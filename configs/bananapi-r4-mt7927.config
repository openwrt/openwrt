# Banana Pi R4 (MT7988A) + MT7927 PCIe Wi-Fi config fragment
# Apply with:
#   cp configs/bananapi-r4-mt7927.config .config
#   make defconfig
#   make -j$(nproc)

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4=y

# MT7927 (Filogic 380) PCIe Wi-Fi driver + firmware
# Pulls in kmod-mt7925e and kmod-mt7927-firmware automatically
CONFIG_PACKAGE_kmod-mt7927=y
