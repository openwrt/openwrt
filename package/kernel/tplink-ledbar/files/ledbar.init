#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	ls /sys/bus/i2c/drivers/tplink-ledbar/*/effect >/dev/null 2>&1 || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/ledbar
	procd_set_param respawn
	procd_close_instance
}

reload_service() {
	procd_running ledbar || return 0
	procd_send_signal ledbar '*' USR1
}
