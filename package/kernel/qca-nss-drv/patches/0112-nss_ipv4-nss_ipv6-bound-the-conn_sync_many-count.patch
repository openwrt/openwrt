--- a/nss_core.c
+++ b/nss_core.c
@@ -460,6 +460,12 @@ void nss_core_handle_nss_status_pkt(stru
 		return;
 	}
 
+	/*
+	 * A response is filled into the request's buffer without ncm->len
+	 * being rewritten, so the receive buffer is the only length that
+	 * covers a variable-length payload.
+	 */
+	nss_ctx->rx_msg_buf_len = buf_len;
 	cb(nss_ctx, ncm, app_data);
 
 	if (ncm->interface != nss_if) {
--- a/nss_core.h
+++ b/nss_core.h
@@ -482,6 +482,7 @@ struct nss_ctx_instance {
 	uint16_t rps_en;		/* N2H Enable Multiple queues for Data Packets */
 	uint16_t n2h_mitigate_en;	/* N2H mitigation */
 	uint32_t max_buf_size;		/* Maximum buffer size */
+	uint32_t rx_msg_buf_len;	/* Receive buffer length of the status message being handled */
 	uint32_t buf_sz_allocated;	/* size of bufs allocated from host */
 	nss_cmn_queue_decongestion_callback_t queue_decongestion_callback[NSS_MAX_CLIENTS];
 					/* Queue decongestion callbacks */
--- a/nss_ipv4.c
+++ b/nss_ipv4.c
@@ -120,7 +120,27 @@ static void nss_ipv4_rx_msg_handler(stru
 		nss_ipv4_stats_conn_sync(nss_ctx, &nim->msg.conn_stats);
 		break;
 
-	case NSS_IPV4_TX_CONN_STATS_SYNC_MANY_MSG:
+	case NSS_IPV4_TX_CONN_STATS_SYNC_MANY_MSG: {
+		/*
+		 * count and size are both written by the firmware, so the
+		 * count-against-size test inside the stats helper compares one
+		 * firmware value with another. ncm->len is no bound either: the
+		 * firmware answers in the request's buffer and leaves the
+		 * header-only length ECM sent. Bound count by the receive
+		 * buffer the core validated, and do it here, because the
+		 * registered callback below iterates the same count with no
+		 * test of its own.
+		 */
+		uint32_t hdr = offsetof(struct nss_ipv4_msg, msg.conn_stats_many.conn_sync);
+		uint32_t buf = nss_ctx->rx_msg_buf_len;
+		uint32_t max = (buf < hdr) ? 0 : (buf - hdr) / sizeof(struct nss_ipv4_conn_sync);
+
+		if (nim->msg.conn_stats_many.count > max) {
+			pr_warn_ratelimited("%px: conn_sync_many count %u exceeds buffer capacity %u\n",
+					nss_ctx, nim->msg.conn_stats_many.count, max);
+			nim->msg.conn_stats_many.count = max;
+		}
+
 		/*
 		 * Update driver statistics on connection sync many.
 		 */
@@ -128,6 +148,7 @@ static void nss_ipv4_rx_msg_handler(stru
 		ncm->cb = (nss_ptr_t)nss_ipv4_conn_sync_many_msg_cb;
 		break;
 	}
+	}
 
 	/*
 	 * Update the callback and app_data for NOTIFY messages, IPv4 sends all notify messages
--- a/nss_ipv4_stats.c
+++ b/nss_ipv4_stats.c
@@ -167,14 +167,6 @@ void nss_ipv4_stats_conn_sync_many(struc
 {
 	int i;
 
-	/*
-	 * Sanity check for the stats count
-	 */
-	if (nicsm->count * sizeof(struct nss_ipv4_conn_sync) >= nicsm->size) {
-		nss_warning("%px: stats sync count %u exceeds the size of this msg %u", nss_ctx, nicsm->count, nicsm->size);
-		return;
-	}
-
 	for (i = 0; i < nicsm->count; i++) {
 		nss_ipv4_stats_conn_sync(nss_ctx, &nicsm->conn_sync[i]);
 	}
