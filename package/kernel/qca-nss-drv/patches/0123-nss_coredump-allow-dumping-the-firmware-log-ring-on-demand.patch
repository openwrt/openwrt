+/*
+ * nss_fwlog_handler()
+ *	Dump the firmware's log ring for core 0 on demand.
+ *
+ * The coredump path only runs when the firmware itself signals a crash. A
+ * firmware that is wedged rather than crashed never signals, and then this
+ * is the only way to read what it logged before it stopped: the ring lives
+ * in host memory, so walking it needs nothing from the firmware.
+ */
+static int nss_fwlog_handler(const struct ctl_table *ctl, int write, void __user *buffer, size_t *lenp, loff_t *ppos)
+{
+	struct nss_ctx_instance *nss_ctx = &nss_top_main.nss[NSS_CORE_0];
+	int ret;
+
+	ret = proc_dointvec(ctl, write, buffer, lenp, ppos);
+	if (ret || !write) {
+		return ret;
+	}
+
+	if (nss_cmd_buf.fwlog) {
+		nss_fw_logbuffer_dump(nss_ctx);
+	}
+
+	return ret;
+}
