+	nss_own->state |= NSS_CORE_STATE_FW_DEAD;
+	queue_delayed_work(coredump_workqueue, &coredump_queuewait,
+			msecs_to_jiffies(NSS_COREDUMP_WAIT_MS));
+
+	nss_fw_logbuffer_dump(nss_own);
 
