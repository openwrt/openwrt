--- a/nss_init.c
+++ b/nss_init.c
@@ -99,8 +99,26 @@
  * nss_probe()
  *	HLOS device probe callback
  */
+static bool enabled;
+module_param(enabled, bool, 0444);
+MODULE_PARM_DESC(enabled, "Boot NSS firmware (requires reboot to change)");
+
 static inline int nss_probe(struct platform_device *nss_dev)
 {
+	u32 mask;
+
+	if (!enabled)
+		return -ENODEV;
+
+	/* Only the internal WAN may leave the host datapath on this board. */
+	if (!of_machine_is_compatible("fpt,ax3000cv2") ||
+	    of_property_read_u32(nss_dev->dev.of_node,
+				 "qcom,physical-interface-mask", &mask) ||
+	    mask != BIT(0)) {
+		dev_err(&nss_dev->dev, "refusing NSS without WF810DF WAN-only ownership\n");
+		return -EINVAL;
+	}
+
 	return nss_hal_probe(nss_dev);
 }
 
