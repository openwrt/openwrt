+	void			(*pon_rx_cb)(void *arg, struct sk_buff *skb, u8 sport, u16 gem);
+	void			*pon_rx_arg;
+#endif
 };
 
 static void en75_fill_rx_queue(struct en75_q_rx *q, u32 end_i)
@@ -196,6 +212,17 @@ static void en75_qdma_rx_process_one(str
 	 *       PPE_CPU_REASON_HIT_UNBIND_RATE_REACHED here. */
 
 	sport = get_erx_sport(&desc.msg.erx);
+#ifdef CONFIG_ECONET_XPON
+	/* PON engine (qdma[1]) has no GDM netdev; hand RX frames to the PON
+	 * sub-driver instead of the sport->netdev path (which would NULL-deref
+	 * in eth_type_trans). The cb takes ownership of skb. */
