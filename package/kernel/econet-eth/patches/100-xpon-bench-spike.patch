@@ -366,6 +393,59 @@ static int en75_qdma_rx_napi_poll(struct
 	return done;
 }
 
+#ifdef CONFIG_ECONET_XPON
+/* PON integration seam (bench spike). en75_qdma_pon_dispatch() runs from the hard
+ * IRQ (under irq->lock_irq) AND from the synthetic /proc trigger, so the registered
+ * callback MUST be non-blocking (schedule work, do not sleep). */
+void en75_qdma_pon_dispatch(struct en75_qdma *qdma, enum en75_irq_purpose_type type)
+{
+	if (type >= IPS_GPON_INT && type <= IPS_XPON_INT)
+		qdma->pon_irq_count[type - IPS_GPON_INT]++;
+	if (qdma->pon_cb)
+		qdma->pon_cb(qdma->pon_arg, type);
+}
+
+int en75_qdma_register_pon(struct en75_qdma *qdma,
+			   void (*cb)(void *, enum en75_irq_purpose_type),
+			   void *arg)
+{
+	guard(mutex)(&qdma->lock);
+	qdma->pon_arg = arg;
+	WRITE_ONCE(qdma->pon_cb, cb);
+	return 0;
+}
+
+int en75_qdma_register_pon_rx(struct en75_qdma *qdma,
+			      void (*cb)(void *, struct sk_buff *, u8, u16),
+			      void *arg)
+{
+	guard(mutex)(&qdma->lock);
+	qdma->pon_rx_arg = arg;
+	WRITE_ONCE(qdma->pon_rx_cb, cb);
+	return 0;
+}
+
+/* Enable/disable the engine's internal QDMA loopback (TX -> RX), so the PON
+ * datapath can be validated without the GPON MAC/optics (no fiber). */
+int en75_qdma_set_loopback(struct en75_qdma *qdma, bool on)
+{
+	struct qregs_qcfg qcfg;
+
+	guard(mutex)(&qdma->lock);
+	qcfg = en75_rreg(&qdma->regs->qdma_cfg);
+	set_qregs_qcfg_qdma_loopback(&qcfg, on);
+	en75_wreg(qcfg, &qdma->regs->qdma_cfg);
+	return 0;
+}
+
+void en75_qdma_pon_counts(struct en75_qdma *qdma, u32 out[3])
+{
+	out[0] = READ_ONCE(qdma->pon_irq_count[0]);
+	out[1] = READ_ONCE(qdma->pon_irq_count[1]);
+	out[2] = READ_ONCE(qdma->pon_irq_count[2]);
+}
+#endif /* CONFIG_ECONET_XPON */
