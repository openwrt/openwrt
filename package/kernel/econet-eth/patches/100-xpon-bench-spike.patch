From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AK Sharma <maskachoska@yahoo.com>
Date: Tue, 5 Aug 2026 00:00:00 +0000
Subject: [PATCH] econet-eth: add xPON PON datapath seam

Add the PON datapath seam hooks the econet-xpon GPON driver binds to.
---
Index: econet-eth-2026.01.27~1db74f83/Kbuild
===================================================================
--- econet-eth-2026.01.27~1db74f83.orig/Kbuild
+++ econet-eth-2026.01.27~1db74f83/Kbuild
@@ -1,2 +1,5 @@
 obj-m := econet-eth.o
-econet-eth-y := econet_eth.o econet_eth_debug.o econet_qdma.o econet_port.o
\ No newline at end of file
+econet-eth-y := econet_eth.o econet_eth_debug.o econet_qdma.o econet_port.o
+
+# PON integration-seam bench spike (M1 Step 1). Promote to a Kconfig symbol later.
+ccflags-y += -DCONFIG_ECONET_XPON
\ No newline at end of file
Index: econet-eth-2026.01.27~1db74f83/econet_eth.c
===================================================================
--- econet-eth-2026.01.27~1db74f83.orig/econet_eth.c
+++ econet-eth-2026.01.27~1db74f83/econet_eth.c
@@ -47,6 +47,12 @@
 #include "qdma_regs.h"
 #include "econet_eth.h"
 
+#ifdef CONFIG_ECONET_XPON
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/ratelimit.h>
+#endif
+
 /* MT7530 switch configuration */
 #define  PMCR_FORCE_FDX			BIT(1)
 #define  PMCR_FORCE_LNK			BIT(0)
@@ -272,6 +278,108 @@ static void en75_prepare_qdma_cfg(struct
 	cfg->soc = soc;
 }
 
+#ifdef CONFIG_ECONET_XPON
+/*
+ * PON integration-seam bench spike (M1 Step 1, hardware-free).
+ * Enables the otherwise-idle PON QDMA engine (qdma[1]; GDMA2/gmac1 disabled in DT),
+ * registers a non-blocking ISR callback for GPON/EPON/XPON interrupts, and exposes
+ * /proc/econet_xpon: read = dispatch counts; write = synthetic dispatch (proves the
+ * IRQ -> callback path without bringing up the GPON MAC, whose real IRQ is M1 Step 4).
+ */
+static struct en75_eth_pvt *xpon_spike_eth;
+static struct proc_dir_entry *xpon_spike_proc;
+
+static void en75_xpon_spike_cb(void *arg, enum en75_irq_purpose_type type)
+{
+	/* Runs in IRQ/atomic context: must stay non-blocking. */
+	pr_info_ratelimited("econet_xpon: %s dispatched to PON sub-driver\n",
+			    en75_irq_purpose_type_str(type));
+}
+
+static int en75_xpon_proc_show(struct seq_file *m, void *v)
+{
+	struct en75_eth_pvt *eth = xpon_spike_eth;
+	u32 c[3] = { 0, 0, 0 };
+
+	if (eth && eth->qdma[1])
+		en75_qdma_pon_counts(eth->qdma[1], c);
+	seq_printf(m, "qdma1_present %d\n", !!(eth && eth->qdma[1]));
+	seq_printf(m, "pon_irq_gpon %u\n", c[0]);
+	seq_printf(m, "pon_irq_epon %u\n", c[1]);
+	seq_printf(m, "pon_irq_xpon %u\n", c[2]);
+	return 0;
+}
+
+static int en75_xpon_proc_open(struct inode *ino, struct file *f)
+{
+	return single_open(f, en75_xpon_proc_show, NULL);
+}
+
+static ssize_t en75_xpon_proc_write(struct file *f, const char __user *buf,
+				    size_t len, loff_t *off)
+{
+	struct en75_eth_pvt *eth = xpon_spike_eth;
+
+	/* Synthetic dispatch: exercise the exact IRQ -> callback path. */
+	if (eth && eth->qdma[1])
+		en75_qdma_pon_dispatch(eth->qdma[1], IPS_GPON_INT);
+	return len;
+}
+
+static const struct proc_ops en75_xpon_proc_ops = {
+	.proc_open	= en75_xpon_proc_open,
+	.proc_read	= seq_read,
+	.proc_write	= en75_xpon_proc_write,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+};
+
+#include <linux/export.h>
+/* Accessor exported to the econet-xpon module: the free PON QDMA engine (qdma[1],
+ * GDMA2/gmac1 disabled in DT). NULL until econet_eth has probed. */
+struct en75_qdma *en75_xpon_pon_qdma(void)
+{
+	return xpon_spike_eth ? xpon_spike_eth->qdma[1] : NULL;
+}
+EXPORT_SYMBOL_GPL(en75_xpon_pon_qdma);
+
+static void en75_xpon_spike_init(struct en75_eth_pvt *eth)
+{
+	xpon_spike_eth = eth;
+
+	if (eth->qdma[1]) {
+		int err = en75_qdma_use(eth->qdma[1]);
+
+		if (err)
+			dev_warn(eth->pub.dev,
+				 "xpon spike: en75_qdma_use(qdma1) failed: %d\n", err);
+		else
+			dev_info(eth->pub.dev,
+				 "xpon spike: PON QDMA engine (qdma1) enabled\n");
+
+		en75_qdma_register_pon(eth->qdma[1], en75_xpon_spike_cb, eth);
+	} else {
+		dev_warn(eth->pub.dev, "xpon spike: qdma1 not present\n");
+	}
+
+	xpon_spike_proc = proc_create("econet_xpon", 0644, NULL,
+				      &en75_xpon_proc_ops);
+}
+
+static void en75_xpon_spike_exit(void)
+{
+	if (xpon_spike_proc) {
+		proc_remove(xpon_spike_proc);
+		xpon_spike_proc = NULL;
+	}
+	if (xpon_spike_eth && xpon_spike_eth->qdma[1]) {
+		en75_qdma_register_pon(xpon_spike_eth->qdma[1], NULL, NULL);
+		en75_qdma_unuse(xpon_spike_eth->qdma[1]);
+	}
+	xpon_spike_eth = NULL;
+}
+#endif /* CONFIG_ECONET_XPON */
+
 static void en75_remove(struct platform_device *pdev)
 {
 	struct en75_eth_pvt *eth = platform_get_drvdata(pdev);
@@ -280,6 +388,9 @@ static void en75_remove(struct platform_
 	if (!eth)
 		return;
 
+#ifdef CONFIG_ECONET_XPON
+	en75_xpon_spike_exit();
+#endif
 	en75_debugfs_exit(eth->debug);
 
 	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
@@ -393,6 +504,10 @@ static int en75_probe(struct platform_de
 	en75_wreg(EN75_PMCR_CONFIG, &regs->switch_regs[MT753X_PMCR_P(6) / 4]);
 	en75_wreg(EN75_MFC_CONFIG, &regs->switch_regs[MT753X_MFC / 4]);
 
+#ifdef CONFIG_ECONET_XPON
+	en75_xpon_spike_init(eth);
+#endif
+
 	return 0;
 
