From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rosen Penev <rosenp@gmail.com>
Date: Wed, 21 Oct 2026 19:28:27 -0700
Subject: [PATCH] 88W8864: report the TX status of nullfunc frames

TX completion freed nullfunc and QoS nullfunc frames instead of
reporting their status. mac80211 and hostapd use these frames to probe
whether a station is still there and wait for their status, which then
never came, and their ACK status entries were never released. Report
their status like that of any other frame.

While at it, take the QoS control field before the descriptor is set
idle and use the common helper to remove the DMA header.

Signed-off-by: Rosen Penev <rosenp@gmail.com>
[Robert Peerenboom: split out of neheb/mwlwifi (upstream branch) commit
 dcb73e4dca ("88W8864/88W8997: fix RX refill, TX status and teardown
 bugs") and backported to db97edf2 on top of the OpenWrt patches]
Signed-off-by: Robert Peerenboom <development@mindrush.de>
---
 hif/pcie/8864/tx.c | 27 ++++++---------------------
 1 file changed, 6 insertions(+), 21 deletions(-)

--- a/hif/pcie/8864/tx.c
+++ b/hif/pcie/8864/tx.c
@@ -441,10 +441,9 @@ static void pcie_non_pfu_tx_done(struct
 	struct pcie_tx_desc *tx_desc;
 	struct sk_buff *done_skb;
 	u32 rate;
+	__le16 qos;
 	struct pcie_dma_data *dma_data;
-	struct ieee80211_hdr *wh;
 	struct ieee80211_tx_info *info;
-	int hdrlen;
 
 	spin_lock_bh(&pcie_priv->tx_desc_lock);
 	while (num--) {
@@ -471,6 +470,7 @@ static void pcie_non_pfu_tx_done(struct
 					 DMA_TO_DEVICE);
 			done_skb = tx_hndl->psk_buff;
 			rate = le32_to_cpu(tx_desc->rate_info);
+			qos = tx_desc->qos_ctrl;
 			tx_desc->pkt_ptr = 0;
 			tx_desc->pkt_len = 0;
 			tx_desc->status =
@@ -479,31 +479,16 @@ static void pcie_non_pfu_tx_done(struct
 			wmb(); /*Data Memory Barrier*/
 
 			dma_data = (struct pcie_dma_data *)done_skb->data;
-			wh = &dma_data->wh;
-			if (ieee80211_is_nullfunc(wh->frame_control) ||
-			    ieee80211_is_qos_nullfunc(wh->frame_control)) {
-				dev_kfree_skb_any(done_skb);
-				goto next;
-			}
-
 			info = IEEE80211_SKB_CB(done_skb);
-			if (ieee80211_is_data(wh->frame_control) ||
-			    ieee80211_is_data_qos(wh->frame_control))
+			if (ieee80211_is_data(dma_data->wh.frame_control) ||
+			    ieee80211_is_data_qos(dma_data->wh.frame_control))
 				pcie_tx_prepare_info(priv, rate, info);
 			else
 				pcie_tx_prepare_info(priv, 0, info);
 
-			/* Remove H/W dma header */
-			hdrlen = ieee80211_hdrlen(
-				dma_data->wh.frame_control);
-			if (ieee80211_is_data_qos(dma_data->wh.frame_control)) {
-				memmove(dma_data->data - hdrlen, &dma_data->wh, hdrlen - IEEE80211_QOS_CTL_LEN);
-				*((__le16 *)(dma_data->data - IEEE80211_QOS_CTL_LEN)) = tx_desc->qos_ctrl;
-			} else
-				memmove(dma_data->data - hdrlen, &dma_data->wh, hdrlen);
-			skb_pull(done_skb, sizeof(*dma_data) - hdrlen);
+			pcie_tx_remove_dma_header(done_skb, qos);
 			ieee80211_tx_status_skb(priv->hw, done_skb);
-next:
+
 			tx_hndl = tx_hndl->pnext;
 			tx_desc = tx_hndl->pdesc;
 			pcie_priv->fw_desc_cnt[num]--;
