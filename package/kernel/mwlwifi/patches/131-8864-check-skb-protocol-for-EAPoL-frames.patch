From a042f1761fafd52e4e875ceb536cae4cb743bf25 Mon Sep 17 00:00:00 2001
From: Qingfang Deng <dqfext@gmail.com>
Date: Fri, 13 Nov 2026 14:01:59 +0800
Subject: [PATCH 2/2] 8864: check skb->protocol for EAPoL frames

88W8864 transmit path peeks directly into the skb payload for an EAPoL
frame. If a QoS Null frame is being transmitted, this will read out of
bound.

Check skb->protocol instead, which 88W8964 already does.

Signed-off-by: Qingfang Deng <dqfext@gmail.com>
---
 hif/pcie/8864/tx.c | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

--- a/hif/pcie/8864/tx.c
+++ b/hif/pcie/8864/tx.c
@@ -656,12 +656,9 @@ void pcie_8864_tx_xmit(struct ieee80211_
 		mgmtframe = true;
 		mgmt = (struct ieee80211_mgmt *)skb->data;
 	} else {
-		u16 pkt_type;
 		struct mwl_sta *sta_info;
 
-		pkt_type = be16_to_cpu(*((__be16 *)
-			&skb->data[ieee80211_hdrlen(wh->frame_control) + 6]));
-		if (pkt_type == ETH_P_PAE) {
+		if (skb->protocol == cpu_to_be16(ETH_P_PAE)) {
 			index = IEEE80211_AC_VO;
 			eapol_frame = true;
 		}
