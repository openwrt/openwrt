+++ b/hif/pcie/8964/tx_ndp.c
@@ -549,13 +549,19 @@ void pcie_tx_xmit_ndp(struct ieee80211_h
 	if (mgmtframe) {
 		u16 capab;
 
+		/* The body of a protected frame starts with its CCMP
