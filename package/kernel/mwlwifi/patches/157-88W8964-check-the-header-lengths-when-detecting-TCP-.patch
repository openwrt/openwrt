From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rosen Penev <rosenp@gmail.com>
Date: Wed, 21 Oct 2026 19:15:14 -0700
Subject: [PATCH] 88W8964: check the header lengths when detecting TCP
 ACKs

pcie_tx_check_tcp_ack() read the IP header of every data frame, and the
TCP header behind it, before checking the protocol and without checking
that the headers are in the linear part of the skb. Check the protocol
first, and that the IP header is valid and both headers fit.

Signed-off-by: Rosen Penev <rosenp@gmail.com>
[Robert Peerenboom: split out of neheb/mwlwifi (upstream branch) commit
 92b4dd1 ("88W8964: return all TX frames to mac80211 and fix TX path
 bugs") and backported to db97edf2 on top of the OpenWrt patches]
Signed-off-by: Robert Peerenboom <development@mindrush.de>
---
 hif/pcie/8964/tx_ndp.c | 42 +++++++++++++++++++++++++-----------------
 1 file changed, 25 insertions(+), 17 deletions(-)

--- a/hif/pcie/8964/tx_ndp.c
+++ b/hif/pcie/8964/tx_ndp.c
@@ -308,23 +308,31 @@ static inline void pcie_tx_check_tcp_ack
 {
 	struct iphdr *iph;
 	struct tcphdr *tcph;
+	unsigned int off;
 
-	if (tx_ctrl->flags & TX_CTRL_TYPE_DATA) {
-		iph = (struct iphdr *)(tx_skb->data + tx_ctrl->hdrlen + 8);
-		tcph = (struct tcphdr *)((u8 *)iph + (iph->ihl * 4));
-		if ((iph->protocol == IPPROTO_TCP) &&
-		    (tx_skb->protocol == htons(ETH_P_IP))) {
-			if ((tcph->ack == 1) && (ntohs(iph->tot_len) ==
-			    (iph->ihl * 4 + tcph->doff * 4))) {
-				if (tcph->syn || tcph->fin)
-					return;
+	if (!(tx_ctrl->flags & TX_CTRL_TYPE_DATA) ||
+	    tx_skb->protocol != htons(ETH_P_IP))
+		return;
 
-				tx_ctrl->flags |= TX_CTRL_TCP_ACK;
-				tx_ctrl->tcp_dst_src = ntohs(tcph->source) |
-					(ntohs(tcph->dest) << 16);
-				tx_ctrl->tcp_sn = ntohl(tcph->ack_seq);
-			}
-		}
+	/* Skip the 802.11 header and the LLC/SNAP header. */
+	off = tx_ctrl->hdrlen + 8;
+	if (skb_headlen(tx_skb) < off + sizeof(*iph))
+		return;
+	iph = (struct iphdr *)(tx_skb->data + off);
+	if (iph->protocol != IPPROTO_TCP || iph->ihl < 5 ||
+	    skb_headlen(tx_skb) < off + iph->ihl * 4 + sizeof(*tcph))
+		return;
+	tcph = (struct tcphdr *)((u8 *)iph + (iph->ihl * 4));
+
+	if ((tcph->ack == 1) && (ntohs(iph->tot_len) ==
+	    (iph->ihl * 4 + tcph->doff * 4))) {
+		if (tcph->syn || tcph->fin)
+			return;
+
+		tx_ctrl->flags |= TX_CTRL_TCP_ACK;
+		tx_ctrl->tcp_dst_src = ntohs(tcph->source) |
+			(ntohs(tcph->dest) << 16);
+		tx_ctrl->tcp_sn = ntohl(tcph->ack_seq);
 	}
 }
 
