 	channel = pmlmeext->cur_channel;
@@ -3396,7 +3399,7 @@ void rtw_cfg80211_indicate_sta_disassoc(
 	DBG_871X(FUNC_ADPT_FMT"\n", FUNC_ADPT_ARG(padapter));
 
 #if defined(RTW_USE_CFG80211_STA_EVENT) || defined(COMPAT_KERNEL_RELEASE)
