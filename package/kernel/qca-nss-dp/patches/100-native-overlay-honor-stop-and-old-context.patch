From: OpenWrt WF810DF contributors
Subject: [PATCH] nss-dp: stop the native data plane before releasing resources

The IPQ5018 NSS overlay uses the native data-plane replacement API. Do not
free its DMA rings if ndo_stop fails, and pass the outgoing data-plane
context to its deinit callback rather than the incoming overlay context.
The overlay caller serializes this transition with RTNL.

--- a/nss_dp_attach.c
+++ b/nss_dp_attach.c
@@ -97,7 +97,8 @@ int nss_dp_override_data_plane(struct net_device *netdev,
 	 * also reset the features
 	 */
 	if (test_bit(__NSS_DP_UP, &dp_dev->flags)) {
-		netdev->netdev_ops->ndo_stop(netdev);
+		if (netdev->netdev_ops->ndo_stop(netdev))
+			return NSS_DP_FAILURE;
 		nss_dp_reset_netdev_features(netdev);
 	}

@@ -105,7 +106,7 @@ int nss_dp_override_data_plane(struct net_device *netdev,
 	 * Free up the resources used by the data plane
 	 */
 	if (dp_dev->drv_flags & NSS_DP_PRIV_FLAG(INIT_DONE)) {
-		if (dp_dev->data_plane_ops->deinit(dpc)) {
+		if (dp_dev->data_plane_ops->deinit(dp_dev->dpc)) {
 			netdev_dbg(netdev, "Data plane de-init failed\n");
 			return -ENOMEM;
 		}
