#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=96
STOP=10
USE_PROCD=1

start_service() {
	local ready=/sys/module/rtx830_board/parameters/boot_complete
	[ -w "$ready" ] || return 1
	printf '1\n' > "$ready" || return 1
	procd_open_instance
	procd_set_param command /usr/sbin/rtx830-media-led-monitor
	procd_set_param respawn 5 1 5
	procd_close_instance
}
