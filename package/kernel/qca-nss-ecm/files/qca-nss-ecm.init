# No START: only wf810df-nss starts ECM after the native WAN handoff.
start() {
	local active
	read -r active < /sys/module/qca_nss_drv/parameters/physical_interface_mask_active || return 1
	[ "$active" = 1 ] || {
		logger -t qca-nss-ecm 'native WAN data plane is not ready; refusing ECM'
		return 1
	}
	[ -d /sys/module/ecm ] && return 0
	# Allocate conntrack event extensions for new flows; never flush existing flows.
	modprobe nf_conntrack || return 1
	sysctl -w net.netfilter.nf_conntrack_events=1 || return 1
	. /lib/functions/wf810df-nss.sh || return 1
	wf810df_nss_load ecm front_end_selection=1 || return 1
	sysctl -w dev.nss.general.redirect=1
}

stop() {
	logger -t qca-nss-ecm 'NSS mode changes require a reboot; leaving active datapaths intact'
}
