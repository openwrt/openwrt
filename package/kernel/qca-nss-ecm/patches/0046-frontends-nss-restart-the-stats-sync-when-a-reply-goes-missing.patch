+		nicsm_req->index = 0;
+		timed_out = true;
+	}
+	spin_unlock_bh(&ecm_nss_ipv4_lock);
+
+	if (timed_out) {
+		pr_warn_ratelimited("ECM: IPv4 conn stats request unanswered for %u ms, restarting the sync\n",
+				    jiffies_to_msecs(waited));
