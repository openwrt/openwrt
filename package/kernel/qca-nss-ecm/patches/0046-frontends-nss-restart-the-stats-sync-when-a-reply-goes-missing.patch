+
+	spin_lock_bh(&ecm_nss_ipv4_lock);
+	if (ecm_nss_ipv4_sync_req_pending) {
+		waited = jiffies - ecm_nss_ipv4_sync_req_jiffies;
+		if (waited < ECM_NSS_IPV4_STATS_SYNC_TIMEOUT) {
+			/*
+			 * Woken early: keep waiting for the reply.
