+/*
+ * ecm_nss_multicast_ipv4_if_rule_dup()
+ *	Whether the rule just filled in at idx puts the same frames on the wire
+ *	as one before it.
+ *
+ * The ports of a tag_8021q DSA bridge all resolve to the conduit with the
+ * VID the tagger gives the bridge, and the switch delivers that one frame
+ * to every port of the group itself. A rule per port would have the
+ * firmware send one copy per port, and the switch deliver each of them to
+ * all the members.
+ */
+static bool ecm_nss_multicast_ipv4_if_rule_dup(struct nss_ipv4_mc_rule_create_msg *create, int idx)
+{
+	struct nss_ipv4_mc_if_rule *b = &create->if_rule[idx];
+	int i;
+
+	for (i = 0; i < idx; i++) {
+		struct nss_ipv4_mc_if_rule *a = &create->if_rule[i];
+
+		if (a->if_num == b->if_num &&
+		    a->xlate_src_ip == b->xlate_src_ip &&
+		    a->xlate_src_ident == b->xlate_src_ident &&
+		    a->pppoe_if_num == b->pppoe_if_num &&
+		    a->egress_vlan_tag[0] == b->egress_vlan_tag[0] &&
+		    a->egress_vlan_tag[1] == b->egress_vlan_tag[1]) {
+			return true;
+		}
+	}
+
+	return false;
+}
