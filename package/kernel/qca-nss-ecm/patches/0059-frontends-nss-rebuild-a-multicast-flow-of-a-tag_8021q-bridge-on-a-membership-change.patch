 				}
 			}
 #endif
-			valid_vif_idx++;
+			if (ecm_nss_multicast_ipv4_if_rule_dup(create, valid_vif_idx)) {
+				DEBUG_TRACE("%px: vif %d puts the same frames on the wire as an earlier one, dropped\n", feci, vif);
+				memset(&create->if_rule[valid_vif_idx], 0, sizeof(create->if_rule[valid_vif_idx]));
+			} else {
+				valid_vif_idx++;
+			}
 		}
 	}
 
