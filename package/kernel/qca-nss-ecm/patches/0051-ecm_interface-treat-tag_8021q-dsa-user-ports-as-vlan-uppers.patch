@@ -916,13 +924,79 @@ static inline bool ecm_interface_lookup_
 }
 #endif
 
+#if IS_ENABLED(CONFIG_NET_DSA)
+/*
+ * ecm_interface_dsa_8021q_conduit()
+ *	The conduit of a DSA user port whose switch talks to the CPU in plain
+ *	802.1Q (a tag_8021q tagger), NULL for any other net device.
+ *
+ * On the wire such a port is a VLAN upper of its conduit: frames arrive on
+ * and leave the conduit carrying the VID the tagger assigned to the port
+ * (or to the port's bridge), exactly like an 802.1Q sub-interface, so the
+ * acceleration rule is written the same way - the conduit's interface
+ * number with the VID in the rule. A rule that names the port's own
+ * interface number instead is accepted by the NSS firmware but never
+ * transmits (measured on IPQ5018 + QCA8337 with the qca-8021q tagger).
+ */
+static struct net_device *ecm_interface_dsa_8021q_conduit(struct net_device *dev, uint16_t *vid)
+{
+	struct dsa_port *dp;
+
+	if (!dsa_user_dev_check(dev)) {
+		return NULL;
+	}
+
+	dp = dsa_port_from_netdev(dev);
+	if (IS_ERR_OR_NULL(dp) || !dp->ds || !dp->ds->tag_8021q_ctx || !dp->cpu_dp) {
+		return NULL;
+	}
+
+	if (vid) {
+		if (dp->bridge && dp->bridge->tx_fwd_offload) {
+			*vid = dsa_tag_8021q_bridge_vid(dsa_port_bridge_num_get(dp));
+		} else {
+			*vid = dsa_tag_8021q_standalone_vid(dp);
+		}
+	}
+
+	return dp->cpu_dp->conduit;
+}
+#else
+static inline struct net_device *ecm_interface_dsa_8021q_conduit(struct net_device *dev, uint16_t *vid)
+{
+	return NULL;
+}
+#endif
+
+/*
+ * ecm_interface_is_vlan_dev()
+ *	An 802.1Q sub-interface, or a DSA port that looks like one on the wire.
+ */
+static inline bool ecm_interface_is_vlan_dev(struct net_device *dev)
+{
+	return is_vlan_dev(dev) || (ecm_interface_dsa_8021q_conduit(dev, NULL) != NULL);
+}
+
 /*
  * ecm_interface_vlan_real_dev()
  *	Return immediate VLAN net device or Physical device pointer
  */
 static inline struct net_device *ecm_interface_vlan_real_dev(struct net_device *vlan_dev)
 {
-	return vlan_dev_next_dev(vlan_dev);
+	if (is_vlan_dev(vlan_dev)) {
+		struct net_device *real_dev = vlan_dev_next_dev(vlan_dev);
+		struct net_device *conduit = ecm_interface_dsa_8021q_conduit(real_dev, NULL);
+
+		/*
+		 * An 802.1Q upper of a tag_8021q DSA port (wan.35 for a PPPoE
+		 * ISP) is on the wire with its own tag only: the switch carries
+		 * that VLAN through and the tagger leaves it alone. Step over the
+		 * port to the conduit, so the rule gets one VLAN, not two.
+		 */
+		return conduit ? conduit : real_dev;
+	}
+
+	return ecm_interface_dsa_8021q_conduit(vlan_dev, NULL);
 }
 
 /*
@@ -4065,14 +4139,25 @@ struct ecm_db_iface_instance *ecm_interf
 		/*
 		 * VLAN?
 		 */
-		if (is_vlan_dev(dev)) {
+		if (ecm_interface_is_vlan_dev(dev)) {
 			/*
 			 * VLAN master
 			 * GGG No locking needed here, ASSUMPTION is that real_dev is held for as long as we have dev.
 			 */
+			uint16_t dsa_vid = 0;
+
 			ether_addr_copy(type_info.vlan.address, dev->dev_addr);
-			type_info.vlan.vlan_tag = vlan_dev_vlan_id(dev);
-			type_info.vlan.vlan_tpid = ntohs(vlan_dev_vlan_proto(dev));
+			if (is_vlan_dev(dev)) {
+				type_info.vlan.vlan_tag = vlan_dev_vlan_id(dev);
+				type_info.vlan.vlan_tpid = ntohs(vlan_dev_vlan_proto(dev));
+			} else {
+				/*
+				 * A tag_8021q DSA port: the tagger's VID, standard TPID.
+				 */
+				ecm_interface_dsa_8021q_conduit(dev, &dsa_vid);
+				type_info.vlan.vlan_tag = dsa_vid;
+				type_info.vlan.vlan_tpid = ETH_P_8021Q;
+			}
 			DEBUG_TRACE("%px: Net device: %px is VLAN, mac: %pM, vlan_id: %x vlan_tpid: %x\n",
 					feci, dev, type_info.vlan.address, type_info.vlan.vlan_tag, type_info.vlan.vlan_tpid);
 
