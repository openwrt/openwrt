+#ifdef ECM_BRIDGE_VLAN_FILTERING_ENABLE
+/*
+ * ecm_nss_common_vlan_filter_vid()
+ *	The 802.1Q VID ci->vlan_filter recorded for dev in the two entries
+ *	starting at first: 0 when neither names dev, -1 when the entry is not
+ *	a usable 802.1Q VID.
+ */
+static inline int ecm_nss_common_vlan_filter_vid(struct ecm_db_connection_instance *ci,
+						 struct net_device *dev, int first)
+{
+	struct ecm_db_connection_vlan_filter *vf;
+	int i;
+
+	for (i = first; i < first + ECM_VLAN_FILTER_RULE_IFACE_MAX; i++) {
+		vf = &ci->vlan_filter[i];
+		if (!vf->is_valid || !vf->ii ||
+		    ecm_db_iface_interface_identifier_get(vf->ii) != dev->ifindex) {
+			continue;
+		}
+		if (vf->vlan_tpid != ETH_P_8021Q || !vf->vlan_tag || vf->vlan_tag >= VLAN_N_VID) {
+			return -1;
+		}
+		return vf->vlan_tag;
+	}
+	return 0;
+}
+#endif
+
+/*
+ * ecm_nss_common_vlan_aware_dsa_side()
+ *	The endpoint of a rule side whose innermost interface is a tag_8021q
+ *	DSA user port of a VLAN-aware bridge: the VID the flow uses on that
+ *	port's conduit, and the conduit's interface number.
+ *
+ *	Such a port is a plain ethernet leaf with no interface number in the
+ *	hierarchy (one port, several VLANs - no single tag describes it), so
+ *	every frontend but this path refuses it. The VID is the one ECM recorded for the port in ci->vlan_filter,
+ *	taken only when both directions agree - flow ingress and return egress
+ *	for the 'from' side, flow egress and return ingress for the 'to' side.
+ *	They can disagree (the VID found for one side is carried into the walk
+ *	of the other, and br_fdb_find_vid_by_mac() returns the newest entry of a
+ *	MAC in any VLAN): a host with one MAC in several VLANs, a routed flow
+ *	through the bridge master to a trunk port. Whether the port itself is a
+ *	tagged or an untagged member does not matter: the CPU port is a tagged
+ *	member of every bridge VLAN, so the conduit carries the tag both ways.
+ *
+ *	Returns 0 when the side is not such a port (nothing to do), 1 with
+ *	*vid and *if_num filled in, -1 when the connection must not be
+ *	accelerated (no agreed VID, or no node for it yet).
+ */
+static inline int ecm_nss_common_vlan_aware_dsa_side(struct ecm_db_connection_instance *ci,
+						     struct ecm_db_iface_instance *ii, bool to_side,
+						     uint16_t *vid, int32_t *if_num)
+{
+	struct net_device *dev;
+	struct net_device *conduit;
+	int ret = -1;
+#ifdef ECM_BRIDGE_VLAN_FILTERING_ENABLE
+	int v, ret_v;
+#endif
+
+	dev = dev_get_by_index(&init_net, ecm_db_iface_interface_identifier_get(ii));
+	if (!dev) {
+		return 0;
+	}
+
+	if (!ecm_interface_dsa_8021q_vlan_aware(dev, &conduit)) {
+		dev_put(dev);
+		return 0;
+	}
+
+#ifdef ECM_BRIDGE_VLAN_FILTERING_ENABLE
+	if (!ci->vlan_filter_valid || !ci->vlan_filter) {
+		DEBUG_TRACE("%px: %s: no bridge VLAN filter data on the connection\n", ci, dev->name);
+		goto out;
+	}
+
+	if (to_side) {
+		v = ecm_nss_common_vlan_filter_vid(ci, dev, ECM_VLAN_FILTER_RULE_FLOW_EGRESS1);
+		ret_v = ecm_nss_common_vlan_filter_vid(ci, dev, ECM_VLAN_FILTER_RULE_RET_INGRESS1);
+	} else {
+		v = ecm_nss_common_vlan_filter_vid(ci, dev, ECM_VLAN_FILTER_RULE_FLOW_INGRESS1);
+		ret_v = ecm_nss_common_vlan_filter_vid(ci, dev, ECM_VLAN_FILTER_RULE_RET_EGRESS1);
+	}
+	if (v <= 0 || v != ret_v) {
+		DEBUG_TRACE("%px: %s: no agreed bridge VLAN (%d / %d)\n", ci, dev->name, v, ret_v);
+		goto out;
+	}
+
+	/*
+	 * The endpoint is the conduit's own interface; the firmware needs a
+	 * VLAN node of this VID on it to classify the frames (measured: a
+	 * tagged frame with no node goes to the host), so no node, no rule.
+	 */
+	if (ecm_interface_dsa_nss_if_num(conduit, (uint16_t)v) < 0) {
+		DEBUG_TRACE("%px: %s: no firmware node for VLAN %d on %s\n", ci, dev->name, v, conduit->name);
+		goto out;
+	}
+
+	*if_num = ecm_nss_common_get_interface_number_by_dev(conduit);
+	if (*if_num < 0) {
+		DEBUG_TRACE("%px: %s: conduit %s has no NSS interface\n", ci, dev->name, conduit->name);
+		goto out;
+	}
+
+	*vid = (uint16_t)v;
+	DEBUG_TRACE("%px: %s: VLAN %u on %s (interface %d)\n", ci, dev->name, *vid, conduit->name, *if_num);
+	ret = 1;
+out:
+#endif
+	dev_put(dev);
+	return ret;
+}
