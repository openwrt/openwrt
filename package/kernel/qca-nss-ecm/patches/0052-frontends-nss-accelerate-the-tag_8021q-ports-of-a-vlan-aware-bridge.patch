+/*
+ * ecm_interface_dsa_8021q_vlan_aware()
+ *	Whether dev is a tag_8021q DSA user port of a VLAN-aware bridge; its
+ *	conduit in *conduit when asked for.
+ */
+bool ecm_interface_dsa_8021q_vlan_aware(struct net_device *dev, struct net_device **conduit)
+{
+	struct dsa_port *dp;
+	struct net_device *br;
+
+	if (!dsa_user_dev_check(dev)) {
+		return false;
+	}
+
+	dp = dsa_port_from_netdev(dev);
+	if (IS_ERR_OR_NULL(dp) || !dp->ds || !dp->ds->tag_8021q_ctx || !dp->cpu_dp || !dp->bridge) {
+		return false;
+	}
+
+	br = dsa_port_bridge_dev_get(dp);
+	if (!br || !br_vlan_enabled(br)) {
+		return false;
+	}
+
+	if (conduit) {
+		*conduit = dp->cpu_dp->conduit;
+	}
+	return true;
+}
+EXPORT_SYMBOL(ecm_interface_dsa_8021q_vlan_aware);
+
+/*
+ * ecm_interface_dsa_nss_if_num()
+ *	The NSS interface number of the firmware VLAN node for vid on the
+ *	conduit's phys_if, -1 when there is none.
+ *
+ * The nodes are the qca-dsa-nss glue's; it is a separate module that may or
+ * may not be loaded, so its lookup is resolved at first use and held for the
+ * life of this module rather than linked. Without it a VLAN-aware bridge's
+ * DSA ports simply stay on the host path.
+ */
+static int (*ecm_interface_dsa_nss_if_num_fn)(struct net_device *conduit, u16 vid);
+
+int32_t ecm_interface_dsa_nss_if_num(struct net_device *conduit, uint16_t vid)
+{
+	int (*fn)(struct net_device *, u16);
+
+	fn = READ_ONCE(ecm_interface_dsa_nss_if_num_fn);
+	if (!fn) {
+		fn = symbol_get(qca_dsa_nss_if_num);
+		if (!fn) {
+			return -1;
+		}
+		if (cmpxchg(&ecm_interface_dsa_nss_if_num_fn, NULL, fn)) {
+			symbol_put(qca_dsa_nss_if_num);
+		}
+	}
+	return fn(conduit, vid);
+}
+EXPORT_SYMBOL(ecm_interface_dsa_nss_if_num);
+
+static void ecm_interface_dsa_nss_if_num_release(void)
+{
+	if (ecm_interface_dsa_nss_if_num_fn) {
+		symbol_put(qca_dsa_nss_if_num);
+		ecm_interface_dsa_nss_if_num_fn = NULL;
+	}
+}
 #else
 static inline struct net_device *ecm_interface_dsa_8021q_conduit(struct net_device *dev, uint16_t *vid)
 {
 	return NULL;
 }
+
+bool ecm_interface_dsa_8021q_vlan_aware(struct net_device *dev, struct net_device **conduit)
+{
+	return false;
+}
+EXPORT_SYMBOL(ecm_interface_dsa_8021q_vlan_aware);
+
+int32_t ecm_interface_dsa_nss_if_num(struct net_device *conduit, uint16_t vid)
+{
+	return -1;
+}
+EXPORT_SYMBOL(ecm_interface_dsa_nss_if_num);
+
+static inline void ecm_interface_dsa_nss_if_num_release(void)
+{
+}
 #endif
 
