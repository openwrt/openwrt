Co-developed-by: Manuel Fombuena <fombuena@outlook.com>
Signed-off-by: Manuel Fombuena <fombuena@outlook.com>
Assisted-by: Claude:claude-opus-5
Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>

--- a/frontends/include/ecm_front_end_types.h
+++ b/frontends/include/ecm_front_end_types.h
@@ -306,6 +306,7 @@ struct ecm_front_end_connection_instance
 	bool destroy_fail_handle_pending;			/* Set while handling the connection destroy failure */
 	bool udp_flow_dir_accel;				/* If the UDP flow is accelerated in flow direction. */
 	bool udp_return_dir_accel;				/* If the UDP flow is accelerated in return direction. */
+	bool tcp_be_liberal_set;				/* True once we marked this connection's conntrack liberal */
 	atomic64_t unidir_accel_fail_reason;				/* Unidirection accel fail reason */
 #ifdef ECM_FRONT_END_PPE_ENABLE
 	atomic64_t ppe_accel_fail_reason;			/* PPE accel fail reason */
--- a/frontends/nss/ecm_nss_ported_ipv4.c
+++ b/frontends/nss/ecm_nss_ported_ipv4.c
@@ -1382,10 +1382,22 @@ static void ecm_nss_ported_ipv4_connecti
 #else
 			if (tcp_be_liberal
 #endif
-					|| (ct->proto.tcp.seen[flow_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)
-					|| (ct->proto.tcp.seen[return_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)) {
+					|| (!feci->tcp_be_liberal_set
+						&& ((ct->proto.tcp.seen[flow_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)
+							|| (ct->proto.tcp.seen[return_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)))) {
 				nircm->rule_flags |= NSS_IPV4_RULE_CREATE_FLAG_NO_SEQ_CHECK;
 			}
+
+			/*
+			 * The firmware forwards this connection from here and conntrack stops
+			 * seeing it, so its window freezes until the next stats sync and a
+			 * packet excepted back to the host reads as invalid. Set after the
+			 * test above, and hidden from it, so that relaxing conntrack does not
+			 * also switch off the firmware's own sequence check.
+			 */
+			ct->proto.tcp.seen[flow_dir].flags |= IP_CT_TCP_FLAG_BE_LIBERAL;
+			ct->proto.tcp.seen[return_dir].flags |= IP_CT_TCP_FLAG_BE_LIBERAL;
+			feci->tcp_be_liberal_set = true;
 			spin_unlock_bh(&ct->lock);
 		}
 
--- a/frontends/nss/ecm_nss_ported_ipv6.c
+++ b/frontends/nss/ecm_nss_ported_ipv6.c
@@ -1309,10 +1309,22 @@ static void ecm_nss_ported_ipv6_connecti
 #else
 			if (tcp_be_liberal
 #endif
-					|| (ct->proto.tcp.seen[flow_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)
-					|| (ct->proto.tcp.seen[return_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)) {
+					|| (!feci->tcp_be_liberal_set
+						&& ((ct->proto.tcp.seen[flow_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)
+							|| (ct->proto.tcp.seen[return_dir].flags & IP_CT_TCP_FLAG_BE_LIBERAL)))) {
 				nircm->rule_flags |= NSS_IPV6_RULE_CREATE_FLAG_NO_SEQ_CHECK;
 			}
+
+			/*
+			 * The firmware forwards this connection from here and conntrack stops
+			 * seeing it, so its window freezes until the next stats sync and a
+			 * packet excepted back to the host reads as invalid. Set after the
+			 * test above, and hidden from it, so that relaxing conntrack does not
+			 * also switch off the firmware's own sequence check.
+			 */
+			ct->proto.tcp.seen[flow_dir].flags |= IP_CT_TCP_FLAG_BE_LIBERAL;
+			ct->proto.tcp.seen[return_dir].flags |= IP_CT_TCP_FLAG_BE_LIBERAL;
+			feci->tcp_be_liberal_set = true;
 			spin_unlock_bh(&ct->lock);
 		}
 
