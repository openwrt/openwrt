From: Julius Bairaktaris <julius@bairaktaris.de>
Subject: [PATCH] ecm_interface: classify a header-less modem as raw IP

The raw-IP interface type is recognised by ARPHRD_RAWIP alone, which
rmnet, MHI and MBIM devices declare. A QMI modem in raw-IP mode does
not: qmi_wwan_netdev_setup() drops the header operations, the header
length and the address length but leaves the type at ARPHRD_NONE, and
that is the WAN interface of every USB-attached cellular router.

Such a device reaches the end of the interface type ladder as unknown,
and an unknown interface never sets the node-address done flag, so
ecm_ipv4_node_establish_and_ref() and its IPv6 counterpart fail and the
connection is never offered to the acceleration engine.

Recognise a raw-IP device by what it carries rather than by its ARP
type. ARPHRD_NONE with no header, no address and no rtnl link operations
also describes the software translators - nat46 builds exactly that
shape - so the parent device a modem bus sets is what tells the two
apart: a translator has none.

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
Assisted-by: Claude Opus 5 (1M context)
---
--- a/ecm_interface.c
+++ b/ecm_interface.c
@@ -4467,7 +4467,7 @@ identifier_update:
 	/*
 	 * RAWIP type?
 	 */
-	if (dev_type == ARPHRD_RAWIP) {
+	if (ecm_interface_is_rawip(dev)) {
 		/*
 		 * Copy netdev address to the type info.
 		 */
@@ -6710,7 +6710,7 @@ lag_success:
 			 * RAWIP?
 			 * If it is RAWIP type, there is no next device.
 			 */
-			if (dest_dev_type == ARPHRD_RAWIP) {
+			if (ecm_interface_is_rawip(dest_dev)) {
 				DEBUG_TRACE("%px: Net device: %px is RAWIP type: %d\n", feci, dest_dev, dest_dev_type);
 				break;
 			}
--- a/ecm_interface.h
+++ b/ecm_interface.h
@@ -6,6 +6,8 @@
  **************************************************************************
  */
 
+#include <linux/if_arp.h>
+
 #ifdef ECM_INTERFACE_VXLAN_ENABLE
 #include <net/vxlan.h>
 #endif
@@ -35,6 +37,26 @@ struct ecm_interface_route {
 #define ECM_INTERFACE_LOOPBACK_DEV_INDEX 1
 
 /*
+ * ecm_interface_is_rawip()
+ *	Determine whether a net device carries bare IP with no link-layer header.
+ *
+ * rmnet, MHI and MBIM devices declare ARPHRD_RAWIP. A QMI modem in raw-IP mode
+ * leaves the type at ARPHRD_NONE with no header and no address, which the
+ * software translators use as well; only a device a modem bus created has a
+ * parent, which separates the two.
+ */
+static inline bool ecm_interface_is_rawip(struct net_device *dev)
+{
+	if (dev->type == ARPHRD_RAWIP) {
+		return true;
+	}
+
+	return dev->type == ARPHRD_NONE && dev->dev.parent
+		&& !dev->rtnl_link_ops && !dev->hard_header_len
+		&& !dev->addr_len;
+}
+
+/*
  * IPSec Core and Interface Definition
  */
 #define ECM_INTERFACE_IPSEC_DEFAULT_CORE 0x2
--- a/frontends/cmn/ecm_ipv4.c
+++ b/frontends/cmn/ecm_ipv4.c
@@ -296,7 +296,7 @@ struct ecm_db_node_instance *ecm_ipv4_no
 			/*
 			 * If the local dev is Rmnet device, no need to do a MAC lookup.
 			 */
-			if (local_dev->type == ARPHRD_RAWIP) {
+			if (ecm_interface_is_rawip(local_dev)) {
 				dev_put(local_dev);
 				done = true;
 				break;
--- a/frontends/cmn/ecm_ipv6.c
+++ b/frontends/cmn/ecm_ipv6.c
@@ -294,7 +294,7 @@ struct ecm_db_node_instance *ecm_ipv6_no
 			/*
 			 * If the local dev is Rmnet device, no need to do a MAC lookup.
 			 */
-			if (local_dev->type == ARPHRD_RAWIP) {
+			if (ecm_interface_is_rawip(local_dev)) {
 				dev_put(local_dev);
 				done = true;
 				break;
--- a/frontends/nss/ecm_nss_common.h
+++ b/frontends/nss/ecm_nss_common.h
@@ -74,7 +74,7 @@ static inline int32_t ecm_nss_common_get
 	}
 
 #ifdef ECM_INTERFACE_RAWIP_ENABLE
-	if (dev->type == ARPHRD_RAWIP) {
+	if (ecm_interface_is_rawip(dev)) {
 		return nss_rmnet_rx_get_ifnum(dev);
 	}
 #endif
