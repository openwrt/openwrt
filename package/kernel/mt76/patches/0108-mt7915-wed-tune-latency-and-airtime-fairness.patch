+#define RED_GLOBAL_TOKEN_WATERMARK	2
+#define RED_BAND_TOKEN_WATERMARK	4
+#define RED_STA_AC_DROP_THRESHOLD	5
+#define RED_DUMP_CTRL			8
+
 static int mt7915_red_set_watermark(struct mt7915_dev *dev)
 {
-#define RED_GLOBAL_TOKEN_WATERMARK 2
 	struct {
 		__le32 args[3];
 		u8 cmd;
@@ -2407,6 +2417,338 @@ static int mt7915_red_set_watermark(stru
 				 sizeof(req), false);
 }
 
+static int mt7915_wa_set_ps_flush(struct mt7915_dev *dev, u16 per_sta,
+				  u16 total_thld)
+{
+	struct {
+		__le16 per_sta_max;
+		__le16 total_thld;
+		u8 enable;
+		u8 __rsv[3];
+	} __packed req = {
+		.per_sta_max = cpu_to_le16(per_sta),
+		.total_thld = cpu_to_le16(total_thld),
+		.enable = 1,
+	};
+
+	return mt76_mcu_send_msg(&dev->mt76,
+				 MCU_WA_EXT_CMD(AP_PWR_SAVING_CAP),
+				 &req, sizeof(req), false);
+}
+
+int mt7915_mcu_set_dscp_pri(struct mt7915_dev *dev, struct mt7915_vif *mvif)
+{
+	struct {
+		u8 bss_idx;
+		u8 enable;
+		u8 __rsv[2];
+		u8 map[64];
+	} __packed req = {
+		.bss_idx = mvif->mt76.idx,
+		.enable = 1,
+	};
+	int dscp;
+
+	if (is_mt7915(&dev->mt76) || mvif->mt76.idx >= 0x30)
+		return 0;
+
+	/* RFC 8325 DSCP-to-UP map matching cfg80211_classify8021d() */
+	for (dscp = 0; dscp < 64; dscp++)
+		req.map[dscp] = dscp >> 3;
+
+	/* AF11, AF12, AF13, CS2 -> UP 0 (AC_BE instead of AC_BK) */
+	req.map[10] = 0;
+	req.map[12] = 0;
+	req.map[14] = 0;
+	req.map[16] = 0;
+
+	/* AF21, AF22, AF23 -> UP 3 (AC_BE) */
+	req.map[18] = 3;
+	req.map[20] = 3;
+	req.map[22] = 3;
+
+	/* CS3, AF31, AF32, AF33 -> UP 4 (AC_VI) */
+	req.map[24] = 4;
+	req.map[26] = 4;
+	req.map[28] = 4;
+	req.map[30] = 4;
+
+	/* VA, EF -> UP 6 (AC_VO) */
+	req.map[44] = 6;
+	req.map[46] = 6;
+
+	/* CS6 -> UP 7 (AC_VO) */
+	req.map[48] = 7;
+
+	return mt76_mcu_send_msg(&dev->mt76, MCU_WA_EXT_CMD(SET_QOS_MAP),
+				 &req, sizeof(req), false);
+}
+
+static int mt7915_red_set_watermarks(struct mt7915_dev *dev,
+				     u16 all_hi, u16 all_lo,
+				     u16 b0_hi, u16 b0_lo,
+				     u16 b1_hi, u16 b1_lo)
+{
+	struct {
+		__le32 args[3];
+		u8 cmd;
+		u8 version;
+		u8 __rsv1[4];
+		__le16 len;
+		__le16 high_mark;
+		__le16 low_mark;
+		__le16 band_high_mark[2];
+		__le16 band_low_mark[2];
+		__le16 page_high_mark;
+		__le16 page_low_mark;
+	} __packed req = {
+		.args[0] = cpu_to_le32(MCU_WA_PARAM_RED_SETTING),
+		.cmd = RED_BAND_TOKEN_WATERMARK,
+		.len = cpu_to_le16(sizeof(req) - sizeof(req.args)),
+		.high_mark = cpu_to_le16(all_hi),
+		.low_mark = cpu_to_le16(all_lo),
+		.band_high_mark[0] = cpu_to_le16(b0_hi),
+		.band_high_mark[1] = cpu_to_le16(b1_hi),
+		.band_low_mark[0] = cpu_to_le16(b0_lo),
+		.band_low_mark[1] = cpu_to_le16(b1_lo),
+	};
+	int ret;
+
+	ret = mt76_mcu_send_msg(&dev->mt76, MCU_WA_PARAM_CMD(SET), &req,
+				sizeof(req), false);
+	if (ret < 0)
+		return ret;
+
+	req.cmd = RED_GLOBAL_TOKEN_WATERMARK;
+	return mt76_mcu_send_msg(&dev->mt76, MCU_WA_PARAM_CMD(SET), &req,
+				 sizeof(req), false);
+}
+
+static int mt7915_red_set_sta_dropth(struct mt7915_dev *dev, u16 wcid,
+				     u16 tokens)
+{
+	struct {
+		__le32 args[3];
+		u8 cmd;
+		u8 version;
+		u8 __rsv1[4];
+		__le16 len;
+		__le16 wcid;
+		u8 ac;
+		u8 __rsv2;
+		__le16 token_dropth;
+		__le16 __rsv3;
+		__le16 page_dropth;
+		__le16 __rsv4[3];
+	} __packed req = {
+		.args[0] = cpu_to_le32(MCU_WA_PARAM_RED_SETTING),
+		.cmd = RED_STA_AC_DROP_THRESHOLD,
+		.len = cpu_to_le16(sizeof(req) - sizeof(req.args)),
+		.wcid = cpu_to_le16(wcid),
+		.ac = 1, /* AC_BE in WA */
+		.token_dropth = cpu_to_le16(tokens),
+		.page_dropth = cpu_to_le16(tokens),
+	};
+
+	return mt76_mcu_send_msg(&dev->mt76, MCU_WA_PARAM_CMD(SET), &req,
+				 sizeof(req), false);
+}
+
+
+static int mt7915_wa_set_ac_tail_drop(struct mt7915_dev *dev, u8 band, u8 ac,
+				      u16 lower, u16 upper)
+{
+	u32 qidx = band * 5 + ac;
+	int ret;
+
+	ret = mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(SET),
+				MCU_WA_PARAM_AC_TAIL_DROP_UPPER, qidx, upper);
+	if (ret)
+		return ret;
+
+	return mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(SET),
+				 MCU_WA_PARAM_AC_TAIL_DROP_LOWER, qidx, lower);
+}
+
+int mt7915_mcu_wed_wa_debug(struct mt7915_dev *dev, u8 cmd)
+{
+	struct {
+		__le32 args[3];
+		u8 cmd;
+		u8 version;
+		u8 __rsv1[4];
+		__le16 len;
+	} __packed req = {
+		.args[0] = cpu_to_le32(MCU_WA_PARAM_RED_SETTING),
+		.cmd = RED_DUMP_CTRL,
+		.len = cpu_to_le16(sizeof(req) - sizeof(req.args)),
+	};
+	int ret;
+
+	/* the WA debug shell (SDO, RED, AC tail drop) only exists on MT7916+ */
+	if (is_mt7915(&dev->mt76))
+		return -EOPNOTSUPP;
+
+	if (!dev->fw.debug_wa)
+		mt7915_mcu_fw_log_2_host(dev, MCU_FW_LOG_WA,
+					 MCU_FW_LOG_TO_HOST);
+
+	if (cmd <= 1) {
+		mt76_mcu_send_msg(&dev->mt76, MCU_WA_PARAM_CMD(SET),
+				  &req, sizeof(req), false);
+		mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(QUERY),
+				  MCU_WA_QUERY_AC_TAIL_DROP, 0, 0);
+		mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(QUERY),
+				  MCU_WA_QUERY_MSDU_DEBUG, 0, 0);
+		ret = mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(QUERY),
+					MCU_WA_QUERY_SDO_INFO, 0, 0);
+	} else {
+		ret = mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(QUERY),
+					cmd, 0, 0);
+	}
+
+	if (!dev->fw.debug_wa)
+		mt7915_mcu_fw_log_2_host(dev, MCU_FW_LOG_WA, 0);
+
+	return ret;
+}
+
+static u16 mt7915_wed_target_ms(void)
+{
+	return clamp_t(unsigned int, READ_ONCE(mt7915_wed_target_delay), 10, 1000);
+}
+
+/* wed_target_delay or wed_autotune changed since the last update */
+bool mt7915_wed_tune_changed(struct mt7915_dev *dev)
+{
+	return mt7915_wed_target_ms() != dev->wed_target_ms ||
+	       READ_ONCE(mt7915_wed_autotune) != dev->wed_autotune;
+}
+
+int mt7915_mcu_wed_tune_update(struct mt7915_dev *dev, bool force)
+{
+	u32 max_rate_mbps[2] = { 72, 400 };
+	u16 target_ms, b_hi[2], b_lo[2], all_hi, all_lo;
+	bool autotune;
+	u8 band;
+	int i, ret;
+
+	/* MT7915 WA has no RED_SETTING/drop-threshold/SDO commands */
+	if (is_mt7915(&dev->mt76))
+		return 0;
+
+	if (!mtk_wed_device_active(&dev->mt76.mmio.wed))
+		return 0;
+
+	target_ms = mt7915_wed_target_ms();
+	autotune = READ_ONCE(mt7915_wed_autotune);
+	if (target_ms != dev->wed_target_ms || autotune != dev->wed_autotune) {
+		dev->wed_target_ms = target_ms;
+		dev->wed_autotune = autotune;
+		force = true;
+	}
+
+	for (i = 1; i < MT7915_WTBL_STA; i++) {
+		struct mt76_wcid *wcid =
+			rcu_dereference_protected(dev->mt76.wcid[i],
+						  lockdep_is_held(&dev->mt76.mutex));
+		struct mt7915_sta *msta;
+		struct rate_info rate;
+		u32 rate_100k, rate_mbps, max_tok, tok, diff;
+
+		if (!wcid || !wcid->sta)
+			continue;
+
+		msta = container_of(wcid, struct mt7915_sta, wcid);
+		band = wcid->phy_idx ? 1 : 0;
+
+		spin_lock_bh(&dev->mt76.sta_poll_lock);
+		rate = wcid->rate;
+		spin_unlock_bh(&dev->mt76.sta_poll_lock);
+
+		/*
+		 * Idle stations report the legacy rate of management or null
+		 * frames (1/6 Mbps); keep their last data threshold.
+		 */
+		if (rate.flags & (RATE_INFO_FLAGS_MCS |
+				  RATE_INFO_FLAGS_VHT_MCS |
+				  RATE_INFO_FLAGS_HE_MCS))
+			rate_100k = cfg80211_calculate_bitrate(&rate);
+		else
+			rate_100k = 0;
+
+		if (!rate_100k && msta->wed_tokens && !force)
+			continue;
+
+		rate_mbps = rate_100k ? max_t(u32, rate_100k / 10, 10) :
+					(band ? 400 : 72);
+		if (rate_mbps > max_rate_mbps[band])
+			max_rate_mbps[band] = rate_mbps;
+
+		max_tok = band ? 3072 : 1024;
+
+		/* the band watermarks below still follow the station rates */
+		if (!autotune) {
+			/*
+			 * The WA firmware computes the threshold of a station
+			 * the host never set one for.  One the host did set
+			 * cannot be handed back: RED_RELEASE_STA_THRES_FROM_HOST
+			 * hung the MT7916 WA firmware.  Lift it to the band
+			 * maximum instead; the firmware takes the station over
+			 * when it associates again.
+			 */
+			if (msta->wed_tokens && msta->wed_tokens != max_tok) {
+				msta->wed_tokens = max_tok;
+				mt7915_red_set_sta_dropth(dev, i, max_tok);
+			}
+			continue;
+		}
+
+		tok = clamp_t(u32, (rate_mbps * target_ms) / 16, 64, max_tok);
+		diff = abs((int)tok - (int)msta->wed_tokens);
+		if (force || !msta->wed_tokens || diff > msta->wed_tokens / 5) {
+			msta->wed_tokens = tok;
+			mt7915_red_set_sta_dropth(dev, i, tok);
+		}
+	}
+
+	b_hi[0] = clamp_t(u32, (max_rate_mbps[0] * target_ms) / 8, 384, 1024);
+	b_lo[0] = (b_hi[0] * 3) / 4;
+	b_hi[1] = clamp_t(u32, (max_rate_mbps[1] * target_ms) / 8, 512, 3072);
+	b_lo[1] = (b_hi[1] * 3) / 4;
+
+	if (!force &&
+	    abs((int)b_hi[0] - (int)dev->wed_band_hi[0]) <= dev->wed_band_hi[0] / 5 &&
+	    abs((int)b_hi[1] - (int)dev->wed_band_hi[1]) <= dev->wed_band_hi[1] / 5)
+		return 0;
+
+	dev->wed_band_hi[0] = b_hi[0];
+	dev->wed_band_hi[1] = b_hi[1];
+
+	all_hi = clamp_t(u32, (u32)b_hi[0] + b_hi[1], 1024,
+			 MT7915_HW_TOKEN_SIZE - 256);
+	all_lo = (all_hi * 3) / 4;
+
+	ret = mt7915_red_set_watermarks(dev, all_hi, all_lo,
+					b_hi[0], b_lo[0], b_hi[1], b_lo[1]);
+	if (ret < 0)
+		return ret;
+
+	mt7915_wa_set_ps_flush(dev, 32, clamp_t(u16, all_lo / 2, 128, 1024));
+
+	for (band = 0; band < 2; band++) {
+		u16 hi = b_hi[band];
+
+		mt7915_wa_set_ac_tail_drop(dev, band, 0, 32, max_t(u16, 64, hi / 2));
+		mt7915_wa_set_ac_tail_drop(dev, band, 1, 64, hi);
+		mt7915_wa_set_ac_tail_drop(dev, band, 2, 64, max_t(u16, 128, hi / 2));
+		mt7915_wa_set_ac_tail_drop(dev, band, 3, 64, max_t(u16, 96, hi / 4));
+		mt7915_wa_set_ac_tail_drop(dev, band, 4, 16, 128);
+	}
+
+	return 0;
+}
+
 static int mt7915_mcu_set_red(struct mt7915_dev *dev, bool enabled)
 {
 #define RED_DISABLE		0
@@ -2426,8 +2755,15 @@ static int mt7915_mcu_set_red(struct mt7
 	if (ret < 0)
 		return ret;
 
-	return mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(SET),
-				 MCU_WA_PARAM_RED, enabled, 0);
+	ret = mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(SET),
+				MCU_WA_PARAM_RED, enabled, 0);
+	if (ret < 0)
+		return ret;
+
+	if (enabled)
+		mt7915_mcu_wed_tune_update(dev, true);
+
+	return 0;
 }
 
