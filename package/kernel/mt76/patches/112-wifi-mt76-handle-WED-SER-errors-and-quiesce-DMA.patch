+		mutex_unlock(&dev->mt76.mutex);
+		return false;
+	}
 
 	mt7996_for_each_phy(dev, phy) {
 		phy->omac_mask = 0;
@@ -2550,6 +2564,8 @@ mt7996_mac_full_reset(struct mt7996_dev
