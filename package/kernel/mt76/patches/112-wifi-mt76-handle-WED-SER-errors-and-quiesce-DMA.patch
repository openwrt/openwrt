From b36e537e6d5025107491c57abc17bd4a191ddcab Mon Sep 17 00:00:00 2001
From: Shi Jiayang <shi05275@163.com>
Date: Wed, 18 Nov 2026 10:57:06 +0800
Subject: [PATCH] wifi: mt76: handle WED SER errors and quiesce DMA

Propagate WED DMA reset failures through mt7996 and mt7915 recovery.
Do not announce DMA readiness or restart firmware without a valid TX
pool. Balance NAPI and worker state so allocation can be retried, and
leave queues stopped after the bounded full-reset attempts are exhausted.

Stop attached WED engines before forced queue cleanup or a WLAN endpoint
reset. Preserve the non-forced L1 recovery sequence.

Drain the token IDR and clear WED token accounting under the same lock.
Wake offload waiters only after token and pending management state have
been reset, preventing stale counts from blocking subsequent offload.

Use an mt76 wrapper to return success when WED is disabled, where
the kernel DMA reset stub is a statement.

Signed-off-by: Shi Jiayang <shi05275@163.com>
---
 mt76.h            |    9 ++++++
 mt76_connac_mac.c |    4 ++-
 mt7915/dma.c      |   10 ++++++-
 mt7915/mac.c      |   72 +++++++++++++++++++++++++++++++++++++-----------------
 mt7996/dma.c      |   25 +++++++++++++++---
 mt7996/mac.c      |   62 ++++++++++++++++++++++++++++++++++++----------
 mt7996/mt7996.h   |    2 -
 7 files changed, 139 insertions(+), 45 deletions(-)

--- a/mt76_connac_mac.c
+++ b/mt76_connac_mac.c
@@ -1224,13 +1224,15 @@ void mt76_connac2_tx_token_put(struct mt
 		mt76_connac2_txwi_free(dev, txwi, NULL, NULL);
 		dev->token_count--;
 	}
-	spin_unlock_bh(&dev->token_lock);
 	idr_destroy(&dev->token);
+	dev->wed_token_count = 0;
+	spin_unlock_bh(&dev->token_lock);
 
 	for (id = 0; id < __MT_MAX_BAND; id++) {
 		struct mt76_phy *phy = dev->phys[id];
 		if (phy)
 			atomic_set(&phy->mgmt_tx_pending, 0);
 	}
+	wake_up(&dev->tx_wait);
 }
 EXPORT_SYMBOL_GPL(mt76_connac2_tx_token_put);
--- a/mt7915/dma.c
+++ b/mt7915/dma.c
@@ -591,7 +591,11 @@ int mt7915_dma_reset(struct mt7915_dev *
 {
 	struct mt76_phy *mphy_ext = dev->mt76.phys[MT_BAND1];
 	struct mtk_wed_device *wed = &dev->mt76.mmio.wed;
-	int i;
+	int i, ret = 0;
+
+	/* Quiesce external DMA before cleaning queues or resetting WFSYS. */
+	if (force && mtk_wed_device_active(wed))
+		mtk_wed_device_stop(wed);
 
 	/* clean up hw queues */
 	for (i = 0; i < ARRAY_SIZE(dev->mt76.phy.q_tx); i++) {
@@ -611,10 +615,12 @@ int mt7915_dma_reset(struct mt7915_dev *
 		mt7915_wfsys_reset(dev);
 
 	if (mtk_wed_device_active(wed))
-		mtk_wed_device_dma_reset(wed);
+		ret = mt76_wed_device_dma_reset(wed);
 
 	mt7915_dma_disable(dev, force);
 	mt76_wed_dma_reset(&dev->mt76);
+	if (ret)
+		return ret;
 
 	/* reset hw queues */
 	for (i = 0; i < __MT_TXQ_MAX; i++) {
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -1337,7 +1337,7 @@ mt7915_mac_restart(struct mt7915_dev *de
 	mt76_connac2_tx_token_put(&dev->mt76);
 	idr_init(&dev->mt76.token);
 
-	mt7915_dma_reset(dev, true);
+	ret = mt7915_dma_reset(dev, true);
 
 	mt76_for_each_q_rx(mdev, i) {
 		if (mdev->q_rx[i].ndesc) {
@@ -1345,6 +1345,9 @@ mt7915_mac_restart(struct mt7915_dev *de
 		}
 	}
 
+	if (ret)
+		goto out;
+
 	local_bh_disable();
 	mt76_for_each_q_rx(mdev, i) {
 		if (mdev->q_rx[i].ndesc) {
@@ -1406,23 +1409,27 @@ mt7915_mac_restart(struct mt7915_dev *de
 	}
 
 out:
-	/* reset done */
-	clear_bit(MT76_RESET, &dev->mphy.state);
-	if (phy2)
-		clear_bit(MT76_RESET, &phy2->mt76->state);
+	/* Keep reset state until a recovery attempt succeeds. */
+	if (!ret) {
+		clear_bit(MT76_RESET, &dev->mphy.state);
+		if (phy2)
+			clear_bit(MT76_RESET, &phy2->mt76->state);
+	}
 
 	napi_enable(&dev->mt76.tx_napi);
 
-	local_bh_disable();
-	napi_schedule(&dev->mt76.tx_napi);
-	local_bh_enable();
+	if (!ret) {
+		local_bh_disable();
+		napi_schedule(&dev->mt76.tx_napi);
+		local_bh_enable();
+	}
 
 	mt76_worker_enable(&dev->mt76.tx_worker);
 
 	return ret;
 }
 
-static void
+static bool
 mt7915_mac_full_reset(struct mt7915_dev *dev)
 {
 	struct mt76_phy *ext_phy;
@@ -1452,8 +1459,12 @@ mt7915_mac_full_reset(struct mt7915_dev
 			break;
 	}
 
-	if (i == 10)
-		dev_err(dev->mt76.dev, "chip full reset failed\n");
+	if (i == 10) {
+		dev_err(dev->mt76.dev, "chip full reset failed, leaving queues stopped\n");
+		dev->recovery.hw_full_reset = false;
+		mutex_unlock(&dev->mt76.mutex);
+		return false;
+	}
 
 	dev->phy.omac_mask = 0;
 	if (phy2)
@@ -1477,6 +1488,8 @@ mt7915_mac_full_reset(struct mt7915_dev
 	ieee80211_restart_hw(mt76_hw(dev));
 	if (ext_phy)
 		ieee80211_restart_hw(ext_phy->hw);
+
+	return true;
 }
 
 /* system error recovery */
@@ -1485,7 +1498,7 @@ void mt7915_mac_reset_work(struct work_s
 	struct mt7915_phy *phy2;
 	struct mt76_phy *ext_phy;
 	struct mt7915_dev *dev;
-	int i;
+	int i, ret = 0;
 
 	dev = container_of(work, struct mt7915_dev, reset_work);
 	ext_phy = dev->mt76.phys[MT_BAND1];
@@ -1502,7 +1515,10 @@ void mt7915_mac_reset_work(struct work_s
 		else
 			dev->recovery.wm_reset_count++;
 
-		mt7915_mac_full_reset(dev);
+		if (!mt7915_mac_full_reset(dev)) {
+			dev->recovery.restart = false;
+			return;
+		}
 
 		/* enable mcu irq */
 		mt7915_irq_enable(dev, MT_INT_MCU_CMD);
@@ -1547,7 +1563,9 @@ void mt7915_mac_reset_work(struct work_s
 	mt76_wr(dev, MT_MCU_INT_EVENT, MT_MCU_INT_EVENT_DMA_STOPPED);
 
 	if (mt7915_wait_reset_state(dev, MT_MCU_CMD_RESET_DONE)) {
-		mt7915_dma_reset(dev, false);
+		ret = mt7915_dma_reset(dev, false);
+		if (ret)
+			goto resume_napi;
 
 		mt76_connac2_tx_token_put(&dev->mt76);
 		idr_init(&dev->mt76.token);
@@ -1567,21 +1585,31 @@ void mt7915_mac_reset_work(struct work_s
 	if (phy2)
 		clear_bit(MT76_RESET, &phy2->mt76->state);
 
-	mt76_for_each_q_rx(&dev->mt76, i) {
+resume_napi:
+	mt76_for_each_q_rx(&dev->mt76, i)
 		napi_enable(&dev->mt76.napi[i]);
-	}
 
-	local_bh_disable();
-	mt76_for_each_q_rx(&dev->mt76, i) {
-		napi_schedule(&dev->mt76.napi[i]);
-	}
-	local_bh_enable();
+	if (!ret) {
+		local_bh_disable();
+		mt76_for_each_q_rx(&dev->mt76, i)
+			napi_schedule(&dev->mt76.napi[i]);
+		local_bh_enable();
 
-	tasklet_schedule(&dev->mt76.irq_tasklet);
+		tasklet_schedule(&dev->mt76.irq_tasklet);
+	}
 
 	mt76_worker_enable(&dev->mt76.tx_worker);
 
 	napi_enable(&dev->mt76.tx_napi);
+	if (ret) {
+		mutex_unlock(&dev->mt76.mutex);
+		dev_err(dev->mt76.dev,
+			"WED DMA reset failed: %d, retrying full recovery\n", ret);
+		dev->recovery.restart = true;
+		queue_work(dev->mt76.wq, &dev->reset_work);
+		return;
+	}
+
 	local_bh_disable();
 	napi_schedule(&dev->mt76.tx_napi);
 	local_bh_enable();
--- a/mt7996/dma.c
+++ b/mt7996/dma.c
@@ -994,12 +994,20 @@ int mt7996_dma_init(struct mt7996_dev *d
 	return 0;
 }
 
-void mt7996_dma_reset(struct mt7996_dev *dev, bool force)
+int mt7996_dma_reset(struct mt7996_dev *dev, bool force)
 {
 	struct mt76_phy *phy2 = dev->mt76.phys[MT_BAND1];
 	struct mt76_phy *phy3 = dev->mt76.phys[MT_BAND2];
 	u32 hif1_ofs = MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0);
-	int i;
+	int i, ret = 0, err;
+
+	/* Quiesce external DMA before cleaning queues or resetting WFSYS. */
+	if (force) {
+		if (mtk_wed_device_active(&dev->mt76.mmio.wed_hif2))
+			mtk_wed_device_stop(&dev->mt76.mmio.wed_hif2);
+		if (mtk_wed_device_active(&dev->mt76.mmio.wed))
+			mtk_wed_device_stop(&dev->mt76.mmio.wed);
+	}
 
 	mt76_clear(dev, MT_WFDMA0_GLO_CFG,
 		   MT_WFDMA0_GLO_CFG_TX_DMA_EN |
@@ -1037,14 +1045,19 @@ void mt7996_dma_reset(struct mt7996_dev
 		mt7996_wfsys_reset(dev);
 
 	if (dev->hif2 && mtk_wed_device_active(&dev->mt76.mmio.wed_hif2))
-		mtk_wed_device_dma_reset(&dev->mt76.mmio.wed_hif2);
+		ret = mt76_wed_device_dma_reset(&dev->mt76.mmio.wed_hif2);
 
-	if (mtk_wed_device_active(&dev->mt76.mmio.wed))
-		mtk_wed_device_dma_reset(&dev->mt76.mmio.wed);
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed)) {
+		err = mt76_wed_device_dma_reset(&dev->mt76.mmio.wed);
+		if (!ret)
+			ret = err;
+	}
 
 	mt76_npu_disable_irqs(&dev->mt76);
 	mt7996_dma_disable(dev, force);
 	mt76_wed_dma_reset(&dev->mt76);
+	if (ret)
+		return ret;
 
 	/* reset hw queues */
 	for (i = 0; i < __MT_TXQ_MAX; i++) {
@@ -1085,6 +1098,8 @@ void mt7996_dma_reset(struct mt7996_dev
 	}
 
 	mt7996_dma_enable(dev, !force);
+
+	return 0;
 }
 
 void mt7996_dma_cleanup(struct mt7996_dev *dev)
