--- /dev/null
+++ b/mt7915/npu.c
@@ -0,0 +1,234 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2026 AIROHA Inc
+ */
+#include <linux/kernel.h>
+#include <linux/soc/airoha/airoha_offload.h>
+
+#include "mt7915.h"
+#include "../dma.h"
+
+#define MT7916_DRIVER_MODEL_D	2
+
+/* The NPU's ring for each band, programmed into the chip's rx data rings */
+static int mt7915_npu_rxd_get(struct mt7915_dev *dev, struct airoha_npu *npu)
+{
+	int err;
+
+	if (!dev->phy.mt76->band_idx) {
+		err = mt76_npu_get_msg(npu, 0, WLAN_FUNC_GET_WAIT_RXDESC_BASE,
+				       &dev->npu_rxd_base[0], GFP_KERNEL);
+		if (err) {
+			dev_warn(dev->mt76.dev,
+				 "failed retrieving NPU wlan rx ring0 addr\n");
+			return err;
+		}
+	}
+
+	if (dev->dbdc_support || dev->phy.mt76->band_idx) {
+		err = mt76_npu_get_msg(npu, 1, WLAN_FUNC_GET_WAIT_RXDESC_BASE,
+				       &dev->npu_rxd_base[1], GFP_KERNEL);
+		if (err) {
+			dev_warn(dev->mt76.dev,
+				 "failed retrieving NPU wlan rx ring1 addr\n");
+			return err;
+		}
+	}
+
+	return 0;
+}
+
+static void mt7915_npu_rxd_set(struct mt7915_dev *dev)
+{
+	if (!dev->phy.mt76->band_idx)
+		writel(dev->npu_rxd_base[0],
+		       &dev->mt76.q_rx[MT_RXQ_MAIN].regs->desc_base);
+
+	if (dev->dbdc_support || dev->phy.mt76->band_idx)
+		writel(dev->npu_rxd_base[1],
+		       &dev->mt76.q_rx[MT_RXQ_BAND1].regs->desc_base);
+}
+
+static int mt7915_npu_offload_init(struct mt7915_dev *dev,
+				   struct airoha_npu *npu)
+{
+	dma_addr_t phy_addr = dev->mt76.mmio.phy_addr;
+	u32 val, dma_addr, port_type = dev->mt76.mmio.npu_type;
+	int err;
+
+	/*
+	 * Informational only, and not every NPU firmware has it: the MT7916
+	 * one answers "func not support".  Say nothing when it is missing.
+	 */
+	if (!mt76_npu_get_msg(npu, 0, WLAN_FUNC_GET_WAIT_NPU_VERSION,
+			      &val, GFP_KERNEL))
+		dev_info(dev->mt76.dev, "NPU version: %0d.%d\n",
+			 (val >> 16) & 0xffff, val & 0xffff);
+
+	/* Set driver model to MT7916_D (2) */
+	err = mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_DRIVER_MODEL,
+				MT7916_DRIVER_MODEL_D, GFP_KERNEL);
+	if (err) {
+		dev_warn(dev->mt76.dev,
+			 "failed setting NPU driver model\n");
+		return err;
+	}
+
+	err = mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_PCIE_PORT_TYPE,
+				dev->hif2 ? port_type : (port_type & 1),
+				GFP_KERNEL);
+	if (err) {
+		dev_warn(dev->mt76.dev,
+			 "failed setting NPU wlan PCIe port type\n");
+		return err;
+	}
+
+	/* Band 0 RX ring base */
+	if (!dev->phy.mt76->band_idx) {
+		err = mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_DESC,
+					MT7915_RX_RING_SIZE, GFP_KERNEL);
+		if (err)
+			return err;
+
+		/*
+		 * The ring's own registers: MT_RXQ_RING_BASE() is the start of
+		 * the RX ring block (ring 0, the MCU WM events), the NPU writes
+		 * the CIDX at +8 of what it is given (as mt76_queue_alloc()).
+		 */
+		dma_addr = phy_addr + MT_RXQ_RING_BASE(MT_RXQ_MAIN) +
+			   MT_RXQ_ID(MT_RXQ_MAIN) * MT_RING_SIZE;
+		err = mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_PCIE_ADDR,
+					dma_addr, GFP_KERNEL);
+		if (err)
+			return err;
+	}
+
+	/* Band 1 RX ring base */
+	if (dev->dbdc_support || dev->phy.mt76->band_idx) {
+		u32 hif1_ofs = dev->hif2 ? MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0) : 0;
+
+		err = mt76_npu_send_msg(npu, 1, WLAN_FUNC_SET_WAIT_DESC,
+					MT7915_RX_RING_SIZE, GFP_KERNEL);
+		if (err)
+			return err;
+
+		dma_addr = phy_addr + MT_RXQ_RING_BASE(MT_RXQ_BAND1) +
+			   MT_RXQ_ID(MT_RXQ_BAND1) * MT_RING_SIZE + hif1_ofs;
+		err = mt76_npu_send_msg(npu, 1, WLAN_FUNC_SET_WAIT_PCIE_ADDR,
+					dma_addr, GFP_KERNEL);
+		if (err)
+			return err;
+	}
+
+	return 0;
+}
+
+static int mt7915_npu_rx_queues_init(struct mt7915_dev *dev)
+{
+	int err;
+
+	err = mt76_npu_rx_queue_init(&dev->mt76,
+				     &dev->mt76.q_rx[MT_RXQ_NPU0]);
+	if (err)
+		return err;
+
+	return mt76_npu_rx_queue_init(&dev->mt76,
+				      &dev->mt76.q_rx[MT_RXQ_NPU1]);
+}
+
+/* Drop the NPU again and leave the device to the host path */
+static void mt7915_npu_disable(struct mt7915_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	struct airoha_npu *npu = rcu_access_pointer(mdev->mmio.npu);
+	/* the WED, when there is one, has taken dma_dev over already */
+	bool npu_dma = npu && mdev->dma_dev == npu->dev;
+	int i;
+
+	for (i = MT_RXQ_NPU0; i <= MT_RXQ_NPU1; i++) {
+		struct napi_struct *napi = &mdev->napi[i];
+
+		if (test_bit(NAPI_STATE_LISTED, &napi->state)) {
+			napi_disable(napi);
+			netif_napi_del(napi);
+		}
+	}
+
+	mt76_npu_deinit(mdev);
+
+	for (i = MT_RXQ_NPU0; i <= MT_RXQ_NPU1; i++)
+		mdev->q_rx[i].ndesc = 0;
+
+	if (npu_dma)
+		mdev->dma_dev = mdev->dev;
+	mdev->hwrro_mode = MT76_HWRRO_OFF;
+}
+
+/* The NPU rx queues; true when the NPU had to be dropped */
+bool mt7915_npu_rx_setup(struct mt7915_dev *dev)
+{
+	int err;
+
+	if (!mt76_npu_device_active(&dev->mt76))
+		return false;
+
+	err = mt7915_npu_rx_queues_init(dev);
+	if (!err)
+		return false;
+
+	dev_warn(dev->mt76.dev,
+		 "NPU rx queues failed (%d)! Fallback to CPU\n", err);
+	mt7915_npu_disable(dev);
+
+	return true;
+}
+
+/* After a reset: the NPU is told everything again */
+int __mt7915_npu_hw_init(struct mt7915_dev *dev)
+{
+	struct airoha_npu *npu;
+	int i, err;
+
+	npu = rcu_dereference_protected(dev->mt76.mmio.npu, &dev->mt76.mutex);
+	if (!npu)
+		return 0;
+
+	err = mt7915_npu_offload_init(dev, npu);
+	if (err)
+		return err;
+
+	err = mt7915_npu_rxd_get(dev, npu);
+	if (err)
+		return err;
+
+	mt7915_npu_rxd_set(dev);
+
+	for (i = MT_RXQ_NPU0; i <= MT_RXQ_NPU1; i++)
+		airoha_npu_wlan_enable_irq(npu, i - MT_RXQ_NPU0);
+
+	return 0;
+}
+
+/*
+ * Probe, after the DMA has started (the order the NPU firmware was proven
+ * with): tell the NPU everything, then point the chip's data rx rings at
+ * the NPU's.  On a failure before that last step the rings still hold the
+ * host's buffers: drop the NPU and let the host take the rx.
+ */
+int mt7915_npu_hw_init(struct mt7915_dev *dev)
+{
+	int err;
+
+	mutex_lock(&dev->mt76.mutex);
+	err = __mt7915_npu_hw_init(dev);
+	mutex_unlock(&dev->mt76.mutex);
+	if (!err)
+		return 0;
+
+	dev_warn(dev->mt76.dev,
+		 "NPU initialization failed (%d)! Fallback to CPU\n", err);
+	mt7915_npu_disable(dev);
+	mt7915_dma_npu_fallback(dev);
+
+	return 0;
+}
--- a/mt7915/pci.c
+++ b/mt7915/pci.c
@@ -6,6 +6,7 @@
 
 #include <linux/kernel.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/pci.h>
 
 #include "mt7915.h"
@@ -136,6 +137,12 @@ static int mt7915_pci_probe(struct pci_d
 	mdev = &dev->mt76;
 	mt7915_wfsys_reset(dev);
 
+	if (mt76_npu_init(mdev, pci_resource_start(pdev, 0),
+			  pci_domain_nr(pdev->bus) ? 3 : 2) &&
+	    of_property_present(pdev->dev.of_node, "airoha,npu"))
+		dev_warn(&pdev->dev,
+			 "NPU initialization failed! Fallback to CPU\n");
+
 	ret = mt7915_mmio_wed_init(dev, pdev, true, &irq);
 	if (ret < 0)
 		goto free_wed_or_irq_vector;
--- a/npu.c
+++ b/npu.c
@@ -527,3 +527,4 @@ void mt76_npu_deinit(struct mt76_dev *de
 	mt76_npu_queue_cleanup(dev, &dev->q_rx[MT_RXQ_NPU0]);
 	mt76_npu_queue_cleanup(dev, &dev->q_rx[MT_RXQ_NPU1]);
 }
+EXPORT_SYMBOL_GPL(mt76_npu_deinit);
