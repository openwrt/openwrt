From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lukasz M <lukasz1992m+openwrt@gmail.com>
Date: Sat, 31 Oct 2026 12:00:00 +0100
Subject: [PATCH] mt7915 add npu offload support

Add support for offloading WiFi RX packet processing to the Kite NPU
(RV32) on Airoha AN7552/AN7563 SoCs paired with MT7916 PCIe wireless chips.

The NPU is given the registers of the band's own rx ring (ring base +
ring id * MT_RING_SIZE), not the start of the rx ring block, and the NPU
version request is optional (the MT7916 firmware does not have it).

Frames handed over by the NPU are trimmed to the length in their RXD
(pskb_trim(): a frame of several segments comes with frags).

When the NPU rx queues cannot be had, or the NPU does not answer, the
driver says "... Fallback to CPU", drops the NPU and gives the data rx
rings and their interrupts back to the host instead of failing the probe.
The chip's rings are pointed at the NPU's only as the last step, so until
then they still hold the host's buffers.

Signed-off-by: Lukasz M <lukasz1992m+openwrt@gmail.com>
---
--- a/mt7915/Makefile
+++ b/mt7915/Makefile
@@ -9,3 +9,4 @@ mt7915e-y := pci.o init.o dma.o eeprom.o
 mt7915e-$(CONFIG_NL80211_TESTMODE) += testmode.o
 mt7915e-$(CONFIG_MT798X_WMAC) += soc.o
 mt7915e-$(CONFIG_DEV_COREDUMP) += coredump.o
+mt7915e-$(CONFIG_MT76_NPU) += npu.o
--- a/mt7915/dma.c
+++ b/mt7915/dma.c
@@ -104,14 +104,25 @@ static void mt7915_dma_config(struct mt7
 			TXQ_CONFIG(1, WFDMA0, MT_INT_WED_TX_DONE_BAND1,
 				   MT7915_TXQ_BAND1);
 		} else {
-			RXQ_CONFIG(MT_RXQ_MAIN, WFDMA0, MT_INT_RX_DONE_BAND0_MT7916,
-				   MT7916_RXQ_BAND0);
-			RXQ_CONFIG(MT_RXQ_MCU_WA, WFDMA0, MT_INT_RX_DONE_WA,
-				   MT7916_RXQ_MCU_WA);
-			RXQ_CONFIG(MT_RXQ_BAND1, WFDMA0, MT_INT_RX_DONE_BAND1_MT7916,
-				   MT7916_RXQ_BAND1);
-			RXQ_CONFIG(MT_RXQ_MAIN_WA, WFDMA0, MT_INT_RX_DONE_WA_MAIN_MT7916,
-				   MT7916_RXQ_MCU_WA_MAIN);
+			if (mt76_npu_device_active(&dev->mt76)) {
+				RXQ_CONFIG(MT_RXQ_MAIN, WFDMA0, 0,
+					   MT7916_RXQ_BAND0);
+				RXQ_CONFIG(MT_RXQ_MCU_WA, WFDMA0, MT_INT_RX_DONE_WA,
+					   MT7916_RXQ_MCU_WA);
+				RXQ_CONFIG(MT_RXQ_BAND1, WFDMA0, 0,
+					   MT7916_RXQ_BAND1);
+				RXQ_CONFIG(MT_RXQ_MAIN_WA, WFDMA0, MT_INT_RX_DONE_WA_MAIN_MT7916,
+					   MT7916_RXQ_MCU_WA_MAIN);
+			} else {
+				RXQ_CONFIG(MT_RXQ_MAIN, WFDMA0, MT_INT_RX_DONE_BAND0_MT7916,
+					   MT7916_RXQ_BAND0);
+				RXQ_CONFIG(MT_RXQ_MCU_WA, WFDMA0, MT_INT_RX_DONE_WA,
+					   MT7916_RXQ_MCU_WA);
+				RXQ_CONFIG(MT_RXQ_BAND1, WFDMA0, MT_INT_RX_DONE_BAND1_MT7916,
+					   MT7916_RXQ_BAND1);
+				RXQ_CONFIG(MT_RXQ_MAIN_WA, WFDMA0, MT_INT_RX_DONE_WA_MAIN_MT7916,
+					   MT7916_RXQ_MCU_WA_MAIN);
+			}
 			TXQ_CONFIG(0, WFDMA0, MT_INT_TX_DONE_BAND0,
 				   MT7915_TXQ_BAND0);
 			TXQ_CONFIG(1, WFDMA0, MT_INT_TX_DONE_BAND1,
@@ -405,6 +416,21 @@ static int mt7915_dma_enable(struct mt79
 	return mt7915_dma_start(dev, reset, true);
 }
 
+/* The NPU was dropped: the data rx rings and their interrupts are the host's */
+void mt7915_dma_npu_fallback(struct mt7915_dev *dev)
+{
+	u32 mask = 0;
+
+	mt7915_dma_config(dev);
+
+	if (dev->mt76.q_rx[MT_RXQ_MAIN].ndesc)
+		mask |= MT_INT_RX(MT_RXQ_MAIN);
+	if (dev->mt76.q_rx[MT_RXQ_BAND1].ndesc)
+		mask |= MT_INT_RX(MT_RXQ_BAND1);
+	if (mask)
+		mt7915_irq_enable(dev, mask);
+}
+
 int mt7915_dma_init(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 {
 	struct mt76_dev *mdev = &dev->mt76;
@@ -578,6 +604,14 @@ int mt7915_dma_init(struct mt7915_dev *d
 	if (ret < 0)
 		return ret;
 
+	/*
+	 * After mt76_init_queues(): the NPU queues need its napi_dev and must
+	 * not get the generic rx NAPI.  If they cannot be had the NPU is
+	 * dropped and the data rx rings are the host's again.
+	 */
+	if (mt7915_npu_rx_setup(dev))
+		mt7915_dma_config(dev);
+
 	netif_napi_add_tx(dev->mt76.tx_napi_dev, &dev->mt76.tx_napi,
 			  mt7915_poll_tx);
 	napi_enable(&dev->mt76.tx_napi);
--- a/mt7915/init.c
+++ b/mt7915/init.c
@@ -1328,6 +1328,10 @@ int mt7915_register_device(struct mt7915
 
 	mt7915_init_wiphy(&dev->phy);
 
+	ret = mt7915_npu_hw_init(dev);
+	if (ret)
+		goto stop_hw;
+
 #ifdef CONFIG_NL80211_TESTMODE
 	dev->mt76.test_ops = &mt7915_testmode_ops;
 #endif
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -536,6 +536,7 @@ mt7915_mac_fill_rx(struct mt7915_dev *de
 		status->flag |= RX_FLAG_8023;
 		mt7915_wed_check_ppe(dev, &dev->mt76.q_rx[q], msta, skb,
 				     *info);
+		mt76_npu_check_ppe(&dev->mt76, skb, *info);
 	}
 
 	if (rxv && mode >= MT_PHY_TYPE_HE_SU && !(status->flag & RX_FLAG_8023))
@@ -1066,6 +1067,19 @@ void mt7915_queue_rx_skb(struct mt76_dev
 
 	type = le32_get_bits(rxd[0], MT_RXD0_PKT_TYPE);
 
+	/*
+	 * The NPU hands some frames over longer than the frame: the RXD has
+	 * the real length.  The skb can carry segments as frags.
+	 */
+	if (q == MT_RXQ_NPU0 || q == MT_RXQ_NPU1) {
+		u32 len = le32_get_bits(rxd[0], MT_RXD0_LENGTH);
+
+		if (len && len < skb->len && pskb_trim(skb, len)) {
+			dev_kfree_skb(skb);
+			return;
+		}
+	}
+
 	switch (type) {
 	case PKT_TYPE_TXRX_NOTIFY:
 		mt7915_mac_tx_free(dev, skb->data, skb->len);
@@ -1570,6 +1584,8 @@ void mt7915_mac_reset_work(struct work_s
 	/* enable DMA Tx/Rx and interrupt */
 	mt7915_dma_start(dev, false, false);
 
+	__mt7915_npu_hw_init(dev);
+
 	clear_bit(MT76_MCU_RESET, &dev->mphy.state);
 	clear_bit(MT76_RESET, &dev->mphy.state);
 	if (phy2)
--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -1840,6 +1840,27 @@ mt7915_reconfig_complete(struct ieee8021
 				     MT7915_WATCHDOG_TIME);
 }
 
+#if defined(CONFIG_NET_MEDIATEK_SOC_WED) || defined(CONFIG_MT76_NPU)
+static int
+mt7915_net_setup_tc(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+		    struct net_device *netdev, enum tc_setup_type type,
+		    void *type_data)
+{
+	struct mt7915_dev *dev = mt7915_hw_dev(hw);
+	struct mtk_wed_device *wed = &dev->mt76.mmio.wed;
+
+	/*
+	 * The ingress block of the wlan netdev belongs to whoever receives
+	 * Wi-Fi: a WED with RX, else the NPU.  A TX-only WED (MT7916 on
+	 * AN7552) has no RX hook and would only refuse it.
+	 */
+	if (mtk_wed_device_active(wed) && mtk_wed_get_rx_capa(wed))
+		return mt76_wed_net_setup_tc(hw, vif, netdev, type, type_data);
+
+	return mt76_npu_net_setup_tc(hw, vif, netdev, type, type_data);
+}
+#endif
+
 const struct ieee80211_ops mt7915_ops = {
 	.add_chanctx = ieee80211_emulate_add_chanctx,
 	.remove_chanctx = ieee80211_emulate_remove_chanctx,
@@ -1896,7 +1917,9 @@ const struct ieee80211_ops mt7915_ops =
 	.set_radar_background = mt7915_set_radar_background,
 #ifdef CONFIG_NET_MEDIATEK_SOC_WED
 	.net_fill_forward_path = mt7915_net_fill_forward_path,
-	.net_setup_tc = mt76_wed_net_setup_tc,
+#endif
+#if defined(CONFIG_NET_MEDIATEK_SOC_WED) || defined(CONFIG_MT76_NPU)
+	.net_setup_tc = mt7915_net_setup_tc,
 #endif
 	.reconfig_complete = mt7915_reconfig_complete,
 };
--- a/mt7915/mmio.c
+++ b/mt7915/mmio.c
@@ -819,6 +819,15 @@ static void mt7915_rx_poll_complete(stru
 {
 	struct mt7915_dev *dev = container_of(mdev, struct mt7915_dev, mt76);
 
+	if (q == MT_RXQ_NPU0 || q == MT_RXQ_NPU1) {
+		struct airoha_npu *npu;
+
+		npu = rcu_dereference(mdev->mmio.npu);
+		if (npu)
+			airoha_npu_wlan_enable_irq(npu, q - MT_RXQ_NPU0);
+		return;
+	}
+
 	mt7915_irq_enable(dev, MT_INT_RX(q));
 }
 
