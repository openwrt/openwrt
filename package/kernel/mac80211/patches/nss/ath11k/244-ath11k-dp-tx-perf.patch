 		       desc, sizeof(struct hal_wbm_release_ring));
-		tx_ring->tx_status_head =
-			ATH11K_TX_COMPL_NEXT(tx_ring->tx_status_head);
-	}
-
-	if (unlikely((ath11k_hal_srng_dst_peek(ab, status_ring) != NULL) &&
