+static struct reserved_mem *ath11k_ahb_get_rproc_reserved_mem(struct ath11k_base *ab)
+{
+	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
+	struct reserved_mem *rmem;
+	struct device_node *node;
+
+	if (!ab_ahb->tgt_rproc) {
+		ath11k_err(ab, "Cannot find rproc\n");
+		return ERR_PTR(-ENODEV);
+	}
+
+	node = of_parse_phandle(ab_ahb->tgt_rproc->dev.parent->parent->of_node,
+				"memory-region", 0);
+	if (!node) {
+		ath11k_err(ab, "Cannot find memory-region node\n");
+		return ERR_PTR(-ENODEV);
+	}
+
+	rmem = of_reserved_mem_lookup(node);
+	of_node_put(node);
+	if (!rmem) {
+		ath11k_err(ab, "Cannot find reserved memory\n");
+		return ERR_PTR(-ENODEV);
+	}
+
+	return rmem;
+}
+
+static int ath11k_ahb_load_m3_firmware(struct ath11k_base *ab)
+{
+	char m3_fw_name[ATH11K_M3_FW_NAME_LEN];
+	const struct firmware *m3_fw = NULL;
+	struct reserved_mem *rmem = NULL;
+	phys_addr_t mem_phys;
+	void *mem_region;
+	size_t mem_size;
+	int ret;
+
+	rmem = ath11k_ahb_get_rproc_reserved_mem(ab);
+	if (IS_ERR(rmem))
+		return PTR_ERR(rmem);
+
+	mem_phys = rmem->base;
+	mem_size = rmem->size;
+	mem_region = devm_memremap(ab->dev, mem_phys, mem_size, MEMREMAP_WC);
+
+	snprintf(m3_fw_name, sizeof(m3_fw_name), "%s/%s/%s",
+		 ATH11K_FW_DIR, ab->hw_params.fw.dir, ATH11K_M3_MDT_FILE);
+
+	ret = request_firmware(&m3_fw, m3_fw_name, ab->dev);
+	if (ret < 0) {
+		ath11k_err(ab, "request_firmware failed\n");
+		return ret;
+	}
+
+	if (!m3_fw->size) {
+		ath11k_err(ab, "Invalid firmware size\n");
+		ret = -EINVAL;
+		goto release_fw;
+	}
+
+	ret = qcom_mdt_load_no_init(ab->dev, m3_fw, m3_fw_name, 0, mem_region,
+				    mem_phys, mem_size, &mem_phys);
+	if (ret) {
+		ath11k_err(ab, "Failed to load MDT segments: %d\n", ret);
+		goto release_fw;
+	}
+
+release_fw:
+	if (m3_fw)
+		release_firmware(m3_fw);
+
+	return ret;
+}
+
 static int ath11k_ahb_power_up(struct ath11k_base *ab)
 {
 	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
 	int ret;
 
+	if (ab->hw_params.m3_fw_support &&
+	    ab->hw_params.fw.m3_loader == ath11k_m3_fw_loader_remoteproc) {
+		ret = ath11k_ahb_load_m3_firmware(ab);
+		if (ret) {
+			ath11k_err(ab, "failed to load m3 firmware: %d\n", ret);
+			return ret;
+		}
+	}
+
 	ret = rproc_boot(ab_ahb->tgt_rproc);
 	if (ret)
 		ath11k_err(ab, "failed to boot the remote processor Q6\n");
@@ -1120,7 +1205,7 @@ static int ath11k_get_userpd_id(struct d
 	ret = of_property_read_string(dev->of_node,
