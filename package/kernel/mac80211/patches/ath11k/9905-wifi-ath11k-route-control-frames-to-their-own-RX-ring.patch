From 48eaa605638fc471edc15c83bab4c26ec42eb872 Mon Sep 17 00:00:00 2001
From: Julius Bairaktaris <julius@bairaktaris.de>
Date: Sun, 15 Nov 2026 10:48:58 +0100
Subject: [PATCH] wifi: ath11k: route control frames to their own RX ring

The firmware has a packet routing command (WMI_PDEV_UPDATE_PKT_ROUTING_CMDID,
advertised by WMI_TLV_SERVICE_PKT_ROUTING) that ath11k never sends. It
makes the classification engine push EAPOL, ARP, neighbour solicitation,
DHCP, IGMP and MLD frames to a REO ring of the host's choice, instead of
the ring the per-peer hash picks for the flow.

Send it for each pdev when the radio starts, before any vdev is up (the
firmware ignores it afterwards), with REO2SW1 as the destination. Every
REO2SW ring is polled by the same handler, so the frames still take the
normal receive path and the EAPOL check on the host stays. The data
rings then carry only data frames.

Count the MSDUs received on each ring in the soc_dp_stats debugfs file.

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -921,6 +921,8 @@ struct ath11k_soc_dp_stats {
 	u32 rxdma_error[HAL_REO_ENTR_RING_RXDMA_ECODE_MAX];
 	u32 reo_error[HAL_REO_DEST_RING_ERROR_CODE_MAX];
 	u32 hal_reo_error[DP_REO_DST_RING_MAX];
+	/* MSDUs received on each REO2SW ring */
+	u64 rx_ring_msdu[DP_REO_DST_RING_MAX];
 	/* TCP batches the TCL segments, their segments, and batches that
 	 * were segmented in software instead
 	 */
--- a/drivers/net/wireless/ath/ath11k/debugfs.c
+++ b/drivers/net/wireless/ath/ath11k/debugfs.c
@@ -705,6 +705,14 @@ static ssize_t ath11k_debugfs_dump_soc_d
 			 soc_stats->hal_reo_error[2],
 			 soc_stats->hal_reo_error[3]);
 
+	len += scnprintf(buf + len, size - len, "\nMSDUs per REO ring:\n");
+	len += scnprintf(buf + len, size - len,
+			 "ring0: %llu\nring1: %llu\nring2: %llu\nring3: %llu\n",
+			 soc_stats->rx_ring_msdu[0],
+			 soc_stats->rx_ring_msdu[1],
+			 soc_stats->rx_ring_msdu[2],
+			 soc_stats->rx_ring_msdu[3]);
+
 	len += scnprintf(buf + len, size - len,
 			 "TCP batches segmented by the TCL: %d, their segments: %d, segmented in software: %d, frames with fragments sent as scatter-gather: %d\n",
 			 atomic_read(&soc_stats->tx_tso_batch),
--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -2991,6 +2991,8 @@ try_again:
 	if (unlikely(!total_msdu_reaped))
 		goto exit;
 
+	ab->soc_stats.rx_ring_msdu[ring_id] += total_msdu_reaped;
+
 	for (i = 0; i < ab->num_radios; i++) {
 		if (!num_buffs_reaped[i])
 			continue;
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -6781,6 +6781,9 @@ static int ath11k_mac_op_start(struct ie
 	/* Configure the hash seed for hash based reo dest ring selection */
 	ath11k_wmi_pdev_lro_cfg(ar, ar->pdev->pdev_id);
 
+	/* REO2SW1 is the first of the rings the datapath polls */
+	ath11k_wmi_pdev_pkt_routing(ar, ar->pdev->pdev_id, 1);
+
 	/* allow device to enter IMPS */
 	if (ab->hw_params.idle_ps) {
 		ret = ath11k_wmi_pdev_set_param(ar, WMI_PDEV_PARAM_IDLE_PS_CONFIG,
--- a/drivers/net/wireless/ath/ath11k/wmi.c
+++ b/drivers/net/wireless/ath/ath11k/wmi.c
@@ -4411,6 +4411,53 @@ err:
 	return ret;
 }
 
+/* Send the classification engine the frames that need the host's attention
+ * (not its fast path) to one fixed REO2SW ring, so the data rings only carry
+ * data. Every ring is polled the same way, so the frames still take the
+ * normal receive path. The firmware ignores the command once a vdev is up.
+ */
+int ath11k_wmi_pdev_pkt_routing(struct ath11k *ar, int pdev_id, u32 dest_ring)
+{
+	struct wmi_pdev_update_pkt_routing_cmd *cmd;
+	struct sk_buff *skb;
+	int ret;
+
+	if (!test_bit(WMI_TLV_SERVICE_PKT_ROUTING, ar->ab->wmi_ab.svc_map))
+		return 0;
+
+	skb = ath11k_wmi_alloc_skb(ar->wmi->wmi_ab, sizeof(*cmd));
+	if (!skb)
+		return -ENOMEM;
+
+	cmd = (struct wmi_pdev_update_pkt_routing_cmd *)skb->data;
+	cmd->tlv_header = FIELD_PREP(WMI_TLV_TAG, WMI_TAG_PDEV_UPDATE_PKT_ROUTING_CMD) |
+			  FIELD_PREP(WMI_TLV_LEN, sizeof(*cmd) - TLV_HDR_SIZE);
+	cmd->pdev_id = pdev_id;
+	cmd->op_code = WMI_PDEV_ADD_PKT_ROUTING;
+	cmd->routing_type_bitmap =
+		BIT(WMI_PDEV_ROUTING_TYPE_ARP_IPV4) |
+		BIT(WMI_PDEV_ROUTING_TYPE_NS_IPV6) |
+		BIT(WMI_PDEV_ROUTING_TYPE_IGMP_IPV4) |
+		BIT(WMI_PDEV_ROUTING_TYPE_MLD_IPV6) |
+		BIT(WMI_PDEV_ROUTING_TYPE_DHCP_IPV4) |
+		BIT(WMI_PDEV_ROUTING_TYPE_DHCP_IPV6) |
+		BIT(WMI_PDEV_ROUTING_TYPE_EAP);
+	cmd->dest_ring = dest_ring;
+	cmd->meta_data = 0;
+	cmd->dest_ring_handler = WMI_PDEV_WIFIRXCCE_USE_CCE;
+
+	ret = ath11k_wmi_cmd_send(ar->wmi, skb, WMI_PDEV_UPDATE_PKT_ROUTING_CMDID);
+	if (ret) {
+		ath11k_warn(ar->ab, "failed to send pkt routing wmi cmd: %d\n", ret);
+		dev_kfree_skb(skb);
+		return ret;
+	}
+
+	ath11k_dbg(ar->ab, ATH11K_DBG_WMI,
+		   "cmd pkt routing pdev_id %d dest ring %u\n", pdev_id, dest_ring);
+	return 0;
+}
+
 int ath11k_wmi_wait_for_service_ready(struct ath11k_base *ab)
 {
 	unsigned long time_left;
--- a/drivers/net/wireless/ath/ath11k/wmi.h
+++ b/drivers/net/wireless/ath/ath11k/wmi.h
@@ -5607,6 +5607,47 @@ struct ath11k_wmi_pdev_lro_config_cmd {
 	u32 pdev_id;
 } __packed;
 
+enum wmi_pdev_pkt_routing_op_code {
+	WMI_PDEV_ADD_PKT_ROUTING,
+	WMI_PDEV_DEL_PKT_ROUTING,
+};
+
+/* The bit numbers of the routing_type_bitmap */
+enum wmi_pdev_pkt_routing_type {
+	WMI_PDEV_ROUTING_TYPE_ARP_IPV4,
+	WMI_PDEV_ROUTING_TYPE_NS_IPV6,
+	WMI_PDEV_ROUTING_TYPE_IGMP_IPV4,
+	WMI_PDEV_ROUTING_TYPE_MLD_IPV6,
+	WMI_PDEV_ROUTING_TYPE_DHCP_IPV4,
+	WMI_PDEV_ROUTING_TYPE_DHCP_IPV6,
+	WMI_PDEV_ROUTING_TYPE_DNS_TCP_IPV4,
+	WMI_PDEV_ROUTING_TYPE_DNS_TCP_IPV6,
+	WMI_PDEV_ROUTING_TYPE_DNS_UDP_IPV4,
+	WMI_PDEV_ROUTING_TYPE_DNS_UDP_IPV6,
+	WMI_PDEV_ROUTING_TYPE_ICMP_IPV4,
+	WMI_PDEV_ROUTING_TYPE_ICMP_IPV6,
+	WMI_PDEV_ROUTING_TYPE_TCP_IPV4,
+	WMI_PDEV_ROUTING_TYPE_TCP_IPV6,
+	WMI_PDEV_ROUTING_TYPE_UDP_IPV4,
+	WMI_PDEV_ROUTING_TYPE_UDP_IPV6,
+	WMI_PDEV_ROUTING_TYPE_IPV4,
+	WMI_PDEV_ROUTING_TYPE_IPV6,
+	WMI_PDEV_ROUTING_TYPE_EAP,
+};
+
+#define WMI_PDEV_WIFIRXCCE_USE_CCE	0
+
+/* The firmware takes this only while no vdev is up */
+struct wmi_pdev_update_pkt_routing_cmd {
+	u32 tlv_header;
+	u32 pdev_id;
+	u32 op_code;
+	u32 routing_type_bitmap;
+	u32 dest_ring;
+	u32 meta_data;
+	u32 dest_ring_handler;
+} __packed;
+
 #define ATH11K_WMI_SPECTRAL_COUNT_DEFAULT                 0
 #define ATH11K_WMI_SPECTRAL_PERIOD_DEFAULT              224
 #define ATH11K_WMI_SPECTRAL_PRIORITY_DEFAULT              1
@@ -6575,6 +6616,7 @@ int ath11k_wmi_send_obss_color_collision
 int ath11k_wmi_send_bss_color_change_enable_cmd(struct ath11k *ar, u32 vdev_id,
 						bool enable);
 int ath11k_wmi_pdev_lro_cfg(struct ath11k *ar, int pdev_id);
+int ath11k_wmi_pdev_pkt_routing(struct ath11k *ar, int pdev_id, u32 dest_ring);
 int ath11k_wmi_pdev_dma_ring_cfg(struct ath11k *ar,
 				 struct ath11k_wmi_pdev_dma_ring_cfg_req_cmd *param);
 int ath11k_wmi_vdev_spectral_enable(struct ath11k *ar, u32 vdev_id,
