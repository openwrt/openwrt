+/* A buffer of a ring with a page pool has no skb until one is needed: its
+ * table entry is its address, and what the reap learns of it is kept where
+ * the skb's shared info goes once one is built on it. The device writes no
+ * more than DP_RX_BUFFER_SIZE bytes of a buffer and the CPU takes no more
+ * than the DP_RX_PP_DATA_SIZE bytes in front of the shared info back from
+ * it, so neither the device nor an invalidation touches that state. An skb
+ * in such a table, which only the reinjection of a defragmented frame puts
+ * there, has bit 0 of its entry set.
+ */
+#define DP_RX_PP_DATA_SIZE	SKB_WITH_OVERHEAD(DP_RX_PP_FRAG_SIZE)
+#define ATH11K_DP_RX_ENT_SKB	1UL
+
+struct ath11k_dp_rx_bufmeta {
+	void *next;
+	struct ath11k_skb_rxcb cb;
+};
+
+static struct ath11k_dp_rx_bufmeta *ath11k_dp_rx_buf_meta(void *va)
+{
+	BUILD_BUG_ON(sizeof(struct ath11k_dp_rx_bufmeta) >
+		     SKB_DATA_ALIGN(sizeof(struct skb_shared_info)));
+	BUILD_BUG_ON(DP_RX_PP_DATA_SIZE < DP_RX_BUFFER_SIZE);
+	BUILD_BUG_ON(DP_RX_PP_DATA_SIZE % L1_CACHE_BYTES);
+
+	return va + DP_RX_PP_DATA_SIZE;
+}
+
+static void *ath11k_dp_rx_skb_ent(struct dp_rxdma_ring *rx_ring,
+				  struct sk_buff *skb)
+{
+	if (!rx_ring->page_pool)
+		return skb;
+
+	return (void *)((unsigned long)skb | ATH11K_DP_RX_ENT_SKB);
+}
+
+/* The skb of table entry @ent, or NULL for a buffer that has none. */
+static struct sk_buff *ath11k_dp_rx_ent_skb(struct dp_rxdma_ring *rx_ring,
+					    void *ent)
+{
+	if (!rx_ring->page_pool)
+		return ent;
+
+	if (!((unsigned long)ent & ATH11K_DP_RX_ENT_SKB))
+		return NULL;
+
+	return (void *)((unsigned long)ent & ~ATH11K_DP_RX_ENT_SKB);
+}
+
+static struct ath11k_skb_rxcb *ath11k_dp_rx_ent_cb(struct dp_rxdma_ring *rx_ring,
+						   void *ent)
+{
+	struct sk_buff *skb = ath11k_dp_rx_ent_skb(rx_ring, ent);
+
+	return skb ? ATH11K_SKB_RXCB(skb) : &ath11k_dp_rx_buf_meta(ent)->cb;
+}
+
+/* The skb built on buffer @va, which takes over the buffer's receive state,
+ * or NULL. The skb's shared info overwrites that state.
+ */
+static struct sk_buff *ath11k_dp_rx_buf_build(void *va, bool napi)
+{
+	struct ath11k_skb_rxcb cb = ath11k_dp_rx_buf_meta(va)->cb;
+	struct sk_buff *skb;
+
+	if (napi)
+		skb = napi_build_skb(va, DP_RX_PP_FRAG_SIZE);
+	else
+		skb = build_skb(va, DP_RX_PP_FRAG_SIZE);
+	if (unlikely(!skb))
+		return NULL;
+
+	skb_mark_for_recycle(skb);
+	*ATH11K_SKB_RXCB(skb) = cb;
+
+	return skb;
+}
+
+static void ath11k_dp_rx_buf_free(struct dp_rxdma_ring *rx_ring, void *va)
+{
+	page_pool_put_full_page(rx_ring->page_pool, virt_to_head_page(va), false);
+}
+
+/* Frees table entry @ent, which the table no longer holds. */
+static void ath11k_dp_rx_ent_free(struct dp_rxdma_ring *rx_ring, void *ent)
+{
+	struct sk_buff *skb = ath11k_dp_rx_ent_skb(rx_ring, ent);
+
+	if (skb)
+		dev_kfree_skb_any(skb);
+	else
+		ath11k_dp_rx_buf_free(rx_ring, ent);
+}
+
+/* The skb of buffer @id. One is built now for a buffer that has none and
+ * takes the buffer's place in the table, so that a caller that leaves the
+ * entry there finds the same skb again; a buffer whose skb cannot be built
+ * is freed with its id. Callers hold bufs_lock.
+ */
+static struct sk_buff *ath11k_dp_rx_buf_lookup(struct dp_rxdma_ring *rx_ring,
+					       u32 id)
+{
+	void *ent = ath11k_dp_rx_buf_lookup_ent(rx_ring, id);
+	struct sk_buff *skb;
+
+	if (!ent)
+		return NULL;
+
+	skb = ath11k_dp_rx_ent_skb(rx_ring, ent);
+	if (skb)
+		return skb;
+
+	skb = ath11k_dp_rx_buf_build(ent, false);
+	if (unlikely(!skb)) {
+		ath11k_dp_rx_buf_put_id(rx_ring, id);
+		ath11k_dp_rx_buf_free(rx_ring, ent);
+		return NULL;
+	}
+
+	rx_ring->bufs[id] = ath11k_dp_rx_skb_ent(rx_ring, skb);
+
+	return skb;
+}
+
 static bool ath11k_dp_rx_buf_is_pp(struct sk_buff *skb)
 {
 	return skb->pp_recycle && skb->head_frag;
@@ -465,36 +588,42 @@ static void ath11k_dp_rx_sync_more(struc
