+/* Hands the first @want bytes of buffer @rxcb is the state of back to the
+ * CPU, or the skb data area it gets for a @want of 0 or past its end, as
+ * ath11k_dp_rx_unmap_buf_len() does for a page pool buffer with an skb.
+ */
+static void ath11k_dp_rx_sync_buf(struct ath11k_base *ab,
+				  struct ath11k_skb_rxcb *rxcb,
+				  unsigned int want)
+{
+	unsigned int len = DP_RX_PP_DATA_SIZE;
+
+	if (want && want < len)
+		len = want;
+	dma_sync_single_for_cpu(ab->dev, rxcb->paddr, len, DMA_BIDIRECTIONAL);
+	rxcb->sync_len = len;
 }
 
-static struct sk_buff *ath11k_dp_rx_pp_alloc_skb(struct dp_rxdma_ring *rx_ring)
+/* ath11k_dp_rx_sync_more() for a buffer without an skb. */
+static void ath11k_dp_rx_sync_buf_more(struct ath11k_base *ab,
+				       struct ath11k_skb_rxcb *rxcb,
+				       unsigned int need)
 {
-	struct sk_buff *skb;
-	unsigned int offset;
-	struct page *page;
-	void *va;
-
-	page = page_pool_dev_alloc_frag(rx_ring->page_pool, &offset,
-					DP_RX_PP_FRAG_SIZE);
-	if (!page)
-		return NULL;
+	need = min_t(unsigned int, need, DP_RX_PP_DATA_SIZE);
+	if (likely(need <= rxcb->sync_len))
+		return;
 
-	va = page_address(page) + offset;
-	skb = build_skb(va, DP_RX_PP_FRAG_SIZE);
-	if (!skb) {
-		page_pool_put_full_page(rx_ring->page_pool, page, false);
-		return NULL;
-	}
+	dma_sync_single_for_cpu(ab->dev, rxcb->paddr + rxcb->sync_len,
+				need - rxcb->sync_len, DMA_BIDIRECTIONAL);
+	rxcb->sync_len = need;
+}
 
-	skb_mark_for_recycle(skb);
+static dma_addr_t ath11k_dp_rx_pp_dma_addr(struct sk_buff *skb)
+{
+	struct page *page = virt_to_head_page(skb->data);
 
-	return skb;
+	return page_pool_get_dma_addr(page) +
+	       (skb->data - (u8 *)page_address(page));
 }
 
