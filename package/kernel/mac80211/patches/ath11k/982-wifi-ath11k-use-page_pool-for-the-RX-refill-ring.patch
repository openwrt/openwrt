 				rxcb->unmapped = 1;
 			}
 			if (drop_mpdu) {
@@ -5474,10 +5556,7 @@ ath11k_dp_rx_full_mon_mpdu_pop(struct at
 
 			rxcb = ATH11K_SKB_RXCB(msdu);
 			if (!rxcb->unmapped) {
-				dma_unmap_single(ar->ab->dev, rxcb->paddr,
-						 msdu->len +
-						 skb_tailroom(msdu),
