From adae8e4d039818771234519d620cca4449e7de13 Mon Sep 17 00:00:00 2001
From: Julius Bairaktaris <julius@bairaktaris.de>
Date: Sun, 15 Nov 2026 02:29:39 +0100
Subject: [PATCH] wifi: ath11k: use Ethernet mode by default

Default frame_mode to Ethernet. Encap and decap offload are enabled on AP
vifs only. Monitor, 4addr and station vifs stay native.

The 802.3 receive path counts a station's MSDUs on the TID the driver
passes in the receive status, so pass the TID of the receive descriptor,
which the native path reads for the same purpose.

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -29,10 +29,10 @@ module_param_named(crypto_mode, ath11k_c
 MODULE_PARM_DESC(crypto_mode, "crypto mode: 0-hardware, 1-software");
 
 /* frame mode values are mapped as per enum ath11k_hw_txrx_mode */
-unsigned int ath11k_frame_mode = ATH11K_HW_TXRX_NATIVE_WIFI;
+unsigned int ath11k_frame_mode = ATH11K_HW_TXRX_ETHERNET;
 module_param_named(frame_mode, ath11k_frame_mode, uint, 0644);
 MODULE_PARM_DESC(frame_mode,
-		 "Datapath frame mode (0: raw, 1: native wifi (default), 2: ethernet)");
+		 "Datapath frame mode (0: raw, 1: native wifi, 2: ethernet on AP interfaces, native wifi on the others (default))");
 
 bool ath11k_ftm_mode;
 module_param_named(ftm_mode, ath11k_ftm_mode, bool, 0444);
--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -2714,6 +2714,7 @@ static void ath11k_dp_rx_deliver_msdu(st
 
 	rx_status = IEEE80211_SKB_RXCB(msdu);
 	*rx_status = *status;
+	rx_status->tid = min_t(u8, rxcb->tid, IEEE80211_NUM_TIDS);
 
 	/* TODO: trace rx packet */
 
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -6901,6 +6901,15 @@ static int ath11k_mac_setup_vdev_create_
 	return 0;
 }
 
+/* The hardware converts between 802.3 and 802.11 frames only for a station
+ * that it decrypts for, so Ethernet mode needs hardware crypto.
+ */
+static bool ath11k_mac_eth_mode(struct ath11k_base *ab)
+{
+	return ath11k_frame_mode == ATH11K_HW_TXRX_ETHERNET &&
+	       !test_bit(ATH11K_FLAG_HW_CRYPTO_DISABLED, &ab->dev_flags);
+}
+
 static void ath11k_mac_op_update_vif_offload(struct ieee80211_hw *hw,
 					     struct ieee80211_vif *vif)
 {
@@ -6910,12 +6919,16 @@ static void ath11k_mac_op_update_vif_off
 	u32 param_id, param_value;
 	int ret;
 
+	/* Only an AP interface is known to work in Ethernet mode. The others
+	 * keep native Wi-Fi frames: a station sees any source address behind
+	 * its AP, a mesh point needs the mesh header and a monitor the 802.11
+	 * header.
+	 */
 	param_id = WMI_VDEV_PARAM_TX_ENCAP_TYPE;
-	if (ath11k_frame_mode != ATH11K_HW_TXRX_ETHERNET ||
-	    (vif->type != NL80211_IFTYPE_STATION &&
-	     vif->type != NL80211_IFTYPE_AP))
-		vif->offload_flags &= ~(IEEE80211_OFFLOAD_ENCAP_ENABLED |
-					IEEE80211_OFFLOAD_DECAP_ENABLED);
+	if (!ath11k_mac_eth_mode(ab) || vif->type != NL80211_IFTYPE_AP)
+		vif->offload_flags &= ~IEEE80211_OFFLOAD_ENCAP_ENABLED;
+	if (!ath11k_mac_eth_mode(ab) || vif->type != NL80211_IFTYPE_AP)
+		vif->offload_flags &= ~IEEE80211_OFFLOAD_DECAP_ENABLED;
 
 	if (vif->offload_flags & IEEE80211_OFFLOAD_ENCAP_ENABLED)
 		param_value = ATH11K_HW_TXRX_ETHERNET;
@@ -10716,7 +10729,7 @@ static int __ath11k_mac_register(struct
 	ieee80211_hw_set(ar->hw, SUPPORTS_TX_FRAG);
 	ieee80211_hw_set(ar->hw, REPORTS_LOW_ACK);
 
-	if (ath11k_frame_mode == ATH11K_HW_TXRX_ETHERNET) {
+	if (ath11k_mac_eth_mode(ab)) {
 		ieee80211_hw_set(ar->hw, SUPPORTS_TX_ENCAP_OFFLOAD);
 		ieee80211_hw_set(ar->hw, SUPPORTS_RX_DECAP_OFFLOAD);
 	}
