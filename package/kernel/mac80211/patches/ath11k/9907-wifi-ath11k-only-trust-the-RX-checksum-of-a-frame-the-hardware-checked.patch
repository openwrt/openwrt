From 1d3b929e7cb4401756348215e97a2b6d417b4474 Mon Sep 17 00:00:00 2001
From: Julius Bairaktaris <julius@bairaktaris.de>
Date: Sun, 15 Nov 2026 11:00:51 +0100
Subject: [PATCH] wifi: ath11k: only trust the RX checksum of a frame the hardware checked

ath11k_dp_rx_h_csum_offload() marks every received frame
CHECKSUM_UNNECESSARY unless the descriptor's IP or TCP/UDP checksum
fail bit is set. Those bits are set only when the hardware computed a
checksum and it did not match, so they are also clear for a frame the
hardware never checked: an IP fragment, a protocol other than TCP and
UDP (ICMP, SCTP), and a packet whose headers it could not parse within
the first 256 bytes. Such a frame skips the checksum verification in
the network stack.

Trust the hardware only for a frame with the TCP or UDP protocol flag
set, no IP fragment flag and the fixed IP header and the TCP/UDP header
flagged as parsed, and leave the rest to the stack. Add a hw_ops
accessor for the descriptor word that carries those flags, which sits
in a different structure on each chip family.

Fixes: d5c65159f289 ("ath11k: driver for Qualcomm IEEE 802.11ax devices")
Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -2062,18 +2062,36 @@ static struct sk_buff *ath11k_dp_rx_get_
 	return NULL;
 }
 
+/* The hardware sets a checksum failure bit only for a checksum it computed
+ * and found wrong, so both bits are clear for a frame it did not check: an IP
+ * fragment, a protocol other than TCP and UDP, or a header it could not parse.
+ * Only a TCP or UDP frame whose IP and L4 headers the engine parsed, and that
+ * is not a fragment, has a verified L4 checksum.
+ */
 static void ath11k_dp_rx_h_csum_offload(struct ath11k *ar, struct sk_buff *msdu)
 {
 	struct ath11k_skb_rxcb *rxcb = ATH11K_SKB_RXCB(msdu);
 	struct rx_attention *rx_attention;
 	bool ip_csum_fail, l4_csum_fail;
+	u32 info2;
 
 	rx_attention = ath11k_dp_rx_get_attention(ar->ab, rxcb->rx_desc);
 	ip_csum_fail = ath11k_dp_rx_h_attn_ip_cksum_fail(rx_attention);
 	l4_csum_fail = ath11k_dp_rx_h_attn_l4_cksum_fail(rx_attention);
+	info2 = ar->ab->hw_params.hw_ops->rx_desc_get_msdu_start_info2(rxcb->rx_desc);
 
-	msdu->ip_summed = (ip_csum_fail || l4_csum_fail) ?
-			  CHECKSUM_NONE : CHECKSUM_UNNECESSARY;
+	msdu->ip_summed = CHECKSUM_NONE;
+
+	if (ip_csum_fail || l4_csum_fail)
+		return;
+
+	if (!(info2 & (RX_MSDU_START_INFO2_TCP | RX_MSDU_START_INFO2_UDP)) ||
+	    (info2 & RX_MSDU_START_INFO2_IP_FRAG) ||
+	    !(info2 & RX_MSDU_START_INFO2_IP_FIXED_HDR_VALID) ||
+	    !(info2 & RX_MSDU_START_INFO2_IP_TCP_UDP_HDR_VALID))
+		return;
+
+	msdu->ip_summed = CHECKSUM_UNNECESSARY;
 }
 
 int ath11k_dp_rx_crypto_mic_len(struct ath11k *ar, enum hal_encrypt_type enctype)
