From: Rosen Penev <rosenp@gmail.com>
Date: Sat, 7 Nov 2026 16:57:51 -0800
Subject: [PATCH] wifi: ath9k: pass the ath_hw to the platform callbacks

get_mac_revision() and external_reset() date from the platform data,
when the board code implemented them with global SoC accessors. Nothing
sets them anymore. The AHB bus code is to implement them again, with
the reset control and registers it gets from the device tree, and it
needs the device to find those.

Pass the struct ath_hw to both callbacks.

Signed-off-by: Rosen Penev <rosenp@gmail.com>
Assisted-by: LLM
---
--- a/drivers/net/wireless/ath/ath9k/hw.c
+++ b/drivers/net/wireless/ath/ath9k/hw.c
@@ -258,7 +258,7 @@ static bool ath9k_hw_read_revisions(stru
 	u32 val;
 
 	if (ah->get_mac_revision)
-		ah->hw_version.macRev = ah->get_mac_revision();
+		ah->hw_version.macRev = ah->get_mac_revision(ah);
 
 	switch (ah->hw_version.devid) {
 	case AR5416_AR9100_DEVID:
@@ -1347,7 +1347,7 @@ static bool ath9k_hw_external_reset(stru
 	ath_dbg(ath9k_hw_common(ah), RESET,
 		"reset MAC via external reset\n");
 
-	err = ah->external_reset();
+	err = ah->external_reset(ah);
 	if (err) {
 		ath_err(ath9k_hw_common(ah),
 			"External reset failed, err=%d\n", err);
@@ -1455,7 +1455,7 @@ static bool ath9k_hw_set_reset(struct at
 	if (AR_SREV_9100(ah)) {
 		/* Reset the AHB-WMAC interface */
 		if (ah->external_reset)
-			ah->external_reset();
+			ah->external_reset(ah);
 		udelay(50);
 	}
 
--- a/drivers/net/wireless/ath/ath9k/hw.h
+++ b/drivers/net/wireless/ath/ath9k/hw.h
@@ -972,8 +972,8 @@ struct ath_hw {
 	struct ath9k_hw_wow wow;
 #endif
 	bool is_clk_25mhz;
-	int (*get_mac_revision)(void);
-	int (*external_reset)(void);
+	int (*get_mac_revision)(struct ath_hw *ah);
+	int (*external_reset)(struct ath_hw *ah);
 
 	const struct firmware *eeprom_blob;
 	u16 *nvmem_blob;	/* devres managed */
