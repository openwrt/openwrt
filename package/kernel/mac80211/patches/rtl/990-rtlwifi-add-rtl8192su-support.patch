From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry R <rdmitry0911@gmail.com>
Date: Tue, 11 Aug 2026 17:30:00 +0300
Subject: [PATCH] wifi: rtlwifi: add RTL8192SU USB support

Restore the RTL8192SU mac80211 driver based on Joshua Roys' port archived
at https://github.com/chunkeey/rtl8192su.

Adapt the driver to the current mac80211 and rtlwifi APIs, add USB firmware
command transport and complete the AP beacon and buffered broadcast paths.
Work around the AP firmware's unreliable HT downlink rate handling, which
otherwise stalls traffic.

Signed-off-by: Dmitry R <rdmitry0911@gmail.com>
---
--- a/drivers/net/wireless/realtek/rtlwifi/Kconfig
+++ b/drivers/net/wireless/realtek/rtlwifi/Kconfig
@@ -37,6 +37,20 @@ config RTL8192SE
 
 	If you choose to build it as a module, it will be called rtl8192se
 
+config RTL8192SU
+	tristate "Realtek RTL8192SU/RTL8188SU USB Wireless Network Adapter"
+	depends on m
+	depends on USB
+	select RTL8192S_COMMON
+	select RTLWIFI
+	select RTLWIFI_USB
+	help
+	  This driver provides mac80211 support for Realtek RTL8192SU and
+	  RTL8188SU 802.11n USB wireless network adapters. It supports both
+	  station and access point operation and requires RTL8192SU firmware.
+
+	  If you choose to build it as a module, it will be called rtl8192su.
+
 config RTL8192DE
 	tristate "Realtek RTL8192DE/RTL8188DE PCIe Wireless Network Adapter"
 	depends on m
@@ -174,6 +188,10 @@ config RTL8192D_COMMON
 	tristate
 	depends on m
 
+config RTL8192S_COMMON
+	tristate
+	depends on m
+
 config RTL8723_COMMON
 	tristate
 	depends on m
