+
+#define IS_HARDWARE_TYPE_8192SE(rtlhal) \
+	((rtlhal)->hw_type == HARDWARE_TYPE_RTL8192SE)
+#define IS_HARDWARE_TYPE_8192SU(rtlhal) \
+	((rtlhal)->hw_type == HARDWARE_TYPE_RTL8192SU)
+
+#define RTL92S_DESC_PACKET_TYPE_INIT	1
+#define RTL92S_DESC_PACKET_TYPE_CMD	2
+
+#define RTL92S_BIT_LEN_MASK_32(len) \
+	((len) == 32 ? ~0U : (BIT(len) - 1))
+#define RTL92S_BIT_LEN_MASK_16(len) \
+	((len) == 16 ? (u16)~0U : (u16)(BIT(len) - 1))
+#define RTL92S_BIT_OFFSET_LEN_MASK_32(offset, len) \
+	(RTL92S_BIT_LEN_MASK_32(len) << (offset))
+
+#define SET_BITS_TO_LE_4BYTE(ptr, offset, len, value) do { \
+	__le32 *__p = (__le32 *)(ptr); \
+	u32 __v = le32_to_cpu(*__p); \
+	__v &= ~RTL92S_BIT_OFFSET_LEN_MASK_32(offset, len); \
+	__v |= ((u32)(value) & RTL92S_BIT_LEN_MASK_32(len)) << (offset); \
+	*__p = cpu_to_le32(__v); \
+} while (0)
+
+#define SET_BITS_TO_LE_2BYTE(ptr, offset, len, value) do { \
+	__le16 *__p = (__le16 *)(ptr); \
+	u16 __v = le16_to_cpu(*__p); \
+	u16 __mask = RTL92S_BIT_LEN_MASK_16(len) << (offset); \
+	__v &= (u16)~__mask; \
+	__v |= ((u16)(value) & RTL92S_BIT_LEN_MASK_16(len)) << (offset); \
+	*__p = cpu_to_le16(__v); \
+} while (0)
