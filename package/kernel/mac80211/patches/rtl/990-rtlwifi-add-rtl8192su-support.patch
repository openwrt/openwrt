+/* Firmware download runs from the start callback before SET_USB_START().
+ * Keep command completion separate from mac80211 data frames. Only firmware
+ * initialization packets may bypass the stopped state.
+ */
+int rtl_usb_transmit_cmd(struct ieee80211_hw *hw, struct sk_buff *skb,
+			 enum rtl_txq qnum, bool is_init)
+{
+	struct rtl_hal *rtlhal = rtl_hal(rtl_priv(hw));
+	struct rtl_usb *rtlusb = rtl_usbdev(rtl_usbpriv(hw));
+	struct urb *urb;
+	u32 ep_num;
+
+	if (unlikely((IS_USB_STOP(rtlusb) || is_hal_stop(rtlhal)) &&
+		     !is_init)) {
+		pr_err("USB device is stopping...\n");
+		kfree_skb(skb);
+		return -ENODEV;
+	}
+
+	ep_num = rtlusb->ep_map.ep_mapping[qnum];
+	urb = _rtl_usb_tx_urb_setup(hw, skb, ep_num);
+	if (!urb) {
+		pr_err("Can't allocate command URB. Drop skb!\n");
+		kfree_skb(skb);
+		return -ENOMEM;
+	}
+
+	urb->complete = _rtl_usb_cmd_tx_complete;
+	return _rtl_submit_tx_urb(hw, urb);
+}
+EXPORT_SYMBOL_GPL(rtl_usb_transmit_cmd);
