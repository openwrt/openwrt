--- a/drivers/net/wireless/realtek/rtlwifi/base.c
+++ b/drivers/net/wireless/realtek/rtlwifi/base.c
@@ -1306,6 +1306,23 @@ void rtl_get_tcb_desc(struct ieee80211_h
 		_rtl_qurey_shortpreamble_mode(hw, tcb_desc, info);
 		_rtl_query_shortgi(hw, sta, tcb_desc, info);
 		_rtl_query_protection_mode(hw, tcb_desc, info);
+
+		/* The RTL8192SU AP firmware is unreliable when mac80211 selects
+		 * an HT rate for downlink traffic. Keep AP traffic on the robust
+		 * OFDM basic rate while retaining HT20 for radio/beacon setup.
+		 */
+		if (rtlpriv->rtlhal.hw_type == HARDWARE_TYPE_RTL8192SU &&
+		    rtlmac->opmode == NL80211_IFTYPE_AP) {
+			tcb_desc->hw_rate =
+				rtlpriv->cfg->maps[RTL_RC_OFDM_RATE6M];
+			tcb_desc->use_driver_rate = true;
+			tcb_desc->ratr_index =
+				SET_RATE_ID(RATR_INX_WIRELESS_GB);
+			tcb_desc->disable_ratefallback = 1;
+			tcb_desc->use_shortgi = false;
+			tcb_desc->use_shortpreamble = false;
+			tcb_desc->packet_bw = false;
+		}
 	} else {
 		tcb_desc->use_driver_rate = true;
 		tcb_desc->ratr_index = SET_RATE_ID(RATR_INX_WIRELESS_MC);
@@ -1887,6 +1904,31 @@ void rtl_rx_ampdu_apply(struct rtl_priv
 }
 EXPORT_SYMBOL(rtl_rx_ampdu_apply);
 
+void rtl_send_buffered_bc(struct ieee80211_hw *hw)
+{
+	struct rtl_priv *rtlpriv = rtl_priv(hw);
+	struct rtl_mac *mac = rtl_mac(rtlpriv);
+	struct ieee80211_vif *vif;
+	struct rtl_tcb_desc tcb_desc;
+	struct sk_buff *skb;
+
+	rcu_read_lock();
+	vif = READ_ONCE(mac->vif);
+	if (!vif || (mac->opmode != NL80211_IFTYPE_AP &&
+		     mac->opmode != NL80211_IFTYPE_ADHOC &&
+		     mac->opmode != NL80211_IFTYPE_MESH_POINT))
+		goto out;
+
+	while ((skb = ieee80211_get_buffered_bc(hw, vif))) {
+		memset(&tcb_desc, 0, sizeof(tcb_desc));
+		rtlpriv->intf_ops->adapter_tx(hw, NULL, skb, &tcb_desc);
+	}
+
+out:
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(rtl_send_buffered_bc);
+
