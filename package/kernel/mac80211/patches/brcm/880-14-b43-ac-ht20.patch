+		if (have_5ghz_phy) {
+			b43_ac_setup_ht_cap(dev, &b43_band_5GHz_acphy.ht_cap);
+			hw->wiphy->bands[NL80211_BAND_5GHZ] =
+				&b43_band_5GHz_acphy;
+		}
