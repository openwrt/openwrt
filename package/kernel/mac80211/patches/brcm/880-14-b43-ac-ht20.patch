 	/* Packet part, bytes 0..19 */
 	if (!(info->flags & IEEE80211_TX_CTL_NO_ACK))
@@ -433,6 +618,17 @@
 	txhdr->seq_ctl = wlhdr->seq_ctrl;
 	/* unk16 (packet flag 0x200), unk18, key bytes and tail: zero */
 
+	if (ht) {
