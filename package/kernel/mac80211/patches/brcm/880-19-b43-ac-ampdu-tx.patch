 					} while (0)
 
+/*
+ * 9g0: A-MPDU TX epoch state per TX FIFO (core rev >= 40, acphy_ampdu
+ * bit 1); what wl keeps at ampdu_tx + 0x278 + 28 * fifo and saves in
+ * wlc_ampdu_chgnsav_epoch 0x141c20. See xmit.h, "epoch state per TX FIFO".
+ */
+struct b43_ac_ampdu_epoch {
+	u8 epoch;
+	u8 prev_ft;		/* 1 HT, 2 VHT, 0 none */
+	u8 prev_tid;
+	u8 prev_addr[ETH_ALEN];
+	u16 prev_phyctl0;
+	u16 prev_phyctl1;
+	u8 prev_plcp[5];
+	u16 next_seq;
+	/*
+	 * 9l0 (acphy_ampdu bit 4): the last aggregate-able MPDU queued on
+	 * this FIFO had another one of its burst behind it in the TX worker's
+	 * queue, so the next MPDU of the same station and TID continues the
+	 * burst even when it is the last one.
+	 */
+	bool burst;
+};
+#define B43_AC_AMPDU_NFIFO	8	/* frame id bits 0..2 */
+
 /* Data structure for one wireless device (802.11 core) */
 struct b43_wldev {
+	/* 9g0: A-MPDU TX epoch per TX FIFO, zeroed with the core init */
+	struct b43_ac_ampdu_epoch ac_ampdu_epoch[B43_AC_AMPDU_NFIFO];
+	/*
+	 * 9l0: while b43_tx_work hands a frame to b43_dma_tx, the frame
+	 * behind it in the same software queue (NULL when none); the header
+	 * builder and the DMA submit use it to tell a burst from a lone
+	 * MPDU. Valid under wl->mutex only.
+	 */
+	struct sk_buff *ac_ampdu_next;
 	/* Core rev >= 40 AC-PHY: PHY TX errors counted, not acted on (99m) */
 	unsigned int phy_txerr_total;
 	struct b43_bus_dev *dev;
--- a/drivers/net/wireless/broadcom/b43/dma.c
+++ b/drivers/net/wireless/broadcom/b43/dma.c
@@ -1432,7 +1432,21 @@
 	}
 	/* Now transfer the whole frame. */
 	wmb();
-	ops->poke_tx(ring, next_slot(ring, slot));
+	/*
+	 * 9l0 (acphy_ampdu bit 4): a frame of an aggregate burst waits on the
+	 * ring until the burst is complete (b43_tx_work calls
+	 * b43_dma_tx_poke_pending), so the ucode finds the whole burst
+	 * pending when it looks for MPDUs to join (its wait at 0x397..0x3A2
+	 * only covers frames the DMA already holds).
+	 */
+	if (b43_ac_ampdu(ring->dev, B43_AC_AMPDU_BURST) &&
+	    b43_ac_ampdu_same_burst(skb, ring->dev->ac_ampdu_next)) {
+		ring->poke_pending = true;
+		ring->poke_slot = next_slot(ring, slot);
+	} else {
+		ring->poke_pending = false;
+		ops->poke_tx(ring, next_slot(ring, slot));
+	}
 	return 0;
 
 out_unmap_hdr:
@@ -1493,6 +1507,31 @@
 	return ring;
 }
 
+/*
+ * 9l0: start the DMA engine of every TX ring that holds a burst frame put
+ * there without a poke (dma_tx_fragment). Called by b43_tx_work after each
+ * queue and after a failed submit, so no frame stays on a ring unstarted.
+ */
+void b43_dma_tx_poke_pending(struct b43_wldev *dev)
+{
+	struct b43_dmaring *rings[] = {
+		dev->dma.tx_ring_AC_BK, dev->dma.tx_ring_AC_BE,
+		dev->dma.tx_ring_AC_VI, dev->dma.tx_ring_AC_VO,
+		dev->dma.tx_ring_mcast,
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(rings); i++) {
+		struct b43_dmaring *ring = rings[i];
+
+		if (!ring || !ring->poke_pending)
+			continue;
+		ring->poke_pending = false;
+		wmb();
+		ring->ops->poke_tx(ring, ring->poke_slot);
+	}
+}
