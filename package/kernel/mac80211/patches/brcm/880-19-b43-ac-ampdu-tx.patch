  */
 #define B43_HF_AC_NOPRBRESP	0x000000010000ULL
+/*
+ * 9g0: host flags word 3 (wl's word index 2) bit 6, A-MPDU TX. wl sets it
+ * for both bands when its AQM mode is selected (wlc_ampdu_tx_set
+ * 0x143314..0x14332c, wlc_mhf(wlc, 2, 0x40, 0x40, 3)); b43 bit 38.
+ */
+#define B43_HF_AC_AMPDUTX	0x004000000000ULL
 
 /* Firmware capabilities field in SHM (Opensource firmware only) */
 #define B43_FWCAPA_HWCRYPTO	0x0001
