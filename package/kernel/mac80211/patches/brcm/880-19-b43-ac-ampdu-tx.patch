+	/* 9g0: frames this status releases (A-MPDU), index of the current one */
+	int nframes = 1, frame = 0;
+	bool ampdu = false;
 	static u8 err_out1;
 
 	ring = parse_cookie(dev, status->cookie, &slot);
@@ -1626,6 +1845,9 @@
 	}
 
 	ops = ring->ops;
+	/* 9g0: one status for several MPDUs of an A-MPDU (never when skipping) */
