From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Conijn <egc112@msn.com>
Date: Thu, 22 Oct 2026 23:48:28 -0700
Subject: [PATCH] wifi: b43: HT-PHY: receive CCK only when the BSS uses it

The HT-PHY receiver locks onto every CCK (802.11b) frame it detects, also
a weak one from a distant BSS, and stays on it until it ends. A 1 Mbit/s
broadcast of 200 bytes keeps it busy for about 2 ms, and a much stronger
OFDM frame of our own BSS that starts meanwhile is not received: it gets no
ACK, and the sender backs off and sends it again.

On a BCM4331 access point with an 802.11n client next to it, 13-16 % of
the client's frames were not acknowledged at the first attempt on an
otherwise quiet channel, whatever the signal level (-25 or -46 dBm at a
sniffer), the rate (MCS 4-15) or the number of streams. With the AP's own
receive times aligned to an independent sniffer, 90 % of the frames that
started while the AP was receiving another frame were lost, against 2 %
of the others, and the other frame was almost always a weak, corrupted
1 Mbit/s broadcast of a neighbour.

CCK reception is needed while anything of the BSS is sent in CCK: at a
CCK basic rate, or to or from a peer that supports a CCK rate, as
mac80211 sends management frames and EAPOL to a peer at the lowest rate
the peer supports, not at a basic rate, and a CCK frame is answered in
CCK. OpenWrt sets up 2.4 GHz networks without CCK basic rates by
default, and mac80211 clients only list the rates the AP has. Turn CCK
reception off in the classifier when no basic rate is CCK and no
station known supports a CCK rate, as an access point or while
associated as a station, and keep it while scanning (other APs beacon
at 1 Mbit/s) and while a monitor interface is up. A station is added
with the mandatory rates, CCK ones among them, so CCK reception stays
on from its authentication until it associates with OFDM rates only.
Use the sta_state callback instead of sta_add and sta_remove to follow
that.

With this, 98.6-99.2 % of the client's frames are acknowledged at the
first attempt, and TCP goes from 49.6 to 53.7 Mbit/s to the client and
from 85.2 to 93.7 Mbit/s from it.

Signed-off-by: Erik Conijn <egc112@msn.com>
Signed-off-by: Rosen Penev <rosenp@gmail.com>
---
 drivers/net/wireless/broadcom/b43/b43.h    |   2 +
 drivers/net/wireless/broadcom/b43/main.c   | 118 +++++++++++++++++++--
 drivers/net/wireless/broadcom/b43/phy_ht.c |  15 +++
 drivers/net/wireless/broadcom/b43/phy_ht.h |  11 ++
 4 files changed, 137 insertions(+), 9 deletions(-)

--- a/drivers/net/wireless/broadcom/b43/b43.h
+++ b/drivers/net/wireless/broadcom/b43/b43.h
@@ -1018,6 +1018,8 @@ struct b43_wl {
 #endif /* CPTCFG_B43_HWRNG */
 
 	bool radiotap_enabled;
+	/* A software scan is on, which needs CCK reception */
+	bool cck_scanning;
 	bool radio_enabled;
 
 	/* The beacon we are currently using (AP or IBSS mode). */
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -38,6 +38,7 @@
 #include "phy_common.h"
 #include "phy_g.h"
 #include "phy_n.h"
+#include "phy_ht.h"
 #include "dma.h"
 #include "pio.h"
 #include "sysfs.h"
@@ -4802,6 +4803,72 @@ static void b43_set_beacon_listen_interv
 	b43_shm_write16(dev, B43_SHM_SHARED, B43_SHM_SH_BCN_LI, interval);
 }
 
+/*
+ * HT-PHY: the receiver locks onto any CCK frame it detects, also a weak
+ * one of a distant BSS, and stays on it to its end: a 1 Mbit/s broadcast
+ * of 200 bytes keeps it deaf for 2 ms, and a much stronger frame of our
+ * own BSS that starts meanwhile is lost. Turn CCK reception off as an AP,
+ * or while associated as a station, when nothing of the BSS is sent in
+ * CCK: no basic rate is CCK, and no peer supports a CCK rate. mac80211
+ * sends management frames and EAPOL to a peer at the lowest rate it
+ * supports, not at a basic rate, and a CCK frame is answered in CCK. A
+ * station is added with the mandatory rates, CCK ones among them, and
+ * keeps them until it associates. Keep CCK reception while scanning, as
+ * other APs beacon at 1 Mbit/s, and while a monitor interface is up.
+ */
+struct b43_cck_peers {
+	/* A station that changes state, counted as @present says */
+	struct ieee80211_sta *sta;
+	u32 cck;
+	bool found;
+};
+
+static void b43_cck_peers_iter(void *data, struct ieee80211_sta *sta)
+{
+	struct b43_cck_peers *peers = data;
+
+	if (sta != peers->sta &&
+	    (sta->deflink.supp_rates[NL80211_BAND_2GHZ] & peers->cck))
+		peers->found = true;
+}
+
+/*
+ * Update the CCK reception for the stations known. @sta, if not NULL,
+ * changes state: it counts if @present, and not if it is being removed.
+ */
+static void b43_update_cck_rx(struct b43_wldev *dev, struct ieee80211_sta *sta,
+			      bool present)
+{
+	struct b43_wl *wl = dev->wl;
+	struct ieee80211_vif *vif = wl->vif;
+	struct ieee80211_supported_band *sband;
+	struct b43_cck_peers peers = { .sta = sta };
+	bool on = true;
+	int i;
+
+	if (dev->phy.type != B43_PHYTYPE_HT)
+		return;
+
+	/* At 5 GHz the PHY receives no CCK whatever is set */
+	if (vif && !wl->radiotap_enabled && !wl->cck_scanning &&
+	    b43_current_band(wl) == NL80211_BAND_2GHZ &&
+	    vif->bss_conf.basic_rates &&
+	    (vif->type == NL80211_IFTYPE_AP ||
+	     (vif->type == NL80211_IFTYPE_STATION && vif->cfg.assoc))) {
+		sband = wl->hw->wiphy->bands[NL80211_BAND_2GHZ];
+		for (i = 0; sband && i < sband->n_bitrates; i++)
+			if (b43_is_cck_rate(sband->bitrates[i].hw_value))
+				peers.cck |= BIT(i);
+
+		ieee80211_iterate_stations_atomic(wl->hw, b43_cck_peers_iter,
+						  &peers);
+		on = (vif->bss_conf.basic_rates & peers.cck) || peers.found ||
+		     (sta && present &&
+		      (sta->deflink.supp_rates[NL80211_BAND_2GHZ] & peers.cck));
+	}
+	b43_phy_ht_set_cck_rx(dev, on);
+}
+
 /* Write the short and long frame retry limit values. */
 static void b43_set_retry_limits(struct b43_wldev *dev,
 				 unsigned int short_retry,
@@ -4883,6 +4950,7 @@ static int b43_op_config(struct ieee8021
 		goto out_mac_enable;
 
 	dev->wl->radiotap_enabled = !!(conf->flags & IEEE80211_CONF_MONITOR);
+	b43_update_cck_rx(dev, NULL, false);
 
 	/* Adjust the desired TX power level. */
 	b43_update_desired_txpower(dev);
@@ -5005,6 +5073,8 @@ static void b43_op_bss_info_changed(stru
 
 	if (changed & BSS_CHANGED_BASIC_RATES)
 		b43_update_basic_rates(dev, conf->basic_rates);
+	if (changed & (BSS_CHANGED_BASIC_RATES | BSS_CHANGED_ASSOC))
+		b43_update_cck_rx(dev, NULL, false);
 
 	if (changed & BSS_CHANGED_ERP_SLOT) {
 		if (conf->use_short_slot)
@@ -6082,8 +6152,8 @@ static void b43_op_release_buffered_fram
 	b43_ps_requeue(wl, &list);
 }
 
-static int b43_op_sta_add(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
-			  struct ieee80211_sta *sta)
+static void b43_sta_add(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+			struct ieee80211_sta *sta)
 {
 	struct b43_sta *bsta = (struct b43_sta *)sta->drv_priv;
 
@@ -6092,13 +6162,11 @@ static int b43_op_sta_add(struct ieee802
 		skb_queue_head_init(&bsta->psq);
 		bsta->ps_init = true;
 	}
-
-	return 0;
 }
 
-static int b43_op_sta_remove(struct ieee80211_hw *hw,
-			     struct ieee80211_vif *vif,
-			     struct ieee80211_sta *sta)
+static void b43_sta_remove(struct ieee80211_hw *hw,
+			   struct ieee80211_vif *vif,
+			   struct ieee80211_sta *sta)
 {
 	struct b43_wl *wl = hw_to_b43_wl(hw);
 	struct b43_sta *bsta = (struct b43_sta *)sta->drv_priv;
@@ -6114,6 +6182,35 @@ static int b43_op_sta_remove(struct ieee
 	skb_queue_splice_init(&bsta->psq, &list);
 	spin_unlock_irqrestore(&bsta->psq.lock, flags);
 	ieee80211_purge_tx_queue(hw, &list);
+}
+
+static int b43_op_sta_state(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+			    struct ieee80211_sta *sta,
+			    enum ieee80211_sta_state old_state,
+			    enum ieee80211_sta_state new_state)
+{
+	struct b43_wl *wl = hw_to_b43_wl(hw);
+	struct b43_wldev *dev;
+	bool added = false, removed = false;
+
+	if (old_state == IEEE80211_STA_NOTEXIST &&
+	    new_state == IEEE80211_STA_NONE) {
+		b43_sta_add(hw, vif, sta);
+		added = true;
+	} else if (old_state == IEEE80211_STA_NONE &&
+		   new_state == IEEE80211_STA_NOTEXIST) {
+		b43_sta_remove(hw, vif, sta);
+		removed = true;
+	}
+
+	/* The rates of a station are known once it associates */
+	if (added || removed || new_state == IEEE80211_STA_ASSOC) {
+		mutex_lock(&wl->mutex);
+		dev = wl->current_dev;
+		if (dev && b43_status(dev) >= B43_STAT_INITIALIZED)
+			b43_update_cck_rx(dev, sta, !removed);
+		mutex_unlock(&wl->mutex);
+	}
 
 	return 0;
 }
@@ -6130,6 +6227,8 @@ static void b43_op_sw_scan_start_notifie
 	if (dev && (b43_status(dev) >= B43_STAT_INITIALIZED)) {
 		/* Disable CFP update during scan on other channels. */
 		b43_hf_write(dev, b43_hf_read(dev) | B43_HF_SKCFPUP);
+		wl->cck_scanning = true;
+		b43_update_cck_rx(dev, NULL, false);
 	}
 	mutex_unlock(&wl->mutex);
 }
@@ -6145,6 +6244,8 @@ static void b43_op_sw_scan_complete_noti
 	if (dev && (b43_status(dev) >= B43_STAT_INITIALIZED)) {
 		/* Re-enable CFP update. */
 		b43_hf_write(dev, b43_hf_read(dev) & ~B43_HF_SKCFPUP);
+		wl->cck_scanning = false;
+		b43_update_cck_rx(dev, NULL, false);
 	}
 	mutex_unlock(&wl->mutex);
 }
@@ -6313,8 +6414,7 @@ static const struct ieee80211_ops b43_hw
 	.set_tim		= b43_op_beacon_set_tim,
 	.sta_notify		= b43_op_sta_notify,
 	.release_buffered_frames = b43_op_release_buffered_frames,
-	.sta_add		= b43_op_sta_add,
-	.sta_remove		= b43_op_sta_remove,
+	.sta_state		= b43_op_sta_state,
 	.ampdu_action		= b43_op_ampdu_action,
 	.sw_scan_start		= b43_op_sw_scan_start_notifier,
 	.sw_scan_complete	= b43_op_sw_scan_complete_notifier,
--- a/drivers/net/wireless/broadcom/b43/phy_ht.c
+++ b/drivers/net/wireless/broadcom/b43/phy_ht.c
@@ -269,6 +269,20 @@ static u16 b43_phy_ht_classifier(struct
 	return tmp;
 }
 
+/* Turn CCK (802.11b) reception on or off, also for later PHY inits */
+void b43_phy_ht_set_cck_rx(struct b43_wldev *dev, bool on)
+{
+	struct b43_phy_ht *phy_ht = dev->phy.ht;
+
+	if (phy_ht->cck_rx_off == !on)
+		return;
+	phy_ht->cck_rx_off = !on;
+	if (b43_current_band(dev->wl) == NL80211_BAND_2GHZ)
+		b43_phy_ht_classifier(dev, B43_PHY_HT_CLASS_CTL_CCK_EN,
+				      on ? B43_PHY_HT_CLASS_CTL_CCK_EN : 0);
+	b43dbg(dev->wl, "HT-PHY: CCK reception %s\n", on ? "on" : "off");
+}
+
 static void b43_phy_ht_reset_cca(struct b43_wldev *dev)
 {
 	u16 bbcfg;
@@ -1155,6 +1169,7 @@ static int b43_phy_ht_op_init(struct b43
 		b43_phy_ht_classifier(dev, B43_PHY_HT_CLASS_CTL_CCK_EN, 0);
 	else
 		b43_phy_ht_classifier(dev, B43_PHY_HT_CLASS_CTL_CCK_EN,
+				      phy_ht->cck_rx_off ? 0 :
 				      B43_PHY_HT_CLASS_CTL_CCK_EN);
 
 	b43_phy_set(dev, 0xb1, 0x91);
--- a/drivers/net/wireless/broadcom/b43/phy_ht.h
+++ b/drivers/net/wireless/broadcom/b43/phy_ht.h
@@ -136,10 +136,21 @@ struct b43_phy_ht {
 	s32 bb_mult_save[3];
 
 	u8 idle_tssi[3];
+
+	/* 2.4 GHz CCK (802.11b) reception is off */
+	bool cck_rx_off;
 };
 
 
 struct b43_phy_operations;
 extern const struct b43_phy_operations b43_phyops_ht;
 
+#ifdef CPTCFG_B43_PHY_HT
+void b43_phy_ht_set_cck_rx(struct b43_wldev *dev, bool on);
+#else
+static inline void b43_phy_ht_set_cck_rx(struct b43_wldev *dev, bool on)
+{
+}
+#endif
+
 #endif /* B43_PHY_HT_H_ */
