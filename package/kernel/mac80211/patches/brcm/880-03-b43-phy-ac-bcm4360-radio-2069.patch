+static void b43_ac2069_femctrl(struct b43_wldev *dev)
+{
+	struct bcma_drv_cc *cc = &dev->dev->bdev->bus->drv_cc;
+	u16 saved = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x26364 */
+
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x26380 */
+	b43_ac_phy_mod(dev, 0x40a, 0x100, 0);			/* 0x26880 */
+	/*
+	 * 0x26898: si_pmu_regcontrol(sih, 0, 0x4, 0x4), PMU regulator control
+	 * register 0 bit 2. bcma's maskset keeps the bits in its mask.
+	 */
+	bcma_chipco_regctl_maskset(cc, 0, ~0x4, 0x4);
+	/*
+	 * 0x26920: si_corereg(sih, 0, 0x28, 0x00fffffd, 0x10), ChipCommon
+	 * chipcontrol: the bits in 0x00fffffd become 0x10 (literal 0x271a8).
+	 */
+	bcma_cc_maskset32(cc, BCMA_CC_CHIPCTL, ~0x00fffffd, 0x10);
+	b43_ac_tbl_write(dev, 10, 32, 0, 8, b43_ac2069_fem3_tbl10[0]);	/* 0x26aac */
+	b43_ac_tbl_write(dev, 10, 32, 32, 8, b43_ac2069_fem3_tbl10[1]); /* 0x26acc */
+	b43_ac_tbl_write(dev, 10, 32, 64, 8, b43_ac2069_fem3_tbl10[2]); /* 0x26aec */
+	/*
+	 * 0x26af0..0x26b30: shm 0x2fc/0x2fe only for boardtype 0x6aa, which
+	 * b43_ac2069_chan_check() refuses. 0x2713c: boardflags bit 0 is clear.
+	 */
+	b43_ac_phy_mod(dev, 0x19e, 0x2, saved);			/* 0x27194 */
+}
