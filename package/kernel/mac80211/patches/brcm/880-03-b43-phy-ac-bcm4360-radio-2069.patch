+/*
+ * wlc_phy_radio20691_pwron_seq @0x1e364, disasm lines 1-488, for radio rev
+ * at most 26. Every rev-split access in that range takes the movls operand
+ * here; the movhi operand is the rev>26 column and is not used.
+ *
+ * Two blocks of the function are not reached for rev 18 and are omitted:
+ *   disasm lines 29-36  the prefreg-table switch only matches rev 18, 27, 30,
+ *                        and rev 18 falls through to the call at line 37
+ *   disasm lines 112-172 gated by (rev-27) <= 10, i.e. rev 27..37
+ * The tail at lines 173-185 runs for every rev, including 18.
+ *
+ * osl_delay(100) is 100 microseconds in this wl.ko, not 10 or 100 ms.
+ */
+static void b43_phy_ac_radio20691_pwron(struct b43_wldev *dev)
+{
+	static const struct { u16 reg, mask, val; } seq[] = {
+		{ 0xa4, 0x0008, 0x0008 }, { 0xa2, 0x0800, 0x0000 },
+		{ 0x66, 0x0400, 0x0000 }, { 0x86, 0x00f0, 0x00b0 },
+		{ 0xbd, 0x0006, 0x0002 }, { 0xbd, 0x0001, 0x0000 },
+		{ 0xbe, 0x003f, 0x0028 }, { 0xbe, 0x1fc0, 0x0800 },
+		{ 0xbf, 0x00ff, 0x0040 }, { 0xc0, 0x01ff, 0x005a },
+		{ 0xc1, 0x01ff, 0x0000 }, { 0xa1, 0x03e0, 0x0320 },
+		{ 0xa1, 0x1c00, 0x1000 }, { 0x47, 0x8000, 0x8000 },
+		{ 0xb5, 0x000f, 0x000a }, { 0x8a, 0x0002, 0x0002 },
+		{ 0x55, 0x1c00, 0x1000 }, { 0x80, 0x0008, 0x0008 },
+		{ 0x7e, 0x000e, 0x0004 }, { 0xa2, 0x001e, 0x0014 },
+		{ 0xbc, 0x0001, 0x0001 }, { 0xcc, 0x0008, 0x0008 },
+		{ 0xdd, 0x0100, 0x0100 }, { 0xd8, 0x0010, 0x0010 },
+		{ 0x86, 0x00f0, 0x00b0 }, { 0x99, 0x00c0, 0x0080 },
+		{ 0x80, 0x0002, 0x0002 }, { 0x7e, 0x0001, 0x0001 },
+		{ 0xb9, 0x0001, 0x0001 }, { 0xbc, 0x1000, 0x0000 },
+	};
+	size_t i;
+
+	/* lines 2-12: PHY window, then 100 us, then PHY 0x408 = 6 */
+	b43_phy_write(dev, 0x728, 0);
+	b43_phy_write(dev, 0x720, 0x03ff);
+	b43_phy_write(dev, 0x415, 0);
+	b43_phy_write(dev, 0x40e, 0);
+	b43_phy_write(dev, 0x40c, 0x2000);
+	b43_phy_write(dev, 0x408, 0);
+	b43_phy_write(dev, 0x417, 0);
+	b43_phy_write(dev, 0x416, 13);
+	b43_phy_write(dev, 0x408, 7);
+	udelay(100);
+	b43_phy_write(dev, 0x408, 6);
+
+	/* lines 38-111, rev <= 26 column */
+	for (i = 0; i < ARRAY_SIZE(seq); i++)
+		b43_phy_ac_radio_mod(dev, seq[i].reg, seq[i].mask, seq[i].val);
+
+	/* lines 173-185 */
+	b43_phy_write(dev, 0x417, 13);
+	b43_phy_write(dev, 0x408, 2);
+	b43_phy_write(dev, 0x728, 0x0180);
+	udelay(100);
+	b43_phy_write(dev, 0x417, 4);
+	b43_phy_write(dev, 0x728, 0x0080);
+	b43_phy_write(dev, 0x720, 0x0180);
+}
