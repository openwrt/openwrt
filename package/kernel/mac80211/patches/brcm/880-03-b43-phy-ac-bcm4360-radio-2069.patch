+/*
+ * wlc_phy_init_radio_prefregs_allbands @0x54bc0, disasm lines 1-19.
+ * Walks (reg, value) pairs and stops when the following halfword is 0xffff.
+ */
+static void b43_phy_ac_prefregs(struct b43_wldev *dev, const u16 *t, size_t n)
+{
+	size_t i;
+
+	for (i = 0; i < n; i += 2)
+		b43_radio_write(dev, t[i], t[i + 1]);
+}
