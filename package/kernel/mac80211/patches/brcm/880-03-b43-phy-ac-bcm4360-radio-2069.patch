+/*
+ * acphy_httx: HT TX search, the TX power control block (bitmask, default
+ * 0, off). After the HT TX trials (ht20-rev42.md) the PHY's TX power
+ * control registers are the one block where every wl 7.14 capture, the
+ * HT-active one (AP up, ch100/80) included, differs from ours: 0x070 =
+ * 0xe500, 0x071 = 0x04c8, 0x072 bits 0, 2 and 14, 0x644 = 20, 0x646 = the
+ * target; ours 0x070 = 0x0100, 0x071 = 0x0400, 0x072 = 0x000c, 0x644 =
+ * 0x20, 0x646 = 0x30 (reset values: the port never writes them). wl.ko
+ * 6.37 writes them in wlc_phy_txpwrctrl_pwr_setup_acphy @0x3ad34, called
+ * from wlc_phy_txpower_recalc_target_acphy @0x3badc (0x3bb50) on every
+ * target recalculation and followed by txpwrctrl_enable(pi, 0) (0x3bb64):
+ * stock wl keeps the hardware loop off on this board
+ * (txpwrctrl-mode-rev1.md: the only 0x070 bit 13..15 writers are
+ * enable_acphy 0x37238/0x37250 and pwr_setup); wl 7.14 runs the loop.
+ * With the loop off the open-loop gain (table 7 0x100.., table 0x0c
+ * bbmult, chan tail step 11) is one row for legacy and HT frames alike, so
+ * this block ranks low as the HT TX fault; the bits make the trial cheap.
+ *   bit 0 (0x01): pwr_setup's register state for PHY rev 1, 5 GHz ePA,
+ *                 radio rev 4, the loop left off: 0x072 |= 0x0001
+ *                 (0x3ad78); 0x070 &= ~0x8000 (0x3ad8c); 0x070 &= ~0x0100
+ *                 (0x3adfc, PHY rev 1 is not 3 or 8); per core 0x646 +
+ *                 c << 9 bits 0..7 = target qdBm (set_target @0x37040,
+ *                 0x3b300; wl's pi[0x16a + c], the highest rate target);
+ *                 0x072 |= 0x4000 (0x3b0e4 from pi+0x131 = tssiposslope5g
+ *                 1, then 0x3b0f8 unconditionally); 0x070 &= ~0x8000
+ *                 (0x3b10c); per core 0x644 + c << 9 bits 0..6 = 20 for
+ *                 radio rev 4 (set_cur_index @0x182f8, 0x3b110..0x3b144);
+ *                 0x071 bits 0..7 = 0xdc (0x3b210..0x3b258: pi_ac[0x475]
+ *                 = NVRAM pdgain5g, 4 on this board; > 4 gives 0xc8, < 4
+ *                 0x96); 0x071 bits 8..10 = 4 (0x3b26c, 0x3b280); 0x070
+ *                 &= ~0x0800 (0x3b294); 0x070 |= 0x0400 (0x3b2c8, PHY rev
+ *                 1 only). The 0x077 block (0x3b174..0x3b20c) is PHY rev
+ *                 6, the clamp (0x3b084) rev 2. Not ported: the
+ *                 TSSI-to-power tables 0x40/0x60/0x80 (0x3b628..0x3b73c,
+ *                 from pa5ga) and table 0x21 (0x3bab0, pdoffset), lookups
+ *                 of the hardware loop, inert while it is off.
+ *   bit 1 (0x02): the hardware loop on as wl 7.14 runs it: enable(1)
+ *                 @0x37240..0x372ec is 0x070 |= 0xe000 and, radio 0x2069,
+ *                 0x678 &= ~4 (the saved index pi_ac[0x4be + c] is 0x80
+ *                 from attach, so no index write). Implies bit 0. The loop
+ *                 then takes the gain from table 0x20 by its own index
+ *                 (start 20) against the unported estimate tables, so the
+ *                 index drifts within the table (row 0 is wl's open-loop
+ *                 point). Skipped and logged while acphy_txcal or
+ *                 acphy_rxcal is set: wl holds the loop off around its
+ *                 cals (wlc_phy_cals_acphy 0x3bc94, 0x3c174), the port's
+ *                 cals do not.
+ *   bit 2 (0x04): open-loop gain row 0 on every core, wl 6.37's own
+ *                 operating point on every 5 GHz channel of this board
+ *                 (txpower-target-rev1.md section 6: pi_ac[16 + c] stays
+ *                 0), in place of the port's target row.
+ * One "HTTX" line per completed channel set.
+ */
+#define B43_AC_HTTX_PWRSETUP	0x01
+#define B43_AC_HTTX_LOOP	0x02
+#define B43_AC_HTTX_ROW0	0x04
