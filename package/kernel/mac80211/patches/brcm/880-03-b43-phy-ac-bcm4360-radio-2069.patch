+/*
+ * wlc_phy_precal_txgain_acphy(pi, cal_info + 0x82) @0x3a414, PHY rev 1:
+ * clear the ladder flags, then per core in the mask take the TX gain entry
+ * 20 (core 0) or 30 (cores 1, 2) of table 0x20, {20, 30, 20} in sub-band 4
+ * (C.1078.57551, .rodata 0x5a80c), split as
+ * wlc_phy_get_txgain_settings_by_index_acphy @0x28854 does.
+ */
+static void b43_ac2069_precal_txgain(struct b43_wldev *dev,
+				     const struct b43_ac2069_chan *ci)
+{
+	static const u8 idx_sb4[3] = { 20, 30, 20 };
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u8 sb = b43_ac2069_chan_freq_range(ci);			/* 0x3a504 */
+	u16 w[3];
+	u8 c, idx;
+
+	for (c = 0; c < phy_ac->ncores; c++)			/* 0x3a43c..0x3a474 */
+		if (phy_ac->coremask & BIT(c))
+			phy_ac->txcal_ladder[c] = false;
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x3a4d0..0x3a5ec */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		idx = c == 0 ? 20 : 30;				/* 0x3a4fc */
+		if (sb == 4)					/* 0x3a508 */
+			idx = idx_sb4[c];
+		b43_ac_tbl_read48(dev, 0x20, idx, w);		/* 0x28878 */
+		phy_ac->txcal_gain[c][0] = (w[0] >> 8) | (w[1] << 8);
+		phy_ac->txcal_gain[c][1] = (w[1] >> 8) | (w[2] << 8);
+		phy_ac->txcal_gain[c][2] = w[2] >> 8;
+		phy_ac->txcal_gain[c][4] = w[0] & 0xff;		/* bbmult */
+		/* 0x3a5ac: major rev 1 only ORs 0xff into rad_gain_mi */
+	}
+}
+
+/*
+ * wlc_phy_txcal_txgain_setup_acphy(pi, cal_info + 0x82, save) @0x28b20 and
+ * wlc_phy_txcal_txgain_cleanup_acphy(pi, save) @0x24ed0: per core in the
+ * mask, table 7 gain words and the bbmult, PHY 0x19e bit 1 held.
+ */
+static void b43_ac2069_txcal_txgain(struct b43_wldev *dev,
+				    struct b43_ac2069_txcal_save *sv, bool setup)
+{
+	static const u8 bbmult_off[3] = { 0x63, 0x67, 0x6b };	/* .rodata 0x5a534 */
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 s = b43_phy_read(dev, 0x19e) & 0x2;			/* 0x28b40 */
+	const u16 *g;
+	u8 c, i;
+
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x28b5c */
+	for (c = 0; c < phy_ac->ncores; c++) {
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		if (setup) {
+			for (i = 0; i < 3; i++)			/* 0x28b8c.. */
+				sv->gain[c][i] = b43_ac_tbl_read16(dev, 7,
+							0x100 + 3 * i + c);
+			g = phy_ac->txcal_gain[c];
+		} else {
+			g = sv->gain[c];
+		}
+		for (i = 0; i < 3; i++)
+			b43_ac_tbl_write16(dev, 7, 0x100 + 3 * i + c, g[i]);
+		if (setup)	/* wlc_phy_get_tx_bbmult_acphy @0x28ad0 */
+			sv->gain[c][4] = b43_ac_tbl_read16(dev, 0x0c,
+							   bbmult_off[c]);
+		b43_ac_set_tx_bbmult(dev, g[4], c);		/* @0x24e14 */
+	}
+	b43_ac_phy_mod(dev, 0x19e, 0x2, s);			/* 0x28ca4, 0x24fb8 */
+}
+
+/*
+ * wlc_phy_pulse_adc_reset_acphy @0x19bac: per core in the mask set 0x739
+ * bit 7, 0x73a bit 7, 0x725 bits 2 and 9 for 1 us, then put the three
+ * registers back in reverse order.
+ */
+static void b43_ac_pulse_adc_reset(struct b43_wldev *dev)
+{
+	static const u16 reg[3] = { 0x739, 0x73a, 0x725 };
+	static const u16 set[3] = { 0x0080, 0x0080, 0x0204 };
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 v[3][3] = { };
+	int c, i;
+
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x19bc4..0x19c98 */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		for (i = 0; i < 3; i++) {
+			v[c][i] = b43_phy_read(dev, reg[i] + (c << 9));
+			b43_phy_write(dev, reg[i] + (c << 9), v[c][i] | set[i]);
+		}
+	}
+	udelay(1);						/* 0x19cb8 */
+	for (c = phy_ac->ncores - 1; c >= 0; c--) {		/* 0x19ccc..0x19ce8 */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		for (i = 2; i >= 0; i--)
+			b43_phy_write(dev, reg[i] + (c << 9), v[c][i]);
+	}
+	udelay(1);						/* 0x19cf8 */
+}
+
+/* wlc_phy_txcal_phy_setup_acphy @0x1a154, this board's path */
+static void b43_ac2069_txcal_phy_setup(struct b43_wldev *dev,
+				       struct b43_ac2069_txcal_save *sv)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 b;
+	u8 c, i;
+
+	sv->phy19e = b43_phy_read(dev, 0x19e);			/* 0x1a168 */
+	sv->phy40f = b43_phy_read(dev, 0x40f);			/* 0x1a17c */
+	b43_ac_phy_mod(dev, 0x40f, 0x200, 0);			/* 0x1a300 */
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x1a370..0x1bd0c */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		b = c << 9;
+		sv->phy[c][0x1e] = b43_phy_read(dev, 0x73e + b);	/* 0x1a3a0 */
+		b43_phy_write(dev, 0x73e + b, 0);			/* 0x1a3b8 */
+		b43_ac_phy_mod(dev, 0x73e + b, 0x0010, 0);		/* 0x1a410 */
+		b43_ac_phy_mod(dev, 0x73e + b, 0x0020, 0);		/* 0x1a468 */
+		b43_ac_phy_mod(dev, 0x73e + b, 0x0040, 0);		/* 0x1a4c0 */
+		b43_ac_phy_mod(dev, 0x73e + b, 0x0080, 0);		/* 0x1a518 */
+		b43_ac_phy_mod(dev, 0x73e + b, 0x1000, 0x1000);		/* 0x1a570 */
+		b43_ac_phy_mod(dev, 0x73e + b, 0x0400, 0x0400);		/* 0x1a5cc */
+		for (i = 0; i < ARRAY_SIZE(b43_ac_txcal_phy_saved); i++) /* 0x1a5ec..0x1a788 */
+			sv->phy[c][b43_ac_txcal_phy_saved[i] - 0x720] =
+				b43_phy_read(dev, b43_ac_txcal_phy_saved[i] + b);
+		for (i = 0; i < ARRAY_SIZE(b43_ac_txcal_phy_mods1); i++)
+			b43_ac_phy_mod(dev, b43_ac_txcal_phy_mods1[i][0] + b,
+				       b43_ac_txcal_phy_mods1[i][1],
+				       b43_ac_txcal_phy_mods1[i][2]);
+		b43_phy_write(dev, 0x724 + b, 0x3ff);			/* 0x1b1f8 */
+		b43_phy_write(dev, 0x736 + b, 0x152);			/* 0x1b208 */
+		for (i = 0; i < ARRAY_SIZE(b43_ac_txcal_phy_mods2); i++)
+			b43_ac_phy_mod(dev, b43_ac_txcal_phy_mods2[i][0] + b,
+				       b43_ac_txcal_phy_mods2[i][1],
+				       b43_ac_cal_bw_field(b43_ac_txcal_phy_mods2[i][0],
+							   b43_ac_txcal_phy_mods2[i][1],
+							   b43_ac_txcal_phy_mods2[i][2],
+							   sv->bw, true));
+	}
+	b43_ac_phy_mod(dev, 0x19e, 0x040, 0x040);		/* 0x1bd28 */
+	b43_ac_phy_mod(dev, 0x19e, 0x080, 0x080);		/* 0x1bd3c */
+	b43_ac_phy_mod(dev, 0x19e, 0x100, 0x100);		/* 0x1bd50 */
+	b43_ac_pulse_adc_reset(dev);				/* 0x1bd60 */
+}
+
+/*
+ * The TX tone samples of wlc_phy_tx_tone_acphy @0x2e704 (f kHz, amplitude
+ * max): theta steps by ((36 f / bw) << 16) / 100 degrees in 16.16 fixed
+ * point, sample t is wlc_phy_cordic @0x5dc04 of t * step, scaled by max
+ * with round half away from zero. wl's cordic and its AtanTbl (.rodata
+ * 0x5b4f8) are the kernel's cordic_calc_iq and arctan_table, which take
+ * whole degrees, so a step with a fraction is refused (bw * 50 kHz with
+ * 2 * bw samples: 18 degrees at 20, 40 and 80 MHz).
+ * Table 14 word, wlc_phy_loadsampletable_acphy @0x25284: q in bits 0..9, i
+ * in bits 10..19.
+ */
+static int b43_ac2069_tone_samples(struct b43_wldev *dev, u32 *buf,
+				   unsigned int n, s32 f_khz, u8 bw, s32 max)
+{
+	/* signed, as wl's __aeabi_idiv: the RX IQ cal also plays -1000 */
+	s32 rot = ((36 * f_khz) / bw) * 65536 / 100;		/* 0x2e784..0x2e7a4 */
+	struct cordic_iq iq;
+	unsigned int t;
+	s32 i, q;
+
+	if (rot & 0xffff) {
+		b43err(dev->wl, "radio 0x2069: TX tone step 0x%x is not whole degrees, not ported\n",
+		       (u32)rot);
+		return -EOPNOTSUPP;
+	}
+	for (t = 0; t < n; t++) {				/* 0x2e7b4..0x2e834 */
+		iq = cordic_calc_iq((s32)t * (rot >> 16));
+		q = CORDIC_FLOAT(iq.q * max);
+		i = CORDIC_FLOAT(iq.i * max);
+		buf[t] = ((u32)q & 0x3ff) | (((u32)i & 0x3ff) << 10); /* 0x252bc..0x252d4 */
+	}
+	return 0;
+}
+
+/*
+ * wlc_phy_tx_tone_acphy(pi, f, max, iqmode, dac_test 0, modify_bbmult 0)
+ * @0x2e704 with the samples already made: load table 14, save the bbmult
+ * once, then wlc_phy_runsamples_acphy.clone.29 @0x2e574. iqmode 1 (TX IQ/LO
+ * cal) plays through the cal engine, PHY 0x382 bit 15; iqmode 0 (RX IQ cal)
+ * is a plain sample play, PHY 0x460 bit 0, inside a carrier search hold
+ * (0x2e58c, 0x2e6fc). Returns false if the RF sequencer wait (PHY 0x403
+ * bit 0, 100 x 10 us, 0x2e6b4..0x2e6d8) runs out.
+ */
+static bool b43_ac2069_tx_tone(struct b43_wldev *dev, const u32 *buf,
+			       unsigned int n, bool iqmode)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	unsigned int i;
+	bool busy;
+	u16 s400;
+	u8 c;
+
+	b43_ac_tbl_write(dev, 14, n, 0, 32, buf);		/* 0x25300 */
+	if (!phy_ac->tone_bbmult_saved) {			/* 0x2e868 */
+		for (c = 0; c < phy_ac->ncores; c++)
+			if (phy_ac->coremask & BIT(c))		/* 0x2e89c */
+				phy_ac->tone_bbmult[c] = b43_ac_tbl_read16(dev,
+							0x0c, 0x63 + 4 * c);
+		phy_ac->tone_bbmult_saved = true;
+	}
+	/* max != 0 and modify_bbmult 0: no bbmult write (0x2e8bc..0x2e8d8) */
+	/* runsamples, dac_test 0: path 0x2e5f8 */
+	if (!iqmode)
+		b43_ac_carriersearch_enter(dev);		/* 0x2e590 */
+	b43_phy_mask(dev, 0x471, 0xfffe);			/* 0x2e608 */
+	b43_phy_write(dev, 0x463, n - 1);			/* 0x2e61c */
+	b43_phy_write(dev, 0x461, 0xffff);			/* 0x2e62c, loops */
+	b43_phy_write(dev, 0x462, 60);				/* 0x2e63c, wait */
+	s400 = b43_phy_read(dev, 0x400);			/* 0x2e648 */
+	b43_phy_set(dev, 0x400, 0x1);				/* 0x2e65c */
+	b43_phy_mask(dev, 0x460, 0xfffb);			/* 0x2e66c */
+	b43_phy_mask(dev, 0x460, 0xfffe);			/* 0x2e67c */
+	b43_phy_mask(dev, 0x382, 0x3fff);			/* 0x2e68c */
+	if (iqmode)
+		b43_phy_set(dev, 0x382, 0x8000);		/* 0x2e6ac */
+	else
+		b43_phy_set(dev, 0x460, 0x1);			/* 0x2e6ac */
+	for (i = 0; ; i++) {
+		busy = b43_phy_read(dev, 0x403) & 0x1;
+		if (!busy || i == 100)
+			break;
+		udelay(10);
+	}
+	b43_phy_write(dev, 0x400, s400);			/* 0x2e6e8 */
+	if (!iqmode)
+		b43_ac_carriersearch_exit(dev);			/* 0x2e700 */
+	return !busy;
+}
+
+/* wlc_phy_stopplayback_acphy @0x2e1cc */
+static void b43_ac2069_stopplayback(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 v = b43_phy_read(dev, 0x464);			/* 0x2e1dc */
+	u8 c;
+
+	if (v & 0x1)
+		b43_phy_set(dev, 0x460, 0x2);			/* 0x2e1f4 */
+	else if (v & 0x2)
+		b43_phy_mask(dev, 0x382, 0x7fff);		/* 0x2e210 */
+	b43_phy_mask(dev, 0x460, 0xfffb);			/* 0x2e220 */
+	if (phy_ac->tone_bbmult_saved) {			/* 0x2e224 */
+		for (c = 0; c < phy_ac->ncores; c++)
+			if (phy_ac->coremask & BIT(c))		/* 0x2e25c */
+				b43_ac_set_tx_bbmult(dev,
+						     phy_ac->tone_bbmult[c], c);
+		phy_ac->tone_bbmult_saved = false;
+	}
+	b43_ac_resetcca(dev);					/* 0x2e284 */
+}
+
+/*
+ * wlc_phy_populate_tx_loft_comp_tbl_acphy(pi, loft) @0x303f8, PHY rev 1:
+ * 128 entries of the LOFT tables 0x42/0x62/0x82, one per core. Core 0 gets
+ * its LO d result as is; on 5 GHz cores 1 and 2 get per-byte offsets that
+ * depend on the channel and the entry index (.rodata 0x5a6b0..0x5a6d2).
+ */
+static void b43_ac2069_populate_loft(struct b43_wldev *dev, const u16 *loft)
+{
+	static const u8 chan_thr[3] = { 200, 149, 100 };	/* C.3370 */
+	static const u8 idx_thr[6] = { 128, 128, 32, 128, 26, 28 }; /* C.3367 */
+	static const u8 add_hi[12] = { 0, 0, 0, 0, 0, 0,
+				       236, 246, 246, 248, 246, 250 }; /* C.3368 */
+	static const u8 add_lo[12] = { 0, 0, 0, 0, 0, 0,
+				       0, 251, 242, 252, 246, 251 };   /* C.3369 */
+	static const u16 tbl[3] = { 0x42, 0x62, 0x82 };
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u8 chan = phy_ac->chanspec & 0xff;
+	bool g5 = (phy_ac->chanspec & 0xc000) != 0;
+	u8 c, f, j;
+	u16 k, v;
+
+	for (k = 0; k < 128; k++) {				/* 0x3049c..0x305a8 */
+		for (c = 0; c < phy_ac->ncores && c < 3; c++) {	/* no mask test */
+			v = loft[c];
+			if (c && g5) {				/* 0x304dc..0x30548 */
+				f = chan >= chan_thr[c];	/* 0x3047c..0x30490 */
+				j = 2 * (2 * c + f) + (idx_thr[3 * f + c] >= k);
+				v = (u16)((u8)((v >> 8) + add_hi[j]) << 8) |
+				    (u8)((v & 0xff) + add_lo[j]);
+			}
+			b43_ac_tbl_write16(dev, tbl[c], k, v);	/* 0x30584 */
+		}
+	}
+}
+
+/* PHY 0x380 busy bits 14..15, 2000 x 10 us (0x31ca8..0x31ce8) */
+static bool b43_ac_txiqlo_wait(struct b43_wldev *dev)
+{
+	unsigned int i;
+
+	for (i = 0; i < 2000; i++) {
+		if (!(b43_phy_read(dev, 0x380) & 0xc000))
+			return true;
+		udelay(10);
+	}
+	return !(b43_phy_read(dev, 0x380) & 0xc000);
+}
+
+/*
+ * One measurement step of the loop at 0x31a34..0x31fd4: command cmds[i] for
+ * core c. Returns 0, or -ETIMEDOUT if the engine stays busy.
+ */
+static int b43_ac2069_txiqlo_step(struct b43_wldev *dev,
+				  struct b43_ac2069_txcal_save *sv,
+				  const u16 *cmds, u8 c, u8 i)
+{
+	static const u16 zero[1];
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 cmd = (cmds[i] & 0x7fff) | 0x8000 | (c << 12);	/* 0x31a64..0x31a70 */
+	u8 type = (cmd >> 8) & 0xf;				/* 0x31a78 */
+	u8 rd, wr, mem, g, k;
+	u16 buf[2] = { };
+	u16 s, bbmult;
+
+	switch (type) {						/* 0x31e5c..0x31ee4 */
+	case 0:
+		rd = 4; wr = 0; mem = 12;
+		break;
+	case 2:
+		rd = 5; wr = 1; mem = 13;
+		break;
+	case 3:
+		rd = 6; wr = 2; mem = 14;
+		break;
+	case 4:
+		rd = 7; wr = 3; mem = 15;
+		break;
+	default:	/* type 1 keeps the previous step's choice in wl */
+		b43err(dev->wl, "radio 0x2069: TX IQ/LO command 0x%04x type %u not ported\n",
+		       cmd, type);
+		return -EOPNOTSUPP;
+	}
+
+	if (!phy_ac->txcal_ladder[c]) {				/* 0x31a84 */
+		bbmult = phy_ac->txcal_gain[c][4];		/* 0x31aa4 */
+		s = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x31ae8 */
+		b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);		/* 0x31b04 */
+		for (k = 0; k < 18; k++) {			/* 0x31b08..0x31bb4 */
+			b43_ac_tbl_write16(dev, 12, k,
+				((b43_ac_txiqlo_ladder_lo[k][0] * bbmult / 100) << 8) |
+				b43_ac_txiqlo_ladder_lo[k][1]);	/* 0x31b58 */
+			b43_ac_tbl_write16(dev, 12, k + 32,
+				((b43_ac_txiqlo_ladder_iq[k][0] * bbmult / 100) << 8) |
+				b43_ac_txiqlo_ladder_iq[k][1]);	/* 0x31bac */
+		}
+		b43_ac_phy_mod(dev, 0x19e, 0x2, s);		/* 0x31bcc */
+		phy_ac->txcal_ladder[c] = true;			/* 0x31bdc */
+	}
+	b43_phy_write(dev, 0x381, sv->nnum);			/* 0x31c00 */
+	if (type == 3 || type == 4)				/* 0x31c50, rev 1 */
+		b43_ac2069_txiqlo_set(dev, zero, 1, c);
+	if (type == 4)						/* 0x31c78 */
+		b43_ac2069_txiqlo_set(dev, zero, 2, c);
+
+	for (g = 0; g < ARRAY_SIZE(b43_ac_txiqlo_gctl); g++) {	/* 0x31c9c..0x31e54 */
+		b43_phy_write(dev, 0x383, b43_ac_txiqlo_gctl[g]); /* 0x31cac */
+		b43_phy_write(dev, 0x380, cmd);			/* 0x31cbc */
+		if (!b43_ac_txiqlo_wait(dev)) {
+			sv->timeouts++;
+			b43err(dev->wl, "radio 0x2069: TX IQ/LO command 0x%04x (core %u, gain %u) still busy after 20 ms, PHY 0x380 = 0x%04x\n",
+			       cmd, c, b43_ac_txiqlo_gctl[g],
+			       b43_phy_read(dev, 0x380));
+			return -ETIMEDOUT;
+		}
+		/* radio 0x144 bit 2, chip 0x4360 (0x31d3c..0x31d90) */
+		if (!(b43_radio_read(dev, 0x144 | (c << 9)) & 0x4))
+			break;
+		b43_ac_phy_mod(dev, 0x73a + (c << 9), 0x100, 0x100); /* 0x31df0 */
+		b43_ac_phy_mod(dev, 0x73a + (c << 9), 0x100, 0);	/* 0x31e48 */
+	}
+	if (g == ARRAY_SIZE(b43_ac_txiqlo_gctl))	/* wl goes on (0x31e54) */
+		b43info(dev->wl, "radio 0x2069: TX IQ/LO command 0x%04x (core %u): radio 0x%03x bit 2 set at every gain, result kept as wl does\n",
+			cmd, c, 0x144 | (c << 9));
+
+	b43_ac2069_txiqlo_get(dev, buf, rd, c);	/* 0x31f00 */
+	b43_ac2069_txiqlo_set(dev, buf, wr, c);	/* 0x31f18 */
+	if (i > 4)						/* 0x31f28, rev 1 */
+		sv->loft[c] = buf[0];
+	b43_ac2069_txiqlo_set(dev, buf, mem, c);	/* 0x31f58 */
+	return 0;
+}
+
+/*
+ * wlc_phy_cal_txiqlo_acphy(pi, searchmode, mphase 0) @0x305c4, the
+ * single-phase path. Returns 0 with the results in table 12 types 8/9
+ * (and 10/11, 16..19) and the LOFT tables, or an error with neither
+ * touched; the hardware state is restored either way.
+ */
+static int b43_ac2069_txiqlo_cal(struct b43_wldev *dev, bool refine)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	struct b43_ac2069_txcal_save sv = { };
+	const u16 *cmds, *src;
+	static const u16 zero15[15];
+	unsigned int nsamp;
+	u16 buf[2], b;
+	u8 c, i, step, nsteps, mhz;
+	u32 *samp;
+	int err;
+
+	/* 0x30718..0x3073c, 0x30854..0x30878: bw index and PHY 0x381 */
+	sv.bw = b43_ac_bw_idx(phy_ac->chanspec);
+	mhz = b43_ac_cal_bw_mhz[sv.bw];
+	sv.nnum = B43_AC_TXIQLO_NNUM_HI << 8 | b43_ac_txiqlo_nnum_lo[sv.bw];
+	/*
+	 * The tone needs no hardware to compute; wl mallocs it too (0x2e770,
+	 * 2 * bw words): bw * 100 / 2 kHz (0x31890..0x318bc), amplitude 250.
+	 */
+	nsamp = 2 * mhz;					/* 0x2e75c */
+	samp = kmalloc_array(nsamp, sizeof(*samp), GFP_KERNEL);
+	if (!samp)
+		return -ENOMEM;
+	err = b43_ac2069_tone_samples(dev, samp, nsamp, mhz * 100 / 2, mhz,
+				      B43_AC_TXIQLO_TONE_AMP);
+	if (err) {
+		kfree(samp);
+		return err;
+	}
+
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x30684..0x306fc */
+		b = c << 9;
+		sv.phy678[c] = b43_phy_read(dev, 0x678 + b);
+		b43_ac_phy_mod(dev, 0x678 + b, 0x1, 0);
+	}
+	b43_ac_carriersearch_enter(dev);			/* 0x30734 */
+	sv.phy140 = b43_phy_read(dev, 0x140);			/* 0x30a38 */
+	b43_ac_phy_mod(dev, 0x140, 0x7, 0x4);			/* 0x30a4c, classifier */
+
+	/* radio, 0x30f58..0x315d0: 2069, chip 0x4360, major 0, 5 GHz */
+	for (c = 0; c < phy_ac->ncores; c++) {
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		b = c << 9;
+		for (i = 0; i < ARRAY_SIZE(b43_ac2069_txcal_radio_regs); i++)
+			sv.radio[c][i] = b43_radio_read(dev,
+					b43_ac2069_txcal_radio_regs[i] | b);
+		b43_ac2069_mod(dev, 26 | b, 0x00f0, 0x00b0);	/* 0x31214 */
+		b43_ac2069_mod(dev, 31 | b, 0x0004, 0x0004);	/* 0x31258 */
+		b43_ac2069_mod(dev, 0x170 | b, 0x0100, 0x0100);	/* 0x312ac */
+		b43_ac2069_mod(dev, 0x170 | b, 0x4000, 0);	/* 0x31318 */
+		b43_ac2069_mod(dev, 30 | b, 0x0004, 0);		/* 0x314e8 */
+		b43_ac2069_mod(dev, 26 | b, 0x0300, 0);		/* 0x3152c */
+	}
+
+	b43_ac2069_txcal_phy_setup(dev, &sv);			/* 0x315f8 */
+	b43_ac2069_txcal_txgain(dev, &sv, true);		/* 0x3160c */
+	b43_phy_force_clock(dev, true);				/* 0x3161c, phyclk_fgc(1) */
+	b43_phy_write(dev, 0x382, 0x8a09);			/* 0x316a4 */
+
+	/* start coefficients, 0x316c4..0x3179c */
+	src = refine ? phy_ac->txiqlo_final : zero15;
+	memcpy(phy_ac->txiqlo_mem, src, sizeof(phy_ac->txiqlo_mem));
+	for (c = 0; c < phy_ac->ncores; c++) {
+		b43_ac2069_txiqlo_set(dev, src + 5 * c, 0, c);
+		b43_ac2069_txiqlo_set(dev, src + 5 * c + 2, 1, c);
+		b43_ac2069_txiqlo_set(dev, src + 5 * c + 3, 2, c);
+		b43_ac2069_txiqlo_set(dev, src + 5 * c + 4, 3, c);
+	}
+	cmds = refine ? b43_ac_txiqlo_cmds_refine : b43_ac_txiqlo_cmds_restart;
+	nsteps = ARRAY_SIZE(b43_ac_txiqlo_cmds_restart) * phy_ac->ncores;
+
+	if (!b43_ac2069_tx_tone(dev, samp, nsamp, true)) {	/* 0x318cc */
+		sv.timeouts++;
+		b43err(dev->wl, "radio 0x2069: TX tone: RF sequencer still busy after 1 ms (PHY 0x403 = 0x%04x)\n",
+		       b43_phy_read(dev, 0x403));
+		err = -ETIMEDOUT;
+	}
+	udelay(5);						/* 0x318d8 */
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x31908..0x319e8 */
+		b43_ac_phy_mod(dev, 0x73a + (c << 9), 0x100, 0);
+		b43_ac_phy_mod(dev, 0x725 + (c << 9), 0x400, 0x400);
+	}
+
+	for (step = 0; !err && step < nsteps; step++)		/* 0x31fd4 */
+		err = b43_ac2069_txiqlo_step(dev, &sv, cmds,
+					     step / ARRAY_SIZE(b43_ac_txiqlo_cmds_restart),
+					     step % ARRAY_SIZE(b43_ac_txiqlo_cmds_restart));
+
+	if (!err) {						/* 0x32008..0x32158 */
+		for (c = 0; c < phy_ac->ncores; c++) {
+			b43_ac2069_txiqlo_get(dev, buf, 12, c);
+			b43_ac2069_txiqlo_set(dev, buf, 16, c);
+			b43_ac2069_txiqlo_set(dev, buf, 8, c);
+			b43_ac2069_txiqlo_set(dev, buf, 10, c);
+			b43_ac2069_txiqlo_get(dev, buf, 13, c);
+			b43_ac2069_txiqlo_set(dev, buf, 17, c);
+			b43_ac2069_txiqlo_set(dev, buf, 9, c);
+			b43_ac2069_txiqlo_set(dev, buf, 11, c);
+			b43_ac2069_txiqlo_get(dev, buf, 14, c);
+			b43_ac2069_txiqlo_set(dev, buf, 18, c);
+			b43_ac2069_txiqlo_get(dev, buf, 15, c);
+			b43_ac2069_txiqlo_set(dev, buf, 19, c);
+		}
+		phy_ac->txiqlo_valid = true;			/* 0x32150 */
+		phy_ac->txcal_chanspec = phy_ac->chanspec;	/* 0x32158 */
+	}
+
+	b43_ac2069_stopplayback(dev);				/* 0x32160 */
+	b43_phy_write(dev, 0x382, 0);				/* 0x32170 */
+	b43_phy_force_clock(dev, false);			/* 0x32180 */
+	if (!err)
+		b43_ac2069_populate_loft(dev, sv.loft);		/* 0x32198, rev 1 */
+	b43_ac2069_txcal_txgain(dev, &sv, false);		/* 0x321a4 */
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x32234..0x323f4 */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		for (i = 0; i < ARRAY_SIZE(b43_ac_txcal_phy_restore); i++)
+			b43_phy_write(dev, b43_ac_txcal_phy_restore[i] + (c << 9),
+				      sv.phy[c][b43_ac_txcal_phy_restore[i] - 0x720]);
+	}
+	b43_phy_write(dev, 0x19e, sv.phy19e);			/* 0x32418 */
+	b43_phy_write(dev, 0x40f, sv.phy40f);			/* 0x32428 */
+	b43_ac_resetcca(dev);					/* 0x324d8, rev 1 */
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x32650..0x3287c */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		for (i = 0; i < ARRAY_SIZE(b43_ac2069_txcal_radio_regs); i++)
+			b43_radio_write(dev, b43_ac2069_txcal_radio_regs[i] | (c << 9),
+					sv.radio[c][i]);
+	}
+	b43_phy_write(dev, 0x140, sv.phy140);			/* 0x32890 */
+	b43_ac_carriersearch_exit(dev);				/* 0x3289c */
+	for (c = 0; c < phy_ac->ncores; c++)			/* 0x328a4..0x328d8 */
+		b43_phy_write(dev, 0x678 + (c << 9), sv.phy678[c]);
+
+	if (sv.timeouts)
+		b43err(dev->wl, "radio 0x2069: TX IQ/LO cal: %u poll timeouts\n",
+		       sv.timeouts);
+	kfree(samp);
+	return err;
+}
+
+/*
+ * On a failed cal: the state before this port had a cal, the zeroed TX IQ
+ * (type 8) and LO (type 9) coefficients the band change writes and the
+ * all-zero LOFT tables regtbl_on_pwron loads (regtbl-on-pwron-rev1.md rows
+ * 11..13). Types 10 and 11, the second copy the final step writes next to
+ * 8 and 9 (0x32008..0x32158), are zeroed too: otherwise a failed cal after
+ * a good one on another channel leaves that channel's results there
+ * (rxiq-cal-2069.md, "TX IQ/LO port review"). wl has no failure path.
+ */
+static void b43_ac2069_txcal_zero(struct b43_wldev *dev)
+{
+	static const u16 zero[2];
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	static const u16 tbl[3] = { 0x42, 0x62, 0x82 };
+	u16 saved = b43_phy_read(dev, 0x19e) & 0x2;
+	u16 k;
+	u8 c;
+
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);
+	for (c = 0; c < phy_ac->ncores; c++) {
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		b43_ac2069_cal_txiqlo_coeffs_write(dev, zero, 8, c);
+		b43_ac2069_cal_txiqlo_coeffs_write(dev, zero, 9, c);
+		b43_ac2069_cal_txiqlo_coeffs_write(dev, zero, 10, c);
+		b43_ac2069_cal_txiqlo_coeffs_write(dev, zero, 11, c);
+	}
+	for (c = 0; c < phy_ac->ncores && c < 3; c++)
+		for (k = 0; k < 128; k++)
+			b43_ac_tbl_write16(dev, tbl[c], k, 0);
+	b43_ac_phy_mod(dev, 0x19e, 0x2, saved);
+	phy_ac->txiqlo_valid = false;
+}
+
+/*
+ * RX IQ calibration (rxiq-cal-2069.md): wlc_phy_cal_rx_fdiqi_acphy @0x333f0
+ * with wlc_phy_rx_iq_est_acphy @0x328ec, wlc_phy_calc_iq_mismatch_acphy
+ * @0x1e088, wlc_phy_rx_iq_comp_acphy @0x175f4, wlc_phy_rx_fdiqi_comp_acphy
+ * @0x18140, wlc_phy_rxcal_radio_setup_acphy @0x1c85c / _cleanup @0x1d28c and
+ * wlc_phy_rxcal_loopback_gainctrl_acphy @0x32e10, for this board's path:
+ * PHY rev 1, radio 0x2069 rev 4 (major 0), chip 0x4360, 3 cores in the mask,
+ * 5 GHz, 20 or 40 MHz. On that path the frequency-dependent part is off
+ * (pi_ac[0x964] = 0 for 20 and 40 MHz, 0x35398) and so is the noise measurement
+ * (pi_ac[0x978] = 0 for PHY rev 1 on 5 GHz, 0x33470): two loopback tones,
+ * one compensation pair per core. Runs only with acphy_rxcal >= 1.
+ */
+
+/* ARM shifts by a register (amount = low byte), as wl's helpers do them */
+static s32 b43_ac_lsl(s32 v, s32 n)
+{
+	n &= 0xff;
+	return n >= 32 ? 0 : (s32)((u32)v << n);
+}
+
+static s32 b43_ac_asr(s32 v, s32 n)
+{
+	n &= 0xff;
+	if (n >= 32)
+		return v < 0 ? -1 : 0;
+	return v >> n;
+}
+
+/* __aeabi_idiv without the C traps: x / 0 is never reached in wl (tested) */
+static s32 b43_ac_idiv(s32 a, s32 b)
+{
+	if (!b)
+		return 0;
+	if (b == -1)
+		return (s32)(0u - (u32)a);
+	return a / b;
+}
+
+/* wlc_phy_nbits @0x5f6b0: bits in |v| (|INT_MIN| counts as 0, as in wl) */
+static s16 b43_ac_nbits(s32 v)
+{
+	s32 a = v < 0 ? (s32)(0u - (u32)v) : v;
+	s16 n = 0;
+
+	while (b43_ac_asr(a, n) > 0)
+		n++;
+	return n;
+}
+
+/* wlc_phy_sqrt_int @0x5f6d8: bitwise integer square root, rounded up once */
+static u32 b43_ac_sqrt_int(u32 x)
+{
+	u32 root = 0, bit, t;
+	unsigned int s;
+
+	for (s = 0; s < 32; s += 2) {
+		bit = 0x40000000u >> s;
+		t = bit + root;
+		root >>= 1;
+		if (t <= x) {
+			x -= t;
+			root |= bit;
+		}
+	}
+	if (root < x)						/* 0x5f710 */
+		root++;
+	return root;
+}
+
+/* AtanTbl, .rodata 0x5b4f8: atan(2^-k) in degrees, 16.16 */
+static const s32 b43_ac_atan_tbl[18] = {
+	2949120, 1740967, 919879, 466945, 234379, 117304, 58666, 29335,
+	14668, 7334, 3667, 1833, 917, 458, 229, 115, 57, 29,
+};
+
+/*
+ * wlc_phy_cordic @0x5dc04 on a 16.16 degree angle (the kernel's
+ * cordic_calc_iq takes whole degrees only): q (offset 0, sine) and i
+ * (offset 4, cosine), both about 2^16 at full scale.
+ */
+static void b43_ac_cordic(s32 theta, s32 *q, s32 *i)
+{
+	s32 sign = theta >= 0 ? 1 : -1, signx = 1, ang = 0, x = 39797, y = 0, t;
+	unsigned int k;
+
+	theta = (theta + 0xb40000 * sign) % 0x1680000 - 0xb40000 * sign;
+	if (theta >= 0) {					/* 0x5dc44 */
+		if (((theta >> 15) + 1) >> 1 > 90) {
+			theta -= 0xb40000;
+			signx = -1;
+		}
+	} else if (-((((-theta) >> 15) + 1) >> 1) < -90) {	/* 0x5dc60 */
+		theta += 0xb40000;
+		signx = -1;
+	}
+	for (k = 0; k < 18; k++) {				/* 0x5dc9c..0x5dce8 */
+		if (theta > ang) {
+			t = y + (x >> k);
+			x = x - (y >> k);
+			ang += b43_ac_atan_tbl[k];
+		} else {
+			t = y - (x >> k);
+			x = x + (y >> k);
+			ang -= b43_ac_atan_tbl[k];
+		}
+		y = t;
+	}
+	*q = y * signx;
+	*i = x * signx;
+}
+
+/* wlc_phy_inv_cordic @0x5dd10: atan2(y, x) in 16.16 degrees, x > 0 */
+static s32 b43_ac_inv_cordic(s32 y, s32 x)
+{
+	s32 ang = 0, xs, ys;
+	unsigned int k;
+
+	x = b43_ac_lsl(x, 4);
+	y = b43_ac_lsl(y, 4);
+	for (k = 0; k < 18; k++) {
+		xs = x >> k;
+		ys = y >> k;
+		if (y < 0) {
+			y += xs;
+			x -= ys;
+			ang -= b43_ac_atan_tbl[k];
+		} else {
+			y -= xs;
+			x += ys;
+			ang += b43_ac_atan_tbl[k];
+		}
+	}
+	return ang;
+}
+
+/*
+ * One core's estimator results (wlc_phy_rx_iq_est_acphy, 12 bytes per core):
+ * PHY 0x6c1:0x6c0, 0x6c3:0x6c2, 0x6c5:0x6c4 + core << 9. The names (IQ
+ * product, I power, Q power) follow how wl's mismatch math uses them.
+ */
+struct b43_ac_iq_est {
+	s32 iq;
+	s32 ii;
+	s32 qq;
+};
+
+/*
+ * wlc_phy_calc_iq_mismatch_acphy @0x1e088: phase = atan2(-iq, sqrt(ii qq))
+ * in 16.16 degrees ([out+0]) and amplitude = sqrt(qq / ii) in Q10
+ * ([out+4]), integer steps exactly as wl does them.
+ */
+static void b43_ac_calc_iq_mismatch(const struct b43_ac_iq_est *e,
+				    s32 *angle, s32 *mag)
+{
+	s16 n_iq = b43_ac_nbits(e->iq), n_qq = b43_ac_nbits(e->qq);
+	s16 n_max = b43_ac_nbits(e->ii), n;
+	s32 a, r0, r1, num, sinv, cosv, d;
+
+	if (n_max < n_qq)					/* 0x1e0c4 */
+		n_max = n_qq;
+	if (n_max <= 30) {					/* 0x1e0d4 */
+		a = b43_ac_sqrt_int(b43_ac_lsl(e->ii, 30 - n_max));
+		r0 = b43_ac_lsl(e->qq, 30 - n_max);
+	} else {
+		a = b43_ac_sqrt_int(b43_ac_asr(e->ii, n_max - 30));
+		r0 = b43_ac_asr(e->qq, n_max - 30);
+	}
+	r0 = (s32)((u32)a * b43_ac_sqrt_int(r0));		/* 0x1e118 */
+	if (n_max > n_iq + 16)					/* 0x1e11c */
+		r1 = b43_ac_lsl(r0, n_max - n_iq - 16);
+	else
+		r1 = b43_ac_asr(r0, n_iq + 16 - n_max);
+	num = b43_ac_lsl((s32)(0u - (u32)e->iq), 30 - n_iq);	/* 0x1e140 */
+	num = num > 0 ? num + (r1 >> 1) : num - (r1 >> 1);
+	sinv = b43_ac_idiv(num, r1);				/* 0x1e15c */
+	cosv = (s32)(b43_ac_sqrt_int((u32)(0x40000000 -
+				(sinv >> 1) * (sinv >> 1))) << 1); /* 0x1e174 */
+	*angle = b43_ac_inv_cordic(sinv, cosv);			/* 0x1e194 */
+
+	d = e->qq - e->ii;					/* 0x1e168 */
+	n = b43_ac_nbits(d);
+	if (n & 1)
+		n++;
+	r1 = n > 10 ? b43_ac_asr(e->ii, n - 10) : b43_ac_lsl(e->ii, 10 - n);
+	d = b43_ac_lsl(d, 30 - n);
+	d = d > 0 ? d + (r1 >> 1) : d - (r1 >> 1);
+	*mag = r1 ? (s32)b43_ac_sqrt_int(b43_ac_idiv(d, r1) + 0x100000) : 1024;
+}
+
+/*
+ * wlc_phy_rx_iq_est_acphy(pi, est, nsamps, wait_time, wait_crs, per_core)
+ * @0x328ec. per_core is the last argument and pi_ac[0x9ab] (2 GHz) or
+ * [0x9ac] (5 GHz); wlc_phy_attach_acphy sets 0x9ac to 1 (0x45ddc), so a
+ * 5 GHz call with per_core 1 measures one core at a time with the other
+ * cores' 0x720/0x728 bit 0, 0x721 bit 2 and 0x729 bit 1 overridden
+ * (0x32aa4..0x32cb0). Each wait is 1001 reads of PHY 0x270 with 1000 x 10 us
+ * between them (0x3297c, 0x32cc8); wl then skips the results, this port also
+ * returns -ETIMEDOUT.
+ */
+static bool b43_ac_rx_iq_est_wait(struct b43_wldev *dev)
+{
+	unsigned int i;
+
+	for (i = 0; i < 1000; i++) {
+		if (!(b43_phy_read(dev, 0x270) & 0x1))
+			return true;
+		udelay(10);
+	}
+	return !(b43_phy_read(dev, 0x270) & 0x1);
+}
+
+static void b43_ac_rx_iq_est_read(struct b43_wldev *dev,
+				  struct b43_ac_iq_est *e, u8 c)
+{
+	u16 r = 0x6c0 + (c << 9);
+
+	e->ii = (s32)((u32)b43_phy_read(dev, r + 3) << 16 |
+		      b43_phy_read(dev, r + 2));		/* 0x329f8..0x32a1c */
+	e->qq = (s32)((u32)b43_phy_read(dev, r + 5) << 16 |
+		      b43_phy_read(dev, r + 4));		/* 0x32a24..0x32a48 */
+	e->iq = (s32)((u32)b43_phy_read(dev, r + 1) << 16 |
+		      b43_phy_read(dev, r));			/* 0x32a50..0x32a68 */
+}
+
+static int b43_ac_rx_iq_est(struct b43_wldev *dev, struct b43_ac_iq_est *est,
+			    u16 nsamps, u8 wait_time, bool wait_crs,
+			    bool per_core)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 sv[3 * 4][2];
+	int err = 0, i, n;
+	u8 c, k;
+	u16 b;
+
+	b43_ac_pulse_adc_reset(dev);				/* 0x32920 */
+	b43_phy_write(dev, 0x272, nsamps);			/* 0x32930 */
+	b43_ac_phy_mod(dev, 0x271, 0xff, wait_time);		/* 0x32944 */
+	b43_ac_phy_mod(dev, 0x270, 0x2, wait_crs ? 0x2 : 0);	/* 0x32958 */
+	if (!per_core) {
+		b43_ac_phy_mod(dev, 0x270, 0x1, 0x1);		/* 0x32978 */
+		if (!b43_ac_rx_iq_est_wait(dev)) {		/* 0x329b4 */
+			b43err(dev->wl, "radio 0x2069: RX IQ estimator still busy after 10 ms (PHY 0x270 = 0x%04x)\n",
+			       b43_phy_read(dev, 0x270));
+			return -ETIMEDOUT;
+		}
+		for (c = 0; c < phy_ac->ncores; c++)		/* 0x329c4..0x32a7c */
+			if (phy_ac->coremask & BIT(c))
+				b43_ac_rx_iq_est_read(dev, &est[c], c);
+		return 0;
+	}
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x32a84..0x32e04 */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		n = 0;
+		for (k = 0; k < phy_ac->ncores; k++) {		/* 0x32aa4..0x32cc0 */
+			if (!(phy_ac->coremask & BIT(k)) || k == c)
+				continue;
+			b = k << 9;
+			sv[n][0] = 0x720 + b;
+			sv[n++][1] = b43_phy_read(dev, 0x720 + b);
+			sv[n][0] = 0x728 + b;
+			sv[n++][1] = b43_phy_read(dev, 0x728 + b);
+			sv[n][0] = 0x721 + b;
+			sv[n++][1] = b43_phy_read(dev, 0x721 + b);
+			sv[n][0] = 0x729 + b;
+			sv[n++][1] = b43_phy_read(dev, 0x729 + b);
+			b43_ac_phy_mod(dev, 0x720 + b, 0x1, 0x1);	/* 0x32bb4 */
+			b43_ac_phy_mod(dev, 0x728 + b, 0x1, 0);		/* 0x32bfc */
+			b43_ac_phy_mod(dev, 0x721 + b, 0x4, 0x4);	/* 0x32c54 */
+			b43_ac_phy_mod(dev, 0x729 + b, 0x2, 0);		/* 0x32cac */
+		}
+		udelay(1);					/* 0x32ccc */
+		b43_ac_phy_mod(dev, 0x270, 0x1, 0x1);		/* 0x32ce0 */
+		b43_ac_rx_iq_est_wait(dev);			/* 0x32cf4..0x32d24 */
+		for (i = n - 1; i >= 0; i--)			/* 0x32d28..0x32d44 */
+			b43_phy_write(dev, sv[i][0], sv[i][1]);
+		if (b43_phy_read(dev, 0x270) & 0x1) {		/* 0x32d48 */
+			b43err(dev->wl, "radio 0x2069: RX IQ estimator (core %u) still busy after 10 ms, no result\n",
+			       c);
+			err = -ETIMEDOUT;
+			continue;
+		}
+		b43_ac_rx_iq_est_read(dev, &est[c], c);		/* 0x32d5c..0x32df0 */
+	}
+	return err;
+}
