+/**************************************************
+ * Radio 0x2069 radio-on, from wl.ko wlc_phy_switch_radio_acphy @0x4d940
+ **************************************************/
+
+/*
+ * Conventions for this section (the same as the decode notes):
+ * - b43_ac2069_mod(reg, mask, val) is wl's mod_radio_reg @0x53688, which
+ *   REPLACES the bits in mask (bic/and/orr at 0x536a0..0x536a8). In b43 that
+ *   is b43_radio_maskset(dev, reg, ~mask, val & mask), because
+ *   b43_radio_maskset KEEPS the bits in its mask.
+ * - b43_radio_write is wl's write_radio_reg @0x50930 (full write).
+ * - b43_phy_read/b43_phy_write are phy_reg_read @0x50a1c and phy_reg_write
+ *   @0x50a74: PHY registers, not radio.
+ * - osl_delay(n) is n microseconds, so udelay(n).
+ * - Register numbers are the ones wl picks for chip 0x4360 (0x4352 and
+ *   0xa9c4 = 43460 take the same). b43_ac2069_check() refuses other chips.
+ * - Per-core radio registers add core << 9.
+ * - wl's polls time out silently. Every poll here is bounded the way wl's
+ *   is and logs a b43warn on timeout, then carries on as wl does.
+ */
+#define B43_RADIO_ID_2069		0x2069
+
+/* wl's xtal compares in the RC cal, literals 0x4ea24 and 0x4ea28, in Hz */
+#define B43_AC2069_XTAL_40M		40000000
+#define B43_AC2069_XTAL_37M4		37400000
+
+struct b43_ac2069 {
+	u8 rev;			/* wl pi+200, low byte of radio control 0 read */
+	u8 major;		/* wl pi+202, rev >> 4 (wlc_phy_attach 0x69894) */
+	u8 ncores;		/* wl pi+196 */
+	u32 xtal;		/* wl pi+0x4874, si_alp_clock() (0x45de8), Hz */
+	u16 s728;		/* PHY 0x728 saved at 0x4dc54 ([sp,#4]) */
+	u16 s408;		/* PHY 0x408 & 0xfc38 saved at 0x4dc70 (r5) */
+	unsigned int timeouts;	/* polls that ran out */
+};
+
+static void b43_ac2069_mod(struct b43_wldev *dev, u16 reg, u16 mask, u16 val)
+{
+	b43_radio_maskset(dev, reg, ~mask, val & mask);
+}
