+
+static const u16 b43_ac2069_prefregs_rev18[] = {
+	0x002f, 0x0077, 0x0041, 0x0000, 0x0044, 0x000f, 0x004c, 0x3000,
+	0x004d, 0x0303, 0x004e, 0x36e2, 0x0050, 0x6000, 0x0051, 0x0003,
+	0x0067, 0x1277, 0x006c, 0xff02, 0x006d, 0x0712, 0x0076, 0xff08,
+	0x0077, 0x6800, 0x0079, 0x0101, 0x007a, 0x4646, 0x012e, 0x1000,
+	0x0135, 0x03e0, 0x0138, 0x0100, 0x0139, 0x0002, 0x0173, 0x0020,
+	0x080c, 0x00be, 0x08f1, 0x020b, 0x08f2, 0x033f, 0x08f4, 0x36bc,
+	0x08f5, 0x1524, 0x08f7, 0x0040, 0x0927, 0x3332, 0x0928, 0x3304,
+	0x097f, 0xd804, 0x0980, 0x0800, 0x0986, 0x0000, 0x098a, 0x0003,
+	0x098c, 0x6900, 0x0991, 0x0001,
+};	/* 34 pairs */
+
+/*
+ * pwron-2069.md step 2a, major rev 1 (rev 18) only, 0x4d988..0x4dba0.
+ * Step 2a.1, wlc_phy_set_lowpwr_phy_reg @0x18380, is not ported: on PHY rev
+ * 0/1 all 82 of its writes target PHY 0xffff with mask 0
+ * (lowpwr-and-flags-2069.md item 21).
+ */
+static void b43_ac2069_preamble_major1(struct b43_wldev *dev,
+				       struct b43_ac2069 *c)
+{
+	unsigned int n;
+
+	b43_ac2069_mod(dev, 0x80c, 0x0080, 0x0080);	/* 0x4d99c */
+	b43_ac2069_mod(dev, 0x80c, 0x0010, 0x0010);	/* 0x4d9b0 */
+	b43_ac2069_mod(dev, 0x80c, 0x0008, 0x0008);	/* 0x4d9c4 */
+	b43_ac2069_mod(dev, 0x80c, 0x0004, 0x0004);	/* 0x4d9d8 */
+	b43_ac2069_mod(dev, 0x80c, 0x0002, 0x0002);	/* 0x4d9ec */
+	udelay(100);					/* 0x4d9f4 */
+	/* value is r5, the radio-on flag byte, 0 on this path (0x4da00) */
+	b43_ac2069_mod(dev, 0x97f, 0x0010, 0);		/* 0x4da08 */
+	b43_ac2069_mod(dev, 0x8ea, 0x0001, 0x0001);	/* 0x4da5c */
+	b43_ac2069_mod(dev, 0x8ea, 0x0100, 0x0100);	/* 0x4dab0 */
+	b43_ac2069_mod(dev, 0x8ea, 0x0010, 0x0010);	/* 0x4db08 */
+	b43_ac2069_mod(dev, 0x80c, 0x0020, 0x0020);	/* 0x4db1c */
+	b43_ac2069_mod(dev, 0x80c, 0x2000, 0x2000);	/* 0x4db30 */
+	b43_ac2069_mod(dev, 0x80c, 0x4000, 0x4000);	/* 0x4db44 */
+
+	/*
+	 * 0x4db48..0x4db74: read radio 0x80b until bit 0 is set; each miss
+	 * delays 100 us; the u8 counter stops it at 101 misses.
+	 */
+	for (n = 0; !(b43_radio_read(dev, 0x80b) & 0x0001); ) {
+		udelay(100);
+		if (++n == 101) {
+			b43warn(dev->wl,
+				"radio 0x2069: 0x80b bit 0 not set after 101 polls\n");
+			c->timeouts++;
+			break;
+		}
+	}
+
+	b43_ac2069_mod(dev, 0x80c, 0x4000, 0);		/* 0x4db88 */
+	b43_ac2069_mod(dev, 0x80c, 0x2000, 0);		/* 0x4db9c */
+}
+
+/*
+ * pwron-2069.md steps 3 to 9, 0x4dc4c..0x4e5fc, then the branch to 0x4e618.
+ * Major rev 0 has no preamble, so step 3 is the first thing that runs and
+ * the prefregs table is the first radio access.
+ */
+static void b43_ac2069_pwron(struct b43_wldev *dev, struct b43_ac2069 *c)
+{
+	const struct ssb_sprom *sprom = dev->dev->bus_sprom;
+	const u16 *pref;
+	size_t npref;
+	u8 core;
+
+	/* step 2a, major rev 1 only (0x4d97c..0x4d984) */
+	if (c->major == 1)
+		b43_ac2069_preamble_major1(dev, c);
+
+	/* step 3, PHY reset pulse, 0x4dc4c..0x4dd3c */
+	c->s728 = b43_phy_read(dev, 0x728);			/* 0x4dc54 */
+	c->s408 = b43_phy_read(dev, 0x408) & 0xfc38;		/* 0x4dc70 */
+	b43_phy_write(dev, 0x415, 0);				/* 0x4dc7c */
+	b43_phy_write(dev, 0x40e, 0);				/* 0x4dc8c */
+	b43_phy_write(dev, 0x40c, 0x2000);			/* 0x4dc9c */
+	b43_phy_write(dev, 0x408, c->s408);			/* 0x4dcac */
+	b43_phy_write(dev, 0x417, 0);				/* 0x4dcbc */
+	b43_phy_write(dev, 0x416, 0x000d);			/* 0x4dccc */
+	b43_phy_write(dev, 0x728, c->s728 & 0x7e7f);		/* 0x4dce4 */
+	b43_phy_write(dev, 0x720,
+		      b43_phy_read(dev, 0x720) | 0x0180);	/* 0x4dd04 */
+	b43_phy_write(dev, 0x408, c->s408);			/* 0x4dd14 */
+	b43_phy_write(dev, 0x408, c->s408 | 1);			/* 0x4dd24 */
+	udelay(1);						/* 0x4dd2c */
+	b43_phy_write(dev, 0x408, c->s408);			/* 0x4dd3c */
+
+	/*
+	 * step 4, prefregs: jump table on rev - 3 at 0x4dd40..0x4dd54, rev 3
+	 * case 0x4dde4, rev 4 case 0x4de2c, rev 18 case 0x4ddfc, writer call
+	 * at 0x4de34. b43_ac2069_check() admits only these three revs, so the
+	 * no-table branch to 0x4e4bc (which skips steps 5..8) is not taken.
+	 */
+	switch (c->rev) {
+	case 3:
+		pref = b43_ac2069_prefregs_rev3;
+		npref = ARRAY_SIZE(b43_ac2069_prefregs_rev3);
+		break;
+	case 4:
+		pref = b43_ac2069_prefregs_rev4;
+		npref = ARRAY_SIZE(b43_ac2069_prefregs_rev4);
+		break;
+	default:	/* 18 */
+		pref = b43_ac2069_prefregs_rev18;
+		npref = ARRAY_SIZE(b43_ac2069_prefregs_rev18);
+		break;
+	}
+	b43_phy_ac_prefregs(dev, pref, npref);
+
+	/*
+	 * step 5, 0x4de38..0x4de98: boardflags bit 1 (sh+0x50, filled from
+	 * NVRAM "boardflags", lowpwr-and-flags-2069.md item 22). The R6400 has
+	 * boardflags 0x30000000 (board-settings.md), so this is skipped there.
+	 */
+	if (sprom->boardflags_lo & 0x0002)
+		b43_ac2069_mod(dev, 0x8ea, 0x0100, 0x0100);	/* 0x4de98 */
+
+	/* step 6, major-specific block, 0x4de9c..0x4e208 */
+	if (c->major == 0) {
+		b43_ac2069_mod(dev, 0x96b, 0x0800, 0x0800);	/* 0x4def8 */
+		b43_ac2069_mod(dev, 0x96b, 0x4000, 0x4000);	/* 0x4df4c */
+		b43_ac2069_mod(dev, 0x96c, 0x0800, 0x0800);	/* 0x4dfa0 */
+		b43_ac2069_mod(dev, 0x96b, 0x8000, 0x8000);	/* 0x4dff4 */
+		b43_ac2069_mod(dev, 0x96b, 0x1000, 0x1000);	/* 0x4e048 */
+		b43_ac2069_mod(dev, 0x96b, 0x0004, 0x0004);	/* 0x4e208 */
+	} else {
+		/* major 1, no chip switch, 0x4e0a4..0x4e118 */
+		b43_ac2069_mod(dev, 0x97f, 0x4000, 0x4000);	/* 0x4e0b4 */
+		b43_ac2069_mod(dev, 0x980, 0x0800, 0x0800);	/* 0x4e0c8 */
+		b43_ac2069_mod(dev, 0x97f, 0x0800, 0x0800);	/* 0x4e0dc */
+		b43_ac2069_mod(dev, 0x97f, 0x8000, 0x8000);	/* 0x4e0f0 */
+		b43_ac2069_mod(dev, 0x97f, 0x1000, 0x1000);	/* 0x4e104 */
+		b43_ac2069_mod(dev, 0x97f, 0x0004, 0x0004);	/* 0x4e118 */
+		/* 0x4e11c: mod(0x970, 0x10, 0x10) is major 2 only */
+		b43_radio_write(dev, 0x792, 0x0001);		/* 0x4e148 */
+		b43_ac2069_mod(dev, 0x992, 0x0001, 0x0001);	/* 0x4e15c */
+		/* 0x4e160: the si_pmu_chipcontrol block is major 2 only */
+	}
+
+	/* step 7, major <= 1, 0x4e20c..0x4e2d8 */
+	b43_ac2069_mod(dev, 0x407, 0x0002, 0x0002);		/* 0x4e268 */
+	b43_ac2069_mod(dev, 0x400 | 0x15e, 0x0010, 0x0010);	/* 0x4e2d8 */
+
+	/* step 8, per core, 0x4e2dc..0x4e4b4 */
+	for (core = 0; core < c->ncores; core++) {
+		u16 b = core << 9;
+
+		b43_ac2069_mod(dev, b | 0x126, 0x0300, 0x0100);	/* 0x4e34c */
+		b43_ac2069_mod(dev, b | 0x127, 0x0003, 0x0002);	/* 0x4e394 */
+		b43_ac2069_mod(dev, b | 0x06f, 0x0004, 0);	/* 0x4e3d4 */
+		b43_ac2069_mod(dev, b | 0x06f, 0x0001, 0);	/* 0x4e414 */
+		b43_ac2069_mod(dev, b | 0x06f, 0x0002, 0);	/* 0x4e454 */
+		b43_ac2069_mod(dev, b | 0x065, 0x0001, 0);	/* 0x4e494 */
+	}
+
+	/* step 9, release, 0x4e4bc..0x4e5fc */
+	b43_ac2069_mod(dev, 0x40c, 0x0010, 0);			/* 0x4e518 */
+	b43_phy_write(dev, 0x408, c->s408 | 6);			/* 0x4e528 */
+	udelay(100);						/* 0x4e530 */
+	b43_ac2069_mod(dev, 0x40c, 0x0010, 0x0010);		/* 0x4e590 */
+	b43_phy_write(dev, 0x417, 0x000d);			/* 0x4e5a0 */
+	b43_phy_write(dev, 0x408, c->s408 | 2);			/* 0x4e5b0 */
+	b43_phy_write(dev, 0x728, c->s728 | 0x0180);		/* 0x4e5c8 */
+	udelay(100);						/* 0x4e5d0 */
+	b43_phy_write(dev, 0x417, 0x0004);			/* 0x4e5e0 */
+	b43_phy_write(dev, 0x728, c->s728 & 0xfeff);		/* 0x4e5f8 */
+}
+
+/*
+ * R cal, rcal-2069.md "R cal", inline in wlc_phy_switch_radio_acphy:
+ * override check 0x4e618..0x4e658, hardware R cal 0x4e65c..0x4eef8, override
+ * apply 0x4ef00..0x4efe0. Nothing is stored; the result latches in the
+ * radio. boardflags3 bit 13 (pi_ac[0x391]) is refused by b43_ac2069_check()
+ * because its value comes from sh+0xf2, whose source is not traced.
+ */
+static void b43_ac2069_rcal(struct b43_wldev *dev, struct b43_ac2069 *c)
+{
+	const struct ssb_sprom *sprom = dev->dev->bus_sprom;
+	unsigned int n;
+
+	/*
+	 * pi_ac[0x387] = boardflags3 bit 3 (0x46000): fixed value, 10 for
+	 * major 1, 0 for major 0 (0x4e630..0x4e658); applied at 0x4ef9c..0x4efe0
+	 * on major 1 only. Major 0 writes nothing. 0 on the R6400.
+	 */
+	if (sprom->boardflags3 & BIT(3)) {
+		if (c->major == 1) {
+			b43_ac2069_mod(dev, 0x807, 0x00f0, 10 << 4);
+			b43_ac2069_mod(dev, 0x971, 0x0004, 0x0004);
+			b43_ac2069_mod(dev, 0x971, 0x0002, 0);
+		}
+		return;
+	}
+
+	/* hardware R cal, majors 0 and 1 */
+	b43_ac2069_mod(dev, 0x8ea, 0x0040, 0x0040);		/* 0x4e6bc */
+	b43_ac2069_mod(dev, 0x8ea, 0x0080, 0x0080);		/* 0x4e710 */
+	b43_ac2069_mod(dev, 0x8ed, 0x0600, 0);			/* 0x4e764 */
+	b43_ac2069_mod(dev, 0x8ed, 0x1800, 0);			/* 0x4e7b8 */
+	b43_ac2069_mod(dev, 0x400 | 0x148, 0x0001, 0x0001);	/* 0x4e8dc */
+	b43_radio_write(dev, 0x400 | 0x149, 0);			/* 0x4e938 */
+	b43_radio_write(dev, 0x400 | 0x14a, 0);			/* 0x4e998 */
+	b43_radio_write(dev, 0x400 | 0x14b, 0);			/* 0x4ea44 */
+	b43_radio_write(dev, 0x400 | 0x14c, 0);			/* 0x4eaa0 */
+	b43_ac2069_mod(dev, 0x40b, 0x0001, 0);			/* 0x4eb38 */
+	udelay(1);						/* 0x4eb40 */
+	b43_ac2069_mod(dev, 0x40b, 0x0001, 0x0001);		/* 0x4ebf4 */
+
+	/* 0x4ebf8..0x4ec7c: delay 10 us, read 0x40b, done on bit 3; 100 reads */
+	for (n = 0; n < 100; n++) {
+		udelay(10);
+		if (b43_radio_read(dev, 0x40b) & 0x0008)
+			break;
+	}
+	if (n == 100) {
+		b43warn(dev->wl, "radio 0x2069: R cal 0x40b bit 3 not set after 100 polls\n");
+		c->timeouts++;
+	}
+	/* 0x4ed0c: read once more; the value is not used on this path */
+	b43_radio_read(dev, 0x40b);
+
+	b43_ac2069_mod(dev, 0x400 | 0x148, 0x0001, 0);		/* 0x4edb8 */
+	b43_ac2069_mod(dev, 0x8ea, 0x0040, 0);			/* 0x4ee0c */
+	b43_ac2069_mod(dev, 0x8ea, 0x0080, 0);			/* 0x4ee60 */
+	b43_ac2069_mod(dev, 0x40b, 0x0001, 0);			/* 0x4eef8 */
+}
+
+/*
+ * RC cal, rcal-2069.md "RC cal", 0x4f000..0x4f990.
+ * sel {1, 0, 0}: immediate stores at 0x4f000..0x4f010.
+ * idx {0, 2, 1}: C.3911, .rodata 0x5ae74 (literal 0x4ea18).
+ * b8 {0x1c, 0x70, 0x40}: C.3912, .rodata 0x5ae78 (literal 0x4ea1c, -0x510).
+ * w16 {0x14a, 0x101, 0x11a}: C.3913, .rodata 0x5ae7c (literal 0x4ea20).
+ * scale: 0xc1 for major 0 (0x4f058); for major 1 0x9e with w16 {0x22d, 0xf0,
+ * 0x10a} on a 37.4 MHz xtal (0x4f0ec..0x4f104), else 0xa0 (0x4f10c). The
+ * rev 25/26 rows (0x4f078..0x4f0e8) are not reachable: only 3, 4, 18 pass
+ * b43_ac2069_check().
+ * Results go where wl keeps them: pass 0 to pi_ac+0x372 and +0x374
+ * (rc_result[0], [1]); pass 1 straight into per-core radio registers; pass 2
+ * to pi_ac+0x376 (rc_dacbuf).
+ */
+static void b43_ac2069_rccal(struct b43_wldev *dev, struct b43_ac2069 *c)
+{
+	static const u8 sel[3] = { 1, 0, 0 };
+	static const u8 idx[3] = { 0, 2, 1 };
+	static const u8 b8[3] = { 0x1c, 0x70, 0x40 };
+	u16 w16[3] = { 0x14a, 0x101, 0x11a };
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	/* i == 2 per-core bit: 0x171 on major 0 (4360 group), 0x185 otherwise */
+	u16 bitreg = c->major ? 0x185 : 0x171;
+	u32 scale;
+	unsigned int i, n;
+	u8 core;
+
+	if (c->major == 0) {
+		scale = 0xc1;
+	} else if (c->xtal == B43_AC2069_XTAL_37M4) {
+		scale = 0x9e;
+		w16[0] = 0x22d;
+		w16[1] = 0x0f0;
+		w16[2] = 0x10a;
+	} else {
+		scale = 0xa0;
+	}
+
+	b43_ac2069_mod(dev, 0x8ea, 0x0080, 0x0080);		/* 0x4f160 */
+	b43_ac2069_mod(dev, 0x8ed, 0x0600, 0x0400);		/* 0x4f1c8 */
+
+	for (i = 0; i < 3; i++) {				/* 0x4f1d4..0x4f93c */
+		b43_ac2069_mod(dev, 0x410, 0x1000, sel[i] << 12); /* 0x4f230 */
+		b43_ac2069_mod(dev, 0x410, 0x0018, idx[i] << 3); /* 0x4f28c */
+		b43_ac2069_mod(dev, 0x411, 0xff00, b8[i] << 8);	/* 0x4f2e8 */
+		b43_radio_write(dev, 0x412, w16[i]);		/* 0x4f340 */
+
+		if (i == 2) {					/* 0x4f360..0x4f42c */
+			for (core = 0; core < c->ncores; core++) {
+				u16 b = core << 9;
+
+				b43_ac2069_mod(dev, b | 0x11d, 0x0004, 0);
+				b43_ac2069_mod(dev, b | bitreg, 0x2000, 0x2000);
+			}
+		}
+
+		b43_ac2069_mod(dev, 0x410, 0x0001, 0);		/* 0x4f484 */
+		udelay(1);					/* 0x4f48c */
+		b43_ac2069_mod(dev, 0x410, 0x0001, 0x0001);	/* 0x4f4e0 */
+		udelay(35);					/* 0x4f4e8 */
+		b43_ac2069_mod(dev, 0x411, 0x0001, 0x0001);	/* 0x4f544 */
+
+		/* 0x4f550..0x4f5c0: delay 100 us, read 0x413, bit 4; 100 reads */
+		for (n = 0; n < 100; n++) {
+			udelay(100);
+			if (b43_radio_read(dev, 0x413) & 0x0010)
+				break;
+		}
+		if (n == 100) {
+			b43warn(dev->wl,
+				"radio 0x2069: RC cal pass %u, 0x413 bit 4 not set after 100 polls\n",
+				i);
+			c->timeouts++;
+		}
+
+		b43_ac2069_mod(dev, 0x411, 0x0001, 0);		/* 0x4f618 */
+
+		if (i == 0) {
+			/*
+			 * 0x4f670..0x4f6e0: read 0x414, then 0x415; rsb, mul by
+			 * scale, ubfx #8, #8. 32-bit arithmetic as in wl.
+			 */
+			u32 lo = b43_radio_read(dev, 0x414);
+			u32 hi = b43_radio_read(dev, 0x415);
+			u16 rc = (((hi - lo) * scale) >> 8) & 0xff;
+
+			phy_ac->rc_result[0] = rc;	/* pi_ac+0x372 */
+			phy_ac->rc_result[1] = rc;	/* pi_ac+0x374 */
+		} else if (i == 1) {
+			/* 0x4f73c..0x4f7f0: 5-bit result into two per-core regs */
+			u16 g = b43_radio_read(dev, 0x416) & 0x1f;
+
+			for (core = 0; core < c->ncores; core++) {
+				u16 b = core << 9;
+
+				b43_ac2069_mod(dev, b | 0x126, 0x001f, g);
+				b43_ac2069_mod(dev, b | 0x043, 0x001f, g);
+			}
+		} else {
+			/* 0x4f84c..0x4f860, then clear the step-5 bit per core */
+			phy_ac->rc_dacbuf =
+				(b43_radio_read(dev, 0x416) >> 5) & 0x1f;
+			for (core = 0; core < c->ncores; core++)
+				b43_ac2069_mod(dev, (core << 9) | bitreg,
+					       0x2000, 0);
+		}
+
+		b43_ac2069_mod(dev, 0x410, 0x0001, 0);		/* 0x4f934 */
+	}
+
+	b43_ac2069_mod(dev, 0x8ea, 0x0080, 0);			/* 0x4f990 */
+	phy_ac->rccal_done = true;
+}
+
+/*
+ * wlc_phy_radio2069_vcocal @0x19ddc, vcocal-2069.md. Same for revs 3, 4
+ * and 18; chip 0x4360 registers.
+ */
+static void b43_ac2069_vcocal(struct b43_wldev *dev)
+{
+	b43_ac2069_mod(dev, 0x8e5, 0x4000, 0);			/* 0x19e34 */
+	b43_ac2069_mod(dev, 0x8d0, 0x0001, 0);			/* 0x19e88 */
+	b43_ac2069_mod(dev, 0x8e8, 0x0040, 0);			/* 0x19edc */
+	b43_ac2069_mod(dev, 0x8dc, 0x2000, 0);			/* 0x19f30 */
+	udelay(11);						/* 0x19f38 */
+	b43_ac2069_mod(dev, 0x8d0, 0x0001, 0x0001);		/* 0x19f8c */
+	b43_ac2069_mod(dev, 0x8e8, 0x0040, 0x0040);		/* 0x19fe0 */
+	udelay(1);						/* 0x19fe8 */
+	b43_ac2069_mod(dev, 0x8dc, 0x2000, 0x2000);		/* 0x1a040 */
+}
+
+/*
+ * wlc_phy_radio2069x_vcocal_isdone @0x1bd64, vcocal-2069.md: up to 100 x
+ * (10 us, read radio 0x90b, done on bit 8), then 120 us if settle is set.
+ * Returns true when bit 8 was seen.
+ */
+static bool b43_ac2069_vcocal_isdone(struct b43_wldev *dev,
+				     struct b43_ac2069 *c, bool settle)
+{
+	unsigned int n;
+	bool done = false;
+
+	for (n = 0; n < 100; n++) {
+		udelay(10);					/* 0x1bd90 */
+		if (b43_radio_read(dev, 0x90b) & 0x0100) {	/* 0x1bde0 */
+			done = true;
+			break;
+		}
+	}
+	if (!done) {
+		b43warn(dev->wl, "radio 0x2069: VCO cal 0x90b bit 8 not set after 100 polls\n");
+		c->timeouts++;
+	}
+	if (settle)
+		udelay(120);					/* 0x1be0c */
+	return done;
+}
+
+/*
+ * Gate for the 0x2069 path. Logs and returns -ENODEV for anything the
+ * decodes do not cover. Reads no radio register; the PHY register read for
+ * the core count happens only after the HT clock check.
+ */
+static int b43_ac2069_check(struct b43_wldev *dev, struct b43_ac2069 *c)
+{
+	struct b43_phy *phy = &dev->phy;
+	const struct ssb_sprom *sprom = dev->dev->bus_sprom;
+	struct bcma_device *core;
+	u32 clkst;
+
+	if (phy->rev != 1) {
+		b43err(dev->wl, "radio 0x2069: AC-PHY rev %u, decoded for rev 1 only\n",
+		       phy->rev);
+		return -ENODEV;
+	}
+	if (dev->dev->bus_type != B43_BUS_BCMA) {
+		b43err(dev->wl, "radio 0x2069: not on bcma, refusing\n");
+		return -ENODEV;
+	}
+	core = dev->dev->bdev;
+
+	/* wl's acphychipid switch: 0x4360, 0x4352, 0xa9c4 share registers */
+	switch (dev->dev->chip_id) {
+	case BCMA_CHIP_ID_BCM4360:
+	case BCMA_CHIP_ID_BCM4352:
+	case BCMA_CHIP_ID_BCM43460:
+		break;
+	default:
+		b43err(dev->wl, "radio 0x2069: chip 0x%04x, decoded for 0x4360 only\n",
+		       dev->dev->chip_id);
+		return -ENODEV;
+	}
+
+	c->rev = phy->radio_rev;
+	c->major = c->rev >> 4;
+	if (!((c->major == 0 && (c->rev == 3 || c->rev == 4)) ||
+	      (c->major == 1 && c->rev == 18))) {
+		b43err(dev->wl, "radio 0x2069 rev %u (major %u): ported for revs 3, 4 and 18 only\n",
+		       c->rev, c->major);
+		return -ENODEV;
+	}
+
+	if (sprom->boardflags3 & BIT(13)) {
+		/* pi_ac[0x391]: R cal value from sh+0xf2, source not traced */
+		b43err(dev->wl, "radio 0x2069: boardflags3 bit 13 (OTP R cal value) not ported\n");
+		return -ENODEV;
+	}
+
+	/*
+	 * Same check as patch 991 makes before b43_phy_versioning reads the
+	 * radio: no radio access without the core's HT clock.
+	 */
+	clkst = bcma_read32(core, BCMA_CLKCTLST);
+	if (!(clkst & BCMA_CLKCTLST_HAVEHT)) {
+		b43err(dev->wl, "radio 0x2069: no HT clock (CLKCTLST 0x%08x), not touching the radio\n",
+		       clkst);
+		return -ENODEV;
+	}
+
+	/* wl pi+196 = PHY reg 0x00b & 7 (wlc_phy_attach_acphy 0x45dfc..0x45e08) */
+	c->ncores = b43_phy_read(dev, 0x00b) & 7;
+	if (c->ncores < 1 || c->ncores > 3) {
+		b43err(dev->wl, "radio 0x2069: PHY reg 0x00b gives %u cores, expected 1..3\n",
+		       c->ncores);
+		return -ENODEV;
+	}
+
+	/*
+	 * wl pi+0x4874 is si_alp_clock() (0x45de8). bcma reports 40 MHz or
+	 * 20 MHz for a 4360 from ChipCommon chip status, never 37.4 MHz; only
+	 * the rev 18 RC cal scale depends on it (37.4 MHz or not).
+	 */
+	c->xtal = bcma_chipco_get_alp_clock(&core->bus->drv_cc);
+	return 0;
+}
+
+/*
+ * NVRAM pci/2/1/rxgainerr5ga0..2, four values each (one per 5 GHz group),
+ * rxgainerr-rev1.md. sromrev 11 keeps them in the array form that
+ * bcm47xx_sprom does not read, so they come in as a parameter, ga0 first:
+ * on the R6400 rxgainerr5ga0=0,-1,2,0 rxgainerr5ga1=-6,-6,-4,-1
+ * rxgainerr5ga2=-4,-1,-6,-6. They only correct reported RSSI, so the
+ * channel set does not refuse without them; it takes 0 for each value, as
+ * wl does for a missing key (rxgainerr-rev1.md, "Missing keys").
+ */
+static int acphy_rxgainerr5g[12];
+static int acphy_rxgainerr5g_n;
+module_param_array_named(acphy_rxgainerr5g, acphy_rxgainerr5g, int, &acphy_rxgainerr5g_n, 0444);
+MODULE_PARM_DESC(acphy_rxgainerr5g,
+	"NVRAM rxgainerr5ga0,rxgainerr5ga1,rxgainerr5ga2 of the 5 GHz radio, four values each, ga0 first (R6400: 0,-1,2,0,-6,-6,-4,-1,-4,-1,-6,-6); without them the RX gain error (an RSSI correction) is 0");
+
+/*
+ * The RX gain error groups pi+0x136..0x14e as wlc_phy_attach @0x68b24
+ * (flags cleared, 0x692c0..0x692d8) and wlc_phy_attach_acphy @0x45aec
+ * (0x468d0..0x46e50) fill them, rxgainerr-rev1.md: per group, core 0 is a
+ * signed 6-bit value (sbfx #0, #6), cores 1 and 2 signed 5-bit deltas from
+ * it (sbfx #0, #5), stored absolute (u8 adds); a group whose read cores are
+ * all -1 becomes 0 with its flag (fifth byte) set. Core slots past the core
+ * count are not read and keep the previous group's value, starting at -1
+ * (memset 0xff, 0x468d0..0x468dc). The 2 GHz keys rxgainerr2ga0..2 are not
+ * supplied: a missing key reads 0 (phy_getintvar_default @0x533d4), and b43
+ * sets no 2 GHz channel (b43_ac2069_chan_check()). No hardware access; it
+ * needs the core count, so it runs at radio-on.
+ */
+static void b43_ac2069_rxgainerr_attach(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	bool given = acphy_rxgainerr5g_n == ARRAY_SIZE(acphy_rxgainerr5g);
+	s8 v[3] = { -1, -1, -1 };				/* 0x468d0..0x468dc */
+	u8 grp, flag, *g;
+
+	if (!given)
+		b43warn(dev->wl, "radio 0x2069: acphy_rxgainerr5g not given (%d of 12 values), RX gain error 0 on every 5 GHz group (R6400: 0,-1,2,0,-6,-6,-4,-1,-4,-1,-6,-6)\n",
+			acphy_rxgainerr5g_n);
+	memset(a->rxgainerr, 0, sizeof(a->rxgainerr));		/* 0x692c4..0x692d8 */
+	/* grp 0: 2 GHz (0x46924..0x469e8); 1..4: element grp - 1 (0x469f0..0x46e50) */
+	for (grp = 0; grp < 5; grp++) {
+		int r0 = 0, r1 = 0, r2 = 0;
+
+		if (grp && given) {
+			r0 = acphy_rxgainerr5g[grp - 1];
+			r1 = acphy_rxgainerr5g[4 + grp - 1];
+			r2 = acphy_rxgainerr5g[8 + grp - 1];
+		}
+		v[0] = sign_extend32(r0, 5);			/* sbfx #0, #6 */
+		if (a->ncores > 1)
+			v[1] = sign_extend32(r1, 4);		/* sbfx #0, #5 */
+		if (a->ncores > 2)
+			v[2] = sign_extend32(r2, 4);
+		if (v[0] == -1 && v[1] == -1 && v[2] == -1) {
+			v[0] = v[1] = v[2] = 0;
+			flag = 1;
+		} else {
+			flag = 0;
+		}
+		g = a->rxgainerr[grp];
+		g[4] = flag;
+		g[0] = (u8)v[0];
+		g[1] = (u8)(v[0] + v[1]);
+		g[2] = (u8)(v[0] + v[2]);
+	}
+	b43info(dev->wl, "radio 0x2069: RX gain error per core, 5 GHz ch 15..48 %d/%d/%d, 49..64 %d/%d/%d, 65..128 %d/%d/%d, >128 %d/%d/%d, flags %u%u%u%u\n",
+		(s8)a->rxgainerr[1][0], (s8)a->rxgainerr[1][1], (s8)a->rxgainerr[1][2],
+		(s8)a->rxgainerr[2][0], (s8)a->rxgainerr[2][1], (s8)a->rxgainerr[2][2],
+		(s8)a->rxgainerr[3][0], (s8)a->rxgainerr[3][1], (s8)a->rxgainerr[3][2],
+		(s8)a->rxgainerr[4][0], (s8)a->rxgainerr[4][1], (s8)a->rxgainerr[4][2],
+		a->rxgainerr[1][4], a->rxgainerr[2][4], a->rxgainerr[3][4],
+		a->rxgainerr[4][4]);
+}
+
+/*
+ * NVRAM pci/2/1/rssicorrnorm5g_c0..2, twelve values each (sub-band 1..4 x
+ * 20/40/80 MHz), rssi-rev42.md. Not in struct ssb_sprom either. Not read on
+ * the R6400 yet; without them every offset is 0, which is what wl stores
+ * for a missing key (0x470cc..0x47114).
+ */
+static int acphy_rssicorr5g[36];
+static int acphy_rssicorr5g_n;
+module_param_array_named(acphy_rssicorr5g, acphy_rssicorr5g, int, &acphy_rssicorr5g_n, 0444);
+MODULE_PARM_DESC(acphy_rssicorr5g,
+	"NVRAM rssicorrnorm5g_c0,_c1,_c2 of the 5 GHz radio, twelve values each, c0 first; without them the RSSI offset is 0");
+
+/*
+ * wlc_phy_attach_acphy 0x47030..0x471a8 (rssi-rev42.md): per core, when
+ * "rssicorrnorm5g_c%d" (.rodata.str1.1 0x987) exists, element 3sb + bw is
+ * stored as a byte at pi_ac[0x3f6 + 12c + 3sb + bw] (0x4711c..0x47140),
+ * else all twelve bytes are 0 (0x470d4..0x47114). The 2 GHz pair
+ * (rssicorrnorm_c%d) is not kept: b43 sets no 2 GHz channel.
+ */
+static void b43_ac2069_rssicorr_attach(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	unsigned int c, i;
+
+	memset(a->rssicorr5g, 0, sizeof(a->rssicorr5g));
+	if (acphy_rssicorr5g_n != ARRAY_SIZE(acphy_rssicorr5g))
+		return;
+	for (c = 0; c < a->ncores && c < 3; c++)
+		for (i = 0; i < 12; i++)
+			a->rssicorr5g[c][i / 3][i % 3] = (s8)acphy_rssicorr5g[12 * c + i];
+}
+
+/*
+ * Radio-on for 0x2069 in wl's order: power-on with prefregs, R cal, RC cal
+ * (all in wlc_phy_switch_radio_acphy), then the VCO cal.
+ *
+ * The VCO cal is not part of wl's radio-on; it runs inside every channel set
+ * (wlc_phy_chanspec_set_acphy 0x4c44c, isdone at 0x4d580 with flag 0) and in
+ * wlc_phy_cals_acphy (0x3bff4, isdone at 0x3c000 with flag 1). It is called
+ * here the way wlc_phy_cals_acphy calls it, with the 120 us settle, on the
+ * PLL as prefregs left it; that ran clean on the radio (2026-10-06 01:03
+ * UTC) and is kept. The channel set starts its own (b43_ac2069_tune).
+ */
+static int b43_ac2069_radio_on(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	struct b43_ac2069 c = { };
+	bool vco;
+	int err;
+
+	err = b43_ac2069_check(dev, &c);
+	if (err)
+		return err;
+
+	b43info(dev->wl, "radio 0x2069 rev %u (major %u): %u cores, xtal %u Hz, starting power-on\n",
+		c.rev, c.major, c.ncores, c.xtal);
+
+	phy_ac->ncores = c.ncores;
+	b43_ac2069_rxgainerr_attach(dev);	/* wl: attach, 0x468d0..0x46e50 */
+	b43_ac2069_rssicorr_attach(dev);	/* wl: attach, 0x47030..0x471a8 */
+	b43_ac2069_pwron(dev, &c);
+	b43_phy_ac_inittime(dev, "pwron", 0);
+	b43_ac2069_rcal(dev, &c);
+	b43_phy_ac_inittime(dev, "rcal", c.timeouts);
+	b43_ac2069_rccal(dev, &c);
+	b43_phy_ac_inittime(dev, "rccal",
+			    phy_ac->rc_result[0] | phy_ac->rc_dacbuf << 8);
+	b43_ac2069_vcocal(dev);
+	vco = b43_ac2069_vcocal_isdone(dev, &c, true);
+	b43_phy_ac_inittime(dev, "vcocal", vco);
+
+	b43info(dev->wl, "radio 0x2069 rev %u: power-on done, rc 0x%02x/0x%02x dacbuf 0x%02x, VCO cal %s, %u poll timeouts\n",
+		c.rev, phy_ac->rc_result[0], phy_ac->rc_result[1],
+		phy_ac->rc_dacbuf, vco ? "done" : "not done", c.timeouts);
+	return 0;
+}
+
+static void b43_ac2069_regtbl_on_pwron(struct b43_wldev *dev, bool por);
+
+static void b43_ac2069_bw40fix_early(struct b43_wldev *dev);
+
+/*
+ * acphy_bw40fix: the 40/80 MHz RX fault (ht20-rev42.md 2026-10-07 13:14 UTC:
+ * HT40 PPDUs from the laptop are never classified as HT, RXFT ht 0/0, while
+ * the PHY register state at 80 MHz matches wl's captures row for row). What
+ * is left against wl is order, not values. Bitmask, default 0; each bit logs
+ * one "BW40FIX" line where it acts.
+ *  1 (B43_AC_BW40FIX_EARLY): the core IOCTL bandwidth bits (and the
+ *    bandwidth state) go in at the start of op_init, before the radio-on
+ *    with its R/RC/VCO cals and regtbl_on_pwron, from the chandef b43 will
+ *    set at the init set. wl: wlc_phy_init @0x56888 calls wlapi_bmac_bw_set
+ *    at 0x56904..0x56920 before wlc_phy_init_acphy; in the agcombo bus
+ *    capture (ch36/80 cold up) the ioctrl write that sets bits 6..7 to the
+ *    80 MHz code (wlc_phy_clk_bwbits 0x53e74) comes five operations before
+ *    the first PHY write, with no PHY reset in between. The port flipped
+ *    them at the init set (ht40-2069.md section 2), after both had run under
+ *    the 20 MHz bits.
+ *  2 (B43_AC_BW40FIX_RESET): with 1, wl's PHY reset pulse
+ *    (b43_phy_ac_phy_reset_wl, cflags(0xce, bwbits | 0xe)) right after the
+ *    flip, so the PHY leaves reset with the bandwidth bits as it does on
+ *    wl's warm up (wlc_bmac_corereset 0x15e7a4 uses the state's bits).
+ *    Nothing has been written to the PHY at that point.
+ *  4 (B43_AC_BW40FIX_REINIT): a bandwidth change at a non-init set does what
+ *    wl does for its non-AC PHYs (wlc_bmac_bw_set 0x15d408..0x15d438:
+ *    phy reset + wlc_phy_init) instead of the live flip: flip (+ reset with
+ *    2), radio-on, regtbl_on_pwron, then the set runs as an init set.
+ *  8 (B43_AC_BW40FIX_EDTHRES): wlc_phy_ed_thres_acphy @0x2b430 at every
+ *    5 GHz set with acphy_edthresh dBm (wl runs it when its byte pi[0x4da0]
+ *    is 1, 0x47a38..0x47a50; the port skipped it). Default -65 dBm: what
+ *    wlc_phy_init_acphy computes into pi_ac[0x470] for PHY rev 1
+ *    (0x500f0..0x50124, (30103 * 0x415 - 73111232) / 640000). Our dumps
+ *    hold the reset values of 0x33a..0x349 (-62 dBm) at every bandwidth.
+ */
+#define B43_AC_BW40FIX_EARLY		0x01
+#define B43_AC_BW40FIX_RESET		0x02
+#define B43_AC_BW40FIX_REINIT		0x04
+#define B43_AC_BW40FIX_EDTHRES		0x08
+static unsigned int acphy_bw40fix;
+module_param_named(acphy_bw40fix, acphy_bw40fix, uint, 0444);
+MODULE_PARM_DESC(acphy_bw40fix,
+	"40/80 MHz RX fault candidates, bitmask: 1 IOCTL bandwidth bits before the radio-on (wl's order), 2 wl PHY reset pulse after that flip, 4 re-init the PHY on a bandwidth change at a later set, 8 ED thresholds (acphy_edthresh) at every set (default 0)");
+
+/*
+ * acphy_initfix: the per-load "HT TX dead" state (htdead-rev42.md) is drawn
+ * in b43_wireless_core_init and re-drawn by a controller restart, and the
+ * 2026-10-07 21:02..22:03 UTC loads went live after the same restart count
+ * in runs of three (1, 1, 1; then 3, 3, 3 on the same build; 0 of 18 on a
+ * build with the same code gated off): not a coin toss per init but
+ * something that advances per init and depends on the binary. The audit
+ * (section 7 of that note) found no local read before it is written
+ * (phy_ac.c, xmit.c, main.c and dma.c compiled at -O2 with
+ * -Wmaybe-uninitialized and with -fanalyzer: nothing beyond upstream's
+ * b43_generate_txhdr / b43_rx false positives). What a re-init does
+ * inherit, against a fresh module load:
+ *  - this struct: op_allocate zeroes it once; prepare_structs resets eight
+ *    fields. intf_mode is the one with a hardware effect: 0 on the first
+ *    init's set, 7 on every later one (wl's sh+108, kept across its ups),
+ *    so b43_ac2069_band_change runs wlc_phy_hwaci_setup_acphy(1, 0) and
+ *    wlc_phy_aci_w2nb_setup_acphy(1) (PHY 0x728 bits 11..13 = 1, 0x729
+ *    bit 12, radio 0x033 bits 12..15 = 4 per core) on a restart's init set
+ *    and not on the first one; with acphy_intf=0 (the default) nothing
+ *    runs them after the first init's set either. The ACI records (a
+ *    found record keeps its bytes 16..25, the desense inputs), the
+ *    desense bookkeeping, the RX gain state, the TX power rows, the cal
+ *    state and the saved bbmult are the rest; they are recomputed by the
+ *    set or unused without acphy_desense / acphy_txcal.
+ *  - the ucode's shared memory: b43_upload_microcode zeroes 4 KB, and the
+ *    initvals write from 0x1000 up (0x10ca, 0x17d2, 0x17e4..); ucode 907
+ *    keeps its own words there too (0x17f4..0x180e the PHY control
+ *    read-back, 0x1816 and 0x1822..0x1832 the packet engine,
+ *    ucode907-tx.md), which a restart and even a module reload inherit.
+ *  - per-wldev AC counters (99m's PHY TX error count, 9g0's A-MPDU epoch
+ *    state without TX aggregation).
+ * Bitmask, default 0; each bit logs "INITFIX" lines where it acts:
+ *  1 (B43_AC_INITFIX_PHYSTATE): prepare_structs zeroes this struct and
+ *    re-applies the attach presets, so every init starts as the first one
+ *    did (intf_mode 0: the init set without the hwaci / w2nb setup).
+ *  2 (B43_AC_INITFIX_INTF7): intf_mode 7 before every init set, so every
+ *    init starts as a restart did (hwaci and w2nb set up in band_change).
+ *    With 1: all inits alike, hwaci on; 1 alone: all inits alike, off.
+ *  4 (B43_AC_INITFIX_WLDEV), main.c: the per-wldev AC counters and the
+ *    A-MPDU epoch state zeroed at every core init.
+ *  8 (B43_AC_INITFIX_SHM), main.c: shared memory 0x1000 up to
+ *    acphy_initfix_shm bytes (default 0x2000, past the highest ucode 907
+ *    word known, 0x1832) zeroed before the ucode upload, with the 4 KB.
+ *  16 (B43_AC_INITFIX_LOG): one "INITFIX init N" line per op_init with
+ *    the inherited driver fields and the registers the power-on and the
+ *    init set read-modify-write (PHY 0x001, 0x408, 0x720, 0x721, 0x728,
+ *    0x729, 0x19e, radio 0x033 / 0x96b / 0x96c, TSF), read before the
+ *    radio-on; main.c adds the shared memory words above 4 KB before
+ *    they are zeroed and the wldev counters. N is init_seq, the value
+ *    that advances per init.
+ */
+unsigned int b43_modparam_acphy_initfix;
+module_param_named(acphy_initfix, b43_modparam_acphy_initfix, uint, 0644);
+MODULE_PARM_DESC(acphy_initfix,
+	"State a core re-init inherits (htdead-rev42.md 7), bitmask: 1 phy_ac state back to attach values at every init, 2 intf_mode 7 before every init set, 4 per-wldev AC counters zeroed, 8 shared memory above 4 KB zeroed before the ucode upload, 16 log the inherited values (default 0)");
+
+unsigned int b43_modparam_acphy_initfix_shm = 0x2000;
+module_param_named(acphy_initfix_shm, b43_modparam_acphy_initfix_shm, uint, 0644);
+MODULE_PARM_DESC(acphy_initfix_shm,
+	"acphy_initfix bit 8: end (bytes) of the shared memory zeroed before the ucode upload, 0x1000 up (default 0x2000)");
+
+/*
+ * acphy_radiodump: the per-init "HT TX dead" state (htdead-rev42.md) is
+ * excluded for every PHY register and table cell the 99r/99u dumps read
+ * (identical in live and dead inits), for the shared memory above 4 KB,
+ * the DMA ring placement, the init order and timing as logged so far, the
+ * build, temperature and allocator state. The one layer no dump has read
+ * per init is the radio 0x2069 itself: its registers hold what the init
+ * leaves there and the ucode never sees: the R cal (0x40b) and RC cal
+ * codes (0x413..0x416 and the per-core copies pass 1 writes into 0x126 and
+ * 0x043, rcal-2069.md), the VCO cal state and done bit (0x8d0, 0x8dc,
+ * 0x8e5, 0x8e8, 0x90b, vcocal-2069.md), the PLL (0x8c7..0x8cc and the
+ * tuning rows, chan-tuning-2069.md), the TX and RX gain, LOFT and bias
+ * state per core (txgain-2069.md, rxgain-2069.md; core c at c << 9), the
+ * 0x600 bank (0x723) and the common bank 0x800..0x9ff of the power-on
+ * (pwron-2069.md). No decode note marks a 0x2069 register as
+ * read-sensitive: the polls read 0x40b, 0x413, 0x80b and 0x90b repeatedly,
+ * wl reads 0x414..0x416 for results, and the only read-sensitive accesses
+ * on this chip are the PHY table data ports, which this sweep does not
+ * touch. Unmapped radio addresses are expected to read 0.
+ *
+ * int, default 0: nothing runs. Level (value & 3):
+ *  1: one dump per core init, at the end of the first completed channel
+ *     set (after the cals, the IQ log and the 99r/99u dumps: the 9t0
+ *     hook at the end of op_switch_channel);
+ *  2: also at the first HT frame of the init (xmit.c, the 9t0 hook before
+ *     99q's header dump, where 99r's acphy_regdump=1 dumps), a few ms
+ *     before the TXST40 status that labels the load.
+ *  +4 (B43_AC_RADIODUMP_PHYWIDE): the PHY registers no dump has read,
+ *     0xc00..0x15ff and 0x1800..0x1bff, in the same frame (reads of
+ *     unmapped PHY addresses return 0 on the N-PHY; not verified here).
+ * Lines, printk with b43info's prefix so net_ratelimit() cannot drop one:
+ *   RADREG begin <why> init N chanspec 0x.... ncores N
+ *   RADREG rrrr: 16 x %04x    radio 0x000..0x9ff
+ *   RADPHY rrrr: n x %04x     PHY status and read-back words b43 reads
+ *                             elsewhere (b43_ac_radiodump_phy[]), the
+ *                             per-core blocks for cores 0..2
+ *   RADREG end lines N
+ * tools/r6400-loaddiff.py parses them as a third class ("rad") next to
+ * PHYREG and tbldump and lists the cells whose live and dead value sets
+ * do not overlap.
+ *
+ * With any level set, one "INITTIME" line per init step, for the timing
+ * of the sequence against the MAC's clocks:
+ *   INITTIME init N step=<name> arg=0x.. us=<local_clock> dus=<since this
+ *   init's prepare_structs> tsf=hhhhhhhhllllllll macctl=.. ioctl=..
+ *   clkst=.. phy0=..
+ * steps: chip init, ucode run, ucode up, phy init done, core init done,
+ * mac enable (main.c, 9t0); op_init, pwron, rcal, rccal, vcocal, regtbl
+ * (the radio-on); set, tune, vcolock, set done (every channel set); first
+ * tx, first ht tx (xmit.c, 9t0). N counts prepare_structs calls, i.e. core
+ * inits since the module load (init_seq counts op_init calls, which come
+ * later in the same init).
+ */
+int b43_modparam_acphy_radiodump;
+module_param_named(acphy_radiodump, b43_modparam_acphy_radiodump, int, 0644);
+MODULE_PARM_DESC(acphy_radiodump,
+	"AC-PHY diagnosis (htdead-rev42.md): radio 0x2069 register dump and INITTIME step timing, 1 = once after the first completed channel set of every core init, 2 = also at the init's first HT frame, +4 PHY 0xc00..0x15ff and 0x1800..0x1bff too (default 0)");
+
+/* radio 0x000..0x9ff: cores 0..2 at core << 9, 0x600.., common 0x800.. */
+#define B43_AC_RADIODUMP_END		0xa00
+
+/*
+ * PHY status and read-back words b43 reads elsewhere (FEMDBG, INITFIX, the
+ * IQ log, the cals' polls): the clock/reset words 0x000..0x003, the
+ * classifier 0x140, the init-set timers 0x16c..0x170, 0x19e, the TX control
+ * block 0x1b0.., the IQ/FDIQI words 0x210.., the ED thresholds 0x33a..,
+ * 0x380..0x394, the rfseq and reset block 0x400.., then per core (+0x200
+ * for cores 1 and 2) 0x520.., 0x6a0.. (RX comp, FDIQI), 0x6dc.. (RX gain
+ * encode) and the RF override block 0x720..0x73e, 0x7ab... All inside the
+ * 99r/99u sweep ranges, so known safe to read.
+ */
+static const struct b43_ac_radiodump_phy {
+	u16 start;
+	u8 n;
+	bool percore;
+} b43_ac_radiodump_phy[] = {
+	{ 0x000, 4, false },
+	{ 0x00b, 1, false },
+	{ 0x070, 3, false },
+	{ 0x140, 1, false },
+	{ 0x16c, 5, false },
+	{ 0x19e, 1, false },
+	{ 0x1b0, 16, false },
+	{ 0x210, 3, false },
+	{ 0x270, 1, false },
+	{ 0x33a, 16, false },
+	{ 0x380, 21, false },
+	{ 0x3a9, 1, false },
+	{ 0x400, 32, false },
+	{ 0x464, 1, false },
+	{ 0x520, 16, true },
+	{ 0x550, 1, true },
+	{ 0x600, 2, true },
+	{ 0x678, 1, true },
+	{ 0x6a0, 15, true },
+	{ 0x6dc, 10, true },
+	{ 0x720, 31, true },
+	{ 0x7ab, 9, true },
+};
+
+/* one "<tag> rrrr: v v ..." line of n radio or PHY registers from base */
+static unsigned int b43_ac_radiodump_line(struct b43_wldev *dev,
+					  const char *tag, u16 base,
+					  unsigned int n, bool radio)
+{
+	const char *name = wiphy_name(dev->wl->hw->wiphy);
+	char buf[112];
+	unsigned int i;
+	int len;
+
+	len = scnprintf(buf, sizeof(buf), "%s %04x:", tag, base);
+	for (i = 0; i < n; i++)
+		len += scnprintf(buf + len, sizeof(buf) - len, " %04x",
+				 radio ? b43_radio_read(dev, base + i) :
+					 b43_phy_read(dev, base + i));
+	printk(KERN_INFO "b43-%s: %s\n", name, buf);
+	return 1;
+}
+
+void b43_phy_ac_radiodump(struct b43_wldev *dev, const char *why)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	const char *name = wiphy_name(dev->wl->hw->wiphy);
+	const struct b43_ac_radiodump_phy *p;
+	unsigned int lines = 0, i, k, n;
+	u16 r;
+	u8 c;
+
+	printk(KERN_INFO "b43-%s: RADREG begin %s init %u chanspec 0x%04x ncores %u\n",
+	       name, why, a->inittime_seq, a->chanspec, a->ncores);
+	for (r = 0; r < B43_AC_RADIODUMP_END; r += 16)
+		lines += b43_ac_radiodump_line(dev, "RADREG", r, 16, true);
+	for (i = 0; i < ARRAY_SIZE(b43_ac_radiodump_phy); i++) {
+		p = &b43_ac_radiodump_phy[i];
+		for (c = 0; c < (p->percore ? 3 : 1); c++) {
+			for (k = 0; k < p->n; k += n) {
+				n = min_t(unsigned int, 16, p->n - k);
+				lines += b43_ac_radiodump_line(dev, "RADPHY",
+						p->start + (c << 9) + k, n,
+						false);
+			}
+		}
+	}
+	if (b43_modparam_acphy_radiodump & B43_AC_RADIODUMP_PHYWIDE) {
+		for (r = 0xc00; r < 0x1600; r += 16)
+			lines += b43_ac_radiodump_line(dev, "RADPHY", r, 16,
+						       false);
+		for (r = 0x1800; r < 0x1c00; r += 16)
+			lines += b43_ac_radiodump_line(dev, "RADPHY", r, 16,
+						       false);
+	}
+	printk(KERN_INFO "b43-%s: RADREG end lines %u\n", name, lines);
+}
+
+/*
+ * One INITTIME line: the step's local_clock in microseconds, the time since
+ * this init's prepare_structs, and the MAC's clock words at that moment
+ * (TSF, MACCTL, core IOCTL and CLKCTLST, MMIO 0x3e6). MMIO only, no PHY or
+ * radio register: the early steps run before the PHY clock is on.
+ */
+void b43_phy_ac_inittime(struct b43_wldev *dev, const char *step, u32 arg)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	u32 ioctl = 0, clkst = 0;
+	u64 now;
+
+	if (!B43_AC_RADIODUMP_LEVEL(b43_modparam_acphy_radiodump) || !a)
+		return;
+	now = local_clock();
+	if (dev->dev->bus_type == B43_BUS_BCMA) {
+		ioctl = bcma_aread32(dev->dev->bdev, BCMA_IOCTL);
+		clkst = bcma_aread32(dev->dev->bdev, BCMA_CLKCTLST);
+	}
+	printk(KERN_INFO "b43-%s: INITTIME init %u step=%s arg=0x%x us=%llu dus=%llu tsf=%08x%08x macctl=%08x ioctl=%08x clkst=%08x phy0=%04x\n",
+	       wiphy_name(dev->wl->hw->wiphy), a->inittime_seq, step, arg,
+	       (unsigned long long)div_u64(now, 1000),
+	       (unsigned long long)div_u64(now - a->inittime_t0, 1000),
+	       b43_read32(dev, B43_MMIO_REV3PLUS_TSF_HIGH),
+	       b43_read32(dev, B43_MMIO_REV3PLUS_TSF_LOW),
+	       b43_read32(dev, B43_MMIO_MACCTL), ioctl, clkst,
+	       b43_read16(dev, B43_MMIO_PHY0));
+}
+
+/* The MAC-side steps from main.c: only for a device with an AC PHY */
+void b43_ac_inittime(struct b43_wldev *dev, const char *step, u32 arg)
+{
+	if (dev->phy.type == B43_PHYTYPE_AC && dev->phy.ac)
+		b43_phy_ac_inittime(dev, step, arg);
+}
+
+/*
+ * xmit.c (9t0), every TX header built on the AC path: the init's first TX
+ * and first HT TX, and with level 2 the radio dump at the first HT frame,
+ * before 99q's header dump of it.
+ */
+void b43_phy_ac_inittime_tx(struct b43_wldev *dev, bool ht)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+
+	if (!B43_AC_RADIODUMP_LEVEL(b43_modparam_acphy_radiodump) || !a)
+		return;
+	if (!a->inittime_tx) {
+		a->inittime_tx = true;
+		b43_phy_ac_inittime(dev, "first tx", ht);
+	}
+	if (ht && !a->inittime_httx) {
+		a->inittime_httx = true;
+		b43_phy_ac_inittime(dev, "first ht tx", 0);
+		if (B43_AC_RADIODUMP_LEVEL(b43_modparam_acphy_radiodump) >= 2)
+			b43_phy_ac_radiodump(dev, "first HT TX");
+	}
+}
+
+/*
+ * End of op_switch_channel (9t0, after the 99r/99u dumps): the "set done"
+ * step and, once per core init, the radio dump after the first completed
+ * set.
+ */
+void b43_phy_ac_radiodump_chanset(struct b43_wldev *dev, u16 chanspec)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+
+	b43_phy_ac_inittime(dev, "set done", chanspec);
+	if (!B43_AC_RADIODUMP_LEVEL(b43_modparam_acphy_radiodump) ||
+	    a->radiodump_set_done)
+		return;
+	a->radiodump_set_done = true;
+	b43_phy_ac_radiodump(dev, "channel set");
+}
+
+/*
+ * acphy_initfix bit 1: everything but the five fields around the desense
+ * work (dev, the work itself, desense_work_on, desense_ticks, desense_mode
+ * and init_seq; prepare_structs resets the three it owns) back to zero and
+ * the attach presets. The work is left alone: op_exit cancelled a pending
+ * one, and a running one waits for wl->mutex, which the caller holds.
+ */
+static void b43_phy_ac_state_reset(struct b43_phy_ac *phy_ac)
+{
+	memset(phy_ac, 0, offsetof(struct b43_phy_ac, dev));
+	/* the TX cal block after init_seq, field by field (fortify) */
+	memset(phy_ac->txcal_gain, 0, sizeof(phy_ac->txcal_gain));
+	memset(phy_ac->txiqlo_final, 0, sizeof(phy_ac->txiqlo_final));
+	memset(phy_ac->txiqlo_mem, 0, sizeof(phy_ac->txiqlo_mem));
+	phy_ac->txiqlo_valid = false;
+	memset(phy_ac->txcal_ladder, 0, sizeof(phy_ac->txcal_ladder));
+	phy_ac->txcal_chanspec = 0;
+	memset(phy_ac->tone_bbmult, 0, sizeof(phy_ac->tone_bbmult));
+	phy_ac->tone_bbmult_saved = false;
+	b43_phy_ac_state_attach(phy_ac);
+}
+
+/*
+ * acphy_initfix bit 16: the inherited fields and the registers the
+ * power-on and the init set read-modify-write, before the radio-on.
+ * Radio reads go through 991's guard (0 without the HT clock).
+ */
+static void b43_phy_ac_initfix_log(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	u8 (*rec)[80] = a->aci_rec[1];
+	const struct cfg80211_chan_def *cd = dev->phy.chandef;
+
+	if (!(b43_modparam_acphy_initfix & B43_AC_INITFIX_LOG))
+		return;
+	b43info(dev->wl, "INITFIX init %u: intf %u aci5g ch %u/%u/%u cur %d chanspec %04x bw %04x band2g %u bwstate %04x done %04x txidx %d/%d/%d gainerr %d/%d/%d crsmax %u desense %u/%u lna %u/%u/%u/%u txcal %u/%04x ncores %u chan %u/%u\n",
+		a->init_seq, a->intf_mode, rec[0][0], rec[1][0], rec[2][0],
+		a->aci_cur ? (int)((a->aci_cur - rec[0]) / 80) : -1,
+		a->chanspec, a->bw, a->band_2g, a->bw_state, a->done_chanspec,
+		a->txpwr_idx[0], a->txpwr_idx[1], a->txpwr_idx[2],
+		(s8)a->rx_gainerr[0], (s8)a->rx_gainerr[1], (s8)a->rx_gainerr[2],
+		a->crs_thr_max, a->desense_total[9], a->desense_last[0],
+		a->desense_lna[0], a->desense_lna[1], a->desense_lna[2],
+		a->desense_lna[3], a->txiqlo_valid, a->txcal_chanspec,
+		a->ncores, dev->phy.channel,
+		cd && cd->chan ? cd->chan->hw_value : 0);
+	b43info(dev->wl, "INITFIX init %u regs: phy 001 %04x 408 %04x 720 %04x 721 %04x 728 %04x 729 %04x 19e %04x 1b0 %04x 3e6 %04x radio 033 %04x 96b %04x 96c %04x 8ea %04x tsf %08x%08x\n",
+		a->init_seq, b43_phy_read(dev, 0x001), b43_phy_read(dev, 0x408),
+		b43_phy_read(dev, 0x720), b43_phy_read(dev, 0x721),
+		b43_phy_read(dev, 0x728), b43_phy_read(dev, 0x729),
+		b43_phy_read(dev, 0x19e), b43_phy_read(dev, 0x1b0),
+		b43_read16(dev, B43_MMIO_PHY0), b43_radio_read(dev, 0x033),
+		b43_radio_read(dev, 0x96b), b43_radio_read(dev, 0x96c),
+		b43_radio_read(dev, 0x8ea),
+		b43_read32(dev, B43_MMIO_REV3PLUS_TSF_HIGH),
+		b43_read32(dev, B43_MMIO_REV3PLUS_TSF_LOW));
+}
+
+/*
+ * b43_phy_ac_op_init.
+ *
+ * Default: log the radio id and rev that b43_phy_versioning cached, and do
+ * nothing else. No register is read or written.
+ *
+ * acphy_pwron=1:
+ * - radio 0x2069 (the R6400's expected radio, radio-id.md): the stage 2
+ *   radio-on above for revs 3, 4 and 18, after its own gate, then
+ *   wlc_phy_set_regtbl_on_pwron_acphy (b43_ac2069_regtbl_on_pwron).
+ * - radio 0x30b (20691): the stage 1 sequences, unchanged: power-on, the
+ *   rev-18 prefreg table, then the VCO cal, in the order pwron_seq calls
+ *   them (the prefreg write is line 37, inside the sequence, before the
+ *   mask-set run), rev 18 only, because every register number there is the
+ *   rev<=26 column.
+ * - anything else: logged, -ENODEV.
+ *
+ * A second init while pwron_done is set is a no-op, like wl's radio-on
+ * flag pi+0x4bdc (0x4d95c..0x4d968). b43_phy_init calls software_rfkill
+ * (dev, false) just before this, which clears pwron_done, so every PHY
+ * init runs the power-on exactly once.
+ */
+static int b43_phy_ac_op_init(struct b43_wldev *dev)
+{
+	int err;
+
+	/* Cached by b43_phy_versioning; logging them touches no register. */
+	b43info(dev->wl, "AC-PHY rev %u, radio manuf 0x%x id 0x%x rev %u\n",
+		dev->phy.rev, dev->phy.radio_manuf, dev->phy.radio_ver,
+		dev->phy.radio_rev);
+
+	if (!acphy_pwron)
+		return 0;
+
+	if (dev->phy.ac->pwron_done)
+		return 0;
+
+	dev->phy.ac->init_seq++;
+	b43_phy_ac_inittime(dev, "op_init", dev->phy.ac->init_seq);
+	if (dev->phy.radio_ver == B43_RADIO_ID_2069) {
+		b43_phy_ac_initfix_log(dev);
+		/*
+		 * acphy_initfix 2: wl's sh+108 is 7 on every init but the
+		 * first after attach (0x56aac); the init set then runs the
+		 * hwaci and w2nb setup in b43_ac2069_band_change.
+		 */
+		if (b43_modparam_acphy_initfix & B43_AC_INITFIX_INTF7) {
+			b43info(dev->wl, "INITFIX init %u: intf_mode %u -> 7 before the init set (acphy_initfix 2)\n",
+				dev->phy.ac->init_seq, dev->phy.ac->intf_mode);
+			dev->phy.ac->intf_mode = 7;
+		}
+		/*
+		 * acphy_bw40fix 1: wl's wlc_phy_init sets the bandwidth bits
+		 * before any of the PHY init (0x56904..0x56920); the radio-on
+		 * below is its first PHY access.
+		 */
+		if (acphy_bw40fix & B43_AC_BW40FIX_EARLY)
+			b43_ac2069_bw40fix_early(dev);
+		/*
+		 * acphy_initorder 2: wl sets MACPHYCLKEN in its bmac init,
+		 * after the ucode start and before wlc_phy_init (the capture
+		 * sets the bit ahead of the first PHY access);
+		 * reg_on_reset step 11 sets it again, a no-op then.
+		 */
+		if (b43_modparam_ac_initorder & B43_AC_INITORDER_MPCLK) {
+			struct bcma_device *core = dev->dev->bdev;
+			u32 io = bcma_aread32(core, BCMA_IOCTL);
+
+			bcma_awrite32(core, BCMA_IOCTL,
+				      io | B43_BCMA_IOCTL_MACPHYCLKEN);
+			b43info(dev->wl, "AC-PHY: MACPHYCLKEN before the radio-on (acphy_initorder 2), core IOCTL 0x%08x -> 0x%08x\n",
+				io, bcma_aread32(core, BCMA_IOCTL));
+		}
+		err = b43_ac2069_radio_on(dev);
+		if (err)
+			return err;
+		dev->phy.ac->pwron_done = true;
+		/* wlc_phy_init_acphy 0x4ffc8..0x4ffe8 (tx-enable-rev42.md, Trial 13:54) */
+		b43_phy_maskset(dev, 0x1b0, (u16)~0x8000, 0x8000);
+		/*
+		 * wlc_phy_init_acphy @0x4ff80, 0x500b0: after the radio-on and
+		 * before the first channel set (regtbl-on-pwron-rev1.md). Its
+		 * table step is gated on wl's power-on-reset flag pi+0xe1, set
+		 * at attach and on every wlc_bmac_hw_up; op_init runs once per
+		 * b43 core reset, so it is set here every time.
+		 */
+		b43_ac2069_regtbl_on_pwron(dev, true);
+		b43_phy_ac_inittime(dev, "regtbl", 0);
+		/*
+		 * wlc_phy_init_acphy runs the next channel set with
+		 * pi_ac[0x368] = 1 (0x500b4..0x500d8, chan-common-2069.md).
+		 */
+		dev->phy.ac->chan_init = true;
+		return 0;
+	}
+
+	if (dev->phy.radio_ver != B43_ACPHY_RADIO_ID) {
+		b43err(dev->wl, "radio id 0x%x, this port is 0x%x and 0x%x only\n",
+		       dev->phy.radio_ver, B43_RADIO_ID_2069,
+		       B43_ACPHY_RADIO_ID);
+		return -ENODEV;
+	}
+	if (dev->phy.rev != 1) {
+		b43err(dev->wl, "AC-PHY rev %u, expected 1\n", dev->phy.rev);
+		return -ENODEV;
+	}
+	if (dev->phy.radio_rev != B43_ACPHY_RADIO_REV) {
+		b43err(dev->wl, "radio rev %u, this port is rev %u only\n",
+		       dev->phy.radio_rev, B43_ACPHY_RADIO_REV);
+		return -ENODEV;
+	}
+
+	b43_phy_ac_radio20691_pwron(dev);
+	b43_phy_ac_prefregs(dev, b43_acphy_prefregs_rev18,
+			    ARRAY_SIZE(b43_acphy_prefregs_rev18));
+	b43_phy_ac_radio20691_vcocal(dev);
+
+	dev->phy.ac->pwron_done = true;
+	b43info(dev->wl, "AC-PHY radio 20691 rev 18 analog power-on done\n");
+	return 0;
+}
+
+/*
+ * b43_phy_exit calls software_rfkill(dev, true) first, so the radio-off
+ * (pwroff-2069.md) has run by the time this is reached; so has the
+ * b43_phy_init error path, which calls this and then software_rfkill(true).
+ * wl does no hardware access on PHY down or detach for an AC-PHY:
+ * wlc_phy_down @0x54170 only deletes the PHY cal timer (0x5418c..0x54194)
+ * and returns for PHY type 11 (0x541a0..0x541a8); the AC-PHY detach hook
+ * [pi,#108] = wlc_phy_detach_acphy (stored at 0x47388, R_ARM_ABS32 at
+ * 0x46b6c) only frees pi_ac (osl_mfree, 0x1e34c..0x1e360). So only the
+ * driver state is reset here.
+ */
+static void b43_phy_ac_op_exit(struct b43_wldev *dev)
+{
+	dev->phy.ac->pwron_done = false;
+	dev->phy.ac->chan_init = false;
+	/*
+	 * Under wl->mutex (b43_wireless_core_exit): a pending desense work is
+	 * dropped, a running one sees the flag once it gets the mutex and
+	 * does not requeue itself.
+	 */
+	dev->phy.ac->desense_work_on = false;
+	cancel_delayed_work(&dev->phy.ac->desense_work);
+}
+
+/*
+ * b43_wireless_core_init calls prepare_structs unconditionally (backports
+ * main.c 4937) before the core reset, and upstream's AC ops leave it NULL:
+ * the 2026-10-06 00:48 UTC interface-up oopsed there (PC 0, process ip). The
+ * core reset that follows powers the radio down, so the next init must run
+ * the radio-on sequence again; the RC cal presets go back to wl's attach
+ * values, as in b43_phy_ac_op_allocate, and the channel-set state starts
+ * over (the first set after power-on is an init set again). Touches no
+ * hardware.
+ */
+static void b43_phy_ac_op_prepare_structs(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+
+	/*
+	 * acphy_initfix 1: the whole state back to what op_allocate left,
+	 * so a controller restart's init runs as the module load's did
+	 * (intf_mode 0, no ACI record, no desense / gain / cal leftovers).
+	 */
+	if (b43_modparam_acphy_initfix & B43_AC_INITFIX_PHYSTATE) {
+		b43info(dev->wl, "INITFIX init %u: phy_ac state reset to the attach values (acphy_initfix 1), intf_mode was %u, aci record %s\n",
+			phy_ac->init_seq + 1, phy_ac->intf_mode,
+			phy_ac->aci_cur ? "present" : "none");
+		b43_phy_ac_state_reset(phy_ac);
+	}
+	phy_ac->pwron_done = false;
+	phy_ac->chan_init = false;
+	phy_ac->done_chanspec = 0;
+	phy_ac->cs_count = 0;
+	phy_ac->rc_result[0] = 0x80;
+	phy_ac->rc_result[1] = 0x80;
+	/* the ucode restarts: MAC-stat counters and the watchdog state start over */
+	phy_ac->aci_stat_valid = false;
+	phy_ac->aci_core = 0;
+	phy_ac->desense_work_on = false;
+	phy_ac->desense_ticks = 0;
+	phy_ac->desense_mode = 0;
+	/* acphy_radiodump: this core init's number, clock origin, one-shots */
+	phy_ac->inittime_seq++;
+	phy_ac->inittime_t0 = local_clock();
+	phy_ac->inittime_tx = false;
+	phy_ac->inittime_httx = false;
+	phy_ac->radiodump_set_done = false;
+	/*
+	 * b43's core reset leaves core IOCTL bits 6..7 at 20 MHz
+	 * (b43_bcma_phy_reset), so the bandwidth state follows it
+	 * (ht40-2069.md); wl's own PHY reset uses the state's bits instead
+	 * (wlc_bmac_phy_reset, cflags(0xce, bwbits | 0xe), 0x15d334..0x15d354).
+	 */
+	phy_ac->bw_state = 0x1000;
+}
+
+/*
+ * b43 calls these three unconditionally: switch_analog(dev, 0) at the end of
+ * b43_wireless_core_attach (backports main.c 5616), software_rfkill and
+ * switch_channel from b43_phy_init. Upstream's AC ops leave them NULL, so the
+ * first probe that gets past the radio-id read would jump through NULL.
+ * switch_analog is wl's wlc_phy_anacore, software_rfkill wl's radio-off
+ * (pwroff-2069.md), switch_channel the channel set below.
+ */
+static void b43_phy_ac_op_switch_analog(struct b43_wldev *dev, bool on)
+{
+	/*
+	 * wlc_phy_anacore @0x53cc8: PHY type 11 takes the generic tail
+	 * (0x53db0..0x53e00), MMIO 0x3e6 = 0 for on (0x53dd0..0x53dd8), 0xf4
+	 * for off (0x53df4..0x53dfc), b43's b43_phyop_switch_analog_generic
+	 * (tx-enable-rev42.md cause 4). The old value is logged to learn the
+	 * reset state.
+	 */
+	b43info(dev->wl, "AC-PHY: switch_analog(%d), MMIO 0x3e6 was 0x%04x\n",
+		on, b43_read16(dev, B43_MMIO_PHY0));
+	b43_write16(dev, B43_MMIO_PHY0, on ? 0 : 0xF4);
+}
+
+/*
+ * wlc_phy_switch_radio_acphy @0x4d940 with on == 0, the branch at 0x4f9c8,
+ * chip 0x4360 (pwroff-2069.md). PHY registers only: the path has no radio
+ * register access, no delay and no poll on this chip, and it saves nothing.
+ * The 0x1xxx registers are what the chip switch picks for 0x4360 (the
+ * all-cores form, regtbl-on-pwron-rev1.md); 0x408, 0x416 and 0x417 have no
+ * chip switch. The radio-on (pwron-2069.md steps 3 and 9) and
+ * wlc_phy_set_regtbl_on_pwron_acphy write all of them back except 0x1739,
+ * for which no write was found (pwroff-2069.md); wl leaves it, so does this.
+ */
+static void b43_ac2069_radio_off(struct b43_wldev *dev)
+{
+	b43_phy_write(dev, 0x173e, 0);				/* 0x4fa28 */
+	b43_phy_write(dev, 0x1739, 0);				/* 0x4fa84 */
+	b43_phy_write(dev, 0x173a, 0);				/* 0x4fae0 */
+	b43_phy_write(dev, 0x1725, 0x1fff);			/* 0x4fb3c */
+	b43_phy_write(dev, 0x1729, 0);				/* 0x4fb98 */
+	b43_phy_write(dev, 0x1721, 0xffff);			/* 0x4fbf4 */
+	b43_phy_write(dev, 0x1728, 0);				/* 0x4fc50 */
+	b43_phy_write(dev, 0x1720, 0x03ff);			/* 0x4fcac */
+	/* phy_reg_mod(0x408, 0x2, 0) @0x538e0: clears bit 1 */
+	b43_phy_mask(dev, 0x0408, (u16)~0x0002);		/* 0x4fcc0 */
+	b43_phy_write(dev, 0x0417, 0);				/* 0x4fcd0 */
+	b43_phy_write(dev, 0x0416, 0x0001);			/* 0x4fce0 */
+	/*
+	 * 0x4fce4..0x4fcf4: chip ([sh,#40]) 0x4335 only goes on to the radio
+	 * 0x97f/0x8ea writes (0x4fcf8..0x4ff00); 0x4360 branches to the exit
+	 * at 0x4ff04, which returns at 0x4ff74 for this chip.
+	 */
+}
+
+/*
+ * software_rfkill. b43_software_rfkill suspends the MAC around it
+ * (backports phy_common.c 451), as wl's off paths do
+ * (wlc_bmac_radio_hw 0x161e10, wlc_bmac_down_finish 0x15f3b4).
+ *
+ * blocked: wl's radio-off, wlc_phy_switch_radio(pi, 0) then
+ * wlc_phy_anacore(pi, 0), in the order both of wl's callers use
+ * (wlc_coredisable 0x15e860/0x15e870 on down, wlc_bmac_radio_hw
+ * 0x161e20/0x161e38). wl's off path clears its radio-on flag pi+0x4bdc
+ * (0x4f9d0) and runs whatever the flag was, so this clears pwron_done and
+ * does not look at it: the b43_phy_init error path calls op_exit (which
+ * clears pwron_done) before software_rfkill(true), and the radio must still
+ * go off there. Gated like the radio-on: acphy_pwron, radio 0x2069 and
+ * b43_ac2069_check() (HT clock, PHY rev, chip, radio rev) before any
+ * access.
+ *
+ * unblocked: no hardware access. pwron_done is cleared, so the next op_init
+ * or switch_channel runs the full radio-on. b43_phy_init calls this
+ * immediately before op_init, which then powers the radio on once; doing it
+ * here as well would run the power-on twice. An unblock from b43_op_config
+ * or b43_rfkill_poll is not followed by an init, so the radio stays off
+ * until the next channel set.
+ */
+static void b43_phy_ac_op_software_rfkill(struct b43_wldev *dev, bool blocked)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	struct b43_ac2069 c = { };
+	bool was_on = phy_ac->pwron_done;
+
+	phy_ac->pwron_done = false;
+	phy_ac->done_chanspec = 0;		/* acphy_initorder 4 */
+	if (!blocked) {
+		b43info(dev->wl, "AC-PHY: software_rfkill(0): radio-on deferred to the next PHY init or channel set%s\n",
+			was_on ? " (pwron_done was set; it runs the full power-on again)" : "");
+		return;
+	}
+
+	if (!acphy_pwron) {
+		b43info(dev->wl, "AC-PHY: software_rfkill(1): acphy_pwron=0, no register access\n");
+		return;
+	}
+	if (dev->phy.radio_ver != B43_RADIO_ID_2069) {
+		b43err(dev->wl, "AC-PHY: software_rfkill(1): radio-off is ported for radio 0x2069 only (radio 0x%x), radio left as it is\n",
+		       dev->phy.radio_ver);
+		return;
+	}
+	if (b43_ac2069_check(dev, &c)) {
+		b43err(dev->wl, "radio 0x2069: software_rfkill(1) refused by the gate, radio left as it is\n");
+		return;
+	}
+
+	b43_ac2069_radio_off(dev);			/* wlc_phy_switch_radio(pi, 0) */
+	b43_phy_ac_op_switch_analog(dev, false);	/* wlc_phy_anacore(pi, 0) */
+	b43info(dev->wl, "radio 0x2069 rev %u: radio off (wl 0x4f9c8 path, MMIO 0x3e6 = 0xf4)%s\n",
+		c.rev, was_on ? "" : ", power-on had not completed");
+}
+
+/*
+ * Radio-on again after a software rfkill, from switch_channel when
+ * pwron_done is clear. wl's matching path is wlc_bmac_radio_hw(on)
+ * @0x161d60: wlc_phy_anacore(pi, 1) (0x161dec), then wlc_phy_switch_radio
+ * (pi, 1) (0x161dfc), whose radio-on ends, with pi_ac[0x369] set by the
+ * first init, in wlc_phy_set_regtbl_on_pwron_acphy (0x4f9a8, with the
+ * power-on-reset flag pi+0xe1 clear) and a channel set with pi_ac[0x368]
+ * as the first init left it (0x4f9b4). chan_init is not touched here; the
+ * caller's set is that channel set. The PMU half of wlc_bmac_radio_hw
+ * (si_pmu_radio_enable, not in wl.ko, and the clk_ctl_st bit 5 clear at
+ * 0x161dc8) is not ported. Gate first, then the analog switch.
+ */
+static int b43_ac2069_radio_on_again(struct b43_wldev *dev)
+{
+	struct b43_ac2069 c = { };
+	int err;
+
+	err = b43_ac2069_check(dev, &c);
+	if (err)
+		return err;
+	b43_phy_ac_op_switch_analog(dev, true);		/* 0x161dec */
+	err = b43_ac2069_radio_on(dev);			/* 0x161dfc */
+	if (err)
+		return err;
+	dev->phy.ac->pwron_done = true;			/* pi+0x4bdc, 0x4f9c0 */
+	b43_ac2069_regtbl_on_pwron(dev, false);		/* 0x4f9a8 */
+	return 0;
+}
+
+/**************************************************
+ * Radio 0x2069 rev 4 channel set, from wl.ko wlc_phy_chanspec_set_acphy @0x478bc
+ **************************************************/
+
+/*
+ * Conventions for this section, on top of the radio-on ones above:
+ * - b43_ac_phy_mod(reg, mask, val) is wl's phy_reg_mod @0x538e0, which
+ *   REPLACES the bits in mask (chan-common-2069.md); b43_phy_maskset keeps
+ *   the bits in its mask, so the helper passes ~mask.
+ * - Table reads and writes are wlc_phy_table_read/write_acphy, decoded in
+ *   chan-head-2069.md.
+ * - Only the path wl takes for this board is ported: PHY rev 1, radio 0x2069
+ *   rev 4 (major rev 0), chip 0x4360, 5 GHz, 20 MHz, femctrl 3. Branches
+ *   for other revs, radios, chips and boards are left out; the decode notes
+ *   cited at each step list them. b43_ac2069_chan_check() refuses anything
+ *   else before the first register access.
+ * - Where wl calls a function that is not decoded yet, a hook named after
+ *   it sits at wl's call site and stops the set there with b43err and
+ *   -EOPNOTSUPP (b43_ac2069_chan_gap()).
+ * - Where a decode note is an outline, the port follows full_disasm.txt and
+ *   cites the instruction addresses it was checked against.
+ */
+
+/*
+ * wl chanspec bits as wlc_phy_chanspec_set_acphy reads them
+ * (chan-common-2069.md, ht40-2069.md): channel byte (the center channel at
+ * 40 MHz), sideband bits 8..10 (0x100: the control channel is the upper
+ * 20 MHz half, wf_chspec_ctlchan @0x7840: center - 2 + 4 * sb), bandwidth
+ * bits 11..13, band bits 14..15.
+ */
+#define B43_AC_CHSPEC_BAND_5G		0xc000
+#define B43_AC_CHSPEC_BW		0x3800
+#define B43_AC_CHSPEC_BW_20		0x1000
+#define B43_AC_CHSPEC_BW_40		0x1800
+#define B43_AC_CHSPEC_BW_80		0x2000
+#define B43_AC_CHSPEC_SB		0x0700
+#define B43_AC_CHSPEC_SB_U		0x0100
+
+/*
+ * 40 MHz channel sets (HT40), ht40-2069.md. Off by default: a 40 MHz
+ * chandef is refused by the channel set, and b43's HT capabilities (99s)
+ * offer 20 MHz only, so nothing changes until the parameter is set. Read
+ * by main.c for the band's HT capabilities, so it cannot change after load.
+ */
+bool b43_modparam_ac_bw40;
+module_param_named(acphy_bw40, b43_modparam_ac_bw40, bool, 0444);
+MODULE_PARM_DESC(acphy_bw40,
+	"AC-PHY 40 MHz channels (HT40): radio 0x2069 40 MHz channel sets and, with the 99s patch, 20/40 MHz HT capabilities (default 0 = 20 MHz only)");
+
+/*
+ * 80 MHz channel sets (VHT80), vht80-2069.md. Off by default: an 80 MHz
+ * chandef is refused by the channel set, and b43's capabilities (99za) offer
+ * no 80 MHz width, so nothing changes until the parameter is set. Read by
+ * main.c for the band's VHT capabilities, so it cannot change after load.
+ */
+bool b43_modparam_ac_bw80;
+module_param_named(acphy_bw80, b43_modparam_ac_bw80, bool, 0444);
+MODULE_PARM_DESC(acphy_bw80,
+	"AC-PHY 80 MHz channels (VHT80): radio 0x2069 80 MHz channel sets and, with the 99za patch and acphy_vht=1, the VHT 80 MHz width (default 0)");
+
+/*
+ * The wl chanspec for a channel set to new_channel under mac80211's current
+ * chandef: 20 MHz (channel byte = new_channel), or with acphy_bw40 and a
+ * 5 GHz 40 MHz chandef whose control channel is 10 MHz from its center, the
+ * center channel, bandwidth 0x1800 and the sideband (ht40-2069.md, wl's
+ * layout as wf_chspec_ctlchan @0x7840 decodes it); or with acphy_bw80 and a
+ * 5 GHz 80 MHz chandef, the center channel, bandwidth 0x2000 and the
+ * sideband 0..3, control channel = center - 6 + 4 * sb (vht80-2069.md).
+ * Also b43's shm 0xa0 and TX header chanspec (99s, 99za). No hardware
+ * access.
+ */
+u16 b43_phy_ac_chanspec(struct b43_wldev *dev, unsigned int channel)
+{
+	const struct cfg80211_chan_def *cd = dev->phy.chandef;
+	u16 band = b43_current_band(dev->wl) == NL80211_BAND_5GHZ ?
+		   B43_AC_CHSPEC_BAND_5G : 0;
+	int center, sb;
+
+	if (b43_modparam_ac_bw80 && band && cd && cd->chan &&
+	    cd->width == NL80211_CHAN_WIDTH_80 &&
+	    cd->chan->hw_value == channel) {
+		center = ieee80211_frequency_to_channel(cd->center_freq1);
+		sb = ((int)channel - center + 6) / 4;
+		if (center > 6 && center < 0xff && sb >= 0 && sb <= 3 &&
+		    (int)channel == center - 6 + 4 * sb)
+			return center | B43_AC_CHSPEC_BW_80 | (sb << 8) | band;
+	}
+	if (b43_modparam_ac_bw40 && band && cd && cd->chan &&
+	    cd->width == NL80211_CHAN_WIDTH_40 &&
+	    cd->chan->hw_value == channel) {
+		center = ieee80211_frequency_to_channel(cd->center_freq1);
+		if (center > 2 && center < 0xff) {
+			if (channel == (unsigned int)center + 2)
+				return center | B43_AC_CHSPEC_BW_40 |
+				       B43_AC_CHSPEC_SB_U | band;
+			if (channel + 2 == (unsigned int)center)
+				return center | B43_AC_CHSPEC_BW_40 | band;
+		}
+	}
+	return (channel & 0xff) | B43_AC_CHSPEC_BW_20 | band;
+}
+
+/*
+ * wl's bandwidth index (0x3e39c..0x3e3b4, 0x17444..0x17468): 0 for 20 MHz,
+ * 1 for 40 MHz, 2 otherwise (80 MHz, the only other width the set takes).
+ */
+static u8 b43_ac_bw_idx(u16 chanspec)
+{
+	switch (chanspec & B43_AC_CHSPEC_BW) {
+	case B43_AC_CHSPEC_BW_20:
+		return 0;
+	case B43_AC_CHSPEC_BW_40:
+		return 1;
+	}
+	return 2;
+}
+
+/*
+ * wlapi_bmac_bw_set @0x17a8c4 (a tail call to wlc_bmac_bw_set @0x15d3d8),
+ * ht40-2069.md: wlc_phy_bw_state_set @0x5544c stores the bandwidth at
+ * [pi,#222]; for a band of PHY type 11 (0x15d3f0..0x15d3f8)
+ * wlc_bmac_bw_reset @0x15d3a0 then replaces the d11 core's IOCTL bits 6..7
+ * (si_core_cflags(sih, 0xc0, bits), 0x15d3c4..0x15d3d4) with
+ * wlc_phy_clk_bwbits @0x53e24 of that state: 0x40 at 20 MHz, 0x80 at 40 MHz,
+ * 0xc0 at 80 MHz (0x53e60..0x53e88, vht80-2069.md). On the AC PHY that is
+ * all: no PHY reset and no wlc_phy_init (popeq at 0x15d41c).
+ */
+static u32 b43_ac2069_clk_bwbits(u16 bw)
+{
+	switch (bw) {
+	case B43_AC_CHSPEC_BW_40:
+		return B43_BCMA_IOCTL_PHY_BW_40MHZ;
+	case B43_AC_CHSPEC_BW_80:
+		return B43_BCMA_IOCTL_PHY_BW_80MHZ;
+	}
+	return B43_BCMA_IOCTL_PHY_BW_20MHZ;
+}
+
+static void b43_ac2069_bmac_bw_set(struct b43_wldev *dev, u16 bw)
+{
+	struct bcma_device *core = dev->dev->bdev;
+	u32 bits = b43_ac2069_clk_bwbits(bw);
+	u32 old, v;
+
+	dev->phy.ac->bw_state = bw;				/* 0x5544c */
+	old = bcma_aread32(core, BCMA_IOCTL);
+	v = (old & ~B43_BCMA_IOCTL_PHY_BW) | bits;		/* 0x15d3c4..0x15d3d4 */
+	bcma_awrite32(core, BCMA_IOCTL, v);
+	b43info(dev->wl, "radio 0x2069: bandwidth state 0x%04x, core IOCTL 0x%08x -> 0x%08x\n",
+		bw, old, v);
+}
+
+/*
+ * acphy_bw40fix 1 (and 2): the bandwidth of the chanspec the init set will
+ * use, from mac80211's chandef as b43_phy_ac_chanspec() reads it (b43_phy_init
+ * points phy->chandef at hw->conf.chandef before op_init, backports
+ * phy_common.c 94), into the state and the core IOCTL before the radio-on;
+ * with bit 2 wl's PHY reset pulse follows, with those bits. Runs where
+ * wlc_phy_init @0x56904..0x56920 runs wlapi_bmac_bw_set.
+ */
+static void b43_ac2069_bw40fix_early(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	const struct cfg80211_chan_def *cd = dev->phy.chandef;
+	unsigned int channel = cd && cd->chan ? cd->chan->hw_value :
+			       dev->phy.channel;
+	u16 chanspec = b43_phy_ac_chanspec(dev, channel);
+	u16 bw = chanspec & B43_AC_CHSPEC_BW;
+
+	if (phy_ac->bw_state == bw) {
+		b43info(dev->wl, "BW40FIX: init at chanspec 0x%04x, bandwidth state 0x%04x already (bit 1 idle)\n",
+			chanspec, bw);
+		return;
+	}
+	b43_ac2069_bmac_bw_set(dev, bw);			/* 0x56920 */
+	if (acphy_bw40fix & B43_AC_BW40FIX_RESET)
+		b43_phy_ac_phy_reset_wl(dev);		/* 0x15e7a4 path */
+	b43info(dev->wl, "BW40FIX: init at chanspec 0x%04x: bandwidth bits set before the radio-on%s (acphy_bw40fix 0x%x)\n",
+		chanspec,
+		(acphy_bw40fix & B43_AC_BW40FIX_RESET) ? ", wl PHY reset pulse" : "",
+		acphy_bw40fix);
+}
+
+/*
+ * Order of the core-level steps around the PHY init, against wl 7.14's
+ * first `up` on this chip (the agcombo ch36 bus capture) and wl.ko 6.37
+ * (ht20-rev42.md, "Init order"). Bitmask; 0 (the default) changes nothing.
+ *  1 (B43_AC_INITORDER_PHYRESET): the PHY reset pulse of every core reset
+ *    after versioning is wl's (b43_phy_ac_phy_reset_wl below, called from
+ *    b43_bcma_phy_reset by patch 99v): force gated clock held during the
+ *    reset, reset released with the PHY clock off, then the clock on.
+ *  2 (B43_AC_INITORDER_MPCLK): core IOCTL MACPHYCLKEN (0x10) set before
+ *    the radio power-on, where wl's bmac init sets it (before wlc_phy_init),
+ *    instead of first at reg_on_reset step 11.
+ *  4 (B43_AC_INITORDER_ONESET): a non-init set to the chanspec the last
+ *    completed set reached returns before any access. wl runs one set per
+ *    `up`; b43's PHY init, op_config and AP start run four or five.
+ */
+unsigned int b43_modparam_ac_initorder;
+module_param_named(acphy_initorder, b43_modparam_ac_initorder, uint, 0444);
+MODULE_PARM_DESC(acphy_initorder,
+	"wl's order around the PHY init, bitmask: 1 wl PHY reset pulse (needs patch 99v), 2 MAC-PHY clock enable before the radio-on, 4 skip repeated sets to the same chanspec (default 0)");
+
+/*
+ * wlc_bmac_phy_reset @0x15cfc4, PHY type 11: si_core_cflags(sih, 0xce,
+ * bwbits | 0xe) (0x15d334..0x15d354) = FGC | PHY_CLKEN | PHY_RESET and the
+ * bandwidth bits in one write, 2 us; then wlc_bmac_core_phy_clk(1)
+ * @0x15cdf4: DAC field 0x100 for core rev > 39 (0x15ce3c..0x15ce48),
+ * cflags(0xe, 0) (0x15ce5c..0x15ce68: FGC, PHY_CLKEN and PHY_RESET cleared
+ * together), 1 us, cflags(4, 4), 1 us. The wl 7.14 bus capture on this
+ * chip shows the same three steps, twice per `up`.
+ * b43_bcma_phy_reset sets PHY_RESET without FGC and releases it with FGC
+ * set and the PHY clock off (b43_phy_take_out_of_reset). The bandwidth
+ * bits follow the state as wl's do (20 MHz after prepare_structs, so the
+ * same as b43's).
+ */
+void b43_phy_ac_phy_reset_wl(struct b43_wldev *dev)
+{
+	struct bcma_device *core = dev->dev->bdev;
+	const u32 m = BCMA_IOCTL_FGC | B43_BCMA_IOCTL_PHY_CLKEN |
+		      B43_BCMA_IOCTL_PHY_RESET;
+	u32 bw = B43_BCMA_IOCTL_PHY_BW_20MHZ;
+	u32 v0, v;
+
+	if (dev->phy.ac)					/* 0x53e60..0x53e88 */
+		bw = b43_ac2069_clk_bwbits(dev->phy.ac->bw_state);
+	v0 = bcma_aread32(core, BCMA_IOCTL);
+	v = (v0 & ~(m | B43_BCMA_IOCTL_PHY_BW)) | m | bw;	/* 0x15d354 */
+	bcma_awrite32(core, BCMA_IOCTL, v);
+	udelay(2);						/* 0x15d35c */
+	v = bcma_aread32(core, BCMA_IOCTL);
+	v = (v & ~B43_BCMA_IOCTL_DAC) | 0x100;			/* 0x15ce48 */
+	bcma_awrite32(core, BCMA_IOCTL, v);
+	v &= ~m;						/* 0x15ce68 */
+	bcma_awrite32(core, BCMA_IOCTL, v);
+	udelay(1);						/* 0x15ce70 */
+	v |= B43_BCMA_IOCTL_PHY_CLKEN;				/* 0x15cea8 */
+	bcma_awrite32(core, BCMA_IOCTL, v);
+	udelay(1);						/* 0x15ceb4 */
+	b43info(dev->wl, "AC-PHY: wl PHY reset (acphy_initorder 1), core IOCTL 0x%08x -> 0x%08x\n",
+		v0, bcma_aread32(core, BCMA_IOCTL));
+}
+
+/*
+ * The R6400 5 GHz board, NVRAM pci/2/1/ (board-settings.md). bcma fills
+ * ssb_sprom from that block, so boardflags, boardflags2, boardflags3,
+ * txchain, rxchain and extpagain5g are checked against the SPROM. femctrl
+ * (3, wl's pi_ac[0x382], attach 0x45f98) and pdgain5g (4, pi_ac[0x475],
+ * attach 0x4622c) are not in ssb_sprom; the code below takes the branches
+ * those values select, and b43_ac2069_chan_check() refuses a board whose
+ * SPROM differs from this one.
+ */
+#define B43_AC2069_BOARD_BFL		0x30000000
+#define B43_AC2069_BOARD_BFL2		0x00300002
+#define B43_AC2069_BOARD_BFL3		0x00000000
+
+static void b43_ac_phy_mod(struct b43_wldev *dev, u16 reg, u16 mask, u16 val)
+{
+	b43_phy_maskset(dev, reg, ~mask, val & mask);
+}
+
+static int b43_ac2069_chan_gap(struct b43_wldev *dev, const char *what)
+{
+	b43err(dev->wl, "radio 0x2069: channel set stops at %s: not decoded, not guessed\n",
+	       what);
+	return -EOPNOTSUPP;
+}
+
+/*
+ * wlc_phy_table_write_acphy @0x2427c over wlc_phy_write_table_ext @0x5454c
+ * (chan-head-2069.md): PHY 0x19e bit 1 set around the access if it was
+ * clear, table id to PHY 0x0d, offset to 0x0e, then per entry width 8/16 to
+ * 0x0f; width 32 high half to 0x10, low half to 0x0f; width 48 word 0 to
+ * 0x11 and words 1 and 2 straight to the PHY data window (phy_reg_write_wide
+ * @0x537b0 writes core +0x3fe without a new address).
+ */
+static void b43_ac_tbl_write_ext(struct b43_wldev *dev, u16 id, u32 len,
+				 u16 offset, u8 width, const void *data)
+{
+	const u16 *w;
+	u32 i, v;
+
+	b43_phy_write(dev, 0x0d, id);				/* 0x54590 */
+	b43_phy_write(dev, 0x0e, offset);			/* 0x545a8 */
+	for (i = 0; i < len; i++) {
+		switch (width) {
+		case 8:						/* 0x546d0 */
+			b43_phy_write(dev, 0x0f, ((const u8 *)data)[i]);
+			break;
+		case 16:					/* 0x546bc */
+			b43_phy_write(dev, 0x0f, ((const u16 *)data)[i]);
+			break;
+		case 32:					/* 0x54698 */
+			v = ((const u32 *)data)[i];
+			b43_phy_write(dev, 0x10, v >> 16);
+			b43_phy_write(dev, 0x0f, v & 0xffff);
+			break;
+		case 48:					/* 0x54634 */
+			w = (const u16 *)data + 3 * i;
+			b43_phy_write(dev, 0x11, w[0]);
+			b43_write16(dev, B43_MMIO_PHY_DATA, w[1]);
+			b43_write16(dev, B43_MMIO_PHY_DATA, w[2]);
+			break;
+		}
+	}
+}
+
+static void b43_ac_tbl_write(struct b43_wldev *dev, u16 id, u32 len,
+			     u16 offset, u8 width, const void *data)
+{
+	bool held = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x2429c */
+
+	if (!held)
+		b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);		/* 0x242b8 */
+	/* 0x242c8..0x24300 */
+	b43_ac_tbl_write_ext(dev, id, len, offset, width, data);
+	if (!held)
+		b43_ac_phy_mod(dev, 0x19e, 0x2, 0);		/* 0x2431c */
+}
+
+/*
+ * wlc_phy_table_read_acphy @0x271d8, width 8: the same bracket, then
+ * wlc_phy_read_table_ext @0x5470c reads PHY 0x0f once per entry
+ * (chan-head-2069.md).
+ */
+static void b43_ac_tbl_read8(struct b43_wldev *dev, u16 id, u32 len,
+			     u16 offset, u8 *out)
+{
+	bool held = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x271f4 */
+	u32 i;
+
+	if (!held)
+		b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);		/* 0x27214 */
+	b43_phy_write(dev, 0x0d, id);				/* 0x54750 */
+	b43_phy_write(dev, 0x0e, offset);			/* 0x54764 */
+	for (i = 0; i < len; i++)
+		out[i] = b43_phy_read(dev, 0x0f);
+	if (!held)
+		b43_ac_phy_mod(dev, 0x19e, 0x2, 0);		/* 0x27278 */
+}
+
+/*
+ * wlc_phy_table_read_acphy @0x271d8, one 48-bit entry: wlc_phy_read_table_ext
+ * reads PHY 0x11, then the data window twice (0x547f0..0x5483c,
+ * chan-head-2069.md), the mirror of the width-48 write.
+ */
+static void b43_ac_tbl_read48(struct b43_wldev *dev, u16 id, u16 offset,
+			      u16 w[3])
+{
+	bool held = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x271f4 */
+
+	if (!held)
+		b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);		/* 0x27214 */
+	b43_phy_write(dev, 0x0d, id);				/* 0x54750 */
+	b43_phy_write(dev, 0x0e, offset);			/* 0x54764 */
+	w[0] = b43_phy_read(dev, 0x11);
+	w[1] = b43_read16(dev, B43_MMIO_PHY_DATA);
+	w[2] = b43_read16(dev, B43_MMIO_PHY_DATA);
+	if (!held)
+		b43_ac_phy_mod(dev, 0x19e, 0x2, 0);		/* 0x27278 */
+}
+
+/* wlc_phy_table_read_acphy @0x271d8, one 16-bit entry (0x54870: read 0x0f) */
+static u16 b43_ac_tbl_read16(struct b43_wldev *dev, u16 id, u16 offset)
+{
+	bool held = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x271f4 */
+	u16 v;
+
+	if (!held)
+		b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);		/* 0x27214 */
+	b43_phy_write(dev, 0x0d, id);				/* 0x54750 */
+	b43_phy_write(dev, 0x0e, offset);			/* 0x54764 */
+	v = b43_phy_read(dev, 0x0f);
+	if (!held)
+		b43_ac_phy_mod(dev, 0x19e, 0x2, 0);		/* 0x27278 */
+	return v;
+}
+
+/*
+ * wlc_phy_table_read_acphy @0x271d8, len entries of 16 bits: one offset
+ * write, then PHY 0x0f once per entry (wlc_phy_read_table_ext @0x5470c).
+ */
+static void b43_ac_tbl_read16n(struct b43_wldev *dev, u16 id, u32 len,
+			       u16 offset, u16 *out)
+{
+	bool held = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x271f4 */
+	u32 i;
+
+	if (!held)
+		b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);		/* 0x27214 */
+	b43_phy_write(dev, 0x0d, id);				/* 0x54750 */
+	b43_phy_write(dev, 0x0e, offset);			/* 0x54764 */
+	for (i = 0; i < len; i++)
+		out[i] = b43_phy_read(dev, 0x0f);
+	if (!held)
+		b43_ac_phy_mod(dev, 0x19e, 0x2, 0);		/* 0x27278 */
+}
+
+static void b43_ac_tbl_write16(struct b43_wldev *dev, u16 id, u16 offset,
+			       u16 val)
+{
+	b43_ac_tbl_write(dev, id, 1, offset, 16, &val);
+}
+
+/*
+ * wlc_phy_resetcca_acphy @0x2a214, PHY rev 1 path 0x2a358..0x2a410
+ * (reset-helpers-rev1.md): force the PHY clock (wlapi_bmac_phyclk_fgc(1) is
+ * si_core_cflags(sih, 0x2, 0x2), BCMA_IOCTL_FGC), PSM_PHY_HDR = CLOCK_EN |
+ * FORCE_CLK, pulse PHY 0x001 bit 14 for 1 us, PSM_PHY_HDR = CLOCK_EN, release
+ * the clock, 2 us. The dsb + outer_cache sync pairs are wmb().
+ */
+static void b43_ac_resetcca(struct b43_wldev *dev)
+{
+	u16 v;
+
+	b43_phy_force_clock(dev, true);				/* 0x2a364 */
+	wmb();							/* 0x2a368 */
+	b43_write16(dev, B43_MMIO_PSM_PHY_HDR,
+		    B43_PSM_HDR_MAC_PHY_CLOCK_EN |
+		    B43_PSM_HDR_MAC_PHY_FORCE_CLK);		/* 0x2a390, 6 */
+	v = b43_phy_read(dev, 0x001);				/* 0x2a398 */
+	b43_phy_write(dev, 0x001, v | 0x4000);			/* 0x2a3b0 */
+	udelay(1);						/* 0x2a3b8 */
+	b43_phy_write(dev, 0x001, v & 0xbfff);			/* 0x2a3cc */
+	wmb();							/* 0x2a3d0 */
+	b43_write16(dev, B43_MMIO_PSM_PHY_HDR,
+		    B43_PSM_HDR_MAC_PHY_CLOCK_EN);		/* 0x2a3f8, 2 */
+	b43_phy_force_clock(dev, false);			/* 0x2a404 */
+	udelay(2);						/* 0x2a410 */
+}
+
+/*
+ * wlc_phy_stay_in_carriersearch_acphy(pi, 1) @0x2e44c, chan-head-2069.md.
+ * The release, (pi, 0), is b43_ac_carriersearch_exit() below.
+ */
+static const u16 b43_ac_ofdm_crs_regs[] = { 0x2ed, 0x2f1, 0x2f5, 0x2f9 };
+
+static void b43_ac_carriersearch_enter(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	const u16 *crs = b43_ac_ofdm_crs_regs;
+	unsigned int i;
+	u8 core;
+
+	if (phy_ac->cs_count == 0) {				/* 0x2e464 */
+		/* wlc_phy_classifier_acphy(pi, 7, 4) @0x2db00 */
+		b43_ac_phy_mod(dev, 0x140, 0x7, 0x4);
+		/* wlc_phy_ofdm_crs_acphy(pi, 0) @0x2e3a0, 0x2e3fc..0x2e448 */
+		for (i = 0; i < ARRAY_SIZE(b43_ac_ofdm_crs_regs); i++)
+			b43_ac_phy_mod(dev, crs[i], 0x10, 0);
+		/* wlc_phy_clip_det_acphy(pi, 0) @0x1e20c: set bit 14, 0x1e330 */
+		for (core = 0; core < phy_ac->ncores; core++)
+			b43_phy_set(dev, 0x6d4 + (core << 9), 0x4000);
+		b43_phy_write(dev, 0x339, 0);			/* 0x2e49c */
+	}
+	phy_ac->cs_count++;					/* 0x2e4ac */
+	b43_ac_resetcca(dev);					/* 0x2e4b4 */
+}
+
+/*
+ * wlc_phy_stay_in_carriersearch_acphy(pi, 0) @0x2e44c, the release side
+ * (chan-head-2069.md, 0x2e4b8..0x2e510): the count goes down; at zero the
+ * classifier goes back to 6 on 5 GHz (7 on 2 GHz), OFDM CRS and clip
+ * detect come back on and PHY 0x339 gets pi_ac[0x9b0], which
+ * wlc_phy_attach_acphy sets to 0x0fff (0x45dcc..0x45dd8). No resetcca on
+ * this side.
+ */
+static void b43_ac_carriersearch_exit(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	unsigned int i;
+	u8 core;
+
+	phy_ac->cs_count--;
+	if (phy_ac->cs_count)
+		return;
+	/* wlc_phy_classifier_acphy(pi, 7, 6) @0x2db00, 5 GHz */
+	b43_ac_phy_mod(dev, 0x140, 0x7, 0x6);
+	/* wlc_phy_ofdm_crs_acphy(pi, 1) @0x2e3a0 */
+	for (i = 0; i < ARRAY_SIZE(b43_ac_ofdm_crs_regs); i++)
+		b43_ac_phy_mod(dev, b43_ac_ofdm_crs_regs[i], 0x10, 0x10);
+	/* wlc_phy_clip_det_acphy(pi, 1) @0x1e20c: clear bit 14, 0x1e2d4 */
+	for (core = 0; core < phy_ac->ncores; core++)
+		b43_phy_mask(dev, 0x6d4 + (core << 9), 0xbfff);
+	b43_phy_write(dev, 0x339, 0x0fff);
+}
+
+/*
+ * Analog LPF and DAC buffer fields in ACPHY table 7, rccal-readers.md.
+ * A negative argument leaves its field alone. Cores below ncores whose bit
+ * is set in sh+147 (rxchain, chan-head-2069.md); core -1 means all. Each
+ * function holds PHY 0x19e bit 1 set and restores it at the end.
+ */
+static void b43_ac_analog_tx_lpf(struct b43_wldev *dev, u16 modes, int a2,
+				 int a3, int s0, int s1, int s2, int core)
+{
+	/* .rodata 0x5a578 / 0x5a580 (C.3455 / C.3456) */
+	static const u16 lo[3] = { 0x142, 0x152, 0x162 };
+	static const u16 hi[3] = { 0x362, 0x372, 0x382 };
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 saved = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x2ba70 */
+	unsigned int m;
+	u32 v;
+	u8 c;
+
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x2ba8c */
+	for (c = 0; c < phy_ac->ncores; c++) {
+		if (!(phy_ac->coremask & BIT(c)) || (core != -1 && core != c))
+			continue;				/* 0x2bac0..0x2bae4 */
+		for (m = 0; m < 9; m++) {
+			if (!(modes & BIT(m)))
+				continue;
+			v = b43_ac_tbl_read16(dev, 7, lo[c] + m) |
+			    (u32)b43_ac_tbl_read16(dev, 7, hi[c] + m) << 16;
+			if (a2 >= 0)				/* 0x2bb68 */
+				v = (v & ~0xfe000007) | a2;
+			if (s0 >= 0)				/* 0x2bb78 */
+				v = (v & ~0xfe000038) | (u32)s0 << 3;
+			if (a3 >= 0)				/* 0x2bb90 */
+				v = (v & ~0xfe0001c0) | (u32)a3 << 6;
+			if (s1 >= 0)				/* 0x2bba4 */
+				v = (v & 0x01fe01ff) | (u32)s1 << 9;
+			if (s2 >= 0)				/* 0x2bbcc */
+				v = (v & 0x0001ffff) | (u32)s2 << 17;
+			b43_ac_tbl_write16(dev, 7, lo[c] + m, v & 0xffff);
+			b43_ac_tbl_write16(dev, 7, hi[c] + m, (v >> 16) & 0x1ff);
+		}
+	}
+	b43_ac_phy_mod(dev, 0x19e, 0x2, saved);			/* 0x2bc54 */
+}
+
+static void b43_ac_analog_rx_lpf(struct b43_wldev *dev, u16 modes, int a2,
+				 int a3, int s0, int s1, int s2, int core)
+{
+	/* .rodata 0x5a590..0x5a5b8, mode 0, 1, 2 */
+	static const u16 lo[3][3] = {
+		{ 0x140, 0x150, 0x160 }, { 0x141, 0x151, 0x161 },
+		{ 0x441, 0x443, 0x445 },
+	};
+	static const u16 hi[3][3] = {
+		{ 0x360, 0x370, 0x380 }, { 0x361, 0x371, 0x381 },
+		{ 0x440, 0x442, 0x444 },
+	};
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 saved = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x2d0b4 */
+	unsigned int m;
+	u32 v;
+	u8 c;
+
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x2d0d0 */
+	for (c = 0; c < phy_ac->ncores; c++) {
+		if (!(phy_ac->coremask & BIT(c)) || (core != -1 && core != c))
+			continue;				/* 0x2d108..0x2d12c */
+		for (m = 0; m < 3; m++) {
+			if (!(modes & BIT(m)))
+				continue;
+			v = b43_ac_tbl_read16(dev, 7, lo[m][c]) |
+			    (u32)b43_ac_tbl_read16(dev, 7, hi[m][c]) << 16;
+			if (a2 >= 0)				/* 0x2d1d0 */
+				v = (v & ~0xfe000007) | a2;
+			if (a3 >= 0)				/* 0x2d1e4 */
+				v = (v & ~0xfe000038) | (u32)a3 << 3;
+			if (s1 >= 0)				/* 0x2d200 */
+				v = (v & ~0xfe003fc0) | (u32)s1 << 6;
+			if (s0 >= 0)				/* 0x2d214 */
+				v = (v & ~0xfe01c000) | (u32)s0 << 14;
+			if (s2 >= 0)				/* 0x2d230 */
+				v = (v & 0x0001ffff) | (u32)s2 << 17;
+			b43_ac_tbl_write16(dev, 7, lo[m][c], v & 0xffff);
+			b43_ac_tbl_write16(dev, 7, hi[m][c], (v >> 16) & 0x1ff);
+		}
+	}
+	b43_ac_phy_mod(dev, 0x19e, 0x2, saved);			/* 0x2d2b4 */
+}
+
+static void b43_ac_tx_dacbuf_cap(struct b43_wldev *dev, u16 modes, int cap,
+				 int a3, int core)
+{
+	/* .rodata 0x5a5c0 (base), 0x5a5c8 (idx), 0x5a5d4 (shift) */
+	static const u16 base[3] = { 0x3f0, 0x060, 0x0d0 };
+	static const u8 idx[9] = { 11, 11, 12, 12, 14, 14, 15, 15, 10 };
+	static const u8 shift[9] = { 0, 6, 0, 6, 0, 6, 0, 6, 0 };
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 saved = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x2d328 */
+	unsigned int m;
+	u16 v, f, off;
+	u8 c;
+
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x2d344 */
+	for (c = 0; c < phy_ac->ncores; c++) {
+		if (!(phy_ac->coremask & BIT(c)) || (core != -1 && core != c))
+			continue;				/* 0x2d358..0x2d37c */
+		for (m = 0; m < 9; m++) {
+			if (!(modes & BIT(m)))
+				continue;
+			off = base[c] + idx[m];
+			v = b43_ac_tbl_read16(dev, 7, off);	/* 0x2d3d8 */
+			f = (v >> shift[m]) & 0x3f;		/* 0x2d3f8 */
+			if (cap >= 0)				/* 0x2d404 */
+				f = (f & 0x20) | cap;
+			if (a3 >= 0)				/* 0x2d41c */
+				f = (u16)(a3 << 5) | (f & 0x1f);
+			if (shift[m])				/* 0x2d430..0x2d440 */
+				v = (v & 0x3f) | (f << 6);
+			else
+				v = (v & 0xfc0) | f;
+			b43_ac_tbl_write16(dev, 7, off, v);	/* 0x2d450 */
+		}
+	}
+	b43_ac_phy_mod(dev, 0x19e, 0x2, saved);			/* 0x2d48c */
+}
