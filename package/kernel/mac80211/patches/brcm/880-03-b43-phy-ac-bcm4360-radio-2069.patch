+/*
+ * prefregs_2069_rev3/rev4/rev18, wl.ko .data symbol values 0x687e0 (92
+ * bytes), 0x6883c (100) and 0x689c0 (140). prefregs-2069.md: (reg, value)
+ * u16 pairs ending in a (0xffff, 0) sentinel that
+ * wlc_phy_init_radio_prefregs_allbands @0x54bc0 never writes; .rel.data has
+ * no relocation in 0x687e0..0x68cb0. Sentinels dropped here; written in
+ * order with write_radio_reg by b43_phy_ac_prefregs() above.
+ */
+static const u16 b43_ac2069_prefregs_rev3[] = {
+	0x063a, 0x0000, 0x063d, 0x000f, 0x0645, 0x3000, 0x0646, 0x0303,
+	0x0647, 0x36e2, 0x0649, 0x6000, 0x064a, 0x0003, 0x0665, 0xff02,
+	0x0666, 0x0b2d, 0x066f, 0xff08, 0x0115, 0x7737, 0x0117, 0x06ff,
+	0x0718, 0x7777, 0x071c, 0x1000, 0x0726, 0x0100, 0x0727, 0x0002,
+	0x0407, 0x8382, 0x0885, 0x0700, 0x08e9, 0x01ce, 0x08ea, 0x00ff,
+	0x08ec, 0x06ff, 0x0972, 0x0600,
+};	/* 22 pairs */
+
+static const u16 b43_ac2069_prefregs_rev4[] = {
+	0x063a, 0x0000, 0x063d, 0x000f, 0x0645, 0x3000, 0x0646, 0x0303,
+	0x0647, 0x36e2, 0x0649, 0x6000, 0x064a, 0x0003, 0x065e, 0x0ff4,
+	0x0666, 0x0b2d, 0x0667, 0x03ff, 0x0115, 0x3337, 0x0117, 0x1337,
+	0x0718, 0x7777, 0x071c, 0x1000, 0x0726, 0x0100, 0x0727, 0x0002,
+	0x0761, 0x0100, 0x0407, 0x8382, 0x055e, 0x0020, 0x0885, 0x0700,
+	0x08e9, 0x01ce, 0x08ea, 0x00ff, 0x08ec, 0x06ff, 0x0972, 0x0600,
