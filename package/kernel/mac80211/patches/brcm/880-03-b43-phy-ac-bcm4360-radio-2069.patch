+/*
+ * RX gain control, rxgain-2069.md and rxgain-encode-2069.md, PHY rev 1,
+ * chip 0x4360, 5 GHz. Checked against full_disasm.txt where the notes are
+ * outlines; the addresses cite the instructions. Sign handling follows the
+ * loads wl uses (ldrsb for gains read as s8, ldrb where it reads u8).
+ */
+
+/*
+ * NVRAM pci/2/1/rxgains5g{,h}{elnagaina,trisoa,trelnabypa}0..2
+ * (board-settings.md), the raw values wlc_phy_attach_acphy turns into
+ * pi_ac bytes (rxgain-2069.md, 0x46450..). [0] is the 5g slot (channel
+ * <= 99), [1] the 5gh slot (0x27cd8..0x27ce8). Not in ssb_sprom, so
+ * b43_ac2069_chan_check() pins the board instead.
+ */
+static const struct {
+	u8 elnagaina[3];
+	u8 trisoa[3];
+	u8 trelnabypa[3];
+} b43_ac2069_board_rxgains[2] = {
+	{ { 1, 1, 1 }, { 7, 6, 5 }, { 1, 1, 1 } },
+	{ { 2, 2, 3 }, { 5, 4, 4 }, { 1, 1, 1 } },
+};
+
+/*
+ * wlc_phy_rxgainctrl_encode_gain_acphy.clone.4 @0x2010c (rxgain-encode-2069.md,
+ * checked at 0x2010c..0x203a0): greedy, stage by stage, under the
+ * per-stage cumulative limits. Returns the gain reached, as u8.
+ */
+static u8 b43_ac_encode_gain(struct b43_phy_ac *a, u8 c, u8 target, bool e,
+			     bool t, u8 out[6])
+{
+	u8 lim[6], base[6], n, s, k;
+	u16 rem, total = 0, o, sum, v;
+	s8 budget, g;
+	int i;
+
+	if (t)						/* 0x20120..0x20178 */
+		o = (u16)(a->rx_triso[c] + a->rx_gain[c][1][0] -
+			  a->rx_gain[c][1][5]);
+	else if (e)					/* 0x2019c..0x201bc */
+		o = a->rx_triso[c];
+	else						/* 0x201c4..0x201d4 */
+		o = 0;
+	for (s = 0; s < 6; s++)
+		lim[s] = (u8)(a->rx_limit[s] + o);
+	rem = (u16)(o + target);			/* 0x201d8 */
+	for (s = 0; s < 6; s++)				/* 0x201fc..0x20208 */
+		base[s] = (u8)a->rx_gain[c][s][0];
+
+	for (s = 0; s < 6; s++) {			/* 0x20284..0x20390 */
+		sum = 0;
+		for (k = s + 1; k < 6; k++)		/* 0x20298..0x202b8, u8 sum */
+			sum += base[k];
+		budget = (s8)(u8)(rem - sum);		/* 0x202c0..0x20300 */
+		n = a->rx_count[s];
+		if (t && s == 1)			/* 0x202f0..0x202fc */
+			n = 1;
+		for (i = n - 1; i >= 0; i--) {		/* 0x20304..0x20388 */
+			g = a->rx_gain[c][s][i];
+			v = (u16)((u16)g + total);
+			if (a->rx_gainbits[c][s][0] == a->rx_gainbits[c][s][i] ||
+			    (g <= budget && (s16)v <= lim[s])) {
+				out[s] = a->rx_gainbits[c][s][i]; /* 0x20370 */
+				rem = (u16)(rem - (u16)g);
+				total = v;
+				break;
+			}
+		}
+		if (s == 3) {				/* 0x20254..0x2027c */
+			if (rem % 3 == 2)
+				rem++;
+			if (rem >= 30)
+				rem = 30;
+		}
+	}
+	return (u8)(total - o);				/* 0x20394 */
+}
+
+/*
+ * wlc_phy_rxgainctrl_set_init_clip_gain_acphy(pi, type, target, e, t, c)
+ * @0x24580: encode the target and write the init (0), hi (1), md (2),
+ * clip 2 (3) or lo (4) gain registers of core c.
+ */
+static u8 b43_ac_set_init_clip_gain(struct b43_wldev *dev, u8 type, u8 target,
+				    bool e, bool t, u8 c)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	static const u16 reg[5] = { 0x6dc, 0x6de, 0x6e0, 0x6e2, 0x6e4 };
+	u16 r = c << 9, v1, v2;
+	bool byp = a->rx_lna1byp[c] != 0;		/* 0x245d0..0x245dc */
+	bool p, q;
+	u8 out[6] = { }, g;
+
+	g = b43_ac_encode_gain(a, c, target, e, t, out); /* 0x245b0 */
+	p = !byp && e;					/* 0x245e0..0x24600 */
+	q = !p;
+	v1 = out[3] << 7 | out[2] << 4 | out[1] << 1;	/* 0x24608..0x2461c */
+	v2 = out[5] << 8 | out[4] << 4 | p << 3 | q << 2; /* 0x24604..0x24620 */
+	b43_phy_write(dev, reg[type] + r, v1);
+	b43_phy_write(dev, reg[type] + 1 + r, v2);
+	if (type == 0)					/* 0x24694..0x246a0 */
+		b43_ac_tbl_write16(dev, 7, 0xf9 + c,
+				   out[1] | out[2] << 3 | out[3] << 6 |
+				   out[4] << 10 | out[5] << 13);
+	/* 0x24760..0x24828: bit 1 of the clip-2 second register */
+	b43_ac_phy_mod(dev, 0x6e3 + r, 0x2, byp ? 0x2 : 0);
+	return g;
+}
+
+/*
+ * wlc_phy_rxgainctrl_calc_low_sens_acphy(pi, g, e, c) @0x17410, 20, 40
+ * or 80 MHz: C.164 / C.165 indexed by the bandwidth (0x17434..0x17474,
+ * ht40-2069.md; index 2 = 80 MHz, -60 / 19)
+ */
+static s8 b43_ac_calc_low_sens(struct b43_wldev *dev, u8 g, bool e, u8 c)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	u8 bw = b43_ac_bw_idx(a->chanspec);
+	/* C.164 / C.165, .rodata 0x59570 / 0x5957c, [bw] */
+	s32 s = b43_ac_low_sens_base[bw];
+	u8 e0 = b43_phy_read(dev, 0x6dc + (c << 9)) & 1;	/* 0x1748c */
+	s8 lo;
+
+	if (e)						/* 0x17504..0x17508 */
+		s = s + a->rx_triso[c] -
+		    (u8)a->rx_gain[c][0][e0] * a->rx_trelnabyp[c];
+	lo = (s8)(u8)-(g + b43_ac_low_sens_floor[bw]);	/* 0x1750c..0x17524 */
+	s = (s8)(u8)((u8)s + a->desense_total[8]);	/* 0x17518..0x17528 */
+	return s < lo ? lo : s;
+}
+
+/* wlc_phy_rxgainctrl_calc_high_sens_acphy(pi, g, e, c) @0x17540 */
+static s8 b43_ac_calc_high_sens(struct b43_wldev *dev, u8 g, bool e, u8 c)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	u8 e0 = b43_phy_read(dev, 0x6dc + (c << 9)) & 1;	/* 0x17568 */
+	s8 hi = (s8)(23 - g);				/* 0x175bc..0x175c4 */
+	s8 v;
+
+	v = (s8)(u8)((e ? a->rx_triso[c] - 16 : -16) -
+		     (u8)a->rx_gain[c][0][e0]);		/* 0x175cc..0x175e0 */
+	return v < hi ? v : hi;
+}
+
+/*
+ * wlc_phy_rxgainctrl_nbclip_acphy(pi, c, nb) @0x19520, checked at
+ * 0x19520..0x19b4c. Levels T[k] = C.178[k] - 40 (.rodata 0x59698).
+ */
+static void b43_ac_nbclip(struct b43_wldev *dev, u8 c, s8 nb)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	static const u8 c178[8] = { 0, 35, 60, 80, 95, 120, 140, 156 };
+	/* C.179 (.rodata 0x596a0): low low mid mid mid mid high high */
+	static const u8 c179[8] = { 0, 0, 1, 1, 1, 1, 2, 2 };
+	static const u8 c180[8] = { 0, 0, 1, 1, 1, 1, 2, 2 };	/* 0x596c0 */
+	static const u8 c181[8] = { 1, 0, 1, 2, 0, 3, 1, 0 };	/* 0x596c8 */
+	u16 r = c << 9, v;
+	u8 idx[5], b0, b1, k;
+	int x, sum = nb, t;
+	unsigned int i;
+	bool found;
+
+	v = b43_phy_read(dev, 0x6dc + r);			/* 0x195bc */
+	idx[0] = v & 0x1;				/* e0 */
+	idx[1] = (v & 0xe) >> 1;			/* l1, 0x19654 */
+	idx[2] = (v & 0x70) >> 4;			/* l2, 0x196a8 */
+	idx[3] = (v & 0x780) >> 7;			/* m, 0x19700 */
+	b0 = (b43_phy_read(dev, 0x6dd + r) & 0x70) >> 4;	/* 0x19714..0x19768 */
+	b1 = (b43_phy_read(dev, 0x6dd + r) & 0x700) >> 8;	/* 0x19774..0x197d0 */
+	idx[4] = b0;
+	for (i = 0; i < 5; i++)				/* 0x197e0..0x1980c */
+		sum += a->rx_gain[c][i][idx[i]];
+	if (a->rx_max_lna == 1)				/* 0x19810..0x19820 */
+		sum -= a->rx_triso[c];
+	x = 10 * sum;					/* 0x19828 */
+
+	if (x < (int)c178[0] - 40) {			/* 0x19830 */
+		k = 0;
+	} else if (x <= (int)c178[7] - 40) {		/* 0x19844, 0x19928..0x1997c */
+		found = false;
+		for (k = 0; k < 7; k++) {
+			t = (int)c178[k] - 40;
+			if (x <= (int)c178[k + 1] - 40 && x >= t) {
+				if (abs(x - t) >= (int)c178[k + 1] - 40 - x)
+					k++;
+				found = true;
+				break;
+			}
+		}
+		if (!found)
+			k = 0;				/* 0x1997c: none brackets x */
+	} else {
+		/* 0x1984c..0x19920: move a step from BIQ0 to BIQ1 */
+		if (x - ((int)c178[7] - 40) > 20 && b0 != 0 && b1 <= 6) {
+			b43_ac_phy_mod(dev, 0x6dd + r, 0x70, (b0 - 1) << 4);
+			b43_ac_phy_mod(dev, 0x6dd + r, 0x700, (b1 + 1) << 8);
+		}
+		k = 7;					/* 0x19984 */
+	}
+	b43_ac_phy_mod(dev, 0x6ee + r, 0x3, c180[k]);	/* 0x199e8 */
+	/* 0x199f0..0x19b4c: radio 0x45 for chip 0x4360, by C.179[k] */
+	if (c179[k] == 0)
+		b43_ac2069_mod(dev, 0x45 | r, 0x80, c181[k] << 7);
+	else if (c179[k] == 1)
+		b43_ac2069_mod(dev, 0x45 | r, 0x300, c181[k] << 8);
+	else
+		b43_ac2069_mod(dev, 0x45 | r, 0x40, c181[k] << 6);
+}
+
+/*
+ * wlc_phy_rxgainctrl_w1clip_acphy(pi, c, w1) @0x19118, checked at
+ * 0x19118..0x1942c, 5 GHz. Levels L0 = C.244 - 340, L1 = C.244 - 280,
+ * L2 = C.246 - 220 (.rodata 0x59674, 0x5968c).
+ */
+static void b43_ac_w1clip(struct b43_wldev *dev, u8 c, s8 w1)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	static const u8 c244[12] = { 0, 19, 35, 49, 60, 70, 80, 88, 95, 102, 109, 115 };
+	static const u8 c246[12] = { 0, 19, 35, 49, 60, 70, 80, 96, 113, 130, 155, 180 };
+	int lv[3][12], x, s;
+	u16 r = c << 9;
+	u8 l1, rr, k;
+
+	for (k = 0; k < 12; k++) {			/* 0x19174..0x191b0 */
+		lv[0][k] = c244[k] - 340;
+		lv[1][k] = c244[k] - 280;
+		lv[2][k] = c246[k] - 220;
+	}
+	l1 = (b43_phy_read(dev, 0x6dc + r) & 0xe) >> 1;	/* 0x191d8..0x19228 */
+	s = w1 + (u8)a->rx_gain[c][0][0] -
+	    (a->rx_gain[c][1][5] - a->rx_gain[c][1][l1]);	/* 0x19230..0x19258 */
+	if (a->rx_max_lna == 1)				/* 0x1925c..0x1926c */
+		s -= a->rx_triso[c];
+	x = 10 * s;					/* 0x19274 */
+
+	if (x <= lv[0][0]) {				/* 0x19278 */
+		rr = 0;
+		k = 0;
+	} else if (x >= lv[2][11]) {			/* 0x1928c */
+		rr = 2;
+		k = 11;
+	} else {
+		if (x > lv[1][11])			/* 0x192a0 */
+			rr = 2;
+		else if (x < lv[1][0])			/* 0x192b4 */
+			rr = 0;
+		else
+			rr = 1;
+		for (k = 0; k < 11; k++) {		/* 0x192cc..0x1931c */
+			if (x <= lv[rr][k + 1] && x >= lv[rr][k]) {
+				if (lv[rr][k + 1] - x <= abs(x - lv[rr][k]))
+					k++;
+				break;
+			}
+		}
+	}
+	b43_ac_phy_mod(dev, 0x6ee + r, 0xc, rr << 2);	/* 0x1937c */
+	b43_ac2069_mod(dev, 0x33 | r, 0xf0, (k << 4) + 0x40); /* 0x1942c */
+}
+
+/*
+ * wlc_phy_rxgainctrl_set_gaintbls_acphy.clone.22(pi, init, band_chg)
+ * @0x27bd0, 5 GHz, PHY rev 1, chip 0x4360. rxgain-2069.md is an outline;
+ * this follows 0x27bd0..0x28550, which also clears PHY 0x73e bits
+ * 0x4c0 per core, gates the stage 3 writes on init or band_chg, and
+ * reads the tables back only on init (chan-common-2069.md step 7).
+ */
+static void b43_ac2069_set_gaintbls(struct b43_wldev *dev, bool init,
+				    bool band_chg)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	const struct ssb_sprom *sprom = dev->dev->bus_sprom;
+	static const u8 gtbl[3] = { 0x44, 0x64, 0x84 };	/* 0x27c64..0x27c84 */
+	static const u8 btbl[3] = { 0x45, 0x65, 0x85 };
+	u16 saved19e, saved16c, reg;
+	u8 stage0[2], slot, g, c;
+
+	saved19e = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x27bfc */
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x27c18 */
+	saved16c = b43_phy_read(dev, 0x16c);			/* 0x27c24 */
+	b43_ac_phy_mod(dev, 0x16c, 0x40, 0x40);			/* 0x27c3c */
+	b43_ac2069_upd_lna1_lna2_gains(dev);			/* 0x27c44 */
+
+	for (c = 0; c < a->ncores; c++) {			/* 0x28518, every core */
+		/* 0x27cd8..0x27d24: 5g slot for channel <= 99, else 5gh */
+		slot = (a->chanspec & 0xff) <= 99 ? 0 : 1;
+		a->rx_elna[c] = (b43_ac2069_board_rxgains[slot].elnagaina[c] + 3) * 2;
+		a->rx_triso[c] = (b43_ac2069_board_rxgains[slot].trisoa[c] + 4) * 2;
+		a->rx_trelnabyp[c] = b43_ac2069_board_rxgains[slot].trelnabypa[c];
+		a->rx_lna1byp[c] = sprom->boardflags2 >> 31;	/* 0x27d1c..0x27d24 */
+		g = a->rx_triso[c] + 2;				/* 0x27d94, rev <= 1 */
+		/* pi_ac[0x9be] is 1 on PHY rev <= 1: 0x27da8..0x27dd4 */
+		reg = 0x73e + (c << 9);
+		b43_phy_write(dev, reg, b43_phy_read(dev, reg) & ~0x4c0);
+		/* 0x27df0..0x27f40: 0x6f9, 0x8f9, 0xaf9 */
+		reg = 0x6f9 + (c << 9);
+		b43_ac_phy_mod(dev, reg, 0x7f00, (g << 8) & 0xff00);
+		b43_ac_phy_mod(dev, reg, 0x7f, 2);
+		/* stage 0, 0x27f44..0x27f88: both entries the eLNA gain */
+		stage0[0] = stage0[1] = a->rx_elna[c];
+		b43_ac_tbl_write(dev, gtbl[c], 2, 0, 8, stage0);
+		memcpy(a->rx_gain[c][0], stage0, a->rx_count[0]);
+		if (!init && !band_chg)				/* 0x27f8c..0x27fa0 */
+			continue;
+		/*
+		 * Stage 3, 5 GHz (0x282a4..0x28420), eLNA on 5 GHz (pi_ac[0x381],
+		 * boardflags bit 28): C.145 gain and C.146 bits.
+		 */
+		b43_phy_write(dev, 0x173b, 0x2c);		/* 0x2836c */
+		b43_phy_write(dev, 0x1726, 0x0c);		/* 0x283c8 */
+		b43_ac_tbl_write(dev, gtbl[c], 10, 32, 8,
+				 b43_ac_stage3_5g_elna_gain);	/* 0x283ec */
+		b43_ac_tbl_write(dev, btbl[c], 10, 32, 8,
+				 b43_ac_stage3_5g_elna_bits);	/* 0x28410 */
+		memcpy(a->rx_gain[c][3], b43_ac_stage3_5g_elna_gain,
+		       a->rx_count[3]);				/* 0x28420 */
+		if (!init)					/* 0x28424..0x2842c */
+			continue;
+		/* 0x28430..0x2850c: read back */
+		b43_ac_tbl_read8(dev, btbl[c], 1, 0, &a->rx_gainbits[c][0][0]);
+		b43_ac_tbl_read8(dev, btbl[c], 10, 32, a->rx_gainbits[c][3]);
+		b43_ac_tbl_read8(dev, gtbl[c], 8, 96, (u8 *)a->rx_gain[c][4]);
+		b43_ac_tbl_read8(dev, gtbl[c], 8, 112, (u8 *)a->rx_gain[c][5]);
+		b43_ac_tbl_read8(dev, btbl[c], 8, 96, a->rx_gainbits[c][4]);
+		b43_ac_tbl_read8(dev, btbl[c], 8, 112, a->rx_gainbits[c][5]);
+	}
+	b43_phy_write(dev, 0x16c, saved16c);			/* 0x28530 */
+	b43_ac_phy_mod(dev, 0x19e, 0x2, saved19e);		/* 0x28548 */
+}
+
+/*
+ * wlc_phy_rxgainctrl_gainctrl_acphy(pi) @0x24838, 5 GHz, 20 or 40 MHz,
+ * checked at 0x24838..0x24bd4. The hi-RSSI eLNA bypass flag (pi_ac[0x9bd])
+ * is 0 from attach (chan-common-2069.md step 5).
+ */
+static void b43_ac2069_gainctrl(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	const struct ssb_sprom *sprom = dev->dev->bus_sprom;
+	/* C.154, .rodata 0x59964 (0x248d8..0x248e4) */
+	static const u8 lim5g[6] = { 47, 47, 47, 52, 52, 100 };
+	const bool h = false;
+	bool elna, e_hi, e_md, t;
+	u8 max_lna, r6, lo, clip2, hi_g, md_g, c2_g, nb, w1, c;
+	s8 sa, sb, sk, sd;
+
+	memcpy(a->rx_limit, lim5g, sizeof(lim5g));
+	/* pi_ac[0x381]: eLNA on 5 GHz, boardflags bit 28 (rxgain-2069.md) */
+	elna = !!(sprom->boardflags & BIT(28));		/* 0x248e8 */
+	max_lna = a->desense_total[7];		/* get_max_lna_index(pi, 0), 0x248f4 */
+	a->rx_max_lna = max_lna;			/* 0x248f8 */
+	e_hi = (max_lna & elna) != 0;			/* 0x248fc */
+	e_md = ((max_lna | 1) & elna) != 0;		/* 0x24910 */
+	r6 = h ? 15 : 20;				/* 0x24920..0x24958 */
+	if (!elna)
+		lo = e_md ? r6 : (u8)((r6 + 35) >> 1);
+	else if (e_md)
+		lo = r6;
+	else {
+		r6 = 30;				/* 0x2495c */
+		lo = (u8)((r6 + 35) >> 1);
+	}
+	clip2 = r6;					/* 0x24994 */
+
+	for (c = 0; c < a->ncores; c++) {		/* 0x24bc4, every core */
+		t = a->rx_lna1byp[c] != 0;		/* 0x249a4..0x249c0 */
+		if (t)
+			clip2 = 15;			/* 0x249c8, kept for later cores */
+		b43_phy_read(dev, 0x6dc + (c << 9));	/* 0x249cc, unused */
+		b43_ac_set_init_clip_gain(dev, 0, 69, e_hi, false, c);	/* 0x249e8 */
+		hi_g = b43_ac_set_init_clip_gain(dev, 1, 48, e_hi, false, c); /* 0x24a04 */
+		md_g = b43_ac_set_init_clip_gain(dev, 2, 35, e_md, false, c); /* 0x24a24 */
+		b43_ac_set_init_clip_gain(dev, 4, lo, e_md, false, c);	/* 0x24a44 */
+		c2_g = b43_ac_set_init_clip_gain(dev, 3, clip2, true, t, c); /* 0x24a60 */
+		sa = b43_ac_calc_low_sens(dev, md_g, e_md, c);	/* 0x24a78 */
+		sb = b43_ac_calc_high_sens(dev, hi_g, e_hi, c);	/* 0x24a94 */
+		sk = b43_ac_calc_low_sens(dev, c2_g, true, c);	/* 0x24ab0 */
+		sd = b43_ac_calc_high_sens(dev, md_g, e_md, c);	/* 0x24ac8 */
+		if (b43_ac_bw_idx(a->chanspec) == 0) {
+			/* 20 MHz: 0x24ae8..0x24af4 and, with h clear, 0x24b58..0x24b6c */
+			nb = (u8)((sa + sb) >> 1);
+			w1 = (u8)((sk + sd) >> 1);
+		} else {
+			/*
+			 * 40 and 80 MHz (ht40-2069.md; 0x24ae8 tests 20 MHz
+			 * only): weights ip = -26, fp = -39 (0x2498c..0x24990),
+			 * arithmetic shift by 6, negated, low byte. nb at
+			 * 0x24afc..0x24b14; PHY rev 1 is not 6 (0x24b08), so
+			 * w1 at 0x24b78..0x24b90 whatever h is.
+			 */
+			nb = (u8)-((-26 * sa - 39 * sb) >> 6);
+			w1 = (u8)-((-26 * sk - 39 * sd) >> 6);
+		}
+		b43_ac_nbclip(dev, c, (s8)nb);		/* 0x24ba4 */
+		b43_ac_w1clip(dev, c, (s8)w1);		/* 0x24bbc */
+	}
+}
+
+/*
+ * Per-core ADC calibration-like block, chan-common-2069.md step 8a
+ * (0x4c684..0x4cad4; the name is a guess). Every 2069 rev. The done poll
+ * is bounded as wl's (10 x 10 us) and logged on timeout, which wl does not.
+ */
+static void b43_ac2069_adc_cal(struct b43_wldev *dev, struct b43_ac2069 *ch)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 sa, sb, sc, x, s1, s2, r, p;
+	unsigned int n;
+	bool done;
+	u8 c;
+
+	b43_ac2069_mod(dev, 0x8ea, 0x80, 0x80);			/* 0x4c6d8 */
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x4c6f4..0x4ca7c */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		r = c << 9;
+		p = c * 0x200;
+		sa = b43_phy_read(dev, 0x739 + p);		/* 1, 0x4c73c */
+		sb = b43_phy_read(dev, 0x73a + p);		/* 0x4c750 */
+		sc = b43_phy_read(dev, 0x725 + p);		/* 0x4c764 */
+		b43_ac_phy_mod(dev, 0x739 + p, 0x80, 0x80);	/* 2, 0x4c7c0 */
+		b43_ac_phy_mod(dev, 0x725 + p, 0x04, 0x04);	/* 3, 0x4c818 */
+		b43_ac2069_mod(dev, 0x121 | r, 0x1000, 0);	/* 4, 0x4c868 */
+		udelay(100);					/* 0x4c870 */
+		b43_ac2069_mod(dev, 0x121 | r, 0x1000, 0x1000);	/* 0x4c8b8 */
+		x = b43_radio_read(dev, 0x122 | r);		/* 5, 0x4c8f4 */
+		b43_radio_write(dev, 0x122 | r, x | 0x000f);	/* 0x4c944 */
+		done = false;
+		for (n = 0; n < 10; n++) {			/* 6, 0x4c930..0x4c9f0 */
+			udelay(10);				/* 0x4c94c */
+			s1 = b43_radio_read(dev, 0x144 | r);	/* 0x4c98c */
+			s2 = b43_radio_read(dev, 0x144 | r);	/* 0x4c9d4 */
+			if ((s1 & 0x2) && (s2 & 0x1)) {		/* 0x4c994, 0x4c9dc */
+				done = true;
+				break;
+			}
+		}
+		if (!done) {
+			b43warn(dev->wl, "radio 0x2069: core %u ADC cal 0x144 bits 1/0 not set after 10 polls\n",
+				c);
+			ch->timeouts++;
+		}
+		b43_radio_write(dev, 0x122 | r, x & 0xfff0);	/* 7, 0x4ca38 */
+		b43_phy_write(dev, 0x725 + p, sc);		/* 8, 0x4ca48 */
+		b43_phy_write(dev, 0x739 + p, sa);		/* 0x4ca58 */
+		b43_phy_write(dev, 0x73a + p, sb);		/* 0x4ca68 */
+	}
+	b43_ac2069_mod(dev, 0x8ea, 0x80, 0);			/* 0x4cad4 */
+}
+
+/*
+ * chan-common-2069.md step 8b (0x4cae4..0x4d354), radio rev <= 3 only:
+ * inverted copies of radio 0x136..0x143 into 0x128..0x135. Rev 4 skips it
+ * (cmp #3; bhi at 0x4cadc..0x4cae0); kept for the rev 3 gate.
+ */
+static void b43_ac2069_adc_copy_rev3(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	unsigned int i;
+	u16 r;
+	u8 c;
+
+	b43_ac2069_mod(dev, 0x8ea, 0x80, 0x80);			/* 0x4cb38 */
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x4cb5c..0x4d2fc */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		r = c << 9;
+		b43_ac2069_mod(dev, 0x15f | r, 0x20, 0x20);	/* 0x4cbc0 */
+		b43_ac2069_mod(dev, 0x15f | r, 0x10, 0x10);	/* 0x4cc04 */
+		for (i = 0; i < 14; i++)			/* 0x4cc40..0x4d2dc */
+			b43_radio_write(dev, (0x135 - i) | r,
+					~b43_radio_read(dev, (0x143 - i) | r) & 0xffff);
+	}
+	b43_ac2069_mod(dev, 0x8ea, 0x80, 0);			/* 0x4d354 */
+}
+
+/*
+ * wlc_phy_desense_aci_getset_chanidx_acphy(pi, chanspec, set) @0x1a048,
+ * chan-set-gaps.md 5: find the channel's record among the three of its band
+ * (byte +0 channel, u16 +2 bandwidth), or with set reuse the one with the
+ * oldest u64 time at +8 (ties keep the lower index), zeroed, with the
+ * current channel and the bandwidth state [pi,#222]. With set, +0x45 = 2
+ * and +8 = wlc_phy_get_time_usec @0x56c84, which reads the d11 TSF low
+ * (0x180) and high (0x184) words, each followed by a dmb (readl's barrier
+ * here). Returns the record, wl's pi_ac[0x940].
+ */
+static u8 *b43_ac2069_desense_aci_getset_chanidx(struct b43_wldev *dev,
+						 u16 chanspec, bool set)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u8 (*b)[80] = phy_ac->aci_rec[(chanspec & B43_AC_CHSPEC_BAND_5G) ? 1 : 0];
+	u8 *rec = NULL;
+	u64 t, tmin;
+	u32 lo, hi;
+	int i, k;
+
+	for (i = 0; i < 3; i++) {				/* 0x1a070..0x1a0a0 */
+		if (b[i][0] == (chanspec & 0xff) &&
+		    get_unaligned_le16(&b[i][2]) == (chanspec & 0x3800)) {
+			rec = b[i];
+			break;
+		}
+	}
+	if (!rec) {
+		if (!set)					/* 0x1a0a4..0x1a0ac */
+			return NULL;
+		k = 0;						/* 0x1a0b0..0x1a104 */
+		tmin = get_unaligned_le64(&b[0][8]);
+		for (i = 1; i < 3; i++) {
+			t = get_unaligned_le64(&b[i][8]);
+			if (t < tmin) {
+				tmin = t;
+				k = i;
+			}
+		}
+		rec = b[k];
+		memset(rec, 0, 80);				/* 0x1a118 */
+		rec[0] = phy_ac->chanspec & 0xff;		/* 0x1a120 */
+		/*
+		 * [pi,#222], wlc_phy_bw_state_set @0x5544c from
+		 * wlc_bmac_bw_set; 0x1000 at attach (0x68ed0), ht40-2069.md.
+		 */
+		put_unaligned_le16(phy_ac->bw_state, &rec[2]);	/* 0x1a128 */
+	}
+	if (set) {						/* 0x1a138..0x1a148 */
+		rec[0x45] = 2;
+		lo = b43_read32(dev, B43_MMIO_REV3PLUS_TSF_LOW);	/* 0x56c8c */
+		hi = b43_read32(dev, B43_MMIO_REV3PLUS_TSF_HIGH);	/* 0x56ca0 */
+		put_unaligned_le64((u64)hi << 32 | lo, &rec[8]);
+	}
+	return rec;
+}
+
+/*
+ * wlc_phy_txpwrctrl_enable_acphy(pi, 0) @0x371ac, chan-set-gaps.md 9 and
+ * txpwrctrl-mode-rev1.md: the mode is byte pi+0x4bf4, which is 0 on every
+ * set in this wl.ko (memzero at attach, and every store to it is 0), so the
+ * channel set only ever takes the mode-0 branch: hardware TX power control
+ * off. The saved-index reads of that branch (PHY 0x640/0x840/0xa40 into
+ * pi_ac[0x4be + c], 0x371d0..0x37210) only fill driver state that the
+ * unused mode-1 branch reads, so they are left out.
+ */
+static void b43_ac2069_txpwrctrl_disable(struct b43_wldev *dev)
+{
+	dev->phy.ac->txpwrctrl = 0;				/* 0x371c0 */
+	b43_ac_phy_mod(dev, 0x070, 0xe000, 0);			/* 0x37238 */
+	/* returns at 0x372d8: radio 0x2069, mode != 1 */
+}
+
+/*
+ * wlc_phy_desense_calc_total_acphy(pi) @0x171fc, desense-calc-rev1.md, 5 GHz:
+ * no hardware access. The source is the channel's desense record (bytes
+ * 16..25) or, without one, pi_ac[0x6e5..0x6ee], zeroed at attach (0x473e0)
+ * with no writer found (0x17208..0x1721c). 5 GHz always copies
+ * (0x17254..0x17270). Steps 3 and 4 change nothing here: the hi-RSSI
+ * threshold pi_ac[0x9c2] is -1 (hirssi_elnabypass_init) and the overrides
+ * pi_ac[0x952..0x954] are -1 (attach 0x47430..0x47440, only an iovar
+ * changes them).
+ */
+static void b43_ac2069_desense_calc_total(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	static const u8 fallback[10];
+	const u8 *src = phy_ac->aci_cur ? phy_ac->aci_cur + 16 : fallback;
+
+	memcpy(phy_ac->desense_total, src, sizeof(phy_ac->desense_total));
+}
+
+/* wlc_phy_set_crs_min_pwr_higain_acphy(pi, v) @0x17da4: high byte of eight registers */
+static void b43_ac_set_crs_min_pwr_higain(struct b43_wldev *dev, u8 v)
+{
+	/* 0x17dbc, 0x17dd0, 0x17de4, 0x17df8, 0x17e0c, 0x17e20, 0x17e34, 0x17e4c */
+	static const u16 regs[8] = {
+		0x324, 0x330, 0x321, 0x32d, 0x32a, 0x336, 0x327, 0x333,
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		b43_ac_phy_mod(dev, regs[i], 0xff00, v << 8);
+}
+
+/* wlc_phy_desense_mf_high_thresh_acphy(pi, d) @0x173a0, PHY rev 1 (not 4) */
+static void b43_ac_desense_mf_high_thresh(struct b43_wldev *dev, bool d)
+{
+	u16 v = d ? 0x5f62 : 0x4e51;				/* 0x173a0..0x173c8 */
+
+	b43_phy_write(dev, 0x304, v);				/* 0x173d8 */
+	b43_phy_write(dev, 0x307, v);				/* 0x173e8 */
+	b43_phy_write(dev, 0x30a, v);				/* 0x173f8 */
+	b43_phy_write(dev, 0x30d, v);				/* 0x1740c */
+}
+
+/*
+ * wlc_phy_desense_apply_acphy(pi, on) with on != 0, 0x2796c..0x27b78
+ * (desense-apply-rev1.md "on != 0"), 5 GHz, PHY rev 1: the OFDM desense
+ * o (dB, at most 48) lowers the init gain target by up to 12 dB and, past
+ * that, raises the CRS minimum power by 2.75 register steps per dB over
+ * the cal's floor pi_ac[66]; the high-gain CRS threshold follows from 21 dB
+ * on; the matched-filter high threshold switches with any desense. The
+ * LNA tables and the gain control are redone only when the LNA desense
+ * bytes or the eLNA bypass moved since they were last applied. The BPHY
+ * desense b only feeds the 2 GHz branch (k, PHY 0x299 / 0x3c1), 0 here.
+ */
+static void b43_ac2069_desense_apply_on(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	const u8 *t = a->desense_total;
+	u8 o, b, d, s, c, h, core;
+	bool chg;
+
+	b43_ac2069_desense_calc_total(dev);			/* 0x27970 */
+	o = min_t(u8, t[0], 48);				/* 0x27974..0x27994 */
+	b = min_t(u8, t[1], 24);
+	a->desense_last[0] = o;					/* 0x279a0 */
+	a->desense_last[1] = b;					/* 0x2799c */
+	b43_ac_desense_mf_high_thresh(dev, o != 0);		/* 0x279a4 */
+	d = o ? o - 1 : 0;					/* 0x279ac..0x279b4 */
+	s = min_t(u8, d, 12);					/* 0x279bc, 0x279e4..0x279f0: 5 GHz s = d, k = 0 */
+	c = clamp_t(int, (int)d - s, 0, 30);			/* 0x279f8..0x27a10 */
+	h = d > 21 ? d - 21 : 0;				/* 0x279fc..0x27a18 */
+	/* 0x27a14..0x27a5c: pi_ac[0x6e2], [0x6df], [0x6dd], [0x6e0], [0x6de] against the total */
+	chg = a->rx_max_lna != t[7] || a->desense_lna[2] != t[4] ||
+	      a->desense_lna[0] != t[2] || a->desense_lna[3] != t[5] ||
+	      a->desense_lna[1] != t[3];
+	if (chg) {
+		b43_ac2069_upd_lna1_lna2_gains(dev);		/* 0x27a68 */
+		b43_ac2069_gainctrl(dev);			/* 0x27a90, PHY rev not 4/7 */
+	}
+	for (core = 0; core < a->ncores; core++)		/* 0x27ab8..0x27aec */
+		b43_ac_set_init_clip_gain(dev, 0, 69 - s, t[7] != 0, false, core);
+	a->desense_init_target = 69 - s;
+	a->desense_crs = max_t(u8, (u8)((88 * c >> 5) + 54), a->crs_thr_max);
+	a->desense_crs_hi = (u8)((88 * h >> 5) + 54);
+	b43_ac_set_crs_min_pwr(dev, a->desense_crs, 0, 0);	/* 0x27af0..0x27b20 */
+	b43_ac_set_crs_min_pwr_higain(dev, a->desense_crs_hi);	/* 0x27b24..0x27b38 */
+	/* 0x27b60, 0x27b78: PHY 0x299 / 0x3c1, 2 GHz only */
+}
+
+/*
+ * wlc_phy_desense_apply_acphy(pi, on) @0x278bc, desense-apply-rev1.md, 5 GHz,
+ * PHY rev 1. wl's MAC suspend/enable nest by a counter, as b43's do.
+ */
+static void b43_ac2069_desense_apply(struct b43_wldev *dev, u8 on)
+{
+	b43_mac_suspend(dev);					/* 1, 0x2791c */
+	if (!on) {						/* 2, 0x27920 */
+		b43_ac_set_crs_min_pwr_higain(dev, 54);		/* 0x27930 */
+		b43_ac_desense_mf_high_thresh(dev, false);	/* 0x2793c */
+		/* 5 GHz: PHY 0x299/0x3c1 are 2 GHz only (0x27948) */
+	} else {
+		b43_ac2069_desense_apply_on(dev);		/* 3 */
+	}
+	/* 4, 0x27b80: wlc_phy_aci_updsts_acphy, host rate selection only */
+	b43_mac_enable(dev);					/* 5, 0x27b94 */
+}
+
+/*
+ * ACI and hwaci engines (acphy_desense): wl's wlc_phy_watchdog @0x5e48c,
+ * once a second, for PHY type 11 with interference mode 7.
+ *
+ * The 80-byte per-channel record (b43_ac2069_desense_aci_getset_chanidx)
+ * as both engines use it; the offsets are wl's:
+ *   16..25  desense block copied to pi_ac[0x6ef..] by calc_total: 16 OFDM
+ *           desense dB, 17 BPHY desense dB, 20 LNA1 limit, 21 LNA2 limit,
+ *           22 LNA1 rout (all ticks), 25 desense on
+ *   26      RSSI of the channel (wlc_phy_desense_aci_upd_chan_stats_acphy
+ *           @0x411a0, reached through a wl-layer pointer, not ported: 0)
+ *   28..43  BPHY glitch history, 4 x u32; 44..46 its calc state
+ *   48..63  OFDM glitch history, 4 x u32; 64..66 its calc state
+ *   0x44    history slot, 0x45 ACI engine skip count
+ *   0x46    hwaci level, 0x47 the level applied, 0x48 hold-down, 0x49 skip
+ */
+#define B43_AC_ACI_BPHY_HIST	28
+#define B43_AC_ACI_OFDM_HIST	48
+#define B43_AC_ACI_HIST_IDX	0x44
+#define B43_AC_ACI_SKIP		0x45
+#define B43_AC_ACI_HW_LEVEL	0x46
+#define B43_AC_ACI_HW_APPLIED	0x47
+#define B43_AC_ACI_HW_HOLD	0x48
+#define B43_AC_ACI_HW_SKIP	0x49
+
+/*
+ * The ucode MAC-stat words wlc_phy_watchdog reads (0x5e618..0x5e6bc). The
+ * byte offsets are wl's constants; they match brcmsmac's struct macstat
+ * (u16 index 21, 20, 58, 61) over a block base of 0xe4 for this ucode.
+ * On 5 GHz the OFDM values are the whole counts (0x5e6a8, 0x5e6d8); on
+ * 2 GHz wl subtracts the BPHY ones.
+ */
+static const u16 b43_ac_aci_stat_off[4] = {
+	0x10e,	/* rxcrsglitch, pi[0x400] */
+	0x10c,	/* rxbadplcp, pi[0x274] */
+	0x158,	/* bphy_rxcrsglitch, pi[0x364] */
+	0x15e,	/* bphy_badplcp, pi[0x276] */
+};
+
+/* the record, taking it as wl does when none is set (0x408c4..0x408dc, 0x40b6c..0x40b84) */
+static u8 *b43_ac2069_aci_rec(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+
+	if (!a->aci_cur)
+		a->aci_cur = b43_ac2069_desense_aci_getset_chanidx(dev,
+							a->chanspec, true);
+	return a->aci_cur;
+}
+
+/*
+ * wlc_phy_desense_aci_get_avg_max_glitches_acphy(hist) @0x170f0: the mean
+ * of the largest two of the four history entries (the largest is taken
+ * out at 0x17148, then the largest of what is left, 0x1714c..0x17174).
+ */
+static u32 b43_ac_aci_avg_max(const u8 *h)
+{
+	u32 v[4], m1, m2 = 0;
+	unsigned int i, k = 0;
+
+	for (i = 0; i < 4; i++)
+		v[i] = get_unaligned_le32(h + 4 * i);
+	for (i = 1; i < 4; i++)					/* 0x17104..0x17138 */
+		if (v[i] > v[k])
+			k = i;
+	m1 = v[k];
+	v[k] = 0;						/* 0x17148 */
+	for (i = 0; i < 4; i++)
+		if (v[i] >= m2)
+			m2 = v[i];
+	return (m1 + m2) >> 1;					/* 0x17178 */
+}
+
+/*
+ * wlc_phy_desense_aci_calc_acphy.clone.5(hist, cur, avg, lo, hi) @0x203a4:
+ * the next desense from the current one. The calc state after the history
+ * (hist[16] low bound, [17] high bound, [18] ticks at this value) makes it
+ * a bounded search: glitches above hi raise the desense half way to the
+ * high bound (or by 4 past it) at once; glitches at or under hi for enough
+ * ticks (12 when one step above the low bound, else 4 under lo, 8 between)
+ * lower it half way to the low bound (or by 4 under it). The bound on the
+ * side left behind becomes the value left.
+ */
+static u8 b43_ac_desense_aci_calc(u8 *h, u8 cur, u32 avg, u32 lo, u32 hi)
+{
+	u8 lob = h[16], hib = h[17], cnt = h[18], lim, new = cur;	/* 0x203ac..0x203b8 */
+	int v;
+
+	if (avg > hi) {						/* 0x203b0..0x203bc */
+		if (cur >= hib)					/* 0x203c0 */
+			new = cur + 4;				/* 0x203c4 */
+		else
+			new = max_t(int, (cur + hib) >> 1, cur + 1); /* 0x203cc..0x203dc */
+		lob = cur;					/* 0x203e0 */
+		cnt = 0;					/* 0x20438 */
+	} else {
+		if (cur - lob == 1)				/* 0x203e8..0x203f4 */
+			lim = 12;
+		else
+			lim = avg < lo ? 4 : 8;			/* 0x203f8..0x20400 */
+		if (cnt > lim) {				/* 0x20404 */
+			if (cur <= lob)				/* 0x2040c */
+				v = cur - 4;			/* 0x20410 */
+			else
+				v = min_t(int, (cur + lob) >> 1, cur - 1); /* 0x20418..0x20428 */
+			new = v > 0 ? v : 0;			/* 0x2042c */
+			hib = cur;				/* 0x20430 */
+			cnt = 0;
+		}
+	}
+	cnt = cnt < 255 ? cnt + 1 : 255;			/* 0x2043c..0x20448 */
+	h[16] = lob;						/* 0x20440 */
+	h[17] = hib;						/* 0x2044c */
+	h[18] = cnt;						/* 0x20450 */
+	return new;
+}
+
+/*
+ * wlc_phy_desense_aci_engine_acphy(pi) @0x408b8, from wlc_phy_watchdog
+ * 0x5eb60 with mode bit 0. Each tick files the second's glitch + 2 * bad
+ * PLCP sample (OFDM and BPHY) in the record's 4-deep history, averages the
+ * two largest, and when desense is on or the average exceeds 600 (OFDM) /
+ * 300 (BPHY) runs the calc for both, capped at 48 / 24 dB and, with
+ * pi_ac[0x6f9] = 1 on this board (attach 0x47408), at the channel RSSI +
+ * 80 / + 85 (inert with the RSSI unset). A change resets that history to
+ * the threshold (300 / 100), applies the desense and skips the next tick;
+ * the record's "on" byte is whether any of its desense bytes is set
+ * (memcmp against the zero block pi_ac[0x6e5], 0x40ac0).
+ */
+static void b43_ac2069_desense_aci_engine(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	static const u8 zero[10];
+	u8 *rec = b43_ac2069_aci_rec(dev);
+	u32 avg_b, avg_o;
+	u8 nb, no, old_b, old_o, k, i;
+	s8 rssi;
+	bool chg = false;
+
+	if (rec[B43_AC_ACI_SKIP]) {				/* 0x408e4..0x408f0 */
+		rec[B43_AC_ACI_SKIP]--;
+		return;
+	}
+	k = rec[B43_AC_ACI_HIST_IDX];				/* 0x40948 */
+	put_unaligned_le32(a->aci_sample[0], rec + B43_AC_ACI_OFDM_HIST + 4 * k); /* 0x40984 */
+	put_unaligned_le32(a->aci_sample[1], rec + B43_AC_ACI_BPHY_HIST + 4 * k); /* 0x40994 */
+	rec[B43_AC_ACI_HIST_IDX] = (k + 1) & 3;			/* 0x4098c..0x40998 */
+	avg_b = b43_ac_aci_avg_max(rec + B43_AC_ACI_BPHY_HIST);	/* 0x409a0 */
+	avg_o = b43_ac_aci_avg_max(rec + B43_AC_ACI_OFDM_HIST);	/* 0x409ac */
+	a->aci_avg[0] = avg_o;
+	a->aci_avg[1] = avg_b;
+	if (!rec[25] && avg_o <= 600 && avg_b <= 300)		/* 0x409b0..0x409c8 */
+		return;
+	old_b = rec[17];
+	old_o = rec[16];
+	nb = b43_ac_desense_aci_calc(rec + B43_AC_ACI_BPHY_HIST, old_b, avg_b, 100, 300); /* 0x409e4 */
+	nb = min_t(u8, nb, 24);					/* 0x40a04 */
+	no = b43_ac_desense_aci_calc(rec + B43_AC_ACI_OFDM_HIST, old_o, avg_o, 300, 600); /* 0x40a0c */
+	no = min_t(u8, no, 48);					/* 0x40a14 */
+	rssi = (s8)rec[26];					/* 0x40a2c, pi_ac[0x6f9] = 1 */
+	nb = min_t(int, nb, max(rssi + 85, 0));		/* 0x40a30..0x40a44 */
+	no = min_t(int, no, max(rssi + 80, 0));		/* 0x40a34..0x40a48 */
+	if (old_b != nb) {					/* 0x40a58..0x40a7c */
+		rec[17] = nb;
+		for (i = 0; i < 4; i++)
+			put_unaligned_le32(100, rec + B43_AC_ACI_BPHY_HIST + 4 * i);
+		chg = true;
+	}
+	if (old_o != no) {					/* 0x40a80..0x40aa4 */
+		rec[16] = no;
+		for (i = 0; i < 4; i++)
+			put_unaligned_le32(300, rec + B43_AC_ACI_OFDM_HIST + 4 * i);
+		chg = true;
+	}
+	rec[25] = 0;						/* 0x40ab0 */
+	rec[25] = memcmp(zero, rec + 16, 10) != 0;		/* 0x40ac0..0x40ad0 */
+	if (!chg)						/* 0x40acc */
+		return;
+	b43_ac2069_desense_apply(dev, 1);			/* 0x40ae0 */
+	rec[B43_AC_ACI_SKIP] = 1;				/* 0x40ae8 */
+	b43info(dev->wl, "DESENSE aci: ofdm %u->%u dB bphy %u->%u dB (avg ofdm %u bphy %u, last ofdm glitch+2*badplcp %u bphy %u, tick %u): init gain %u, crs min pwr %u/%u, lna %u/%u/%u, on %u\n",
+		old_o, no, old_b, nb, avg_o, avg_b, a->aci_sample[0],
+		a->aci_sample[1], a->desense_ticks, a->desense_init_target,
+		a->desense_crs, a->desense_crs_hi, rec[20], rec[21], rec[22],
+		rec[25]);
+}
+
+/*
+ * The hwaci level table for 5 GHz, pi_ac[0x732 + 8 * level]: the common
+ * stores of wlc_phy_attach_acphy (0x4748c..0x4750c; fp = 30 from 0x47364,
+ * r8 = -1, sl = 1, r9 = 2) and the PHY rev 1 branch 0x4775c..0x477e8 (rev 1
+ * fails the 0, 2, 3, 4 tests at 0x476b4..0x476d8). pi_ac[0x75b] = 5 levels
+ * (0x47794). Row bytes as the engine reads them: 0..1 PHY 0x554/0x555
+ * value, 2 LNA1, 3 LNA2, 4 LNA1 rout, 5 w2nb test mode, 6 and 7 w2nb
+ * thresholds. The LNA bytes become desense offsets 5 - LNA1, 6 - LNA2 and
+ * 4 - rout (0x41120..0x41148).
+ */
+struct b43_ac_hwaci_row {
+	u16 thr;
+	u8 lna1, lna2, rout, mode, th, th2;
+};
+
+static const struct b43_ac_hwaci_row b43_ac_hwaci_5g_rev1[5] = {
+	{ 0xffff, 5, 6, 4, 0, 30, 4 },	/* 0x732: 0x474e0..0x47500 */
+	{   3000, 5, 4, 4, 0, 30, 4 },	/* 0x73a: 0x47764, 0x4776c, 0x47798, 0x477b8..0x477c0 */
+	{   8000, 5, 4, 2, 1, 15, 4 },	/* 0x742: 0x47774..0x47784, 0x4779c, 0x477c4, 0x477c8 */
+	{  11000, 5, 4, 0, 2,  8, 4 },	/* 0x74a: 0x4778c..0x477a8, 0x477cc..0x477d4 */
+	{  12000, 3, 4, 4, 2, 25, 4 },	/* 0x752: 0x477b0, 0x477d8..0x477e8 */
+};
+
+/*
+ * wlc_phy_hwaci_engine_acphy(pi) @0x40af0, from wlc_phy_watchdog 0x5eb78
+ * with mode bits 1 or 2, 5 GHz, PHY rev 1. Mode bit 1: the hardware ACI
+ * detector's four per-core status words (0x7af, 0x7ab, 0x7b3, 0x7b1 + c *
+ * 0x200 for PHY rev 1, 0x40c18..0x40e44), averaged over the RX chain,
+ * flag ACI when the pair (0x7b3, 0x7b1) or, under 200, (0x7af, 0x7ab) has
+ * its second word below four times the first (0x40eb0..0x40edc). Mode bit
+ * 2: the w2nb detector status PHY 0x523, 0x527, 0x528, 0x529 (bits 0..6,
+ * shifted right by the bandwidth index) against the current level's row
+ * (0x40ef0..0x40fe0). Detection steps the level up and holds it for 8
+ * ticks; 8 quiet ticks step it down. A level change writes the row's
+ * threshold to PHY 0x554/0x555 and skips two ticks; the level in force
+ * moves the LNA desense bytes of the record and reloads the LNA tables.
+ * The level is 1 after the first tick (0x40fec..0x40ff4), so wl runs with
+ * PHY 0x554/0x555 = 3000 once its watchdog has ticked, not hwaci_setup's
+ * 1000. BT coex override calls around it (0x40bc8, 0x41164) are left out.
+ */
+static void b43_ac2069_hwaci_engine(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	const struct b43_ac_hwaci_row *tbl = b43_ac_hwaci_5g_rev1, *row;
+	const u8 nlev = ARRAY_SIZE(b43_ac_hwaci_5g_rev1);	/* pi_ac[0x75b] */
+	u8 mode = a->intf_mode, bw = b43_ac_bw_idx(a->chanspec);
+	u32 s[4] = { }, n = 0;
+	u16 v523 = 0, v527 = 0, v528 = 0, v529 = 0;
+	u8 *rec, lvl, applied, nlvl, c;
+	bool hw = false, w2 = false, flag;
+	unsigned int i;
+
+	if (!(mode & 0x6))					/* 0x40b60 */
+		return;
+	rec = b43_ac2069_aci_rec(dev);
+	if (rec[B43_AC_ACI_HW_SKIP]) {				/* 0x40b8c..0x40b9c */
+		rec[B43_AC_ACI_HW_SKIP]--;
+		return;
+	}
+	if (rec[B43_AC_ACI_HW_HOLD])				/* 0x40ba0..0x40bac */
+		rec[B43_AC_ACI_HW_HOLD]--;
+	lvl = rec[B43_AC_ACI_HW_LEVEL];				/* 0x40bb0 */
+	applied = rec[B43_AC_ACI_HW_APPLIED];			/* 0x40fe8 */
+	b43_mac_suspend(dev);					/* 0x40bc0 */
+	if (mode & 0x2) {					/* 0x40bcc */
+		for (c = 0; c < a->ncores; c++) {		/* 0x40bf8..0x40e64 */
+			if (!(a->coremask & BIT(c)))		/* 0x40bf8..0x40c0c */
+				continue;
+			s[0] += b43_phy_read(dev, 0x7af + c * 0x200);
+			s[1] += b43_phy_read(dev, 0x7ab + c * 0x200);
+			s[2] += b43_phy_read(dev, 0x7b3 + c * 0x200);
+			s[3] += b43_phy_read(dev, 0x7b1 + c * 0x200);
+			n++;
+		}
+		if (n > 1)					/* 0x40e68..0x40eac */
+			for (i = 0; i < 4; i++)
+				s[i] /= n;
+		if (s[3] <= 199) {				/* 0x40eb0 */
+			if (s[1] > 199) {			/* 0x40eb8..0x40ec4 */
+				s[2] = s[0];
+				s[3] = s[1];
+			} else {
+				s[2] = 0;
+			}
+		}
+		hw = s[2] != 0 && s[3] < 4 * s[2];		/* 0x40ec8..0x40edc */
+	}
+	if (mode & 0x4) {					/* 0x40ee0 */
+		row = &tbl[lvl < nlev ? lvl : nlev - 1];	/* 0x40f4c */
+		v523 = (b43_phy_read(dev, 0x523) & 0x7f) >> bw;	/* 0x40ef8, 0x40f08, 0x40f64 */
+		v529 = b43_phy_read(dev, 0x529);		/* 0x40f0c */
+		v528 = (b43_phy_read(dev, 0x528) & 0x7f) >> bw;	/* 0x40f1c..0x40f30 */
+		v527 = (b43_phy_read(dev, 0x527) & 0x7f) >> bw;	/* 0x40f34..0x40f54 */
+		flag = row->th2 >= v523;			/* 0x40f70..0x40f78 */
+		if (row->mode == 0) {				/* 0x40f7c */
+			v529 = (v529 & 0x7f) >> bw;		/* 0x40f84..0x40f8c */
+			w2 = (v529 >= row->th || v528 != 0 || v527 != 0) && flag; /* 0x40f90..0x40fb0 */
+		} else if (row->mode == 1) {			/* 0x40fb8 */
+			w2 = (v528 >= row->th || v527 != 0) && flag; /* 0x40fc0..0x40fd0 */
+		} else {
+			w2 = v527 >= row->th && flag;		/* 0x40fd8..0x40fe0 */
+		}
+	}
+	if (lvl == 0) {						/* 0x40fec..0x40ff4 */
+		rec[B43_AC_ACI_HW_LEVEL] = 1;
+	} else if (hw || w2) {					/* 0x40ff8 */
+		rec[B43_AC_ACI_HW_APPLIED] = lvl;		/* 0x41004 */
+		rec[B43_AC_ACI_HW_HOLD] = 8;			/* 0x41008 */
+		rec[B43_AC_ACI_HW_LEVEL] = lvl + 1;		/* 0x4100c */
+	} else if (rec[B43_AC_ACI_HW_HOLD] == 0) {		/* 0x41018..0x41020 */
+		nlvl = lvl - 1;					/* 0x41024..0x4102c */
+		rec[B43_AC_ACI_HW_LEVEL] = nlvl;
+		if (nlvl < applied)				/* 0x41030..0x41038 */
+			rec[B43_AC_ACI_HW_APPLIED] = nlvl;
+	}
+	nlvl = clamp_t(int, rec[B43_AC_ACI_HW_LEVEL], 1, nlev - 1); /* 0x4103c..0x4105c */
+	rec[B43_AC_ACI_HW_LEVEL] = nlvl;			/* 0x41064 */
+	if (lvl != nlvl) {					/* 0x41060, 0x41068 */
+		rec[B43_AC_ACI_HW_HOLD] = 8;			/* 0x41070 */
+		rec[B43_AC_ACI_HW_SKIP] = 2;			/* 0x41078 */
+		if (mode & 0x2) {				/* 0x4107c */
+			b43_phy_write(dev, 0x554, tbl[nlvl].thr);	/* 0x410c4, PHY rev 1 */
+			b43_phy_write(dev, 0x555, tbl[nlvl].thr);	/* 0x410f8 */
+		}
+	}
+	if (applied != rec[B43_AC_ACI_HW_APPLIED]) {		/* 0x410fc..0x41104 */
+		row = &tbl[rec[B43_AC_ACI_HW_APPLIED]];		/* 0x41110 */
+		rec[21] = row->lna2 < 6 ? 6 - row->lna2 : 0;	/* 0x41120, 0x41128, 0x41130 */
+		rec[20] = row->lna1 < 5 ? 5 - row->lna1 : 0;	/* 0x41124, 0x4112c, 0x41134 */
+		rec[22] = row->rout < 4 ? 4 - row->rout : 0;	/* 0x41138..0x41148, 5 levels */
+		b43_ac2069_desense_calc_total(dev);		/* 0x4114c */
+		b43_ac2069_upd_lna1_lna2_gains(dev);		/* 0x41154 */
+		/* 0x4115c wlc_phy_aci_updsts_acphy: host rate selection only */
+	}
+	if (lvl != nlvl || applied != rec[B43_AC_ACI_HW_APPLIED])
+		b43info(dev->wl, "DESENSE hwaci: level %u->%u applied %u->%u (hw %u: %u %u %u %u; w2nb %u: 523 %u 527 %u 528 %u 529 %u; tick %u): lna1/lna2/rout desense %u/%u/%u, PHY 0x554 %u\n",
+			lvl, nlvl, applied, rec[B43_AC_ACI_HW_APPLIED], hw,
+			s[0], s[1], s[2], s[3], w2, v523, v527, v528, v529,
+			a->desense_ticks, rec[20], rec[21], rec[22],
+			tbl[nlvl].thr);
+	b43_mac_enable(dev);					/* 0x41178 */
+}
+
+/*
+ * wlc_phy_ed_thres_acphy(pi, &dbm, 1) @0x2b430 (set): the energy-detect
+ * CCA thresholds, sixteen PHY registers in two groups of eight from one
+ * dBm value: (dBm * 640000 + 73111232) / 30103 for 0x33a, 0x33b, 0x33e,
+ * 0x33f, 0x342, 0x343, 0x346, 0x347 (0x2b444..0x2b4e0) and (dBm * 640000
+ * + 69271232) / 30103 for 0x33c, 0x33d, 0x340, 0x341, 0x344, 0x345, 0x348,
+ * 0x349 (0x2b4e4..0x2b578): 21.26 steps per dB from -114.24 and -108.24
+ * dBm (30103 = 100000 log10 2). -70 dBm gives 0x3ac / 0x32c, the values in
+ * the community captures; wl's EU default -63 dBm gives 0x43f / 0x3c0.
+ */
+static void b43_ac2069_ed_thres(struct b43_wldev *dev, int dbm)
+{
+	static const u16 ra[8] = { 0x33a, 0x33b, 0x33e, 0x33f, 0x342, 0x343, 0x346, 0x347 };
+	static const u16 rb[8] = { 0x33c, 0x33d, 0x340, 0x341, 0x344, 0x345, 0x348, 0x349 };
+	int m = dbm * 640000;					/* 0x2b454 */
+	u16 va = (u16)((m + 73111232) / 30103);			/* 0x2b458..0x2b460 */
+	u16 vb = (u16)((m + 69271232) / 30103);			/* 0x2b4e4..0x2b4f4 */
+	u16 before = b43_phy_read(dev, 0x33a);
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(ra); i++)
+		b43_phy_write(dev, ra[i], va);
+	for (i = 0; i < ARRAY_SIZE(rb); i++)
+		b43_phy_write(dev, rb[i], vb);
+	b43info(dev->wl, "EDTHR %d dBm: PHY 0x33a.. %04x -> %04x, 0x33c.. %04x (wl writes these for an EU locale only)\n",
+		dbm, before, va, vb);
+}
+
+/*
+ * The fixed test levels (acphy_desense >= 2) and the switch-off: the
+ * record's desense block set by hand, then wl's apply with on = 1, which
+ * is also what wl's mode-0 reset does after zeroing the records
+ * (wlc_phy_desense_aci_reset_params_acphy 0x408a8..0x408b4).
+ */
+static void b43_ac2069_desense_fixed(struct b43_wldev *dev, int mode)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	u8 *rec = b43_ac2069_aci_rec(dev);
+
+	memset(rec + 16, 0, 10);
+	if (mode >= 2) {
+		rec[16] = min(mode - 1, 48);
+		rec[25] = 1;
+	}
+	b43_ac2069_desense_apply(dev, 1);
+	b43info(dev->wl, "DESENSE fixed: ofdm %u dB (acphy_desense %d): init gain %u, crs min pwr %u/%u\n",
+		rec[16], mode, a->desense_init_target, a->desense_crs,
+		a->desense_crs_hi);
+}
+
+/*
+ * wl's 1 s watchdog for this PHY (wlc_watchdog -> wlc_phy_watchdog
+ * @0x5e48c): the MAC-stat deltas of the second (0x5e618..0x5e6e4), the
+ * AC-PHY hook wlc_phy_watchdog_acphy @0x1e024 (the RX core index rotated
+ * into PHY 0x520 bits 2..3 under a MAC suspend, 0x1e048..0x1e084; its
+ * noise-sample request for the CRS min-power cal, pi_ac[0x37a], is not
+ * ported), then the two engines by the interference mode bits
+ * (0x5eb50..0x5eb78). The rest of wlc_phy_watchdog (glitch moving
+ * averages for the other PHY types, periodic cals, the hi-RSSI eLNA bypass
+ * engine 0x4590c, TX power recalc) is not here. Runs under wl->mutex like
+ * b43's periodic work; while the core is not started it only requeues.
+ */
+static void b43_ac2069_desense_work(struct work_struct *work)
+{
+	struct b43_phy_ac *a = container_of(work, struct b43_phy_ac,
+					    desense_work.work);
+	struct b43_wldev *dev = a->dev;
+	struct b43_wl *wl = dev->wl;
+	u16 cur[4];
+	u32 d[4];
+	unsigned int i;
+	int mode;
+
+	mutex_lock(&wl->mutex);
+	if (!a->desense_work_on)
+		goto out;
+	if (!a->pwron_done || !dev->phy.radio_on) {
+		a->desense_work_on = false;		/* the next channel set restarts it */
+		goto out;
+	}
+	if (b43_status(dev) != B43_STAT_STARTED)
+		goto requeue;
+
+	a->desense_ticks++;
+	for (i = 0; i < 4; i++)
+		cur[i] = b43_shm_read16(dev, B43_SHM_SHARED, b43_ac_aci_stat_off[i]);
+	if (a->aci_stat_valid) {
+		for (i = 0; i < 4; i++)
+			d[i] = (u16)(cur[i] - a->aci_stat[i]);
+		/* 0x40940, 0x40980: glitch + 2 * bad PLCP; 5 GHz, OFDM is the whole count */
+		a->aci_sample[0] = d[0] + 2 * d[1];
+		a->aci_sample[1] = d[2] + 2 * d[3];
+	}
+	memcpy(a->aci_stat, cur, sizeof(cur));
+	a->aci_stat_valid = true;
+
+	/* wlc_phy_watchdog_acphy, 0x1e048..0x1e084 */
+	b43_mac_suspend(dev);
+	b43_ac_phy_mod(dev, 0x520, 0xc, a->aci_core << 2);
+	a->aci_core = (a->aci_core + 1) % a->ncores;
+	b43_mac_enable(dev);
+
+	mode = acphy_desense;
+	if (mode == 1) {
+		if (a->intf_mode & 0x1)				/* 0x5eb54 */
+			b43_ac2069_desense_aci_engine(dev);
+		if (a->intf_mode & 0x6)				/* 0x5eb6c */
+			b43_ac2069_hwaci_engine(dev);
+	} else if (mode != a->desense_mode) {
+		b43_ac2069_desense_fixed(dev, mode);
+	}
+	a->desense_mode = mode;
+	if (a->desense_ticks % 10 == 0 && a->aci_cur)
+		b43info(dev->wl, "ACISTAT tick %u: ofdm glitch+2*badplcp %u bphy %u, avg ofdm %u bphy %u, desense ofdm %u bphy %u lna %u/%u/%u on %u, hwaci level %u applied %u, stat %04x %04x %04x %04x\n",
+			a->desense_ticks, a->aci_sample[0], a->aci_sample[1],
+			a->aci_avg[0], a->aci_avg[1], a->aci_cur[16],
+			a->aci_cur[17], a->aci_cur[20], a->aci_cur[21],
+			a->aci_cur[22], a->aci_cur[25],
+			a->aci_cur[B43_AC_ACI_HW_LEVEL],
+			a->aci_cur[B43_AC_ACI_HW_APPLIED], cur[0], cur[1],
+			cur[2], cur[3]);
+requeue:
+	ieee80211_queue_delayed_work(wl->hw, &a->desense_work,
+				     msecs_to_jiffies(1000));
+out:
+	mutex_unlock(&wl->mutex);
+}
+
+/* after a completed channel set (under wl->mutex): the watchdog, if asked for */
+static void b43_ac2069_desense_work_start(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+
+	if (!acphy_desense)
+		return;
+	if (!a->desense_work_on)
+		b43info(dev->wl, "DESENSE watchdog started (acphy_desense %d, interference mode %u)\n",
+			acphy_desense, a->intf_mode);
+	a->desense_work_on = true;
+	a->aci_stat_valid = false;
+	ieee80211_queue_delayed_work(dev->wl->hw, &a->desense_work,
+				     msecs_to_jiffies(1000));
+}
+
+/*
+ * wlc_phy_set_tx_bbmult_acphy(pi, &bbmult, c) @0x24e14 (txpower.md,
+ * txpwr-by-index-rev1.md): two table 0x0c entries per core, offsets from
+ * .rodata 0x5996c / 0x59974.
+ */
+static void b43_ac_set_tx_bbmult(struct b43_wldev *dev, u16 bbmult, u8 c)
+{
+	static const u8 off1[4] = { 0x63, 0x67, 0x6b, 0x6f };
+	static const u8 off2[4] = { 0x73, 0x77, 0x7b, 0x7f };
+	u16 saved = b43_phy_read(dev, 0x19e);			/* 0x24e58 */
+
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x24e70 */
+	b43_ac_tbl_write16(dev, 0x0c, off1[c], bbmult);		/* 0x24e90 */
+	b43_ac_tbl_write16(dev, 0x0c, off2[c], bbmult);		/* 0x24ea8 */
+	b43_ac_phy_mod(dev, 0x19e, 0x2, saved & 0x2);		/* 0x24ec4 */
+}
+
+/*
+ * wlc_phy_txpwr_by_index_acphy(pi, mask, idx) @0x2db40,
+ * txpwr-by-index-rev1.md, 5 GHz ePA (the iPA block 0x2dc38..0x2ddc4 and the
+ * radio 0x30b tail are skipped): per core in mask, split table 0x20 entry
+ * idx (wlc_phy_get_txgain_settings_by_index_acphy @0x28854) into the three
+ * radio gain words in table 7 and the bbmult, and remember idx.
+ */
+static void b43_ac2069_txpwr_by_index(struct b43_wldev *dev, u8 mask, s8 idx)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 s = b43_phy_read(dev, 0x19e) & 0x2;			/* 1, 0x2db58 */
+	u16 w[3];
+	u8 c;
+
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x2db7c */
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 2, 0x2dba8..0x2dde4 */
+		if (!(mask & BIT(c)))
+			continue;
+		b43_ac_tbl_read48(dev, 0x20, (u16)idx, w);	/* 0x2dbc8, 0x28878 */
+		b43_ac_tbl_write16(dev, 7, 0x100 + c,
+				   (w[0] >> 8) | (w[1] << 8));	/* rad_gain, 0x2dbe4 */
+		b43_ac_tbl_write16(dev, 7, 0x103 + c,
+				   (w[1] >> 8) | (w[2] << 8));	/* rad_gain_mi, 0x2dc04 */
+		b43_ac_tbl_write16(dev, 7, 0x106 + c, w[2] >> 8); /* rad_gain_hi, 0x2dc24 */
+		b43_ac_set_tx_bbmult(dev, w[0] & 0xff, c);	/* 0x2dc34 */
+		phy_ac->txpwr_idx[c] = idx;			/* 0x2ddd0 */
+	}
+	b43_ac_phy_mod(dev, 0x19e, 0x2, s);			/* 4, 0x2de90 */
+}
+
+/*
+ * The 5 GHz channel the last set completed, or NULL while no set has
+ * completed since power-on (the gain table and gain words are not loaded).
+ */
+static const struct b43_ac2069_chan *b43_ac2069_txpwr_chan(struct b43_wldev *dev)
+{
+	const struct b43_phy_ac *a = dev->phy.ac;
+
+	if (dev->phy.radio_ver != B43_RADIO_ID_2069 || !a || !a->pwron_done ||
+	    a->chan_init || !(a->chanspec & B43_AC_CHSPEC_BAND_5G))
+		return NULL;
+	return b43_ac2069_find_chan(a->chanspec & 0xff);
+}
+
+/*
+ * b43 TX power check (b43_phy_txpower_check: periodic, on TX status, and
+ * on a mac80211 power_level change). Only computes; the write is
+ * adjust_txpower's, from b43's work queue.
+ */
 static enum b43_txpwr_result
 b43_phy_ac_op_recalc_txpower(struct b43_wldev *dev, bool ignore_tssi)
 {
+	const struct b43_phy_ac *a = dev->phy.ac;
+	const struct b43_ac2069_chan *ci = b43_ac2069_txpwr_chan(dev);
+	struct b43_ac_txpwr t;
+	u8 c;
+
+	if (!ci)
+		return B43_TXPWR_RES_DONE;
+	b43_ac2069_txpwr_calc(dev, ci, &t);
+	for (c = 0; c < a->ncores; c++) {
+		if ((a->coremask & BIT(c)) && a->txpwr_idx[c] != (s8)t.row[c])
+			return B43_TXPWR_RES_NEED_ADJUST;
+	}
+	if (memcmp(a->pwroff, t.off, sizeof(a->pwroff)))	/* acphy_rateppr */
+		return B43_TXPWR_RES_NEED_ADJUST;
 	return B43_TXPWR_RES_DONE;
 }
 
+/*
+ * Recomputes for the channel now set (a set may have run since
+ * recalc_txpower) and writes the changed rows with the MAC suspended, as
+ * wlc_phy_txpower_set @0x60a08 suspends it around its recalculation.
+ */
 static void b43_phy_ac_op_adjust_txpower(struct b43_wldev *dev)
 {
+	struct b43_phy_ac *a = dev->phy.ac;
+	const struct b43_ac2069_chan *ci = b43_ac2069_txpwr_chan(dev);
+	struct b43_ac_txpwr t;
+	bool ok, changed = false;
+	u8 c;
+
+	if (!ci)
+		return;
+	ok = b43_ac2069_txpwr_calc(dev, ci, &t);
+	b43_mac_suspend(dev);
+	for (c = 0; c < a->ncores; c++) {
+		if (!(a->coremask & BIT(c)) || a->txpwr_idx[c] == (s8)t.row[c])
+			continue;
+		b43_ac2069_txpwr_by_index(dev, BIT(c), (s8)t.row[c]);
+		changed = true;
+	}
+	if (b43_ac2069_txpwr_set_off(a, &t))			/* acphy_rateppr */
+		changed = true;
+	b43_mac_enable(dev);
+	if (changed)
+		b43_ac2069_txpwr_log(dev, ci, &t, ok);
 }
 
-/**************************************************
- * PHY ops struct
- **************************************************/
+/*
+ * acphy_httx bits 0 and 1 (the comment at the parameter): the register
+ * state of wlc_phy_txpwrctrl_pwr_setup_acphy @0x3ad34 for this board, then
+ * txpwrctrl_enable(pi, 0) as stock wl (0x3bb64) or enable(1) as wl 7.14.
+ * Runs after the channel set's tail (its step 12 already ran enable(0)
+ * twice), where wl's recalc_target follows wlc_phy_init's set.
+ */
+static void b43_ac2069_httx(struct b43_wldev *dev,
+			    const struct b43_ac2069_chan *ci)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	struct b43_ac_txpwr t;
+	u16 r70, r71, r72, saved;
+	bool loop = acphy_httx & B43_AC_HTTX_LOOP, ok;
+	u8 c;
+
+	if (!(acphy_httx & (B43_AC_HTTX_PWRSETUP | B43_AC_HTTX_LOOP)))
+		return;
+	if (loop && (acphy_txcal || acphy_rxcal)) {
+		b43info(dev->wl, "HTTX ch %u: hardware TX power control left off, acphy_txcal/acphy_rxcal set (wl holds the loop off around its cals, the port's cals do not)\n",
+			ci->channel);
+		loop = false;
+	}
+	r70 = b43_phy_read(dev, 0x070);
+	r71 = b43_phy_read(dev, 0x071);
+	r72 = b43_phy_read(dev, 0x072);
+	ok = b43_ac2069_txpwr_calc(dev, ci, &t);
+
+	saved = b43_phy_read(dev, 0x19e) & 0x2;			/* 0x3ad48 */
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x3ad64 */
+	b43_ac_phy_mod(dev, 0x072, 0x0001, 0x0001);		/* 0x3ad78 */
+	b43_ac_phy_mod(dev, 0x070, 0x8000, 0);			/* 0x3ad8c */
+	b43_ac_phy_mod(dev, 0x070, 0x0100, 0);			/* 0x3adfc, rev 1 */
+	for (c = 0; c < a->ncores; c++) {			/* 0x3b000..0x3b0b8 */
+		if (!(a->coremask & BIT(c)))
+			continue;
+		/* set_target @0x37040: 0x646/0x846/0xa46 bits 0..7 */
+		b43_ac_phy_mod(dev, 0x646 + (c << 9), 0x00ff,
+			       (u16)clamp(t.target[c], 0, 255));
+	}
+	b43_ac_phy_mod(dev, 0x072, 0x4000, 0x4000);		/* 0x3b0e4, 0x3b0f8 */
+	b43_ac_phy_mod(dev, 0x070, 0x8000, 0);			/* 0x3b10c */
+	for (c = 0; c < a->ncores; c++) {			/* 0x3b124..0x3b158 */
+		if (!(a->coremask & BIT(c)))
+			continue;
+		/* set_cur_index @0x182f8: 0x644/0x844/0xa44 bits 0..6, 20 for radio rev 4 */
+		b43_ac_phy_mod(dev, 0x644 + (c << 9), 0x007f, 20);
+	}
+	b43_ac_phy_mod(dev, 0x071, 0x00ff, 0xdc);		/* 0x3b258, pdgain5g 4 */
+	b43_ac_phy_mod(dev, 0x071, 0x0700, 0x0400);		/* 0x3b26c */
+	b43_ac_phy_mod(dev, 0x071, 0x0700, 0x0400);		/* 0x3b280 */
+	b43_ac_phy_mod(dev, 0x070, 0x0800, 0);			/* 0x3b294 */
+	b43_ac_phy_mod(dev, 0x070, 0x0400, 0x0400);		/* 0x3b2c8, rev 1 */
+	/* 0x3b2d0..0x3bab0: estimate tables 0x40/0x60/0x80 and 0x21, not ported */
+	b43_ac_phy_mod(dev, 0x19e, 0x2, saved);			/* 0x3bac8 */
+
+	if (loop) {
+		a->txpwrctrl = 1;				/* 0x371c0 */
+		b43_ac_phy_mod(dev, 0x070, 0xe000, 0xe000);	/* 0x37250 */
+		b43_ac_phy_mod(dev, 0x678, 0x0004, 0);		/* 0x372e8 */
+	} else {
+		b43_ac2069_txpwrctrl_disable(dev);		/* 0x3bb64 */
+	}
+	b43info(dev->wl, "HTTX ch %u: pwr_setup regs 0x070 %04x -> %04x, 0x071 %04x -> %04x, 0x072 %04x -> %04x; per core 0x644 idx 20, 0x646 target %d/%d/%d qdBm%s%s; hardware loop %s (acphy_httx 0x%x)\n",
+		ci->channel, r70, b43_phy_read(dev, 0x070),
+		r71, b43_phy_read(dev, 0x071), r72, b43_phy_read(dev, 0x072),
+		t.target[0], t.target[1], t.target[2],
+		ok ? "" : ", no target: ", ok ? "" : t.why,
+		loop ? "on (0x678 bit 2 clear)" : "off", acphy_httx);
+}
+
+/*
+ * wlc_phy_chanspec_set_acphy from after the band, bandwidth and channel
+ * tables to its return: chan-common-2069.md steps 5..22, PHY rev 1,
+ * radio 0x2069 rev 4, chip 0x4360, femctrl 3, boardflags3 0.
+ */
+static int b43_ac2069_chan_tail(struct b43_wldev *dev, struct b43_ac2069 *ch,
+				bool init, bool band_chg, bool bw_chg)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	const struct b43_ac2069_chan *ci;
+	struct b43_ac_txpwr txp;
+	s16 gerr[3] = { };
+	u8 out[6], flag, g, c;
+	bool txok, vco;
+
+	/*
+	 * 5, 0x4c588..0x4c5bc: wlc_phy_hirssi_elnabypass_set_ucode_params_acphy
+	 * @0x4581c, enable 0 (attach), shm writes at 0x458dc, 0x458f0, 0x45908.
+	 */
+	if (init || band_chg || bw_chg) {
+		b43_shm_write16(dev, B43_SHM_SHARED, 0x186, 20);
+		b43_shm_write16(dev, B43_SHM_SHARED, 0x180, 0x527);
+		b43_shm_write16(dev, B43_SHM_SHARED, 0x182, 500);
+	}
+	/*
+	 * 6, 0x4c5c0..0x4c60c: pi_ac[0x940] = 0; then, unless a PHY hold flag
+	 * ([pi,#248] & 0x206, wlc_phy_hold_upd @0x550b0) is set for another
+	 * channel, [pi,#400] = channel and pi_ac[0x940] = the channel's
+	 * desense record. b43 keeps no PHY hold flags, so the record is taken
+	 * every time.
+	 */
+	phy_ac->aci_cur = NULL;
+	phy_ac->aci_chan = phy_ac->chanspec & 0xff;
+	phy_ac->aci_cur = b43_ac2069_desense_aci_getset_chanidx(dev,
+						phy_ac->chanspec, true); /* 0x4c608 */
+	/* 7, RX gain, 0x4c610..0x4c648 */
+	b43_ac2069_desense_calc_total(dev);			/* 0x4c614 */
+	b43_ac2069_set_gaintbls(dev, init, band_chg);		/* 0x4c624 */
+	b43_ac2069_gainctrl(dev);				/* 0x4c63c */
+	/* 0x4c644: on = pi_ac[0x6f8], the total block's byte 9 */
+	b43_ac2069_desense_apply(dev, phy_ac->desense_total[9]);	/* 0x4c648 */
+
+	if (init || bw_chg) {					/* 8, 0x4c64c */
+		b43_ac_resetcca(dev);				/* 0x4c668 */
+		udelay(1);					/* 0x4c670 */
+		b43_ac2069_adc_cal(dev, ch);			/* 8a */
+		if (ch->rev <= 3)				/* 8b, 0x4cadc */
+			b43_ac2069_adc_copy_rev3(dev);
+	}
+	/* 9: radio 0x30b only; 10: PHY rev 4/7 and > 1 only */
+
+	/*
+	 * 11, 0x4d494..0x4d4e0: txpwr_by_index(pi, 1 << c, (s8)pi_ac[16 + c])
+	 * per core in the core mask. wl's pi_ac[16..18] is 0 on the first set
+	 * and nothing in wl moves it from the TX power target
+	 * (txpwr-by-index-rev1.md, txpower-target-rev1.md), so wl transmits at
+	 * row 0. Not ported as such: the row comes from the board target and
+	 * the regulatory and user limits for this channel, computed before it
+	 * is applied, so a set never starts at row 0 or at the previous
+	 * channel's row. Lowest-power row when the inputs are missing.
+	 */
+	ci = b43_ac2069_find_chan(phy_ac->chanspec & 0xff);
+	if (ci) {
+		txok = b43_ac2069_txpwr_calc(dev, ci, &txp);
+		b43_ac2069_txpwr_log(dev, ci, &txp, txok);
+	} else {
+		memset(txp.row, B43_AC_TXPWR_ROW_MAX, sizeof(txp.row));
+		memset(txp.off, 0, sizeof(txp.off));
+	}
+	for (c = 0; c < phy_ac->ncores; c++) {
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		b43_ac2069_txpwr_by_index(dev, BIT(c), (s8)txp.row[c]); /* 0x4d4cc */
+	}
+	b43_ac2069_txpwr_set_off(phy_ac, &txp);			/* acphy_rateppr */
+
+	/*
+	 * 12, 0x4d4e4..0x4d568: wlc_phy_tssivisible_thresh_acphy @0x45710 gives
+	 * 24 for PHY rev <= 1 unless femctrl/boardflags3 & 7 is 0x0203 (this
+	 * board: 3/0), so PHY 0x1641 = 0x7f00 + 24. The mode saved at 0x4d4f0
+	 * and passed back at 0x4d568 is pi+0x4bf4, always 0
+	 * (txpwrctrl-mode-rev1.md), so both calls are enable(pi, 0).
+	 */
+	b43_ac2069_txpwrctrl_disable(dev);			/* 0x4d4f4 */
+	b43_phy_write(dev, 0x1641, 0x7f18);			/* 0x4d55c */
+	b43_ac2069_txpwrctrl_disable(dev);			/* 0x4d568 */
+
+	/*
+	 * 13, 0x4d580: wait for the VCO cal started in b43_ac2069_tune(), no
+	 * settle; the helper logs a timeout, wl's is silent.
+	 */
+	vco = b43_ac2069_vcocal_isdone(dev, ch, false);
+	b43_phy_ac_inittime(dev, "vcolock", vco);
+	/* 14: PHY rev 6 only */
+	b43_ac_resetcca(dev);					/* 15, 0x4d5e4 */
+
+	/*
+	 * 16, 0x4d5e8..0x4d688: RX gain error bytes pi+0x166 + c, driver
+	 * state only (read by wlc_phy_rssi_compute_acphy), rxgainerr-rev1.md.
+	 * wl stores (u8)buf[c] - 122 - 2 * (g - 2) (0x4d65c..0x4d67c); since
+	 * 122 + 2 * (69 - 2) = 256, that byte is err + 2 * (69 - g), with g
+	 * the init gain the encoder reaches against the 69 dB target.
+	 */
+	flag = b43_ac2069_get_rxgainerr(dev, phy_ac->chanspec & 0xff, gerr); /* 0x4d5f0 */
+	for (c = 0; c < phy_ac->ncores; c++) {
+		if (flag) {					/* 0x4d604..0x4d630 */
+			phy_ac->rx_gainerr[c] = 0;
+			continue;
+		}
+		g = b43_ac_encode_gain(phy_ac, c, 69, false, false, out); /* 0x4d650 */
+		phy_ac->rx_gainerr[c] = (u8)(gerr[c] + 2 * (69 - g));
+		b43info(dev->wl, "radio 0x2069: core %u init gain %u dB (target 69), RX gain error %d, stored %d\n",
+			c, g, gerr[c], (s8)phy_ac->rx_gainerr[c]);
+	}
+	if (flag)
+		b43info(dev->wl, "radio 0x2069: RX gain error group flagged (all -1 in NVRAM), 0 stored for every core\n");
+	/* 17..19, 21: PHY rev 2/3/5/6/7/8 only */
+	b43_ac_carriersearch_exit(dev);				/* 20, 0x4d8d4 */
+	phy_ac->done_chanspec = phy_ac->chanspec;		/* acphy_initorder 4 */
+	return 0;						/* 22, 0x4d938 */
+}
