+/*
+ * wlc_phy_set_reg_on_reset_acphy @0x4391c, reg-on-reset-rev1.md, PHY rev 1,
+ * radio 0x2069, 5 GHz. Step numbers are the decode's.
+ */
+static void b43_ac2069_reg_on_reset(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	struct bcma_device *core = dev->dev->bdev;
+	u8 c;
+
+	b43_phy_set(dev, 0x19e, 0x1c0);				/* 1, 0x4393c */
+	/* 2: write(0x3c4, 0x668) is 2 GHz only */
+	b43_ac_phy_mod(dev, 0x19e, 0x200, 0x200);		/* 3, 0x4396c */
+	b43_ac_phy_mod(dev, 0x19e, 0x3c, 0x10);			/* 5, 0x43a28 */
+	b43_phy_write(dev, 0x1f2, 0xc8);			/* 8, 0x43a80 */
+	b43_phy_write(dev, 0x26, 0x92);				/* 9, 0x43a9c */
+	b43_phy_write(dev, 0x25, 0x30);				/* 10, 0x43aac */
+	/*
+	 * 11, 0x43ac0: si_core_cflags(sih, 0x10, 0x10), the d11 core's ioctl
+	 * bit 4 (B43_BCMA_IOCTL_MACPHYCLKEN); si_core_cflags is the BCMA_IOCTL
+	 * read-modify-write, as for FGC in reset-helpers-rev1.md.
+	 */
+	bcma_awrite32(core, BCMA_IOCTL,
+		      bcma_aread32(core, BCMA_IOCTL) |
+		      B43_BCMA_IOCTL_MACPHYCLKEN);
+	b43_ac_phy_mod(dev, 0x40f, 0x200, 0);			/* 12, 0x43b04 */
+	b43_ac_phy_mod(dev, 0x2f1, 0x20, 0);			/* 13, 0x43b18 */
+	b43_ac_phy_mod(dev, 0x2ed, 0x20, 0);			/* 14, 0x43b2c */
+	b43_ac_phy_mod(dev, 0x2f9, 0x20, 0);			/* 15, 0x43b40 */
+	b43_ac_phy_mod(dev, 0x2f5, 0x20, 0);			/* 16, 0x43b54 */
+	b43_ac_phy_mod(dev, 0x2ef, 0xff, 0x55);			/* 17 */
+	b43_ac_phy_mod(dev, 0x2eb, 0xff, 0x55);
+	b43_ac_phy_mod(dev, 0x2f7, 0xff, 0x55);
+	b43_ac_phy_mod(dev, 0x2f3, 0xff, 0x55);
+	b43_phy_write(dev, 0x400, 0);				/* 21, 0x4424c */
+	b43_ac_phy_mod(dev, 0x1ca, 0x1000, 0);			/* 22, 0x4426c */
+	b43_ac_resetcca(dev);					/* 23, 0x44274 */
+	b43_ac_phy_mod(dev, 0x72, 0x4, 0x4);			/* 24, 0x442a8 */
+	b43_ac_phy_mod(dev, 0x1b0, 0x20, 0);			/* 26, 0x442e4 */
+	b43_ac_phy_mod(dev, 0x1b1, 0x1000, 0x1000);		/* 27, 0x442f8 */
+	b43_ac_phy_mod(dev, 0x1b6, 0x8000, 0);			/* 28, 0x4430c */
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 29, 0x44310..0x443e4 */
+		b43_ac_phy_mod(dev, 0x690 + (c << 9), 0x200, 0x200);
+		b43_ac_phy_mod(dev, 0x690 + (c << 9), 0x400, 0x400);
+	}
+	b43_phy_write(dev, 0x1e6, 0x30);			/* 30, 0x443f4 */
+	b43_ac_phy_mod(dev, 0x2d1, 0xf0, 0x40);			/* 34, 0x449f4 */
+	b43_ac_phy_mod(dev, 0x2d1, 0xf00, 0x400);		/* 0x44a60 */
+	/*
+	 * 35, 0x44a64..0x44a94: f = bit 1 of sh+0x70 or sh+0x74, both 7 from
+	 * wlc_phy_attach for PHY rev 1 (reset-helpers-rev1.md), so f = 1.
+	 */
+	b43_ac_hwaci_setup(dev, false, true);
+	b43_phy_write(dev, 0x358, 0xc07f);			/* 37, 0x44b28 */
+	b43_phy_write(dev, 0x359, 0x64);			/* 38, 0x44b38 */
+	b43_phy_write(dev, 0x35a, 0x64);			/* 39, 0x44b4c */
+}
