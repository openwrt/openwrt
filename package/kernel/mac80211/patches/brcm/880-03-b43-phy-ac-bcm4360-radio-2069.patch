+/*
+ * TX power target and open-loop gain row, txpower-target-rev1.md. Powers
+ * are in qdBm (0.25 dB) as wl keeps them.
+ *
+ * Board values b43 cannot read: bcm47xx_sprom fills maxp5ga only for
+ * sromrev 4/5/8/9 and has no mcslr5g*po field, so both come in as
+ * parameters. mcsbw205g{l,m,h}po are in the SPROM struct for sromrev 11 and
+ * are read from there. Without acphy_maxp5g every core gets the lowest-power
+ * row.
+ */
+static int acphy_maxp5g[12];
+static int acphy_maxp5g_n;
+module_param_array_named(acphy_maxp5g, acphy_maxp5g, int, &acphy_maxp5g_n, 0444);
+MODULE_PARM_DESC(acphy_maxp5g,
+	"NVRAM maxp5ga0,maxp5ga1,maxp5ga2 of the 5 GHz radio in qdBm, four sub-band values each, ga0 first (R6400: 88,106,106,106 three times); without them TX uses the lowest-power gain row");
+
+static int acphy_mcslr5gpo[3];
+static int acphy_mcslr5gpo_n;
+module_param_array_named(acphy_mcslr5gpo, acphy_mcslr5gpo, int, &acphy_mcslr5gpo_n, 0444);
+MODULE_PARM_DESC(acphy_mcslr5gpo,
+	"NVRAM mcslr5glpo,mcslr5gmpo,mcslr5ghpo of the 5 GHz radio (low nibble used); 0 if not given, as wl for a missing key");
+
+static int acphy_txpwrbckof = 6;
+module_param_named(acphy_txpwrbckof, acphy_txpwrbckof, int, 0444);
+MODULE_PARM_DESC(acphy_txpwrbckof,
+	"NVRAM txpwrbckof in qdBm, subtracted from every TX power target (default 6, wl's value for a missing key; negative is taken as 0)");
+
+/*
+ * NVRAM sb20in40lrpo, sb20in40hrpo (wlc_phy_txpwr_srom11_read 0x63128..
+ * 0x63154 -> pi+0x496e / 0x4970): the 20-in-40 MHz rate offsets of the
+ * 40 MHz TX power target (ht40-2069.md). Not in ssb_sprom, so a parameter;
+ * without it a 40 MHz set gets the lowest-power row.
+ */
+static ushort acphy_sb20in40po[2];
+static int acphy_sb20in40po_n;
+module_param_array_named(acphy_sb20in40po, acphy_sb20in40po, ushort, &acphy_sb20in40po_n, 0444);
+MODULE_PARM_DESC(acphy_sb20in40po,
+	"NVRAM sb20in40lrpo,sb20in40hrpo of the 5 GHz radio, for the 40 MHz TX power target (acphy_bw40=1); without them 40 MHz uses the lowest-power row unless acphy_bw40pwr says otherwise");
+
+static int acphy_txpwr_idx0 = -1;
+module_param_named(acphy_txpwr_idx0, acphy_txpwr_idx0, int, 0444);
+MODULE_PARM_DESC(acphy_txpwr_idx0,
+	"Output power at TX gain row 0 in qdBm, 0..127, all cores (default -1: assume the highest acphy_maxp5g value, a guess; a measured value replaces it)");
+
+static bool acphy_pwr_scale_1db;
+module_param_named(acphy_pwr_scale_1db, acphy_pwr_scale_1db, bool, 0444);
+MODULE_PARM_DESC(acphy_pwr_scale_1db,
+	"NVRAM pwr_scale_1db of the 5 GHz radio is non-zero: lower 54 Mbps a second time by its mcsbw205g*po offset, as wl does (R6400: 1; default 0)");
+
+/*
+ * Per-rate TX power (txpower-target-rev1.md, "Per-rate offset"). wl sizes
+ * the target for the highest rate target and backs every frame off to its
+ * own rate's target through PHY control 1 bits 3..7, in half dB
+ * (wlc_update_txppr_offset @0x193e20, wlc_stf_get_204080_pwrs @0x193990,
+ * wlc_acphy_txctl1_calc @0x114254). Without acphy_rateppr the port keeps
+ * one row for the lowest rate target and offset 0 on every frame.
+ */
+static unsigned int acphy_rateppr;
+module_param_named(acphy_rateppr, acphy_rateppr, uint, 0444);
+MODULE_PARM_DESC(acphy_rateppr,
+	"1: wl's per-rate TX power: gain row for the highest OFDM/MCS target, each frame backed off to its rate's target in PHY control 1 (default 0: row for the lowest target, offset 0)");
+
+static unsigned int acphy_rateppr_htadd;
+module_param_named(acphy_rateppr_htadd, acphy_rateppr_htadd, uint, 0644);
+MODULE_PARM_DESC(acphy_rateppr_htadd,
+	"Test hook: extra TX power offset in half dB on every HT frame, added in PHY control 1 (sum capped at 31; default 0); writable at run time");
+
+/*
+ * NVRAM mcsbw205g{l,m,h}po and mcsbw405g{l,m,h}po. bcm47xx_sprom fills
+ * them for sromrev 11 (mask 0xfffffe00), but whether the R6400's SPROM
+ * fallback reaches them is not proven, so all six can come in here and
+ * then replace the SPROM's.
+ */
+static unsigned int acphy_mcsbw5gpo[6];
+static int acphy_mcsbw5gpo_n;
+module_param_array_named(acphy_mcsbw5gpo, acphy_mcsbw5gpo, uint, &acphy_mcsbw5gpo_n, 0444);
+MODULE_PARM_DESC(acphy_mcsbw5gpo,
+	"NVRAM mcsbw205glpo,mcsbw205gmpo,mcsbw205ghpo,mcsbw405glpo,mcsbw405gmpo,mcsbw405ghpo of the 5 GHz radio; all six replace the SPROM values (default: SPROM)");
+
+/*
+ * acphy_bw40pwr: the 40 MHz TX power target (ht40-2069.md, "On-air state
+ * 2026-10-07 22:03 UTC": at 40 MHz the laptop hears the router at -74 dBm
+ * against -30 dBm at 20 MHz, and association is luck: 5, 1, 0 and 0 acked
+ * frames of 42 in the ch36/38 HT40 loads of 15:43, 16:12, 22:05 and 22:08
+ * UTC). Every one of those sets logged "40 MHz without acphy_sb20in40po,
+ * lowest-power row 127": the 40 MHz branch of b43_ac2069_txpwr_calc refused
+ * for want of the two NVRAM words and every core got row 127 of
+ * acphy_txgain_epa_5g_2069rev4 (bbmult 2, radio gain word 0x0700) against
+ * row 12 at 20 MHz (bbmult 64, 0x7f00): over 40 dB down, the whole
+ * difference measured. acphy_mcsbw5gpo never reached the 40 MHz path (the
+ * refusal comes first), so the 22:08 failure with it is the same row 127.
+ * wl reads sb20in40lrpo/hrpo with phy_getintvar @0x53400, which is
+ * phy_getintvar_default(pi, name, 0) (0x53400..0x53404): a board without
+ * the keys, this one, gets offset 0, so its 20-in-40 rates are the 20 MHz
+ * rates, and its 40 MHz MCS rates come from mcsbw405g{l,m,h}po, which
+ * bcm47xx_sprom fills for sromrev 11 (mask 0xfffffe00) and the SPROM
+ * struct carries. Bitmask, default 0 (the refusal stays); one "BW40PWR"
+ * line per 40 MHz set when any bit is set.
+ *  1 (B43_AC_BW40PWR_WL): wl's 40 MHz target: the 20-in-40 OFDM and MCS
+ *    rates from the 20 MHz values plus the sb20in40 offsets, taken as 0
+ *    when acphy_sb20in40po is not given, and MCS 0..7 at 40 MHz from
+ *    mcsbw405g*po (apply_srom11 0x612f4..0x614e4); the row for the lowest
+ *    of them (the highest with acphy_rateppr), as at 20 MHz. This unit,
+ *    channel 36 HT40+: MCS 40 = 84 qdBm from mcsbw405glpo 0x11112222, so
+ *    target 19.50 dBm, row 14 (20 MHz: 20.50 dBm, row 12).
+ *  2 (B43_AC_BW40PWR_ROW20): the 40 MHz set keeps the 20 MHz target: the
+ *    row from the 20 MHz OFDM (and, with acphy_rateppr, MCS) rates only,
+ *    mcsbw405g*po and the sb20in40 offsets ignored, the 40 MHz MCS slots
+ *    given the 20 MHz MCS values. Diagnostic: the gain row of the 20 MHz
+ *    load, so a weak signal with 2 is not the target. Wins over 1.
+ *  4 (B43_AC_BW40PWR_LOG): the BW40PWR line also lists the board rate
+ *    values (qdBm) of the three groups and the slots that sized the row.
+ */
+#define B43_AC_BW40PWR_WL		0x01
+#define B43_AC_BW40PWR_ROW20		0x02
+#define B43_AC_BW40PWR_LOG		0x04
+static unsigned int acphy_bw40pwr;
+module_param_named(acphy_bw40pwr, acphy_bw40pwr, uint, 0444);
+MODULE_PARM_DESC(acphy_bw40pwr,
+	"40 MHz TX power target, bitmask: 1 wl's target (MCS 40 from mcsbw405g*po, 20-in-40 = 20 MHz rates plus sb20in40 offsets, 0 without acphy_sb20in40po as wl for missing keys), 2 keep the 20 MHz target and row at 40 MHz (diagnostic, wins over 1), 4 log the rate values (default 0: lowest-power row without acphy_sb20in40po)");
+
+/* how the 40 MHz set got its 20-in-40 offsets (struct b43_ac_txpwr sbsrc) */
+#define B43_AC_SBSRC_NONE	0	/* not a 40 MHz set, or refused */
+#define B43_AC_SBSRC_PARAM	1	/* acphy_sb20in40po */
+#define B43_AC_SBSRC_WL0	2	/* acphy_bw40pwr 1: wl's 0 for missing keys */
+#define B43_AC_SBSRC_ROW20	3	/* acphy_bw40pwr 2: 20 MHz rate set */
+
+#define B43_AC_TXPWR_ROW_MAX	127
+/* wlc_phy_txpower_sromlimit 0x60268..0x6027c: pi+0x488d (1 on AC PHY rev 1) << 2 */
+#define B43_AC_TXPWR_MIN_QDBM	4
+/* guess, txpower-target-rev1.md section 6: about 0.5 dB per row */
+#define B43_AC_TXPWR_QDBM_PER_ROW	2
+/* wlc_update_txppr_offset: offset clamp 0..31 half dB (0x193f04..0x193f0c) */
+#define B43_AC_PWROFF_MAX	31
+#define B43_AC_PWROFF_SLOTS	28
+
+struct b43_ac_txpwr {
+	u8 sb;			/* 5 GHz sub-band 1..4, 0 if not computed */
+	bool bw40;		/* 40 MHz chanspec (ht40-2069.md) */
+	int user;		/* mac80211 power_level, qdBm (127: none) */
+	int reg;		/* channel max_power, qdBm */
+	int target[3];		/* per core, min over the rates (max with acphy_rateppr), qdBm */
+	int p0[3];		/* assumed output at row 0, qdBm */
+	u8 row[3];		/* chosen TX gain row (table 0x20 index) */
+	u32 po20, po40;		/* mcsbw205g*po, mcsbw405g*po used */
+	u8 cap;			/* acphy_rateppr: offset cap, half dB */
+	u32 used;		/* B43_AC_PWROFF_* slots the target covers */
+	u8 off[B43_AC_PWROFF_SLOTS];	/* acphy_rateppr: half dB, 0 otherwise */
+	const char *why;	/* set when every core got the lowest row */
+	u8 sbsrc;		/* 40 MHz: B43_AC_SBSRC_* (acphy_bw40pwr) */
+	u8 sboff;		/* 40 MHz: the 20-in-40 offset byte applied */
+	int maxp_min;		/* min over cores of maxp[c][sb], qdBm */
+	s8 rv[B43_AC_PWROFF_SLOTS];	/* board rate values before the limits, qdBm */
+};
+
+/*
+ * wlc_phy_txpwr_srom11_convert_mcs_5g(po, lr, maxp, out) @0x513d0: MCS 0
+ * and 3..9 from nibbles 0 and 1..7, MCS 1 and 2 = MCS 0 minus the signed
+ * lr nibble (0x51420..0x51434). Half-dB nibbles, qdBm values.
+ */
+static void b43_ac_convert_mcs_5g(u32 po, u32 lr, int maxp, int out[10])
+{
+	unsigned int i;
+
+	out[0] = maxp - 2 * (int)(po & 0xf);			/* 0x513f4..0x51408 */
+	for (i = 3; i < 10; i++)
+		out[i] = maxp - 2 * (int)((po >> (4 * (i - 2))) & 0xf);
+	out[1] = out[0] - 2 * sign_extend32(lr & 0xf, 3);	/* 0x513d4..0x513e8 */
+	out[2] = out[1];
+}
+
+/*
+ * wlc_phy_txpwr_mcs_deduct_again(po, out) @0x5131c (pwr_scale_1db): MCS 6..9
+ * lose nibbles 4..7 a second time (checked at 0x51324..0x5135c).
+ */
+static void b43_ac_mcs_deduct_again(u32 po, int out[10])
+{
+	unsigned int i;
+
+	for (i = 6; i < 10; i++)
+		out[i] -= 2 * (int)((po >> (4 * (i - 2))) & 0xf);
+}
+
+/*
+ * wlc_phy_txpwr_srom11_convert_ofdm_offset.clone.3 @0x526f8 (n = 8, the
+ * low nibble for rates 0..5) and _mcs_offset.clone.4 @0x52754 (n = 10, low
+ * for 0..4): add the signed half-dB nibbles of off, low then high.
+ */
+static void b43_ac_add_offset(int *v, unsigned int n, unsigned int nlow, u8 off)
+{
+	int lo = 2 * sign_extend32(off & 0xf, 3);
+	int hi = 2 * sign_extend32(off >> 4, 3);
+	unsigned int i;
+
+	for (i = 0; i < n; i++)
+		v[i] += i < nlow ? lo : hi;
+}
+
+/*
+ * One rate's per-core target, the order of wlc_phy_txpower_sromlimit_get_acphy
+ * (d = maxp of the core minus maxp_min, cap maxp) and
+ * wlc_phy_txpower_recalc_target @0x60340, qdBm.
+ */
+static int b43_ac_txpwr_rate_target(const struct b43_ac_txpwr *t, int r,
+				    int d, int maxp, int bck)
+{
+	int v;
+
+	v = r + d;						/* 0x3c254 */
+	v = min(v, maxp);					/* 0x3c284 */
+	v = min(v, t->reg);					/* 0x60690 */
+	v = v > bck ? v - bck : 0;				/* 0x606d0 */
+	v = min(v, t->user);					/* 0x606dc */
+	v = max(v, B43_AC_TXPWR_MIN_QDBM);			/* 0x60748 */
+	return min(v, min(t->reg, t->user));	/* port: floor never above a limit */
+}
+
+/*
+ * Per-core gain row for the 5 GHz channel ci. Always fills t->row; returns
+ * false (t->why set) when it had to fall back to the lowest-power row. No
+ * hardware access.
+ *
+ * Board target, wlc_phy_txpower_sromlimit_get_acphy @0x3c198 and
+ * wlc_phy_txpwr_apply_srom11 @0x60e34 (5 GHz, 20 MHz: legacy OFDM only, the
+ * rates the 20 MHz path has always been sized for; 40 MHz, ht40-2069.md:
+ * OFDM 20-in-40, MCS 0..7 20-in-40 and MCS 0..7 at 40 MHz; with
+ * acphy_rateppr also MCS 0..9 at 20 MHz and MCS 8, 9 at 40 MHz); limits,
+ * wlc_phy_txpower_recalc_target @0x60340 with mac80211's channel max_power
+ * standing in for wl's CLM table and power_level for wl's user target.
+ * The row model is the port's own (wl keeps row 0 open loop): one row per
+ * core that keeps every OFDM rate at or below its target, with 0.5 dB per
+ * row and an assumed row-0 output, both guesses that err towards lower power.
+ * With acphy_rateppr the row is for the highest rate target, as wl's row 0
+ * stands for tx_power_max, and t->off holds each rate's backoff in half dB
+ * for PHY control 1 (the PHY lowering a frame by that many half dB from the
+ * row is assumed, not observed).
+ */
+static bool b43_ac2069_txpwr_calc(struct b43_wldev *dev,
+				  const struct b43_ac2069_chan *ci,
+				  struct b43_ac_txpwr *t)
+{
+	const struct ssb_sprom *sprom = dev->dev->bus_sprom;
+	const struct b43_phy_ac *a = dev->phy.ac;
+	const struct ieee80211_channel *chan =
+		dev->phy.chandef ? dev->phy.chandef->chan : NULL;
+	const struct ieee80211_channel *chan2;
+	int maxp_min = 127, ofdm[8], mcs[10], mcs40[10];
+	int rate[B43_AC_PWROFF_SLOTS] = { };
+	int bck, lr, v, d, tmax_all;
+	unsigned int i, sh;
+	u8 c, rb, off;
+	u32 po, lrraw;
+
+	memset(t, 0, sizeof(*t));
+	for (c = 0; c < ARRAY_SIZE(t->row); c++)
+		t->row[c] = (acphy_httx & B43_AC_HTTX_ROW0) ? 0 :
+			    B43_AC_TXPWR_ROW_MAX;
+	t->bw40 = b43_ac_bw_idx(a->chanspec) == 1;
+
+	if (acphy_maxp5g_n != ARRAY_SIZE(acphy_maxp5g)) {
+		t->why = "acphy_maxp5g not given";
+		return false;
+	}
+	for (i = 0; i < ARRAY_SIZE(acphy_maxp5g); i++) {
+		if (acphy_maxp5g[i] < 0 || acphy_maxp5g[i] > 127) {
+			t->why = "acphy_maxp5g value outside 0..127";
+			return false;
+		}
+	}
+	if (a->ncores < 1 || a->ncores > 3) {
+		t->why = "core count unknown";
+		return false;
+	}
+	/*
+	 * 80 MHz: apply_srom11's 80 MHz branch (mcsbw805g*po, sb40and80*po,
+	 * sb20in80and160*po; none in ssb_sprom) is not ported (vht80-2069.md)
+	 */
+	if (b43_ac_bw_idx(a->chanspec) == 2) {
+		t->why = "80 MHz TX power target not ported";
+		return false;
+	}
+	t->sb = b43_ac2069_chan_freq_range(ci);			/* 0x3c1b0 */
+	if (t->sb < 1 || t->sb > 4) {
+		t->why = "not a 5 GHz channel";
+		return false;
+	}
+
+	/* wl's reg_ppr (0x60690) and user target pi+0x12a (0x605dc, 127 = none) */
+	if (!chan || chan->max_power <= 0) {
+		t->why = "no regulatory limit for the channel";
+		return false;
+	}
+	t->reg = min(chan->max_power * 4, 127);
+	/*
+	 * 40 MHz: mac80211's limit of the secondary 20 MHz channel too (the
+	 * port's stand-in for wl's CLM 40 MHz table, which is not decoded)
+	 */
+	if (t->bw40) {
+		chan2 = dev->phy.chandef ?
+			ieee80211_get_channel(dev->wl->hw->wiphy,
+				2 * dev->phy.chandef->center_freq1 - chan->center_freq) :
+			NULL;
+		if (!chan2 || chan2->max_power <= 0) {
+			t->why = "no regulatory limit for the 40 MHz secondary channel";
+			return false;
+		}
+		t->reg = min(t->reg, chan2->max_power * 4);
+	}
+	t->user = dev->phy.desired_txpower > 0 ?
+		  min(dev->phy.desired_txpower * 4, 127) : 127;
+
+	/* 0x3c1b4..0x3c200: minimum over all cores, masked or not */
+	for (c = 0; c < a->ncores; c++)
+		maxp_min = min(maxp_min, acphy_maxp5g[4 * c + t->sb - 1]);
+	t->maxp_min = maxp_min;
+
+	/* 0x3c204..0x3c214, then apply_srom11's 5 GHz branch 0x611e4 */
+	rb = t->sb > 3 ? 3 : t->sb;
+	if (acphy_mcsbw5gpo_n == ARRAY_SIZE(acphy_mcsbw5gpo)) {
+		t->po20 = acphy_mcsbw5gpo[rb - 1];
+		t->po40 = acphy_mcsbw5gpo[3 + rb - 1];
+	} else {
+		t->po20 = rb == 1 ? sprom->mcsbw205glpo :	/* 0x61228 */
+			  rb == 2 ? sprom->mcsbw205gmpo : sprom->mcsbw205ghpo;
+		t->po40 = rb == 1 ? sprom->mcsbw405glpo :
+			  rb == 2 ? sprom->mcsbw405gmpo : sprom->mcsbw405ghpo;
+	}
+	po = t->po20;
+	lrraw = acphy_mcslr5gpo_n == ARRAY_SIZE(acphy_mcslr5gpo) ?
+		acphy_mcslr5gpo[rb - 1] : 0;
+	lr = sign_extend32(lrraw & 0xf, 3);			/* 0x51368..0x5137c */
+	/* wlc_phy_txpwr_srom11_convert_ofdm_5g @0x51364: 6, 9, 12, 18, 24, 36, 48, 54 */
+	ofdm[0] = maxp_min - 2 * (int)(po & 0xf);
+	ofdm[1] = ofdm[0];
+	ofdm[2] = ofdm[0] - 2 * lr;				/* 0x513b4..0x513c8 */
+	ofdm[3] = ofdm[2];
+	for (i = 0; i < 4; i++)
+		ofdm[4 + i] = maxp_min - 2 * (int)((po >> (4 * (i + 1))) & 0xf);
+	/*
+	 * pi+0x4d9f = (NVRAM pwr_scale_1db != 0), wlc_phy_attach 0x68e6c..0x68e84;
+	 * tested at 0x61268. wlc_phy_txpwr_ofdm_5g_deduct_again @0x512d8 shifts
+	 * po right by 4 at r3 = 1, 4, 5, 6 (0x512f8..0x5130c) before r3 == 7
+	 * (0x512e0), so it subtracts nibble 4 a second time from 54 Mbps only
+	 * (0x512e4..0x512f4).
+	 */
+	if (acphy_pwr_scale_1db)
+		ofdm[7] -= 2 * (int)((po >> 16) & 0xf);
+	/*
+	 * The 20 MHz MCS array from the mcsbw205g*po copy (0x61244..0x61264,
+	 * the same NVRAM word) with its pwr_scale_1db deduction
+	 * (wlc_phy_txpwr_mcs_deduct_again @0x5131c, 0x61294: MCS 6..9).
+	 * wlc_phy_ppr_set_mcs @0x529c4 stores the same ten values for every
+	 * stream count, TX mode and chain count, so one array serves HT
+	 * MCS 0..7 of each stream and VHT MCS 0..9.
+	 */
+	b43_ac_convert_mcs_5g(po, lrraw, maxp_min, mcs);
+	if (acphy_pwr_scale_1db)
+		b43_ac_mcs_deduct_again(po, mcs);
+
+	/*
+	 * Rate slots B43_AC_PWROFF_*: OFDM 0..7, MCS 8..17 (20 MHz, or
+	 * 20-in-40), MCS 18..27 (40 MHz). Without acphy_rateppr the slots the
+	 * target always covered: 20 MHz OFDM; 40 MHz OFDM and MCS 0..7 of
+	 * both widths. With it every rate wl puts in its 20 MHz or 40 MHz
+	 * ppr except the 40 MHz OFDM duplicate (never sent).
+	 */
+	memcpy(rate + B43_AC_PWROFF_OFDM, ofdm, sizeof(ofdm));
+	if (!t->bw40) {
+		/* 20 MHz: ppr_set_ofdm(ppr, 0, ofdm) 0x612e0, ppr_set_mcs(ppr, 0, mcs) 0x611dc */
+		memcpy(rate + B43_AC_PWROFF_MCS, mcs, sizeof(mcs));
+		t->used = acphy_rateppr ? GENMASK(B43_AC_PWROFF_MCS + 9, 0) :
+					  GENMASK(7, 0);
+	} else if (acphy_bw40pwr & B43_AC_BW40PWR_ROW20) {
+		/*
+		 * acphy_bw40pwr 2: the 20 MHz rate set sizes the row at 40 MHz
+		 * too; the 40 MHz MCS slots carry the 20 MHz MCS values so that
+		 * acphy_rateppr has an offset for an HT40 frame.
+		 */
+		t->sbsrc = B43_AC_SBSRC_ROW20;
+		memcpy(rate + B43_AC_PWROFF_MCS, mcs, sizeof(mcs));
+		memcpy(rate + B43_AC_PWROFF_MCS40, mcs, sizeof(mcs));
+		t->used = acphy_rateppr ? GENMASK(B43_AC_PWROFF_SLOTS - 1, 0) :
+					  GENMASK(7, 0);
+	} else {
+		/* 40 MHz branch, 0x612f4..0x614e4 (ht40-2069.md) */
+		u16 sblr = 0, sbhr = 0;
+
+		if (acphy_sb20in40po_n == ARRAY_SIZE(acphy_sb20in40po)) {
+			sblr = acphy_sb20in40po[0];
+			sbhr = acphy_sb20in40po[1];
+			t->sbsrc = B43_AC_SBSRC_PARAM;
+		} else if (acphy_bw40pwr & B43_AC_BW40PWR_WL) {
+			/*
+			 * wl: phy_getintvar @0x53400 = phy_getintvar_default(pi,
+			 * name, 0), so a board without the two keys runs with
+			 * offset 0 (0x63134..0x63154 store what it returns)
+			 */
+			t->sbsrc = B43_AC_SBSRC_WL0;
+		} else {
+			t->why = "40 MHz without acphy_sb20in40po (acphy_bw40pwr 1 takes wl's 0 for the missing keys)";
+			return false;
+		}
+		/*
+		 * MCS at 40 MHz: mcsbw405g{l,m,h}po (pi+0x4930 + 4r, 0x6132c;
+		 * srom11_read stores it at 0x63240..0x63264) and bits 4..7 of
+		 * mcslr5g*po (0x61308..0x61310), deducted again with
+		 * pwr_scale_1db (0x61358)
+		 */
+		b43_ac_convert_mcs_5g(t->po40, (lrraw >> 4) & 0xf, maxp_min, mcs40);
+		if (acphy_pwr_scale_1db)
+			b43_ac_mcs_deduct_again(t->po40, mcs40);
+		/*
+		 * 20-in-40 offset byte: nibble rb of sb20in40lrpo (low) and of
+		 * sb20in40hrpo (high), shift 4, 8, 12 for rb 1, 2, 3
+		 * (0x613d4..0x61414)
+		 */
+		sh = 4 * rb;
+		off = ((sblr >> sh) & 0xf) | ((sbhr >> sh) & 0xf) << 4;
+		t->sboff = off;
+		b43_ac_add_offset(rate + B43_AC_PWROFF_OFDM, 8, 6, off); /* 0x6142c */
+		b43_ac_add_offset(mcs, 10, 5, off);		/* 0x61444 */
+		/*
+		 * OFDM 20-in-40 (ppr_set_ofdm(ppr, 3), 0x614d4), MCS 20-in-40
+		 * (ppr_set_mcs(ppr, 3)) and MCS at 40 MHz (ppr_set_mcs(ppr, 1),
+		 * 0x614c0). The OFDM duplicate (dot11agdup*po, 0x61460..
+		 * 0x61498) is never sent and not used.
+		 */
+		memcpy(rate + B43_AC_PWROFF_MCS, mcs, sizeof(mcs));
+		memcpy(rate + B43_AC_PWROFF_MCS40, mcs40, sizeof(mcs40));
+		t->used = acphy_rateppr ? GENMASK(B43_AC_PWROFF_SLOTS - 1, 0) :
+			  GENMASK(7, 0) | GENMASK(B43_AC_PWROFF_MCS + 7, B43_AC_PWROFF_MCS) |
+			  GENMASK(B43_AC_PWROFF_MCS40 + 7, B43_AC_PWROFF_MCS40);
+	}
+	for (i = 0; i < B43_AC_PWROFF_SLOTS; i++)
+		t->rv[i] = clamp(rate[i], -128, 127);
+
+	bck = max(acphy_txpwrbckof, 0);				/* pi+0x4cde, 0x606cc */
+	for (c = 0; c < a->ncores; c++) {
+		int maxp = acphy_maxp5g[4 * c + t->sb - 1];
+		int tmin = 127, tmax = 0;
+
+		d = max(maxp - maxp_min, 0);			/* 0x3c240 */
+		for (i = 0; i < B43_AC_PWROFF_SLOTS; i++) {
+			if (!(t->used & BIT(i)))
+				continue;
+			v = b43_ac_txpwr_rate_target(t, rate[i], d, maxp, bck);
+			tmin = min(tmin, v);
+			tmax = max(tmax, v);
+		}
+		/*
+		 * wlc_phy_txpower_recalc_target: tx_power_max pi[0x16a + c]
+		 * (0x607c4) is what wl's open-loop row stands for; the port's
+		 * own row without acphy_rateppr keeps every rate at or below
+		 * its target with offset 0.
+		 */
+		t->target[c] = acphy_rateppr ? tmax : tmin;
+
+		if (acphy_txpwr_idx0 >= 0 && acphy_txpwr_idx0 <= 127) {
+			t->p0[c] = acphy_txpwr_idx0;
+		} else {
+			/* guess: row 0 gives at most the board's highest rated output */
+			t->p0[c] = 0;
+			for (i = 0; i < 4; i++)
+				t->p0[c] = max(t->p0[c], acphy_maxp5g[4 * c + i]);
+		}
+		v = DIV_ROUND_UP(max(t->p0[c] - t->target[c], 0), B43_AC_TXPWR_QDBM_PER_ROW);
+		t->row[c] = min(v, B43_AC_TXPWR_ROW_MAX);
+		if (acphy_httx & B43_AC_HTTX_ROW0)	/* wl 6.37: pi_ac[16 + c] = 0 */
+			t->row[c] = 0;
+	}
+	if (!acphy_rateppr)
+		return true;
+
+	/*
+	 * Offsets, wlc_phy_txpower_recalc_target: per core tx_power_max
+	 * minus each rate (ppr_cmn_val_minus 0x6083c), maximum over the
+	 * cores into pi+0x120 (ppr_compare_max 0x60860). Then
+	 * wlc_update_txppr_offset @0x193e20 maps every rate through
+	 * wlc_stf_convert_to_s41_hdb @0x19016c (relocation 0x193fa4):
+	 * min(offset >> 1, cap), the u8 offset shifted to half dB, with
+	 * cap = clamp((target_max - 4 * min_txpower) >> 1, 0, 31)
+	 * (0x193ec8..0x193f10). target_max is wlc_phy_txpower_get_target_max
+	 * @0x55a40, the highest pi[0x16a + c] over the cores; min_txpower is
+	 * the PHY iovar 0x144 (string .rodata.str1.1 0x1104, table .rodata
+	 * 0x5dc88), whose get (wlc_phy_iovar_dispatch 0x68110) returns byte
+	 * pi+0x488d, 1 on AC PHY rev 1: 4 qdBm, B43_AC_TXPWR_MIN_QDBM.
+	 */
+	tmax_all = 0;
+	for (c = 0; c < a->ncores; c++)
+		tmax_all = max(tmax_all, t->target[c]);
+	t->cap = clamp((tmax_all - B43_AC_TXPWR_MIN_QDBM) >> 1, 0, B43_AC_PWROFF_MAX);
+	for (i = 0; i < B43_AC_PWROFF_SLOTS; i++) {
+		int o = 0;
+
+		if (!(t->used & BIT(i)))
+			continue;
+		for (c = 0; c < a->ncores; c++) {
+			int maxp = acphy_maxp5g[4 * c + t->sb - 1];
+
+			d = max(maxp - maxp_min, 0);
+			v = b43_ac_txpwr_rate_target(t, rate[i], d, maxp, bck);
+			o = max(o, t->target[c] - v);
+		}
+		t->off[i] = min(o >> 1, (int)t->cap);
+	}
+	return true;
+}
+
+/* qdBm as signed dBm with two decimals */
+#define B43_AC_QDBM_FMT	"%s%d.%02d"
+#define B43_AC_QDBM_ARG(q)	(q) < 0 ? "-" : "", abs(q) / 4, (abs(q) % 4) * 25
+
+/* n qdBm values as decimal, space-separated (acphy_bw40pwr 4) */
+#define B43_AC_QDBM_LIST_LEN	(10 * 5)
+static void b43_ac_qdbm_list(char *buf, size_t len, const s8 *v, unsigned int n)
+{
+	unsigned int i;
+	size_t pos = 0;
+
+	buf[0] = '\0';
+	for (i = 0; i < n && pos < len; i++)
+		pos += scnprintf(buf + pos, len - pos, "%s%d", i ? " " : "", v[i]);
+}
+
+static void b43_ac2069_txpwr_log(struct b43_wldev *dev,
+				 const struct b43_ac2069_chan *ci,
+				 const struct b43_ac_txpwr *t, bool ok)
+{
+	const struct b43_phy_ac *a = dev->phy.ac;
+	char l1[B43_AC_QDBM_LIST_LEN], l2[B43_AC_QDBM_LIST_LEN], l3[B43_AC_QDBM_LIST_LEN];
+	int est;
+	u8 c;
+
+	if (!ok) {
+		b43warn(dev->wl, "radio 0x2069: channel %u TX power: %s, lowest-power row %u on every core\n",
+			ci->channel, t->why, B43_AC_TXPWR_ROW_MAX);
+		return;
+	}
+	for (c = 0; c < a->ncores; c++) {
+		est = t->p0[c] - B43_AC_TXPWR_QDBM_PER_ROW * t->row[c];
+		b43info(dev->wl, "radio 0x2069: channel %u%s sub-band %u core %u TX power: target " B43_AC_QDBM_FMT " dBm (regulatory " B43_AC_QDBM_FMT ", user " B43_AC_QDBM_FMT "), row %u, estimated " B43_AC_QDBM_FMT " dBm (row 0 assumed " B43_AC_QDBM_FMT ")\n",
+			ci->channel, t->bw40 ? " (40 MHz)" : "", t->sb, c,
+			B43_AC_QDBM_ARG(t->target[c]),
+			B43_AC_QDBM_ARG(t->reg), B43_AC_QDBM_ARG(t->user), t->row[c],
+			B43_AC_QDBM_ARG(est), B43_AC_QDBM_ARG(t->p0[c]));
+	}
+	if (t->bw40 && acphy_bw40pwr) {
+		/*
+		 * acphy_bw40pwr: which 40 MHz model sized the rows and where the
+		 * 20-in-40 offsets came from; with 4 the board rate values too
+		 * (qdBm before the limits, OFDM 6..54, MCS 0..9, MCS 0..9 at
+		 * 40 MHz) and the slots that sized the row (bit i = slot i)
+		 */
+		b43info(dev->wl, "BW40PWR channel %u sub-band %u: %s, 20-in-40 offset byte 0x%02x, po20 0x%08x po40 0x%08x (%s), rows %u/%u/%u (acphy_bw40pwr 0x%x)\n",
+			ci->channel, t->sb,
+			t->sbsrc == B43_AC_SBSRC_ROW20 ? "20 MHz rate set and row (acphy_bw40pwr 2)" :
+			t->sbsrc == B43_AC_SBSRC_WL0 ? "wl's 40 MHz target, sb20in40 offsets 0 as wl for the missing keys (acphy_bw40pwr 1)" :
+			t->sbsrc == B43_AC_SBSRC_PARAM ? "wl's 40 MHz target, sb20in40 offsets from acphy_sb20in40po" :
+			"no 40 MHz target",
+			t->sboff, t->po20, t->po40,
+			acphy_mcsbw5gpo_n == ARRAY_SIZE(acphy_mcsbw5gpo) ? "param" : "sprom",
+			t->row[0], t->row[1], t->row[2], acphy_bw40pwr);
+		if (acphy_bw40pwr & B43_AC_BW40PWR_LOG) {
+			b43_ac_qdbm_list(l1, sizeof(l1), t->rv + B43_AC_PWROFF_OFDM, 8);
+			b43_ac_qdbm_list(l2, sizeof(l2), t->rv + B43_AC_PWROFF_MCS, 10);
+			b43_ac_qdbm_list(l3, sizeof(l3), t->rv + B43_AC_PWROFF_MCS40, 10);
+			b43info(dev->wl, "BW40PWR channel %u board qdBm: OFDM20in40 [%s] MCS20in40 [%s] MCS40 [%s], slots sizing the row 0x%07x, maxp_min %d\n",
+				ci->channel, l1, l2, l3, t->used, t->maxp_min);
+		}
+	}
+	if (!acphy_rateppr)
+		return;
+	/* half dB below the row in hex, per B43_AC_PWROFF_* slot; 00 for a slot not covered */
+	b43info(dev->wl, "radio 0x2069: channel %u%s RATEPPR po 0x%08x/0x%08x (%s) cap %u, half dB (hex) OFDM %*phD MCS %*phD MCS40 %*phD\n",
+		ci->channel, t->bw40 ? " (40 MHz)" : "", t->po20, t->po40,
+		acphy_mcsbw5gpo_n == ARRAY_SIZE(acphy_mcsbw5gpo) ? "param" : "sprom",
+		t->cap, 8, t->off + B43_AC_PWROFF_OFDM, 10, t->off + B43_AC_PWROFF_MCS,
+		10, t->off + B43_AC_PWROFF_MCS40);
+}
+
+/*
+ * The offsets go to the frames together with the rows they belong to:
+ * all 0 without acphy_rateppr or when the computation fell back to the
+ * lowest-power row (t->off is zeroed then).
+ */
+static bool b43_ac2069_txpwr_set_off(struct b43_phy_ac *a,
+				     const struct b43_ac_txpwr *t)
+{
+	BUILD_BUG_ON(sizeof(a->pwroff) != sizeof(t->off));
+	if (!memcmp(a->pwroff, t->off, sizeof(a->pwroff)))
+		return false;
+	memcpy(a->pwroff, t->off, sizeof(a->pwroff));
+	return true;
+}
+
+/*
+ * PHY control 1 power field for one frame (xmit.c): the rate's offset in
+ * half dB, wlc_stf_get_204080_pwrs @0x193990 picking the stf+0x2c ppr
+ * entry for the rspec (20 MHz byte 0 for a non-beamformed frame,
+ * 0x11c8c8..0x11c8e8), plus acphy_rateppr_htadd on HT frames, capped at
+ * the field's 31.
+ */
+u8 b43_phy_ac_txpwroff(struct b43_wldev *dev, unsigned int slot, bool ht)
+{
+	const struct b43_phy_ac *a = dev->phy.ac;
+	unsigned int v = 0;
+
+	if (!a)
+		return 0;
+	if (acphy_rateppr && slot < ARRAY_SIZE(a->pwroff))
+		v = a->pwroff[slot];
+	if (ht)
+		v += READ_ONCE(acphy_rateppr_htadd);
+	return min_t(unsigned int, v, B43_AC_PWROFF_MAX);
+}
+
+/*
+ * wlc_phy_rssi_compute_acphy (.text.fastpath 0x26c), rssi-rev42.md: the
+ * received signal strength in dBm from the per-core bytes of a core rev >= 40
+ * RX status, raw[c] = byte 9 + c. The caller has checked the PHY RX status
+ * valid bit (wlc_phy_rssi_compute 0x644..0x65c). PHY rev 1 skips the CCK
+ * workaround of revs 2, 5, 6 (0x2b8..0x300). Returns -ENODEV before radio-on
+ * (no core count), else 0 with *dbm set.
+ */
+int b43_phy_ac_rssi(struct b43_wldev *dev, const u8 *raw, s8 *dbm)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	const struct b43_ac2069_chan *ci;
+	u8 n = a ? min_t(u8, a->ncores, 3) : 0;
+	u8 mask, c, sb = 0, bw;
+	s16 rssi[3], t, d, r, out = 0;
+	bool first = true;
+
+	if (!n)
+		return -ENODEV;
+	/*
+	 * wlc_phy_upd_gain_wrt_temp_phy @0x661bc: round(14 * dt / 50) with
+	 * dt = min(temp, 105) - rawtempsense. temp is pi_ac[0x97c], which
+	 * attach sets to rawtempsense (0x46910..0x46920) and only
+	 * wlc_phy_tempsense_acphy (0x3df60) changes; that is not ported, so
+	 * dt = 0 here, as in wl before its first tempsense.
+	 */
+	t = 0;
+	ci = b43_ac2069_find_chan(a->chanspec & 0xff);
+	if (ci)
+		sb = b43_ac2069_chan_freq_range(ci);		/* 0x3c0 */
+	bw = a->bw == 0x2000 ? 2 : a->bw == 0x1800 ? 1 : 0;	/* 0x3e4..0x4a8 */
+
+	for (c = 0; c < n; c++) {
+		rssi[c] = (s8)raw[c];				/* 0x27c..0x32c */
+		if (rssi[c]) {					/* 0x35c */
+			/* 0x364..0x398: rounded half away from zero */
+			d = 2 * (s8)a->rx_gainerr[c] - t;
+			r = d < 0 ? -((2 - d) >> 2) : (d + 2) >> 2;
+			rssi[c] -= r;
+		}
+		if (sb)						/* 0x3b8..0x4b8, 5 GHz */
+			rssi[c] += a->rssicorr5g[c][sb - 1][bw];
+		rssi[c] = max_t(s16, rssi[c], -128);		/* 0x4e8..0x500 */
+	}
+	/*
+	 * 0x51c..0x5d8: one core is taken as is; otherwise over the cores in
+	 * sh+0x93 (rxchain) with sh+0x94, the merge mode, 0 = maximum
+	 * (wlc_phy_shared_attach 0x53ba8). Deviation: before the first channel
+	 * set the mask is not loaded yet, so all cores count.
+	 */
+	mask = n == 1 ? 1 : a->coremask & ((1 << n) - 1);
+	if (!mask)
+		mask = (1 << n) - 1;
+	for (c = 0; c < n; c++) {
+		if (!(mask & BIT(c)))
+			continue;
+		if (first || rssi[c] > out)
+			out = rssi[c];
+		first = false;
+	}
+	/* wlc_phy_rssi_compute stores the result as a byte (0xbb8..0xbc0) */
+	*dbm = clamp_t(s16, out, -128, 127);
+	return 0;
+}
+
+/*
+ * wlc_phy_set_crs_min_pwr_acphy(pi, thr, off1, off2) @0x17758,
+ * crs-min-pwr-cal-rev1.md, PHY rev 1 (flag f = 0, so thr_hi = thr and no
+ * rev 3/8 offset). Core 0 gets the threshold, cores 1 and 2 the offsets
+ * from core 0, for the cores in the core mask.
+ */
+static void b43_ac_set_crs_min_pwr(struct b43_wldev *dev, u8 thr, s8 off1,
+				   s8 off2)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	/* core 0, 0x179d8..0x17d84: (reg, uses thr_hi) */
+	static const u16 c0[8] = { 0x324, 0x330, 0x321, 0x32d, 0x32a, 0x336, 0x327, 0x333 };
+	u16 thr_hi, o1, o1s, o2;
+	unsigned int i;
+	u8 c;
+
+	if (thr == 0)						/* 0x177b8..0x17808 */
+		thr = 54;
+	thr_hi = thr;						/* 0x1786c, f == 0 */
+	o1 = (u16)off1;						/* 0x17958..0x17994 */
+	o1s = (u16)(s16)off1;
+	o2 = (u16)off2;
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x1799c..0x17d98 */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		if (c == 0) {
+			for (i = 0; i < ARRAY_SIZE(c0); i++)
+				b43_ac_phy_mod(dev, c0[i], 0xff,
+					       (i & 1) ? thr_hi : thr);
+		} else if (c == 1) {				/* 0x17aa4.. */
+			b43_ac_phy_mod(dev, 0x910, 0xff00, o1 << 8);
+			b43_ac_phy_mod(dev, 0x910, 0xff, o1);
+			b43_ac_phy_mod(dev, 0x912, 0xff00, o1s << 8);
+			b43_ac_phy_mod(dev, 0x912, 0xff, o1s);
+			b43_ac_phy_mod(dev, 0x911, 0xff, o1);
+			b43_ac_phy_mod(dev, 0x911, 0xff00, o1 << 8);
+			b43_ac_phy_mod(dev, 0x913, 0xff, o1s);
+			b43_ac_phy_mod(dev, 0x913, 0xff00, o1s << 8);
+		} else if (c == 2) {				/* 0x17c88.. */
+			b43_ac_phy_mod(dev, 0xb10, 0xff00, o2 << 8);
+			b43_ac_phy_mod(dev, 0xb10, 0xff, o2);
+			b43_ac_phy_mod(dev, 0xb12, 0xff00, o2 << 8);
+			b43_ac_phy_mod(dev, 0xb12, 0xff, o2);
+			b43_ac_phy_mod(dev, 0xb11, 0xff, o2);
+			b43_ac_phy_mod(dev, 0xb11, 0xff00, o2 << 8);
+			b43_ac_phy_mod(dev, 0xb13, 0xff, o2);
+			b43_ac_phy_mod(dev, 0xb13, 0xff00, o2 << 8);
+		}
+	}
+}
+
+/*
+ * wlc_phy_crs_min_pwr_cal_acphy(pi, 1) @0x3a68c, chan change step 14
+ * (0x3f3d8), crs-min-pwr-cal-rev1.md, 20, 40 (ht40-2069.md) or 80 MHz
+ * (vht80-2069.md), PHY rev 1: the threshold per core from the stored noise
+ * level of the sub-band (crs_nf, -30 from attach on the first set: 20 MHz
+ * index 4, threshold 58; 40 MHz index 6, threshold 60; 80 MHz index 7,
+ * threshold 61). Only the hardware part and
+ * the noise levels are kept; the pi_ac bookkeeping bytes 0x37c, 66, 67, 68
+ * and 61..63 have no reader in this port.
+ */
+static void b43_ac2069_crs_min_pwr_cal(struct b43_wldev *dev,
+				       const struct b43_ac2069_chan *ci)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u8 bw = b43_ac_bw_idx(phy_ac->chanspec);
+	/* 0x3a694..0x3a6f4: C.3158 / C.3159 / C.3160 copied to sp+40/24/8 */
+	const u8 *tbl = bw == 2 ? b43_ac_crs_min_pwr_80 :
+			bw == 1 ? b43_ac_crs_min_pwr_40 : b43_ac_crs_min_pwr_20;
+	u8 thr[4] = { 54 };					/* 0x3a704, 0x3a760 */
+	u8 sb = b43_ac2069_chan_freq_range(ci);			/* 0x3a764 */
+	s8 nf, off1 = 0, off2 = 0;				/* 0x3a800, 0x3a808 */
+	int idx;
+	u8 c;
+
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x3a810..0x3aaf8 */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		/*
+		 * mode 1, 0x3a950..0x3a9ac: the stored byte, plus 3 at 40 MHz,
+		 * plus 7 at 80 MHz (0x3a99c..0x3a9a8: the value, not the
+		 * slot), as a byte
+		 */
+		nf = phy_ac->crs_nf[sb][c];
+		if (bw)
+			nf = (s8)(u8)(nf + (bw == 2 ? 7 : 3));
+		/*
+		 * 0x3a9b0..0x3aa08: + 34 at 20 MHz, + 33 at 40 MHz, + 30 at
+		 * 80 MHz (0x3aa04), as s8
+		 */
+		idx = (s8)(u8)(nf + (bw == 2 ? 30 : bw ? 33 : 34));
+		idx = clamp(idx, 0, 14);			/* 0x3aa14..0x3aa3c */
+		/*
+		 * 0x3a708..0x3a750 (+4, rev <= 1), 0x3aa4c..0x3aaa4 by
+		 * bandwidth (80 MHz: sp+8, 0x3aa88..0x3aaa0)
+		 */
+		thr[c] = tbl[idx] + 4;
+		if (c == 1)					/* 0x3aaa8..0x3aae0 */
+			off1 = (s8)(u8)(thr[1] - thr[0]);
+		else if (c == 2)
+			off2 = (s8)(u8)(thr[2] - thr[0]);
+	}
+	/* 6, 0x3ab1c..0x3ab3c: pi_ac[66], the floor the desense apply uses */
+	phy_ac->crs_thr_max = max3(thr[0], thr[1], thr[2]);
+	/* 7, 0x3ab40..0x3ab54: the desense code applies its own threshold */
+	if (phy_ac->desense_total[9])
+		return;
+	/*
+	 * 9, 0x3abb8..0x3abf0: wlapi_suspend_mac_and_wait, wlc_phyreg_enter
+	 * (a ucode wake override), the write, wlc_phyreg_exit,
+	 * wlapi_enable_mac. In b43 terms, an inference: b43_mac_suspend /
+	 * b43_mac_enable, and b43_power_saving_ctl_bits(B43_PS_AWAKE) / (0)
+	 * for the wake override.
+	 */
+	b43_mac_suspend(dev);
+	b43_power_saving_ctl_bits(dev, B43_PS_AWAKE);
+	b43_ac_set_crs_min_pwr(dev, thr[0], off1, off2);	/* 0x3abdc */
+	b43_power_saving_ctl_bits(dev, 0);
+	b43_mac_enable(dev);
+}
+
+/*
+ * wlc_phy_set_tx_iir_coeffs.clone.27(pi, type) @0x20afc,
+ * tx-iir-coeffs-rev1.md, PHY rev 1: ten full writes to PHY 0x0ec..0x0f5,
+ * set A for type 0, set B for type 1, nothing for any other type.
+ */
+static void b43_ac2069_set_tx_iir_coeffs(struct b43_wldev *dev, u8 type)
+{
+	static const u16 set[2][10] = {
+		/* A, 0x20ba0..0x20c2c */
+		{ 0x0a94, 0x0373, 0x0005, 0x0a93, 0x0298, 0x0004, 0x0a52,
+		  0x021d, 0x0004, 0x0080 },
+		/* B, 0x20c38..0x20cd4 */
+		{ 0x0b54, 0x0290, 0x0004, 0x0a40, 0x0290, 0x0005, 0x0a06,
+		  0x0240, 0x0005, 0x0080 },
+	};
+	unsigned int i;
+
+	if (type > 1)						/* 0x20c34 */
+		return;
+	for (i = 0; i < ARRAY_SIZE(set[0]); i++)
+		b43_phy_write(dev, 0x0ec + i, set[type][i]);	/* last at 0x20ee0 */
+}
+
+/*
+ * NVRAM pci/2/1/rpcal5gb0..3 (wl's sh+186..192). b43 cannot read them from
+ * the SPROM, and on the R6400 they are not zero (rpcal5gb0 0x96e7,
+ * rpcal5gb3 0xa30b, recipcoeffs-rev1.md), so they come in as a parameter
+ * and the channel set refuses without them.
+ */
+static ushort acphy_rpcal5g[4];
+static int acphy_rpcal5g_n;
+module_param_array_named(acphy_rpcal5g, acphy_rpcal5g, ushort, &acphy_rpcal5g_n, 0444);
+MODULE_PARM_DESC(acphy_rpcal5g,
+	"NVRAM rpcal5gb0,rpcal5gb1,rpcal5gb2,rpcal5gb3 of the 5 GHz radio (R6400: 0x96e7,0,0,0xa30b); the 5 GHz channel set refuses without them");
+
+/*
+ * One 24-bit coefficient of wlc_phy_populate_recipcoeffs_acphy, PHY rev <= 1
+ * (0x3e16c..0x3e208): phase byte x = quadrant (bits 6..7) and step (bits
+ * 0..5) of 90/64 degrees; sine and cosine from the quarter sine table, the
+ * cosine read one step further ((k + 1) steps, as wl does); 11-bit two's
+ * complement parts, bit 22 set.
+ */
+static u32 b43_ac_recip_coeff(u8 x)
+{
+	u16 k = x & 0x3f, q = (x >> 6) & 3;
+	s16 s = b43_ac_recip_sin[k], co = b43_ac_recip_sin[63 - k];
+	s16 re, im;
+
+	switch (q) {						/* 0x3e188..0x3e1d4 */
+	case 0:
+		re = co;
+		im = -s;
+		break;
+	case 1:
+		re = -s;
+		im = -co;
+		break;
+	case 2:
+		re = -co;
+		im = s;
+		break;
+	default:
+		re = s;
+		im = co;
+		break;
+	}
+	if (re < 0)						/* 0x3e1d8..0x3e1fc */
+		re += 0x800;
+	if (im < 0)
+		im += 0x800;
+	return (u16)re | 0x400000 | (u32)(u16)im << 11;	/* 0x3e204..0x3e208 */
+}
+
+/*
+ * wlc_phy_populate_recipcoeffs_acphy(pi) @0x3e09c, chan change step 18
+ * (bl at 0x3f5c0), recipcoeffs-rev1.md, PHY rev 1: table 0x11 entries 0..11
+ * from the fixed head, 12..459 the entry E built from the sub-band's rpcal
+ * word, 460..463 zero, one 48-bit write each, inside a PHY 0x19e bit 1
+ * bracket.
+ */
+static void b43_ac2069_populate_recipcoeffs(struct b43_wldev *dev,
+					    const struct b43_ac2069_chan *ci)
+{
+	static const u16 z[3];					/* 0x3e0d4 */
+	u8 sb = b43_ac2069_chan_freq_range(ci);			/* 0x3e0f0 */
+	u16 w, e[3], b1;
+	u64 E;
+	unsigned int i;
+
+	/* 2, 0x3e0d8..0x3e0e4: txchain (sh+144) is 7 here, so no return */
+	/* 3: u16 sh+184 + 2*sb; sb 1..4 are rpcal5gb0..3 (sb 0 is 2 GHz) */
+	w = acphy_rpcal5g[sb - 1];
+	E = b43_ac_recip_coeff(w & 0xff) |
+	    (u64)b43_ac_recip_coeff(w >> 8) << 24;		/* 4 */
+	e[0] = E & 0xffff;					/* 0x3e210..0x3e23c */
+	e[1] = (E >> 16) & 0xffff;
+	e[2] = (E >> 32) & 0xffff;
+	b43info(dev->wl, "radio 0x2069: channel %u sub-band %u rpcal5gb%u 0x%04x, reciprocity entry 0x%04x%04x%04x\n",
+		ci->channel, sb, sb - 1, w, e[2], e[1], e[0]);
+
+	b1 = b43_phy_read(dev, 0x19e) & 0x2;			/* 5, 0x3e260 */
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x3e280 */
+	for (i = 0; i < 12; i++)				/* 6, 0x3e29c..0x3e2c0 */
+		b43_ac_tbl_write(dev, 0x11, 1, i, 48, b43_ac_recip_head[i]);
+	for (; i < 460; i++)					/* 0x3e2c8..0x3e2e8 */
+		b43_ac_tbl_write(dev, 0x11, 1, i, 48, e);
+	for (; i < 464; i++)					/* 0x3e2f0..0x3e310 */
+		b43_ac_tbl_write(dev, 0x11, 1, i, 48, z);
+	b43_ac_phy_mod(dev, 0x19e, 0x2, b1);			/* 7, 0x3e368 */
+}
+
+/*
+ * wlc_phy_set_regtbl_on_chan_change_acphy(pi, ci) @0x3e37c,
+ * chan-change-rev1.md, PHY rev 1, radio 0x2069, chip 0x4360, 5 GHz, 20 MHz
+ * (bw 0), 40 MHz (bw 1, ht40-2069.md) or 80 MHz (bw 2, vht80-2069.md); ci is
+ * the tuning entry of the chanspec's channel byte, the center channel at 40
+ * and 80 MHz. Step numbers are the decode's.
+ */
+static void b43_ac2069_chan_change(struct b43_wldev *dev,
+				   const struct b43_ac2069_chan *ci)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	/* 1, 0x3e39c..0x3e3b4; 2: the 0x1a6/0x1a7 block is PHY rev 4/7 only */
+	u8 bw = b43_ac_bw_idx(phy_ac->chanspec);
+	/* the 0x5c4 * bw block (0x3e4e8..0x3e510, 0x3e6ec..0x3e700) */
+	const struct b43_ac_farrow *rxf = bw == 2 ? b43_ac_rx_farrow_tbl_80 :
+					  bw ? b43_ac_rx_farrow_tbl_40 :
+					       b43_ac_rx_farrow_tbl_20;
+	const struct b43_ac_farrow *txf = bw == 2 ? b43_ac_tx_farrow_dac1_tbl_80 :
+					  bw ? b43_ac_tx_farrow_dac1_tbl_40 :
+					       b43_ac_tx_farrow_dac1_tbl_20;
+	const struct b43_ac_farrow *f;
+	unsigned int i;
+	u16 saved, v31c;
+	u8 c, r, cck;
+
+	/* 3, 0x3e4e8..0x3e6a4: first rx_farrow_tbl entry whose u8 channel matches */
+	for (i = 0; i < ARRAY_SIZE(b43_ac_rx_farrow_tbl_20); i++)
+		if ((u8)rxf[i].ch == ci->channel)
+			break;
+	if (i < ARRAY_SIZE(b43_ac_rx_farrow_tbl_20)) {
+		f = &rxf[i];
+		b43_phy_write(dev, 0x19a, f->f[0]);		/* 4, 0x3e5b0 */
+		b43_phy_write(dev, 0x19b, f->f[1]);		/* 0x3e5d0 */
+		b43_phy_write(dev, 0x19c, f->f[2]);		/* 0x3e5ec */
+		b43_phy_write(dev, 0x199, f->f[3]);		/* 0x3e60c */
+		b43_phy_write(dev, 0x1a1, f->f[0]);		/* 0x3e62c */
+		b43_phy_write(dev, 0x1a2, f->f[1]);		/* 0x3e64c */
+		b43_phy_write(dev, 0x1a3, f->f[2]);		/* 0x3e66c */
+		b43_phy_write(dev, 0x1a0, f->f[3]);		/* 0x3e688 */
+		/*
+		 * 4a, 0x3f898 then 0x3e6bc..0x3e994: TX farrow, u16 channel
+		 * match. pi_ac[0] picks the dac1/2/3 table; its only writer
+		 * found is wlc_phy_attach_acphy, 1 (0x45be0): dac1.
+		 */
+		for (i = 0; i < ARRAY_SIZE(b43_ac_tx_farrow_dac1_tbl_20); i++)
+			if (txf[i].ch == ci->channel)
+				break;
+		if (i < ARRAY_SIZE(b43_ac_tx_farrow_dac1_tbl_20)) {
+			f = &txf[i];
+			b43_phy_write(dev, 0x1603, f->f[0]);	/* 0x3e818 */
+			b43_phy_write(dev, 0x1602, f->f[1]);	/* 0x3e874 */
+			b43_phy_write(dev, 0x1607, f->f[2]);	/* 0x3e8d0 */
+			b43_phy_write(dev, 0x1606, f->f[3]);	/* 0x3e92c */
+			/* 0x3e938: read 0x601, write 0x1601 (chip 0x4360) */
+			b43_phy_write(dev, 0x1601, b43_phy_read(dev, 0x601));
+		}
+	}
+
+	/*
+	 * 5, 0x3e998..0x3eaf4: av/vmid from avvmid_set, set pi_ac[0x475]
+	 * (pdgain5g, 4 here), row from the sub-band through CSWTCH.5735 (the
+	 * identity on 0..4, else row 0). pi_ac[0x38f] is boardflags3 bit 30
+	 * (attach 0x45fe4..0x45fe8), 0 here, so the default table is used.
+	 */
+	r = b43_ac2069_chan_freq_range(ci);			/* 0x3e9d0 */
+	if (r > 4)						/* 0x3e9d4..0x3e9e0 */
+		r = 0;
+	saved = b43_phy_read(dev, 0x19e) & 0x2;			/* 6, 0x3eaf8 */
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x3eb1c */
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 7, 0x3eb38..0x3ec40 */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		b43_ac_tbl_read16(dev, 7, 0x3cd + 16 * c);	/* 0x3eba4, unused */
+		b43_ac_tbl_write16(dev, 7, 0x3cd + 16 * c,
+				   (b43_ac_avvmid_set4[r][3 + c] << 3) |
+				   (b43_ac_avvmid_set4[r][c] & 7));	/* 0x3ebdc */
+	}
+	b43_ac_phy_mod(dev, 0x19e, 0x2, saved);			/* 8, 0x3ec5c */
+	/* 9: radio major rev 2 only */
+
+	/* 10, 0x3f1a0..0x3f1fc: tuning entry words 104..114 (ci->bw) */
+	for (i = 0; i < ARRAY_SIZE(ci->bw); i++)
+		b43_phy_write(dev, 0x371 + i, ci->bw[i]);
+	/*
+	 * 11: 40 MHz with the upper sideband (chanspec & 0x3f00 == 0x1900,
+	 * 0x3f278..0x3f2b4) sets 0x164 bit 4 and 0x30f bits 14..15 = 1; 40 MHz
+	 * lower (0x3f280..0x3f28c) and 20 MHz (0x3f2b8..0x3f2e4) clear both.
+	 * 80 MHz (0x3f200..0x3f26c, vht80-2069.md): 0x30f bits 14..15 = the
+	 * sideband 0..3 (values 0, 0x4000, 0x8000, 0xc000), 0x164 untouched
+	 * (the bandwidth change cleared bit 4 at 0x2bd40).
+	 */
+	if (bw == 2) {
+		b43_ac_phy_mod(dev, 0x30f, 0xc000,
+			       (phy_ac->chanspec & 0x0300) << 6); /* 0x3f2e4 */
+	} else if (bw == 1 &&
+	    (phy_ac->chanspec & 0x3f00) == (B43_AC_CHSPEC_BW_40 | B43_AC_CHSPEC_SB_U)) {
+		b43_ac_phy_mod(dev, 0x164, 0x10, 0x10);		/* 0x3f2a0 */
+		b43_ac_phy_mod(dev, 0x30f, 0xc000, 0x4000);	/* 0x3f2e4 */
+	} else {
+		b43_ac_phy_mod(dev, 0x164, 0x10, 0);		/* 0x3f2d0 */
+		b43_ac_phy_mod(dev, 0x30f, 0xc000, 0);		/* 0x3f2e4 */
+	}
+	/*
+	 * 12, 0x3f2e8..0x3f388: 5 GHz, 0xbf at 20 and 40 MHz (0x3f300), 0x100
+	 * at 80 MHz on PHY rev <= 1 (0x3f308..0x3f310)
+	 */
+	v31c = bw == 2 ? 0x100 : 0xbf;
+	b43_phy_write(dev, 0x31c, v31c);
+	b43_phy_write(dev, 0x31d, v31c);
+	b43_phy_write(dev, 0x31e, v31c);
+	b43_phy_write(dev, 0x31f, v31c);
+	/* 13, 0x3f38c..0x3f3d4: pi_ac state bytes cleared, no hardware */
+	b43_ac2069_crs_min_pwr_cal(dev, ci);			/* 14, 0x3f3d8 */
+	/* 15: channel 14 only */
+	/*
+	 * 16, 0x3f4b0..0x3f510, from pi_ac[0x9a6]: NVRAM cckdigfilttype, absent
+	 * on this unit (recipcoeffs-rev1.md, read-only nvram show 2026-10-06
+	 * 01:56 UTC), so wlc_phy_attach_acphy stores 1 (0x46240..0x46244).
+	 */
+	cck = 1;
+	b43_ac_phy_mod(dev, 0x3a9, 0x7f,
+		       (b43_phy_read(dev, 0x3a9) & 0x3f) | (cck & 2) << 5); /* 0x3f4dc */
+	b43_ac_phy_mod(dev, 0x3a9, 0x800, ((cck >> 2) & 1) << 11); /* 0x3f4fc */
+	b43_ac2069_set_tx_iir_coeffs(dev, cck & 1);		/* 0x3f510 */
+	/* 17: PHY rev 2/5/6 only */
+	b43_ac2069_populate_recipcoeffs(dev, ci);		/* 18, 0x3f5c0 */
+	/* 19: PHY rev 6 only */
+	/* 20, 0x3f7f4..0x3f890: femctrl 3 (pi_ac[0x382]) and these channels */
+	switch (ci->freq) {
+	case 5180: case 5190: case 5310: case 5320: case 5500: case 5510:
+		b43_ac2069_mod(dev, 0x892, 0xff00, 0xa000);
+		break;
+	}
+}
