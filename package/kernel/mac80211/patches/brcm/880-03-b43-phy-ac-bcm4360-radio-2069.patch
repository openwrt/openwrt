+	b43_ac_tx_dacbuf_cap(dev, 0x1ff, phy_ac->rc_dacbuf, -1, -1); /* 4, 0x2d54c */
+	/* 5..7: PHY rev <= 1 scales rc0 (0x2d564..0x2d58c) */
+	b43_ac_analog_rx_lpf(dev, 1, -1, -1, -1, (0xdd * rc0) >> 8, rc1, -1);
+	b43_ac_analog_rx_lpf(dev, 2, -1, -1, -1, (0xd7 * rc0) >> 8, rc1, -1);
+	b43_ac_analog_rx_lpf(dev, 4, -1, -1, -1, (0xd7 * rc0) >> 8, rc1, -1);
