+/*
+ * The bandwidth fields of both cals' PHY setup: the tables above and
+ * b43_ac_rxcal_phy_mods1 hold the 20 MHz values, this gives the value for
+ * bw index b (txiqlo-cal-2069.md, "40 and 80 MHz"). k is the setup
+ * constant 0xd5eb / 0x45ea / 0x7f8; both setups derive five fields from it
+ * (TX 0x1a304..0x1a34c, RX 0x33a28..0x33a68), the TX setup three more from
+ * b + 3 (0x1a308..0x1a368: [sp+28], [sp+60], [sp+64]). At b = 0 every
+ * field equals the table's value. Other {reg, mask} pairs do not depend on
+ * the bandwidth on this board's path.
+ */
+static u16 b43_ac_cal_bw_field(u16 reg, u16 mask, u16 val20, u8 b, bool tx)
+{
+	static const u16 bw_k[3] = { 0xd5eb, 0x45ea, 0x07f8 };
+	u16 k = bw_k[b];
+
+	switch ((u32)reg << 16 | mask) {
+	case 0x073a0007:		/* TX 0x1b260, RX 0x33cac */
+		return k & 3;
+	case 0x0739007e:		/* TX 0x1b310, RX 0x33d6c */
+		return ((k >> 3) & 0x3f) << 1;
+	case 0x073a0008:		/* TX 0x1b3c0, RX 0x33e1c */
+		return ((k >> 9) & 1) << 3;
+	case 0x073a0010:		/* TX 0x1b470, RX 0x33ecc */
+		return ((k >> 10) & 1) << 4;
+	case 0x073a0060:		/* TX 0x1b520, RX 0x33f7c */
+		return (k >> 6) & 0x40;
+	case 0x07350700:		/* TX 0x1b6d8, [sp+60] */
+		return tx ? (b + 3) << 8 : val20;
+	case 0x07353800:		/* TX 0x1b894, [sp+64], rev <= 1 */
+		return tx ? (b + 3) << 11 : val20;
+	case 0x07380007:		/* TX 0x1b8ec, [sp+28], rev <= 1 */
+		return tx ? b + 3 : val20;
+	}
+	return val20;
+}
