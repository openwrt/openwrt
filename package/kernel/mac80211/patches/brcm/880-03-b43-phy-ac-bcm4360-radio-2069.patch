+static uint acphy_httx;
+module_param_named(acphy_httx, acphy_httx, uint, 0644);
+MODULE_PARM_DESC(acphy_httx,
+	"HT TX test hook, TX power control block, bitmask: 1 wl's txpwrctrl_pwr_setup registers (loop off), 2 hardware loop on as wl 7.14 (implies 1), 4 open-loop gain row 0 as wl 6.37 (default 0)");
