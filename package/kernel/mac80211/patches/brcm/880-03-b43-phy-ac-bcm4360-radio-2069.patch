+/*
+ * wlc_phy_set_regtbl_on_bw_change_acphy @0x2bc68, PHY rev 1, 5 GHz, chip
+ * 0x4360, 20 MHz (bw-change-rev1-20mhz.md), 40 MHz
+ * (bw-change-rev1-40mhz.md) or 80 MHz (bw-change-rev1-80mhz.md), b =
+ * b43_ac_bw_idx(). Every row of the decodes' tables, in their order.
+ */
+static void b43_ac2069_bw_change(struct b43_wldev *dev, u8 b)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	const struct b43_ac2069_bwvals *v = &b43_ac2069_bwvals[b];
+	u16 saved = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x2bcb0 */
+	unsigned int i;
+	u8 c;
+
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x2bcc8 */
+	b43_ac_phy_mod(dev, 0x076, 0x7, v->r076);		/* 0x2bcf8 */
+	b43_ac_phy_mod(dev, 0x140, 0x800, v->r140);		/* 0x2bd1c */
+	b43_ac_phy_mod(dev, 0x164, 0x10, v->r164);		/* 0x2bd40 */
+	b43_ac_phy_mod(dev, 0x180, 0x1f, v->r180);		/* 0x2bd70 */
+	for (i = 0; i < ARRAY_SIZE(v->v181); i++)		/* 0x2bdbc..0x2c2dc */
+		b43_ac_phy_mod(dev, 0x181 + i, 0x7ff, v->v181[i]);
+	b43_ac_phy_mod(dev, 0x1b5, 0xff, v->r1b5);		/* 0x2c30c */
+	/* 5 GHz only (0x2c318) */
+	b43_ac_phy_mod(dev, 0x250, 0xff, v->r250);		/* 0x2c33c */
+	b43_ac_phy_mod(dev, 0x261, 0xfff, v->r261);		/* 0x2c360 */
+	b43_ac_phy_mod(dev, 0x262, 0xfff, v->r262);		/* 0x2c384 */
+	b43_ac_phy_mod(dev, 0x263, 0xfff, v->r263);		/* 0x2c3a8 */
+	b43_ac_phy_mod(dev, 0x312, 0xff, v->r312);		/* 0x2c3d8 */
+	b43_ac_phy_mod(dev, 0x313, 0xff00, v->r313);		/* 0x2c408 */
+	/* 0x2c40c..0x2c45c: chip 0x4335 only */
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x2c468..0x2c5e4 */
+		b43_ac_phy_mod(dev, 0x6ed + (c << 9), 0xff, v->r6ed);	/* 0x2c4e8 */
+		b43_ac_phy_mod(dev, 0x6ef + (c << 9), 0xff, v->r6ef);	/* 0x2c55c */
+		/* mask 0xff00 for every core on rev 1 (0x2c560..0x2c5a4) */
+		b43_ac_phy_mod(dev, 0x6ef + (c << 9), 0xff00, v->r6ef_hi); /* 0x2c5d8 */
+	}
+	/*
+	 * 0x2c5e8..0x2c770: r7 = 15 (20 MHz, 0x2c644), 30 (40 MHz, 0x2c61c)
+	 * or 60 (80 MHz, 0x2c5fc); rev 1 takes 0x2c6a0 for every core
+	 */
+	for (c = 0; c < phy_ac->ncores; c++)
+		b43_ac_phy_mod(dev, 0x6ef + (c << 9), 0xff, v->r6ef2);	/* 0x2c764 */
+	/*
+	 * 0x2c794: set_analog_tx_lpf(pi, 0x100, -1, x, x, -1, -1, -1), x = 3
+	 * (20 MHz, 0x2c650), 4 (40 MHz, 0x2c628) or 5 (80 MHz, 0x2c608) for
+	 * rev <= 1
+	 */
+	b43_ac_analog_tx_lpf(dev, 0x100, -1, v->lpf, v->lpf, -1, -1, -1);
+	/* 0x2c7a0..0x2c864: PHY rev 0 only; 0x2c880: rev 2/5/6 only */
+	b43_ac_tbl_write(dev, 4, 3, 0x01, 8, v->t4_lo);		/* 0x2c8dc / 0x2c910 */
+	b43_ac_tbl_write(dev, 4, 3, 0x3d, 8, v->t4_hi);		/* 0x2c92c */
+	/*
+	 * The core loop: 0x2c94c..0x2ca38 at 80 MHz, 0x2cb98..0x2ccc4 at 20 and
+	 * 40 MHz; both give mask = value = 0x80 / 0x200 for PHY rev 1.
+	 */
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x2c9c4 / 0x2cc4c */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		b43_ac_phy_mod(dev, 0x73a + (c << 9), 0x80, 0x80);
+		b43_ac_phy_mod(dev, 0x725 + (c << 9), 0x200, 0x200);
+	}
+	if (b == 2) {
+		/*
+		 * 80 MHz only (0x2c938): table 0x14 entries 0x30..0x32, then
+		 * rf_upd*_adcrst (.data 0x12e4..0x1343) where 20 and 40 MHz
+		 * write rf_upd*_clamp (0x2cae8..0x2cd88)
+		 */
+		for (i = 0; i < ARRAY_SIZE(b43_ac2069_bw80_t14); i++)
+			b43_ac_tbl_write(dev, 0x14, 1, 0x30 + i, 48,
+					 b43_ac2069_bw80_t14[i]);
+		b43_ac_tbl_write(dev, 7, 8, 0x30, 16, b43_ac_rf_updh_cmd_adcrst); /* 0x2cb48 */
+		b43_ac_tbl_write(dev, 7, 8, 0xa0, 16, b43_ac_rf_updh_dly_adcrst); /* 0x2cb68 */
+		b43_ac_tbl_write(dev, 7, 8, 0x40, 16, b43_ac_rf_updl_cmd_adcrst); /* 0x2cb88 */
+		b43_ac_tbl_write(dev, 7, 8, 0xb0, 16, b43_ac_rf_updl_dly_adcrst); /* 0x2cd48 */
+		b43_ac_tbl_write(dev, 7, 8, 0x50, 16, b43_ac_rf_updu_cmd_adcrst); /* 0x2cd6c */
+		b43_ac_tbl_write(dev, 7, 8, 0xc0, 16, b43_ac_rf_updu_dly_adcrst); /* 0x2cd88 */
+	} else {
+		b43_ac_tbl_write(dev, 7, 8, 0x30, 16, b43_ac_rf_updh_cmd_clamp); /* 0x2cce8 */
+		b43_ac_tbl_write(dev, 7, 8, 0xa0, 16, b43_ac_rf_updh_dly_clamp); /* 0x2cd08 */
+		b43_ac_tbl_write(dev, 7, 8, 0x40, 16, b43_ac_rf_updl_cmd_clamp); /* 0x2cd28 */
+		b43_ac_tbl_write(dev, 7, 8, 0xb0, 16, b43_ac_rf_updl_dly_clamp); /* 0x2cd48 */
+		b43_ac_tbl_write(dev, 7, 8, 0x50, 16, b43_ac_rf_updu_cmd_clamp); /* 0x2cd6c */
+		b43_ac_tbl_write(dev, 7, 8, 0xc0, 16, b43_ac_rf_updu_dly_clamp); /* 0x2cd88 */
+	}
+	/* 0x2cdb4..0x2ce30: rev 2/5/6 or radio 0x30b only */
+	b43_phy_write(dev, 0x197, v->r197);			/* 0x2ce68 / 0x2ce88 */
+	b43_phy_write(dev, 0x198, v->r198);			/* 0x2cf74 */
+	/*
+	 * 0x2cfb4, 0x2d00c: rfseq tables (rfseq_rx2tx_dly_epa1_20 / _40 /
+	 * _80) only if bits 15..16 of sh+80 (boardflags, reset-helpers-rev1.md)
+	 * are 1; 0x30000000 gives 0.
+	 */
+	b43_ac_phy_mod(dev, 0x19e, 0x2, saved);			/* 0x2d020 */
+}
