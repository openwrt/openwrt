From cdfe11e8db77ecdc302f23e57504bf2bc85bde64 Mon Sep 17 00:00:00 2001
From: Russell Ballestrini <russell@unturf.com>
Date: Fri, 10 Oct 2026 12:00:00 -0400
Subject: [PATCH 03/29] b43: AC-PHY: port the BCM4360 (radio 0x2069) PHY

Replace the AC-PHY stub with a port of the BCM4360 PHY and radio 0x2069
code, reimplemented from the disassembly of Broadcom's wl.ko 6.37.15.24
(ARM, R6400 firmware): radio power-on/off, prefregs, R and RC cal, VCO
cal (wlc_phy_switch_radio_acphy @0x4d940, wlc_phy_radio2069_vcocal
@0x19ddc), register and table setup on reset, the 5 GHz 20 MHz channel
set (wlc_phy_chanspec_set_acphy @0x478bc with band, bandwidth and channel
change, femctrl, RX gain tables and gain control), TX gain and power
target (NVRAM targets, regulatory limit, pwr_scale_1db), TSSI PHY setup,
the TX IQ/LO cal behind acphy_txcal, and b43_phy_ac_rssi() for the RX
path. Radio 0x30b (20691) keeps the stage-1 power-on and VCO cal.

Each sequence in phy_ac.c names its wl.ko function and addresses. Steps
that are not decoded yet stop the channel set with -EOPNOTSUPP. Nothing
touches the radio unless the module is loaded with acphy_pwron=1; poking
this radio while it is down froze the router once.

B43_PHY_AC still depends on BROKEN after this patch; the last patch of
the series drops that.
---
 drivers/net/wireless/broadcom/b43/phy_ac.c | 10157 +++++++++++++++++++++-
 drivers/net/wireless/broadcom/b43/phy_ac.h |   322 +-
 2 files changed, 10430 insertions(+), 49 deletions(-)

--- a/drivers/net/wireless/broadcom/b43/phy_ac.c
+++ b/drivers/net/wireless/broadcom/b43/phy_ac.c
@@ -1,17 +1,175 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 /*
  * Broadcom B43 wireless driver
- * IEEE 802.11ac AC-PHY support
+ * IEEE 802.11ac AC-PHY support (BCM4360: radio 0x2069, and radio 0x30b/20691)
  *
- * Copyright (c) 2015 Rafał Miłecki <zajec5@gmail.com>
+ * The radio init below is reimplemented from the disassembly of Broadcom's
+ * closed driver (re/r6400/wl/wl.ko, 6.37.15.24-6.43.10, ARM, vermagic
+ * 2.6.36.4brcmarm+), not from re/r6400/wl/ANALYSIS.md, which disagrees with
+ * that disassembly. Each sequence names the function, the wl.ko addresses
+ * and the decode note (a .md file in re/r6400/b43-acphy/) it was checked
+ * against.
+ *
+ * Radio 0x2069 (stage 2, revs 3 and 4 = major rev 0, rev 18 = major rev 1):
+ *   wlc_phy_switch_radio_acphy @0x4d940, radio-on path:
+ *     power-on, prefregs, R cal, RC cal   pwron-2069.md, prefregs-2069.md,
+ *                                          rcal-2069.md, lowpwr-and-flags-2069.md
+ *   radio-off path (on == 0, 0x4f9c8)     pwroff-2069.md (software_rfkill)
+ *   wlc_phy_radio2069_vcocal @0x19ddc      vcocal-2069.md
+ *   wlc_phy_radio2069x_vcocal_isdone @0x1bd64
+ *   prefregs_2069_rev3/rev4/rev18          wl.ko .data 0x687e0/0x6883c/0x689c0
+ *
+ * Radio 0x2069 rev 4 channel set (stages 2b..2d: 5 GHz, 20 MHz, R6400 board):
+ *   wlc_phy_set_regtbl_on_pwron_acphy     regtbl-on-pwron-rev1.md (from op_init)
+ *   wlc_phy_chanspec_set_acphy @0x478bc   chan-head-2069.md, chan-tuning-2069.md,
+ *                                          chan-tail-2069-major0.md,
+ *                                          chan-common-2069.md
+ *   reg/tbl on reset, femctrl, resetcca,  reg-on-reset-rev1.md, tbl-on-reset-rev1.md,
+ *   hwaci, analog LPF and dacbuf          reset-helpers-rev1.md, rccal-readers.md
+ *   band change, TSSI PHY setup           band-change-rev1.md, txgain-2069.md,
+ *                                          tssi-setup-rev1.md
+ *   bandwidth and channel change          bw-change-rev1-20mhz.md, chan-change-rev1.md
+ *   40 MHz (acphy_bw40=1): bandwidth      ht40-2069.md, bw-change-rev1-40mhz.md
+ *   change, wlapi_bmac_bw_set, 40 MHz
+ *   farrow/CRS/gain control/TX power
+ *   80 MHz (acphy_bw80=1): bandwidth      vht80-2069.md, bw-change-rev1-80mhz.md
+ *   change, IOCTL 0xc0, 80 MHz farrow,
+ *   step 11/12, CRS; TX power not ported
+ *   RX gain tables and gain control       rxgain-2069.md, rxgain-encode-2069.md,
+ *                                          lna-gains-rev1.md
+ *   RX gain error bytes                   rxgainerr-rev1.md
+ *   RX signal strength (b43_phy_ac_rssi)  rssi-rev42.md
+ *   TX power target and open-loop row     txpower-target-rev1.md
+ *   (recalc/adjust_txpower, set step 11)
+ *   wl.ko data tables                     decode-chanset-tables.py
+ *   The set stops with -EOPNOTSUPP at the first hook (a call that is not
+ *   decoded yet); README.md lists them.
+ *
+ * Radio 0x30b (20691 rev 18), kept from stage 1 and only reached for id 0x30b:
+ *   wlc_phy_radio20691_vcocal            disasm/wlc_phy_radio20691_vcocal.dis
+ *   wlc_phy_radio20691_pwron_seq         disasm/wlc_phy_radio20691_pwron_seq.dis
+ *   wlc_phy_init_radio_prefregs_allbands disasm/wlc_phy_init_radio_prefregs_allbands.dis
+ *   prefregs_20691_rev18/27/30           wl.ko .data, no relocations in range
+ *   wlc_phy_radio20691_rccal is not ported (README.md has the decode).
+ *
+ * Nothing here runs unless the module is loaded with acphy_pwron=1. A trial
+ * load with the default touches no radio register. Poking this radio while
+ * it is down has already frozen the router once (2026-10-04, power cycle).
  */
 
+#include <linux/cordic.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+#include <linux/math64.h>
+#include <linux/sched/clock.h>
+
 #include "b43.h"
+#include "main.h"
 #include "phy_ac.h"
 
-/**************************************************
- * Basic PHY ops
- **************************************************/
+/* acphy_desense: wl's 1 s watchdog ("ACI and hwaci engines" below) */
+static void b43_ac2069_desense_work(struct work_struct *work);
+
+static bool acphy_pwron;
+module_param_named(acphy_pwron, acphy_pwron, bool, 0644);
+MODULE_PARM_DESC(acphy_pwron,
+	"Run the radio power-on, prefregs, R/RC cal and VCO cal during PHY init (default off)");
+
+/*
+ * TX IQ/LO calibration after each radio 0x2069 channel set
+ * (txiqlo-cal-2069.md, b43_ac2069_cals). Off by default: a channel set then
+ * only zeroes the TX IQ/LO coefficients, as before.
+ */
+static bool acphy_txcal;
+module_param_named(acphy_txcal, acphy_txcal, bool, 0644);
+MODULE_PARM_DESC(acphy_txcal,
+	"Run the TX IQ/LO calibration after each radio 0x2069 channel set (default off)");
+
+/*
+ * Read-back check of PHY table 0x01 (acphy_mcs_tbl_rev0), ht20-rev42.md
+ * "MCS table read-back". Off by default; logs only, and leaves the table
+ * as wl writes it.
+ */
+static bool acphy_mcscheck;
+module_param_named(acphy_mcscheck, acphy_mcscheck, bool, 0644);
+MODULE_PARM_DESC(acphy_mcscheck,
+	"Write/read-back check of PHY table 0x01 (MCS) after the power-on tables and each channel set, logged (default off)");
+
+/*
+ * RX IQ calibration after each radio 0x2069 channel set (rxiq-cal-2069.md,
+ * b43_ac2069_rxiq_cal), after the TX IQ/LO cal when that runs too, as
+ * wlc_phy_cals_acphy orders them. Off by default: the RX IQ compensation
+ * (PHY 0x6a0/0x6a1 per core) then stays at the band change's zero.
+ * 1: wl's cal. 2: wl's cal, then the loopback estimate once more with the
+ * new compensation applied ("RX IQ residual" lines, before and after).
+ * 3 and 4 are controls for that check, not wl: 3 writes the compensation
+ * for the negated phase (a sign error in 0x6a0), 4 the one for the inverted
+ * amplitude 1/sqrt(Q/I); both log the residual and stay written.
+ */
+static int acphy_rxcal;
+module_param_named(acphy_rxcal, acphy_rxcal, int, 0644);
+MODULE_PARM_DESC(acphy_rxcal,
+	"RX IQ calibration after each radio 0x2069 channel set: 0 off (default), 1 wl's, 2 wl's plus residual check, 3/4 residual check with the phase negated / amplitude inverted (controls)");
+
+/*
+ * Classifier (PHY 0x140) probe and override, ht20-rev42.md "HT-SIG detection".
+ * The classifier holds the frame-type enable bits cck(0x1)/ofdm(0x2)/
+ * waitED(0x4) (wlc_phy_classifier_acphy @0x2db00 is a read-modify-write of
+ * this one register; the HT-PHY names the same three bits, and no AC-PHY
+ * caller sets an HT/MIMO bit). A bitmask OR'd into 0x140 after each channel
+ * set; default 0 logs the live value and writes nothing.
+ */
+static uint acphy_classfix;
+module_param_named(acphy_classfix, acphy_classfix, uint, 0644);
+MODULE_PARM_DESC(acphy_classfix,
+	"Bitmask OR'd into the classifier register PHY 0x140 after each channel set; 0 logs the live value only (default 0)");
+
+/*
+ * wlc_phy_radio20691_pwron_seq splits every radio access at rev 26 and only
+ * loads a prefreg table for rev 18, 27 or 30 (disasm lines 29-36). Any other
+ * rev is refused.
+ *
+ * The 20691 sequences below were decoded from the wl.ko branch taken for
+ * radio id 0x30b (wlc_phy_chanspec_set_acphy 0x47940, wlc_phy_ac_gains_load
+ * 0x50654). wl reads the id the way b43 does (core +0x3d8/+0x3da,
+ * wlc_phy_attach 0x697a0), so the numbers compare directly.
+ * b43_phy_versioning refuses any AC radio other than 0x2069, so on stock b43
+ * the 0x30b path is never reached; 0x2069 takes its own path
+ * (b43_ac2069_radio_on).
+ */
+#define B43_ACPHY_RADIO_ID	0x30b
+#define B43_ACPHY_RADIO_REV	18
+
+/*
+ * wlc_phy_attach_acphy's presets on a zeroed pi_ac: from op_allocate, and
+ * from prepare_structs with acphy_initfix bit 1 after the state is zeroed
+ * again (b43_phy_ac_state_reset).
+ */
+static void b43_phy_ac_state_attach(struct b43_phy_ac *phy_ac)
+{
+	/*
+	 * wlc_phy_attach_acphy presets pi_ac+0x372 and +0x374 to 0x80 (0x45bc8,
+	 * 0x45bd0, rccal-readers.md), so a reader that runs before RC cal sees
+	 * 0x80. No preset of pi_ac+0x376 was traced; it stays 0.
+	 */
+	phy_ac->rc_result[0] = 0x80;
+	phy_ac->rc_result[1] = 0x80;
+	/*
+	 * Entry counts of the six RX gain stages, copied from C.5675 (.rodata
+	 * 0x5ae40) at 0x45e2c (rxgain-2069.md).
+	 */
+	phy_ac->rx_count[0] = 2;
+	phy_ac->rx_count[1] = 6;
+	phy_ac->rx_count[2] = 7;
+	phy_ac->rx_count[3] = 10;
+	phy_ac->rx_count[4] = 8;
+	phy_ac->rx_count[5] = 8;
+	/* -30 in every noise slot, PHY rev <= 1 (0x463c4..0x463fc) */
+	memset(phy_ac->crs_nf, (u8)-30, sizeof(phy_ac->crs_nf));
+	/* [pi,#222] = 0x1000 at attach (0x68ed0), ht40-2069.md */
+	phy_ac->bw_state = 0x1000;
+	/* intf_mode 0 (0x473d0) and the ACI records zeroed (0x47404, 0x47414) by the zeroing */
+}
 
 static int b43_phy_ac_op_allocate(struct b43_wldev *dev)
 {
@@ -20,41 +178,104 @@
 	phy_ac = kzalloc(sizeof(*phy_ac), GFP_KERNEL);
 	if (!phy_ac)
 		return -ENOMEM;
+	b43_phy_ac_state_attach(phy_ac);
+	phy_ac->dev = dev;
+	INIT_DELAYED_WORK(&phy_ac->desense_work, b43_ac2069_desense_work);
 	dev->phy.ac = phy_ac;
-
 	return 0;
 }
 
+/*
+ * Reached from b43_one_core_detach (after ieee80211_unregister_hw, which
+ * flushed the mac80211 workqueue) and from b43_wireless_core_attach's error
+ * path; neither holds wl->mutex, so the work can be waited for here.
+ */
 static void b43_phy_ac_op_free(struct b43_wldev *dev)
 {
 	struct b43_phy *phy = &dev->phy;
-	struct b43_phy_ac *phy_ac = phy->ac;
 
-	kfree(phy_ac);
+	if (!phy->ac)
+		return;
+	phy->ac->desense_work_on = false;
+	cancel_delayed_work_sync(&phy->ac->desense_work);
