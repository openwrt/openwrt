+/*
+ * acphy_poke: a test hook for the HT-SIG search (ht20-rev42.md "Live register
+ * diff"). Triples reg,value,mask; after every completed channel set each
+ * register gets (old & ~mask) | (value & mask) and one "POKE" line logs
+ * old -> new. Lets a trial try register values from a diff without a rebuild
+ * per guess. Empty by default: nothing written.
+ */
+static uint acphy_poke[48];
+static int acphy_poke_n;
+module_param_array_named(acphy_poke, acphy_poke, uint, &acphy_poke_n, 0444);
+MODULE_PARM_DESC(acphy_poke,
+	"reg,value,mask triples written after every channel set, for tests (default none)");
+
+static void b43_ac_poke(struct b43_wldev *dev)
+{
+	u16 reg, old;
+	int i;
+
+	for (i = 0; i + 2 < acphy_poke_n; i += 3) {
+		reg = (u16)acphy_poke[i];
+		old = b43_phy_read(dev, reg);
+		b43_phy_maskset(dev, reg, ~(u16)acphy_poke[i + 2],
+				acphy_poke[i + 1] & acphy_poke[i + 2]);
+		b43info(dev->wl, "POKE PHY 0x%03x: %04x -> %04x (value %04x mask %04x)\n",
+			reg, old, b43_phy_read(dev, reg),
+			(u16)acphy_poke[i + 1], (u16)acphy_poke[i + 2]);
+	}
+}
