+/*
+ * wlc_phy_cal_txiqlo_coeffs_acphy(pi, rw, buf, type, core) @0x28cb4, all 20
+ * types (txiqlo-coeffs-rev1.md): types 0..11 are PHY table 12 at
+ * base + core * stride (0x28d48 read, 0x28d68 write), 12..15 and 16..19
+ * the in-memory copies (0x28d80..0x28e00). get is rw = 0, set rw = 1.
+ */
+/*
+ * Types 12..19 of C.1845.62099 (.rodata 0x5a53c + 36): {len, base, stride}
+ * into the in-memory copies; the same four rows for 12..15 and 16..19.
+ * Kept outside the generated block, which carries types 0..11.
+ */
+static const u8 b43_ac_txiqlo_mem_layout[4][3] = {
+	{ 0x02, 0x00, 0x05 },
+	{ 0x01, 0x02, 0x05 },
+	{ 0x01, 0x03, 0x05 },
+	{ 0x01, 0x04, 0x05 },
+};
+
+static const u8 *b43_ac2069_txiqlo_layout(u8 type)
+{
+	if (type < ARRAY_SIZE(b43_ac_txiqlo_layout))
+		return b43_ac_txiqlo_layout[type];
+	return b43_ac_txiqlo_mem_layout[(type - 12) & 3];
+}
+
+static u16 *b43_ac2069_txiqlo_mem(struct b43_wldev *dev, u8 type, u16 k)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+
+	return (type <= 15 ? phy_ac->txiqlo_mem : phy_ac->txiqlo_final) + k;
+}
+
+static void b43_ac2069_txiqlo_get(struct b43_wldev *dev, u16 *buf, u8 type,
+				  u8 core)
+{
+	const u8 *l = b43_ac2069_txiqlo_layout(type);
+	u16 k = core * l[2] + l[1];				/* 0x28d28 */
+
+	if (type <= 11)						/* 0x28d20 */
+		b43_ac_tbl_read16n(dev, 12, l[0], k, buf);
+	else
+		memcpy(buf, b43_ac2069_txiqlo_mem(dev, type, k), 2 * l[0]);
+}
+
+static void b43_ac2069_txiqlo_set(struct b43_wldev *dev, const u16 *buf,
+				  u8 type, u8 core)
+{
+	const u8 *l = b43_ac2069_txiqlo_layout(type);
+	u16 k = core * l[2] + l[1];
+
+	if (type <= 11)
+		b43_ac_tbl_write(dev, 12, l[0], k, 16, buf);
+	else
+		memcpy(b43_ac2069_txiqlo_mem(dev, type, k), buf, 2 * l[0]);
+}
