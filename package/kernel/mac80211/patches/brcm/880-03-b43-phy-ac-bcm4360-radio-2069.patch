+/*
+ * Tone amplitude (0x3322c, 0x3545c); the tone parameter, in the TX cal's
+ * unit, is freq * 1000 / 2 = +-1000 at 20 MHz, +-2000 at 40 (0x3542c..0x3544c)
+ */
+#define B43_AC_RXCAL_TONE_AMP		181
+#define B43_AC_RXCAL_EST_NSAMPS		0x4000	/* 0x354a0 */
+#define B43_AC_RXCAL_GAIN_PASSES	32	/* this port's bound; wl has none */
+
+struct b43_ac2069_rxcal_save {
+	u16 phy[3][0x28];	/* PHY 0x720 + i + c * 0x200 */
+	u16 phy73e[3];
+	u16 phy678[3];
+	u16 gain[3][3];		/* table 7 0x100/0x103/0x106 + c */
+	u16 bbmult[3];
+	s8 txidx[3];		/* pi_ac[16 + c] */
+	u16 radio[3][ARRAY_SIZE(b43_ac2069_rxcal_radio_regs)];
+	u16 phy40f, phy401;
+	bool hold19e;
+	u8 bw;			/* wl's bandwidth index, [sp+24] (0x33590) */
+	unsigned int timeouts;
+};
+
+static void b43_ac2069_rxcal_radio(struct b43_wldev *dev,
+				   struct b43_ac2069_rxcal_save *sv, bool setup)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	unsigned int i;
+	u16 b;
+	u8 c;
+
+	for (c = 0; c < phy_ac->ncores; c++) {
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		b = c << 9;
+		if (!setup) {					/* 0x1d2b4..0x1d47c */
+			for (i = 0; i < ARRAY_SIZE(b43_ac2069_rxcal_radio_regs); i++)
+				b43_radio_write(dev, b43_ac2069_rxcal_radio_regs[i] | b,
+						sv->radio[c][i]);
+			continue;
+		}
+		for (i = 0; i < ARRAY_SIZE(b43_ac2069_rxcal_radio_regs); i++) /* 0x1c8e0..0x1ca48 */
+			sv->radio[c][i] = b43_radio_read(dev,
+					b43_ac2069_rxcal_radio_regs[i] | b);
+		for (i = 0; i < ARRAY_SIZE(b43_ac2069_rxcal_radio_regs); i++) /* 0x1ca94..0x1cbc0 */
+			b43_radio_write(dev, b43_ac2069_rxcal_radio_regs[i] | b, 0);
+		for (i = 0; i < ARRAY_SIZE(b43_ac2069_rxcal_radio_mods); i++)
+			b43_ac2069_mod(dev, b43_ac2069_rxcal_radio_mods[i][0] | b,
+				       b43_ac2069_rxcal_radio_mods[i][1],
+				       b43_ac2069_rxcal_radio_mods[i][2]);
+	}
+	/* cleanup tail 0x1d494..0x1d540: PHY rev 2/5/6 only */
+}
+
+/*
+ * wlc_phy_rxcal_loopback_gainctrl_acphy @0x32e10, 5 GHz, PHY rev 1: per
+ * core step through C.2877.67510 from entry 4 until the loopback tone's
+ * power ((ii + 512) >> 10) + ((qq + 512) >> 10) over 1024 samples lies in
+ * 2903..5789 (0x33310, 0x32f88), or the index leaves 0..10. Each pass sets
+ * the gain of the cores not done, plays the tone, estimates (all cores at
+ * once), stops. wl loops until every core is done; the index moves every
+ * pass, so it ends within 12; this port stops after 32 and fails.
+ */
+static int b43_ac2069_rxcal_gainctrl(struct b43_wldev *dev, const u32 *tone,
+				     unsigned int n)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	struct b43_ac_iq_est est[3] = { };
+	u8 lpf[3], st[3] = { }, done[3] = { };
+	s8 idx[3];
+	unsigned int pass;
+	const u8 *g;
+	bool more;
+	u32 pwr;
+	int err;
+	u8 c;
+
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x32ed0..0x32f7c */
+		lpf[c] = (b43_phy_read(dev, 0x6dc + (c << 9)) & 0x780) >> 7;
+		idx[c] = 4;					/* 5 GHz, 0x32f70 */
+	}
+	for (pass = 0; pass < B43_AC_RXCAL_GAIN_PASSES; pass++) {
+		for (c = 0; c < phy_ac->ncores; c++) {		/* 0x32f98..0x331f4 */
+			if (done[c])
+				continue;
+			g = b43_ac_rxcal_lpbk_gain_5g[(u8)idx[c]];
+			b43_phy_write(dev, 0x730 + (c << 9),
+				      0x30 | (lpf[c] << 6));	/* 0x33068, 6 << 3 */
+			b43_phy_write(dev, 0x731 + (c << 9), 4);	/* 0x3309c, 5 GHz */
+			b43_phy_write(dev, 0x734 + (c << 9),
+				      g[1] | (g[0] << 3));	/* 0x330c8 */
+			b43_ac_phy_mod(dev, 0x722 + (c << 9), 0x2, 0x2);	/* 0x33120 */
+			b43_ac_phy_mod(dev, 0x722 + (c << 9), 0x4, 0x4);	/* 0x33178 */
+			b43_ac_phy_mod(dev, 0x722 + (c << 9), 0x8, 0x8);	/* 0x331d0 */
+			b43_ac2069_txpwr_by_index(dev, BIT(c), (s8)g[2]); /* 0x331e8 */
+		}
+		if (!b43_ac2069_tx_tone(dev, tone, n, false)) {	/* 0x33244 */
+			b43err(dev->wl, "radio 0x2069: RX IQ cal tone: RF sequencer still busy after 1 ms\n");
+			b43_ac2069_stopplayback(dev);
+			return -ETIMEDOUT;
+		}
+		err = b43_ac_rx_iq_est(dev, est, 0x400, 32, false, false); /* 0x33260 */
+		b43_ac2069_stopplayback(dev);			/* 0x33268 */
+		if (err)
+			return err;
+		more = false;
+		for (c = 0; c < phy_ac->ncores; c++) {		/* 0x3328c..0x333d4 */
+			if (done[c])
+				continue;
+			pwr = (((u32)est[c].ii + 512) >> 10) +
+			      (((u32)est[c].qq + 512) >> 10);
+			switch (st[c]) {
+			case 0:
+				if (pwr > 5789) {			/* 0x332d0 */
+					st[c] = 2;
+					while (idx[c] > 1) {
+						pwr >>= 1;
+						idx[c]--;
+						if (pwr <= 5789)
+							break;
+					}
+				} else if (pwr > 2902) {		/* 0x33310 */
+					done[c] = 1;
+				} else {
+					st[c] = 1;
+					while (pwr && idx[c] <= 7) {
+						pwr <<= 1;
+						idx[c]++;
+						if (pwr > 2902)
+							break;
+					}
+				}
+				break;
+			case 1:						/* 0x3335c */
+				if (pwr > 2903)
+					done[c] = 1;
+				else
+					idx[c]++;
+				break;
+			case 2:						/* 0x3337c */
+				if (pwr <= 5789)
+					done[c] = 1;
+				else
+					idx[c]--;
+				break;
+			}
+			if ((u8)idx[c] > 10)				/* 0x333a4 */
+				done[c] = 1;
+			if (!done[c])
+				more = true;
+		}
+		if (!more)
+			break;
+	}
+	for (c = 0; c < phy_ac->ncores; c++)
+		b43info(dev->wl, "radio 0x2069: RX IQ cal loopback gain core %u: step %d, PHY 0x730/0x734 = 0x%04x/0x%04x, %u passes\n",
+			c, idx[c], b43_phy_read(dev, 0x730 + (c << 9)),
+			b43_phy_read(dev, 0x734 + (c << 9)), pass + 1);
+	if (pass == B43_AC_RXCAL_GAIN_PASSES) {
+		b43err(dev->wl, "radio 0x2069: RX IQ cal loopback gain not settled after %u passes\n",
+		       pass);
+		return -ETIMEDOUT;
+	}
+	return 0;
+}
+
+/* 16.16 degrees as a signed value with two decimals, for the log */
+static void b43_ac_deg100(s32 a, const char **sign, u32 *ip, u32 *fp)
+{
+	s32 h = (s32)(((s64)a * 100) >> 16);
+
+	*sign = h < 0 ? "-" : "";
+	if (h < 0)
+		h = -h;
+	*ip = h / 100;
+	*fp = h % 100;
+}
+
+static void b43_ac2069_rxcal_phy_setup(struct b43_wldev *dev,
+				       struct b43_ac2069_rxcal_save *sv)
+{
+	static const u8 bbmult_off[3] = { 0x63, 0x67, 0x6b };	/* .rodata 0x5a534 */
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	unsigned int i;
+	u16 b, w;
+	u8 c;
+
+	sv->hold19e = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x33554 */
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x33568 */
+	/* pi_ac[0x184] = 1 (0x335b4): "PHY state saved" flag, not kept here */
+	sv->phy40f = b43_phy_read(dev, 0x40f);			/* 0x335bc */
+	b43_ac_phy_mod(dev, 0x40f, 0x200, 0);			/* 0x335dc */
+	/* 0x335e0..0x33684: PHY rev 2/5/6 only */
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x33698..0x339c8 */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		b = c << 9;
+		sv->txidx[c] = phy_ac->txpwr_idx[c];		/* 0x336d0 */
+		for (i = 0; i < ARRAY_SIZE(b43_ac_rxcal_phy_saved); i++)
+			sv->phy[c][b43_ac_rxcal_phy_saved[i] - 0x720] =
+				b43_phy_read(dev, b43_ac_rxcal_phy_saved[i] + b);
+		sv->bbmult[c] = b43_ac_tbl_read16(dev, 0x0c, bbmult_off[c]); /* 0x33940 */
+		for (i = 0; i < 3; i++)				/* 0x33964..0x339b0 */
+			sv->gain[c][i] = b43_ac_tbl_read16(dev, 7, 0x100 + 3 * i + c);
+		sv->phy73e[c] = b43_phy_read(dev, 0x73e + b);	/* 0x339bc */
+	}
+	sv->phy401 = b43_phy_read(dev, 0x401);			/* 0x339e4 */
+	b43_ac_phy_mod(dev, 0x401, 0x7, phy_ac->coremask);	/* 0x33a10 */
+	b43_ac_phy_mod(dev, 0x401, 0x7000, 0);			/* 0x33a24 */
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x33a70..0x35314 */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		b = c << 9;
+		for (i = 0; i < ARRAY_SIZE(b43_ac_rxcal_phy_mods1); i++)
+			b43_ac_phy_mod(dev, b43_ac_rxcal_phy_mods1[i][0] + b,
+				       b43_ac_rxcal_phy_mods1[i][1],
+				       b43_ac_cal_bw_field(b43_ac_rxcal_phy_mods1[i][0],
+							   b43_ac_rxcal_phy_mods1[i][1],
+							   b43_ac_rxcal_phy_mods1[i][2],
+							   sv->bw, false));
+		/*
+		 * 0x34e18..0x34e54: table 7 entry 0x140 + 16c + bw index
+		 * (0x140 + 16c at 20 MHz, 0x141 + 16c at 40), 0x441 + 2c at
+		 * 80 MHz
+		 */
+		w = b43_ac_tbl_read16(dev, 7, sv->bw == 2 ? 0x441 + 2 * c :
+						 0x140 + 16 * c + sv->bw);
+		b43_ac_phy_mod(dev, 0x735 + b, 0x0700, (w & 7) << 8);	/* 0x34ecc */
+		b43_ac_phy_mod(dev, 0x723 + b, 0x0008, 0x0008);		/* 0x34f24 */
+		b43_ac_phy_mod(dev, 0x735 + b, 0x3800, ((w >> 3) & 7) << 11); /* 0x34f88 */
+		b43_ac_phy_mod(dev, 0x723 + b, 0x0010, 0x0010);		/* 0x34fe0 */
+		b43_ac_phy_mod(dev, 0x737 + b, 0x00ff, (w >> 6) & 0xff);	/* 0x35048 */
+		for (i = 0; i < ARRAY_SIZE(b43_ac_rxcal_phy_mods2); i++)
+			b43_ac_phy_mod(dev, b43_ac_rxcal_phy_mods2[i][0] + b,
+				       b43_ac_rxcal_phy_mods2[i][1],
+				       b43_ac_rxcal_phy_mods2[i][2]);
+		sv->phy678[c] = b43_phy_read(dev, 0x678 + b);	/* 0x352a8 */
+		b43_ac_phy_mod(dev, 0x678 + b, 0x1, 0);		/* 0x35300 */
+	}
+	b43_ac_phy_mod(dev, 0x19e, 0x2, sv->hold19e ? 0x2 : 0);	/* 0x3532c */
+}
+
+/* 0x35904..0x35d1c, then PHY 0x40f (0x35d44) */
+static void b43_ac2069_rxcal_phy_cleanup(struct b43_wldev *dev,
+					 struct b43_ac2069_rxcal_save *sv)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	unsigned int i;
+	u16 b;
+	u8 c;
+
+	sv->hold19e = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x35918 */
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x3592c */
+	b43_phy_write(dev, 0x401, sv->phy401);			/* 0x35948 */
+	for (c = 0; c < phy_ac->ncores; c++) {
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		b = c << 9;
+		for (i = 0; i < 3; i++)				/* 0x35990..0x359f0 */
+			b43_ac_tbl_write16(dev, 7, 0x100 + 3 * i + c, sv->gain[c][i]);
+		b43_ac2069_txpwr_by_index(dev, BIT(c), sv->txidx[c]); /* 0x35a18 */
+		b43_ac_set_tx_bbmult(dev, sv->bbmult[c], c);	/* 0x35a30 */
+		b43_phy_write(dev, 0x73e + b, sv->phy73e[c]);	/* 0x35a4c */
+		b43_phy_write(dev, 0x678 + b, sv->phy678[c]);	/* 0x35a70 */
+		for (i = 0; i < ARRAY_SIZE(b43_ac_rxcal_phy_restore); i++)
+			b43_phy_write(dev, b43_ac_rxcal_phy_restore[i] + b,
+				      sv->phy[c][b43_ac_rxcal_phy_restore[i] - 0x720]);
+	}
+	b43_phy_write(dev, 0x40f, sv->phy40f);			/* 0x35d44 */
+}
+
+/*
+ * Rounded means over the tones, 0x357b0..0x357e0: amplitude (sum + n/2) / n,
+ * phase (sum + sign(sum) n/2) / n. ang/mag point at [tone 0][core], rows of 3.
+ */
+static void b43_ac_rxiq_mean(const s32 *ang, const s32 *mag, unsigned int n,
+			     s32 *avg_ang, s32 *avg_mag)
+{
+	s32 sum_ang = 0, sum_mag = 0;
+	unsigned int k;
+
+	for (k = 0; k < n; k++) {				/* 0x356e0..0x35780 */
+		sum_ang += ang[3 * k];
+		sum_mag += mag[3 * k];
+	}
+	*avg_mag = b43_ac_idiv(sum_mag + (s32)n / 2, n);
+	*avg_ang = b43_ac_idiv(sum_ang + (sum_ang < 0 ? -1 : 1) * ((s32)n / 2),
+			       n);
+}
+
+/* phase (16.16 degrees) and amplitude (Q10) as "phase -3.70 deg, amplitude 1.058" */
+static void b43_ac_rxiq_log(struct b43_wldev *dev, u8 c, const char *what,
+			    s32 ang, s32 mag)
+{
+	const char *sg;
+	u32 dip, dfp;
+
+	b43_ac_deg100(ang, &sg, &dip, &dfp);
+	b43info(dev->wl, "radio 0x2069: RX IQ residual core %u %s: phase %s%u.%02u deg, amplitude %d.%03d\n",
+		c, what, sg, dip, dfp, mag / 1024, (mag % 1024) * 1000 / 1024);
+}
+
+/*
+ * Not wl (acphy_rxcal >= 2): with the new compensation in 0x6a0/0x6a1 and
+ * the loopback still set up, play the same tones and run the same per-core
+ * estimate again. If the estimator sees the compensated samples (wl and
+ * b43_nphy_calc_rx_iq_comp zero the compensation before they measure, which
+ * suggests it does), a right compensation leaves a phase near 0 and an
+ * amplitude near 1.000; a sign error in a roughly doubles the phase, an
+ * inverted b roughly doubles the amplitude error. An "after" equal to
+ * "before" means the estimator taps the samples ahead of the compensation
+ * and the check says nothing. Logs only; the cal's result stands.
+ */
+static noinline_for_stack void
+b43_ac2069_rxiq_residual(struct b43_wldev *dev, const u32 *tone,
+			 unsigned int nsamp, unsigned int ntones,
+			 const s32 (*before)[2], unsigned int *timeouts)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	struct b43_ac_iq_est est[3];
+	s32 ang[2][3], mag[2][3], avg_ang, avg_mag;
+	unsigned int k;
+	int err;
+	u8 c;
+
+	if (WARN_ON(ntones > ARRAY_SIZE(ang)))
+		return;
+	for (k = 0; k < ntones; k++) {
+		memset(est, 0, sizeof(est));
+		if (!b43_ac2069_tx_tone(dev, tone + k * nsamp, nsamp, false)) {
+			(*timeouts)++;
+			err = -ETIMEDOUT;
+		} else {
+			err = b43_ac_rx_iq_est(dev, est,
+					       B43_AC_RXCAL_EST_NSAMPS, 32,
+					       false, true);
+		}
+		b43_ac2069_stopplayback(dev);
+		if (err) {
+			b43err(dev->wl, "radio 0x2069: RX IQ residual check: tone %u failed (%d), no residual\n",
+			       k, err);
+			return;
+		}
+		for (c = 0; c < phy_ac->ncores; c++) {
+			if (!(phy_ac->coremask & BIT(c)))
+				continue;
+			if (est[c].ii <= 0 || est[c].qq <= 0) {
+				b43err(dev->wl, "radio 0x2069: RX IQ residual check core %u: no loopback tone power (I %d, Q %d)\n",
+				       c, est[c].ii, est[c].qq);
+				return;
+			}
+			b43_ac_calc_iq_mismatch(&est[c], &ang[k][c],
+						&mag[k][c]);
+		}
+	}
+	for (c = 0; c < phy_ac->ncores; c++) {
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		b43_ac_rxiq_mean(&ang[0][c], &mag[0][c], ntones, &avg_ang,
+				 &avg_mag);
+		b43_ac_rxiq_log(dev, c, "before", before[c][0], before[c][1]);
+		b43_ac_rxiq_log(dev, c,
+				acphy_rxcal == 3 ? "after (control: phase negated)" :
+				acphy_rxcal == 4 ? "after (control: amplitude inverted)" :
+				"after", avg_ang, avg_mag);
+	}
+}
+
+/*
+ * wlc_phy_cal_rx_fdiqi_acphy @0x333f0, this board's path. Returns 0 with the
+ * new compensation in PHY 0x6a0/0x6a1 per core, or an error with both left
+ * at 0; the hardware state is restored either way.
+ */
+static int b43_ac2069_rxiq_cal(struct b43_wldev *dev)
+{
+	/* [sp+440..441], 0x3534c..0x35370: {2, -2} at 20 MHz, {4, -4} at 40 */
+	static const s8 freq20[2] = { 2, -2 };
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	struct b43_ac2069_rxcal_save sv = { };
+	struct b43_ac_iq_est est[ARRAY_SIZE(freq20)][3] = { };
+	s32 ang[ARRAY_SIZE(freq20)][3], mag[ARRAY_SIZE(freq20)][3];
+	s32 avg_ang, avg_mag, comp_ang, comp_mag, q, i;
+	s32 freq[ARRAY_SIZE(freq20)];
+	s32 avg[3][2] = { };
+	u16 comp[3][2] = { };
+	unsigned int k, nsamp;
+	const char *sg;
+	u32 dip, dfp;
+	u32 *tone;
+	int err = 0;
+	u8 c, mhz;
+
+	sv.bw = b43_ac_bw_idx(phy_ac->chanspec);		/* 0x3356c..0x335a4 */
+	/*
+	 * 0x35398..0x353b0: pi_ac[0x964] (FDIQI) is 1 at 80 MHz on PHY rev 1:
+	 * 6 tones, 0x3000 samples, the slope and wlc_phy_rx_fdiqi_comp_acphy
+	 * (pi, 1), none of it ported. 20 and 40 MHz take the 2-tone path.
+	 */
+	if (sv.bw > 1) {
+		b43err(dev->wl, "radio 0x2069: RX IQ cal at 80 MHz needs FDIQI (not ported), not run\n");
+		return -EOPNOTSUPP;
+	}
+	mhz = b43_ac_cal_bw_mhz[sv.bw];
+	/*
+	 * The tones need no hardware to compute; wl mallocs them (0x2e770,
+	 * 2 * bw words each). Tone parameter freq * 1000 / 2 (0x3542c..
+	 * 0x3544c, sbfx #1, #15): +-1000 at 20 MHz, +-2000 at 40.
+	 */
+	nsamp = 2 * mhz;					/* 0x2e75c */
+	tone = kmalloc_array(ARRAY_SIZE(freq20) * nsamp, sizeof(*tone),
+			     GFP_KERNEL);
+	if (!tone)
+		return -ENOMEM;
+	for (k = 0; k < ARRAY_SIZE(freq20); k++) {
+		freq[k] = freq20[k] * (mhz / 20) * 1000 / 2;
+		err = b43_ac2069_tone_samples(dev, tone + k * nsamp, nsamp,
+					      freq[k], mhz,
+					      B43_AC_RXCAL_TONE_AMP); /* 0x3544c */
+		if (err) {
+			kfree(tone);
+			return err;
+		}
+	}
+
+	/* 0x333f8..0x33474: radio 0x30b refused; 0x978 = 0, PHY rev 1, 5 GHz */
+	b43_ac_carriersearch_enter(dev);			/* 0x334d8 */
+	if (!b43_ac_force_rfseq(dev, B43_AC_RFSEQ_RESET2RX)) {	/* 0x334e4 */
+		sv.timeouts++;
+		err = -ETIMEDOUT;
+		b43err(dev->wl, "radio 0x2069: RX IQ cal: RF sequencer reset2rx still busy after 200 ms (PHY 0x403 = 0x%04x)\n",
+		       b43_phy_read(dev, 0x403));
+	}
+	for (c = 0; c < phy_ac->ncores; c++)			/* 0x334f0..0x33528 */
+		if (phy_ac->coremask & BIT(c))
+			b43_ac_rx_iq_comp_write(dev, c, 0, 0);	/* mode 2 */
+	/* wlc_phy_rx_fdiqi_comp_acphy(pi, 0) @0x18140: off, slopes 0 */
+	b43_ac_phy_mod(dev, 0x211, 0x1, 0);			/* 0x18180 */
+
+	b43_ac2069_rxcal_phy_setup(dev, &sv);
+	b43_ac2069_rxcal_radio(dev, &sv, true);			/* 0x35334 */
+	if (!err)
+		err = b43_ac2069_rxcal_gainctrl(dev, tone, nsamp); /* 0x3533c */
+
+	for (k = 0; !err && k < ARRAY_SIZE(freq); k++) {	/* 0x35428..0x3568c */
+		if (!b43_ac2069_tx_tone(dev, tone + k * nsamp, nsamp,
+					false)) {		/* 0x35468 */
+			sv.timeouts++;
+			err = -ETIMEDOUT;
+			b43err(dev->wl, "radio 0x2069: RX IQ cal tone: RF sequencer still busy after 1 ms\n");
+		} else {
+			/* 0x354b4: per core (pi_ac[0x9ac] = 1 on 5 GHz) */
+			err = b43_ac_rx_iq_est(dev, est[k],
+					       B43_AC_RXCAL_EST_NSAMPS, 32,
+					       false, true);
+		}
+		b43_ac2069_stopplayback(dev);			/* 0x35500 */
+		if (err)
+			break;
+		for (c = 0; c < phy_ac->ncores; c++) {		/* 0x35510..0x3567c */
+			if (!(phy_ac->coremask & BIT(c)))
+				continue;
+			b43_ac_calc_iq_mismatch(&est[k][c], &ang[k][c],
+						&mag[k][c]);	/* 0x35554 */
+			b43_ac_deg100(ang[k][c], &sg, &dip, &dfp);
+			b43info(dev->wl, "radio 0x2069: RX IQ est core %u tone %+d: I pwr %d, Q pwr %d, IQ %d; phase %s%u.%02u deg, amplitude sqrt(Q/I) %d/1024\n",
+				c, freq[k], est[k][c].ii,
+				est[k][c].qq, est[k][c].iq, sg, dip, dfp,
+				mag[k][c]);
+			if (est[k][c].ii <= 0 || est[k][c].qq <= 0) {
+				b43err(dev->wl, "radio 0x2069: RX IQ cal core %u: no loopback tone power (I %d, Q %d)\n",
+				       c, est[k][c].ii, est[k][c].qq);
+				err = -EIO;
+			}
+		}
+	}
+
+	for (c = 0; !err && c < phy_ac->ncores; c++) {		/* 0x35790..0x35890 */
+		if (!(phy_ac->coremask & BIT(c)))
+			continue;
+		/* rounded means, 0x357b0..0x357e0 (num = 2, half = 1) */
+		b43_ac_rxiq_mean(&ang[0][c], &mag[0][c], ARRAY_SIZE(freq),
+				 &avg_ang, &avg_mag);
+		avg[c][0] = avg_ang;
+		avg[c][1] = avg_mag;
+		/*
+		 * acphy_rxcal 3 and 4, controls for the residual check (not
+		 * wl): the compensation for -phase, or for 1 / amplitude
+		 */
+		comp_ang = acphy_rxcal == 3 ? -avg_ang : avg_ang;
+		comp_mag = acphy_rxcal == 4 && avg_mag > 0 ?
+			   b43_ac_idiv(0x100000 + avg_mag / 2, avg_mag) :
+			   avg_mag;
+		b43_ac_cordic(comp_ang, &q, &i);		/* 0x357e8 */
+		/*
+		 * 0x357f4..0x35818: a = sin * amp and b = cos * amp in Q10,
+		 * low 10 bits kept (ubfx #1, #10), a to 0x6a0 and b to 0x6a1
+		 * (buffer halves 0 and 1, 0x35818/0x35810, 0x17648/0x17664).
+		 * With sin = -iq / sqrt(ii qq) and amp = sqrt(qq / ii) that
+		 * is a = -iq / ii and b = sqrt(qq / ii - a^2) - 1 mod 2^10,
+		 * the formula of b43_nphy_calc_rx_iq_comp (rev >= 3: a to
+		 * COMPA, b to COMPB). Amp 1.0 at phase 0 writes 0/0, the
+		 * band change's value.
+		 */
+		comp[c][0] = ((((q * comp_mag) >> 15) + 1) >> 1) & 0x3ff;
+		comp[c][1] = ((((i * comp_mag) >> 15) + 1) >> 1) & 0x3ff;
+		b43_ac_deg100(avg_ang, &sg, &dip, &dfp);
+		b43info(dev->wl, "radio 0x2069: RX IQ imbalance core %u: phase %s%u.%02u deg, amplitude sqrt(Q/I) %d/1024 (%d.%03d); coefficients 0x6a0/0x6a1 = 0x%03x/0x%03x\n",
+			c, sg, dip, dfp, avg_mag, avg_mag / 1024,
+			(avg_mag % 1024) * 1000 / 1024, comp[c][0], comp[c][1]);
+		/*
+		 * Port bound, not wl's: a loopback that does not work gives
+		 * numbers far outside a real radio's; writing them would hurt
+		 * every RX. Beyond 45 degrees or a 2:1 amplitude ratio the cal
+		 * fails and the compensation stays 0.
+		 */
+		if (avg_ang > 45 * 65536 || avg_ang < -45 * 65536 ||
+		    avg_mag < 512 || avg_mag > 2048) {
+			b43err(dev->wl, "radio 0x2069: RX IQ cal core %u: imbalance outside this port's bounds (45 deg, 2:1), not written\n",
+			       c);
+			err = -ERANGE;
+		}
+	}
+	if (!err) {
+		for (c = 0; c < phy_ac->ncores; c++)		/* 0x358a0..0x358d8 */
+			if (phy_ac->coremask & BIT(c))
+				b43_ac_rx_iq_comp_write(dev, c, comp[c][0],
+							comp[c][1]);
+		/* 0x358dc: wlc_phy_rx_fdiqi_comp_acphy(pi, 1) only with 0x964 */
+		if (acphy_rxcal >= 2)
+			b43_ac2069_rxiq_residual(dev, tone, nsamp,
+				ARRAY_SIZE(freq), (const s32 (*)[2])avg,
+				&sv.timeouts);
+	}
+
+	b43_ac2069_rxcal_radio(dev, &sv, false);		/* 0x35900 */
+	b43_ac2069_rxcal_phy_cleanup(dev, &sv);
+	if (!b43_ac_force_rfseq(dev, B43_AC_RFSEQ_RESET2RX)) {	/* 0x35d50 */
+		sv.timeouts++;
+		b43err(dev->wl, "radio 0x2069: RX IQ cal: RF sequencer reset2rx still busy after 200 ms at the end\n");
+		if (!err)
+			err = -ETIMEDOUT;
+	}
+	b43_ac_phy_mod(dev, 0x19e, 0x2, sv.hold19e ? 0x2 : 0);	/* 0x35d68 */
+	b43_ac_carriersearch_exit(dev);				/* 0x35d74 */
+	/* 0x35d78..0x35df0: dssf, PHY rev 6 only */
+
+	if (err) {
+		for (c = 0; c < phy_ac->ncores; c++)
+			if (phy_ac->coremask & BIT(c))
+				b43_ac_rx_iq_comp_write(dev, c, 0, 0);
+		b43err(dev->wl, "radio 0x2069: RX IQ cal failed (%d, %u poll timeouts), RX IQ compensation left at 0\n",
+		       err, sv.timeouts);
+	}
+	kfree(tone);
+	return err;
+}
+
+/*
+ * wlc_phy_cals_acphy(pi, searchmode) @0x3bbf4, the single-phase order
+ * (cal_info[1] = 0, 0x3bc8c..0x3be74) as one call after a channel set.
+ * wl itself runs it from wlc_phy_cal_perical @0x5e048, in multi-phase mode
+ * (pi+0x4bdd = 2 from attach, 0x45bf8) from a timer, phase by phase; the
+ * hardware steps of the TX IQ/LO part are the same (txiqlo-cal-2069.md).
+ */
+static void b43_ac2069_cals(struct b43_wldev *dev, struct b43_ac2069 *ch,
+			    const struct b43_ac2069_chan *ci)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	bool refine;
+	int err = 0;
+	u8 c;
+
+	/*
+	 * gates: the decode covers this board's path only. 20 and 40 MHz
+	 * (acphy_bw40=1); the 80 MHz values are in the bandwidth tables
+	 * (b43_ac_cal_bw_field, b43_ac_txiqlo_nnum_lo) but the RX cal's FDIQI
+	 * path is not ported and no channel set here makes 80 MHz.
+	 */
+	if (ch->major != 0 || phy_ac->ncores != 3 ||
+	    phy_ac->coremask != 0x7 ||
+	    (phy_ac->chanspec & 0xc000) != B43_AC_CHSPEC_BAND_5G ||
+	    ((phy_ac->chanspec & 0x3800) != B43_AC_CHSPEC_BW_20 &&
+	     (phy_ac->chanspec & 0x3800) != B43_AC_CHSPEC_BW_40)) {
+		b43err(dev->wl, "radio 0x2069: TX IQ/LO and RX IQ cals decoded for major rev 0, 3 cores (mask 7), 5 GHz, 20/40 MHz only (major %u, %u cores, mask 0x%x, chanspec 0x%04x), not run\n",
+		       ch->major, phy_ac->ncores, phy_ac->coremask,
+		       phy_ac->chanspec);
+		return;
+	}
+
+	/*
+	 * 0x3bc54..0x3bc70: a refine search only on the channel of the last
+	 * cal with results present. wl's perical passes searchmode 0 in
+	 * single-phase mode and cal_info[0] = 1 (refine) from a BSS up, join
+	 * or watchdog cal in multi-phase mode (0x5e354); this port asks for
+	 * refine and lets the test decide.
+	 */
+	refine = phy_ac->txiqlo_valid &&
+		 phy_ac->txcal_chanspec == phy_ac->chanspec;
+
+	/*
+	 * wlc_phy_susp2tx_cts2self(pi, 29000) @0x372f4 (0x3bcf0): MAC
+	 * suspend, wlc_phyreg_enter, txpwrctrl_enable(pi, 0). The shm 0xb8
+	 * CTS-to-self duration write is left out (meaning not traced, it
+	 * would have the ucode transmit).
+	 */
+	b43_mac_suspend(dev);
+	b43_power_saving_ctl_bits(dev, B43_PS_AWAKE);
+	b43_ac2069_txpwrctrl_disable(dev);
+
+	/*
+	 * 0x3bd14: idle TSSI measurement only with pi+0x4bd8 set (first cal
+	 * after a BSS up, 0x5e12c); not ported. wl's multi-phase order runs
+	 * it last (phase 16), after the TX and RX cals.
+	 */
+	if (acphy_txcal) {
+		phy_ac->txcal_chanspec = phy_ac->chanspec;	/* 0x3bd10 */
+		b43_ac2069_precal_txgain(dev, ci);		/* 0x3bd84 */
+		b43info(dev->wl, "radio 0x2069: TX IQ/LO cal on channel %u, %u MHz (%s), pre-cal gains %u/%u/%u bbmult %u/%u/%u\n",
+			ci->channel,
+			b43_ac_cal_bw_mhz[b43_ac_bw_idx(phy_ac->chanspec)],
+			refine ? "refine" : "restart",
+			phy_ac->txcal_gain[0][1], phy_ac->txcal_gain[1][1],
+			phy_ac->txcal_gain[2][1], phy_ac->txcal_gain[0][4],
+			phy_ac->txcal_gain[1][4], phy_ac->txcal_gain[2][4]);
+		err = b43_ac2069_txiqlo_cal(dev, refine);	/* 0x3bd94 */
+		if (err) {
+			b43_ac2069_txcal_zero(dev);
+			b43err(dev->wl, "radio 0x2069: TX IQ/LO cal failed (%d), TX IQ/LO coefficients and LOFT tables zeroed again\n",
+			       err);
+		} else {
+			for (c = 0; c < phy_ac->ncores; c++)
+				b43info(dev->wl, "radio 0x2069: core %u TX IQ a/b 0x%04x/0x%04x, LO d/e/f 0x%04x/0x%04x/0x%04x\n",
+					c, phy_ac->txiqlo_final[5 * c],
+					phy_ac->txiqlo_final[5 * c + 1],
+					phy_ac->txiqlo_final[5 * c + 2],
+					phy_ac->txiqlo_final[5 * c + 3],
+					phy_ac->txiqlo_final[5 * c + 4]);
+		}
+	}
+	/*
+	 * 0x3bd9c: wlc_phy_cal_rx_fdiqi_acphy @0x333f0, the RX IQ cal, right
+	 * after the TX cal in wl's single-phase order (phase 14 in its
+	 * multi-phase order, 0x3bf80); it does not depend on the TX cal's
+	 * result. 0x3bda0..0x3bdf8 (dssf) is PHY rev 6 only.
+	 */
+	if (acphy_rxcal) {
+		b43info(dev->wl, "radio 0x2069: RX IQ cal on channel %u, %u MHz\n",
+			ci->channel,
+			b43_ac_cal_bw_mhz[b43_ac_bw_idx(phy_ac->chanspec)]);
+		if (b43_ac2069_rxiq_cal(dev))
+			err = -EIO;
+	}
+	if (!err) {
+		/* 0x3be1c: table 12 offset 0x5f = 0xacdc (literal 0x3c194) */
+		b43_ac_tbl_write16(dev, 12, 0x5f, 0xacdc);
+		/* 0x3be20..0x3be64: PAPD on an iPA band only; 5 GHz is ePA here */
+	}
+
+	/* 0x3c0b4..0x3c188: coarse DCOC is PHY rev 4/7 only; mode 0 again */
+	b43_ac2069_txpwrctrl_disable(dev);			/* 0x3c174 */
+	b43_power_saving_ctl_bits(dev, 0);			/* 0x3c17c */
+	b43_mac_enable(dev);					/* 0x3c188 */
+}
+
+/*
+ * Read-only state of every IQ-related setting after a channel set (and its
+ * cals), next to the value wl writes where that is a constant
+ * (rxiq-cal-2069.md, "State log"). Reads only; a table read sets PHY 0x19e
+ * bit 1 around the access when it is clear, as every table access does.
+ */
+static void b43_ac2069_iq_log(struct b43_wldev *dev)
+{
+	static const u16 loft_tbl[3] = { 0x42, 0x62, 0x82 };
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 st[5], ofdm[3], cck[3], fd[11], lo0, lo127;
+	unsigned int i;
+	u16 b;
+	u8 c;
+
+	for (c = 0; c < phy_ac->ncores && c < 3; c++) {
+		b = c << 9;
+		b43_ac_tbl_read16n(dev, 12, 2, 0x40 + 8 * c, st);	/* type 0 */
+		b43_ac_tbl_read16n(dev, 12, 3, 0x43 + 8 * c, st + 2);	/* types 1..3 */
+		b43_ac_tbl_read16n(dev, 12, 3, 0x60 + 4 * c, ofdm);	/* types 8, 9 */
+		b43_ac_tbl_read16n(dev, 12, 3, 0x70 + 4 * c, cck);	/* types 10, 11 */
+		lo0 = b43_ac_tbl_read16(dev, loft_tbl[c], 0);
+		lo127 = b43_ac_tbl_read16(dev, loft_tbl[c], 127);
+		for (i = 0; i < ARRAY_SIZE(fd); i++)
+			fd[i] = b43_phy_read(dev, 0x6a4 + i + b);
+		b43info(dev->wl, "radio 0x2069: IQ state core %u: RX comp 0x6a0/0x6a1 0x%04x/0x%04x (wl: 0/0 from the band change, else its RX cal); TX table 12 OFDM a/b/d 0x%04x/0x%04x/0x%04x, second set 0x%04x/0x%04x/0x%04x (wl: 0 from the band change, else its TX cal); start a/b/d/e/f 0x%04x/0x%04x/0x%04x/0x%04x/0x%04x; LOFT[0]/[127] 0x%04x/0x%04x (wl: 0 from regtbl_on_pwron, else the TX cal); PHY 0x678 0x%04x; FDIQI 0x6a4..0x6ae %04x %04x %04x %04x %04x %04x %04x %04x %04x %04x %04x (wl: only written with FDIQI on)\n",
+			c, b43_phy_read(dev, 0x6a0 + b),
+			b43_phy_read(dev, 0x6a1 + b), ofdm[0], ofdm[1], ofdm[2],
+			cck[0], cck[1], cck[2], st[0], st[1], st[2], st[3],
+			st[4], lo0, lo127, b43_phy_read(dev, 0x678 + b),
+			fd[0], fd[1], fd[2], fd[3], fd[4], fd[5], fd[6], fd[7],
+			fd[8], fd[9], fd[10]);
+	}
+	b43info(dev->wl, "radio 0x2069: IQ state: PHY 0x210/0x211/0x212 0x%04x/0x%04x/0x%04x (wl: 0x211 bit 0 = 0 from any RX cal, FDIQI off), PHY 0x382 0x%04x (wl: 0 after a TX cal), table 12 [0x5f] 0x%04x (wl: 0xacdc after its cals)\n",
+		b43_phy_read(dev, 0x210), b43_phy_read(dev, 0x211),
+		b43_phy_read(dev, 0x212), b43_phy_read(dev, 0x382),
+		b43_ac_tbl_read16(dev, 12, 0x5f));
+}
+
+/*
+ * wlc_phy_chanspec_set_acphy @0x478bc for radio 0x2069 rev 4, PHY rev 1,
+ * 5 GHz, 20 MHz, (acphy_bw40=1) 40 MHz (ht40-2069.md) or (acphy_bw80=1)
+ * 80 MHz (vht80-2069.md). Order:
+ *   head (chan-head-2069.md): table lookup, band and bandwidth state, PHY
+ *     0x19e bit 0, PHY 0x003 bit 8, carrier search, PHY 0x728 bit 8 pulse
+ *   tuning, major-0 tail, VCO cal start (b43_ac2069_tune)
+ *   common code (chan-common-2069.md): PHY 0x19e bit 0 restored; on the init
+ *     set reg_on_reset and tbl_on_reset; band change on init or band change;
+ *     bandwidth change on init or bandwidth change; channel change; then the
+ *     tail (b43_ac2069_chan_tail) up to the carrier search release.
+ * A hook that is not decoded yet stops the set there with -EOPNOTSUPP
+ * (README.md, "Hooks"). None is left on this board's path.
+ */
+static int b43_phy_ac_op_switch_channel(struct b43_wldev *dev,
+					unsigned int new_channel)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	const struct b43_ac2069_chan *ci;
+	struct b43_ac2069 c = { };
+	bool init, band_chg, bw_chg, vco;
+	u16 chanspec, saved19e, bw;
+	int err;
+
+	if (dev->phy.radio_ver != B43_RADIO_ID_2069) {
+		b43err(dev->wl, "AC-PHY: switch_channel(%u) is ported for radio 0x2069 only\n",
+		       new_channel);
+		return -EOPNOTSUPP;
+	}
+	/*
+	 * After a software rfkill unblock pwron_done is clear and the radio is
+	 * off; the set powers it on first (b43_ac2069_radio_on_again). Not
+	 * while b43 has the radio blocked: a channel change then must not
+	 * power the radio and PA back on.
+	 */
+	if (acphy_pwron && !phy_ac->pwron_done) {
+		if (!dev->phy.radio_on) {
+			b43err(dev->wl, "radio 0x2069: channel %u while the radio is blocked (rfkill), not powering it on, refusing\n",
+			       new_channel);
+			return -EOPNOTSUPP;
+		}
+		b43info(dev->wl, "radio 0x2069: channel %u after radio off, running the radio-on first\n",
+			new_channel);
+		err = b43_ac2069_radio_on_again(dev);
+		if (err)
+			return err;
+	}
+	err = b43_ac2069_chan_check(dev, &c);
+	if (err)
+		return err;
+
+	if (new_channel > 0xff) {
+		b43err(dev->wl, "radio 0x2069 rev 4: channel %u out of range, refusing\n",
+		       new_channel);
+		return -EINVAL;
+	}
+	/*
+	 * The chanspec mac80211's chandef asks for (ht40-2069.md,
+	 * vht80-2069.md): 20 MHz, or with acphy_bw40 a 40 MHz chandef (with
+	 * acphy_bw80 an 80 MHz one) as center channel, bandwidth 0x1800
+	 * (0x2000) and sideband. A 40 or 80 MHz chandef that does not map
+	 * (control channel not where the width puts it) is refused before
+	 * any access.
+	 */
+	chanspec = b43_phy_ac_chanspec(dev, new_channel);
+	bw = chanspec & B43_AC_CHSPEC_BW;
+	if (dev->phy.chandef &&
+	    ((dev->phy.chandef->width == NL80211_CHAN_WIDTH_40 &&
+	      bw != B43_AC_CHSPEC_BW_40) ||
+	     (dev->phy.chandef->width == NL80211_CHAN_WIDTH_80 &&
+	      bw != B43_AC_CHSPEC_BW_80))) {
+		b43err(dev->wl, "radio 0x2069: %s MHz chandef (control channel %u, center %u MHz) gives no chanspec of that width, refusing\n",
+		       dev->phy.chandef->width == NL80211_CHAN_WIDTH_80 ? "80" : "40",
+		       new_channel, dev->phy.chandef->center_freq1);
+		return -EINVAL;
+	}
+	/*
+	 * chan-head-2069.md 3: chan2freq on the chanspec's channel byte (the
+	 * center channel at 40 and 80 MHz; the six 80 MHz centers 42 .. 155
+	 * are entries of chan_tuning_2069rev4, vht80-2069.md); no table
+	 * entry, wl returns before any access
+	 */
+	ci = b43_ac2069_find_chan(chanspec & 0xff);
+	if (!ci) {
+		b43err(dev->wl, "radio 0x2069 rev 4: channel %u (chanspec 0x%04x) is not in chan_tuning_2069rev4, refusing\n",
+		       chanspec & 0xff, chanspec);
+		return -EINVAL;
+	}
+	init = phy_ac->chan_init;				/* 1, pi_ac[0x368] */
+	/*
+	 * acphy_bw40fix 4: a bandwidth change outside an init set is handled
+	 * as wl's wlc_bmac_bw_set handles it for its other PHY types
+	 * (0x15d408..0x15d438: PHY reset, then wlc_phy_init): the bits (and
+	 * with bit 2 wl's PHY reset pulse), the radio-on with its cals,
+	 * regtbl_on_pwron (its table step too after a reset), and this set as
+	 * an init set (reg_on_reset, tbl_on_reset, band and bandwidth change).
+	 * The AC path's live flip (step 8 below) is what the port ran so far.
+	 */
+	if (!init && (acphy_bw40fix & B43_AC_BW40FIX_REINIT) &&
+	    phy_ac->bw != bw) {
+		b43info(dev->wl, "BW40FIX: bandwidth 0x%04x -> 0x%04x at a later set: PHY re-init instead of the live flip (acphy_bw40fix 4)\n",
+			phy_ac->bw, bw);
+		b43_ac2069_bmac_bw_set(dev, bw);
+		if (acphy_bw40fix & B43_AC_BW40FIX_RESET)
+			b43_phy_ac_phy_reset_wl(dev);
+		err = b43_ac2069_radio_on(dev);
+		if (err)
+			return err;
+		phy_ac->pwron_done = true;
+		/* wlc_phy_init_acphy 0x4ffc8..0x4ffe8, as op_init */
+		b43_phy_maskset(dev, 0x1b0, (u16)~0x8000, 0x8000);
+		b43_ac2069_regtbl_on_pwron(dev,
+			!!(acphy_bw40fix & B43_AC_BW40FIX_RESET));
+		phy_ac->chan_init = true;
+		init = true;
+	}
+	/*
+	 * acphy_initorder 4: wl's `up` has one set (one band write in the
+	 * capture); a repeat to the chanspec the last completed set
+	 * reached, outside an init set, returns before any access.
+	 */
+	if ((b43_modparam_ac_initorder & B43_AC_INITORDER_ONESET) && !init &&
+	    phy_ac->done_chanspec == chanspec) {
+		b43info(dev->wl, "radio 0x2069 rev 4: channel %u chanspec 0x%04x already set, repeat skipped (acphy_initorder 4)\n",
+			ci->channel, chanspec);
+		return 0;
+	}
+	/*
+	 * A later set comes through wlc_phy_chanspec_set @0x5d4e8, which sets
+	 * sh+108 = sh+116 (7) on 5 GHz first (0x5d538); the init set is called
+	 * straight from wlc_phy_init_acphy and sees intf_mode as it is.
+	 */
+	if (!init)
+		phy_ac->intf_mode = 7;
+
+	b43info(dev->wl, "radio 0x2069 rev 4: channel %u (%u MHz) chanspec 0x%04x (%s MHz%s%s)%s\n",
+		ci->channel, ci->freq, chanspec,
+		bw == B43_AC_CHSPEC_BW_80 ? "80" :
+		bw == B43_AC_CHSPEC_BW_40 ? "40" : "20",
+		bw != B43_AC_CHSPEC_BW_40 ? "" :
+		(chanspec & B43_AC_CHSPEC_SB) ? ", control upper" : ", control lower",
+		bw != B43_AC_CHSPEC_BW_80 ? "" :
+		(chanspec & 0x0300) == 0x0000 ? ", control sideband 0 (lowest)" :
+		(chanspec & 0x0300) == 0x0100 ? ", control sideband 1" :
+		(chanspec & 0x0300) == 0x0200 ? ", control sideband 2" :
+		", control sideband 3 (highest)",
+		init ? ", init set" : "");
+	b43_phy_ac_inittime(dev, "set", chanspec | (init ? 0x10000 : 0));
+
+	/*
+	 * wlc_phy_init @0x56888 runs before the PHY's init and so before the
+	 * init set: if the chanspec's bandwidth differs from the state
+	 * [pi,#222], wlapi_bmac_bw_set (0x56904..0x56920). Here it runs at the
+	 * start of the init set, after op_init's power-on and
+	 * regtbl_on_pwron (an order difference; neither reads the state).
+	 */
+	if (init && phy_ac->bw_state != bw)
+		b43_ac2069_bmac_bw_set(dev, bw);
+
+	/* 5, band: 0x47990..0x47a34; pi_ac[0x36a] is 1 for 2 GHz */
+	band_chg = init || phy_ac->band_2g;
+	if (band_chg) {
+		/* hirssi_elnabypass_shmem_read_clear @0x171a4 */
+		if (b43_shm_read16(dev, B43_SHM_SHARED, 0x184) == 0xdead)
+			b43_shm_write16(dev, B43_SHM_SHARED, 0x184, 0);
+		/* 0x479d4..0x47a18 copy: pi_ac[0x9bc]/[0x9bd] are 0 */
+		phy_ac->band_2g = false;			/* 0x47a34 */
+	}
+	/*
+	 * 6, 0x47a38..0x47aa0: wlc_phy_ed_thres_acphy on a band change, only
+	 * with the EU locale flag [pi,#0x4da0] (0 at attach, 0 for a US
+	 * locale); acphy_edthresh runs it with its value instead.
+	 */
+	if (acphy_edthresh && band_chg)
+		b43_ac2069_ed_thres(dev, acphy_edthresh);
+	/*
+	 * 6: ed_thres runs in wl when its byte pi[0x4da0] is 1 (0x47a38..
+	 * 0x47a50; 0 on this unit's path), for 5 GHz with pi_ac[0x470] unless
+	 * the NVRAM ed_thresh5g value pi_ac[0x46c] is set (0x47a54..0x47aa0).
+	 * acphy_bw40fix 8 runs it with acphy_edthresh.
+	 */
+	if ((acphy_bw40fix & B43_AC_BW40FIX_EDTHRES) &&
+	    (chanspec & B43_AC_CHSPEC_BAND_5G))
+		b43_ac2069_ed_thres(dev, acphy_edthresh ? acphy_edthresh : -65);	/* 0x47aa0 */
+
+	saved19e = b43_phy_read(dev, 0x19e) & 0x1;		/* 7, 0x47ab8 */
+	b43_ac_phy_mod(dev, 0x19e, 0x1, 0x1);			/* 0x47ac8 */
+
+	/* 8, bandwidth: 0x47acc..0x47b6c */
+	bw_chg = init || phy_ac->bw != bw;			/* 0x47adc..0x47af0 */
+	if (bw_chg) {
+		phy_ac->bw = bw;				/* 0x47b04 */
+		if (!init)					/* 0x47b08 */
+			b43_ac2069_bmac_bw_set(dev, bw);	/* 0x47b18 */
+		/* 0x47b1c..0x47b5c: chip 0x4335 80 MHz only */
+		udelay(2);					/* 0x47b64 */
+	}
+
+	b43_ac_phy_mod(dev, 0x003, 0x100, 0x100);		/* 9, 0x47b9c, 5 GHz */
+	phy_ac->cs_count = 0;					/* 10, 0x47ba8 */
+	b43_ac_carriersearch_enter(dev);			/* 0x47bb0 */
+	phy_ac->chanspec = chanspec;				/* 11, 0x55490 */
+
+	if (band_chg || bw_chg) {				/* 13, 0x47e9c */
+		b43_ac_phy_mod(dev, 0x728, 0x100, 0x100);	/* 0x47eb8 */
+		udelay(1);					/* 0x47ec0 */
+		b43_ac_phy_mod(dev, 0x728, 0x100, 0);		/* 0x47ed4 */
+	}
+
+	b43_ac2069_tune(dev, ci);				/* 14 */
+	b43_phy_ac_inittime(dev, "tune", 0);
+
+	/* chan-common-2069.md */
+	b43_ac_phy_mod(dev, 0x19e, 0x1, saved19e);		/* 1, 0x4c460 */
+	if (init) {						/* 2 */
+		/* femctrl call at 0x4c4e8 is for femctrl 1 only */
+		b43_ac2069_reg_on_reset(dev);			/* 0x4c4f0 */
+		b43_ac2069_tbl_on_reset(dev);			/* 0x4c4f8 */
+		/* rxcore_setstate skipped: b43_ac2069_chan_check() */
+	}
+	if (init || band_chg)					/* 3, 0x4c550 */
+		b43_ac2069_band_change(dev);
+	if (init || bw_chg)					/* 0x4c570 */
+		b43_ac2069_bw_change(dev, b43_ac_bw_idx(chanspec));
+	b43_ac2069_chan_change(dev, ci);			/* 4, 0x4c584 */
+	err = b43_ac2069_chan_tail(dev, &c, init, band_chg, bw_chg); /* 5..22 */
+	if (err)
+		goto stopped;
+
+	/* wlc_phy_init_acphy clears pi_ac[0x368] after its set (0x500d8) */
+	if (init) {
+		/*
+		 * wlc_phy_init_acphy 0x50284..0x502dc, PHY rev <= 1, after the
+		 * init set (tx-enable-rev42.md, Trial 13:54). Purpose unknown;
+		 * 0x07d0 = 2000 looks like a timer or limit.
+		 */
+		b43_ac_phy_mod(dev, 0x16e, 0x0002, 0x0002);
+		b43_ac_phy_mod(dev, 0x16e, 0x0001, 0x0001);
+		b43_ac_phy_mod(dev, 0x16e, 0x0010, 0x0010);
+		b43_phy_write(dev, 0x16f, 0x07d0);
+		b43_phy_write(dev, 0x170, 0x07d0);
+	}
+	phy_ac->chan_init = false;
+	/*
+	 * wlc_phy_init then sets sh+108 = sh+116 on 5 GHz (0x56aa0..0x56aac):
+	 * 7 for PHY rev 1 (wlc_phy_attach 0x68f50..0x68f94), unless NVRAM has
+	 * an interference key (0x69254..0x692a0), which board-settings.md did
+	 * not query. Its wlc_phy_interference(pi, 7, 0) call (0x56ac0) that
+	 * follows runs as b43_ac2069_interference() below, with acphy_intf=1.
+	 */
+	if (init)
+		phy_ac->intf_mode = 7;
+	b43_ac_mcs_tbl_check(dev, "channel set");
+	b43_ac_classfix(dev, "channel set");
+	b43_ac_poke(dev);
+	b43_ac2069_interference(dev);
+	b43_ac2069_httx(dev, ci);
+	b43info(dev->wl, "radio 0x2069 rev 4: channel %u set, %u poll timeouts\n",
+		ci->channel, c.timeouts);
+	/*
+	 * wl runs wlc_phy_cals_acphy from wlc_phy_cal_perical after a BSS up
+	 * or join and from the watchdog once the chanspec differs from the
+	 * last cal's (txiqlo-cal-2069.md, "When wl runs it"); here it follows
+	 * every completed set. A failed cal leaves the zeroed coefficients.
+	 */
+	if (acphy_txcal || acphy_rxcal)
+		b43_ac2069_cals(dev, &c, ci);
+	b43_ac2069_iq_log(dev);
+	/* wl's 1 s watchdog (wlc_phy_watchdog), acphy_desense */
+	b43_ac2069_desense_work_start(dev);
+	return 0;
+
+stopped:
+	/*
+	 * Diagnostic, not wl's order: wl waits for the VCO cal started in
+	 * b43_ac2069_tune() at 0x4d580 (chan-common-2069.md step 13), which a
+	 * stopped set does not reach. Polling it here (read-only, bounded, no
+	 * settle) shows whether the PLL locked on this channel.
+	 */
+	vco = b43_ac2069_vcocal_isdone(dev, &c, false);
+	b43info(dev->wl, "radio 0x2069 rev 4: channel %u tuned, VCO cal %s; channel set stopped before completion\n",
+		ci->channel, vco ? "done" : "not done");
+	return err;
+}
 
 const struct b43_phy_operations b43_phyops_ac = {
 	.allocate		= b43_phy_ac_op_allocate,
 	.free			= b43_phy_ac_op_free,
+	.prepare_structs	= b43_phy_ac_op_prepare_structs,
+	.phy_read		= b43_phy_ac_op_phy_read,
+	.phy_write		= b43_phy_ac_op_phy_write,
 	.phy_maskset		= b43_phy_ac_op_maskset,
 	.radio_read		= b43_phy_ac_op_radio_read,
 	.radio_write		= b43_phy_ac_op_radio_write,
+	.software_rfkill	= b43_phy_ac_op_software_rfkill,
+	.switch_analog		= b43_phy_ac_op_switch_analog,
+	.switch_channel		= b43_phy_ac_op_switch_channel,
+	.init			= b43_phy_ac_op_init,
+	.exit			= b43_phy_ac_op_exit,
 	.get_default_chan	= b43_phy_ac_op_get_default_chan,
