+/*
+ * wlc_phy_set_regtbl_on_band_change_acphy @0x44b50, band-change-rev1.md, PHY
+ * rev 1, radio 0x2069, 5 GHz. Step numbers are the decode's. No callee is
+ * left undecoded on this board (chan-set-gaps.md).
+ */
+static void b43_ac2069_band_change(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	static const u16 zero[2];	/* the 56-byte buffer, 0x45398..0x453a8 */
+	u16 saved = b43_phy_read(dev, 0x19e) & 0x2;		/* 1, 0x44b5c */
+	u8 c;
+
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x44b84 */
+	/*
+	 * 2, 3: PHY rev 2/3/5/6/8 only.
+	 * 4, 0x44cf0: wlc_phy_ac_gains_load @0x50390, 5 GHz ePA rev 4
+	 * (chan-head-2069.md): table 0x20, 128 entries, 48 bits (0x5064c).
+	 */
+	b43_ac_tbl_write(dev, 0x20, ARRAY_SIZE(b43_ac2069_txgain_epa_5g_rev4), 0,
+			 48, b43_ac2069_txgain_epa_5g_rev4);
+	/*
+	 * 5: PHY rev 0 only. 6, 0x44f10: table 7 offset 0x18e only if
+	 * pi_ac[0x475] (pdgain5g) is 9 or 16; this board's pdgain5g is 4.
+	 * 7, 8: PHY rev > 1 and radio 0x30b only.
+	 */
+	b43_ac2069_tssi_phy_setup(dev);				/* 9, 0x45284 */
+	/* 10, 0x452b4: mask = sh+145 (rxchain), mode 0 */
+	b43_ac2069_tssi_radio_setup(dev, phy_ac->coremask, 0);
+	/* 11: radio 0x30b only */
+	/*
+	 * 12, 13: sh+108 is intf_mode, 0 on the first init after attach and
+	 * 7 on later ones (aci-w2nb-setup-rev1.md).
+	 * 12, 0x4533c: wlc_phy_hwaci_setup_acphy(pi, bit 1, 0).
+	 */
+	b43_ac_hwaci_setup(dev, phy_ac->intf_mode & 0x2, false);
+	/* 13, 0x45348: wlc_phy_aci_w2nb_setup_acphy(pi, bit 2) */
+	b43_ac2069_aci_w2nb_setup(dev, phy_ac->intf_mode & 0x4);
+	/* 14, 0x4534c..0x45394: iPA bands only; 5 GHz is ePA here */
+
+	/*
+	 * 15..19, one loop over the cores in the core mask (0x453bc..0x454c8):
+	 * the zeroed buffer goes to the TX IQ (type 8) and LO (type 9)
+	 * coefficients, radio regs 2..5 (radio 0x2069 only) and PHY
+	 * 0x6a0/0x6a1 of the core.
+	 */
+	for (c = 0; c < phy_ac->ncores; c++) {
+		if (!(phy_ac->coremask & BIT(c)))		/* 0x453c8 */
+			continue;
+		b43_ac2069_cal_txiqlo_coeffs_write(dev, zero, 8, c); /* 16, 0x45400 */
+		b43_ac2069_cal_txiqlo_coeffs_write(dev, zero, 9, c); /* 0x4541c */
+		b43_radio_write(dev, (c << 9) | 2, 0);		/* 17, 0x45440 */
+		b43_radio_write(dev, (c << 9) | 3, 0);		/* 0x45454 */
+		b43_radio_write(dev, (c << 9) | 4, 0);		/* 0x45468 */
+		b43_radio_write(dev, (c << 9) | 5, 0);		/* 0x4547c */
+		b43_phy_write(dev, 0x6a0 + (c << 9), 0);	/* 18, 0x454a0 */
+		b43_phy_write(dev, 0x6a1 + (c << 9), 0);	/* 19, 0x454b4 */
+	}
+	b43_ac_phy_mod(dev, 0x19e, 0x2, saved);			/* 20, 0x454e0 */
+}
