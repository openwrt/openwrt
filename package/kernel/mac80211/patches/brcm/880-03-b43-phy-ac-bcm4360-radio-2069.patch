 }
 
+static u16 b43_phy_ac_op_phy_read(struct b43_wldev *dev, u16 reg)
+{
+	b43_write16f(dev, B43_MMIO_PHY_CONTROL, reg);
+	return b43_read16(dev, B43_MMIO_PHY_DATA);
+}
+
+static void b43_phy_ac_op_phy_write(struct b43_wldev *dev, u16 reg, u16 value)
+{
+	b43_write16f(dev, B43_MMIO_PHY_CONTROL, reg);
+	b43_write16(dev, B43_MMIO_PHY_DATA, value);
+}
+
 static void b43_phy_ac_op_maskset(struct b43_wldev *dev, u16 reg, u16 mask,
 				  u16 set)
 {
-	b43_write16f(dev, B43_MMIO_PHY_CONTROL, reg);
-	b43_write16(dev, B43_MMIO_PHY_DATA,
-		    (b43_read16(dev, B43_MMIO_PHY_DATA) & mask) | set);
+	b43_phy_write(dev, reg, (b43_phy_read(dev, reg) & mask) | set);
+}
+
+/*
+ * Radio-24 window at core base + 0x3d8 (control) and + 0x3da (data).
+ *
+ * For PHY type 11 (AC) wl's read_radio_reg @0x50848 and write_radio_reg
+ * @0x50930 put the register number into 0x3d8 unchanged: the bank-bit jump
+ * table at 0x50878..0x508dc only covers PHY types 0..10, and type 11 goes
+ * straight to the access at 0x508e0. On radio 0x2069 bits 9..11 of the
+ * register number select the core (core << 9, pwron-2069.md step 8), so an
+ * extra 0x200 would move every access to core 1. The 0x200 below is applied
+ * only for radio 0x30b, where the stage 1 20691 port relies on it; that path
+ * is left as it was.
+ */
+#define B43_AC_RADIO_BANKSEL		0x200
+
+static u16 b43_phy_ac_radio_addr(struct b43_wldev *dev, u16 reg)
+{
+	if (dev->phy.radio_ver == B43_ACPHY_RADIO_ID)
+		return reg | B43_AC_RADIO_BANKSEL;
+	return reg;
 }
 
 static u16 b43_phy_ac_op_radio_read(struct b43_wldev *dev, u16 reg)
 {
-	b43_write16f(dev, B43_MMIO_RADIO24_CONTROL, reg);
+	b43_write16f(dev, B43_MMIO_RADIO24_CONTROL,
+		     b43_phy_ac_radio_addr(dev, reg));
 	return b43_read16(dev, B43_MMIO_RADIO24_DATA);
 }
 
 static void b43_phy_ac_op_radio_write(struct b43_wldev *dev, u16 reg,
 				      u16 value)
 {
-	b43_write16f(dev, B43_MMIO_RADIO24_CONTROL, reg);
+	b43_write16f(dev, B43_MMIO_RADIO24_CONTROL,
+		     b43_phy_ac_radio_addr(dev, reg));
 	b43_write16(dev, B43_MMIO_RADIO24_DATA, value);
 }
 
+/*
+ * mod_radio_reg(pi, reg, mask, val) replaces the bits in mask. Do not route
+ * this through b43_radio_maskset: that helper keeps the bits in mask, which
+ * is the opposite convention, and the previous port got this backwards.
+ */
+static void b43_phy_ac_radio_mod(struct b43_wldev *dev, u16 reg,
+				 u16 mask, u16 val)
+{
+	b43_radio_write(dev, reg,
+			(b43_radio_read(dev, reg) & ~mask) | (val & mask));
+}
+
+/*
+ * Not called by backports 6.18.26 b43: b43_phy_init takes the first channel
+ * from mac80211's chandef, which is 34 for the A-PHY list the AC-PHY gets.
+ * 34 and 36 are both in chan_tuning_2069rev4 (chan-head-2069.md). 36 is in
+ * 5 GHz sub-band 1, whose maxp5ga (88 qdBm on the R6400) is the board's
+ * lowest TX power target (txpower-target-rev1.md), so it is also the
+ * conservative default.
+ */
 static unsigned int b43_phy_ac_op_get_default_chan(struct b43_wldev *dev)
 {
 	if (b43_current_band(dev->wl) == NL80211_BAND_2GHZ)
@@ -62,26 +283,9930 @@
 	return 36;
 }
 
