+/*
+ * wlc_phy_hwaci_setup_acphy(pi, enable, init) @0x43224, PHY rev 1,
+ * reset-helpers-rev1.md. The init block's inputs are the attach defaults
+ * listed there: pi_ac[0x6fa] 300, [0x6fc] 1000, [0x6fe] 500, [0x700] 1,
+ * [0x702] 15, [0x703] 15, [0x704] 1, [0x705..0x707] 0.
+ */
+static void b43_ac_hwaci_setup(struct b43_wldev *dev, bool enable, bool init)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u32 t;
+	u16 v;
+	u8 c;
+
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x43264..0x4333c */
+		b43_ac_phy_mod(dev, 0x728 + (c << 9), 0x3800,
+			       enable ? 0x0800 : 0);
+		b43_ac_phy_mod(dev, 0x721 + (c << 9), 0x4000, 0x4000);
+	}
+	if (!init)
+		return;						/* 0x43344 */
+
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x433d8..0x435c0 */
+		u16 r = c << 9;
+
+		b43_ac2069_mod(dev, r | 0x45, 0x0080, 1 << 7);	/* [0x704] */
+		b43_ac2069_mod(dev, r | 0x49, 0xe000, 0);
+		b43_ac2069_mod(dev, r | 0x49, 0x1800, 0);
+		b43_ac2069_mod(dev, r | 0x49, 0x0400, 0);
+		b43_ac2069_mod(dev, r | 0x49, 0x0300, 0);	/* [0x705] */
+		b43_ac2069_mod(dev, r | 0x49, 0x0040, 0);	/* [0x706] */
+		b43_ac2069_mod(dev, r | 0x49, 0x0080, 0);	/* [0x707] */
+	}
+
+	/* 0x435c4..0x436b8: bits 0, 2, 3 set, 4..11 = [0x702] twice */
+	v = b43_phy_read(dev, 0x550);
+	b43_phy_write(dev, 0x550, (v & 0xf002) | 0x000d | 15 << 4 | 15 << 8);
+	b43_ac_phy_mod(dev, 0x551, 0x000f, 15);			/* 0x436f4 */
+	b43_ac_phy_mod(dev, 0x551, 0x00f0, 15 << 4);		/* 0x43734 */
+	b43_phy_write(dev, 0x552, 1);				/* 0x43768 */
+	b43_phy_write(dev, 0x553, 1);				/* 0x4379c */
+	b43_phy_write(dev, 0x554, 1000);			/* 0x437d0 */
+	b43_phy_write(dev, 0x555, 1000);			/* 0x43804 */
+	b43_phy_write(dev, 0x556, 500);				/* 0x43838 */
+	b43_phy_write(dev, 0x557, 500);				/* 0x4386c */
+	t = (10000 * 300) >> 3;					/* 0x4387c..0x43888 */
+	b43_phy_write(dev, 0x558, t & 0xffff);			/* 0x438b0 */
+	b43_phy_write(dev, 0x559, t >> 16);			/* 0x438e4 */
+}
