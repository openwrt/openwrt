+/* wlc_phy_rx_iq_comp_acphy(pi, 1, {a, b}, core) @0x175f4, write mode */
+static void b43_ac_rx_iq_comp_write(struct b43_wldev *dev, u8 c, u16 a, u16 b)
+{
+	b43_phy_write(dev, 0x6a0 + (c << 9), a);		/* 0x17654 */
+	b43_phy_write(dev, 0x6a1 + (c << 9), b);		/* 0x17694 */
+}
