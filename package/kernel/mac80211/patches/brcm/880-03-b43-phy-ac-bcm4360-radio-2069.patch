+/*
+ * wlc_phy_set_regtbl_on_pwron_acphy @0x1f154, regtbl-on-pwron-rev1.md, PHY
+ * rev 1, chip 0x4360: wl writes the 0x1xxx form of every register here
+ * (the chip switch at 0x1f1cc and after), and so does this port. por is
+ * wl's power-on-reset flag pi+0xe1: op_init passes true (set at attach and
+ * on every wlc_bmac_hw_up, i.e. every b43 core reset), so the 23 tables of
+ * acphytbl_info_rev0 are written; the radio-on after a software rfkill
+ * passes false, as wl's later radio-on (0x4f9a8) runs with pi+0xe1 cleared
+ * at 0x569d8, and then only the 0x19e bit 1 bracket is left of step 10
+ * (0x1f8e4..0x1f8ec). PHY rev 1 returns at 0x1fbec; the rev 4/7 block
+ * after it is not on this board.
+ */
+/*
+ * One table read with a stale-data sentinel. The 99u dump read every cell
+ * of table 0x01 as 0x03d0, the value of PHY 0x19e that the read bracket had
+ * just read: the data port answered with the last value on the PHY read
+ * path, i.e. no table data at all. Here, after the id and offset writes,
+ * a register with a known, different value is read first (sreg); if the
+ * data port then returns that same value, the read is stale. wl never
+ * reads table 0x01 (no wlc_phy_table_read_acphy call with id 1 in wl.ko),
+ * so whether the MCS table is readable at all is not known from wl.
+ */
+static u16 b43_ac_tbl_read16_sent(struct b43_wldev *dev, u16 id, u16 offset,
+				  u16 sreg, u16 *sent)
+{
+	bool held = b43_phy_read(dev, 0x19e) & 0x2;
+	u16 v;
+
+	if (!held)
+		b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);
+	b43_phy_write(dev, 0x0d, id);
+	b43_phy_write(dev, 0x0e, offset);
+	*sent = b43_phy_read(dev, sreg);
+	v = b43_phy_read(dev, 0x0f);
+	if (!held)
+		b43_ac_phy_mod(dev, 0x19e, 0x2, 0);
+	return v;
+}
