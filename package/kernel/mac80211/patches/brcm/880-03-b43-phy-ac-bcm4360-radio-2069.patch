+/*
+ * acphy_classfix: read the classifier register PHY 0x140 at its settled
+ * run-time value (after b43_ac2069_chan_tail has run b43_ac_carriersearch_exit,
+ * so wl's value is in place) and log it. wl leaves 0x140 = 6 on 5 GHz 20 MHz
+ * (bit1 ofdm | bit2 waitED; bit0 cck is 2 GHz only, bit11 is the 40 MHz
+ * primary-sub-band select from wlc_phy_set_regtbl_on_bw_change_acphy, clear at
+ * 20 MHz). That 6 was deduced from the disasm and never read back from this
+ * hardware; this records it. A non-zero mask ORs those bits into 0x140 and
+ * logs the before/after, a way to test whether some bit the static diff cannot
+ * see gates the HT path. Logs one "CLASSFIX" line.
+ */
+static void b43_ac_classfix(struct b43_wldev *dev, const char *where)
+{
+	u16 before, after;
+
+	before = b43_phy_read(dev, 0x140);
+	if (!acphy_classfix) {
+		b43info(dev->wl, "CLASSFIX %s: classifier PHY 0x140 = %04x (wl leaves 6 on 5 GHz 20 MHz: bit0 cck, bit1 ofdm, bit2 waitED; acphy_classfix=0, no write)\n",
+			where, before);
+		return;
+	}
+	b43_phy_set(dev, 0x140, (u16)acphy_classfix);
+	after = b43_phy_read(dev, 0x140);
+	b43info(dev->wl, "CLASSFIX %s: classifier PHY 0x140 %04x -> %04x (OR mask %04x)\n",
+		where, before, after, (u16)acphy_classfix);
+}
