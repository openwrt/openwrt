+static void b43_ac2069_tbl_on_reset(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	const struct ssb_sprom *sprom = dev->dev->bus_sprom;
+	u16 saved = b43_phy_read(dev, 0x19e) & 0x2;		/* 0x2d4dc */
+	u16 rc0 = phy_ac->rc_result[0], rc1 = phy_ac->rc_result[1];
