+/*
+ * acphy_mcscheck: control read of table 0x02 (tx_evm, width 8, written
+ * from the same acphytbl_info_rev0 loop), reads of table 0x01 entries 0..7
+ * and 127 against wl's values, then a pattern written to entry 127 through
+ * wl's write path (b43_ac_tbl_write, 0x2427c), read back with two different
+ * sentinels, and the wl value restored. Logs one line per step ("MCSTBL").
+ */
+static void b43_ac_mcs_tbl_check(struct b43_wldev *dev, const char *where)
+{
+	static const u16 pat = 0xa5c3;
+	u16 v[9], s[9], c, cs, p1, ps1, p2, ps2, r, rs;
+	unsigned int i;
+
+	if (!acphy_mcscheck)
+		return;
+	c = b43_ac_tbl_read16_sent(dev, 0x02, 0, 0x003, &cs);
+	for (i = 0; i < 8; i++)
+		v[i] = b43_ac_tbl_read16_sent(dev, 0x01, i, 0x003, &s[i]);
+	v[8] = b43_ac_tbl_read16_sent(dev, 0x01, 127, 0x003, &s[8]);
+	b43info(dev->wl, "MCSTBL %s: tbl2[0] %04x (wl %02x, sentinel 0x003=%04x) | tbl1[0..7] %04x %04x %04x %04x %04x %04x %04x %04x [127] %04x (wl %04x %04x %04x %04x %04x %04x %04x %04x [127] %04x, sentinel %04x)\n",
+		where, c, b43_ac_rev0_tx_evm_tbl[0], cs,
+		v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8],
+		b43_ac_rev0_mcs_tbl[0], b43_ac_rev0_mcs_tbl[1],
+		b43_ac_rev0_mcs_tbl[2], b43_ac_rev0_mcs_tbl[3],
+		b43_ac_rev0_mcs_tbl[4], b43_ac_rev0_mcs_tbl[5],
+		b43_ac_rev0_mcs_tbl[6], b43_ac_rev0_mcs_tbl[7],
+		b43_ac_rev0_mcs_tbl[127], s[0]);
+
+	b43_ac_tbl_write(dev, 0x01, 1, 127, 16, &pat);
+	p1 = b43_ac_tbl_read16_sent(dev, 0x01, 127, 0x003, &ps1);
+	p2 = b43_ac_tbl_read16_sent(dev, 0x01, 127, 0x19e, &ps2);
+	b43_ac_tbl_write(dev, 0x01, 1, 127, 16, &b43_ac_rev0_mcs_tbl[127]);
+	r = b43_ac_tbl_read16_sent(dev, 0x01, 127, 0x003, &rs);
+	b43info(dev->wl, "MCSTBL %s: wrote %04x to [127], read %04x (sentinel 0x003=%04x), %04x (sentinel 0x19e=%04x); restored %04x, read %04x: %s\n",
+		where, pat, p1, ps1, p2, ps2, b43_ac_rev0_mcs_tbl[127], r,
+		(p1 == pat && p2 == pat) ? "table readable, write lands" :
+		(p1 == ps1 && p2 == ps2) ? "stale data port: table 1 not readable this way, write unproven" :
+		"inconclusive");
+}
