+ * No hardware access.
+ */
+static u8 b43_ac_get_max_lna_index(struct b43_phy_ac *a, u8 which)
+{
+	int m = which == 1 ? 5 - a->desense_total[2] : 6 - a->desense_total[3];
+
+	return m > 0 ? m : 0;
+}
+
+/*
+ * wlc_phy_upd_lna1_lna2_gainlimittbls_acphy(pi, which) @0x24328,
+ * lna-gains-rev1.md, PHY rev 1, 5 GHz. which 1: the LNA1 rout rows of
+ * table 0x15 per core and the LNA1 limits in table 0x0b; anything else
+ * (cmp r6, #1 at 0x2435c): the LNA2 limits. The PHY rev 6 second writes
+ * (0x244f8, 0x2454c) are not on this board. The desense inputs are
+ * pi_ac[0x6f3] (desense_total[4]), [0x6f4] ([5]) and [0x6f5] ([6]), all 0
+ * on the init set (desense-calc-rev1.md).
+ */
+static void b43_ac2069_upd_gainlimittbls(struct b43_wldev *dev, u8 which)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	u8 lna1[6], lna2[7], row[5], hi, c;
+	int m, base, k;
+
+	memcpy(lna1, b43_ac_lna1_limits, sizeof(lna1));		/* 0x24330..0x2433c */
+	memcpy(lna2, b43_ac_lna2_limits, sizeof(lna2));		/* 0x24340..0x24354 */
+	if (which != 1) {					/* 0x24558..0x24570 */
+		a->desense_lna[3] = a->desense_total[5];	/* pi_ac[0x6e0] = [0x6f4] */
+		m = 6 - a->desense_total[5];
+		if (m < 0)
+			m = 0;
+		for (k = m + 1; k < 7; k++)			/* from 0x24474 */
+			lna2[k] = 127;
+		b43_ac_tbl_write(dev, 0x0b, 7, 16, 8, lna2);	/* 0x24520 */
+		return;
+	}
+
+	a->desense_lna[2] = a->desense_total[4];	/* pi_ac[0x6df] = [0x6f3], 0x24360 */
+	m = 5 - a->desense_total[4];				/* 0x24364..0x24374 */
+	if (m < 0)
+		m = 0;
+	base = 0;						/* 0x24380..0x243a0 */
+	if (a->desense_total[6]) {
+		base = m - 4;
+		m = 4;
+	}
+	/* 5 GHz: rout index (4 - pi_ac[0x6f5]) & 0xff into bits 3..6 (0x243a4..0x243a8) */
+	hi = (u8)((u8)(4 - a->desense_total[6]) << 3);
+	for (k = 0; k < 5; k++)					/* 0x243bc..0x243e4 */
+		row[k] = hi | (base + k > 0 ? base + k : 0);
+	/* PHY rev != 0 (0x243e8..0x243fc), every core (0x24464..0x2446c) */
+	for (c = 0; c < a->ncores; c++)
+		b43_ac_tbl_write(dev, 0x15, 5, b43_ac_lna1_rout_off_5g[c], 8,
+				 row);				/* 0x24460 */
+	for (k = m + 1; k < 6; k++)				/* 0x24470..0x244a4 */
+		lna1[k] = 127;
+	b43_ac_tbl_write(dev, 0x0b, 6, 8, 8, lna1);		/* 0x244cc */
+}
+
+/*
+ * wlc_phy_upd_lna1_lna2_gaintbls_acphy(pi, which) @0x27284,
+ * lna-gains-rev1.md, PHY rev 1, chip 0x4360, 5 GHz: the LNA1 (which 1) or
+ * LNA2 (2) gain and gain-bits tables 0x44/0x64/0x84 and 0x45/0x65/0x85 per
+ * core, and the copies the encoder walks (rx_gain/rx_gainbits stage
+ * which). For LNA1, wl reads each core's six table 0x15 entries back and
+ * corrects every gain by the rout delta its entry selects; entries 0..4 are
+ * the rows gainlimittbls just wrote, entry 5 (13 / 37 / 61) is written
+ * nowhere in wl.ko, so it is whatever the hardware holds
+ * (lna-gains-rev1.md, "Open"). The raw entries and the gains they give are
+ * logged per core so a trial settles it.
+ *
+ * Left out, not on this board: the LTE-coex block at 0x27484..0x27598
+ * (table 0x15 entries 5 and 20, radio 0x762 bits 6 and 2), which needs
+ * PHY rev 2, 5 or 6 (0x27494..0x274a8) and boardflags3 bits 17..18 == 1;
+ * the table 0x15 fill at 0x275b4..0x2766c, PHY rev 4 or 7 only.
+ */
+static void b43_ac2069_upd_gaintbls(struct b43_wldev *dev, u8 which)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	static const u8 gtbl[3] = { 0x44, 0x64, 0x84 };	/* 0x27670..0x276d4 */
+	const s8 *tbl = which == 1 ? b43_ac_lna1_5g : b43_ac_lna2_5g; /* 0x27840 / 0x27854 */
+	u8 n = a->rx_count[which];				/* 0x272e4: 6 / 7 */
+	u8 o = which == 1 ? 8 : 16;				/* 0x273e8 / 0x273f4 */
+	u8 gain[10], bits[10], r[6], max, x, c, i;
+	u16 s;
+
+	s = b43_phy_read(dev, 0x19e) & 0x2;			/* 0x272b8..0x272c8 */
+	b43_ac_phy_mod(dev, 0x19e, 0x2, 0x2);			/* 0x272d8 */
+	max = b43_ac_get_max_lna_index(a, which);		/* 0x27400 */
+	/* lo = 1 - rev = 0 on PHY rev 1 (0x27404..0x27414): no i < lo entry */
+	for (i = 0; i < n; i++) {				/* 0x2741c..0x2746c */
+		bits[i] = i > max ? max : i;			/* 0x27444..0x2745c */
+		gain[i] = (u8)tbl[bits[i]];
+	}
+	/* pi_ac[0x6dd] = [0x6f1] or pi_ac[0x6de] = [0x6f2], 0x27470..0x27480 */
+	a->desense_lna[which - 1] = a->desense_total[which + 1];
+
+	for (c = 0; c < a->ncores; c++) {			/* 0x2759c..0x2781c */
+		if (which == 1) {				/* 0x276d8..0x27768 */
+			b43_ac_tbl_read8(dev, 0x15, 6,
+					 b43_ac_lna1_rout_off_5g[c], r); /* 0x27700 */
+			for (i = 0; i < 6; i++) {
+				x = r[bits[i]];			/* 0x27714..0x27730 */
+				if ((x & 7) > 5 || ((x >> 3) & 0xf) > 4)
+					b43warn(dev->wl, "radio 0x2069: core %u LNA1 index %u: table 0x15 entry 0x%02x indexes past ac_lna1_5g or ac_lna1_rout_delta_5g, using the bytes after them as wl does\n",
+						c, i, x);
+				gain[i] = (u8)(b43_ac_lna1_5g[x & 7] -
+					       b43_ac_lna1_rout_delta_5g[(x >> 3) & 0xf]); /* 0x2774c..0x2775c */
+			}
+			b43info(dev->wl, "radio 0x2069: core %u table 0x15 @%u r[0..5] = %02x %02x %02x %02x %02x %02x, LNA1 gains %d %d %d %d %d %d dB\n",
+				c, b43_ac_lna1_rout_off_5g[c],
+				r[0], r[1], r[2], r[3], r[4], r[5],
+				(s8)gain[0], (s8)gain[1], (s8)gain[2],
+				(s8)gain[3], (s8)gain[4], (s8)gain[5]);
+		}
+		memcpy(a->rx_gain[c][which], gain, n);		/* 0x277a4 */
+		b43_ac_tbl_write(dev, gtbl[c], n, o, 8, gain);	/* 0x277c8 */
+		memcpy(a->rx_gainbits[c][which], bits, n);	/* 0x277f0 */
+		b43_ac_tbl_write(dev, gtbl[c] + 1, n, o, 8, bits); /* 0x27810 */
+	}
+	b43_ac_phy_mod(dev, 0x19e, 0x2, s);			/* 0x27820..0x27834 */
+}
+
+/*
+ * wlc_phy_upd_lna1_lna2_gains_acphy(pi) @0x27884, called first in
+ * wlc_phy_rxgainctrl_set_gaintbls_acphy (0x27c44), lna-gains-rev1.md:
+ * four calls and nothing else. No radio access, no delay, no poll.
+ */
+static void b43_ac2069_upd_lna1_lna2_gains(struct b43_wldev *dev)
+{
+	b43_ac2069_upd_gainlimittbls(dev, 1);			/* 0x27890 */
+	b43_ac2069_upd_gainlimittbls(dev, 2);			/* 0x2789c */
+	b43_ac2069_upd_gaintbls(dev, 1);			/* 0x278a8 */
+	b43_ac2069_upd_gaintbls(dev, 2);			/* 0x278b8 */
+}
+
+/*
+ * Hooks: wl calls that are not decoded yet (chan-set-gaps.md has the
+ * list). Each logs what it stands for and returns -EOPNOTSUPP, and the
+ * channel set stops there. Stage 2d filled the two on the init set's path
+ * (upd_lna1_lna2_gains and the RX gain error source, above); the desense
+ * apply with desense on is ported with the ACI engines below ("ACI and
+ * hwaci engines"). None is left on this board's path.
+ */
+
+
+/*
+ * wlc_phy_get_rxgainerr_phy(pi, buf) @0x56d44, chan common step 16
+ * (chan-common-2069.md, rxgainerr-rev1.md): the group of pi+0x136..0x14e
+ * that covers the channel (<= 14, 15..48, 49..64, 65..128, above;
+ * 0x56d8c..0x56e2c), its first [pi,#196] bytes as s16 into err[], and its
+ * fifth byte returned. No hardware access.
+ */
+static u8 b43_ac2069_get_rxgainerr(struct b43_wldev *dev, u8 channel,
+				   s16 *err)
+{
+	struct b43_phy_ac *a = dev->phy.ac;
+	const u8 *g;
+	u8 c;
+
+	if (channel <= 14)
+		g = a->rxgainerr[0];
+	else if (channel <= 48)
+		g = a->rxgainerr[1];
+	else if (channel <= 64)
+		g = a->rxgainerr[2];
+	else if (channel <= 128)
+		g = a->rxgainerr[3];
+	else
+		g = a->rxgainerr[4];
+	for (c = 0; c < a->ncores; c++)
+		err[c] = (s8)g[c];
+	return g[4];
+}
+
+/*
+ * wlc_phy_tssi_phy_setup_acphy(pi, 0) @0x17e50, band change step 9
+ * (0x45284), tssi-setup-rev1.md: PHY rev 1, 5 GHz ePA (not an iPA band),
+ * arg 0. Per core in the core mask: PHY 0x072 bit 2 set (the same register
+ * every pass), bit 2 of 0x727 set, bit 4 of 0x73c cleared. PHY rev 1 gets
+ * the full mask on every core.
+ */
+static void b43_ac2069_tssi_phy_setup(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u8 c;
+
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x18128 */
+		if (!(phy_ac->coremask & BIT(c)))		/* 0x17e78 */
+			continue;
+		b43_ac_phy_mod(dev, 0x072, 0x4, 0x4);		/* 1, 0x17ebc */
+		/* 2: PHY rev 4 only */
+		b43_ac_phy_mod(dev, 0x727 + (c << 9), 0x4, 0x4); /* 3, 0x17f7c */
+		/* 4a, not an iPA band: vA = arg << 4 = 0 */
+		b43_ac_phy_mod(dev, 0x73c + (c << 9), 0x10, 0);	/* 0x18010 */
+	}
+}
+
+/*
+ * wlc_phy_tssi_radio_setup_acphy(pi, mask, mode) @0x1be28,
+ * tssi-radio-setup-2069.md: radio 0x2069 major rev 0, chip 0x4360, 5 GHz,
+ * not an iPA band. Radio writes only. The band change calls it with
+ * rxchain (sh+145) and mode 0.
+ */
+static void b43_ac2069_tssi_radio_setup(struct b43_wldev *dev, u8 mask,
+					u8 mode)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 r;
+	u8 c;
+
+	/* head, major rev 0, 0x1bed0..0x1c0a4 */
+	b43_ac2069_mod(dev, 0x548, 0x0001, 0x0001);		/* 0x1bf2c */
+	b43_radio_write(dev, 0x549, 0);				/* 0x1bf88 */
+	b43_radio_write(dev, 0x54a, 0);				/* 0x1bfe8 */
+	b43_radio_write(dev, 0x54b, 0);				/* 0x1c048 */
+	b43_radio_write(dev, 0x54c, 0);				/* 0x1c0a4 */
+	b43_ac2069_mod(dev, 0x40b, 0x0001, 0);			/* 0x1c13c */
+
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x1c164..0x1c84c */
+		if (!(mask & BIT(c)))				/* 0x1c168..0x1c174 */
+			continue;
+		r = c << 9;
+		/* A, 0x1c46c: mode 1 takes 0x20 on 5 GHz; mode 0, major 0: 0x10 */
+		b43_ac2069_mod(dev, 0x01a | r, 0xf0, mode ? 0x20 : 0x10);
+		/* B, not an iPA band, 0x1c470..0x1c5e0 */
+		b43_ac2069_mod(dev, 0x01a | r, 0x04, mode ? 0 : 0x04); /* 0x1c4f8 */
+		if (c == 0)					/* 0x1c5e0 */
+			b43_ac2069_mod(dev, 0x54b, 0xff00, 0x0100);
+		else if (c == 1)
+			b43_ac2069_mod(dev, 0x54b, 0x00ff, 0x0001);
+		else if (c == 2)
+			b43_ac2069_mod(dev, 0x54c, 0xff00, 0x0100);
+		/* C, every enabled core, 0x1c5e4..0x1c7ac, major 0 */
+		b43_ac2069_mod(dev, 0x01a | r, 0x0300, 0);	/* 0x1c628 */
+		b43_ac2069_mod(dev, 0x017 | r, 0x0002, 0);	/* 0x1c668 */
+		b43_ac2069_mod(dev, 0x01f | r, 0x0004, mode << 2); /* 0x1c6b4 */
+		b43_ac2069_mod(dev, 0x170 | r, 0x0100, 0x0100);	/* 0x1c7ac */
+	}
+}
+
+/*
+ * wlc_phy_aci_w2nb_setup_acphy(pi, enable) @0x430a8, aci-w2nb-setup-rev1.md,
+ * PHY rev 1: every core up to the core count (no core-mask test).
+ * pi_ac[0x708] is 4 (wlc_phy_attach_acphy 0x4747c).
+ */
+static void b43_ac2069_aci_w2nb_setup(struct b43_wldev *dev, bool enable)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u8 c;
+
+	for (c = 0; c < phy_ac->ncores; c++) {			/* 0x43208..0x43218 */
+		b43_ac_phy_mod(dev, 0x729 + c * 0x200, 0x1000,
+			       enable ? 0x1000 : 0);		/* 0x43134 */
+		b43_ac_phy_mod(dev, 0x721 + c * 0x200, 0x1000, 0x1000); /* 0x43194 */
+		if (enable)					/* 0x43198..0x43204 */
+			b43_ac2069_mod(dev, 0x033 | c << 9, 0xf000, 4 << 12);
+	}
+}
+
+/*
+ * acphy_intf: wlc_phy_interference(pi, sh+108, 0) @0x519a4, the call
+ * wlc_phy_init makes at 0x56ac0 after the init set (interference-mode7-rev1.md).
+ * For PHY type 11 with init 0 and mode 7 the head (0x519a4..0x51e70) is
+ * skipped and the tail runs wlc_phy_hwaci_setup_acphy(pi, 1, 1) (0x51ed4,
+ * mode bit 1) and wlc_phy_aci_w2nb_setup_acphy(pi, 1) (0x51ef0, mode bit 2):
+ * hardware ACI detector bit 11 of PHY 0x728, the hwaci init block again, the
+ * w2nb detector bit 12 of PHY 0x729 and radio 0x033 bits 12..15 = 4. No
+ * desense, CRS or clip writes. pi[0x4894] = mode (0x51f28) is host state.
+ * Here it follows every completed set (wl: once per wlc_phy_init; on 5 GHz
+ * nothing in a later set undoes it). Logs one "INTF" line.
+ */
+static bool acphy_intf;
+module_param_named(acphy_intf, acphy_intf, bool, 0644);
+MODULE_PARM_DESC(acphy_intf,
+	"Run wl's wlc_phy_interference(pi, 7, 0) tail (hwaci + w2nb ACI detectors) after every channel set (default 0)");
+
+/*
+ * acphy_desense: wl's interference mitigation, the part of its 1 s watchdog
+ * that reads the detectors and raises or lowers the receiver desense ("ACI
+ * and hwaci engines" below): the ucode MAC-stat glitch and bad-PLCP
+ * counters feed wlc_phy_desense_aci_engine_acphy @0x408b8 (OFDM / BPHY
+ * desense in dB, applied by wlc_phy_desense_apply_acphy: init gain, CRS
+ * minimum power, matched-filter threshold), the hardware ACI and
+ * wide-to-narrowband detectors feed wlc_phy_hwaci_engine_acphy @0x40af0
+ * (LNA1 / LNA2 gain limits and the LNA1 rout, by a level table). 1 runs
+ * both as wl does (wlc_phy_watchdog 0x5eb54..0x5eb78, mode 7). 2..49 hold
+ * a fixed OFDM desense of value - 1 dB for tests (1..12: init gain target
+ * 68..57 dB; 13..48: CRS minimum power raised too). 0 (default): neither
+ * runs and nothing is applied, as before.
+ */
+static int acphy_desense;
+module_param_named(acphy_desense, acphy_desense, int, 0644);
+MODULE_PARM_DESC(acphy_desense,
+	"Receiver desense: 0 off (default); 1 wl's ACI and hwaci engines every second (glitch counters, hwaci and w2nb detectors); 2..49 a fixed OFDM desense of value-1 dB");
+
+/*
+ * acphy_edthresh: the energy-detect CCA threshold block PHY 0x33a..0x349.
+ * wl writes it only for a locale whose CLM country flags carry bit 6
+ * (wlc_phy_set_locale @0x69d00 from 0x16c720 sets [pi,#0x4da0] = 1; the
+ * attach sets 0 at 0x69cb4): wlc_phy_init_acphy 0x500e0..0x5026c then
+ * writes eu_edthresh2g/5g (NVRAM, pi_ac[0x468]/[0x46c], attach
+ * 0x4627c/0x462a0) or, without the key, 0x43f / 0x3c0 on PHY rev <= 1
+ * (0x50104..0x50118, -63 dBm), and the channel set's band change writes
+ * the same through wlc_phy_ed_thres_acphy (0x47a38..0x47aa0). For a US
+ * locale neither runs and the block keeps the PHY reset values (ours: 0x454
+ * / 0x414 / 0x3d4 by register, -62 / -65 / -68 dBm). A value here writes it
+ * as the EU path does; the community captures of wl 7.14 hold 0x3ac / 0x32c
+ * = -70 dBm.
+ */
+static int acphy_edthresh;
+module_param_named(acphy_edthresh, acphy_edthresh, int, 0644);
+MODULE_PARM_DESC(acphy_edthresh,
+	"Energy-detect CCA threshold in dBm written to PHY 0x33a..0x349 on the init set as wl's EU-locale path does (0: not written, the reset values stay, as wl for US; default 0)");
+
+static const u16 b43_ac_intf_phy_core[] = { 0x721, 0x728, 0x729 };
+static const u16 b43_ac_intf_radio_core[] = { 0x033, 0x045, 0x049 };
+
+static void b43_ac2069_interference(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 before[3 * 6 + 10];
+	char line[512];		/* 18 + 10 pairs, ~430 chars */
+	unsigned int i, n, len;
+	u8 mode = phy_ac->intf_mode;
+	u8 c;
+
+	if (!acphy_intf)
+		return;
+
+	for (n = 0, c = 0; c < phy_ac->ncores && c < 3; c++) {
+		for (i = 0; i < 3; i++)
+			before[n++] = b43_phy_read(dev,
+					b43_ac_intf_phy_core[i] + (c << 9));
+		for (i = 0; i < 3; i++)
+			before[n++] = b43_radio_read(dev,
+					b43_ac_intf_radio_core[i] | c << 9);
+	}
+	for (i = 0; i < 10; i++)
+		before[n++] = b43_phy_read(dev, 0x550 + i);
+
+	/* 0x51e80: mode 0 takes the reset path instead, not this board's */
+	if (mode & 0x2)						/* 0x51ec0 */
+		b43_ac_hwaci_setup(dev, true, true);		/* 0x51ed4 */
+	if (mode & 0x4)						/* 0x51ee0 */
+		b43_ac2069_aci_w2nb_setup(dev, true);		/* 0x51ef0 */
+
+	len = scnprintf(line, sizeof(line), "mode %u:", mode);
+	for (n = 0, c = 0; c < phy_ac->ncores && c < 3; c++) {
+		for (i = 0; i < 3; i++, n++) {
+			u16 reg = b43_ac_intf_phy_core[i] + (c << 9);
+
+			len += scnprintf(line + len, sizeof(line) - len,
+					 " P%03x %04x>%04x", reg, before[n],
+					 b43_phy_read(dev, reg));
+		}
+		for (i = 0; i < 3; i++, n++) {
+			u16 reg = b43_ac_intf_radio_core[i] | c << 9;
+
+			len += scnprintf(line + len, sizeof(line) - len,
+					 " R%03x %04x>%04x", reg, before[n],
+					 b43_radio_read(dev, reg));
+		}
+	}
+	for (i = 0; i < 10; i++, n++)
+		len += scnprintf(line + len, sizeof(line) - len,
+				 " P%03x %04x>%04x", 0x550 + i, before[n],
+				 b43_phy_read(dev, 0x550 + i));
+	b43info(dev->wl, "INTF %s\n", line);
+}
+
+/*
+ * wlc_phy_cal_txiqlo_coeffs_acphy(pi, 1, buf, type, core) @0x28cb4,
+ * txiqlo-coeffs-rev1.md, the write side for types 0..11: len entries of 16
+ * bits to PHY table 12 at base + core * stride. Types 12..19 are memory
+ * copies (cal_info+44 / +4, txiqlo-cal-2069.md), handled by
+ * b43_ac2069_txiqlo_coeffs() for the TX IQ/LO cal; the band change only
+ * writes types 8 and 9.
+ */
+static void b43_ac2069_cal_txiqlo_coeffs_write(struct b43_wldev *dev,
+					       const u16 *buf, u8 type, u8 core)
+{
+	const u8 *l;
+
+	if (type >= ARRAY_SIZE(b43_ac_txiqlo_layout)) {		/* 0x28d20 */
+		b43err(dev->wl, "radio 0x2069: TX IQ/LO coefficient type %u not ported\n",
+		       type);
+		return;
+	}
+	l = b43_ac_txiqlo_layout[type];				/* 0x28d04..0x28d1c */
+	b43_ac_tbl_write(dev, 12, l[0], core * l[2] + l[1], 16, buf); /* 0x28d68 */
