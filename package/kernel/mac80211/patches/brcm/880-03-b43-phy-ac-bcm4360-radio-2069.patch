+/*
+ * Gate for a channel set: the radio-on gate (HT clock, PHY rev, chip, radio
+ * rev) plus what only the channel set needs. Reads no radio register.
+ */
+static int b43_ac2069_chan_check(struct b43_wldev *dev, struct b43_ac2069 *c)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	const struct ssb_sprom *sprom = dev->dev->bus_sprom;
+	int err;
+
+	if (!phy_ac->pwron_done) {
+		b43err(dev->wl, "radio 0x2069: channel set without radio power-on (acphy_pwron=0?), refusing\n");
+		return -EOPNOTSUPP;
+	}
+	err = b43_ac2069_check(dev, c);
+	if (err)
+		return err;
+	if (c->rev != 4) {
+		b43err(dev->wl, "radio 0x2069 rev %u: the channel set is ported for rev 4 only\n",
+		       c->rev);
+		return -EOPNOTSUPP;
+	}
+	if (c->ncores != phy_ac->ncores) {
+		b43err(dev->wl, "radio 0x2069: %u cores now, %u at power-on\n",
+		       c->ncores, phy_ac->ncores);
+		return -EOPNOTSUPP;
+	}
+	if (b43_current_band(dev->wl) != NL80211_BAND_5GHZ) {
+		b43err(dev->wl, "radio 0x2069: only the 5 GHz channel set is ported\n");
+		return -EOPNOTSUPP;
+	}
+	if (dev->phy.chandef) {
+		switch (dev->phy.chandef->width) {
+		case NL80211_CHAN_WIDTH_20_NOHT:
+		case NL80211_CHAN_WIDTH_20:
+			break;
+		case NL80211_CHAN_WIDTH_40:
+			if (b43_modparam_ac_bw40)
+				break;
+			b43err(dev->wl, "radio 0x2069: 40 MHz channel width needs acphy_bw40=1 (ht40-2069.md), refusing\n");
+			return -EOPNOTSUPP;
+		case NL80211_CHAN_WIDTH_80:
+			if (b43_modparam_ac_bw80)
+				break;
+			b43err(dev->wl, "radio 0x2069: 80 MHz channel width needs acphy_bw80=1 (vht80-2069.md), refusing\n");
+			return -EOPNOTSUPP;
+		default:
+			b43err(dev->wl, "radio 0x2069: channel width %d, only 20, 40 and 80 MHz are ported\n",
+			       dev->phy.chandef->width);
+			return -EOPNOTSUPP;
+		}
+	}
+	if (sprom->boardflags != B43_AC2069_BOARD_BFL ||
+	    sprom->boardflags2 != B43_AC2069_BOARD_BFL2 ||
+	    sprom->boardflags3 != B43_AC2069_BOARD_BFL3) {
+		b43err(dev->wl, "radio 0x2069: boardflags 0x%08x/0x%08x/0x%08x, the channel set is ported for the R6400 board (0x%08x/0x%08x/0x%08x) only\n",
+		       sprom->boardflags, sprom->boardflags2, sprom->boardflags3,
+		       B43_AC2069_BOARD_BFL, B43_AC2069_BOARD_BFL2,
+		       B43_AC2069_BOARD_BFL3);
+		return -EOPNOTSUPP;
+	}
+	/* txgain-2069.md: extpagain5g == 2 would pick the iPA table, not carried */
+	if (sprom->fem.ghz5.extpa_gain == 2) {
+		b43err(dev->wl, "radio 0x2069: extpagain5g 2 (iPA) not ported\n");
+		return -EOPNOTSUPP;
+	}
+	/*
+	 * chan-head-2069.md: wlc_phy_rxcore_setstate_acphy @0x3df70 (not
+	 * decoded) runs on the init set unless rxchain == (1 << cores) - 1 and
+	 * txchain == rxchain (0x4c4fc..0x4c538).
+	 */
+	if (sprom->rxchain != (1 << c->ncores) - 1 ||
+	    sprom->txchain != sprom->rxchain)
+		return b43_ac2069_chan_gap(dev,
+			"wlc_phy_rxcore_setstate_acphy @0x3df70 (txchain/rxchain not all cores)");
+	/*
+	 * reset-helpers-rev1.md: the femctrl shm writes need boardtype 0x6aa,
+	 * whose source in wl is not traced. Neither candidate is 0x6aa here.
+	 */
+	if (dev->dev->board_type == 0x6aa || sprom->board_type == 0x6aa)
+		return b43_ac2069_chan_gap(dev,
+			"femctrl boardtype 0x6aa shm writes (source of sh+0x44 not traced)");
+	/* recipcoeffs-rev1.md: the rpcal5gb* words are not in the SPROM */
+	if (acphy_rpcal5g_n != ARRAY_SIZE(acphy_rpcal5g)) {
+		b43err(dev->wl, "radio 0x2069: channel set needs acphy_rpcal5g=<rpcal5gb0>,<b1>,<b2>,<b3> from NVRAM pci/2/1/ (R6400: 0x96e7,0,0,0xa30b), refusing\n");
+		return -EOPNOTSUPP;
+	}
+	phy_ac->coremask = sprom->rxchain;
+	return 0;
+}
