+/*
+ * wlc_phy_force_rfseq_acphy(pi, cmd) @0x2b928 with the sequencer bit already
+ * chosen (jump table 0x2b93c: cmd 2, RESET2RX, is 0x20): save PHY 0x400 and
+ * 0x19e, 0x19e bit 0, 0x400 |= 3, 0x402 |= bit, wait for 0x403 & bit to
+ * clear (20001 reads, 20000 x 10 us, 0x2b998..0x2b9fc), put both back. wl
+ * goes on after a timeout; this returns false.
+ */
+#define B43_AC_RFSEQ_RESET2RX	0x20
+
+static bool b43_ac_force_rfseq(struct b43_wldev *dev, u16 bit)
+{
+	u16 s400 = b43_phy_read(dev, 0x400);			/* 0x2b988 */
+	u16 s19e = b43_phy_read(dev, 0x19e);			/* 0x2b99c */
+	unsigned int i;
+	bool busy;
+
+	b43_ac_phy_mod(dev, 0x19e, 0x1, 0x1);			/* 0x2b9b4 */
+	b43_phy_set(dev, 0x400, 0x3);				/* 0x2b9c4 */
+	b43_phy_set(dev, 0x402, bit);				/* 0x2b9d4 */
+	for (i = 0; ; i++) {
+		busy = b43_phy_read(dev, 0x403) & bit;
+		if (!busy || i == 20000)
+			break;
+		udelay(10);
+	}
+	b43_phy_write(dev, 0x400, s400);			/* 0x2ba0c */
+	b43_phy_write(dev, 0x19e, s19e);			/* 0x2ba20 */
+	return !busy;
+}
