+/*
+ * Table 0x14 entries 0x30..0x32 (48 bits as three u16, wl's stack words)
+ * that only the 80 MHz path writes (0x2ca9c..0x2cb2c, bw-change-rev1-80mhz.md)
+ */
+static const u16 b43_ac2069_bw80_t14[3][3] = {
+	{ 0x0fd2, 0x0096, 0 },		/* sp+36, 0x2cae8 */
+	{ 0x0fc2, 0x0086, 0 },		/* sp+28, 0x2cb0c */
