+static const struct b43_ac2069_chan *b43_ac2069_find_chan(u8 channel)
+{
+	unsigned int i;
+
+	/* wlc_phy_chan2freq_acphy @0x16b1c: first entry whose channel matches */
+	for (i = 0; i < ARRAY_SIZE(b43_ac2069_rev4_chans); i++)
+		if (b43_ac2069_rev4_chans[i].channel == channel)
+			return &b43_ac2069_rev4_chans[i];
+	return NULL;
+}
+
+/*
+ * Tuning writes for major rev 0 (chan-tuning-2069.md, 0x4a71c..0x4b7a8),
+ * then the major-0 tail for rev 4 on 5 GHz (chan-tail-2069-major0.md
+ * steps 3, 4, 5), then the VCO cal start (step 9, 0x4c44c). Rev 3's writes
+ * (step 1) and channel 4's (step 2, a 2.4 GHz channel) do not apply.
+ */
+static void b43_ac2069_tune(struct b43_wldev *dev,
+			    const struct b43_ac2069_chan *ci)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(b43_ac2069_tune_regs); i++)
+		b43_radio_write(dev, b43_ac2069_tune_regs[i], ci->radio[i]);
+
+	b43_ac2069_mod(dev, 0x645, 0x7000, 0x7000);		/* 3, 0x4b9ac */
+	/* 4, 0x4b9c4: wlc_2069_rfpll_150khz @0x2b6d0, 5 GHz only */
+	b43_ac2069_mod(dev, 0x8c9, 0xff00, 0x0000);		/* 0x2b72c */
+	b43_ac2069_mod(dev, 0x8c9, 0x00ff, 0x0002);		/* 0x2b784 */
+	b43_radio_write(dev, 0x8ca, 0x0002);			/* 0x2b7d4 */
+	b43_ac2069_mod(dev, 0x8cc, 0x00ff, 0x0002);		/* 0x2b828 */
+	b43_ac2069_mod(dev, 0x8cc, 0xff00, 0xff00);		/* 0x2b87c */
+	b43_radio_write(dev, 0x8c7, 0xffff);			/* 0x2b8cc */
+	b43_radio_write(dev, 0x8c8, 0xffff);			/* 0x2b920 */
+	b43_radio_write(dev, 0x723, 0x83e0);			/* 5, 0x4ba20, rev >= 4 */
+	/* 6..8: major-1/2 blocks and the PHY rev 6 vco_opt are skipped */
+	b43_ac2069_vcocal(dev);					/* 9, 0x4c44c */
+}
+
+/*
+ * wlc_phy_get_chan_freq_range_acphy(pi, 0) @0x3a2c4, chan-set-gaps.md 1: the
+ * 5 GHz sub-band of the current channel from its frequency (the tuning
+ * entry's, wlc_phy_chan2freq_acphy) and sh+56 = NVRAM subband5gver, 4 on
+ * this board (board-settings.md; also attach's default, 0x45e60..0x45e7c).
+ * Ranges are tested as unsigned freq - base <= span (0x3a33c..0x3a378), so
+ * a frequency below 5170 MHz falls to 4. No hardware access.
+ */
+static u8 b43_ac2069_chan_freq_range(const struct b43_ac2069_chan *ci)
+{
+	if (ci->channel <= 14)					/* 0x3a320 */
+		return 0;
+	if ((u16)(ci->freq - 5170) <= 5249 - 5170)
+		return 1;
+	if ((u16)(ci->freq - 5250) <= 5499 - 5250)
+		return 2;
+	if ((u16)(ci->freq - 5500) <= 5744 - 5500)
+		return 3;
+	return 4;
+}
