+/*
+ * wlc_phy_radio20691_vcocal @0x19cfc, disasm lines 1-58.
+ * mod_radio_reg replaces the masked bits, so (reg, mask, val) below is what
+ * the instruction writes, not what an earlier note said it writes. The note
+ * cleared bits 4, 5 and 6 of reg 0x41; the disassembly sets all three.
+ * osl_delay() in this wl.ko is microseconds.
+ */
+static void b43_phy_ac_radio20691_vcocal(struct b43_wldev *dev)
+{
+	b43_phy_ac_radio_mod(dev, 0x35, 0x4000, 0);
+	b43_phy_ac_radio_mod(dev, 0x24, 0x0001, 0);
+	b43_phy_ac_radio_mod(dev, 0x41, 0x0010, 0x0010);
+	b43_phy_ac_radio_mod(dev, 0x38, 0x0040, 0);
+	b43_phy_ac_radio_mod(dev, 0x41, 0x0020, 0x0020);
+	b43_phy_ac_radio_mod(dev, 0x2c, 0x2000, 0);
+	b43_phy_ac_radio_mod(dev, 0x41, 0x0040, 0x0040);
+	udelay(11);
+	b43_phy_ac_radio_mod(dev, 0x24, 0x0001, 0x0001);
+	b43_phy_ac_radio_mod(dev, 0x38, 0x0040, 0x0040);
+	udelay(1);
+	b43_phy_ac_radio_mod(dev, 0x2c, 0x2000, 0x2000);
+}
