+	b43_actab_read_bulk((dev), __id, __off, 16, __n, __buf);	\
+	for (__i = 0; B43_DEBUG && __i < __n; __i++)			\
+		b43info((dev)->wl, "table rd 0x%02x:0x%04x = 0x%04x\n",	\
+			__id, (u16)(__off + __i), __buf[__i]);		\
