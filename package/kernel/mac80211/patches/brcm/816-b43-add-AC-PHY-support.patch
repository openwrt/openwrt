+
+/* Radio register page (RC-cal engine). */
+#define R2069_RCCAL_EN1		0x8ea	/* enable bit 0x80 */
+#define R2069_RCCAL_EN2		0x8ed	/* [10:9] mode select */
+#define R2069_RCCAL_CFG		0x410	/* [12]=init [4:3]=mode [0]=start */
+#define R2069_RCCAL_KICK	0x411	/* [15:8]=nloop [0]=kick */
+#define R2069_RCCAL_SEED	0x412	/* write-only seed code */
+#define R2069_RCCAL_STAT	0x413	/* [4]=done */
+#define R2069_RCCAL_E		0x414	/* comparator A (pass 0) */
+#define R2069_RCCAL_F		0x415	/* comparator B (pass 0) */
+#define R2069_RCCAL_G		0x416	/* measured RC code (pass 1) */
+
+/* Per-core RC-trim apply bases, OR'd with (core << 9). */
+#define R2069_RCCAL_P1_A	0x126	/* pass 1, field [4:0] = code */
+#define R2069_RCCAL_P1_B	0x043	/* pass 1, field [4:0] = code; the trace has 0x043/0x243/0x443, not 0x04a */
+#define R2069_RCCAL_P2_A	0x11d	/* pass 2, clear bit 0x4 */
+#define R2069_RCCAL_P2_B	0x171	/* pass 2, set bit 0x2000 */
+
+#define R2069_RCCAL_POLL_MAX	100
+
+/* AFE calibration (per-core); shares the cal-block enable R2069_RCCAL_EN1. */
+#define R2069_AFE_CAL_CLK	0x121	/* [12] per-core cal clock enable */
+#define R2069_AFE_CAL_CTRL	0x122	/* [3:0] cal-enable bits */
+#define R2069_AFE_CAL_STAT	0x144	/* [1]=done (1st read) [0]=valid (2nd) */
+static inline void r2069_mod(struct b43_wldev *dev, u16 reg, u16 mask, u16 val)
+{
+	b43_radio_maskset(dev, reg, (u16)~mask, val & mask);
+}
+
+static const u16 b43_r2069_rccal_seed[3] = { 0x014a, 0x0101, 0x011a };
+static const u8  b43_r2069_rccal_init[3] = { 1, 0, 0 };
+static const u8  b43_r2069_rccal_mode[3] = { 0, 2, 1 };
+static const u8  b43_r2069_rccal_nloop[3] = { 0x1c, 0x70, 0x40 };
+
+/* Pass 0/1 common preamble: program the engine for this pass. */
+/* [capture-ref: router-data/d6220/cold-sweep.zip!cold01-ch36-bw20.txt;
+ *   911-923, 956-968, 1025-1037]
+ * [capture-ref: router-data/d6220/hot-sweep.zip!segmenti/01-up-ch36-bw20.txt;
+ *   293-305, 338-350, 401-413]
+ */
+static void b43_r2069_rccal_setup(struct b43_wldev *dev, unsigned int pass)
+{
+	B43_AC_FN();
+	r2069_mod(dev, R2069_RCCAL_CFG, 0x1000,
+		  (u16)(b43_r2069_rccal_init[pass] << 12));
+	r2069_mod(dev, R2069_RCCAL_CFG, 0x0018,
+		  (u16)(b43_r2069_rccal_mode[pass] << 3));
+	r2069_mod(dev, R2069_RCCAL_KICK, 0xff00,
+		  (u16)(b43_r2069_rccal_nloop[pass] << 8));
+	b43_radio_write(dev, R2069_RCCAL_SEED,
+			b43_r2069_rccal_seed[pass]);
+}
+
+/* Kick the engine and poll the done bit. */
+/* [capture-ref: router-data/d6220/cold-sweep.zip!cold01-ch36-bw20.txt;
+ *   924-947, 969-994, 1062-1089]
+ * [capture-ref: router-data/d6220/hot-sweep.zip!segmenti/01-up-ch36-bw20.txt;
+ *   306-329, 351-370, 438-455]
+ */
+static bool b43_r2069_rccal_run(struct b43_wldev *dev)
+{
+	B43_AC_FN();
+	unsigned int i;
+
+	r2069_mod(dev, R2069_RCCAL_CFG, 0x0001, 0x0000);
+	udelay(1);
+	r2069_mod(dev, R2069_RCCAL_CFG, 0x0001, 0x0001);
+	udelay(35);
+	r2069_mod(dev, R2069_RCCAL_KICK, 0x0001, 0x0001);
+
+	for (i = 0; i < R2069_RCCAL_POLL_MAX; i++) {
+		udelay(100);
+		if (b43_radio_read(dev, R2069_RCCAL_STAT) & 0x0010)
+			break;
+	}
+
+	r2069_mod(dev, R2069_RCCAL_KICK, 0x0001, 0x0000);
+
+	return i < R2069_RCCAL_POLL_MAX;
+}
+
+/* Pass 1: write the measured 5-bit RC code into the per-core trim regs. */
+static void b43_r2069_rccal_apply_code(struct b43_wldev *dev)
+{
+	u16 code = b43_radio_read_log(dev, R2069_RCCAL_G) & 0x001f;
+	unsigned int core;
+
+	/*
+	 * Per silicon core: RC-time-constant trim applies to every powered core,
+	 * incl. the antenna-less core 2 (all three cores).
+	 * Unlike AFE cal (afecal), this is not per-active-chain.
+	 */
+	for (core = 0; core < dev->phy.ac->num_cores; core++) {
+		u16 stride = (u16)(core << 9);
+
+		r2069_mod(dev, (R2069_RCCAL_P1_A | stride) & 0xff3e, 0x001f, code);
+		r2069_mod(dev, (R2069_RCCAL_P1_B | stride) & 0xfe4b, 0x001f, code);
+	}
+}
+
+/*
+ * Pass 2 arm: set the fixed per-core trim before running the engine.
+ * P2_A clears bit 2 (RC-fast trim off), P2_B sets bit 13 (dacbuf-cap
+ * measurement enable). The engine runs with these armed; P2_B is then
+ * disarmed by b43_r2069_rccal_disarm_p2b after reading the result.
+ */
+static void b43_r2069_rccal_apply_fixed(struct b43_wldev *dev)
+{
+	unsigned int core;
+
+	/* Per silicon core, as apply_code (all three). */
+	for (core = 0; core < dev->phy.ac->num_cores; core++) {
+		u16 stride = (u16)(core << 9);
+
+		r2069_mod(dev, (R2069_RCCAL_P2_A | stride) & 0xff3f, 0x0004, 0x0000);
+		r2069_mod(dev, (R2069_RCCAL_P2_B | stride) & 0xfff5, 0x2000, 0x2000);
+	}
+}
+
+/* Pass 2 disarm: clear the P2_B measurement-enable bit after the engine
+ * has run and dacbuf_cap has been read. */
+static void b43_r2069_rccal_disarm_p2b(struct b43_wldev *dev)
+{
+	unsigned int core;
+
+	for (core = 0; core < dev->phy.ac->num_cores; core++) {
+		u16 stride = (u16)(core << 9);
+
+		r2069_mod(dev, (R2069_RCCAL_P2_B | stride) & 0xfff5,
+			  0x2000, 0x0000);
+	}
+}
+
+/* [capture-ref: router-data/d6220/cold-sweep.zip!cold01-ch36-bw20.txt;
+ *   911-1111]
+ * [capture-ref: router-data/d6220/hot-sweep.zip!segmenti/01-up-ch36-bw20.txt;
+ *   293-477]
+ */
+void b43_radio_2069_rccal(struct b43_wldev *dev)
+{
+	B43_AC_FN();
+	unsigned int pass;
+
+	u16 chipnum = dev->dev->chip_id;
+
+	if (chipnum != 0x4352 && chipnum != 0x4360) {
+		b43warn(dev->wl, "radio 2069: rccal skipped, chipnum 0x%04x not supported\n",
+		       chipnum);
+		return;
+	}
+
+	/* Cal-block enable (EN1 bit 0x80, EN2 mode) is left armed by
+	 * b43_radio_2069_pwron, which always runs first; do not repeat it. */
+
+	/*
+	 * First two passes
+	 */
+	for (pass = 0; pass < 2; pass++) {
+		b43_r2069_rccal_setup(dev, pass);
+		if (b43_r2069_rccal_run(dev)) {
+			if (pass == 0) {
+				s16 e = b43_radio_read_log(dev, R2069_RCCAL_E);
+				s16 f = b43_radio_read_log(dev, R2069_RCCAL_F);
+				u8 cap = (u8)(((f - e) * 193) >> 8);
+
+				dev->phy.ac->lpf_cap0 = cap;
+				dev->phy.ac->lpf_cap1 = cap;
+				b43dbg(dev->wl,
+				       "radio 2069: rccal lpf cap 0x%02x (E=0x%04x F=0x%04x)\n",
+				       cap, (u16)e, (u16)f);
+			} else {
+				b43_r2069_rccal_apply_code(dev);
+			}
+		}
+		/* Stop: clear start after the result readout. */
+		r2069_mod(dev, R2069_RCCAL_CFG, 0x0001, 0x0000);
+	}
+
+	/*
+	 * Last pass (dacbuf cap): the engine runs with P2_A/P2_B armed,
+	 * then the measurement-enable bit in P2_B is cleared.
+	 */
+	b43_r2069_rccal_setup(dev, pass);
+	b43_r2069_rccal_apply_fixed(dev);
+	b43_r2069_rccal_run(dev);
+	dev->phy.ac->dacbuf_cap = (b43_radio_read(dev, R2069_RCCAL_G) & 0x03e0) >> 5;
+	b43_r2069_rccal_disarm_p2b(dev);
+
+	r2069_mod(dev, R2069_RCCAL_CFG, 0x0001, 0x0000);
+
+	r2069_mod(dev, R2069_RCCAL_EN1, 0x0080, 0x0000);
+}
+
+/*
+ * Per-core analog-front-end calibration for the 2069 radio.
+ *
+ * Two passes over the active chains, faithful to the d6220 bring-up
+ * capture: arm every core (save the three gain regs, route the PHY in, gate
+ * the cal clock off), settle, then launch every core (gate the clock on, set
+ * the AFE_CAL_CTRL enable nibble, poll done/valid, drop the nibble, put the
+ * gain regs back). Completion is two STAT reads per try -- done from the
+ * first, valid from the second.
+ *
+ * Both writes of AFE_CAL_CTRL come from its own readback: the vendor writes
+ * <read>|0x000f to arm and <read> to disarm. The word carries a bandwidth
+ * field in its top bits -- 0x5830 at 20 MHz, 0x5030 at 40, 0x4230 at 80 --
+ * which is why it must not be a constant, and taking it from the register
+ * needs no table.
+ * [capture-ref: router-data/d6220/cold-sweep.zip!cold01-ch36-bw20.txt;
+ *   11237-11298]
+ * [capture-ref: router-data/d6220/hot-sweep.zip!segmenti/01-up-ch36-bw20.txt;
+ *   6907-6968]
+ */
+void b43_radio_2069_afecal(struct b43_wldev *dev)
+{
+	B43_AC_FN();
+	struct b43_phy_ac *ac = dev->phy.ac;
+	u16 gain_saved[B43_PHY_AC_MAX_CORES][3] = { { 0 } };
+	unsigned int core;
+
+	/* Enable the shared analog cal block (same gate rccal uses). */
+	r2069_mod(dev, R2069_RCCAL_EN1, 0x0080, 0x0080);
+
+	/* Pass 1: arm every active core with the cal clock gated off. */
+	for_each_set_bit(core, &ac->coremask, ac->num_cores) {
+		u16 rbase = (u16)(core << 9);	/* per-core radio window */
+		u16 pbase = (u16)(core << 9);	/* per-core PHY window */
+
+		/*
+		 * The three gain regs the arming masksets below perturb, read
+		 * once per core before touching them: pass 2 writes them back
+		 * from here. Same save/restore over the same three registers
+		 * that b43_phy_ac_idle_tssi_meas() does.
+		 */
+		gain_saved[core][0] = b43_phy_read(dev, 0x0739 + pbase);
+		gain_saved[core][1] = b43_phy_read(dev, 0x073a + pbase);
+		gain_saved[core][2] = b43_phy_read(dev, 0x0725 + pbase);
+
+		b43_phy_maskset(dev, 0x0739 + pbase, (u16)~0x0080, 0x0080);
+		b43_phy_maskset(dev, 0x0725 + pbase, (u16)~0x0004, 0x0004);
+		r2069_mod(dev, R2069_AFE_CAL_CLK | rbase, 0x1000, 0x0000);
+	}
+
+	udelay(100);
+
+	/* Pass 2: launch every active core, then finalize its PHY regs. */
+	for_each_set_bit(core, &ac->coremask, ac->num_cores) {
+		u16 rbase = (u16)(core << 9);
+		u16 pbase = (u16)(core << 9);
+		u16 post[2] = { 0, 0 }, ctrl = 0;
+
+
+		/*
+		 * Clock un-gate is the AFE_CAL_CLK[12] bit toggled by the two
+		 * r2069_mod above (off in pass 1, on here); the trace confirms
+		 * it, so no extra gating is needed.
+		 */
+		r2069_mod(dev, R2069_AFE_CAL_CLK | rbase, 0x1000, 0x1000);
+		ctrl = b43_radio_read(dev, R2069_AFE_CAL_CTRL | rbase);
+
+		/*
+		 * The vendor reads STAT only after the arming write, never before:
+		 * a CTRL readback while still disarmed, the CTRL arm write, 10 us,
+		 * two STAT reads, then the CTRL disarm write.
+		 */
+		b43_radio_write(dev, R2069_AFE_CAL_CTRL | rbase,
+				ctrl | 0x000f);
+		udelay(10);
+		post[0] = b43_radio_read_log(dev, R2069_AFE_CAL_STAT | rbase);
+		post[1] = b43_radio_read_log(dev, R2069_AFE_CAL_STAT | rbase);
+
+		b43dbg(dev->wl,
+		       "radio 2069: afecal core %u ctrl=0x%04x stat=0x%04x/0x%04x\n",
+		       core, ctrl, post[0], post[1]);
+
+		b43_radio_write(dev, R2069_AFE_CAL_CTRL | rbase, ctrl);
+
+		b43_phy_write(dev, 0x0739 + pbase, gain_saved[core][0]);
+		b43_phy_write(dev, 0x073a + pbase, gain_saved[core][1]);
+		b43_phy_write(dev, 0x0725 + pbase, gain_saved[core][2]);
+	}
+
+	/* Disable the cal block. */
+	r2069_mod(dev, R2069_RCCAL_EN1, 0x0080, 0x0000);
+}
+
+/*
+ * Band-preferred radio register block for radio_rev 4, run from
+ * b43_radio_2069_init right after the power-on setup pulse, before the
+ * chip-id-gated body. Table and writer touch only radio registers
+ * (b43_radio_write), like the rest of this file.
+ */
+static const u16 b43_r2069_prefregs_rev4[][2] = {
+	{ 0x063a, 0x0000 }, { 0x063d, 0x000f }, { 0x0645, 0x3000 },
+	{ 0x0646, 0x0303 }, { 0x0647, 0x36e2 }, { 0x0649, 0x6000 },
+	{ 0x064a, 0x0003 }, { 0x065e, 0x0ff4 }, { 0x0666, 0x0b2d },
+	{ 0x0667, 0x03ff }, { 0x0115, 0x3337 },
+	{ 0x0117, 0x1337 }, { 0x0718, 0x7777 }, { 0x071c, 0x1000 },
+	{ 0x0726, 0x0100 }, { 0x0727, 0x0002 }, { 0x0761, 0x0100 },
+	{ 0x0407, 0x8382 }, { 0x055e, 0x0020 }, { 0x0885, 0x0700 },
+	{ 0x08e9, 0x01ce }, { 0x08ea, 0x00ff }, { 0x08ec, 0x06ff },
+	{ 0x0972, 0x0600 },
+};
+
+/* [capture-ref: router-data/d6220/cold-sweep.zip!cold01-ch36-bw20.txt;
+ *   709-732]
+ * [capture-ref: router-data/d6220/hot-sweep.zip!segmenti/01-up-ch36-bw20.txt;
+ *   91-114]
+ */
+static void b43_r2069_prefregs_init(struct b43_wldev *dev)
+{
+	B43_AC_FN();
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(b43_r2069_prefregs_rev4); i++)
+		b43_radio_write(dev, b43_r2069_prefregs_rev4[i][0],
+				b43_r2069_prefregs_rev4[i][1]);
+}
+
+/*
+ * Radio 2069 power-on init. Called once from op_init. The only PHY-register
+ * touches here are the save/restore of 0x0728 and the fixed gating writes
+ * around the radio body, the same pattern as b43_radio_2069_afecal in this
+ * file.
+ */
+
+/* [capture-ref: router-data/d6220/cold-sweep.zip!cold01-ch36-bw20.txt;
+ *   692-850]
+ * [capture-ref: router-data/d6220/hot-sweep.zip!segmenti/01-up-ch36-bw20.txt;
+ *   74-232]
+ */
+void b43_radio_2069_init(struct b43_wldev *dev)
+{
+	B43_AC_FN();
+	u16 saved_728;
+
+	saved_728 = b43_phy_read_log(dev, 0x0728);
+	b43_phy_read_log(dev, 0x0408);	/* base read before the writes below; logged for HW (absolute write) */
+
+	/* --- Prologue: PHY register writes --- */
+	b43_phy_write(dev, 0x0415, 0x0000);
+	b43_phy_write(dev, 0x040e, 0x0000);
+	b43_phy_write(dev, 0x040c, 0x2000);
+	b43_phy_write(dev, B43_PHY_AC_RFCTL_CMD, 0x0c00);
+	b43_phy_write(dev, 0x0417, 0x0000);
+	b43_phy_write(dev, 0x0416, 0x000d);
+
+	/* 0x728 &= 0x7e7f (clears 0x8000/0x0100/0x0080); wl7 writes 0x720 = 0x03ff. */
+	b43_phy_write(dev, 0x0728, saved_728 & 0x7e7f);
+	b43_phy_read_log(dev, 0x0720);	/* base logged for HW; the write below is absolute */
+	b43_phy_write(dev, 0x0720, 0x03ff);
+	b43_phy_write(dev, B43_PHY_AC_RFCTL_CMD, 0x0c00);
+
+	b43_phy_write(dev, B43_PHY_AC_RFCTL_CMD, 0x0c01);
+	/* Hold armed 1032us for the RF/analog lock to complete. */
+	udelay(1032);
+	b43_phy_write(dev, B43_PHY_AC_RFCTL_CMD, 0x0c00);
+
+	if (dev->phy.radio_rev == 4)
+		b43_r2069_prefregs_init(dev);
+
+	/* --- Body (acphychipid ∈ {0x4360, 0x4352}) --- */
+	b43_radio_set(dev, 0x096b, 0x0800);
+	b43_radio_set(dev, 0x096b, 0x4000);
+	b43_radio_set(dev, 0x096c, 0x0800);
+	b43_radio_set(dev, 0x096b, 0x8000);
+	b43_radio_set(dev, 0x096b, 0x1000);
+	b43_radio_set(dev, 0x096b, 0x0004);
+	b43_radio_set(dev, 0x0407, 0x0002);
+	b43_radio_set(dev, 0x055e, 0x0010);	/* -> 0x0030 (0x0020|0x0010) */
+
+	{
+		unsigned int core;
+
+		/*
+		 * All num_cores silicon cores are still powered here: this runs
+		 * at rfkill-time, before channel_setup->rxcore_setstate, which
+		 * only masks the active RX chains (it does not power a core down).
+		 * The wl blob touches every core's radio space at this point
+		 * (incl. core 2 on the 2x2 d6220), so gate
+		 * on presence (num_cores), not on the antenna/active-chain mask.
+		 */
+		for (core = 0; core < dev->phy.ac->num_cores; core++) {
+			u16 stride = (u16)(core * 0x200);
+
+			b43_radio_maskset(dev, 0x0126 + stride, (u16)~0x0300, 0x0100);
+			b43_radio_maskset(dev, 0x0127 + stride, (u16)~0x0003, 0x0002);
+			b43_radio_maskset(dev, 0x006f + stride, (u16)~0x0004, 0x0000);
+			b43_radio_maskset(dev, 0x006f + stride, (u16)~0x0001, 0x0000);
+			b43_radio_maskset(dev, 0x006f + stride, (u16)~0x0002, 0x0000);
+			b43_radio_maskset(dev, 0x0065 + stride, (u16)~0x0001, 0x0000);
+		}
+	}
+
+	/* --- Epilogue (chip-agnostic), restores the SAVED 0x728 --- */
+	/* radio 0x040c bit4 low, PHY 0x0408 pulse, bit4 high. */
+	b43_radio_mask(dev, 0x040c, (u16)~0x0010);
+	b43_phy_write(dev, B43_PHY_AC_RFCTL_CMD, 0x0c06);
+	udelay(100);
+	b43_radio_set(dev, 0x040c, 0x0010);
+	b43_phy_write(dev, 0x0417, 0x000d);
+	udelay(100);
+	b43_phy_write(dev, B43_PHY_AC_RFCTL_CMD, 0x0c02);
+	b43_phy_write(dev, 0x0728, saved_728 | 0x0180);
+	b43_phy_write(dev, 0x0417, 0x0004);
+	b43_phy_write(dev, 0x0728, saved_728 & 0xfeff);
+}
+
+#define R2069_PWRON_POLL_MAX	100
+
+/*
+ * Radio power-on sequence, run once right after b43_radio_2069_init
+ * during software-rfkill unblock (op_software_rfkill). Pure radio-register
+ * block, no PHY touches.
+ * [capture-ref: router-data/d6220/cold-sweep.zip!cold01-ch36-bw20.txt;
+ *   851-910]
+ * [capture-ref: router-data/d6220/hot-sweep.zip!segmenti/01-up-ch36-bw20.txt;
+ *   233-292]
+ */
+void b43_radio_2069_pwron(struct b43_wldev *dev)
+{
+	B43_AC_FN();
+	unsigned int polls;
+	u16 pon;
+
+	b43_radio_set(dev,   0x08ea, 0x0040);
+	b43_radio_set(dev,   0x08ea, 0x0080);
+	b43_radio_mask(dev,  0x08ed, ~0x0600);
+	b43_radio_mask(dev,  0x08ed, ~0x1800);
+	b43_radio_set(dev,   0x0548, 0x0001);
+	b43_radio_write(dev, 0x0549, 0x0000);
+	b43_radio_write(dev, 0x054a, 0x0000);
+	b43_radio_write(dev, 0x054b, 0x0000);
+	b43_radio_write(dev, 0x054c, 0x0000);
+	b43_radio_mask(dev,  0x040b, ~0x0001);
+	udelay(1);
+	b43_radio_set(dev,   0x040b, 0x0001);	/* power-on kick */
+
+	/*
+	 * Bit 3 of 0x040b rises when the sequence completes: poll it every
+	 * 10 us, then read the register once more, as the vendor does.
+	 */
+	for (polls = 1; polls <= R2069_PWRON_POLL_MAX; polls++) {
+		udelay(10);
+		if (b43_radio_read(dev, 0x040b) & 0x0008)
+			break;
+	}
+	pon = b43_radio_read(dev, 0x040b);
+	if (!(pon & 0x0008))
+		b43warn(dev->wl, "radio 2069: power-on timeout (0x040b=0x%04x)\n",
+			pon);
+
+	b43_radio_mask(dev,  0x0548, ~0x0001);
+	b43_radio_mask(dev,  0x08ea, ~0x0040);
+	b43_radio_mask(dev,  0x08ea, ~0x0080);
+	b43_radio_mask(dev,  0x040b, ~0x0001);
+
+	/* pwron tail, dropped by the read-less attach port */
+	b43_radio_set(dev,     0x08ea, 0x0080);
+	b43_radio_maskset(dev, 0x08ed, (u16)~0x0600, 0x0400);
+
+	b43dbg(dev->wl, "phy-ac: radio pwron 0x040b readback: %04x after %u polls\n",
+	       pon, polls);
+}
Index: backports-7.2/drivers/net/wireless/broadcom/b43/radio_2069.h
===================================================================
--- /dev/null
+++ backports-7.2/drivers/net/wireless/broadcom/b43/radio_2069.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef B43_RADIO_2069_H_
+#define B43_RADIO_2069_H_
+
+#include <linux/types.h>
+
+struct b43_wldev;
+
+/* Per-core register routing for the 2069 radio. */
+
+/* One PHY-side row in the per-channel table. */
+/*
+ * One row of the per-channel table for the 2069 radio.
+ *
+ * All 45 cluster-1 values of an entry, u16[2..46], are radio writes:
+ *   radio_raw[39]  the first 39, offsets 4 to 80, registers 0x08e8 to 0x006f
+ *   chan_raw6[6]   the r2069_chan_writes batch, offsets 82 to 92, registers
+ *                  0x11a, 0x11b, 0x719, 0x630, 0x65c and 0x662
+ *
+ * The rows are chan_tuning_2069rev4 of the 6.30.102.7 blob, 2.4 and 5 GHz,
+ * with one register map for both bands. reverse-tools/check_channeltab.py
+ * checks them against the captures' BW20 segments.
+ */
+struct b43_phy_ac_channeltab_e_radio2069 {
+	u8  channel;
+	u16 freq;
+	u16 radio_raw[39];
+	u16 chan_raw6[6];
+	u16 phy_bw[6];
+};
+
+const struct b43_phy_ac_channeltab_e_radio2069 *
+b43_phy_ac_get_channeltab_e_r2069(struct b43_wldev *dev, u16 freq);
+
+void b43_radio_2069_channel_setup(struct b43_wldev *dev,
+	const struct b43_phy_ac_channeltab_e_radio2069 *e);
+
+void b43_radio_2069_rccal(struct b43_wldev *dev);
+
+void b43_radio_2069_afecal(struct b43_wldev *dev);
+
+void b43_radio_2069_init(struct b43_wldev *dev);
+
+void b43_radio_2069_pwron(struct b43_wldev *dev);
+
+void b43_radio_2069_afe_lpf_stage(struct b43_wldev *dev, u16 afe_728);
+
+#endif /* B43_RADIO_2069_H_ */
Index: backports-7.2/drivers/net/wireless/broadcom/b43/tables_phy_ac.c
===================================================================
--- /dev/null
+++ backports-7.2/drivers/net/wireless/broadcom/b43/tables_phy_ac.c
@@ -0,0 +1,1082 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Broadcom B43 wireless driver
+ * AC-PHY init tables and the bulk write path that feeds them into the chip
+ *
+ * Copyright (c) 2026 Alessio Ferri <alessio.ferri.3012@gmail.com>
+ * Copyright (c) 2026 Andreas Wendleder <andreas.wendleder@proton.me>
+ */
+
+#include "b43.h"
+#include "phy_ac.h"
+#include "tables_phy_ac.h"
+
+/* PHY-table-write gate (file-local) */
+
+u16 b43_phy_ac_tbl_write_lock(struct b43_wldev *dev)
+{
+	u16 saved = b43_phy_read_log(dev, B43_PHY_AC_REG_TBL_WRITE_GATE);
+
+	b43_phy_maskset(dev, B43_PHY_AC_REG_TBL_WRITE_GATE,
+			(u16)~B43_PHY_AC_TBL_WRITE_GATE_LOCK,
+			B43_PHY_AC_TBL_WRITE_GATE_LOCK);
+	return saved;
+}
+
+void b43_phy_ac_tbl_write_unlock(struct b43_wldev *dev, u16 saved)
+{
+	b43_phy_maskset(dev, B43_PHY_AC_REG_TBL_WRITE_GATE,
+			(u16)~B43_PHY_AC_TBL_WRITE_GATE_LOCK,
+			saved & B43_PHY_AC_TBL_WRITE_GATE_LOCK);
+}
+
+/* Bulk table write */
+
+/*
+ * One 48-bit cell through the DATA_2 port. The first word selects the port,
+ * the other two go to the PHY data register without selecting it again, as
+ * the vendor does.
+ */
+static void actab_write_cell48(struct b43_wldev *dev, u16 w0, u16 w1, u16 w2)
+{
+	b43_phy_write(dev, B43_PHY_AC_TABLE_DATA_2, w0);
+	b43_write16(dev, B43_MMIO_PHY_DATA, w1);
+	b43_write16(dev, B43_MMIO_PHY_DATA, w2);
+}
+
+/*
+ * Shared body of the bulk writes: write a contiguous run of values into one of
+ * the PHY's internal tables. @peek decides whether to re-read the 0x019e gate
+ * before the id/offset/data sequence. The stock driver re-reads it for every
+ * bulk emitted with the gate unlocked, but not when the caller holds it locked
+ * across a run -- in a table load there is one peek, at the lock.
