+/* 5 GHz pa5ga subband group (0..3) for a channel freq, per subband5gver. */
+static unsigned int b43_phy_ac_pa5g_group(struct b43_wldev *dev, u16 freq)
+{
+	switch (dev->dev->bus_sprom->subband5gver) {
+	case 4:
+		if (freq < 5250)
+			return 0;
+		if (freq < 5500)
+			return 1;
+		if (freq > 5744)
+			return 3;
+		return 2;
+	case 1:
+		if (freq < 5250)
+			return 0;
+		if (freq > 5744)
+			return 2;
+		return 1;
+	case 0:
+		if (freq < 5500)
+			return 0;
+		if (freq < 5745)
+			return 1;
+		return 2;
+	default:
+		if (freq < 5100)
+			return 0;
+		if (freq > 5499)
+			return 2;
+		return 1;
+	}
+}
