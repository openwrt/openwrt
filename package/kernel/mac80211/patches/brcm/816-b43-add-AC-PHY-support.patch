+
+#include <linux/delay.h>
+
+#include "b43.h"
+#include "phy_ac.h"
+#include "radio_2069.h"
+#include "main.h"
+
+static const struct b43_phy_ac_channeltab_e_radio2069
+b43_chantab_r2069[] = {
+	{ /* chan   1, 2412 MHz */
+		.channel = 1,
+		.freq    = 2412,
+		.radio_raw = {
+			0x0005, 0x001e, 0x0a09, 0x0e21, 0x00b4, 0xe666,
+			0x02d3, 0x9999, 0x0000, 0x0488, 0x0cef, 0x0000,
