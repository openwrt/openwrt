 static void b43_phy_ac_op_adjust_txpower(struct b43_wldev *dev)
 {
+	B43_AC_FN();
+	b43_mac_suspend(dev);
+	b43_phy_ac_txpwr_adjust(dev);
+	b43_mac_enable(dev);
