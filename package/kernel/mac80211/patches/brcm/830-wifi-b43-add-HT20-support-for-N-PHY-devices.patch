From c5c17dac81dfa0103b21af24fe4bc0a725b512dc Mon Sep 17 00:00:00 2001
From: Rosen Penev <rosenp@gmail.com>
Date: Thu, 15 Oct 2026 00:50:04 -0700
Subject: [PATCH 830/846] wifi: b43: add HT20 support for N-PHY devices

b43 drives N-PHY devices as 802.11a/g only, although their firmware
can send and receive 802.11n frames. The TX header already has the
fields for HT rates, but the driver never fills them in.

Build HT frames when mac80211 picks an MCS for the main or the
fallback rate:

 - an HT-SIG instead of a legacy PLCP header,
 - the HT encoding in the PHY TX control word,
 - PHY TX control word 1 with the modulation and coding of the MCS,
 - the L-SIG length of the mixed-mode preamble in the MIMO mode
   length fields, and
 - the MCS as the main rate.

The values follow the brcmsmac driver, which builds the same TX header
for a newer version of the same firmware.

Only the TX header of firmware 598 and newer has room for an HT-SIG.
The firmware is loaded after the bands are registered, so with older
firmware b43 still advertises HT, but sends the legacy OFDM rate
closest to the MCS that mac80211 picked, and warns about it.

Advertise HT20 with MCS 0-7 in the 2.4 GHz band. Two spatial streams,
40 MHz, the 5 GHz band and A-MPDU are left out.

Tested on an ASUS RT-N16 (BCM4718, N-PHY rev 5, firmware 666.2) as an
access point with an Intel 3168 client, open and with WPA2 using
hardware CCMP. At -50 dBm, with the per-rate TX power backoff in
place, the router sends at MCS 7 and receives at MCS 4-7, and iperf3
traffic flows both ways without errors.

Signed-off-by: Rosen Penev <rosenp@gmail.com>
---
 drivers/net/wireless/broadcom/b43/main.c |  51 ++++++-
 drivers/net/wireless/broadcom/b43/xmit.c | 168 ++++++++++++++++++++---
 2 files changed, 198 insertions(+), 21 deletions(-)

--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -365,6 +365,46 @@ static struct ieee80211_supported_band b
 	.n_bitrates	= b43_g_ratetable_size,
 };
 
+/* HT20 with one spatial stream and no A-MPDU */
+#define B43_HT_CAP {							\
+	.ht_supported	= true,						\
+	.cap		= IEEE80211_HT_CAP_SM_PS,			\
+	.ampdu_factor	= IEEE80211_HT_MAX_AMPDU_8K,			\
+	.ampdu_density	= IEEE80211_HT_MPDU_DENSITY_NONE,		\
+	.mcs = {							\
+		.rx_mask	= { 0xff },				\
+		.tx_params	= IEEE80211_HT_MCS_TX_DEFINED,		\
+	},								\
+}
+
+static struct ieee80211_supported_band b43_band_2ghz_ht = {
+	.band		= NL80211_BAND_2GHZ,
+	.channels	= b43_2ghz_chantable,
+	.n_channels	= ARRAY_SIZE(b43_2ghz_chantable),
+	.bitrates	= b43_g_ratetable,
+	.n_bitrates	= b43_g_ratetable_size,
+	.ht_cap		= B43_HT_CAP,
+};
+
+static struct ieee80211_supported_band b43_band_2ghz_limited_ht = {
+	.band		= NL80211_BAND_2GHZ,
+	.channels	= b43_2ghz_chantable,
+	.n_channels	= b43_2ghz_chantable_limited_size,
+	.bitrates	= b43_g_ratetable,
+	.n_bitrates	= b43_g_ratetable_size,
+	.ht_cap		= B43_HT_CAP,
+};
+
+/*
+ * Whether b43 enables HT on the PHY of @dev. HT needs the 598 firmware TX
+ * header. The firmware is not loaded when the bands are set up: with an
+ * older one, b43_generate_txhdr() sends legacy rates.
+ */
+static bool b43_ht_supported(struct b43_wldev *dev)
+{
+	return dev->phy.type == B43_PHYTYPE_N;
+}
+
 static void b43_wireless_core_exit(struct b43_wldev *dev);
 static int b43_wireless_core_init(struct b43_wldev *dev);
 static struct b43_wldev * b43_wireless_core_stop(struct b43_wldev *dev);
@@ -2711,6 +2751,9 @@ static int b43_upload_microcode(struct b
 		dev->fw.hdr_format = B43_FW_HDR_351;
 	WARN_ON(dev->fw.opensource != (fwdate == 0xFFFF));
 
+	if (b43_ht_supported(dev) && dev->fw.hdr_format != B43_FW_HDR_598)
+		b43warn(dev->wl, "HT needs firmware 598 or newer, sending legacy rates only\n");
+
 	dev->qos_enabled = dev->wl->hw->queues > 1;
 	/* Default to firmware/hardware crypto acceleration. */
 	dev->hwcrypto_enabled = true;
@@ -5359,6 +5402,7 @@ static int b43_setup_bands(struct b43_wl
 	struct b43_phy *phy = &dev->phy;
 	bool limited_2g;
 	bool limited_5g;
+	bool ht;
 
 	/* We don't support all 2 GHz channels on some devices */
 	limited_2g = phy->radio_ver == 0x2057 &&
@@ -5366,7 +5410,12 @@ static int b43_setup_bands(struct b43_wl
 	limited_5g = phy->radio_ver == 0x2057 &&
 		     phy->radio_rev == 9;
 
-	if (have_2ghz_phy)
+	ht = b43_ht_supported(dev);
+
+	if (have_2ghz_phy && ht)
+		hw->wiphy->bands[NL80211_BAND_2GHZ] = limited_2g ?
+			&b43_band_2ghz_limited_ht : &b43_band_2ghz_ht;
+	else if (have_2ghz_phy)
 		hw->wiphy->bands[NL80211_BAND_2GHZ] = limited_2g ?
 			&b43_band_2ghz_limited : &b43_band_2GHz;
 	if (dev->phy.type == B43_PHYTYPE_N) {
--- a/drivers/net/wireless/broadcom/b43/xmit.c
+++ b/drivers/net/wireless/broadcom/b43/xmit.c
@@ -192,6 +192,64 @@ static u16 b43_generate_tx_phy_ctl1(stru
 	return control;
 }
 
+/* PHY TX control word 1 modulation and coding byte for MCS 0-7 */
+static const u8 b43_ht_phy_ctl1_mod[] = {
+	0x00, 0x08, 0x0a, 0x10, 0x12, 0x19, 0x1a, 0x1c,
+};
+
+/* Data rate of MCS 0-7 at 20 MHz with the long guard interval, in kbit/s */
+static const u16 b43_ht_rate_kbps[] = {
+	6500, 13000, 19500, 26000, 39000, 52000, 58500, 65000,
+};
+
+/* Legacy rate closest to MCS 0-7, for firmware without HT TX support */
+static const u8 b43_ht_legacy_rate[] = {
+	B43_OFDM_RATE_6MB, B43_OFDM_RATE_12MB, B43_OFDM_RATE_18MB,
+	B43_OFDM_RATE_24MB, B43_OFDM_RATE_36MB, B43_OFDM_RATE_48MB,
+	B43_OFDM_RATE_54MB, B43_OFDM_RATE_54MB,
+};
+
+static u16 b43_generate_tx_phy_ctl1_ht(u8 mcs)
+{
+	return B43_TXH_PHY1_BW_20 | B43_TXH_PHY1_MODE_SISO |
+	       (b43_ht_phy_ctl1_mod[mcs] << 8);
+}
+
+/* Generate a mixed-mode HT PLCP header (HT-SIG) */
+static void b43_generate_ht_plcp_hdr(struct b43_plcp_hdr6 *plcp,
+				     unsigned int octets, u8 mcs, bool sgi)
+{
+	memset(plcp, 0, sizeof(*plcp));
+	plcp->raw[0] = mcs;
+	plcp->raw[1] = octets & 0xff;
+	plcp->raw[2] = (octets >> 8) & 0xff;
+	/* Smoothing, not a sounding PPDU, reserved bit set */
+	plcp->raw[3] = 0x07;
+	if (sgi)
+		plcp->raw[3] |= 0x80;
+}
+
+/*
+ * The L-SIG length of a mixed-mode HT frame, which legacy stations use to
+ * defer for the whole frame: its duration in 4 us legacy symbols, as bytes
+ * at 6 Mbit/s.
+ */
+static u16 b43_ht_lsig_len(u8 mcs, bool sgi, unsigned int octets)
+{
+	unsigned int kbps = b43_ht_rate_kbps[mcs];
+	unsigned int nsyms;
+
+	if (sgi)
+		kbps = DIV_ROUND_UP(kbps * 10, 9);
+
+	/* 16 service bits and 6 tail bits, in 4 us symbols */
+	nsyms = DIV_ROUND_UP((16 + 8 * octets + 6) * 1000, kbps * 4);
+	/* One HT-LTF for one spatial stream, two HT-SIG and the HT-STF */
+	nsyms += 1 + 3;
+
+	return 3 * nsyms - 3;
+}
+
 static u8 b43_calc_fallback_rate(u8 bitrate, int gmode)
 {
 	switch (bitrate) {
@@ -256,19 +314,61 @@ int b43_generate_txhdr(struct b43_wldev
 			      phy->type == B43_PHYTYPE_N ||
 			      phy->type == B43_PHYTYPE_HT);
 	u8 extra_ft = 0;
-	struct ieee80211_rate *txrate;
-	struct ieee80211_tx_rate *rates;
+	struct ieee80211_rate *txrate = NULL;
+	struct ieee80211_tx_rate *rates = info->control.rates;
+	struct ieee80211_tx_rate *rate_fb_ctl;
+	/* Only the 598 TX header has room for an HT-SIG */
+	bool ht_fw = dev->fw.hdr_format == B43_FW_HDR_598;
+	bool ht, ht_fb, sgi, sgi_fb;
+	u8 mcs = 0, mcs_fb = 0;
 
 	memset(txhdr, 0, sizeof(*txhdr));
 
-	txrate = ieee80211_get_tx_rate(dev->wl->hw, info);
-	rate = txrate ? txrate->hw_value : B43_CCK_RATE_1MB;
+	/* HT rates are MCS indices, not indices into the bitrate table */
+	ht = rates[0].flags & IEEE80211_TX_RC_MCS;
+	rate_fb_ctl = rates[1].idx >= 0 ? &rates[1] : &rates[0];
+	ht_fb = rate_fb_ctl->flags & IEEE80211_TX_RC_MCS;
+	sgi = rates[0].flags & IEEE80211_TX_RC_SHORT_GI;
+	sgi_fb = rate_fb_ctl->flags & IEEE80211_TX_RC_SHORT_GI;
+
+	if (ht) {
+		mcs = rates[0].idx;
+		if (B43_WARN_ON(mcs >= ARRAY_SIZE(b43_ht_rate_kbps)))
+			return -EINVAL;
+		if (ht_fw) {
+			rate = B43_OFDM_RATE_6MB;
+		} else {
+			ht = false;
+			rate = b43_ht_legacy_rate[mcs];
+		}
+	} else {
+		txrate = ieee80211_get_tx_rate(dev->wl->hw, info);
+		rate = txrate ? txrate->hw_value : B43_CCK_RATE_1MB;
+	}
 	rate_ofdm = b43_is_ofdm_rate(rate);
-	fbrate = ieee80211_get_alt_retry_rate(dev->wl->hw, info, 0) ? : txrate;
-	rate_fb = fbrate->hw_value;
+
+	if (ht_fb) {
+		mcs_fb = rate_fb_ctl->idx;
+		if (B43_WARN_ON(mcs_fb >= ARRAY_SIZE(b43_ht_rate_kbps)))
+			return -EINVAL;
+		fbrate = NULL;
+		if (ht_fw) {
+			rate_fb = B43_OFDM_RATE_6MB;
+		} else {
+			ht_fb = false;
+			rate_fb = b43_ht_legacy_rate[mcs_fb];
+		}
+	} else {
+		fbrate = ieee80211_get_alt_retry_rate(dev->wl->hw, info, 0);
+		if (!fbrate)
+			fbrate = txrate;
+		rate_fb = fbrate ? fbrate->hw_value : B43_CCK_RATE_1MB;
+	}
 	rate_fb_ofdm = b43_is_ofdm_rate(rate_fb);
 
-	if (rate_ofdm)
+	if (ht)
+		txhdr->phy_rate = mcs;
+	else if (rate_ofdm)
 		txhdr->phy_rate = b43_plcp_get_ratecode_ofdm(rate);
 	else
 		txhdr->phy_rate = b43_plcp_get_ratecode_cck(rate);
@@ -276,9 +376,9 @@ int b43_generate_txhdr(struct b43_wldev
 	memcpy(txhdr->tx_receiver, wlhdr->addr1, ETH_ALEN);
 
 	/* Calculate duration for fallback rate */
-	if ((rate_fb == rate) ||
+	if (ht || !fbrate || rate_fb == rate ||
 	    (wlhdr->duration_id & cpu_to_le16(0x8000)) ||
-	    (wlhdr->duration_id == cpu_to_le16(0))) {
+	    wlhdr->duration_id == cpu_to_le16(0)) {
 		/* If the fallback rate equals the normal rate or the
 		 * dur_id field contains an AID, CFP magic or 0,
 		 * use the original dur_id field. */
@@ -339,8 +439,12 @@ int b43_generate_txhdr(struct b43_wldev
 	}
 	switch (dev->fw.hdr_format) {
 	case B43_FW_HDR_598:
-		b43_generate_plcp_hdr((struct b43_plcp_hdr4 *)(&txhdr->format_598.plcp),
-				      plcp_fragment_len, rate);
+		if (ht)
+			b43_generate_ht_plcp_hdr(&txhdr->format_598.plcp,
+						 plcp_fragment_len, mcs, sgi);
+		else
+			b43_generate_plcp_hdr((struct b43_plcp_hdr4 *)(&txhdr->format_598.plcp),
+					      plcp_fragment_len, rate);
 		break;
 	case B43_FW_HDR_351:
 		b43_generate_plcp_hdr((struct b43_plcp_hdr4 *)(&txhdr->format_351.plcp),
@@ -351,11 +455,17 @@ int b43_generate_txhdr(struct b43_wldev
 				      plcp_fragment_len, rate);
 		break;
 	}
-	b43_generate_plcp_hdr((struct b43_plcp_hdr4 *)(&txhdr->plcp_fb),
-			      plcp_fragment_len, rate_fb);
+	if (ht_fb)
+		b43_generate_ht_plcp_hdr(&txhdr->plcp_fb, plcp_fragment_len,
+					 mcs_fb, sgi_fb);
+	else
+		b43_generate_plcp_hdr((struct b43_plcp_hdr4 *)(&txhdr->plcp_fb),
+				      plcp_fragment_len, rate_fb);
 
 	/* Extra Frame Types */
-	if (rate_fb_ofdm)
+	if (ht_fb)
+		extra_ft |= B43_TXH_EFT_FB_HT;
+	else if (rate_fb_ofdm)
 		extra_ft |= B43_TXH_EFT_FB_OFDM;
 	else
 		extra_ft |= B43_TXH_EFT_FB_CCK;
@@ -367,7 +477,9 @@ int b43_generate_txhdr(struct b43_wldev
 	txhdr->chan_radio_code = phy->channel;
 
 	/* PHY TX Control word */
-	if (rate_ofdm)
+	if (ht)
+		phy_ctl |= B43_TXH_PHY_ENC_HT;
+	else if (rate_ofdm)
 		phy_ctl |= B43_TXH_PHY_ENC_OFDM;
 	else
 		phy_ctl |= B43_TXH_PHY_ENC_CCK;
@@ -394,7 +506,6 @@ int b43_generate_txhdr(struct b43_wldev
 		B43_WARN_ON(1);
 	}
 
-	rates = info->control.rates;
 	/* MAC control */
 	if (!(info->flags & IEEE80211_TX_CTL_NO_ACK))
 		mac_ctl |= B43_TXH_MAC_ACK;
@@ -553,10 +664,27 @@ int b43_generate_txhdr(struct b43_wldev
 	}
 
 	if (fill_phy_ctl1) {
-		txhdr->phy_ctl1 =
-			cpu_to_le16(b43_generate_tx_phy_ctl1(dev, rate));
-		txhdr->phy_ctl1_fb =
-			cpu_to_le16(b43_generate_tx_phy_ctl1(dev, rate_fb));
+		u16 len;
+
+		if (ht) {
+			txhdr->phy_ctl1 =
+				cpu_to_le16(b43_generate_tx_phy_ctl1_ht(mcs));
+			len = b43_ht_lsig_len(mcs, sgi, plcp_fragment_len);
+			txhdr->mimo_modelen = cpu_to_le16(len);
+		} else {
+			txhdr->phy_ctl1 =
+				cpu_to_le16(b43_generate_tx_phy_ctl1(dev, rate));
+		}
+		if (ht_fb) {
+			txhdr->phy_ctl1_fb =
+				cpu_to_le16(b43_generate_tx_phy_ctl1_ht(mcs_fb));
+			len = b43_ht_lsig_len(mcs_fb, sgi_fb,
+					      plcp_fragment_len);
+			txhdr->mimo_ratelen_fb = cpu_to_le16(len);
+		} else {
+			txhdr->phy_ctl1_fb =
+				cpu_to_le16(b43_generate_tx_phy_ctl1(dev, rate_fb));
+		}
 	}
 
 	/* Apply the bitfields */
