+	 * underflow counter (ucode 907 shm 0xEC + 2 * FIFO); zeroed with the
+	 * core init like the ucode's own copy.
+	 */
+	u16 txfunfl;
 };
 #define B43_AC_AMPDU_NFIFO	8	/* frame id bits 0..2 */
 
