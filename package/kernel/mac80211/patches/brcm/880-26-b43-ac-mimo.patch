 drivers/net/wireless/broadcom/b43/dma.c  |  24 ++-
 drivers/net/wireless/broadcom/b43/main.c |  16 +-
 drivers/net/wireless/broadcom/b43/xmit.c | 433 +++++++++++++++++++++++++-
 drivers/net/wireless/broadcom/b43/xmit.h |  28 ++
 5 files changed, 484 insertions(+), 23 deletions(-)

