+/*
+ * wlc_bmac_ifsctl_vht_set(hw, 1) @0x15f708 for the chanspec just set, as
+ * wlc_set_chanspec calls it after every channel set on PHY type 11
+ * (0x120fa8). 20 MHz (0x15f76c..0x15f7a0): MMIO 0x6c6 and shm 0x5a =
+ * 0x0f0f. 40 MHz (0x15f7a8..0x15f874, ht40-2069.md): MMIO 0x6c8 = 1 with the
+ * upper control sideband, 2 with the lower; then v = 0x303, or that value
+ * ^ 0x303 when host flag word 0 bit 0 (ANTDIVHELP, wl's band->mhfs[0] at
+ * band+8, 0x15f7d8..0x15f7ec) is set, masked with 0x0f0f (0x15f844), to shm
+ * 0x5a and MMIO 0x6c6. Then wlc_acphy_set_scramb_dyn_bw_en (tail call
+ * 0x15f888): PHY 0x042 bit 15 (99h); the channel set may reset PHY 0x042.
+ */
+static void b43_ac_ifsctl_vht_set(struct b43_wldev *dev, u16 chanspec)
+{
+	u16 v;
+
+	if (b43_ac_chanspec_is40(chanspec)) {
+		v = (chanspec & B43_AC_CHANSPEC_SB) ? 1 : 2;
+		b43_write16(dev, 0x6C8, v);
+		if (b43_hf_read(dev) & B43_HF_ANTDIVHELP)
+			v ^= 0x0303;
+		else
+			v = 0x0303;
+		v &= 0x0F0F;
+		b43_shm_write16(dev, B43_SHM_SHARED, 0x005A, v);
+		b43_write16(dev, 0x6C6, v);
+	} else {
+		b43_write16(dev, 0x6C6, 0x0F0F);
+		b43_shm_write16(dev, B43_SHM_SHARED, 0x005A, 0x0F0F);
+	}
+	b43_phy_set(dev, 0x042, 0x8000);
+}
