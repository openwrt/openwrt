+static void b43_nphy_set_rx_core_state(struct b43_wldev *dev, u8 mask);
+
+/*
+ * N-PHY rev 3+ RX I/Q calibration, ported from brcmsmac
+ * (wlc_phy_cal_rxiq_nphy_rev3() and its helpers in phy_n.c).
+ */
+#define B43_NPHY_RXCAL_TONEAMP		181
+#define B43_NPHY_RXCAL_TONEFREQ_40MHZ	4000
+#define B43_NPHY_RXCAL_TONEFREQ_20MHZ	2000
+
+struct b43_nphy_rxcal_gain {
+	u16 hpvga;
+	u16 lpf_biq1;
+	u16 lpf_biq0;
+	u16 lna2;
+	u16 lna1;
+	s8 txpwrindex;
+};
+
+#define B43_NPHY_RXCAL_MAXGAININDEX	(6 - 1)
+
+static const struct b43_nphy_rxcal_gain b43_nphy_rxcal_gain_5ghz[] = {
+	{ 0, 0, 0, 0, 0, 100 },
+	{ 0, 0, 0, 0, 0, 50 },
+	{ 0, 0, 0, 0, 0, -1 },
+	{ 0, 0, 0, 3, 0, -1 },
+	{ 0, 0, 3, 3, 0, -1 },
+	{ 0, 2, 3, 3, 0, -1 },
+};
+
+/*
+ * brcmsmac has 128 as the first TX power index, in an s8 field, so the value
+ * it uses is -128: it restores the saved TX gain rather than setting one.
+ */
+static const struct b43_nphy_rxcal_gain b43_nphy_rxcal_gain_2ghz[] = {
+	{ 0, 0, 0, 0, 0, -128 },
+	{ 0, 0, 0, 0, 0, 70 },
+	{ 0, 0, 0, 0, 0, 20 },
+	{ 0, 0, 0, 3, 0, 20 },
+	{ 0, 0, 3, 3, 0, 20 },
+	{ 0, 2, 3, 3, 0, 20 },
+};
+
+static const struct b43_nphy_rxcal_gain b43_nphy_rxcal_gain_5ghz_rev7[] = {
+	{ 0, 0, 0, 0, 0, 100 },
+	{ 0, 0, 0, 0, 0, 50 },
+	{ 0, 0, 0, 0, 0, -1 },
+	{ 0, 0, 0, 3, 0, -1 },
+	{ 0, 0, 3, 3, 0, -1 },
+	{ 0, 0, 5, 3, 0, -1 },
+};
+
+static const struct b43_nphy_rxcal_gain b43_nphy_rxcal_gain_2ghz_rev7[] = {
+	{ 0, 0, 0, 0, 0, 10 },
+	{ 0, 0, 0, 1, 0, 10 },
+	{ 0, 0, 1, 2, 0, 10 },
+	{ 0, 0, 1, 3, 0, 10 },
+	{ 0, 0, 4, 3, 0, 10 },
+	{ 0, 0, 6, 3, 0, 10 },
+};
+
+enum b43_nphy_rxcal_gain_dirn {
+	B43_NPHY_RXCAL_GAIN_INIT,
+	B43_NPHY_RXCAL_GAIN_UP,
+	B43_NPHY_RXCAL_GAIN_DOWN,
+};
+
+/*
+ * Set a fixed TX power index on the cores of core_mask, or with a negative
+ * index restore the TX gain saved when the first index was set.
+ * Port of brcmsmac's wlc_phy_txpwr_index_nphy().
+ */
+static void b43_nphy_tx_pwr_index(struct b43_wldev *dev, u8 core_mask,
+				  s8 txpwrindex, bool restore_cals)
+{
+	struct b43_phy_n *nphy = dev->phy.n;
+	struct b43_phy_n_txpwrindex *txpi;
+	u16 tx_ind0 = 192, iq_ind0 = 320, lo_ind0 = 448;
+	u16 rad_gain, dac_gain, m1m2, iqcomp_a, iqcomp_b, tmp;
+	u16 afe_over, dac_gain_reg, buf[2];
+	u32 txgain, iqcomp, locomp;
+	bool tx_pwr_ctrl_state;
+	s32 rfpwr_offset;
+	u8 core, tbl, bbmult;
+
+	if (nphy->hang_avoid)
+		b43_nphy_stay_in_carrier_search(dev, true);
+
+	for (core = 0; core < 2; core++) {
+		if (!(core_mask & (1 << core)))
+			continue;
+
+		txpi = &nphy->txpwrindex[core];
+		tbl = (core == 0) ? 26 : 27;
+		afe_over = (core == 0) ? B43_NPHY_AFECTL_OVER1 :
+					 B43_NPHY_AFECTL_OVER;
+		dac_gain_reg = (core == 0) ? B43_NPHY_AFECTL_DACGAIN1 :
+					     B43_NPHY_AFECTL_DACGAIN2;
+
+		if (txpwrindex < 0) {
+			if (txpi->index < 0)
+				continue;
+
+			if (dev->phy.rev >= 3) {
+				b43_phy_maskset(dev, B43_NPHY_AFECTL_OVER1,
+						~0x0100,
+						txpi->AfectrlOverride & 0x0100);
+				b43_phy_maskset(dev, B43_NPHY_AFECTL_OVER,
+						~0x0100,
+						txpi->AfectrlOverride & 0x0100);
+			} else {
+				b43_phy_maskset(dev, B43_NPHY_AFECTL_OVER,
+						~0x4000,
+						txpi->AfectrlOverride & 0x4000);
+			}
+
+			b43_phy_write(dev, dac_gain_reg, txpi->AfeCtrlDacGain);
+
+			b43_ntab_write(dev, B43_NTAB16(7, 0x110 + core),
+				       txpi->rad_gain);
+
+			m1m2 = b43_ntab_read(dev, B43_NTAB16(15, 87));
+			m1m2 &= (core == 0) ? 0x00FF : 0xFF00;
+			m1m2 |= (core == 0) ? (txpi->bbmult << 8) :
+					      txpi->bbmult;
+			b43_ntab_write(dev, B43_NTAB16(15, 87), m1m2);
+
+			if (restore_cals) {
+				buf[0] = txpi->iqcomp_a;
+				buf[1] = txpi->iqcomp_b;
+				b43_ntab_write_bulk(dev,
+						    B43_NTAB16(15, 80 + 2 * core),
+						    2, buf);
+				b43_ntab_write(dev, B43_NTAB16(15, 85 + core),
+					       txpi->locomp);
+				b43_ntab_write(dev, B43_NTAB16(15, 93 + core),
+					       txpi->locomp);
+			}
+
+			b43_nphy_tx_power_ctrl(dev, nphy->txpwrctrl);
+
+			txpi->index_internal = txpi->index_internal_save;
+		} else {
+			if (txpi->index < 0) {
+				if (dev->phy.rev >= 3) {
+					b43_phy_maskset(dev,
+							B43_NPHY_AFECTL_OVER1,
+							~0x0100,
+							txpi->AfectrlOverride &
+							0x0100);
+					b43_phy_maskset(dev,
+							B43_NPHY_AFECTL_OVER,
+							~0x0100,
+							txpi->AfectrlOverride &
+							0x0100);
+				} else {
+					txpi->AfectrlOverride =
+						b43_phy_read(dev,
+							     B43_NPHY_AFECTL_OVER);
+				}
+
+				txpi->AfeCtrlDacGain =
+					b43_phy_read(dev, dac_gain_reg);
+
+				txpi->rad_gain =
+					b43_ntab_read(dev,
+						      B43_NTAB16(7, 0x110 + core));
+
+				tmp = b43_ntab_read(dev, B43_NTAB16(15, 87));
+				tmp >>= (core == 0) ? 8 : 0;
+				txpi->bbmult = tmp & 0xFF;
+
+				b43_ntab_read_bulk(dev,
+						   B43_NTAB16(15, 80 + 2 * core),
+						   2, buf);
+				txpi->iqcomp_a = buf[0];
+				txpi->iqcomp_b = buf[1];
+
+				txpi->locomp =
+					b43_ntab_read(dev,
+						      B43_NTAB16(15, 85 + core));
+
+				txpi->index_internal_save =
+					txpi->index_internal;
+			}
+
+			tx_pwr_ctrl_state = nphy->txpwrctrl;
+			b43_nphy_tx_power_ctrl(dev, false);
+
+			if (dev->phy.rev == 1)
+				b43_phy_force_clock(dev, 1);
+
+			txgain = b43_ntab_read(dev,
+					       B43_NTAB32(tbl,
+							  tx_ind0 + txpwrindex));
+
+			if (dev->phy.rev >= 3)
+				rad_gain = (txgain >> 16) & 0x1FFFF;
+			else
+				rad_gain = (txgain >> 16) & 0x1FFF;
+
+			dac_gain = (txgain >> 8) & 0x3F;
+			bbmult = txgain & 0xFF;
+
+			if (dev->phy.rev >= 3)
+				b43_phy_set(dev, afe_over, 0x0100);
+			else
+				b43_phy_set(dev, B43_NPHY_AFECTL_OVER, 0x4000);
+
+			b43_phy_write(dev, dac_gain_reg, dac_gain);
+
+			b43_ntab_write(dev, B43_NTAB16(7, 0x110 + core),
+				       rad_gain);
+
+			m1m2 = b43_ntab_read(dev, B43_NTAB16(15, 87));
+			m1m2 &= (core == 0) ? 0x00FF : 0xFF00;
+			m1m2 |= (core == 0) ? (bbmult << 8) : bbmult;
+			b43_ntab_write(dev, B43_NTAB16(15, 87), m1m2);
+
+			iqcomp = b43_ntab_read(dev,
+					       B43_NTAB32(tbl,
+							  iq_ind0 + txpwrindex));
+			iqcomp_a = (iqcomp >> 10) & 0x3FF;
+			iqcomp_b = iqcomp & 0x3FF;
+
+			if (restore_cals) {
+				buf[0] = iqcomp_a;
+				buf[1] = iqcomp_b;
+				b43_ntab_write_bulk(dev,
+						    B43_NTAB16(15, 80 + 2 * core),
+						    2, buf);
+			}
+
+			locomp = b43_ntab_read(dev,
+					       B43_NTAB32(tbl,
+							  lo_ind0 + txpwrindex));
+			if (restore_cals)
+				b43_ntab_write(dev, B43_NTAB16(15, 85 + core),
+					       locomp);
+
+			if (dev->phy.rev == 1)
+				b43_phy_force_clock(dev, 0);
+
+			if (b43_nphy_ipa(dev)) {
+				u16 reg = (core == 0) ? B43_NPHY_PAPD_EN0 :
+							B43_NPHY_PAPD_EN1;
+
+				rfpwr_offset =
+					b43_ntab_read(dev,
+						      B43_NTAB32(tbl,
+								 576 + txpwrindex));
+				b43_phy_maskset(dev, reg, ~(0x1FF << 4),
+						((s16)rfpwr_offset << 4) &
+						(0x1FF << 4));
+				b43_phy_set(dev, reg, 0x0004);
+			}
+
+			b43_nphy_tx_power_ctrl(dev, tx_pwr_ctrl_state);
+		}
+
+		txpi->index = txpwrindex;
+	}
+
+	if (nphy->hang_avoid)
+		b43_nphy_stay_in_carrier_search(dev, false);
+}
+
+/* brcmsmac: wlc_phy_rxcal_physetup_nphy() */
+static void b43_nphy_rx_cal_phy_setup(struct b43_wldev *dev, u8 rx_core)
+{
+	struct b43_phy *phy = &dev->phy;
+	u16 *regs = phy->n->tx_rx_cal_phy_saveregs;
+	u16 afectl_core = (rx_core == 0) ? B43_NPHY_AFECTL_C1 :
+					   B43_NPHY_AFECTL_C2;
+	u16 afectl_over = (rx_core == 0) ? B43_NPHY_AFECTL_OVER1 :
+					   B43_NPHY_AFECTL_OVER;
+	u16 rx_antval, tx_antval;
+	u8 tx_core;
+
+	if (phy->rev >= 7)
+		tx_core = rx_core;
+	else
+		tx_core = (rx_core == 0) ? 1 : 0;
+
+	regs[0] = b43_phy_read(dev, B43_NPHY_RFSEQCA);
+	regs[1] = b43_phy_read(dev, afectl_core);
+	regs[2] = b43_phy_read(dev, afectl_over);
+	regs[3] = b43_phy_read(dev, B43_NPHY_RFCTL_INTC1);
+	regs[4] = b43_phy_read(dev, B43_NPHY_RFCTL_INTC2);
+	regs[5] = b43_phy_read(dev, B43_NPHY_RFCTL_RSSIO1);
+	regs[6] = b43_phy_read(dev, B43_NPHY_RFCTL_RSSIO2);
+	regs[7] = b43_phy_read(dev, B43_NPHY_REV3_RFCTL_OVER0);
+	regs[8] = b43_phy_read(dev, B43_NPHY_REV3_RFCTL_OVER1);
+	if (phy->rev >= 7) {
+		regs[11] = b43_phy_read(dev, B43_NPHY_REV7_RF_CTL_OVER3);
+		regs[12] = b43_phy_read(dev, B43_NPHY_REV7_RF_CTL_OVER4);
+		regs[13] = b43_phy_read(dev, B43_NPHY_REV7_RF_CTL_OVER5);
+		regs[14] = b43_phy_read(dev, B43_NPHY_REV7_RF_CTL_OVER6);
+	}
+
+	regs[9] = b43_phy_read(dev, B43_NPHY_PAPD_EN0);
+	regs[10] = b43_phy_read(dev, B43_NPHY_PAPD_EN1);
+	b43_phy_mask(dev, B43_NPHY_PAPD_EN0, ~0x0001);
+	b43_phy_mask(dev, B43_NPHY_PAPD_EN1, ~0x0001);
+
+	if (phy->rev >= 7) {
+		b43_phy_maskset(dev, B43_NPHY_RFSEQCA, ~B43_NPHY_RFSEQCA_TXEN,
+				(1 << tx_core) << B43_NPHY_RFSEQCA_TXEN_SHIFT);
+		b43_phy_maskset(dev, B43_NPHY_RFSEQCA,
+				~B43_NPHY_RFSEQCA_RXDIS & 0xFFFF,
+				(1 << (1 - rx_core)) <<
+				B43_NPHY_RFSEQCA_RXDIS_SHIFT);
+	} else {
+		b43_phy_maskset(dev, B43_NPHY_RFSEQCA,
+				~B43_NPHY_RFSEQCA_RXDIS & 0xFFFF,
+				(1 << tx_core) << B43_NPHY_RFSEQCA_RXDIS_SHIFT);
+		b43_phy_maskset(dev, B43_NPHY_RFSEQCA, ~B43_NPHY_RFSEQCA_TXEN,
+				(1 << tx_core) << B43_NPHY_RFSEQCA_TXEN_SHIFT);
+		b43_phy_maskset(dev, B43_NPHY_RFSEQCA, ~B43_NPHY_RFSEQCA_RXEN,
+				(1 << rx_core) << B43_NPHY_RFSEQCA_RXEN_SHIFT);
+		b43_phy_maskset(dev, B43_NPHY_RFSEQCA, ~B43_NPHY_RFSEQCA_TXDIS,
+				(1 << rx_core) << B43_NPHY_RFSEQCA_TXDIS_SHIFT);
+	}
+
+	b43_phy_mask(dev, afectl_core, ~0x0004);
+	b43_phy_set(dev, afectl_over, 0x0004);
+	if (phy->rev < 7) {
+		b43_phy_mask(dev, afectl_core, ~0x0003);
+		b43_phy_set(dev, afectl_over, 0x0003);
+	}
+
+	b43_nphy_rf_ctl_intc_override(dev, N_INTC_OVERRIDE_PA, 0, 3);
+
+	if (phy->rev >= 7) {
+		b43_nphy_rf_ctl_override_rev7(dev, 0x0008, 0, 0, false, 0);
+		b43_nphy_rf_ctl_override_rev7(dev, 0x0200, 0, 0, false, 1);
+		b43_nphy_rf_ctl_override_rev7(dev, 0x0400, 1, 0, false, 1);
+		b43_nphy_rf_ctl_override_rev7(dev, 0x0001, 1, 0, false, 1);
+		b43_nphy_rf_ctl_override_rev7(dev, 0x0002, 1, 0, false, 2);
+		b43_nphy_rf_ctl_override_rev7(dev, 0x0800, 0, 0, false, 1);
+		if (b43_is_40mhz(dev))
+			b43_nphy_rf_ctl_override_rev7(dev, 0x0080, 2, 0, false,
+						      1);
+		else
+			b43_nphy_rf_ctl_override_rev7(dev, 0x0080, 0, 0, false,
+						      1);
+		/* brcmsmac overrides the LPF bandwidth again, with 0 */
+		b43_nphy_rf_ctl_override_rev7(dev, 0x0080, 0, 0, false, 1);
+		b43_nphy_rf_ctl_override_rev7(dev, 0x0020, 0, 0, false, 1);
+	} else {
+		b43_nphy_rf_ctl_override(dev, 0x0008, 0, 3, false);
+	}
+
+	b43_nphy_force_rf_sequence(dev, B43_RFSEQ_RX2TX);
+
+	if (phy->rev >= 7) {
+		b43_nphy_rf_ctl_intc_override(dev, N_INTC_OVERRIDE_TRSW, 0x1,
+					      rx_core + 1);
+	} else {
+		if (rx_core == 0) {
+			rx_antval = 0x1;
+			tx_antval = 0x8;
+		} else {
+			rx_antval = 0x4;
+			tx_antval = 0x2;
+		}
+		b43_nphy_rf_ctl_intc_override(dev, N_INTC_OVERRIDE_TRSW,
+					      rx_antval, rx_core + 1);
+		b43_nphy_rf_ctl_intc_override(dev, N_INTC_OVERRIDE_TRSW,
+					      tx_antval, tx_core + 1);
+	}
+}
+
+/* brcmsmac: wlc_phy_rxcal_phycleanup_nphy() */
+static void b43_nphy_rx_cal_phy_cleanup(struct b43_wldev *dev, u8 rx_core)
+{
+	u16 *regs = dev->phy.n->tx_rx_cal_phy_saveregs;
+
+	b43_phy_write(dev, B43_NPHY_RFSEQCA, regs[0]);
+	b43_phy_write(dev, (rx_core == 0) ? B43_NPHY_AFECTL_C1 :
+					    B43_NPHY_AFECTL_C2, regs[1]);
+	b43_phy_write(dev, (rx_core == 0) ? B43_NPHY_AFECTL_OVER1 :
+					    B43_NPHY_AFECTL_OVER, regs[2]);
+	b43_phy_write(dev, B43_NPHY_RFCTL_INTC1, regs[3]);
+	b43_phy_write(dev, B43_NPHY_RFCTL_INTC2, regs[4]);
+
+	b43_phy_write(dev, B43_NPHY_RFCTL_RSSIO1, regs[5]);
+	b43_phy_write(dev, B43_NPHY_RFCTL_RSSIO2, regs[6]);
+	b43_phy_write(dev, B43_NPHY_REV3_RFCTL_OVER0, regs[7]);
+	b43_phy_write(dev, B43_NPHY_REV3_RFCTL_OVER1, regs[8]);
+	if (dev->phy.rev >= 7) {
+		b43_phy_write(dev, B43_NPHY_REV7_RF_CTL_OVER3, regs[11]);
+		b43_phy_write(dev, B43_NPHY_REV7_RF_CTL_OVER4, regs[12]);
+		b43_phy_write(dev, B43_NPHY_REV7_RF_CTL_OVER5, regs[13]);
+		b43_phy_write(dev, B43_NPHY_REV7_RF_CTL_OVER6, regs[14]);
+	}
+
+	b43_phy_write(dev, B43_NPHY_PAPD_EN0, regs[9]);
+	b43_phy_write(dev, B43_NPHY_PAPD_EN1, regs[10]);
+}
+
+/* brcmsmac: wlc_phy_rxcal_radio_setup_nphy() */
+static void b43_nphy_rx_cal_radio_setup(struct b43_wldev *dev, u8 rx_core)
+{
+	struct b43_phy *phy = &dev->phy;
+	u16 *save = phy->n->tx_rx_cal_radio_saveregs;
+	bool ghz5 = b43_current_band(dev->wl) == NL80211_BAND_5GHZ;
+	u16 tx, rx, pwrup, atten, lna_reg, offtune_val;
+	u16 bias_g = 0, bias_a = 0;
+
+	if (phy->rev >= 7) {
+		if (rx_core == 0) {
+			pwrup = ghz5 ? R2057_TX0_TXRXCOUPLE_5G_PWRUP :
+				       R2057_TX0_TXRXCOUPLE_2G_PWRUP;
+			atten = ghz5 ? R2057_TX0_TXRXCOUPLE_5G_ATTEN :
+				       R2057_TX0_TXRXCOUPLE_2G_ATTEN;
+		} else {
+			pwrup = ghz5 ? R2057_TX1_TXRXCOUPLE_5G_PWRUP :
+				       R2057_TX1_TXRXCOUPLE_2G_PWRUP;
+			atten = ghz5 ? R2057_TX1_TXRXCOUPLE_5G_ATTEN :
+				       R2057_TX1_TXRXCOUPLE_2G_ATTEN;
+		}
+		save[0] = b43_radio_read(dev, pwrup);
+		save[1] = b43_radio_read(dev, atten);
+		b43_radio_write(dev, pwrup, 0x3);
+		b43_radio_write(dev, atten, ghz5 ? 0xaf : 0x7f);
+		return;
+	}
+
+	/* Radio 2056: loop back from the TX of the other core */
+	tx = (rx_core == 0) ? B2056_TX1 : B2056_TX0;
+	rx = (rx_core == 0) ? B2056_RX0 : B2056_RX1;
+
+	save[0] = b43_radio_read(dev, B2056_TX_RXIQCAL_TXMUX | tx);
+	save[1] = b43_radio_read(dev, B2056_RX_RXIQCAL_RXMUX | rx);
+
+	if (phy->radio_rev >= 5) {
+		save[2] = b43_radio_read(dev, B2056_RX_RXSPARE2 | rx);
+		save[3] = b43_radio_read(dev, B2056_TX_TXSPARE2 | tx);
+	}
+
+	if (phy->radio_rev >= 5) {
+		lna_reg = (ghz5 ? B2056_RX_LNAA_MASTER :
+				  B2056_RX_LNAG_MASTER) | rx;
+		save[4] = b43_radio_read(dev, lna_reg);
+		b43_radio_write(dev, lna_reg, 0x40);
+		b43_radio_write(dev, B2056_TX_TXSPARE2 | tx,
+				ghz5 ? bias_a : bias_g);
+		b43_radio_write(dev, B2056_RX_RXSPARE2 | rx,
+				ghz5 ? bias_a : bias_g);
+	} else {
+		lna_reg = (ghz5 ? B2056_RX_LNAA_TUNE :
+				  B2056_RX_LNAG_TUNE) | rx;
+		save[4] = b43_radio_read(dev, lna_reg);
+
+		/*
+		 * As in brcmsmac: save[2] is only read on radio rev 5+, and
+		 * (x & 0xF0) >> 8 is always 0, so offtune_val is 0xF and its
+		 * shifted value falls outside the 0xF0 mask: this only clears
+		 * bits 4-7.
+		 */
+		offtune_val = (save[2] & 0xF0) >> 8;
+		offtune_val = (offtune_val <= 0x7) ? 0xF : 0;
+		b43_radio_maskset(dev, lna_reg, ~0xF0,
+				  (offtune_val << 8) & 0xF0);
+	}
+
+	b43_radio_write(dev, B2056_TX_RXIQCAL_TXMUX | tx, ghz5 ? 0x9 : 0x6);
+	b43_radio_write(dev, B2056_RX_RXIQCAL_RXMUX | rx, ghz5 ? 0x9 : 0x6);
+}
+
+/* brcmsmac: wlc_phy_rxcal_radio_cleanup_nphy() */
+static void b43_nphy_rx_cal_radio_cleanup(struct b43_wldev *dev, u8 rx_core)
+{
+	struct b43_phy *phy = &dev->phy;
+	u16 *save = phy->n->tx_rx_cal_radio_saveregs;
+	bool ghz5 = b43_current_band(dev->wl) == NL80211_BAND_5GHZ;
+	u16 tx, rx;
+
+	if (phy->rev >= 7) {
+		if (rx_core == 0) {
+			b43_radio_write(dev,
+					ghz5 ? R2057_TX0_TXRXCOUPLE_5G_PWRUP :
+					       R2057_TX0_TXRXCOUPLE_2G_PWRUP,
+					save[0]);
+			b43_radio_write(dev,
+					ghz5 ? R2057_TX0_TXRXCOUPLE_5G_ATTEN :
+					       R2057_TX0_TXRXCOUPLE_2G_ATTEN,
+					save[1]);
+		} else {
+			b43_radio_write(dev,
+					ghz5 ? R2057_TX1_TXRXCOUPLE_5G_PWRUP :
+					       R2057_TX1_TXRXCOUPLE_2G_PWRUP,
+					save[0]);
+			b43_radio_write(dev,
+					ghz5 ? R2057_TX1_TXRXCOUPLE_5G_ATTEN :
+					       R2057_TX1_TXRXCOUPLE_2G_ATTEN,
+					save[1]);
+		}
+		return;
+	}
+
+	tx = (rx_core == 0) ? B2056_TX1 : B2056_TX0;
+	rx = (rx_core == 0) ? B2056_RX0 : B2056_RX1;
+
+	b43_radio_write(dev, B2056_TX_RXIQCAL_TXMUX | tx, save[0]);
+	b43_radio_write(dev, B2056_RX_RXIQCAL_RXMUX | rx, save[1]);
+
+	if (phy->radio_rev >= 5) {
+		b43_radio_write(dev, B2056_RX_RXSPARE2 | rx, save[2]);
+		b43_radio_write(dev, B2056_TX_TXSPARE2 | tx, save[3]);
+	}
+
+	if (ghz5) {
+		if (phy->radio_rev >= 5)
+			b43_radio_write(dev, B2056_RX_LNAA_MASTER | rx,
+					save[4]);
+		else
+			b43_radio_write(dev, B2056_RX_LNAA_TUNE | rx, save[4]);
+	} else {
+		if (phy->radio_rev >= 5)
+			b43_radio_write(dev, B2056_RX_LNAG_MASTER | rx,
+					save[4]);
+		else
+			b43_radio_write(dev, B2056_RX_LNAG_TUNE | rx, save[4]);
+	}
+}
+
+/*
+ * Set the RX gain for the loopback tone of the RX I/Q calibration.
+ * brcmsmac: wlc_phy_rxcal_gainctrl_nphy_rev5(), whose rxgain output is
+ * never asked for and is left out.
+ */
+static void b43_nphy_rx_cal_gain_ctl(struct b43_wldev *dev, u8 rx_core,
+				     u8 cal_type)
+{
+	struct b43_phy *phy = &dev->phy;
+	struct b43_phy_n *nphy = phy->n;
+	const struct b43_nphy_rxcal_gain *tbl;
+	struct b43_phy_n_iq_comp save_comp, zero_comp = { };
+	struct nphy_iq_est est;
+	enum b43_nphy_rxcal_gain_dirn dirn = B43_NPHY_RXCAL_GAIN_INIT;
+	u32 i_pwr, q_pwr, curr_pwr, optim_pwr = 0, prev_pwr = 0;
+	u32 thresh_pwr = 10000;
+	s16 desired_log2_pwr = 13, actual_log2_pwr, delta_pwr;
+	s8 optim_index = 0, prev_index = 0, curr_index = 3;
+	u16 hpvga, lpf_biq1, lpf_biq0, lna2, lna1, rxgain, rxcal_txgain[2];
+	u16 num_samps = 1024;
+	u8 mix_tia_gain = 3;
+	bool done = false;
+	int fine_gain_idx;
+	s8 txpwrindex;
+	u8 tx_core;
+
+	if (phy->rev >= 7)
+		tx_core = rx_core;
+	else
+		tx_core = 1 - rx_core;
+
+	b43_nphy_rx_iq_coeffs(dev, false, &save_comp);
+	b43_nphy_rx_iq_coeffs(dev, true, &zero_comp);
+
+	if (b43_current_band(dev->wl) == NL80211_BAND_5GHZ) {
+		if (phy->rev >= 7)
+			mix_tia_gain = 3;
+		else if (phy->rev >= 4)
+			mix_tia_gain = 4;
+		else
+			mix_tia_gain = 6;
+		if (phy->rev >= 7)
+			tbl = b43_nphy_rxcal_gain_5ghz_rev7;
+		else
+			tbl = b43_nphy_rxcal_gain_5ghz;
+	} else {
+		if (phy->rev >= 7)
+			tbl = b43_nphy_rxcal_gain_2ghz_rev7;
+		else
+			tbl = b43_nphy_rxcal_gain_2ghz;
+	}
+
+	do {
+		hpvga = (phy->rev >= 7) ? 0 : tbl[curr_index].hpvga;
+		lpf_biq1 = tbl[curr_index].lpf_biq1;
+		lpf_biq0 = tbl[curr_index].lpf_biq0;
+		lna2 = tbl[curr_index].lna2;
+		lna1 = tbl[curr_index].lna1;
+		txpwrindex = tbl[curr_index].txpwrindex;
+
+		if (phy->rev >= 7) {
+			rxgain = (lpf_biq1 << 12) | (lpf_biq0 << 8) |
+				 (mix_tia_gain << 4) | (lna2 << 2) | lna1;
+			b43_nphy_rf_ctl_override_one_to_many(dev,
+							     N_RF_CTL_OVER_CMD_RX_GAIN,
+							     rxgain, 0x3, false);
+		} else {
+			rxgain = (hpvga << 12) | (lpf_biq1 << 10) |
+				 (lpf_biq0 << 8) | (mix_tia_gain << 4) |
+				 (lna2 << 2) | lna1;
+			b43_nphy_rf_ctl_override(dev, 0x1000, rxgain, 0x3,
+						 false);
+		}
+
+		/* brcmsmac's nphy_rxcal_pwr_idx[] is never read: skipped */
+
+		if (txpwrindex == -1) {
+			rxcal_txgain[0] = 0x8ff0 | nphy->gmval;
+			rxcal_txgain[1] = 0x8ff0 | nphy->gmval;
+			b43_ntab_write_bulk(dev, B43_NTAB16(7, 0x110), 2,
+					    rxcal_txgain);
+		} else {
+			b43_nphy_tx_pwr_index(dev, tx_core + 1, txpwrindex,
+					      false);
+		}
+
+		b43_nphy_tx_tone(dev, b43_is_40mhz(dev) ?
+				 B43_NPHY_RXCAL_TONEFREQ_40MHZ :
+				 B43_NPHY_RXCAL_TONEFREQ_20MHZ,
+				 B43_NPHY_RXCAL_TONEAMP, false, cal_type == 1,
+				 false);
+
+		b43_nphy_rx_iq_est(dev, &est, num_samps, 32, false);
+		i_pwr = DIV_ROUND_CLOSEST(rx_core ? est.i1_pwr : est.i0_pwr,
+					  num_samps);
+		q_pwr = DIV_ROUND_CLOSEST(rx_core ? est.q1_pwr : est.q0_pwr,
+					  num_samps);
+		curr_pwr = i_pwr + q_pwr;
+
+		switch (dirn) {
+		case B43_NPHY_RXCAL_GAIN_INIT:
+			if (curr_pwr > thresh_pwr) {
+				dirn = B43_NPHY_RXCAL_GAIN_DOWN;
+				prev_index = curr_index;
+				curr_index--;
+			} else {
