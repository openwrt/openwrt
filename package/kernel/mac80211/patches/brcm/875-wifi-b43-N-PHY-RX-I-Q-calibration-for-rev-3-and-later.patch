+				optim_index = prev_index;
+			} else {
+				prev_index = curr_index;
+				curr_index++;
+			}
+			break;
+		case B43_NPHY_RXCAL_GAIN_DOWN:
+			if (curr_pwr > thresh_pwr) {
+				prev_index = curr_index;
+				curr_index--;
+			} else {
+				done = true;
+				optim_pwr = curr_pwr;
+				optim_index = curr_index;
+			}
+			break;
+		}
+
+		if (curr_index < 0 ||
+		    curr_index > B43_NPHY_RXCAL_MAXGAININDEX) {
+			done = true;
