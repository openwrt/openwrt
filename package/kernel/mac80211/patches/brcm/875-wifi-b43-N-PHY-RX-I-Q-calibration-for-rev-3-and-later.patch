+/*
+ * Find the RC calibration value of the RX LPF of radio 2056, measuring the
+ * filter response to two tones. brcmsmac: wlc_phy_rc_sweep_nphy()
+ */
+static u8 b43_nphy_rc_sweep(struct b43_wldev *dev, u8 core_idx,
+			    u8 loopback_type)
+{
+	static const u16 rxstrnfilt40[] = {
+		B43_NPHY_RXSTRNFILT40NUM00, B43_NPHY_RXSTRNFILT40NUM01,
+		B43_NPHY_RXSTRNFILT40NUM02, B43_NPHY_RXSTRNFILT40DEN00,
+		B43_NPHY_RXSTRNFILT40DEN01, B43_NPHY_RXSTRNFILT40NUM10,
+		B43_NPHY_RXSTRNFILT40NUM11, B43_NPHY_RXSTRNFILT40NUM12,
+		B43_NPHY_RXSTRNFILT40DEN10, B43_NPHY_RXSTRNFILT40DEN11,
+	};
+	static const u16 rxstrnfilt40_val[] = {
+		0x02d4, 0x0000, 0x0000, 0x0000, 0x0000,
+		0x02d4, 0x0000, 0x0000, 0x0000, 0x0000,
+	};
+	u32 target_bw, ref_tone, target_pwr_ratio;
+	u32 pwr_ratio, last_pwr_ratio = 0;
+	u16 start_rccal_ovr_val = 128;
+	u16 txlpf_rccal_lpc_ovr_val = 128;
+	u16 rxlpf_rccal_hpc_ovr_val = 159;
+	u16 orig_txlpf_rccal_lpc, orig_rxlpf_rccal_hpc;
+	u16 rx, tx, orig_dc_bypass;
+	u16 orig_rxstrnfilt40[ARRAY_SIZE(rxstrnfilt40)];
+	u16 orig_rfctl_over[2], orig_rfctl_aux[2], orig_rssio;
+	u16 rfctl_over_this, rfctl_over_other, rfctl_aux_this, rfctl_aux_other;
+	u16 rssio;
+	u16 tx_lpf_bw = 4, rx_lpf_bw, lpf_hpc = 7, hpvga_hpc = 7;
+	s8 rccal_stepsize;
+	u16 rccal_val, last_rccal_val = 0, best_rccal_val = 0;
+	u32 ref_iq_vals = 0, target_iq_vals = 0;
+	u16 log_num_samps = 10, num_samps;
+	struct nphy_iq_est est;
+	int i;
+
+	if (dev->phy.rev >= 7)
+		return 0;
+
+	num_samps = 1 << log_num_samps;
+
+	if (b43_is_40mhz(dev)) {
+		target_bw = 21000;
+		target_pwr_ratio = 18468;
+		ref_tone = 6000;
+		rx_lpf_bw = 4;
+	} else {
+		target_bw = 9500;
+		target_pwr_ratio = 28606;
+		ref_tone = 3000;
+		rx_lpf_bw = 2;
+	}
+
+	if (core_idx == 0) {
+		rx = B2056_RX0;
+		tx = (loopback_type == 0) ? B2056_TX0 : B2056_TX1;
+	} else {
+		rx = B2056_RX1;
+		tx = (loopback_type == 0) ? B2056_TX1 : B2056_TX0;
+	}
+	rfctl_over_this = core_idx == 0 ? B43_NPHY_REV3_RFCTL_OVER0 :
+					  B43_NPHY_REV3_RFCTL_OVER1;
+	rfctl_over_other = core_idx == 0 ? B43_NPHY_REV3_RFCTL_OVER1 :
+					   B43_NPHY_REV3_RFCTL_OVER0;
+	rfctl_aux_this = core_idx == 0 ? B43_NPHY_RFCTL_LUT_TRSW_LO1 :
+					 B43_NPHY_RFCTL_LUT_TRSW_LO2;
+	rfctl_aux_other = core_idx == 0 ? B43_NPHY_RFCTL_LUT_TRSW_LO2 :
+					  B43_NPHY_RFCTL_LUT_TRSW_LO1;
+	rssio = core_idx == 0 ? B43_NPHY_RFCTL_RSSIO1 : B43_NPHY_RFCTL_RSSIO2;
+
+	orig_txlpf_rccal_lpc = b43_radio_read(dev, B2056_TX_TXLPF_RCCAL | tx);
+	orig_rxlpf_rccal_hpc = b43_radio_read(dev,
+					      B2056_RX_RXLPF_RCCAL_HPC | rx);
+
+	/* DC filter bypass */
+	orig_dc_bypass = (b43_phy_read(dev, B43_NPHY_DCFADDR) >> 8) & 1;
+
+	for (i = 0; i < ARRAY_SIZE(rxstrnfilt40); i++)
+		orig_rxstrnfilt40[i] = b43_phy_read(dev, rxstrnfilt40[i]);
+
+	orig_rfctl_over[0] = b43_phy_read(dev, B43_NPHY_REV3_RFCTL_OVER0);
+	orig_rfctl_over[1] = b43_phy_read(dev, B43_NPHY_REV3_RFCTL_OVER1);
+	orig_rfctl_aux[0] = b43_phy_read(dev, B43_NPHY_RFCTL_LUT_TRSW_LO1);
+	orig_rfctl_aux[1] = b43_phy_read(dev, B43_NPHY_RFCTL_LUT_TRSW_LO2);
+	orig_rssio = b43_phy_read(dev, rssio);
+
+	b43_radio_write(dev, B2056_TX_TXLPF_RCCAL | tx,
+			txlpf_rccal_lpc_ovr_val);
+	b43_radio_write(dev, B2056_RX_RXLPF_RCCAL_HPC | rx,
+			rxlpf_rccal_hpc_ovr_val);
+
+	b43_phy_set(dev, B43_NPHY_DCFADDR, 0x0100);
+
+	for (i = 0; i < ARRAY_SIZE(rxstrnfilt40); i++)
+		b43_phy_write(dev, rxstrnfilt40[i], rxstrnfilt40_val[i]);
+
+	b43_phy_set(dev, rfctl_over_this, 0x0100);
+	b43_phy_set(dev, rfctl_over_other, 0x8000);
+	b43_phy_set(dev, rfctl_over_this, 0x0200);
+	b43_phy_set(dev, rfctl_over_this, 0x0400);
+
+	b43_phy_maskset(dev, rfctl_aux_other, ~(0x7 << 10), tx_lpf_bw << 10);
+	b43_phy_maskset(dev, rfctl_aux_this, ~0x7, hpvga_hpc);
+	b43_phy_maskset(dev, rfctl_aux_this, ~(0x7 << 4), lpf_hpc << 4);
+	b43_phy_maskset(dev, rssio, ~(0x7 << 8), rx_lpf_bw << 8);
+
+	rccal_stepsize = 16;
+	rccal_val = start_rccal_ovr_val + rccal_stepsize;
+
+	while (rccal_stepsize >= 0) {
+		b43_radio_write(dev, B2056_RX_RXLPF_RCCAL_LPC | rx, rccal_val);
+
+		if (rccal_stepsize == 16) {
+			b43_nphy_tx_tone(dev, ref_tone, B43_NPHY_RXCAL_TONEAMP,
+					 false, true, false);
+			udelay(2);
+
+			b43_nphy_rx_iq_est(dev, &est, num_samps, 32, false);
+
+			if (core_idx == 0)
+				ref_iq_vals = max_t(u32, (est.i0_pwr +
+							  est.q0_pwr) >>
+						    (log_num_samps + 1), 1);
+			else
+				ref_iq_vals = max_t(u32, (est.i1_pwr +
+							  est.q1_pwr) >>
+						    (log_num_samps + 1), 1);
+
+			b43_nphy_tx_tone(dev, target_bw,
+					 B43_NPHY_RXCAL_TONEAMP, false, true,
+					 false);
+			udelay(2);
+		}
+
+		b43_nphy_rx_iq_est(dev, &est, num_samps, 32, false);
+
+		if (core_idx == 0)
+			target_iq_vals = (est.i0_pwr + est.q0_pwr) >>
+					 (log_num_samps + 1);
+		else
+			target_iq_vals = (est.i1_pwr + est.q1_pwr) >>
+					 (log_num_samps + 1);
+
+		pwr_ratio = (target_iq_vals << 16) / ref_iq_vals;
+
+		if (rccal_stepsize == 0) {
+			rccal_stepsize--;
+		} else if (rccal_stepsize == 1) {
+			last_rccal_val = rccal_val;
+			rccal_val += (pwr_ratio > target_pwr_ratio) ? 1 : -1;
+			last_pwr_ratio = pwr_ratio;
+			rccal_stepsize--;
+		} else {
+			rccal_stepsize = (rccal_stepsize >> 1);
+			rccal_val += ((pwr_ratio > target_pwr_ratio) ?
+				      rccal_stepsize : (-rccal_stepsize));
+		}
+
+		if (rccal_stepsize == -1) {
+			best_rccal_val =
+				(abs((int)last_pwr_ratio -
+				     (int)target_pwr_ratio) <
+				 abs((int)pwr_ratio -
+				     (int)target_pwr_ratio)) ? last_rccal_val :
+				rccal_val;
+
+			if (b43_is_40mhz(dev)) {
+				if (best_rccal_val > 140 ||
+				    best_rccal_val < 135)
+					best_rccal_val = 138;
+			} else {
+				if (best_rccal_val > 142 ||
+				    best_rccal_val < 137)
+					best_rccal_val = 140;
+			}
+
+			b43_radio_write(dev, B2056_RX_RXLPF_RCCAL_LPC | rx,
+					best_rccal_val);
+		}
+	}
+
+	b43_nphy_stop_playback(dev);
+
+	b43_radio_write(dev, B2056_TX_TXLPF_RCCAL | tx, orig_txlpf_rccal_lpc);
+	b43_radio_write(dev, B2056_RX_RXLPF_RCCAL_HPC | rx,
+			orig_rxlpf_rccal_hpc);
+
+	b43_phy_maskset(dev, B43_NPHY_DCFADDR, ~0x0100, orig_dc_bypass << 8);
+
+	for (i = 0; i < ARRAY_SIZE(rxstrnfilt40); i++)
+		b43_phy_write(dev, rxstrnfilt40[i], orig_rxstrnfilt40[i]);
+
+	b43_phy_write(dev, B43_NPHY_REV3_RFCTL_OVER0, orig_rfctl_over[0]);
+	b43_phy_write(dev, B43_NPHY_REV3_RFCTL_OVER1, orig_rfctl_over[1]);
+	b43_phy_write(dev, B43_NPHY_RFCTL_LUT_TRSW_LO1, orig_rfctl_aux[0]);
+	b43_phy_write(dev, B43_NPHY_RFCTL_LUT_TRSW_LO2, orig_rfctl_aux[1]);
+	b43_phy_write(dev, rssio, orig_rssio);
+
+	/*
+	 * brcmsmac clears nphy_anarxlpf_adjusted here; that flag and the
+	 * value stored below (nphy_rccal_value) only feed its analog RX LPF
+	 * adjustment for channel 11 at 40 MHz, which b43 does not have.
+	 */
+
+	return best_rccal_val - 0x80;
+}
