From adb947547136096c91f037dd392cd8af3aa98451 Mon Sep 17 00:00:00 2001
From: Phil Elwell <phil@raspberrypi.com>
Date: Thu, 19 Nov 2026 13:25:35 +0000
Subject: [PATCH] wifi: brcmfmac: Keep a secondary AP on the STA's channel

When a soft AP runs on a virtual interface alongside an associated STA,
firmware with multi-channel support will run the two on different
channels, time-sharing the radio. On the SYN43436P this almost
completely breaks traffic forwarded between the interfaces (e.g. a
NetworkManager "shared" hotspot), because frames queued for whichever
interface is off-channel are dropped.

While such an AP is running, set the "mchan_stago_disab" iovar, which
disables multi-channel operation for STA + GO/AP concurrency. The
firmware then keeps the AP on the STA's channel: it starts there
regardless of the channel requested, and follows the STA when it
roams. Clear it again when the AP stops (or fails to start) so that
other concurrency is unaffected. Firmware without the iovar just
ignores the request.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Phil Elwell <phil@raspberrypi.com>
---
 .../broadcom/brcm80211/brcmfmac/cfg80211.c    | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -5234,6 +5234,21 @@ static s32 brcmf_bss_disable(struct brcm
 	return err;
 }
 
+/*
+ * Stop the firmware from time-sharing the radio between an AP and another
+ * interface on different channels, so that the AP follows the channel of an
+ * associated STA. Not all firmware supports this, hence the lack of fuss.
+ */
+static void brcmf_set_mchan_stago_disab(struct brcmf_if *ifp, bool disab)
+{
+	s32 err;
+
+	err = brcmf_fil_iovar_int_set(ifp, "mchan_stago_disab", disab);
+	if (err)
+		brcmf_dbg(INFO, "mchan_stago_disab %d failed: %d\n", disab,
+			  err);
+}
+
 static s32
 brcmf_cfg80211_start_ap(struct wiphy *wiphy, struct net_device *ndev,
 			struct cfg80211_ap_settings *settings)
@@ -5358,6 +5373,9 @@ brcmf_cfg80211_start_ap(struct wiphy *wi
 		if ((brcmf_feat_is_enabled(ifp, BRCMF_FEAT_MBSS)) && (!mbss))
 			brcmf_fil_iovar_int_set(ifp, "mbss", 1);
 
+		if (!brcmf_ap_owns_radio(ifp))
+			brcmf_set_mchan_stago_disab(ifp, true);
+
 		err = brcmf_fil_cmd_int_set(ifp, BRCMF_C_SET_AP, 1);
 		if (err < 0) {
 			bphy_err(drvr, "setting AP mode failed %d\n",
@@ -5477,6 +5495,8 @@ exit:
 		brcmf_set_mpc(ifp, 1);
 		brcmf_configure_arp_nd_offload(ifp, true);
 	}
+	if (err && dev_role == NL80211_IFTYPE_AP && !brcmf_ap_owns_radio(ifp))
+		brcmf_set_mchan_stago_disab(ifp, false);
 	return err;
 }
 
@@ -5541,6 +5561,7 @@ static int brcmf_cfg80211_stop_ap(struct
 		} else {
 			/* Leave the radio, and other interfaces, running */
 			err = brcmf_bss_disable(ifp);
+			brcmf_set_mchan_stago_disab(ifp, false);
 		}
 
 		brcmf_vif_clear_mgmt_ies(ifp->vif);
