+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	unsigned int len = skb->len + FCS_LEN;
+
+	if (info->control.hw_key)
+		len += info->control.hw_key->icv_len;
+
+	return len;
