+	plcp->raw[1] = len & 0xff;
+	plcp->raw[2] = (len >> 8) & 0xff;
+	txhdr->mimo_modelen =
+		cpu_to_le16(b43_ht_lsig_len(plcp->raw[0], plcp->raw[3] & 0x80,
+					    len));
+	txhdr->mimo_ratelen_fb =
+		cpu_to_le16(b43_ht_lsig_len(plcp_fb->raw[0],
+					    plcp_fb->raw[3] & 0x80, len));
