From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ville Takio <ville+git@takio.fi>
Subject: [PATCH] b43: AC-PHY: pull frames from the mac80211 TX queues

b43 pushed every frame mac80211 had into its own wl->tx_queue through
ieee80211_handle_wake_tx_queue() and b43_op_tx(), so whatever did not
fit the DMA ring waited there, out of reach of mac80211's fair queueing
and A-MSDU aggregation.

On the AC cores with DMA, pull instead, as mt76 and ath9k do: the
wake_tx_queue op schedules the TX work, which takes frames with
ieee80211_next_txq()/ieee80211_tx_dequeue() (bottom halves off) only
while the ring of the access category has room. Frames from b43_op_tx()
and the beacons of further BSSes still go first. The other cores keep
the old path.

With that, announce fast transmit, on which mac80211 builds A-MSDUs, and
TX A-MSDUs of full-size MSDUs (1000 bytes and more): aggregating the TCP
ACKs we send as well cost a OnePlus Nord 2 two rooms away a third of its
uplink.

Tested on the RT-AC66U B1, 5 GHz ch36/80, alternating in place:
- pulling against pushing: 196/177/169 against 193/189/158 Mbit/s down;
- A-MSDUs (two subframes, ~2200 bytes per MPDU against ~1200) of large
  MSDUs only: 125 Mbit/s up, 172 down; of all MSDUs 85/170; none
  121/173;
- an rtl8821ae client (1x1, no A-MSDU in A-MPDU): 123 up, 168 down.
---
--- a/drivers/net/wireless/broadcom/b43/dma.c
+++ b/drivers/net/wireless/broadcom/b43/dma.c
@@ -1425,6 +1425,14 @@ static struct b43_dmaring *select_ring_b
 	return ring;
 }
 
+/* Whether the ring of @queue_prio takes another frame now. */
+bool b43_dma_tx_room(struct b43_wldev *dev, u8 queue_prio)
+{
+	struct b43_dmaring *ring = select_ring_by_priority(dev, queue_prio);
+
+	return !ring->stopped && free_slots(ring) >= TX_SLOTS_PER_FRAME;
+}
+
 int b43_dma_tx(struct b43_wldev *dev, struct sk_buff *skb)
 {
 	struct b43_dmaring *ring;
--- a/drivers/net/wireless/broadcom/b43/dma.h
+++ b/drivers/net/wireless/broadcom/b43/dma.h
@@ -315,6 +315,7 @@ void b43_dma_tx_resume(struct b43_wldev
 
 int b43_dma_tx(struct b43_wldev *dev,
 	       struct sk_buff *skb);
+bool b43_dma_tx_room(struct b43_wldev *dev, u8 queue_prio);
 void b43_dma_handle_txstatus(struct b43_wldev *dev,
 			     const struct b43_txstatus *status);
 
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -4923,6 +4923,8 @@ static int b43_rng_init(struct b43_wl *w
 	return err;
 }
 
+static void b43_tx_pull(struct b43_wldev *dev);
+
 static void b43_tx_work(struct work_struct *work)
 {
 	struct b43_wl *wl = container_of(work, struct b43_wl, tx_work);
@@ -4959,6 +4961,7 @@ static void b43_tx_work(struct work_stru
 		if (!err)
 			wl->tx_queue_stopped[queue_num] = false;
 	}
+	b43_tx_pull(dev);
 
 #if B43_DEBUG
 	dev->tx_count++;
@@ -5031,6 +5034,89 @@ static void b43_op_tx(struct ieee80211_h
 		b43_stop_queue(wl->current_dev, skb_queue_mapping);
 }
 
+/*
+ * The AC cores with DMA pull their frames from the mac80211 TX queues, and
+ * only while the ring of the access category has room: what does not fit
+ * waits in mac80211, which builds A-MSDUs and keeps its fair queueing
+ * there, instead of in wl->tx_queue. The other cores keep
+ * ieee80211_handle_wake_tx_queue(), which pushes every frame to
+ * b43_op_tx().
+ */
+/*
+ * Only full-size MSDUs go into an A-MSDU: with a OnePlus Nord 2 two rooms
+ * away, aggregating everything took its uplink from 121 to 85 Mbit/s (the
+ * TCP ACKs we send it wait for a partner), aggregating MSDUs of 1000
+ * bytes and more kept it (125) and its downlink (172 against 173).
+ */
+static bool b43_op_can_aggregate_in_amsdu(struct ieee80211_hw *hw,
+					  struct sk_buff *head,
+					  struct sk_buff *skb)
+{
+	return skb->len >= 1000;
+}
+
+static bool b43_tx_pulls(struct b43_wldev *dev)
+{
+	return dev && dev->phy.type == B43_PHYTYPE_AC &&
+	       !b43_using_pio_transfers(dev);
+}
+
+static void b43_tx_pull(struct b43_wldev *dev)
+{
+	struct b43_wl *wl = dev->wl;
+	struct ieee80211_hw *hw = wl->hw;
+	struct ieee80211_txq *txq;
+	struct sk_buff *skb;
+	int ac, err;
+
+	if (!b43_tx_pulls(dev))
+		return;
+
+	/* ieee80211_tx_dequeue() wants the bottom halves off. */
+	local_bh_disable();
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
+		if (wl->tx_queue_stopped[ac] || skb_queue_len(&wl->tx_queue[ac]))
+			continue;
+		ieee80211_txq_schedule_start(hw, ac);
+		while (b43_dma_tx_room(dev, ac) &&
+		       (txq = ieee80211_next_txq(hw, ac))) {
+			while (b43_dma_tx_room(dev, ac) &&
+			       (skb = ieee80211_tx_dequeue(hw, txq))) {
+				if (unlikely(skb->len < 2 + 2 + 6 ||
+					     !b43_tx_rates_ok(hw,
+						IEEE80211_SKB_CB(skb)))) {
+					ieee80211_free_txskb(hw, skb);
+					continue;
+				}
+				err = b43_dma_tx(dev, skb);
+				if (err == -ENOSPC) {
+					skb_queue_head(&wl->tx_queue[ac], skb);
+					wl->tx_queue_stopped[ac] = true;
+					break;
+				}
+				if (unlikely(err))
+					ieee80211_free_txskb(hw, skb);
+			}
+			ieee80211_return_txq(hw, txq, false);
+			if (wl->tx_queue_stopped[ac])
+				break;
+		}
+		ieee80211_txq_schedule_end(hw, ac);
+	}
+	local_bh_enable();
+}
+
+static void b43_op_wake_tx_queue(struct ieee80211_hw *hw,
+				 struct ieee80211_txq *txq)
+{
+	struct b43_wl *wl = hw_to_b43_wl(hw);
+
+	if (b43_tx_pulls(READ_ONCE(wl->current_dev)))
+		ieee80211_queue_work(hw, &wl->tx_work);
+	else
+		ieee80211_handle_wake_tx_queue(hw, txq);
+}
+
 static void b43_qos_params_upload(struct b43_wldev *dev,
 				  const struct ieee80211_tx_queue_params *p,
 				  u16 shm_offset)
@@ -7107,7 +7193,8 @@ static const struct ieee80211_ops b43_hw
 	.change_chanctx = ieee80211_emulate_change_chanctx,
 	.switch_vif_chanctx = ieee80211_emulate_switch_vif_chanctx,
 	.tx			= b43_op_tx,
-	.wake_tx_queue		= ieee80211_handle_wake_tx_queue,
+	.wake_tx_queue		= b43_op_wake_tx_queue,
+	.can_aggregate_in_amsdu	= b43_op_can_aggregate_in_amsdu,
 	.conf_tx		= b43_op_conf_tx,
 	.add_interface		= b43_op_add_interface,
 	.remove_interface	= b43_op_remove_interface,
@@ -7332,6 +7419,13 @@ static int b43_setup_bands(struct b43_wl
 		ieee80211_hw_set(hw, AMPDU_AGGREGATION);
 		/* A-MSDUs come in pieces, which b43_rx_amsdu() joins. */
 		ieee80211_hw_set(hw, SUPPORTS_AMSDU_IN_AMPDU);
+		/*
+		 * mac80211 builds A-MSDUs from what waits (b43_tx_pull()), on
+		 * its fast transmit path only, of frames that are worth it
+		 * (b43_op_can_aggregate_in_amsdu()).
+		 */
+		ieee80211_hw_set(hw, TX_AMSDU);
+		ieee80211_hw_set(hw, SUPPORT_FAST_XMIT);
 		hw->max_tx_aggregation_subframes = IEEE80211_MAX_AMPDU_BUF_HT;
 		hw->max_rx_aggregation_subframes = IEEE80211_MAX_AMPDU_BUF_HT;
 		if (have_5ghz_phy) {
