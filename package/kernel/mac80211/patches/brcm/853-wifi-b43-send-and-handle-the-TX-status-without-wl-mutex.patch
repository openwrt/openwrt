+/* TX power control register access before OFDM frames are sent */
+enum b43_nphy_txpctl_op {
+	B43_NPHY_TXPCTL_NONE,
+	B43_NPHY_TXPCTL_LOAD,
+	B43_NPHY_TXPCTL_UNLOAD,
+	B43_NPHY_TXPCTL_SAMPLE,
+};
