From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gleb Pesin <dormancygrace@gmail.com>
Date: Sat, 5 Sep 2026 16:18:35 +0000
Subject: [PATCH] wifi: mac80211: account extended TX retry histories

Extended TX status may describe more attempts than the four legacy rate
entries can hold. Use the complete reported attempt count for station
retry statistics and radiotap feedback, keeping the radiotap byte bounded.

Some drivers, including mt76, supply an extended rate only for rate
information and leave try_count zero. Keep the legacy retry count when
there are no extended attempts, and retain the existing AMPDU guard.

Signed-off-by: Gleb Pesin <dormancygrace@gmail.com>

--- a/net/mac80211/status.c
+++ b/net/mac80211/status.c
@@ -329,7 +329,7 @@ ieee80211_add_tx_radiotap_header(struct
 
 	/* IEEE80211_RADIOTAP_DATA_RETRIES */
 	/* for now report the total retry_count */
-	*pos = retry_count;
+	*pos = min_t(int, retry_count, U8_MAX);
 	pos++;
 
 	if (status_rate && (status_rate->rate_idx.flags & RATE_INFO_FLAGS_MCS))
@@ -1161,6 +1161,23 @@ void ieee80211_tx_status_skb(struct ieee
 }
 EXPORT_SYMBOL(ieee80211_tx_status_skb);
 
+static int ieee80211_tx_status_retry_count(struct ieee80211_tx_status *status,
+					   int legacy_count)
+{
+	struct ieee80211_tx_info *info = status->info;
+	int i, attempts = 0;
+
+	if (!status->rates || !status->n_rates ||
+	    ((info->flags & IEEE80211_TX_CTL_AMPDU) &&
+	     !(info->flags & IEEE80211_TX_STAT_AMPDU)))
+		return legacy_count;
+
+	for (i = 0; i < status->n_rates; i++)
+		attempts += status->rates[i].try_count;
+
+	return attempts ? attempts - 1 : legacy_count;
+}
+
 void ieee80211_tx_status_ext(struct ieee80211_hw *hw,
 			     struct ieee80211_tx_status *status)
 {
@@ -1198,6 +1215,8 @@ void ieee80211_tx_status_ext(struct ieee
 		goto free;
 
 	rates_idx = ieee80211_tx_get_rates(hw, info, &retry_count);
+	/* Extended histories need not fit the four legacy rate entries. */
+	retry_count = ieee80211_tx_status_retry_count(status, retry_count);
 
 	acked = !!(info->flags & IEEE80211_TX_STAT_ACK);
 	noack_success = !!(info->flags & IEEE80211_TX_STAT_NOACK_TRANSMITTED);
