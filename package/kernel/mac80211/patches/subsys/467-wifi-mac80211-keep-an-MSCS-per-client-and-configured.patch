+	/* The entries were keyed with this MSCS */
+	spin_lock_bh(&mscs->lock);
+	mscs->removed = true;
+	ieee80211_flow_purge(ap, mscs);
+	spin_unlock_bh(&mscs->lock);
+
+	kfree_rcu(mscs, rcu_head);
