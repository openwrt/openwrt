From: Felix Fietkau <nbd@nbd.name>
Date: Mon, 9 Nov 2026 17:04:03 +0100
Subject: [PATCH] wifi: mac80211: report the airtime of an MLO station only once

mac80211 counts the airtime of a station per AC, not per link.
sta_set_sinfo() reports that sum as the duration of the station, and
sta_set_link_sinfo() reports the same sum as the duration of each link.
cfg80211_sta_set_mld_sinfo() then adds the link durations to the
station value, so nl80211 reports more airtime for the station than the
driver registered, and each link claims the airtime of all links. A
non-MLD station of an AP MLD has one valid link and is affected too.

Leave the link durations to a driver that fills them in its
.link_sta_statistics, so that the station value holds the registered
airtime once.

A driver that fills the link durations has them counted twice in the
same way, since sta_set_sinfo() fills the station duration with the
registered airtime, which holds every link. Where mac80211 fills the
station duration itself, take the link durations that the driver filled
out of it, so that the sum that cfg80211 builds is the registered
airtime. A station duration that the driver fills stays as it is. The
result does not go below zero, since the link counters of a driver need
not follow the registered airtime exactly.

Fixes: 505991fba9ec ("wifi: mac80211: extend support to fill link level sinfo structure")
Fixes: 4cb1ce7e254a ("wifi: mac80211: add link_sta_statistics ops to fill link station statistics")
Signed-off-by: Felix Fietkau <nbd@nbd.name>
---
--- a/net/mac80211/sta_info.c
+++ b/net/mac80211/sta_info.c
@@ -2979,18 +2979,6 @@ static void sta_set_link_sinfo(struct st
 		link_sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_FAILED);
 	}
 
-	if (!(link_sinfo->filled & BIT_ULL(NL80211_STA_INFO_RX_DURATION))) {
-		for (ac = 0; ac < IEEE80211_NUM_ACS; ac++)
-			link_sinfo->rx_duration += sta->airtime[ac].rx_airtime;
-		link_sinfo->filled |= BIT_ULL(NL80211_STA_INFO_RX_DURATION);
-	}
-
-	if (!(link_sinfo->filled & BIT_ULL(NL80211_STA_INFO_TX_DURATION))) {
-		for (ac = 0; ac < IEEE80211_NUM_ACS; ac++)
-			link_sinfo->tx_duration += sta->airtime[ac].tx_airtime;
-		link_sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_DURATION);
-	}
-
 	if (!(link_sinfo->filled & BIT_ULL(NL80211_STA_INFO_AIRTIME_WEIGHT))) {
 		link_sinfo->airtime_weight = sta->airtime_weight;
 		link_sinfo->filled |= BIT_ULL(NL80211_STA_INFO_AIRTIME_WEIGHT);
@@ -3135,9 +3123,35 @@ static u32 sta_estimate_expected_through
 	return ((1024 * USEC_PER_SEC) / duration) * 8;
 }
 
+/*
+ * cfg80211_sta_set_mld_sinfo() adds the link durations a driver filled to
+ * the station value, and the airtime mac80211 counts holds them already.
+ */
+static void sta_sinfo_link_durations_subtract(struct station_info *sinfo,
+					      bool tx, bool rx)
+{
+	u64 tx_links = 0, rx_links = 0;
+	int link_id;
+
+	for_each_valid_link(sinfo, link_id) {
+		struct link_station_info *link_sinfo = sinfo->links[link_id];
+
+		if (link_sinfo->filled & BIT_ULL(NL80211_STA_INFO_TX_DURATION))
+			tx_links += link_sinfo->tx_duration;
+		if (link_sinfo->filled & BIT_ULL(NL80211_STA_INFO_RX_DURATION))
+			rx_links += link_sinfo->rx_duration;
+	}
+
+	if (tx)
+		sinfo->tx_duration -= min(sinfo->tx_duration, tx_links);
+	if (rx)
+		sinfo->rx_duration -= min(sinfo->rx_duration, rx_links);
+}
+
 void sta_set_sinfo(struct sta_info *sta, struct station_info *sinfo,
 		   bool tidstats)
 {
+	bool tx_duration_own = false, rx_duration_own = false;
 	struct ieee80211_sub_if_data *sdata = sta->sdata;
 	struct ieee80211_local *local = sdata->local;
 	u32 thr = 0;
@@ -3235,12 +3249,14 @@ void sta_set_sinfo(struct sta_info *sta,
 		for (ac = 0; ac < IEEE80211_NUM_ACS; ac++)
 			sinfo->rx_duration += sta->airtime[ac].rx_airtime;
 		sinfo->filled |= BIT_ULL(NL80211_STA_INFO_RX_DURATION);
+		rx_duration_own = true;
 	}
 
 	if (!(sinfo->filled & BIT_ULL(NL80211_STA_INFO_TX_DURATION))) {
 		for (ac = 0; ac < IEEE80211_NUM_ACS; ac++)
 			sinfo->tx_duration += sta->airtime[ac].tx_airtime;
 		sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_DURATION);
+		tx_duration_own = true;
 	}
 
 	if (!(sinfo->filled & BIT_ULL(NL80211_STA_INFO_AIRTIME_WEIGHT))) {
@@ -3409,8 +3425,11 @@ void sta_set_sinfo(struct sta_info *sta,
 			sta_set_link_sinfo(sta, sinfo->links[link_id],
 					   link, tidstats);
 		}
+
+		sta_sinfo_link_durations_subtract(sinfo, tx_duration_own,
+						  rx_duration_own);
 	}
 }
 
 u32 sta_get_expected_throughput(struct sta_info *sta)
 {
