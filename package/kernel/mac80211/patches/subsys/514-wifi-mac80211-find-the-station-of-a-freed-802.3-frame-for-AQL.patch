From a595a56d4aa73fceb19d52e0b71db9a38a9f27bc Mon Sep 17 00:00:00 2001
From: Julius Bairaktaris <julius@bairaktaris.de>
Date: Sun, 15 Nov 2026 02:29:38 +0100
Subject: [PATCH] wifi: mac80211: find the station of a freed 802.3 frame for AQL

ieee80211_report_used_skb() looks the station up from the 802.11 addresses
at the start of the frame. A frame sent through the encap offload starts
with its 802.3 header, so the lookup reads the wrong bytes, finds no
station and the airtime charged by ieee80211_tx_dequeue() is never
refunded when the frame is freed without a status report. Find the
station as the transmit path does.

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
--- a/net/mac80211/status.c
+++ b/net/mac80211/status.c
@@ -783,11 +783,26 @@ static void ieee80211_report_used_skb(st
 		acked = false;
 
 	if (tx_time_est) {
-		struct sta_info *sta;
+		struct ieee80211_sub_if_data *sdata;
+		struct sta_info *sta = NULL;
 
 		rcu_read_lock();
 
-		sta = sta_info_get_by_addrs(local, hdr->addr1, hdr->addr2);
+		/* An encap offloaded frame still starts with its 802.3
+		 * header; find its station as the transmit path did.
+		 */
+		if (!(info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP)) {
+			sta = sta_info_get_by_addrs(local, hdr->addr1,
+						    hdr->addr2);
+		} else {
+			sdata = ieee80211_sdata_from_skb(local, skb);
+			if (!sdata ||
+			    ieee80211_lookup_ra_sta(sdata, skb, &sta,
+						    skb->protocol ==
+						    sdata->control_port_protocol) ||
+			    IS_ERR(sta))
+				sta = NULL;
+		}
 		ieee80211_sta_update_pending_airtime(local, sta,
 						     skb_get_queue_mapping(skb),
 						     tx_time_est,
