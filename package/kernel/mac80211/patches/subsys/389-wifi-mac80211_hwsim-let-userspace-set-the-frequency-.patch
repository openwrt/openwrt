From: Felix Fietkau <nbd@nbd.name>
Date: Mon, 19 Oct 2026 09:30:00 +0200
Subject: [PATCH] wifi: mac80211_hwsim: let userspace set the frequency ranges
 of radios

A multi-radio hwsim wiphy registers one wiphy radio per band, each with
the frequency range of all channels of its band. Hardware often splits
a band between radios, for example the 5 GHz band of a tri-band device
into one radio for channels 36 to 64 and one for channel 100 and above.
Userspace that handles such a device, for example by assigning a
channel to each radio, cannot be tested on hwsim.

Add the HWSIM_ATTR_RADIOS attribute to HWSIM_CMD_NEW_RADIO. It is a
nested array of radios in the format of NL80211_ATTR_WIPHY_RADIOS: each
entry holds one or more NL80211_WIPHY_RADIO_ATTR_FREQ_RANGE attributes
with a start and an end in kHz, and its position gives the radio index.
Ranges must not overlap, since cfg80211_get_radio_idx_by_chan() takes
the first radio that covers a channel, and each range must cover at
least one channel. As in the ranges that drivers register, a range can
extend past the channels of a band, for example 2400000 to 2500000 kHz.
Channels outside all ranges are disabled. A strict driver hint
(REGULATORY_STRICT_REG) takes the channel flags from the regulatory
domain alone, so a regulatory notifier disables them again after each
update. More than one radio requires HWSIM_ATTR_MULTI_RADIO. Without
it, the single entry only limits the channels of the wiphy. The other
radio attributes are refused: each radio keeps the interface combination
that hwsim builds, and the antenna mask and the RTS threshold do not
come from userspace.

Without the attribute, a multi-radio wiphy keeps one radio per band.
HWSIM_CMD_GET_RADIO and the new radio notification report the radios of
a multi-radio wiphy, and the entry given for a single-radio wiphy, so
that userspace can check that the kernel applied them.

A channel stays enabled only if its 20 MHz (1 MHz for S1G) lies within
a frequency range of one radio, the test that
ieee80211_radio_freq_range_valid() applies.

Signed-off-by: Felix Fietkau <nbd@nbd.name>
---
--- a/drivers/net/wireless/virtual/mac80211_hwsim_i.h
+++ b/drivers/net/wireless/virtual/mac80211_hwsim_i.h
@@ -66,8 +66,9 @@ struct mac80211_hwsim_data {
 	struct mac80211_hwsim_phy_data *phy_data;
 
 	struct ieee80211_iface_combination if_combination_radio;
-	struct wiphy_radio_freq_range radio_range[NUM_NL80211_BANDS];
-	struct wiphy_radio radio[NUM_NL80211_BANDS];
+	struct wiphy_radio_freq_range *radio_range;
+	struct wiphy_radio *radio;
+	int n_radio;
 
 	u32 ciphers[HWSIM_NUM_CIPHERS];
 
--- a/drivers/net/wireless/virtual/mac80211_hwsim_main.c
+++ b/drivers/net/wireless/virtual/mac80211_hwsim_main.c
@@ -862,6 +862,22 @@ hwsim_pmsr_capa_policy[NL80211_PMSR_ATTR
 	[NL80211_PMSR_ATTR_PEERS] = { .type = NLA_REJECT }, // only for request.
 };
 
+static const struct nla_policy
+hwsim_radio_freq_policy[NL80211_WIPHY_RADIO_FREQ_ATTR_MAX + 1] = {
+	[NL80211_WIPHY_RADIO_FREQ_ATTR_START] = { .type = NLA_U32 },
+	[NL80211_WIPHY_RADIO_FREQ_ATTR_END] = { .type = NLA_U32 },
+};
+
+static const struct nla_policy
+hwsim_radio_policy[NL80211_WIPHY_RADIO_ATTR_MAX + 1] = {
+	[NL80211_WIPHY_RADIO_ATTR_INDEX] = { .type = NLA_REJECT },
+	[NL80211_WIPHY_RADIO_ATTR_FREQ_RANGE] =
+		NLA_POLICY_NESTED(hwsim_radio_freq_policy),
+	[NL80211_WIPHY_RADIO_ATTR_INTERFACE_COMBINATION] = { .type = NLA_REJECT },
+	[NL80211_WIPHY_RADIO_ATTR_ANTENNA_MASK] = { .type = NLA_REJECT },
+	[NL80211_WIPHY_RADIO_ATTR_RTS_THRESHOLD] = { .type = NLA_REJECT },
+};
+
 static const struct nla_policy hwsim_genl_policy[HWSIM_ATTR_MAX + 1] = {
 	[HWSIM_ATTR_ADDR_RECEIVER] = NLA_POLICY_ETH_ADDR_COMPAT,
 	[HWSIM_ATTR_ADDR_TRANSMITTER] = NLA_POLICY_ETH_ADDR_COMPAT,
@@ -895,6 +911,7 @@ static const struct nla_policy hwsim_gen
 	[HWSIM_ATTR_MULTI_RADIO] = { .type = NLA_FLAG },
 	[HWSIM_ATTR_SUPPORT_NAN_DEVICE] = { .type = NLA_FLAG },
 	[HWSIM_ATTR_SUPPORT_BACKGROUND_RADAR] = { .type = NLA_FLAG },
+	[HWSIM_ATTR_RADIOS] = NLA_POLICY_NESTED_ARRAY(hwsim_radio_policy),
 };
 
 #if IS_REACHABLE(CONFIG_VIRTIO)
@@ -4370,6 +4387,8 @@ struct hwsim_new_radio_params {
 	const struct cfg80211_pmsr_capabilities *pmsr_capa;
 	bool nan_device;
 	bool background_radar;
+	const struct wiphy_radio *radio;
+	int n_radio;
 };
 
 static void hwsim_mcast_config_msg(struct sk_buff *mcast_skb,
@@ -4383,6 +4402,42 @@ static void hwsim_mcast_config_msg(struc
 				  HWSIM_MCGRP_CONFIG, GFP_KERNEL);
 }
 
+static int hwsim_radios_put(struct sk_buff *skb,
+			    const struct wiphy_radio *radio, int n_radio)
+{
+	const struct wiphy_radio_freq_range *range;
+	struct nlattr *radios, *entry, *freq;
+	int i, j;
+
+	radios = nla_nest_start(skb, HWSIM_ATTR_RADIOS);
+	if (!radios)
+		return -EMSGSIZE;
+
+	for (i = 0; i < n_radio; i++) {
+		entry = nla_nest_start(skb, i);
+		if (!entry)
+			return -EMSGSIZE;
+
+		for (j = 0; j < radio[i].n_freq_range; j++) {
+			range = &radio[i].freq_range[j];
+			freq = nla_nest_start(skb,
+					      NL80211_WIPHY_RADIO_ATTR_FREQ_RANGE);
+			if (!freq ||
+			    nla_put_u32(skb, NL80211_WIPHY_RADIO_FREQ_ATTR_START,
+					range->start_freq) ||
+			    nla_put_u32(skb, NL80211_WIPHY_RADIO_FREQ_ATTR_END,
+					range->end_freq))
+				return -EMSGSIZE;
+			nla_nest_end(skb, freq);
+		}
+
+		nla_nest_end(skb, entry);
+	}
+
+	nla_nest_end(skb, radios);
+	return 0;
+}
+
 static int append_radio_msg(struct sk_buff *skb, int id,
 			    struct hwsim_new_radio_params *param)
 {
@@ -4461,6 +4516,12 @@ static int append_radio_msg(struct sk_bu
 		if (ret < 0)
 			return ret;
 	}
+
+	if (param->n_radio) {
+		ret = hwsim_radios_put(skb, param->radio, param->n_radio);
+		if (ret < 0)
+			return ret;
+	}
 	return 0;
 }
 
@@ -5598,6 +5659,179 @@ static void mac80211_hwsim_sband_capab(s
 	}
 }
 
+static void hwsim_channels_freq_range(const struct ieee80211_channel *channels,
+				      int n_channels,
+				      struct wiphy_radio_freq_range *range)
+{
+	range->start_freq = ieee80211_channel_to_khz(&channels[0]) - 10000;
+	range->end_freq = ieee80211_channel_to_khz(&channels[n_channels - 1]) +
+			  10000;
+}
+
+static void mac80211_hwsim_radios_free(struct mac80211_hwsim_data *data)
+{
+	kfree(data->radio);
+	kfree(data->radio_range);
+	data->radio = NULL;
+	data->radio_range = NULL;
+	data->n_radio = 0;
+}
+
+static int mac80211_hwsim_radios_alloc(struct mac80211_hwsim_data *data,
+				       int n_radio, int n_range)
+{
+	data->radio = kcalloc(n_radio, sizeof(*data->radio), GFP_KERNEL);
+	data->radio_range = kcalloc(n_range, sizeof(*data->radio_range),
+				    GFP_KERNEL);
+	if (!data->radio || !data->radio_range) {
+		mac80211_hwsim_radios_free(data);
+		return -ENOMEM;
+	}
+
+	data->n_radio = n_radio;
+	return 0;
+}
+
+static int mac80211_hwsim_radios_copy(struct mac80211_hwsim_data *data,
+				      const struct wiphy_radio *radio,
+				      int n_radio)
+{
+	struct wiphy_radio_freq_range *range;
+	int i, n_range = 0;
+	int err;
+
+	for (i = 0; i < n_radio; i++)
+		n_range += radio[i].n_freq_range;
+
+	err = mac80211_hwsim_radios_alloc(data, n_radio, n_range);
+	if (err)
+		return err;
+
+	range = data->radio_range;
+	for (i = 0; i < n_radio; i++) {
+		memcpy(range, radio[i].freq_range,
+		       radio[i].n_freq_range * sizeof(*range));
+		data->radio[i].freq_range = range;
+		data->radio[i].n_freq_range = radio[i].n_freq_range;
+		range += radio[i].n_freq_range;
+	}
+
+	return 0;
+}
+
+static int mac80211_hwsim_radios_band(struct mac80211_hwsim_data *data)
+{
+	struct ieee80211_supported_band *sband;
+	struct wiphy *wiphy = data->hw->wiphy;
+	enum nl80211_band band;
+	int i = 0, n_band = 0;
+	int err;
+
+	for (band = NL80211_BAND_2GHZ; band < NUM_NL80211_BANDS; band++) {
+		if (wiphy->bands[band])
+			n_band++;
+	}
+
+	err = mac80211_hwsim_radios_alloc(data, n_band, n_band);
+	if (err)
+		return err;
+
+	for (band = NL80211_BAND_2GHZ; band < NUM_NL80211_BANDS; band++) {
+		sband = wiphy->bands[band];
+		if (!sband)
+			continue;
+
+		hwsim_channels_freq_range(sband->channels, sband->n_channels,
+					  &data->radio_range[i]);
+		data->radio[i].freq_range = &data->radio_range[i];
+		data->radio[i].n_freq_range = 1;
+		i++;
+	}
+
+	return 0;
+}
+
+static bool hwsim_radio_covers_chan(const struct wiphy_radio *radio,
+				    const struct ieee80211_channel *chan)
+{
+	u32 width = MHZ_TO_KHZ(chan->band == NL80211_BAND_S1GHZ ? 1 : 20);
+
+	return ieee80211_radio_freq_range_valid(radio,
+						ieee80211_channel_to_khz(chan),
+						width);
+}
+
+static bool mac80211_hwsim_radios_cover(const struct mac80211_hwsim_data *data,
+					const struct ieee80211_channel *chan)
+{
+	int i;
+
+	for (i = 0; i < data->n_radio; i++) {
+		if (hwsim_radio_covers_chan(&data->radio[i], chan))
+			return true;
+	}
+
+	return false;
+}
+
+static void
+mac80211_hwsim_channels_uncovered_disable(struct mac80211_hwsim_data *data)
+{
+	struct ieee80211_supported_band *sband;
+	struct ieee80211_channel *chan;
+	enum nl80211_band band;
+	int i;
+
+	for (band = NL80211_BAND_2GHZ; band < NUM_NL80211_BANDS; band++) {
+		sband = data->hw->wiphy->bands[band];
+		if (!sband)
+			continue;
+
+		for (i = 0; i < sband->n_channels; i++) {
+			chan = &sband->channels[i];
+			if (mac80211_hwsim_radios_cover(data, chan))
+				continue;
+
+			chan->flags |= IEEE80211_CHAN_DISABLED;
+			chan->orig_flags |= IEEE80211_CHAN_DISABLED;
+		}
+	}
+}
+
+/* A strict driver hint takes the channel flags from the regulatory domain
+ * alone.
+ */
+static void mac80211_hwsim_reg_notifier(struct wiphy *wiphy,
+					struct regulatory_request *request)
+{
+	struct ieee80211_hw *hw = wiphy_to_ieee80211_hw(wiphy);
+
+	mac80211_hwsim_channels_uncovered_disable(hw->priv);
+}
+
+static int mac80211_hwsim_radios_init(struct mac80211_hwsim_data *data,
+				      const struct hwsim_new_radio_params *param)
+{
+	int err = 0;
+	int i;
+
+	if (param->n_radio)
+		err = mac80211_hwsim_radios_copy(data, param->radio,
+						 param->n_radio);
+	else if (param->multi_radio)
+		err = mac80211_hwsim_radios_band(data);
+	if (err || !data->n_radio)
+		return err;
+
+	for (i = 0; i < data->n_radio; i++) {
+		data->radio[i].iface_combinations = &data->if_combination_radio;
+		data->radio[i].n_iface_combinations = 1;
+	}
+
+	mac80211_hwsim_channels_uncovered_disable(data);
+	return 0;
+}
+
