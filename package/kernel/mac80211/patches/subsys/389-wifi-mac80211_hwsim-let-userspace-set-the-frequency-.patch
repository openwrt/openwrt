+		data->if_combination.num_different_channels *= data->n_radio;
 	}
 
 	if (data->use_chanctx)
@@ -6165,6 +6386,8 @@ static int mac80211_hwsim_new_radio(stru
 	hwsim_radios_generation++;
 	spin_unlock_bh(&hwsim_radio_lock);
 
+	param->radio = data->radio;
+	param->n_radio = data->n_radio;
 	hwsim_mcast_new_radio(idx, info, param);
 
 	return idx;
@@ -6177,6 +6400,7 @@ failed_hw:
 failed_bind:
 	device_unregister(data->dev);
 failed_drvdata:
+	mac80211_hwsim_radios_free(data);
