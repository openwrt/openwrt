+/* well below the 32 radios that the u32 radio masks of cfg80211 can hold */
+#define HWSIM_MAX_RADIOS		16
+#define HWSIM_MAX_RADIO_FREQ_RANGES	8
+
+static bool hwsim_freq_range_covers(const struct wiphy_radio_freq_range *range)
+{
+	static const struct {
+		const struct ieee80211_channel *channels;
+		int n_channels;
+	} bands[] = {
+		{ hwsim_channels_2ghz, ARRAY_SIZE(hwsim_channels_2ghz) },
+		{ hwsim_channels_5ghz, ARRAY_SIZE(hwsim_channels_5ghz) },
+		{ hwsim_channels_6ghz, ARRAY_SIZE(hwsim_channels_6ghz) },
+		{ hwsim_channels_s1g, ARRAY_SIZE(hwsim_channels_s1g) },
+	};
+	const struct wiphy_radio radio = {
+		.freq_range = range,
+		.n_freq_range = 1,
+	};
+	int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(bands); i++) {
+		for (j = 0; j < bands[i].n_channels; j++) {
+			if (hwsim_radio_covers_chan(&radio,
+						    &bands[i].channels[j]))
+				return true;
+		}
+	}
+
+	return false;
+}
+
+static int hwsim_freq_range_parse(const struct nlattr *attr,
+				  struct wiphy_radio_freq_range *range,
+				  struct genl_info *info)
+{
+	struct nlattr *tb[NL80211_WIPHY_RADIO_FREQ_ATTR_MAX + 1];
+	int ret;
+
+	ret = nla_parse_nested(tb, NL80211_WIPHY_RADIO_FREQ_ATTR_MAX, attr,
+			       hwsim_radio_freq_policy, info->extack);
+	if (ret)
+		return ret;
+
+	if (NL_REQ_ATTR_CHECK(info->extack, attr, tb,
+			      NL80211_WIPHY_RADIO_FREQ_ATTR_START) ||
+	    NL_REQ_ATTR_CHECK(info->extack, attr, tb,
+			      NL80211_WIPHY_RADIO_FREQ_ATTR_END))
+		return -EINVAL;
+
+	range->start_freq = nla_get_u32(tb[NL80211_WIPHY_RADIO_FREQ_ATTR_START]);
+	range->end_freq = nla_get_u32(tb[NL80211_WIPHY_RADIO_FREQ_ATTR_END]);
+
+	if (range->start_freq >= range->end_freq) {
+		NL_SET_ERR_MSG_ATTR(info->extack, attr,
+				    "frequency range does not end after its start");
+		return -EINVAL;
+	}
+
+	if (!hwsim_freq_range_covers(range)) {
+		NL_SET_ERR_MSG_ATTR(info->extack, attr,
+				    "frequency range covers no channel");
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int hwsim_radio_ranges_count(const struct nlattr *radios,
+				    struct genl_info *info, int *n_range)
+{
+	const struct nlattr *radio, *freq;
+	int rem, rem_freq, n, n_radio = 0;
+
+	*n_range = 0;
+	nla_for_each_nested(radio, radios, rem) {
+		n = 0;
+		nla_for_each_nested_type(freq,
+					 NL80211_WIPHY_RADIO_ATTR_FREQ_RANGE,
+					 radio, rem_freq) {
+			n++;
+		}
+
+		if (!n || n > HWSIM_MAX_RADIO_FREQ_RANGES) {
+			NL_SET_ERR_MSG_ATTR(info->extack, radio,
+					    "radio needs 1 to 8 frequency ranges");
+			return -EINVAL;
+		}
+
+		*n_range += n;
+		n_radio++;
+	}
+
+	if (!n_radio || n_radio > HWSIM_MAX_RADIOS) {
+		NL_SET_ERR_MSG_ATTR(info->extack, radios,
+				    "radio count must be 1 to 16");
+		return -EINVAL;
+	}
+
+	return n_radio;
+}
+
+static bool hwsim_freq_ranges_overlap(const struct wiphy_radio_freq_range *range,
+				      int n_range)
+{
+	int i, j;
+
+	for (i = 0; i < n_range; i++) {
+		for (j = i + 1; j < n_range; j++) {
+			if (range[i].start_freq < range[j].end_freq &&
+			    range[j].start_freq < range[i].end_freq)
+				return true;
+		}
+	}
+
+	return false;
+}
+
+/*
+ * Returns the number of radios; on success, the caller frees *radio_out and
+ * *range_out, which holds the ranges of all radios.
+ */
+static int hwsim_radios_parse(const struct nlattr *radios,
+			      struct genl_info *info,
+			      struct wiphy_radio **radio_out,
+			      struct wiphy_radio_freq_range **range_out)
+{
+	struct wiphy_radio_freq_range *range, *next;
+	int rem, rem_freq, n_radio, n_range, i = 0;
+	const struct nlattr *radio, *freq;
+	struct wiphy_radio *out;
+	int ret;
+
+	n_radio = hwsim_radio_ranges_count(radios, info, &n_range);
+	if (n_radio < 0)
+		return n_radio;
+
+	out = kcalloc(n_radio, sizeof(*out), GFP_KERNEL);
+	range = kcalloc(n_range, sizeof(*range), GFP_KERNEL);
+	if (!out || !range) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	next = range;
+	nla_for_each_nested(radio, radios, rem) {
+		out[i].freq_range = next;
+		nla_for_each_nested_type(freq,
+					 NL80211_WIPHY_RADIO_ATTR_FREQ_RANGE,
+					 radio, rem_freq) {
+			ret = hwsim_freq_range_parse(freq, next++, info);
+			if (ret)
+				goto err;
+			out[i].n_freq_range++;
+		}
+		i++;
+	}
+
+	if (hwsim_freq_ranges_overlap(range, n_range)) {
+		NL_SET_ERR_MSG_ATTR(info->extack, radios,
+				    "frequency ranges overlap");
+		ret = -EINVAL;
+		goto err;
+	}
+
+	*radio_out = out;
+	*range_out = range;
+	return n_radio;
+
+err:
+	kfree(out);
+	kfree(range);
+	return ret;
+}
+
 static int hwsim_new_radio_nl(struct sk_buff *msg, struct genl_info *info)
 {
+	struct wiphy_radio_freq_range *radio_range = NULL;
 	struct hwsim_new_radio_params param = { 0 };
+	struct wiphy_radio *radio = NULL;
 	const char *hwname = NULL;
 	int ret;
 
@@ -6886,6 +7290,24 @@ static int hwsim_new_radio_nl(struct sk_
 		param.hwname = hwname;
 	}
 
+	if (info->attrs[HWSIM_ATTR_RADIOS]) {
+		ret = hwsim_radios_parse(info->attrs[HWSIM_ATTR_RADIOS], info,
+					 &radio, &radio_range);
+		if (ret < 0)
+			goto out_free;
