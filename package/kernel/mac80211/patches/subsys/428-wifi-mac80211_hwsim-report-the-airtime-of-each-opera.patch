 		default:
 			WARN(1, "Invalid mode %d\n", mode);
@@ -6372,6 +6692,8 @@ static int mac80211_hwsim_new_radio(stru
 	hw->wiphy->ema_max_profile_periodicity = 3;
 
 	spin_lock_init(&data->tsf_offset_lock);
+	for (i = 0; i < ARRAY_SIZE(data->airtime); i++)
+		spin_lock_init(&data->airtime[i].lock);
 
 	data->rx_rssi = DEFAULT_RX_RSSI;
 
@@ -6939,6 +7261,8 @@ static int hwsim_cloned_frame_received_n
 {
 	struct mac80211_hwsim_data *data2;
 	struct ieee80211_rx_status rx_status;
+	const struct ieee80211_tx_rate *tx_rate;
