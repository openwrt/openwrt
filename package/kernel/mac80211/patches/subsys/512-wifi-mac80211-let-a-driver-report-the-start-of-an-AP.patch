From: Felix Fietkau <nbd@nbd.name>
Date: Sat, 14 Nov 2026 18:45:00 +0100
Subject: [PATCH] wifi: mac80211: let a driver report the start of an AP
 Removal Timer

Add ieee80211_ap_removal_timer_started(), with which a driver that
counts the AP Removal Timer reports the count and the TBTT that it
applies to each removed link, so that user space times the removal from
them.

Signed-off-by: Felix Fietkau <nbd@nbd.name>
---
--- a/include/net/mac80211.h
+++ b/include/net/mac80211.h
@@ -6174,6 +6174,24 @@ void ieee80211_crit_update_done(struct i
 void ieee80211_links_removed(struct ieee80211_vif *vif, u16 links);
 
 /**
+ * ieee80211_ap_removal_timer_started - report the start of an AP Removal Timer
+ * @vif: &struct ieee80211_vif pointer from the add_interface callback.
+ * @event: the link, and the count and the TBTT of its removal
+ * @gfp: allocation flags
+ *
+ * A driver with %NL80211_EXT_FEATURE_AP_REMOVAL_TIMER_OFFLOAD calls this for
+ * each removed link of an AP MLD when it starts to count the AP Removal Timer,
+ * with the count that it puts on air and the TBTT at which it removes the
+ * link, before it calls ieee80211_links_removed() for the link. mac80211
+ * reports it with %NL80211_CMD_AP_REMOVAL_TIMER_STARTED.
+ *
+ * This function can be called from any context.
+ */
+void ieee80211_ap_removal_timer_started(struct ieee80211_vif *vif,
+					const struct cfg80211_ap_removal_timer_event *event,
+					gfp_t gfp);
+
+/**
  * ieee80211_proberesp_get - retrieve a Probe Response template
  * @hw: pointer obtained from ieee80211_alloc_hw().
  * @vif: &struct ieee80211_vif pointer from the add_interface callback.
--- a/net/mac80211/iface.c
+++ b/net/mac80211/iface.c
@@ -1948,6 +1948,16 @@ void ieee80211_links_removed(struct ieee
 }
 EXPORT_SYMBOL_GPL(ieee80211_links_removed);
 
+void ieee80211_ap_removal_timer_started(struct ieee80211_vif *vif,
+					const struct cfg80211_ap_removal_timer_event *event,
+					gfp_t gfp)
+{
+	struct ieee80211_sub_if_data *sdata = vif_to_sdata(vif);
+
+	cfg80211_ap_removal_timer_started(sdata->dev, event, gfp);
+}
+EXPORT_SYMBOL_GPL(ieee80211_ap_removal_timer_started);
+
 void ieee80211_ap_removal_end(struct ieee80211_sub_if_data *sdata, u16 links)
 {
 	lockdep_assert_wiphy(sdata->local->hw.wiphy);
