From: Felix Fietkau <nbd@nbd.name>
Date: Sun, 27 Sep 2026 22:00:00 +0200
Subject: [PATCH] wifi: mac80211_hwsim: declare the MLD capabilities of a station

An MLO radio declares extended capabilities, EML capabilities and MLD
capabilities for the AP interface type only. A station interface of the
same radio then reports no simultaneous links, and userspace that reads
the station's MLD capabilities from the wiphy describes an MLO station
as supporting no simultaneous transmit and receive.

Declare the station interface type as well, with the extended
capabilities of the AP entry except the TWT responder bit and the same
maximum number of simultaneous links, and no EML capabilities.

ieee80211_add_ml_elem() takes the MLD Capabilities of the Association
Request from this entry, so an MLO station of hwsim now announces that
maximum number of simultaneous links instead of 0.

Signed-off-by: Felix Fietkau <nbd@nbd.name>
---
--- a/drivers/net/wireless/virtual/mac80211_hwsim_main.c
+++ b/drivers/net/wireless/virtual/mac80211_hwsim_main.c
@@ -5665,6 +5665,14 @@ static const u8 iftypes_ext_capa_ap[] =
 	 [9] = WLAN_EXT_CAPA10_TWT_RESPONDER_SUPPORT,
 };
 
+static const u8 iftypes_ext_capa_sta[] = {
+	 [0] = WLAN_EXT_CAPA1_EXT_CHANNEL_SWITCHING,
+	 [2] = WLAN_EXT_CAPA3_MULTI_BSSID_SUPPORT,
+	 [7] = WLAN_EXT_CAPA8_OPMODE_NOTIF |
+	       WLAN_EXT_CAPA8_MAX_MSDU_IN_AMSDU_LSB,
+	 [8] = WLAN_EXT_CAPA9_MAX_MSDU_IN_AMSDU_MSB,
+};
+
 #define MAC80211_HWSIM_MLD_CAPA_OPS				\
 	FIELD_PREP_CONST(IEEE80211_MLD_CAP_OP_TID_TO_LINK_MAP_NEG_SUPP, \
 			 IEEE80211_MLD_CAP_OP_TID_TO_LINK_MAP_NEG_SUPP_SAME) | \
@@ -5680,6 +5688,14 @@ static const struct wiphy_iftype_ext_cap
 		.eml_capabilities = IEEE80211_EML_CAP_EMLSR_SUPP |
 				    IEEE80211_EML_CAP_EMLMR_SUPPORT,
 		.mld_capa_and_ops = MAC80211_HWSIM_MLD_CAPA_OPS,
+	}, {
+		.iftype = NL80211_IFTYPE_STATION,
+		.extended_capabilities = iftypes_ext_capa_sta,
+		.extended_capabilities_mask = iftypes_ext_capa_sta,
+		.extended_capabilities_len = sizeof(iftypes_ext_capa_sta),
+		.mld_capa_and_ops =
+			FIELD_PREP_CONST(IEEE80211_MLD_CAP_OP_MAX_SIMUL_LINKS,
+					 IEEE80211_MLD_MAX_NUM_LINKS - 1),
 	},
 };
 
