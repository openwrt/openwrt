From: Felix Fietkau <nbd@nbd.name>
Date: Wed, 4 Nov 2026 14:30:00 +0100
Subject: [PATCH] wifi: mac80211: update station rx stats for a fast-rx A-MSDU

Since fast-rx handles A-MSDUs, ieee80211_invoke_fast_rx() returns after
__ieee80211_rx_h_amsdu() and does not reach the station stats update.
The signal values followed when that update moved into
ieee80211_rx_8023(). An A-MSDU on the fast path thus updates no packet,
byte, fragment, last_rx, last_rate or signal value of the station, and a
station that sends mostly A-MSDUs shows almost no rx packets. Only the
MSDU and netdev counters stay right, since ieee80211_deliver_skb()
updates them for each subframe. A driver with rx decap offload gets here
when a monitor interface disables the offload.

Update the station stats for the A-MSDU before it is split, once for
each MPDU, like the slow path. The split consumes the skb that holds the
rx status. The MSDU counter stays in ieee80211_rx_8023() for frames that
do not pass ieee80211_deliver_skb().

Fixes: 24bba078eca0 ("mac80211: support A-MSDU in fast-rx")
Fixes: 80a915ec4427 ("mac80211: add rx decapsulation offload support")
Signed-off-by: Felix Fietkau <nbd@nbd.name>
---
--- a/net/mac80211/rx.c
+++ b/net/mac80211/rx.c
@@ -4991,27 +4991,13 @@ void ieee80211_check_fast_rx_iface(struc
 	__ieee80211_check_fast_rx_iface(sdata);
 }
 
-static void ieee80211_rx_8023(struct ieee80211_rx_data *rx,
-			      struct ieee80211_fast_rx *fast_rx,
-			      int orig_len)
+static struct ieee80211_sta_rx_stats *
+ieee80211_fast_rx_stats_update(struct ieee80211_fast_rx *fast_rx,
+			       struct link_sta_info *link_sta,
+			       struct ieee80211_rx_status *status,
+			       int orig_len)
 {
 	struct ieee80211_sta_rx_stats *stats;
-	struct ieee80211_rx_status *status = IEEE80211_SKB_RXCB(rx->skb);
-	struct sta_info *sta = rx->sta;
-	struct link_sta_info *link_sta;
-	struct sk_buff *skb = rx->skb;
-	void *sa = skb->data + ETH_ALEN;
-	void *da = skb->data;
-
-	if (rx->link_id >= 0) {
-		link_sta = rcu_dereference(sta->link[rx->link_id]);
-		if (WARN_ON_ONCE(!link_sta)) {
-			dev_kfree_skb(rx->skb);
-			return;
-		}
-	} else {
-		link_sta = &sta->deflink;
-	}
 
 	stats = &link_sta->rx_stats;
 	if (fast_rx->uses_rss)
@@ -5049,6 +5035,38 @@ static void ieee80211_rx_8023(struct iee
 	stats->fragments++;
 	stats->packets++;
 
+	u64_stats_update_begin(&stats->syncp);
+	u64_stats_add(&stats->bytes, orig_len);
+	u64_stats_update_end(&stats->syncp);
+
+	return stats;
+}
+
+static void ieee80211_rx_8023(struct ieee80211_rx_data *rx,
+			      struct ieee80211_fast_rx *fast_rx,
+			      int orig_len)
+{
+	struct ieee80211_sta_rx_stats *stats;
+	struct ieee80211_rx_status *status = IEEE80211_SKB_RXCB(rx->skb);
+	struct sta_info *sta = rx->sta;
+	struct link_sta_info *link_sta;
+	struct sk_buff *skb = rx->skb;
+	void *sa = skb->data + ETH_ALEN;
+	void *da = skb->data;
+
+	if (rx->link_id >= 0) {
+		link_sta = rcu_dereference(sta->link[rx->link_id]);
+		if (WARN_ON_ONCE(!link_sta)) {
+			dev_kfree_skb(rx->skb);
+			return;
+		}
+	} else {
+		link_sta = &sta->deflink;
+	}
+
+	stats = ieee80211_fast_rx_stats_update(fast_rx, link_sta, status,
+					       orig_len);
+
 	skb->dev = fast_rx->dev;
 
 	dev_sw_netstats_rx_add(fast_rx->dev, skb->len);
@@ -5060,7 +5078,6 @@ static void ieee80211_rx_8023(struct iee
 	 */
 	u64_stats_update_begin(&stats->syncp);
 	u64_stats_inc(&stats->msdu[rx->seqno_idx]);
-	u64_stats_add(&stats->bytes, orig_len);
 	u64_stats_update_end(&stats->syncp);
 
 	ieee80211_flow_learn(rx);
@@ -5201,6 +5218,9 @@ static bool ieee80211_invoke_fast_rx(str
 		goto drop;
 
 	if (status->rx_flags & IEEE80211_RX_AMSDU) {
+		ieee80211_fast_rx_stats_update(fast_rx, rx->link_sta, status,
+					       orig_len);
+
 		if (__ieee80211_rx_h_amsdu(rx, snap_offs - hdrlen) !=
 		    RX_QUEUED)
 			goto drop;
