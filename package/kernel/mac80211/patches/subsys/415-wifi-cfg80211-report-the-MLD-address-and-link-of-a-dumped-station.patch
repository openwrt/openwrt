From: Felix Fietkau <nbd@nbd.name>
Date: Thu, 1 Oct 2026 20:23:37 +0200
Subject: [PATCH] wifi: cfg80211: report the MLD address and link of a dumped
 station

Since nl80211_dump_station() builds the aggregated message with
nl80211_put_sta_info_common() instead of nl80211_send_station(), a
station dump no longer carries NL80211_ATTR_MLD_ADDR and
NL80211_ATTR_MLO_LINK_ID, while NL80211_CMD_GET_STATION for one station
still does. Userspace that dumps the stations of an AP MLD can then no
longer tell an MLO station from a legacy one, nor its association link.

Move the MLO parameters into nl80211_put_sta_mlo_params() and emit them
in the aggregated message of the dump as well. The association IEs stay
out of the dump, as 727afb05ef63 intends.

Fixes: 727afb05ef63 ("wifi: cfg80211: Refactor nl80211_dump_station() to prepare for per-link stats")
Signed-off-by: Felix Fietkau <nbd@nbd.name>
---
 net/wireless/nl80211.c | 30 ++++++++++++++++++++----------
 1 file changed, 20 insertions(+), 10 deletions(-)

--- a/net/wireless/nl80211.c
+++ b/net/wireless/nl80211.c
@@ -8234,6 +8234,22 @@ nla_put_failure:
 	return -EMSGSIZE;
 }
 
+static int nl80211_put_sta_mlo_params(struct sk_buff *msg,
+				      struct station_info *sinfo)
+{
+	if (!sinfo->mlo_params_valid)
+		return 0;
+
+	if (nla_put_u8(msg, NL80211_ATTR_MLO_LINK_ID, sinfo->assoc_link_id))
+		return -EMSGSIZE;
+
+	if (!is_zero_ether_addr(sinfo->mld_addr) &&
+	    nla_put(msg, NL80211_ATTR_MLD_ADDR, ETH_ALEN, sinfo->mld_addr))
+		return -EMSGSIZE;
+
+	return 0;
+}
+
 static int nl80211_send_station(struct sk_buff *msg, u32 cmd, u32 portid,
 				u32 seq, int flags,
 				struct cfg80211_registered_device *rdev,
@@ -8269,16 +8285,8 @@ static int nl80211_send_station(struct s
 		    sinfo->assoc_resp_ies))
 		goto nla_put_failure;
 
-	if (sinfo->mlo_params_valid) {
-		if (nla_put_u8(msg, NL80211_ATTR_MLO_LINK_ID,
-			       sinfo->assoc_link_id))
-			goto nla_put_failure;
-
-		if (!is_zero_ether_addr(sinfo->mld_addr) &&
-		    nla_put(msg, NL80211_ATTR_MLD_ADDR, ETH_ALEN,
-			    sinfo->mld_addr))
-			goto nla_put_failure;
-	}
+	if (nl80211_put_sta_mlo_params(msg, sinfo))
+		goto nla_put_failure;
 
 	cfg80211_sinfo_release_content(sinfo);
 	genlmsg_end(msg, hdr);
@@ -8673,6 +8681,8 @@ static int nl80211_dump_station(struct s
 		switch (ctx->phase) {
 		case NL80211_DUMP_STA_PHASE_AGGREGATED:
 			ret = nl80211_put_sta_info_common(skb, rdev, &ctx->sinfo);
+			if (!ret)
+				ret = nl80211_put_sta_mlo_params(skb, &ctx->sinfo);
 			if (ret) {
 				genlmsg_cancel(skb, hdr);
 				err = ret;
