From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nickolay Savchenko <n.savchenko@axioma.lv>
Date: Thu, 16 Jul 2026 03:35:29 +0300
Subject: [PATCH] wifi: rt2x00: limit advertised RT5392 TX spatial streams

Allow RT5392 boards to limit the number of transmit spatial streams
advertised in HT capabilities without changing the physical RF topology
described by the EEPROM.

Signed-off-by: Nickolay Savchenko <n.savchenko@axioma.lv>
---
--- a/drivers/net/wireless/ralink/rt2x00/rt2800lib.c
+++ b/drivers/net/wireless/ralink/rt2x00/rt2800lib.c
@@ -11816,7 +11816,7 @@ static int rt2800_probe_hw_mode(struct r
 	s8 *default_power1;
 	s8 *default_power2;
 	s8 *default_power3;
-	unsigned int i, tx_chains, rx_chains;
+	unsigned int i, tx_chains, tx_streams, rx_chains;
 	u32 reg;
 
 	/*
@@ -11959,6 +11959,17 @@ static int rt2800_probe_hw_mode(struct r
 	tx_chains = rt2x00dev->default_ant.tx_chain_num;
 	rx_chains = rt2x00dev->default_ant.rx_chain_num;
+	tx_streams = tx_chains;
 
+	if (rt2x00_rt(rt2x00dev, RT5392)) {
+		u32 max_tx_streams;
+
+		if (!of_property_read_u32(rt2x00dev->dev->of_node,
+					  "ralink,max-tx-streams",
+					  &max_tx_streams) &&
+		    max_tx_streams >= 1 && max_tx_streams <= 2)
+			tx_streams = min_t(unsigned int, tx_streams, max_tx_streams);
+	}
+
 	if (tx_chains >= 2)
 		spec->ht.cap |= IEEE80211_HT_CAP_TX_STBC;
 
@@ -11974,10 +11985,10 @@ static int rt2800_probe_hw_mode(struct r
 	spec->ht.ampdu_factor = (rx_chains > 1) ? 3 : 2;
 	spec->ht.ampdu_density = 4;
 	spec->ht.mcs.tx_params = IEEE80211_HT_MCS_TX_DEFINED;
-	if (tx_chains != rx_chains) {
+	if (tx_streams != rx_chains) {
 		spec->ht.mcs.tx_params |= IEEE80211_HT_MCS_TX_RX_DIFF;
 		spec->ht.mcs.tx_params |=
-		    (tx_chains - 1) << IEEE80211_HT_MCS_TX_MAX_STREAMS_SHIFT;
+		    (tx_streams - 1) << IEEE80211_HT_MCS_TX_MAX_STREAMS_SHIFT;
 	}
 
 	/*
