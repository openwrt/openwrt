From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gleb Pesin <dormancygrace@gmail.com>
Date: Sat, 5 Sep 2026 01:59:40 +0000
Subject: [PATCH] wifi: rt2x00: read extended TX retry status on RT6352

Read the per-frame retry counter from TX_STA_FIFO_EXT before reading
TX_STA_FIFO on RT6352 and carry both words through the software FIFO.
For matched non-aggregated completions, retain the complete 8-bit retry
count and reconstruct the configured fallback chain up to the reported
final rate. Keep repeated attempts at that rate, respect the MCS8 and
OFDM fallback floors, and reject inconsistent rate/count pairs.

Report the full chain through ieee80211_tx_status_ext, with a bounded
legacy prefix. Aggregated completions retain the existing retry
estimate, but use the same rate-chain mapping.
Unmatched completions and other chips retain their existing status path.

Retain packet ID and hardware queue selection from TX_STA_FIFO. On an
MT7620A ECO6 / RT6352 board, the EXT packet-ID field returned zero while
the regular FIFO PID matched TXWI. Using the EXT PID therefore routes
management completions to the wrong queue and breaks authentication.

Signed-off-by: Gleb Pesin <dormancygrace@gmail.com>

--- a/drivers/net/wireless/ralink/rt2x00/rt2800.h
+++ b/drivers/net/wireless/ralink/rt2x00/rt2800.h
@@ -2016,6 +2016,12 @@
 #define MPDU_DENSITY_CNT_RX_ZERO_DEL	FIELD32(0xffff0000)
 
 /*
+ * TX_STA_FIFO_EXT: per-frame TX status extension (RT6352).
+ */
+#define TX_STA_FIFO_EXT			0x1798
+#define TX_STA_FIFO_EXT_RETRY_COUNT	FIELD32(0x000000ff)
+
+/*
  * Security key table memory.
  *
  * The pairwise key table shares some memory with the beacon frame
--- a/drivers/net/wireless/ralink/rt2x00/rt2800lib.c
+++ b/drivers/net/wireless/ralink/rt2x00/rt2800lib.c
@@ -1019,13 +1019,95 @@ static bool rt2800_txdone_entry_check(st
 	return true;
 }
 
-void rt2800_txdone_entry(struct queue_entry *entry, u32 status, __le32 *txwi,
-			 bool match)
+/* Eight fallback stages, or two entries for 256 attempts at one rate. */
+#define RT2800_TX_STATUS_RATES 8
+
+static u8 rt2800_fill_tx_rates(struct rt2x00_dev *rt2x00dev,
+			       const struct skb_frame_desc *skbdesc,
+			       u32 status, unsigned int retry,
+			       struct ieee80211_tx_rate *legacy,
+			       struct ieee80211_rate_status *rates)
+{
+	struct ieee80211_supported_band *sband;
+	struct skb_frame_desc final = {};
+	u8 flags = skbdesc->tx_rate_flags;
+	int idx = skbdesc->tx_rate_idx;
+	int mode = rt2x00_get_field32(status, TX_STA_FIFO_PHYMODE);
+	int floor, last, attempts = retry + 1;
+	int count, i, n = 0;
+
+	memset(legacy, 0, sizeof(*legacy) * IEEE80211_TX_MAX_RATES);
+	memset(rates, 0, sizeof(*rates) * RT2800_TX_STATUS_RATES);
+	for (i = 0; i < IEEE80211_TX_MAX_RATES; i++)
+		legacy[i].idx = -1;
+
+	/* The programmed HT table keeps MCS8 in the two-stream group. */
+	if (flags & IEEE80211_TX_RC_MCS) {
+		if (idx > 15)
+			return 0;
+		floor = idx & ~7;
+	} else {
+		sband = rt2x00dev->hw->wiphy->bands[rt2x00dev->curr_band];
+		if (!sband || idx >= sband->n_bitrates)
+			return 0;
+		/* Reject a PHY mode that cannot belong to the requested rate. */
+		if (mode != (rt2x00dev->curr_band == NL80211_BAND_2GHZ &&
+			     idx < 4 ? RATE_MODE_CCK : RATE_MODE_OFDM))
+			return 0;
+		/* OFDM falls back to OFDM 6 Mbps, never into the CCK table. */
+		floor = rt2x00dev->curr_band == NL80211_BAND_2GHZ &&
+			idx >= 4 ? 4 : 0;
+	}
+
+	rt2800_rate_from_status(&final, status, rt2x00dev->curr_band);
+	last = final.tx_rate_idx;
+	/* Do not feed an inconsistent FIFO/TXWI pair to rate control. */
+	if (retry > 255 || last < floor || last > idx || retry < idx - last ||
+	    ((final.tx_rate_flags ^ flags) & (IEEE80211_TX_RC_MCS |
+						IEEE80211_TX_RC_GREEN_FIELD |
+						IEEE80211_TX_RC_40_MHZ_WIDTH |
+						IEEE80211_TX_RC_SHORT_GI)))
+		return 0;
+
+	while (attempts && n < RT2800_TX_STATUS_RATES) {
+		struct rate_info *ri = &rates[n].rate_idx;
+
+		count = idx > last ? 1 : min(attempts, 255);
+		if (flags & IEEE80211_TX_RC_MCS) {
+			ri->flags = RATE_INFO_FLAGS_MCS;
+			ri->mcs = idx;
+			ri->bw = flags & IEEE80211_TX_RC_40_MHZ_WIDTH ?
+				 RATE_INFO_BW_40 : RATE_INFO_BW_20;
+			if (flags & IEEE80211_TX_RC_SHORT_GI)
+				ri->flags |= RATE_INFO_FLAGS_SHORT_GI;
+		} else {
+			ri->legacy = sband->bitrates[idx].bitrate;
+		}
+		rates[n].try_count = count;
+		/* Keep a truthful prefix for consumers of the legacy API. */
+		if (n < IEEE80211_TX_MAX_RATES) {
+			legacy[n].idx = idx;
+			legacy[n].flags = flags;
+			legacy[n].count = min(count, IEEE80211_MAX_TX_RETRY);
+		}
+		attempts -= count;
+		if (idx > last)
+			idx--;
+		n++;
+	}
+
+	return n;
+}
+
+void rt2800_txdone_entry(struct queue_entry *entry, u32 status,
+			 u32 status_ext, __le32 *txwi, bool match)
 {
 	struct rt2x00_dev *rt2x00dev = entry->queue->rt2x00dev;
 	struct rt2800_drv_data *drv_data = rt2x00dev->drv_data;
 	struct skb_frame_desc *skbdesc = get_skb_frame_desc(entry->skb);
 	struct txdone_entry_desc txdesc;
+	struct ieee80211_tx_rate legacy[IEEE80211_TX_MAX_RATES];
+	struct ieee80211_rate_status rates[RT2800_TX_STATUS_RATES];
 	u32 word;
 	u16 mcs, real_mcs;
 	int aggr, ampdu, wcid, ack_req;
@@ -1075,19 +1157,24 @@ void rt2800_txdone_entry(struct queue_en
 	if (!ack_req)
 		__set_bit(TXDONE_NO_ACK_REQ, &txdesc.flags);
 
+	if (rt2x00_get_field32(status, TX_STA_FIFO_TX_SUCCESS))
+		__set_bit(TXDONE_SUCCESS, &txdesc.flags);
+	else
+		__set_bit(TXDONE_FAILURE, &txdesc.flags);
+
 	/*
-	 * Ralink has a retry mechanism using a global fallback
-	 * table. We setup this fallback table to try the immediate
-	 * lower rate for all rates. In the TX_STA_FIFO, the MCS field
-	 * always contains the MCS used for the last transmission, be
-	 * it successful or not.
+	 * Aggregation can replace the requested rate with another MPDU's
+	 * rate, so retain the existing estimate for aggregate completions.
+	 * Unmatched completions and other chips also retain that estimate.
 	 */
-	if (rt2x00_get_field32(status, TX_STA_FIFO_TX_SUCCESS)) {
+	if (rt2x00_rt(rt2x00dev, RT6352) && match && !aggr && !ampdu) {
+		txdesc.retry = rt2x00_get_field32(status_ext,
+						  TX_STA_FIFO_EXT_RETRY_COUNT);
+	} else if (rt2x00_get_field32(status, TX_STA_FIFO_TX_SUCCESS)) {
 		/*
 		 * Transmission succeeded. The number of retries is
 		 * mcs - real_mcs
 		 */
-		__set_bit(TXDONE_SUCCESS, &txdesc.flags);
 		txdesc.retry = ((mcs > real_mcs) ? mcs - real_mcs : 0);
 	} else {
 		/*
@@ -1095,10 +1182,18 @@ void rt2800_txdone_entry(struct queue_en
 		 * always 7 in this case (for a total number of 8
 		 * frames sent).
 		 */
-		__set_bit(TXDONE_FAILURE, &txdesc.flags);
 		txdesc.retry = rt2x00dev->long_retry;
 	}
 
+	if (rt2x00_rt(rt2x00dev, RT6352) && match) {
+		txdesc.n_rates = rt2800_fill_tx_rates(rt2x00dev, skbdesc,
+						      status, txdesc.retry,
+						      legacy, rates);
+		txdesc.legacy_rates = legacy;
+		txdesc.rates = rates;
+		__set_bit(TXDONE_EXTENDED_RATES, &txdesc.flags);
+	}
+
 	/*
 	 * the frame was retried at least once
 	 * -> hw used fallback rates
@@ -1125,6 +1220,7 @@ void rt2800_txdone(struct rt2x00_dev *rt
 {
 	struct data_queue *queue;
 	struct queue_entry *entry;
+	struct rt2x00_txstatus txstatus;
 	u32 reg;
 	u8 qid;
 	bool match;
@@ -1135,7 +1231,9 @@ void rt2800_txdone(struct rt2x00_dev *rt
 		IEEE80211_AC_VO,
 	};
 
-	while (quota-- > 0 && kfifo_get(&rt2x00dev->txstatus_fifo, &reg)) {
+	while (quota-- > 0 && kfifo_get(&rt2x00dev->txstatus_fifo, &txstatus)) {
+		reg = txstatus.status;
+
 		/*
 		 * TX_STA_FIFO_PID_QUEUE is a 2-bit field, thus qid is
 		 * guaranteed to be one of the TX QIDs .
@@ -1161,7 +1259,8 @@ void rt2800_txdone(struct rt2x00_dev *rt
 		}
 
 		match = rt2800_txdone_entry_check(entry, reg);
-		rt2800_txdone_entry(entry, reg, rt2800_drv_get_txwi(entry), match);
+		rt2800_txdone_entry(entry, reg, txstatus.status_ext,
+				    rt2800_drv_get_txwi(entry), match);
 	}
 }
 EXPORT_SYMBOL_GPL(rt2800_txdone);
--- a/drivers/net/wireless/ralink/rt2x00/rt2800lib.h
+++ b/drivers/net/wireless/ralink/rt2x00/rt2800lib.h
@@ -200,8 +200,8 @@ void rt2800_write_tx_data(struct queue_e
 			  struct txentry_desc *txdesc);
 void rt2800_process_rxwi(struct queue_entry *entry, struct rxdone_entry_desc *txdesc);
 
-void rt2800_txdone_entry(struct queue_entry *entry, u32 status, __le32 *txwi,
-			 bool match);
+void rt2800_txdone_entry(struct queue_entry *entry, u32 status,
+			 u32 status_ext, __le32 *txwi, bool match);
 void rt2800_txdone(struct rt2x00_dev *rt2x00dev, unsigned int quota);
 void rt2800_txdone_nostatus(struct rt2x00_dev *rt2x00dev);
 bool rt2800_txstatus_timeout(struct rt2x00_dev *rt2x00dev);
--- a/drivers/net/wireless/ralink/rt2x00/rt2800mmio.c
+++ b/drivers/net/wireless/ralink/rt2x00/rt2800mmio.c
@@ -279,7 +279,7 @@ EXPORT_SYMBOL_GPL(rt2800mmio_autowake_ta
 
 static void rt2800mmio_fetch_txstatus(struct rt2x00_dev *rt2x00dev)
 {
-	u32 status;
+	struct rt2x00_txstatus txstatus = {};
 	unsigned long flags;
 
 	/*
@@ -300,11 +300,22 @@ static void rt2800mmio_fetch_txstatus(st
 	spin_lock_irqsave(&rt2x00dev->irqmask_lock, flags);
 
 	while (!kfifo_is_full(&rt2x00dev->txstatus_fifo)) {
-		status = rt2x00mmio_register_read(rt2x00dev, TX_STA_FIFO);
-		if (!rt2x00_get_field32(status, TX_STA_FIFO_VALID))
+		/* MT7620 programming guide v1.0: register 696 (page 470)
+		 * marks EXT read-only; register 664 (page 464) marks the
+		 * FIFO VALID bit read-clear. Read EXT before FIFO, including
+		 * the final invalid entry, as in the vendor driver.
+		 */
+		if (rt2x00_rt(rt2x00dev, RT6352))
+			txstatus.status_ext =
+				rt2x00mmio_register_read(rt2x00dev,
+							 TX_STA_FIFO_EXT);
+
+		txstatus.status = rt2x00mmio_register_read(rt2x00dev,
+							   TX_STA_FIFO);
+		if (!rt2x00_get_field32(txstatus.status, TX_STA_FIFO_VALID))
 			break;
 
-		kfifo_put(&rt2x00dev->txstatus_fifo, status);
+		kfifo_put(&rt2x00dev->txstatus_fifo, txstatus);
 	}
 
 	spin_unlock_irqrestore(&rt2x00dev->irqmask_lock, flags);
--- a/drivers/net/wireless/ralink/rt2x00/rt2800usb.c
+++ b/drivers/net/wireless/ralink/rt2x00/rt2800usb.c
@@ -94,6 +94,9 @@ static void rt2800usb_stop_queue(struct
 static bool rt2800usb_tx_sta_fifo_read_completed(struct rt2x00_dev *rt2x00dev,
 						 int urb_status, u32 tx_status)
 {
+	struct rt2x00_txstatus status = {
+		.status = tx_status,
+	};
 	bool valid;
 
 	if (urb_status) {
@@ -105,7 +108,7 @@ static bool rt2800usb_tx_sta_fifo_read_c
 
 	valid = rt2x00_get_field32(tx_status, TX_STA_FIFO_VALID);
 	if (valid) {
-		if (!kfifo_put(&rt2x00dev->txstatus_fifo, tx_status))
+		if (!kfifo_put(&rt2x00dev->txstatus_fifo, status))
 			rt2x00_warn(rt2x00dev, "TX status FIFO overrun\n");
 
 		queue_work(rt2x00dev->workqueue, &rt2x00dev->txdone_work);
--- a/drivers/net/wireless/ralink/rt2x00/rt2x00.h
+++ b/drivers/net/wireless/ralink/rt2x00/rt2x00.h
@@ -723,6 +723,11 @@ enum {
 	NUM_IF_COMB,
 };
 
+struct rt2x00_txstatus {
+	u32 status;
+	u32 status_ext;
+};
+
 /*
  * rt2x00 device structure.
  */
@@ -974,7 +979,7 @@ struct rt2x00_dev {
 	/*
 	 * FIFO for storing tx status reports between isr and tasklet.
 	 */
-	DECLARE_KFIFO_PTR(txstatus_fifo, u32);
+	DECLARE_KFIFO_PTR(txstatus_fifo, struct rt2x00_txstatus);
 
 	/*
 	 * Timer to ensure tx status reports are read (rt2800usb).
--- a/drivers/net/wireless/ralink/rt2x00/rt2x00dev.c
+++ b/drivers/net/wireless/ralink/rt2x00/rt2x00dev.c
@@ -328,6 +328,12 @@ static void rt2x00lib_fill_tx_status(str
 	 * retry it lowered the rate 1 step except when the
 	 * lowest rate was used.
 	 */
+	if (test_bit(TXDONE_EXTENDED_RATES, &txdesc->flags)) {
+		memcpy(tx_info->status.rates, txdesc->legacy_rates,
+		       sizeof(tx_info->status.rates));
+		goto flags;
+	}
+
 	for (i = 0; i < retry_rates && i < IEEE80211_TX_MAX_RATES; i++) {
 		tx_info->status.rates[i].idx = rate_idx - i;
 		tx_info->status.rates[i].flags = rate_flags;
@@ -346,6 +352,7 @@ static void rt2x00lib_fill_tx_status(str
 	if (i < (IEEE80211_TX_MAX_RATES - 1))
 		tx_info->status.rates[i].idx = -1; /* terminate */
 
+flags:
 	if (test_bit(TXDONE_NO_ACK_REQ, &txdesc->flags))
 		tx_info->flags |= IEEE80211_TX_CTL_NO_ACK;
 
@@ -533,10 +540,26 @@ void rt2x00lib_txdone(struct queue_entry
 	 * send the status report back.
 	 */
 	if (!(skbdesc_flags & SKBDESC_NOT_MAC80211)) {
-		if (rt2x00_has_cap_flag(rt2x00dev, REQUIRE_TASKLET_CONTEXT))
+		if (test_bit(TXDONE_EXTENDED_RATES, &txdesc->flags)) {
+			struct ieee80211_hdr *hdr = (void *)entry->skb->data;
+			struct ieee80211_tx_status status = {
+				.skb = entry->skb,
+				.info = tx_info,
+				.rates = txdesc->rates,
+				.n_rates = txdesc->n_rates,
+			};
+
+			/* RT6352 TX completion runs in serialized tasklet context. */
+			rcu_read_lock();
+			status.sta = ieee80211_find_sta_by_ifaddr(rt2x00dev->hw,
+								  hdr->addr1, hdr->addr2);
+			ieee80211_tx_status_ext(rt2x00dev->hw, &status);
+			rcu_read_unlock();
+		} else if (rt2x00_has_cap_flag(rt2x00dev, REQUIRE_TASKLET_CONTEXT)) {
 			ieee80211_tx_status_skb(rt2x00dev->hw, entry->skb);
-		else
+		} else {
 			ieee80211_tx_status_ni(rt2x00dev->hw, entry->skb);
+		}
 	} else {
 		dev_kfree_skb_any(entry->skb);
 	}
--- a/drivers/net/wireless/ralink/rt2x00/rt2x00queue.h
+++ b/drivers/net/wireless/ralink/rt2x00/rt2x00queue.h
@@ -217,6 +217,7 @@ struct rxdone_entry_desc {
  * @TXDONE_SUCCESS: Frame was successfully send
  * @TXDONE_FALLBACK: Hardware used fallback rates for retries
  * @TXDONE_FAILURE: Frame was not successfully send
+ * @TXDONE_EXTENDED_RATES: Driver supplied an extended rate history.
  * @TXDONE_EXCESSIVE_RETRY: In addition to &TXDONE_FAILURE, the
  *	frame transmission failed due to excessive retries.
  */
@@ -228,6 +229,7 @@ enum txdone_entry_desc_flags {
 	TXDONE_EXCESSIVE_RETRY,
 	TXDONE_AMPDU,
 	TXDONE_NO_ACK_REQ,
+	TXDONE_EXTENDED_RATES,
 };
 
 /**
@@ -238,10 +240,16 @@ enum txdone_entry_desc_flags {
  *
  * @flags: TX done flags (See &enum txdone_entry_desc_flags).
  * @retry: Retry count.
+ * @legacy_rates: Legacy rate prefix, valid only with TXDONE_EXTENDED_RATES.
+ * @rates: Extended rates, valid until the synchronous TX status call returns.
+ * @n_rates: Number of extended rate entries.
  */
 struct txdone_entry_desc {
 	unsigned long flags;
 	int retry;
+	const struct ieee80211_tx_rate *legacy_rates;
+	struct ieee80211_rate_status *rates;
+	u8 n_rates;
 };
 
 /**
