From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nickolay Savchenko <n.savchenko@axioma.lv>
Date: Thu, 16 Jul 2026 03:35:29 +0300
Subject: [PATCH] wifi: rt2x00: control RT5392 LED directly

Allow boards without the MCU LED path to select direct register control
through a device-tree property.

Signed-off-by: Nickolay Savchenko <n.savchenko@axioma.lv>
---
--- a/drivers/net/wireless/ralink/rt2x00/rt2800lib.c
+++ b/drivers/net/wireless/ralink/rt2x00/rt2800lib.c
@@ -1657,6 +1657,30 @@ static void rt2800_brightness_set(struct
 				   EEPROM_FREQ_LED_MODE);
 	u32 reg;
 
+	/* ZyXEL's RT5392 board wiring uses GPIO1 together with LED_CFG,
+	 * while the generic PCI path sends MCU_LED commands. The vendor
+	 * driver programs these registers directly. Keep the other two
+	 * logical rt2x00 LEDs from fighting this one physical pin.
+	 */
+	if (rt2x00_rt(led->rt2x00dev, RT5392) &&
+	    of_property_read_bool(led->rt2x00dev->dev->of_node,
+				  "ralink,direct-led-control")) {
+		if (led->type != LED_TYPE_RADIO)
+			return;
+
+		/* Exact register state captured from the working vendor driver. */
+		reg = rt2800_register_read(led->rt2x00dev, GPIO_CTRL);
+		reg &= ~0xa2;
+		rt2800_register_write(led->rt2x00dev, GPIO_CTRL, reg);
+		rt2800_register_write(led->rt2x00dev, GPIO_SWITCH, 0);
+
+		reg = 0;
+		if (enabled)
+			rt2x00_set_field32(&reg, LED_CFG_LED_POLAR, 1);
+		rt2800_register_write(led->rt2x00dev, LED_CFG, reg);
+		return;
+	}
+
 	/* Check for SoC (SOC devices don't support MCU requests) */
 	if (rt2x00_is_soc(led->rt2x00dev)) {
 		reg = rt2800_register_read(led->rt2x00dev, LED_CFG);
