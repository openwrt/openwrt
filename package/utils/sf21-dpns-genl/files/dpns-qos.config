# Hardware QoS on the DPNS NPU (see /etc/init.d/dpns-qos).
# Classified packets use queue <priority> of the egress port, unclassified ones queue 0.
# Queues 4-7 are strict priority (7 highest) above queues 0-3, which use "sched".

config globals 'globals'
	option enabled '0'

config port 'wan'
	option device 'eth4'
	# egress rate limit in Mbit/s, 0 = off
	option rate '0'
	# queues 0-3: pq | rr | wrr | dwrr, weights for queues 0-3
	option sched 'dwrr'
	option weights '1 2 4 8'

config class 'voice'
	option enabled '0'
	# DSCP name (EF, CSn, AFxy) or number; the NPU matches the DSCP class (precedence)
	option dscp 'EF'
	option priority '7'

config class 'dns'
	option enabled '0'
	option proto 'udp'
	option dport '53'
	option priority '6'

config class 'bulk'
	option enabled '0'
	option src '192.168.1.200/32'
	option priority '1'
