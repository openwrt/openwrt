#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

PROFILE_DIR="${OMCI_PROFILE_DIR:-/usr/share/omci/profiles}"

usage() {
	cat >&2 <<'USAGE'
Usage:
  omci-profile list
  omci-profile apply <profile-id> [<input-name> <value>]...
USAGE
	exit 2
}

valid_name() {
	case "$1" in
		''|*[!a-z0-9_]* ) return 1 ;;
		* ) return 0 ;;
	esac
}

list_profiles() {
	local script metadata separator

	printf '['
	separator=''
	for script in "$PROFILE_DIR"/*.sh; do
		[ -x "$script" ] || continue
		metadata=$("$script" describe 2>/dev/null) || continue
		[ -n "$metadata" ] || continue
		printf '%s%s' "$separator" "$metadata"
		separator=','
	done
	printf ']\n'
}

apply_profile() {
	local profile_id script input_name input_value env_name

	profile_id="$1"
	shift
	valid_name "$profile_id" || {
		echo "Invalid profile ID" >&2
		exit 2
	}

	script="$PROFILE_DIR/$profile_id.sh"
	[ -x "$script" ] || {
		echo "Unknown OMCI profile: $profile_id" >&2
		exit 2
	}

	[ $(( $# % 2 )) -eq 0 ] || usage

	while [ "$#" -gt 0 ]; do
		input_name="$1"
		input_value="$2"
		shift 2

		valid_name "$input_name" || {
			echo "Invalid profile input name: $input_name" >&2
			exit 2
		}

		env_name=$(printf '%s' "$input_name" | tr 'a-z' 'A-Z')
		export "OMCI_INPUT_${env_name}=$input_value"
	done

	exec "$script" apply
}

case "$1" in
	list)
		[ "$#" -eq 1 ] || usage
		list_profiles
		;;
	apply)
		[ "$#" -ge 2 ] || usage
		shift
		apply_profile "$@"
		;;
	*)
		usage
		;;
esac
