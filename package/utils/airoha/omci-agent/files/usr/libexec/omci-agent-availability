#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

BACKEND="${OMCI_BACKEND:-/usr/libexec/omci-netlink}"
UCI="${OMCI_UCI:-/sbin/uci}"
RUNTIME_DIR="${OMCI_RUNTIME_DIR:-/var/run/omci-agent}"
LUCI_CACHE_DIR="${OMCI_LUCI_CACHE_DIR:-/tmp}"
AVAILABLE_FILE="$RUNTIME_DIR/available"

get_device() {
	local device

	device="$("$UCI" -q get omci.main.device 2>/dev/null)"
	case "$device" in
		''|*[!0-9]*) device=0 ;;
	esac

	printf '%s\n' "$device"
}

invalidate_luci_menu() {
	rm -f "$LUCI_CACHE_DIR"/luci-indexcache.*.json
}

update_availability() {
	local available=0 changed=0 device

	device="$(get_device)"
	if "$BACKEND" --json --device "$device" status >/dev/null 2>&1; then
		available=1
	fi

	if [ "$available" -eq 1 ]; then
		mkdir -p "$RUNTIME_DIR"
		if [ ! -f "$AVAILABLE_FILE" ]; then
			: > "$AVAILABLE_FILE"
			changed=1
		fi
	else
		if [ -e "$AVAILABLE_FILE" ]; then
			rm -f "$AVAILABLE_FILE"
			changed=1
		fi
	fi

	[ "$changed" -eq 0 ] || invalidate_luci_menu
	[ "$available" -eq 1 ]
}

update_availability
