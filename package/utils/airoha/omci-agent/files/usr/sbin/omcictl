#!/usr/bin/ucode

'use strict';

import * as libubus from 'ubus';

let json_output = false;
let device = 0;

function usage() {
	warn('usage: omcictl [--json] [--device ID] COMMAND\n' +
		'  status\n' +
		'  agent enable|disable|permissive|strict|fake-enable|fake-disable\n' +
		'  config list\n' +
		'  config details\n' +
		'  config get KEY\n' +
		'  config inspect KEY\n' +
		'  config set KEY VALUE\n' +
		'  class list\n' +
		'  class show CLASS\n' +
		'  mib list\n' +
		'  mib show CLASS ENTITY\n' +
		'  mib set CLASS ENTITY MASK HEX-DATA\n' +
		'  mib delete CLASS ENTITY\n' +
		'  mib reset\n' +
		'  raw-tx HEX-PDU\n' +
		'  apply\n');
}

function uint(value, maximum) {
	let number;

	if (type(value) == 'int')
		number = value;
	else if (type(value) == 'string' && match(value, /^0[xX][0-9a-fA-F]+$/))
		number = int(substr(value, 2), 16);
	else if (type(value) == 'string' && match(value, /^[0-9]+$/))
		number = int(value);
	else
		return null;

	return number >= 0 && number <= maximum ? number : null;
}

function rpc_call(bus, method, args, field) {
	let result = bus.call('omci.agent', method, args || {});

	if (result == null) {
		warn(`omcictl: ${libubus.error() || 'RPC call failed'}\n`);
		exit(1);
	}

	return field == null ? result : result[field];
}

function print_vlan_filter(filter) {
	if (filter == null)
		return;

	printf('  vlan-filter: forward=%d entries=%d\n',
		filter.forward_operation || 0, filter.number_of_entries || 0);

	for (let entry in filter.entries || [])
		printf('    [%d] tci=0x%04x pbit=%d dei=%d vid=%d\n',
			entry.index || 0, entry.tci || 0, entry.pbit || 0,
			entry.dei || 0, entry.vid || 0);
}

function print_extended_vlan(vlan) {
	if (vlan == null)
		return;

	printf('  extended-vlan: association=%d pointer=0x%04x ' +
		'input-tpid=0x%04x output-tpid=0x%04x downstream=%d ' +
		'max=%d rules=%d\n',
		vlan.association_type || 0, vlan.associated_me || 0,
		vlan.input_tpid || 0, vlan.output_tpid || 0,
		vlan.downstream_mode || 0, vlan.max_table_size || 0,
		length(vlan.rules || []));

	for (let rule in vlan.rules || [])
		printf('    [%d] raw=%s delete=%s ' +
			'filter={outer:%d/%d/%d inner:%d/%d/%d eth:%d} ' +
			'treatment={remove:%d outer:%d/%d/%d inner:%d/%d/%d}\n',
			rule.index || 0, rule.raw || '', rule.delete ? 'yes' : 'no',
			rule.filter_outer_pbit || 0, rule.filter_outer_vid || 0,
			rule.filter_outer_tpid_dei || 0,
			rule.filter_inner_pbit || 0, rule.filter_inner_vid || 0,
			rule.filter_inner_tpid_dei || 0,
			rule.filter_ethertype || 0, rule.tags_to_remove || 0,
			rule.treat_outer_pbit || 0, rule.treat_outer_vid || 0,
			rule.treat_outer_tpid_dei || 0,
			rule.treat_inner_pbit || 0, rule.treat_inner_vid || 0,
			rule.treat_inner_tpid_dei || 0);
}

function print_class(info) {
	printf('class=%d name=%s category=%s support=%s flags=0x%08x\n',
		info.class_id || 0, info.name || '', info.category_name || 'unspecified',
		info.support_name || 'unknown', info.flags || 0);
}

function print_mib(object) {
	printf('class=%d entity=%d mask=0x%04x origin=%d name=%s data=%s\n',
		object.class_id, object.entity_id, object.mask, object.origin,
		object.name || '', object.data || '');
	print_vlan_filter(object.vlan_filter);
	print_extended_vlan(object.extended_vlan);
}

function print_status(status) {
	let names = [
		'device', 'ifindex', 'state', 'onu_id', 'gem_port', 'channel_up',
		'agent_enabled', 'permissive', 'fake_omci', 'mib_sync', 'mib_objects',
		'rx_packets', 'rx_bytes', 'rx_dropped', 'tx_packets', 'tx_bytes',
		'tx_errors', 'responses', 'duplicates', 'unsupported', 'fake_responses',
		'fec_downstream', 'fec_upstream', 'bosa_temperature_mc',
		'bosa_voltage_uv', 'bosa_bias_ua', 'bosa_tx_power_nw',
		'bosa_rx_power_nw', 'bosa_alarms'
	];

	for (let name in names) {
		let value = status[name];
		printf('%s: %s\n', replace(name, /_/g, '-'), value == null ? 'unavailable' : `${value}`);
	}
}

while (length(ARGV) && substr(ARGV[0], 0, 1) == '-') {
	let option = shift(ARGV);

	if (option == '--json' || option == '-j') {
		json_output = true;
	}
	else if (option == '--device' || option == '-d') {
		device = uint(shift(ARGV), 0xffffffff);
		if (device == null) {
			usage();
			exit(1);
		}
	}
	else {
		usage();
		exit(1);
	}
}

if (!length(ARGV)) {
	usage();
	exit(1);
}

let bus = libubus.connect();
if (!bus) {
	warn(`omcictl: ${libubus.error() || 'unable to connect to ubus'}\n`);
	exit(1);
}

let command = shift(ARGV);
let result;
let kind;

switch (command) {
case 'status':
	if (length(ARGV)) break;
	result = rpc_call(bus, 'status', { device }, 'status');
	kind = 'status';
	break;

case 'agent':
	if (length(ARGV) != 1) break;
	result = rpc_call(bus, 'agent_set', { device, mode: ARGV[0] });
	kind = 'write';
	break;

case 'config':
	let config_command = shift(ARGV);
	if (config_command == 'list' && !length(ARGV)) {
		result = rpc_call(bus, 'config_list', { device }, 'config');
		kind = 'config-list';
	}
	else if (config_command == 'details' && !length(ARGV)) {
		result = rpc_call(bus, 'config_details', { device }, 'config');
		kind = 'config-details';
	}
	else if (config_command == 'get' && length(ARGV) == 1) {
		result = rpc_call(bus, 'config_get', { device, key: ARGV[0] }, 'value');
		kind = 'value';
	}
	else if (config_command == 'inspect' && length(ARGV) == 1) {
		result = rpc_call(bus, 'config_inspect', { device, key: ARGV[0] }, 'info');
		kind = 'config-info';
	}
	else if (config_command == 'set' && length(ARGV) == 2) {
		result = rpc_call(bus, 'config_set', { device, key: ARGV[0], value: ARGV[1] });
		kind = 'write';
	}
	break;

case 'class':
	let class_command = shift(ARGV);
	if (class_command == 'list' && !length(ARGV)) {
		result = rpc_call(bus, 'class_list', {}, 'classes');
		kind = 'class-list';
	}
	else if (class_command == 'show' && length(ARGV) == 1) {
		let class_id = uint(ARGV[0], 0xffff);
		if (class_id == null) break;
		result = rpc_call(bus, 'class_get', { class_id }, 'class');
		kind = 'class';
	}
	break;

case 'mib':
	let mib_command = shift(ARGV);
	if (mib_command == 'list' && !length(ARGV)) {
		result = rpc_call(bus, 'mib_list', { device }, 'objects');
		kind = 'mib-list';
	}
	else if (mib_command == 'reset' && !length(ARGV)) {
		result = rpc_call(bus, 'mib_reset', { device });
		kind = 'write';
	}
	else if ((mib_command == 'show' || mib_command == 'delete') && length(ARGV) == 2) {
		let class_id = uint(ARGV[0], 0xffff);
		let entity_id = uint(ARGV[1], 0xffff);
		if (class_id == null || entity_id == null) break;
		if (mib_command == 'show') {
			result = rpc_call(bus, 'mib_get', { device, class_id, entity_id }, 'object');
			kind = 'mib';
		}
		else {
			result = rpc_call(bus, 'mib_delete', { device, class_id, entity_id });
			kind = 'write';
		}
	}
	else if (mib_command == 'set' && length(ARGV) == 4) {
		let class_id = uint(ARGV[0], 0xffff);
		let entity_id = uint(ARGV[1], 0xffff);
		let mask = uint(ARGV[2], 0xffff);
		if (class_id == null || entity_id == null || mask == null) break;
		result = rpc_call(bus, 'mib_set', { device, class_id, entity_id, mask, data: ARGV[3] });
		kind = 'write';
	}
	break;

case 'raw-tx':
	if (length(ARGV) != 1) break;
	result = rpc_call(bus, 'raw_tx', { device, pdu: ARGV[0] });
	kind = 'write';
	break;

case 'apply':
	if (length(ARGV)) break;
	result = rpc_call(bus, 'apply', {});
	kind = 'apply';
	break;
}

if (kind == null) {
	usage();
	exit(1);
}

if (json_output) {
	printf('%.J\n', result);
}
else if (kind == 'status') {
	print_status(result);
}
else if (kind == 'config-list') {
	for (let name, value in result)
		printf('%s: %s\n', name, value);
}
else if (kind == 'config-details') {
	for (let name, info in result)
		printf('%s: %s [source=%s]\n', name, info.value, info.source_name || 'unspecified');
}
else if (kind == 'config-info') {
	printf('%s [source=%s]\n', result.value, result.source_name || 'unspecified');
}
else if (kind == 'class-list') {
	for (let info in result)
		print_class(info);
}
else if (kind == 'class') {
	print_class(result);
}
else if (kind == 'mib-list') {
	for (let object in result)
		print_mib(object);
}
else if (kind == 'mib') {
	print_mib(result);
}
else if (kind == 'value') {
	printf('%s\n', result);
}
else if (kind == 'apply') {
	printf('applied %d OMCI settings\n', result.applied || 0);
}

exit(0);
