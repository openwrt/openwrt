# Local setup only; negotiated links and services remain kernel state.
config agent 'main'
	# Empty selects a single xPON device automatically.
	option netdev ''
	# OMCI-specific settings below apply only to GPON/XGS-PON.
	option device '0'
	option enabled '0'
	option permissive '1'
	option fake_omci '0'
	option dying_gasp '1'
	# Optional OLT-requested reboot policy; empty keeps the kernel default.
	option reboot ''
	option reset_mib '0'

	# OLT interoperability policy: auto, generic, nokia-alcl, dasan,
	# huawei, fiberhome, zte, or unspecified.
	option olt_profile 'auto'
	option olt_profile_force 'unspecified'

	# ONU identity. Empty values leave the kernel/driver source unchanged.
	option serial ''
	option vendor_id ''
	option hardware_version ''
	option software_version_0 ''
	option software_version_1 ''
	option equipment_id ''
	option password ''

	# Legacy combined version, retained for older configurations only.
	option version ''

	# Optional scalar identity/capability overrides.
	option omcc_version ''
	option traffic_management_option ''
	option onu_type ''
	option uni_count ''

	# Last built-in profile applied through RPC/LuCI.
	option profile ''

# Optional EPON registration instances. IDs are local, not assigned wire LLIDs.
# config link 'primary'
#	option id '1'
#	option enabled '1'
