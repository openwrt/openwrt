#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	local dev

	# the device of the wan interface; without one the daemon uses its default
	. /lib/functions/network.sh
	network_get_physdev dev wan || network_get_device dev wan

	procd_open_instance
	procd_set_param command /usr/sbin/ucgfiber-lcd
	[ -n "$dev" ] && procd_append_param command -d "$dev"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

# look the device up again when wan comes up; a new device restarts the daemon
service_triggers() {
	procd_add_reload_interface_trigger wan
}
