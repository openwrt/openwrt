{
	"luci-app-display": {
		"description": "Grant access to display control",
		"read": {
			"file": {
				"/dev/fb0": [ "read" ],
				"/usr/sbin/display-control": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec", "read" ]
			},
			"uci": [ "display" ]
		},
		"write": {
			"file": {
				"/usr/sbin/display-control": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			},
			"uci": [ "display" ]
		}
	}
}
