From 5e9f34d6e75fb538ae039bd5117b5d6f24ed30e0 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Tue, 20 Oct 2026 23:08:27 +0000
Subject: [PATCH] powerpc: add complex type support for 32-bit SYSV

The 32-bit SYSV ABI passes and returns complex values in GPRs, never in
FPRs, even with hard float.  GCC does not split them for this ABI but
treats each one as a single item of as many words as it needs, and
those items follow the same rules as integers of the same size:

  - one word (_Complex char and short) like an int, right-justified;
  - two words (float and int _Complex) like long long: in an even/odd
    GPR pair (r3:r4, r5:r6, r7:r8, r9:r10), otherwise 8-byte aligned on
    the stack, and the remaining GPRs count as used;
  - more words (double and long long _Complex, four words) in
    consecutive GPRs with no pair alignment if they all fit, otherwise
    4-byte aligned on the stack, and every later argument goes to the
    stack too;
  - returned in r3, r3:r4 or r3-r6.

All of these already exist for soft-float long double (FFI_TYPE_UINT128)
and long long, so map complex types onto them by size in a new
translate_type(), used everywhere translate_float() was.

With a 128-bit long double, long double _Complex takes eight words: it
goes in r3-r10 when it is the first argument and on the stack otherwise,
and is returned in r3-r10.  Handle it as an internal FFI_TYPE_UINT256,
passed like FFI_TYPE_UINT128 with eight words, with a new
FLAG_RETURNS_256BITS that makes ffi_call_SYSV also store r7-r10, and a
PPC32_LD_R3R10 closure return entry.  The closure's return value area
is exactly 32 bytes.

A _Complex char is returned right-justified in r3, so ffi_call uses the
small struct bounce buffer for it and the closure helper shifts it into
place.  The ELFv2 handling of that bounce buffer for integer complex
types is now limited to powerpc64.

ffi_prep_types_sysv() resizes ffi_type_longdouble according to the abi;
keep ffi_type_complex_longdouble in step with it, as ffi_linux64.c does.

This matches GCC's code generation for 8548 (soft-float) and 464fp
(hard-float), with 64-bit long double (musl) and with
-mlong-double-128.
Assisted-by: LLM
Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 src/powerpc/ffi.c         |   2 +-
 src/powerpc/ffi_powerpc.h |  16 +++--
 src/powerpc/ffi_sysv.c    | 125 ++++++++++++++++++++++++++++++--------
 src/powerpc/ffitarget.h   |  11 +++-
 src/powerpc/ppc_closure.S |  11 ++++
 src/powerpc/sysv.S        |   5 ++
 6 files changed, 134 insertions(+), 36 deletions(-)

--- a/src/powerpc/ffi.c
+++ b/src/powerpc/ffi.c
@@ -114,7 +114,7 @@ ffi_call_int (ffi_cif *cif,
   if (rvalue && ecif.rvalue == smst_buffer)
     {
       unsigned int rsize = cif->rtype->size;
-#ifdef FFI_TARGET_HAS_COMPLEX_TYPE
+#if defined (FFI_TARGET_HAS_COMPLEX_TYPE) && defined (POWERPC64)
       /* Integer-typed _Complex: the .Lsmall_struct return path stored
 	 r3 at buffer offset 0 and r4 at offset 8.  Extract one inner-
 	 sized half from each slot — right-justified on BE, low-address
--- a/src/powerpc/ffi_powerpc.h
+++ b/src/powerpc/ffi_powerpc.h
@@ -54,6 +54,9 @@
 /* Needed for soft-float long-double. */
 #define PPC32_LD_R3R6		10
 
+/* Needed for _Complex long double with a 128-bit long double.  */
+#define PPC32_LD_R3R10		11
+
 /* Needed for FFI_SYSV small structure returns.  */
 #ifdef __LITTLE_ENDIAN__
 #define PPC32_SYSV_LD_STRUCT_3	PPC32_LD_R3
@@ -63,12 +66,12 @@
 #define PPC32_SYSV_LD_STRUCT_1	PPC_LD_U8
 #define PPC32_SYSV_LD_STRUCT_2	PPC_LD_U16
 #else
-#define PPC32_SYSV_LD_STRUCT_3	11
-#define PPC32_SYSV_LD_STRUCT_5	12
-#define PPC32_SYSV_LD_STRUCT_6	13
-#define PPC32_SYSV_LD_STRUCT_7	14
-#define PPC32_SYSV_LD_STRUCT_1	15
-#define PPC32_SYSV_LD_STRUCT_2	16
+#define PPC32_SYSV_LD_STRUCT_3	12
+#define PPC32_SYSV_LD_STRUCT_5	13
+#define PPC32_SYSV_LD_STRUCT_6	14
+#define PPC32_SYSV_LD_STRUCT_7	15
+#define PPC32_SYSV_LD_STRUCT_1	16
+#define PPC32_SYSV_LD_STRUCT_2	17
 #endif
 
 #else /* POWERPC64 */
@@ -116,6 +119,7 @@ enum {
   /* These go in cr6 */
   FLAG_RETURNS_64BITS   = 1 << (31-27),
   FLAG_RETURNS_128BITS  = 1 << (31-26),
+  FLAG_RETURNS_256BITS  = 1 << (31-25), /* Used by sysv code */
 
   FLAG_COMPAT           = 1 << (31- 8), /* Not used by assembly */
 
--- a/src/powerpc/ffi_sysv.c
+++ b/src/powerpc/ffi_sysv.c
@@ -42,6 +42,10 @@
 #define NUM_GPR_ARG_REGISTERS 8
 #define NUM_FPR_ARG_REGISTERS 8
 
+/* Internal type for an eight-word complex value, i.e. _Complex long double
+   with a 128-bit long double.  */
+#define FFI_TYPE_UINT256 (FFI_TYPE_LAST + 1)
+
 
 #if HAVE_LONG_DOUBLE_VARIANT && FFI_TYPE_LONGDOUBLE != FFI_TYPE_DOUBLE
 /* Adjust size of ffi_type_longdouble.  */
@@ -58,6 +62,12 @@ ffi_prep_types_sysv (ffi_abi abi)
       ffi_type_longdouble.size = 16;
       ffi_type_longdouble.alignment = 16;
     }
+#ifdef FFI_TARGET_HAS_COMPLEX_TYPE
+  /* _Complex long double is two halves of whatever long double just
+     became, so keep its size and alignment in step.  */
+  ffi_type_complex_longdouble.size = 2 * ffi_type_longdouble.size;
+  ffi_type_complex_longdouble.alignment = ffi_type_longdouble.alignment;
+#endif
 }
 #endif
 
@@ -89,6 +99,39 @@ translate_float (int abi, int type)
   return type;
 }
 
+/* Transform a type to the type that is passed and returned the same way.
+   Complex values always go in GPRs, never in FPRs, even with hard float:
+   GCC does not split them for this ABI but passes each one as a single
+   item of as many words as it needs, just like an integer of that size.  */
+static int
+translate_type (int abi, const ffi_type *t)
+{
+  if (t->type != FFI_TYPE_COMPLEX)
+    return translate_float (abi, t->type);
+
+  switch (t->size)
+    {
+    case 2:
+      /* _Complex char.  */
+      return FFI_TYPE_UINT16;
+    case 4:
+      /* _Complex short.  */
+      return FFI_TYPE_UINT32;
+    case 8:
+      /* float and int _Complex: two words, like long long.  */
+      return FFI_TYPE_UINT64;
+    case 16:
+      /* double, long long and 64-bit long double _Complex.  */
+      return FFI_TYPE_UINT128;
+    case 32:
+      /* 128-bit long double _Complex.  */
+      return FFI_TYPE_UINT256;
+    default:
+      FFI_ASSERT (0);
+      return FFI_TYPE_STRUCT;
+    }
+}
+
 /* Perform machine dependent cif processing */
 static ffi_status
 ffi_prep_cif_sysv_core (ffi_cif *cif)
@@ -121,7 +164,7 @@ ffi_prep_cif_sysv_core (ffi_cif *cif)
      - long doubles (if not equivalent to double) are returned in
      fpr1,fpr2 for Linux and as for large structs for SysV.  */
 
-  type = translate_float (cif->abi, type);
+  type = translate_type (cif->abi, cif->rtype);
 
   switch (type)
     {
@@ -140,6 +183,9 @@ ffi_prep_cif_sysv_core (ffi_cif *cif)
 #endif
       break;
 
+    case FFI_TYPE_UINT256:
+      flags |= FLAG_RETURNS_256BITS;
+      /* Fall through.  */
     case FFI_TYPE_UINT128:
       flags |= FLAG_RETURNS_128BITS;
       /* Fall through.  */
@@ -148,6 +194,13 @@ ffi_prep_cif_sysv_core (ffi_cif *cif)
       flags |= FLAG_RETURNS_64BITS;
       break;
 
+    case FFI_TYPE_UINT16:
+      /* A _Complex char is returned right-justified in r3, like a small
+	 struct.  Use the small struct bounce buffer to extract it.  */
+      if (cif->rtype->type == FFI_TYPE_COMPLEX)
+	flags |= FLAG_RETURNS_SMST;
+      break;
+
     case FFI_TYPE_STRUCT:
       /* The final SYSV ABI says that structures smaller or equal 8 bytes
 	 are returned in r3/r4.  A draft ABI used by linux instead
@@ -176,9 +229,8 @@ ffi_prep_cif_sysv_core (ffi_cif *cif)
      Stuff on the stack needs to keep proper alignment.  */
   for (ptr = cif->arg_types, i = cif->nargs; i > 0; i--, ptr++)
     {
-      unsigned short typenum = (*ptr)->type;
-
-      typenum = translate_float (cif->abi, typenum);
+      unsigned short typenum = translate_type (cif->abi, *ptr);
+      unsigned nwords;
 
       switch (typenum)
 	{
@@ -224,16 +276,19 @@ ffi_prep_cif_sysv_core (ffi_cif *cif)
 #endif
 	  break;
 
+	case FFI_TYPE_UINT256:
 	case FFI_TYPE_UINT128:
 	  /* A long double in FFI_LINUX_SOFT_FLOAT can use only a set
 	     of four consecutive gprs. If we do not have enough, we
-	     have to adjust the gpr_count value.  */
-	  if (gpr_count >= NUM_GPR_ARG_REGISTERS - 3)
+	     have to adjust the gpr_count value.  Complex values of four
+	     or eight words are passed the same way.  */
+	  nwords = typenum == FFI_TYPE_UINT256 ? 8 : 4;
+	  if (gpr_count > NUM_GPR_ARG_REGISTERS - nwords)
 	    gpr_count = NUM_GPR_ARG_REGISTERS;
 	  if (gpr_count >= NUM_GPR_ARG_REGISTERS)
-	    stack_count += 4;
+	    stack_count += nwords;
 	  else
-	    gpr_count += 4;
+	    gpr_count += nwords;
 	  break;
 
 	case FFI_TYPE_UINT64:
@@ -458,9 +513,8 @@ ffi_prep_args_SYSV (extended_cif *ecif,
        i > 0;
        i--, ptr++, p_argv.v++)
     {
-      unsigned int typenum = (*ptr)->type;
-
-      typenum = translate_float (ecif->cif->abi, typenum);
+      unsigned int typenum = translate_type (ecif->cif->abi, *ptr);
+      unsigned int ii, nwords;
 
       /* Now test the translated value */
       switch (typenum)
@@ -518,16 +572,18 @@ ffi_prep_args_SYSV (extended_cif *ecif,
 	  break;
 #endif /* have FPRs */
 
+	case FFI_TYPE_UINT256:
 	case FFI_TYPE_UINT128:
 	  /* The soft float ABI for long doubles works like this, a long double
 	     is passed in four consecutive GPRs if available.  A maximum of 2
 	     long doubles can be passed in gprs.  If we do not have 4 GPRs
-	     left, the long double is passed on the stack, 4-byte aligned.  */
-	  if (gpr_base.u >= gpr_end.u - 3)
+	     left, the long double is passed on the stack, 4-byte aligned.
+	     Complex values of four or eight words are passed the same way.  */
+	  nwords = typenum == FFI_TYPE_UINT256 ? 8 : 4;
+	  if (gpr_base.u > gpr_end.u - nwords)
 	    {
-	      unsigned int ii;
 	      gpr_base.u = gpr_end.u;
-	      for (ii = 0; ii < 4; ii++)
+	      for (ii = 0; ii < nwords; ii++)
 		{
 		  unsigned int int_tmp = (*p_argv.ui)[ii];
 		  *next_arg.u++ = int_tmp;
@@ -535,8 +591,7 @@ ffi_prep_args_SYSV (extended_cif *ecif,
 	    }
 	  else
 	    {
-	      unsigned int ii;
-	      for (ii = 0; ii < 4; ii++)
+	      for (ii = 0; ii < nwords; ii++)
 		{
 		  unsigned int int_tmp = (*p_argv.ui)[ii];
 		  *gpr_base.u++ = int_tmp;
@@ -709,7 +764,7 @@ ffi_closure_helper_SYSV (ffi_cif *cif,
   avalue = alloca (cif->nargs * sizeof (void *));
 
   /* First translate for softfloat/nonlinux */
-  rtypenum = translate_float (cif->abi, rtypenum);
+  rtypenum = translate_type (cif->abi, cif->rtype);
 
   /* Copy the caller's structure return value address so that the closure
      returns the data directly to the caller.
@@ -729,10 +784,9 @@ ffi_closure_helper_SYSV (ffi_cif *cif,
 
   /* Grab the addresses of the arguments from the stack frame.  */
   while (i < avn) {
-    unsigned short typenum = arg_types[i]->type;
-
     /* We may need to handle some values depending on ABI.  */
-    typenum = translate_float (cif->abi, typenum);
+    unsigned short typenum = translate_type (cif->abi, arg_types[i]);
+    long nwords;
 
     switch (typenum)
       {
@@ -796,20 +850,23 @@ ffi_closure_helper_SYSV (ffi_cif *cif,
 # endif
 #endif
 
+      case FFI_TYPE_UINT256:
       case FFI_TYPE_UINT128:
 	/* Test if for the whole long double, 4 gprs are available.
-	   otherwise the stuff ends up on the stack.  */
-	if (ng < NUM_GPR_ARG_REGISTERS - 3)
+	   otherwise the stuff ends up on the stack.  The same holds
+	   for complex values of four or eight words.  */
+	nwords = typenum == FFI_TYPE_UINT256 ? 8 : 4;
+	if (ng <= NUM_GPR_ARG_REGISTERS - nwords)
 	  {
 	    avalue[i] = pgr;
-	    pgr += 4;
-	    ng += 4;
+	    pgr += nwords;
+	    ng += nwords;
 	  }
 	else
 	  {
 	    avalue[i] = pst;
-	    pst += 4;
-	    ng = 8+4;
+	    pst += nwords;
+	    ng = NUM_GPR_ARG_REGISTERS;
 	  }
 	break;
 
@@ -940,6 +997,18 @@ ffi_closure_helper_SYSV (ffi_cif *cif,
     case FFI_TYPE_SINT8:
       return PPC_LD_S8;
     case FFI_TYPE_UINT16:
+      if (cif->rtype->type == FFI_TYPE_COMPLEX)
+	{
+	  /* A _Complex char is returned right-justified in r3.  */
+	  unsigned int word = 0;
+#ifdef __LITTLE_ENDIAN__
+	  memcpy (&word, rvalue, 2);
+#else
+	  memcpy ((char *) &word + 2, rvalue, 2);
+#endif
+	  *(unsigned int *) rvalue = word;
+	  return PPC_LD_U32;
+	}
       return PPC_LD_U16;
     case FFI_TYPE_SINT16:
       return PPC_LD_S16;
@@ -955,6 +1024,8 @@ ffi_closure_helper_SYSV (ffi_cif *cif,
       return PPC_LD_I64;
     case FFI_TYPE_UINT128:
       return PPC32_LD_R3R6;
+    case FFI_TYPE_UINT256:
+      return PPC32_LD_R3R10;
     case FFI_TYPE_STRUCT:
       if (cif->abi & FFI_SYSV_STRUCT_RET)
 	switch (size)
--- a/src/powerpc/ffitarget.h
+++ b/src/powerpc/ffitarget.h
@@ -155,8 +155,15 @@ typedef enum ffi_abi {
    ELFv2, float/double _Complex are passed and returned as a 2-element
    homogeneous floating-point aggregate, but each scalar half consumes a
    GPR shadow slot of its own — i.e. the same way the underlying C ABI
-   handles them, which is what GCC's split_complex_arg emits.  */
-#if defined(POWERPC64) && _CALL_ELF == 2
+   handles them, which is what GCC's split_complex_arg emits.
+
+   They are also supported on 32-bit SYSV, where complex values are passed
+   and returned in GPRs like integers of the same size.  */
+#if defined(POWERPC64)
+# if _CALL_ELF == 2
+#  define FFI_TARGET_HAS_COMPLEX_TYPE
+# endif
+#elif defined (POWERPC) || defined (POWERPC_FREEBSD)
 # define FFI_TARGET_HAS_COMPLEX_TYPE
 #endif
 
--- a/src/powerpc/ppc_closure.S
+++ b/src/powerpc/ppc_closure.S
@@ -202,10 +202,17 @@ E PPC_LD_S16
 	epilogue
 
 E PPC32_LD_R3R6
+.Lr3r6:
 	lwz %r5,112+8(%r1)
 	lwz %r6,112+12(%r1)
 	b .Lr3r4
 
+E PPC32_LD_R3R10
+	lwz %r7,112+16(%r1)
+	lwz %r8,112+20(%r1)
+	lwz %r9,112+24(%r1)
+	b .Lr3r10
+
 #ifndef __LITTLE_ENDIAN__
 E PPC32_SYSV_LD_STRUCT_3
 	lwz %r3,112+0(%r1)
@@ -247,6 +254,10 @@ E PPC32_SYSV_LD_STRUCT_2
 	epilogue
 #endif
 
+.Lr3r10:
+	lwz %r10,112+28(%r1)
+	b .Lr3r6
+
 	.cfi_endproc
 END(ffi_closure_SYSV)
 
--- a/src/powerpc/sysv.S
+++ b/src/powerpc/sysv.S
@@ -116,6 +116,11 @@ ENTRY(ffi_call_SYSV)
 	bf	26,L(done_return_value)
 	stw     %r5,8(%r30)
 	stw	%r6,12(%r30)
+	bf	25,L(done_return_value)
+	stw	%r7,16(%r30)
+	stw	%r8,20(%r30)
+	stw	%r9,24(%r30)
+	stw	%r10,28(%r30)
 	/* Fall through...  */
 
 L(done_return_value):
