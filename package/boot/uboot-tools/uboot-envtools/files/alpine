[ -e /etc/config/ubootenv ] && exit 0

touch /etc/config/ubootenv

. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

case "$board" in
checkpoint,l-71)
	ubootenv_add_uci_config "/dev/mtd1" "0x0" "0x8000" "0x40000" "1"
	ubootenv_add_uci_config "/dev/mtd1" "0x40000" "0x8000" "0x40000" "1"
	;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config ubootenv

exit 0
