#
# Drop the u-boot environment configuration on boards that ship with a blank
# environment region. U-Boot on these boards runs its compiled-in environment
# while the region is erased; the first fw_setenv writes the generic
# uboot-envtools environment with a valid CRC, which lacks the boot command
# the bootloader needs, and the board no longer boots.
#
# 30_uboot-envtools returns early when /etc/config/ubootenv already exists,
# and both that file and /etc/fw_env.config are conffiles kept across
# sysupgrade, so dropping these boards from the generator only protects fresh
# installs. This removes the configuration from systems already carrying it.
#
# The removal is gated on the region actually reading blank, so an environment
# deliberately written from the u-boot console is left alone.
#

. /lib/functions.sh

board=$(board_name)

case "$board" in
asus,4g-ax56|asus,rt-ax53u|asus,rt-ax54)
	;;
*)
	exit 0
	;;
esac

[ -f /etc/config/ubootenv ] || exit 0

ubootenv_is_blank() {
	local dev="$1"
	local offset="$2"
	local envsize="$3"

	[ -e "$dev" ] || return 1
	[ -n "$offset" ] && [ -n "$envsize" ] || return 1

	offset=$((offset))
	envsize=$((envsize))

	[ "$envsize" -gt 0 ] || return 1
	[ $((offset % envsize)) -eq 0 ] || return 1

	# A failed or short read produces an empty pipeline, which is
	# indistinguishable from an erased region. Require the full envsize
	# before concluding anything, so a read error falls through to "not
	# blank" and leaves a deliberately written environment alone.
	[ "$(dd if="$dev" bs="$envsize" skip=$((offset / envsize)) count=1 \
		2>/dev/null | wc -c)" = "$envsize" ] || return 1

	[ "$(dd if="$dev" bs="$envsize" skip=$((offset / envsize)) count=1 \
		2>/dev/null | tr -d '\377' | wc -c)" = "0" ]
}

ubootenv_drop_blank() {
	local cfg="$1"
	local dev offset envsize

	config_get dev "$cfg" dev
	config_get offset "$cfg" offset
	config_get envsize "$cfg" envsize

	ubootenv_is_blank "$dev" "$offset" "$envsize" || return 0

	uci -q delete "ubootenv.$cfg"
	[ -f /etc/fw_env.config ] && \
		sed -i "\|^[[:space:]]*${dev}[[:space:]]*${offset}|d" /etc/fw_env.config

	changed=1
}

changed=0

config_load ubootenv
config_foreach ubootenv_drop_blank ubootenv

[ "$changed" = "1" ] && uci -q commit ubootenv

exit 0
