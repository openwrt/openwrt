 plat/microchip/lan969x/common/common.mk |  4 +-
 plat/microchip/scripts/html_inline.py   | 73 +++++++++++++++++++++++++
 plat/microchip/scripts/html_inline.rb   | 60 --------------------
 plat/microchip/scripts/mkjs.py          | 30 ++++++++++
 plat/microchip/scripts/mkjs.rb          | 28 ----------
 6 files changed, 107 insertions(+), 92 deletions(-)
 create mode 100755 plat/microchip/scripts/html_inline.py
 delete mode 100755 plat/microchip/scripts/html_inline.rb
 create mode 100755 plat/microchip/scripts/mkjs.py
 delete mode 100755 plat/microchip/scripts/mkjs.rb

