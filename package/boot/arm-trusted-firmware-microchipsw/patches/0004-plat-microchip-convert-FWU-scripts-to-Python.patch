diff --git a/plat/microchip/scripts/html_inline.py b/plat/microchip/scripts/html_inline.py
new file mode 100755
index 000000000..b6d065ea7
--- /dev/null
+++ b/plat/microchip/scripts/html_inline.py
@@ -0,0 +1,73 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+
+"""Inline JavaScript, stylesheets, and images into an HTML document."""
+
+import argparse
+import base64
+import re
+from pathlib import Path
+
+
+SCRIPT_RE = re.compile(r'<script src="([^"]+)"></script>')
+HREF_RE = re.compile(r'href="([^"]+)"')
+SRC_RE = re.compile(r'src="([^"]+)"')
+
+
+def inline_file(tag: str, path: Path) -> None:
+    print(f"<{tag}>")
+    with path.open(encoding="utf-8", newline="") as source:
+        for line in source:
+            print(line, end="" if line.endswith(("\n", "\r")) else "\n")
+    print(f"</{tag}>")
+
+
+def inline_pic(path: Path) -> str:
+    image_type = path.suffix.lower().lstrip(".")
+    encoded = base64.b64encode(path.read_bytes()).decode("ascii")
+    data = "\n".join(encoded[start:start + 60]
+                     for start in range(0, len(encoded), 60)) + "\n"
+    return f"data:image/{image_type};base64,{data}"
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("-i", "--include", dest="incdir", type=Path,
+                        help="Use include dir")
+    parser.add_argument("html_input", type=Path)
+    args = parser.parse_args()
+
+    if not args.html_input.is_file():
+        parser.error(f"cannot read '{args.html_input}'")
+
+    input_path = args.html_input.resolve()
+    input_dir = input_path.parent
+
+    with input_path.open(encoding="utf-8", newline="") as html:
+        for line in html:
+            script = SCRIPT_RE.search(line)
+            if script:
+                source = input_dir / script.group(1)
+                if args.incdir:
+                    include_source = args.incdir / script.group(1)
+                    if include_source.exists():
+                        source = include_source
+                inline_file("script", source)
+                continue
+
+            href = HREF_RE.search(line) if "<link" in line else None
+            if href:
+                inline_file("style", input_dir / href.group(1))
+                continue
+
+            src = SRC_RE.search(line) if "<img" in line else None
+            if src:
+                data = inline_pic(input_dir / src.group(1))
+                print(line.replace(src.group(0), f'src="{data}"'), end="")
+                continue
+
+            print(line, end="")
+
+
+if __name__ == "__main__":
+    main()
