diff --git a/plat/microchip/scripts/mkjs.py b/plat/microchip/scripts/mkjs.py
new file mode 100755
index 000000000..5b0b42ee0
--- /dev/null
+++ b/plat/microchip/scripts/mkjs.py
@@ -0,0 +1,30 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+
+"""Generate the JavaScript payload used by the firmware-update HTML page."""
+
+import argparse
+import base64
+from pathlib import Path
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("-p", "--platform", default="lan966x_b0",
+                        help="Build for given platform")
+    parser.add_argument("-o", "--output", required=True, help="Output file")
+    parser.add_argument("fwu_fips", nargs="*", help="Firmware-update FIP files")
+    args = parser.parse_args()
+
+    with Path(args.output).open("w", encoding="utf-8") as output:
+        output.write(f'const bl2u_platform = "{args.platform}";\n')
+        output.write("const bl2u_app = [\n")
+        for fwu_fip in args.fwu_fips:
+            encoded = base64.b64encode(Path(fwu_fip).read_bytes()).decode("ascii")
+            for start in range(0, len(encoded), 60):
+                output.write(f'\t"{encoded[start:start + 60]}",\n')
+        output.write("]\n")
+
+
+if __name__ == "__main__":
+    main()
