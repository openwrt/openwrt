+	const volatile u8 *src =
+		(const volatile u8 *)(CONFIG_TPL_TEXT_BASE +
+				      ECONET_DDR_BLOB_OFFSET);
+	volatile u8 *dst = (volatile u8 *)ECONET_DDR_BLOB_ADDR;
+	u32 i;
+
+	for (i = 0; i < ECONET_DDR_BLOB_SIZE; i++)
+		dst[i] = src[i];
+
+	__asm__ volatile("sync" : : : "memory");
