 		filename = "u-boot-en7512.bin";
 		pad-byte = <0xff>;
+		size = <0x00100000>;
 
 		u-boot-tpl {
 			offset = <0x00000000>;
@@ -42,13 +43,15 @@
 			size = <0x00004f70>;
 		};
 
+		/* 0xff00..0xffff is the 128 KiB TCBoot manufacturing block. */
 		spl {
 			type = "blob";
