@@ -13,40 +13,124 @@
 #define ECONET_UART0_BASE		0xbfbf0000
 #define ECONET_TIMER_BASE		0xbfbf0100
 
+/* Vendor TCBoot geometries used by the MIPS internal-ROM boot path. */
+#define ECONET_TCBOOT_128K_SIZE	0x00020000
+#define ECONET_TCBOOT_256K_SIZE	0x00040000
+#define ECONET_BOOT_IMAGE_SIZE		0x00100000
+#define ECONET_TCBOOT_CRC1_OFFSET	0x0001fffc
+#define ECONET_TCBOOT_CRC2_OFFSET	0x0003fdfc
+#define ECONET_TCBOOT_MINFO_128_OFFSET	0x0000ff00
+#define ECONET_TCBOOT_MINFO_128_SIZE	0x00000100
+#define ECONET_TCBOOT_MINFO_256_OFFSET	0x0003fe00
+#define ECONET_TCBOOT_MINFO_256_SIZE	0x00000200
+#define ECONET_TCBOOT_MAGIC_BE_256	0x0000ffb0
+#define ECONET_TCBOOT_MAGIC_LE		0x0001fff8
+#define ECONET_TCBOOT_MAGIC_MINFO_256	0x0003feb0
+#define ECONET_TCBOOT_ECC_INFO		0x00040010
+
 #define ECONET_RESET_CONTROL		(ECONET_SYSCTL_BASE + 0x040)
 #define ECONET_FE_SRAM_SEL		(ECONET_SYSCTL_BASE + 0x958)
 #define ECONET_SCREG_WR0		(ECONET_SYSCTL_BASE + 0x280)
 #define ECONET_REG_SAVE_INFO		(ECONET_SYSCTL_BASE + 0x284)
 
-#define ECONET_TPL_STACK_ADDR		(ECONET_FE_SRAM_BASE + 0xbff0)
-#define ECONET_TPL_SAVED_SP		(ECONET_FE_SRAM_BASE + 0xbffc)
 #define ECONET_SPL_HEADER_ADDR		(ECONET_FE_SRAM_BASE + 0x40)
 
 #if defined(CONFIG_TARGET_EN751221)
 #include <mach/en751221.h>
 #define ECONET_DDR_BLOB_ADDR		EN7512_DDR_BLOB_ADDR
+#define ECONET_DDR_BLOB_ENTRY		EN7512_DDR_BLOB_ENTRY
 #define ECONET_DDR_BLOB_OFFSET		EN7512_DDR_BLOB_OFFSET
 #define ECONET_DDR_BLOB_SIZE		EN7512_DDR_BLOB_SIZE
 #define ECONET_SPL_IMAGE_OFFSET		EN7512_SPL_IMAGE_OFFSET
 #define ECONET_UBOOT_IMAGE_OFFSET	EN7512_UBOOT_IMAGE_OFFSET
-#elif defined(CONFIG_TARGET_EN751627) || defined(CONFIG_TARGET_EN7528)
+#define ECONET_TPL_STACK_ADDR		EN7512_TPL_STACK_ADDR
+#define ECONET_TPL_SAVED_SP		EN7512_TPL_SAVED_SP
+/* Match the older EN751221 image observed on the Nokia G-240G-E. */
+#define ECONET_TCBOOT_SIZE		ECONET_TCBOOT_128K_SIZE
+#define ECONET_TCBOOT_HEADER_LEN	0x00000000
+#define ECONET_SPL_IMAGE_LIMIT		ECONET_TCBOOT_CRC1_OFFSET
+#define ECONET_TCBOOT_CHIP_FLASH_INFO	0x00000000
+#define ECONET_TCBOOT_WORD28		0x00000000
+#define ECONET_TCBOOT_WORD2C		0x00000000
+#elif defined(CONFIG_TARGET_EN751627)
+#include <mach/en751627.h>
+#define ECONET_DDR_BLOB_ADDR		EN751627_DDR_BLOB_ADDR
+#define ECONET_DDR_BLOB_ENTRY		EN751627_DDR_BLOB_ENTRY
+#define ECONET_DDR_BLOB_OFFSET		EN751627_DDR_BLOB_OFFSET
+#define ECONET_DDR_BLOB_SIZE		EN751627_DDR_BLOB_SIZE
+#define ECONET_SPL_IMAGE_OFFSET		EN751627_SPL_IMAGE_OFFSET
+#define ECONET_UBOOT_IMAGE_OFFSET	EN751627_UBOOT_IMAGE_OFFSET
+#define ECONET_TPL_STACK_ADDR		EN751627_TPL_STACK_ADDR
