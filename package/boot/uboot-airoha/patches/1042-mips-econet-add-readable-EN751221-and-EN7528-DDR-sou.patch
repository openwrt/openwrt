 "$objcopy" -O binary "$build/ddr.elf" "$out.tmp"
 mv -f "$out.tmp" "$out"
 
+if [ -n "${ddr_variant:-}" ]; then
+ printf 'EN7528 DDR: %s (%s bytes)\n' "$ddr_variant" "$(wc -c < "$out")" >&2
+fi
