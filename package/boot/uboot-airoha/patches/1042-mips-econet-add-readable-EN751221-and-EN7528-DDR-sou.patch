+  # The EN7528 V1.8 DDR stage is now fully readable C.  The complete path
+  # (system/eFuse setup, MEMPLL, DRAMC init and all training stages) has
+  # completed a standalone SRAM training run on EN7528HU/QFP DDR3.
+  no_reconstructed=1
