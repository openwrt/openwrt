   mtd erase ubi && ubi part ubi && \
-  ubi create ubootenv 0x1f000 && ubi create ubootenv2 0x1f000 && \
+  ubi create ubootenv 0x40000 static && \
+  ubi create ubootenv2 0x40000 static && \
   ubi create art 0x400000 && ubi write 0x89400000 art 0x400000
 
