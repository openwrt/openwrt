diff --git a/defenvs/en7523-askey_rtf8225vw_env b/defenvs/en7523-askey_rtf8225vw_env
index 8500895a8d1..5c69ecbf030 100644
--- a/defenvs/en7523-askey_rtf8225vw_env
+++ b/defenvs/en7523-askey_rtf8225vw_env
@@ -23,10 +23,10 @@ format_ubi_part=\
   mtd read spi-nand0 0x89480000 0x6dc0000 0x240000 && \
   \
   mtd erase ubi && ubi part ubi && \
-  ubi create ubootenv 0x40000 && \
-  ubi create ubootenv2 0x40000 && \
-  ubi create art 0x400000 && ubi write 0x89480000 art 0x400000 && \
-  (env import -b 0x89400000 0x040000 ethaddr asp_gpon_sn asp_gpon_pw || env import -b 0x89440000 0x040000 ethaddr asp_gpon_sn asp_gpon_pw) && \
+  ubi create ubootenv 0x40000 static && \
+  ubi create ubootenv2 0x40000 static && \
+  ubi create art 0x400000 static && ubi write 0x89480000 art 0x400000 static && \
+  (env import -b 0x89400000 0x040000 ethaddr asp_gpon_sn || env import -b 0x89440000 0x040000 ethaddr asp_gpon_sn) && \
   saveenv && saveenv && run upgrade_uboot
 
 bootcmd=run boot_ubi
diff --git a/defenvs/en7523-mitrastar_gpt-2742gx4x5v6_env b/defenvs/en7523-mitrastar_gpt-2742gx4x5v6_env
