+++ b/defenvs/en7523-mitrastar_gpt-2742gx4x5v6_env
@@ -22,8 +22,8 @@ format_ubi_part=\
   mtd read spi-nand0 0x89640000 0x005f800 0x00044e && \
   \
   mtd erase ubi && ubi part ubi && \
-  ubi create ubootenv 0x40000 && \
-  ubi create ubootenv2 0x40000 && \
+  ubi create ubootenv 0x40000 static && \
+  ubi create ubootenv2 0x40000 static && \
   ubi create art 0x240000 && ubi write 0x89400000 art 0x240000 && \
   setenv ethaddr && bin2mac ethaddr 0x89640448 0x6 && \
   saveenv && saveenv && run upgrade_uboot
