 format_ubi_part=\
   mtd read spi-nand0 0x89400000 0xa0000 $art_size && \
   mtd erase ubi && ubi part ubi && \
-  ubi create ubootenv 0x1f000 && \
-  ubi create ubootenv2 0x1f000 && \
+  ubi create ubootenv 0x40000 static && \
+  ubi create ubootenv2 0x40000 static && \
   ubi create art $art_size && ubi write 0x89400000 art $art_size && \
   run upgrade_uboot
 
