diff --git a/defenvs/en7523-tplink-xx230v_v1_env b/defenvs/en7523-tplink-xx230v_v1_env
new file mode 100644
index 00000000000..37f4b64c3a6
--- /dev/null
+++ b/defenvs/en7523-tplink-xx230v_v1_env
@@ -0,0 +1,33 @@
+loadaddr=0x86a00000
+ipaddr=192.168.1.1
+serverip=192.168.1.10
+bootled_pwr=green:power
+
+bootconf=config-1
+bootfile=openwrt-airoha-en7523-tplink_xx230v-v1-initramfs-kernel.bin
+
+boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
+ubi_read_openwrt=ubi read $loadaddr fit && iminfo $loadaddr
+
+boot_openwrt=led $bootled_pwr on ; run ubi_read_openwrt && bootm $loadaddr#$bootconf ; led $bootled_pwr off
+boot_ubi=ubi part ubi && run boot_openwrt
+
+format_ubi_part=mtd read spi-nand0 $loadaddr 0xa0000 $art_size && \
+  mtd erase ubi && ubi part ubi && \
+  ubi create ubootenv 0x1f000 && ubi create ubootenv2 0x1f000 && \
+  ubi create art $art_size && ubi write $loadaddr art $art_size
+
+xx230_ubi_part=setenv art_size 0x100000 && run format_ubi_part
+xx530_ubi_part=setenv art_size 0x200000 && run format_ubi_part
+
+bootcmd=run boot_ubi
+bootdelay=3
+bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 20
+bootmenu_default=0
+bootmenu_delay=3
+bootmenu_title=      34m( ( ( mOpenWrt34m ) ) )
+bootmenu_0=Run default boot command.=run boot_openwrt
+bootmenu_1=Boot system via TFTP.=run boot_tftp ; run bootmenu_confirm_return
+bootmenu_2=Format UBI partition for xx230v.=run xx230_ubi_part
+bootmenu_3=Format UBI partition for xx530v.=run xx530_ubi_part
+bootmenu_5=Reboot.=reset
diff --git a/dts/upstream/src/arm/airoha/en7523-tplink-xx230v_v1.dts b/dts/upstream/src/arm/airoha/en7523-tplink-xx230v_v1.dts
new file mode 100644
index 00000000000..c1c4bd45e7d
--- /dev/null
+++ b/dts/upstream/src/arm/airoha/en7523-tplink-xx230v_v1.dts
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/dts-v1/;
+
+/* Bootloader installs ATF here */
+/memreserve/ 0x80000000 0x200000;
+
+#include <dt-bindings/input/linux-event-codes.h>
+#include "en7523.dtsi"
+
+/ {
+	model = "TP-Link xx230v/xx530v v1";
+	compatible = "airoha,en7523-xx230v-v1", "airoha,en7523";
+
+	aliases {
+		serial0 = &uart1;
+	};
+
+	chosen {
+		bootargs = "console=ttyS0,115200 earlycon";
+		stdout-path = "serial0:115200n8";
+		linux,usable-memory-range = <0x80200000 0x1fe00000>;
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x10000000>;
+	};
+
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <100>;
+
+		reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+			debounce-interval = <60>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		// Power
+		led@0 {
+			label = "green:power";
+			gpios = <&pinctrl 11 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		// xPON
+		led@1 {
+			label = "green:xpon";
+			gpios = <&pinctrl 10 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		// internet
+		led@3 {
+			label = "green:inet";
+			gpios = <&pinctrl 1 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		// Wireless
+		led@4 {
+			label = "green:wlan";
+			gpios = <&pinctrl 6 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		// Phone
+		led@5 {
+			label = "green:phone";
+			gpios = <&pinctrl 5 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		// LOS
+		led@2 {
+			label = "red:los";
+			gpios = <&pinctrl 3 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+};
+
+&pinctrl {
+	status = "okay";
+};
+
+&pcie1 {
+	status = "okay";
+};
+
+&snfi {
+	status = "okay";
+};
+
+&eth {
+	status = "okay";
+};
+
+&gdm1 {
+	status = "okay";
+};
+
+&spi_nand {
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0 {
+			label = "u-boot";
+			reg = <0x00000000 0x00100000>;
+		};
+
+		partition@100000 {
+			label = "ubi";
+			reg = <0x00100000 0x08000000>;
+		};
+	};
+};
