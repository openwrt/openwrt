-{
-	char buf[11];
-	int i = sizeof(buf);
-
-	buf[--i] = '\0';
-	do {
-		buf[--i] = '0' + val % 10;
-		val /= 10;
-	} while (val && i);
-	prom_puts(&buf[i]);
