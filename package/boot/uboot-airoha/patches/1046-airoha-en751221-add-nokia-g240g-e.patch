diff --git a/arch/mips/dts/Makefile b/arch/mips/dts/Makefile
index 3bb66dbd666..0e5f636fc2e 100644
--- a/arch/mips/dts/Makefile
+++ b/arch/mips/dts/Makefile
@@ -10,6 +10,7 @@ dtb-$(CONFIG_TARGET_EN751221) += econet,en751221-reference.dtb
 dtb-$(CONFIG_TARGET_EN751627) += econet,en751627-reference.dtb
 dtb-$(CONFIG_TARGET_EN7528) += \
 	econet,en7528-reference.dtb \
+	econet,en751221-nokia_g240g-e.dts \
 	econet,en7528-tplink-xc220-g3v.dtb
 dtb-$(CONFIG_TARGET_EN7580) += econet,en7580-xgz030.dtb
 dtb-$(CONFIG_BOARD_BROADCOM_BCM968380GERG) += brcm,bcm968380gerg.dtb
diff --git a/arch/mips/dts/econet,en751221-nokia_g240g-e.dts b/arch/mips/dts/econet,en751221-nokia_g240g-e.dts
new file mode 100644
index 00000000000..146a12dc24a
--- /dev/null
+++ b/arch/mips/dts/econet,en751221-nokia_g240g-e.dts
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0+
+/dts-v1/;
+
+#include "econet,en751221.dtsi"
+
+/ {
+	model = "Airoha EN751221 reference board";
+	compatible = "econet,en751221-reference", "econet,en751221";
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
+			debounce-interval = <60>;
+		};
+
+		wps5 {
+			label = "led";
+			linux,code = <BTN_0>;
+			gpios = <&pinctrl 5 GPIO_ACTIVE_LOW>;
+			debounce-interval = <60>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		/* Power Green */
+		power_green: led@6 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+			function-enumerator = <6>;
+			gpios = <&pinctrl 6 GPIO_ACTIVE_LOW>;
+		};
+
+		/* Power Red */
+		power_red: led@9 {
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_STATUS;
+			function-enumerator = <9>;
+			gpios = <&pinctrl 9 GPIO_ACTIVE_LOW>;
+		};
+
+		/* xPON/Internet */
+		pon_led: led@2 {
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_STATUS;
+			function-enumerator = <2>;
+			gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
+		};
+
+		/* USB */
+		led@11 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_USB;
+			function-enumerator = <11>;
+			gpios = <&pinctrl 11 GPIO_ACTIVE_LOW>;
+		};
+
+		/* AUTH */
+		pon_los: led@24 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+			function-enumerator = <24>;
+			gpios = <&pinctrl 24 GPIO_ACTIVE_LOW>;
+		};
+
+		/* FXS1 */
+		led@25 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+			function-enumerator = <25>;
+			gpios = <&pinctrl 25 GPIO_ACTIVE_LOW>;
+		};
+
+		/* FXS2 */
+		led@26 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+			function-enumerator = <26>;
+			gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
+		};
+
+		/* Internet */
+		led@28 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+			function-enumerator = <28>;
+			gpios = <&pinctrl 28 GPIO_ACTIVE_LOW>;
+		};
+
+		/* VoIP */
+		led@29 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+			function-enumerator = <29>;
+			gpios = <&pinctrl 29 GPIO_ACTIVE_LOW>;
+		};
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&eth {
+	status = "okay";
+};
+
+&gdm1 {
+	status = "okay";
+};
+
+&switch0 {
+	status = "okay";
+};
+
+
+&spi0 {
+	status = "okay";
+
+	nand: nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+	
+			partition@0 {
+				label = "u-boot";
+				reg = <0x000000 0x100000>;
+			};
+	
+			partition@100000 {
+				label = "ubi";
+				reg = <0x100000 0x000000>;
+			};
+		};
+	};
+};
\ No newline at end of file
diff --git a/arch/mips/dts/econet,en751221-reference-u-boot.dtsi b/arch/mips/dts/econet,en751221-reference-u-boot.dtsi
index 3aef9c82e84..c785884d3e9 100644
--- a/arch/mips/dts/econet,en751221-reference-u-boot.dtsi
+++ b/arch/mips/dts/econet,en751221-reference-u-boot.dtsi
@@ -1,61 +1,5 @@
 // SPDX-License-Identifier: GPL-2.0+
-#include <linux/stringify.h>
-
-/ {
-	binman: binman {
-		multiple-images;
-	};
-};
 
 &uart0 {
 	bootph-all;
 };
-
-&binman {
-	spl-img {
-		filename = "u-boot-spl.img";
-
-		mkimage {
-			args = "-A", "mips", "-T", "standalone", "-O", "u-boot",
-			       "-C", "none", "-n", "EN7512 U-Boot SPL",
-			       "-a", __stringify(CONFIG_SPL_TEXT_BASE),
-			       "-e", __stringify(CONFIG_SPL_TEXT_BASE);
-
-			u-boot-spl {
-			};
-		};
-	};
-
-	en7512-uboot {
-		filename = "u-boot-en7512.bin";
-		pad-byte = <0xff>;
-		size = <0x00100000>;
-
-		u-boot-tpl {
-			offset = <0x00000000>;
-			size = <0x00008000>;
-		};
-
-		ddr-blob {
-			type = "blob";
-			filename = "en751221_ddr.bin";
-			offset = <0x00008000>;
-			size = <0x00004f70>;
-		};
-
-		/* 0xff00..0xffff is the 128 KiB TCBoot manufacturing block. */
-		spl {
-			type = "blob";
-			filename = "u-boot-spl.img";
-			offset = <0x00010000>;
-			size = <0x0000fffc>;
-		};
-
-		/* CRC32 at 0x1fffc is filled by econet_tcboot_image.py. */
-		u-boot {
-			type = "blob";
-			filename = "u-boot.img";
-			offset = <0x00050000>;
-		};
-	};
-};
