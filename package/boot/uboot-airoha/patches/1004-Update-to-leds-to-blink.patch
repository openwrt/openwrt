From bd5c61bcb6f9339506422e3a8df61bf1aacb0afe Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 23 Jun 2026 16:13:07 -0300
Subject: [PATCH] Update to leds to blink

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 defenvs/en7523-genexis_pixly_r1_env | 2 +-
 defenvs/en7523-tplink-ex530v_v1_env | 2 +-
 defenvs/en7523-tplink-xx230v_v1_env | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/defenvs/en7523-genexis_pixly_r1_env b/defenvs/en7523-genexis_pixly_r1_env
index 42f1d8e5eb0..8599243b482 100644
--- a/defenvs/en7523-genexis_pixly_r1_env
+++ b/defenvs/en7523-genexis_pixly_r1_env
@@ -5,7 +5,7 @@ bootfile=openwrt-airoha-en7523-genexis_pixly_r1-initramfs-kernel.bin
 firfile=openwrt-airoha-en7523-genexis_pixly_r1-squashfs-sysupgrade.bin
 bootled_pwr=green:power
 ubi_read_openwrt=ubi read $loadaddr fit && iminfo $loadaddr
-boot_openwrt=led $bootled_pwr on ; run ubi_read_openwrt && bootm $loadaddr#$bootconf ; led $bootled_pwr off
+boot_openwrt=led $bootled_pwr blink 155 ; run ubi_read_openwrt && bootm $loadaddr#$bootconf ; led $bootled_pwr off
 boot_ubi=ubi part ubi && run boot_openwrt
 boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
 firm_install=tftpboot $loadaddr $firfile && ubi write $loadaddr fit 0x$filesize
diff --git a/defenvs/en7523-tplink-ex530v_v1_env b/defenvs/en7523-tplink-ex530v_v1_env
index 0a37c875abf..3f2ed7a90cc 100644
--- a/defenvs/en7523-tplink-ex530v_v1_env
+++ b/defenvs/en7523-tplink-ex530v_v1_env
@@ -9,7 +9,7 @@ bootfile=openwrt-airoha-en7523-tplink_ex530v-v1-initramfs-kernel.bin
 boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
 ubi_read_openwrt=ubi read $loadaddr fit && iminfo $loadaddr
 
-boot_openwrt=led $bootled_pwr on ; run ubi_read_openwrt && bootm $loadaddr#$bootconf ; led $bootled_pwr off
+boot_openwrt=led $bootled_pwr blink 155; run ubi_read_openwrt && bootm $loadaddr#$bootconf ; led $bootled_pwr off
 boot_ubi=ubi part ubi && run boot_openwrt
 
 format_ubi_part=mtd read spi-nand0 $loadaddr 0xa0000 0x400000 && \
diff --git a/defenvs/en7523-tplink-xx230v_v1_env b/defenvs/en7523-tplink-xx230v_v1_env
index 37f4b64c3a6..15b0bcb04d5 100644
--- a/defenvs/en7523-tplink-xx230v_v1_env
+++ b/defenvs/en7523-tplink-xx230v_v1_env
@@ -9,7 +9,7 @@ bootfile=openwrt-airoha-en7523-tplink_xx230v-v1-initramfs-kernel.bin
 boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
 ubi_read_openwrt=ubi read $loadaddr fit && iminfo $loadaddr
 
-boot_openwrt=led $bootled_pwr on ; run ubi_read_openwrt && bootm $loadaddr#$bootconf ; led $bootled_pwr off
+boot_openwrt=led $bootled_pwr blink 155; run ubi_read_openwrt && bootm $loadaddr#$bootconf ; led $bootled_pwr off
 boot_ubi=ubi part ubi && run boot_openwrt
 
 format_ubi_part=mtd read spi-nand0 $loadaddr 0xa0000 $art_size && \
-- 
