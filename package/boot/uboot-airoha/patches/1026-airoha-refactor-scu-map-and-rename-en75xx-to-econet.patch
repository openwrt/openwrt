rename to arch/mips/mach-econet/Kconfig
index 1c122d0b82b..06b305f0611 100644
--- a/arch/mips/mach-en75xx/Kconfig
+++ b/arch/mips/mach-econet/Kconfig
@@ -1,36 +1,32 @@
-menu "EcoNet/Airoha EN75xx platforms"
-	depends on ARCH_EN75XX
+menu "Airoha MIPS platforms"
+	depends on ARCH_ECONET
+
+config TARGET_EN751221
+	bool "Airoha EN751221 SoC"
+	select SYSCON
+
+config TARGET_EN7528
+	bool "Airoha EN7528 SoC"
