diff --git a/defenvs/en7523-genexis_pixly_r1_env b/defenvs/en7523-genexis_pixly_r1_env
new file mode 100644
index 00000000000..42f1d8e5eb0
--- /dev/null
+++ b/defenvs/en7523-genexis_pixly_r1_env
@@ -0,0 +1,23 @@
+loadaddr=0x90000000
+ipaddr=192.168.1.1
+serverip=192.168.1.10
+bootfile=openwrt-airoha-en7523-genexis_pixly_r1-initramfs-kernel.bin
+firfile=openwrt-airoha-en7523-genexis_pixly_r1-squashfs-sysupgrade.bin
+bootled_pwr=green:power
+ubi_read_openwrt=ubi read $loadaddr fit && iminfo $loadaddr
+boot_openwrt=led $bootled_pwr on ; run ubi_read_openwrt && bootm $loadaddr#$bootconf ; led $bootled_pwr off
+boot_ubi=ubi part ubi && run boot_openwrt
+boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
+firm_install=tftpboot $loadaddr $firfile && ubi write $loadaddr fit 0x$filesize
+format_ubi_part=mtd erase ubi && ubi part ubi && ubi create ubootenv 126976 && ubi create ubootenv2 126976 && ubi create fit && run firm_install
+bootconf=config-1
+bootcmd=run boot_ubi
+bootdelay=3
+bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 20
+bootmenu_default=0
+bootmenu_delay=3
+bootmenu_title=      34m( ( ( mOpenWrt34m ) ) )
+bootmenu_0=Run default boot command.=run boot_openwrt
+bootmenu_1=Boot system via TFTP.=run boot_tftp ; run bootmenu_confirm_return
+bootmenu_2=Format UBI partition.=run format_ubi_part
+bootmenu_3=Reboot.=reset
diff --git a/dts/upstream/src/arm/airoha/en7523-genexis_pixly_r1.dts b/dts/upstream/src/arm/airoha/en7523-genexis_pixly_r1.dts
new file mode 100644
index 00000000000..69e4a5a20be
--- /dev/null
+++ b/dts/upstream/src/arm/airoha/en7523-genexis_pixly_r1.dts
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/dts-v1/;
+
+/* Bootloader installs ATF here */
+/memreserve/ 0x80000000 0x200000;
+
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/gpio/gpio.h>
+#include "en7523.dtsi"
+
+/ {
+	model = "Genexis/Heimgard CX30";
+	compatible = "airoha,en7523-genexis-cx30", "airoha,en7523";
+
+	aliases {
+		serial0 = &uart1;
+	};
+
+	chosen {
+		bootargs = "console=ttyS0,115200 earlycon";
+		stdout-path = "serial0:115200n8";
+		linux,usable-memory-range = <0x80200000 0x1fe00000>;
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x20000000>;
+	};
+};
+
+&pcie0 {
+	status = "okay";
+};
+
+&pcie1 {
+	status = "okay";
+};
+
+&snfi {
+	status = "okay";
+};
+
+&spi_nand {
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0 {
+			label = "uboot-atf";
+			reg = <0x00000000 0x00100000>;
+			read-only;
+		};
+
+		partition@1 {
+			label = "ubi";
+			reg = <0x00100000 0x10000000>;
+		};
+	};
+};
+
+&eth {
+	status = "okay";
+};
+
+&gdm1 {
+	status = "okay";
+};
