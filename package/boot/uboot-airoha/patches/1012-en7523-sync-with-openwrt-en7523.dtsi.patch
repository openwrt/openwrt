From c78fa200708b1e76670bd1f30b83a4f47794e664 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 23 Jun 2026 13:53:15 -0300
Subject: [PATCH 1012/1020] en7523: sync with openwrt en7523.dtsi

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 arch/arm/dts/en7523-u-boot.dtsi            |   3 -
 dts/upstream/src/arm/airoha/en7523-evb.dts |   8 --
 dts/upstream/src/arm/airoha/en7523.dtsi    | 122 ++++++++++++++++-----
 3 files changed, 92 insertions(+), 41 deletions(-)

diff --git a/arch/arm/dts/en7523-u-boot.dtsi b/arch/arm/dts/en7523-u-boot.dtsi
index 5f9fd74eb07..304145ec1d2 100644
--- a/arch/arm/dts/en7523-u-boot.dtsi
+++ b/arch/arm/dts/en7523-u-boot.dtsi
@@ -2,9 +2,6 @@
 
 #include <dt-bindings/reset/airoha,en7523-reset.h>
 
-/delete-node/ &gpio0;
-/delete-node/ &gpio1;
-
 / {
 	reserved-memory {
 		#address-cells = <1>;
diff --git a/dts/upstream/src/arm/airoha/en7523-evb.dts b/dts/upstream/src/arm/airoha/en7523-evb.dts
index f23a25cce11..0a79f5f6c31 100644
--- a/dts/upstream/src/arm/airoha/en7523-evb.dts
+++ b/dts/upstream/src/arm/airoha/en7523-evb.dts
@@ -26,14 +26,6 @@
 	};
 };
 
-&gpio0 {
-	status = "okay";
-};
-
-&gpio1 {
-	status = "okay";
-};
-
 &pcie0 {
 	status = "okay";
 };
diff --git a/dts/upstream/src/arm/airoha/en7523.dtsi b/dts/upstream/src/arm/airoha/en7523.dtsi
index b523a868c4a..7b26503a847 100644
--- a/dts/upstream/src/arm/airoha/en7523.dtsi
+++ b/dts/upstream/src/arm/airoha/en7523.dtsi
@@ -4,6 +4,7 @@
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/clock/en7523-clk.h>
+#include <dt-bindings/reset/airoha,en7523-reset.h>
 
 / {
 	interrupt-parent = <&gic>;
@@ -15,29 +16,29 @@
 		#size-cells = <1>;
 		ranges;
 
-		npu_binary@84000000 {
+		atf@80000000 {
 			no-map;
-			reg = <0x84000000 0xA00000>;
+			reg = <0x80000000 0x40000>;
 		};
 
-		npu_flag@84B0000 {
+		npu_binary: npu-binary@84000000 {
 			no-map;
-			reg = <0x84B00000 0x100000>;
+			reg = <0x84000000 0x00100000>;
 		};
 
-		npu_pkt@85000000 {
+		npu_pkt: npu-pkt@84d00000 {
 			no-map;
-			reg = <0x85000000 0x1A00000>;
+			reg = <0x84d00000 0x01600000>;
 		};
 
-		npu_phyaddr@86B00000 {
+		qdma0_buf: qdma0-buf@86400000 {
 			no-map;
-			reg = <0x86B00000 0x100000>;
+			reg = <0x86400000 0x02000000>;
 		};
 
-		npu_rxdesc@86D00000 {
+		qdma1_buf: qdma1-buf@88400000 {
 			no-map;
-			reg = <0x86D00000 0x100000>;
+			reg = <0x88400000 0x01000000>;
 		};
 	};
 
@@ -86,6 +87,11 @@
 		};
 	};
 
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x40000000>;
+	};
+
 	scu: system-controller@1fa20000 {
 		compatible = "airoha,en7523-scu";
 		reg = <0x1fa20000 0x400>,
@@ -93,6 +99,26 @@
 		#clock-cells = <1>;
 	};
 
+	system-controller@1fbf0200 {
+		compatible = "syscon", "simple-mfd";
+		reg = <0x1fbf0200 0xc0>;
+
+		pinctrl: pinctrl {
+			compatible = "airoha,en7523-pinctrl";
+
+			interrupt-parent = <&gic>;
+			interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;
+
+			gpio-controller;
+			#gpio-cells = <2>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			gpio-ranges = <&pinctrl 0 12 30>;
+		};
+	};
+
 	gic: interrupt-controller@9000000 {
 		compatible = "arm,gic-v3";
 		interrupt-controller;
@@ -126,26 +152,6 @@
 		status = "okay";
 	};
 
-	gpio0: gpio@1fbf0200 {
-		compatible = "airoha,en7523-gpio";
-		reg = <0x1fbf0204 0x4>,
-		      <0x1fbf0200 0x4>,
-		      <0x1fbf0220 0x4>,
-		      <0x1fbf0214 0x4>;
-		gpio-controller;
-		#gpio-cells = <2>;
-	};
-
-	gpio1: gpio@1fbf0270 {
-		compatible = "airoha,en7523-gpio";
-		reg = <0x1fbf0270 0x4>,
-		      <0x1fbf0260 0x4>,
-		      <0x1fbf0264 0x4>,
-		      <0x1fbf0278 0x4>;
-		gpio-controller;
-		#gpio-cells = <2>;
-	};
-
 	pcie0: pcie@1fa91000 {
 		compatible = "airoha,en7523-pcie", "mediatek,mt7622-pcie";
 		device_type = "pci";
@@ -203,4 +209,60 @@
 			#interrupt-cells = <1>;
 		};
 	};
+
+	eth: ethernet@1fb50000 {
+		compatible = "airoha,en7523-eth";
+		reg = <0x1fb50000 0x2600>,
+		      <0x1fb54000 0x2000>,
+		      <0x1fb56000 0x2000>;
+		reg-names = "fe", "qdma0", "qdma1";
+
+		resets = <&scu EN7523_FE_RST>,
+			 <&scu EN7523_FE_PDMA_RST>,
+			 <&scu EN7523_FE_QDMA_RST>,
+			 <&scu EN7523_DUAL_HSI0_MAC_RST>,
+			 <&scu EN7523_DUAL_HSI1_MAC_RST>,
+			 <&scu EN7523_HSI_MAC_RST>;
+		reset-names = "fe", "pdma", "qdma",
+			      "hsi0-mac", "hsi1-mac", "hsi-mac";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gdm1: ethernet@1 {
+			compatible = "airoha,eth-mac";
+			reg = <1>;
+			phy-mode = "internal";
+			status = "disabled";
+
+			fixed-link {
+				speed = <10000>;
+				full-duplex;
+				pause;
+			};
+		};
+	};
+
+	snfi: spi@1fa10000 {
+		compatible = "airoha,en7523-snand", "airoha,en7581-snand";
+		reg = <0x1fa10000 0x140>,
+					<0x1fa11000 0x160>;
+
+		clocks = <&scuclk EN7523_CLK_SPI>;
+		clock-names = "spi";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		status = "disabled";
+
+		spi_nand: nand@0 {
+			compatible = "spi-nand";
+			reg = <0>;
+
+			spi-max-frequency = <50000000>;
+			spi-tx-bus-width = <1>;
+			spi-rx-bus-width = <2>;
+		};
+	};
 };
-- 
2.54.0

