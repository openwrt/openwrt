 		LEGACY_IMAGE_FORMAT || SPL_LEGACY_IMAGE_FORMAT
 	default 0x8000000 if PPC || ARM64 || RISCV
+	default 0x4000000 if ARCH_ECONET
 	default 0x1000000 if X86 || ARCH_MX6 || ARCH_MX7
