+static int en7528_switch_atc_wait(struct airoha_eth *eth)
+{
+	int i;
+
+	for (i = 0; i < 10000; i++) {
+		if (!(airoha_switch_rr(eth, SWITCH_ATC) & SWITCH_ATC_BUSY))
+			return 0;
+		udelay(1);
+	}
+
+	return -ETIMEDOUT;
+}
