diff --git a/arch/mips/dts/econet,en7528-tplink-xc220-g3v.dts b/arch/mips/dts/econet,en7528-tplink-xc220-g3v.dts
new file mode 100644
index 00000000000..709dfe5b239
--- /dev/null
+++ b/arch/mips/dts/econet,en7528-tplink-xc220-g3v.dts
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0
+/dts-v1/;
+
+#include "econet,en7528.dtsi"
+
+/ {
+	model = "TP-Link XC220-G3V";
+	compatible = "tplink,xc220-g3v", "econet,en7528";
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x10000000>;
+	};
+
+	aliases {
+		serial0 = &uart1;
+		ethernet0 = &gdm1;
+		spi0 = &spi;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&spi {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+		spi-tx-bus-width = <1>;
+		spi-rx-bus-width = <1>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "boot";
+				reg = <0x00000000 0x00040000>;
+				read-only;
+			};
+
+			partition@40000 {
+				label = "romfile";
+				reg = <0x00040000 0x00010000>;
+			};
+
+			partition@50000 {
+				label = "kernel";
+				reg = <0x00050000 0x00220000>;
+			};
+
+			partition@270000 {
+				label = "rootfs";
+				reg = <0x00270000 0x00cd0000>;
+			};
+
+			partition@f40000 {
+				label = "misc";
+				reg = <0x00f40000 0x000c0000>;
+			};
+		};
+	};
+};
+
+&eth { status = "okay"; };
+&gdm1 { status = "okay"; };
+&switch { status = "okay"; };
diff --git a/arch/mips/dts/econet,en7528.dtsi b/arch/mips/dts/econet,en7528.dtsi
new file mode 100644
index 00000000000..b0098552595
--- /dev/null
+++ b/arch/mips/dts/econet,en7528.dtsi
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+
+#include <dt-bindings/reset/airoha,en7523-reset.h>
+
+/ {
+	compatible = "econet,en7528";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			compatible = "mips,mips1004Kc";
+			device_type = "cpu";
+			reg = <0>;
+		};
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		scuclk: system-controller@1fa20000 {
+			compatible = "airoha,en7528-scu";
+			reg = <0x1fa20000 0x400>,
+			      <0x1fb00000 0x1000>;
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+		};
+
+		spi: spi@1fa10000 {
+			compatible = "airoha,en7523-spi";
+			reg = <0x1fa10000 0x140>,
+			      <0x1fa11000 0x600>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		eth: ethernet@1fb50000 {
+			compatible = "econet,en7528-eth";
+			reg = <0x1fb50000 0x2600>,
+			      <0x1fb54000 0x1000>,
+			      <0x1fb55000 0x1000>,
+			      <0x1fa40000 0x8000>;
+			reg-names = "fe", "qdma0", "qdma1", "gdmp";
+			resets = <&scuclk EN7523_FE_RST>,
+				 <&scuclk EN7523_FE_PDMA_RST>,
+				 <&scuclk EN7523_FE_QDMA_RST>;
+			reset-names = "fe", "pdma", "qdma";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+
+			gdm1: mac@1 {
+				compatible = "econet,eth-mac";
+				reg = <1>;
+				phy-mode = "internal";
+	
+				fixed-link {
+					speed = <1000>;
+					full-duplex;
+					pause;
+				};
+			};
+		};
+
+		switch: switch@1fb58000 {
+			compatible = "airoha,en7528-switch", "airoha,en7523-switch";
+			reg = <0x1fb58000 0x8000>;
+			status = "disabled";
+		};
+
+		uart1: serial@1fbf0000 {
+			compatible = "ns16550";
+			reg = <0x1fbf0000 0x30>;
+			reg-io-width = <4>;
+			reg-shift = <2>;
+			clock-frequency = <1843200>;
+			current-speed = <115200>;
+			status = "disabled";
+		};
+	};
+};
diff --git a/arch/mips/mach-en75xx/Kconfig b/arch/mips/mach-en75xx/Kconfig
index 609c07cb4a5..c1e984261d7 100644
--- a/arch/mips/mach-en75xx/Kconfig
+++ b/arch/mips/mach-en75xx/Kconfig
@@ -5,17 +5,32 @@ config SYS_VENDOR
 	default "econet"
 
 config SYS_SOC
+	default "en7528" if BOARD_EN7528_TPLINK_XC220_G3V
 	default "en7512"
 
 config SYS_BOARD
+	default "en7528" if BOARD_EN7528_TPLINK_XC220_G3V
 	default "en7512"
 
 config SYS_CONFIG_NAME
+	default "en7528" if BOARD_EN7528_TPLINK_XC220_G3V
 	default "en7512"
 
 config SYS_MALLOC_F_LEN
 	default 0x2000
 
+config EN75XX_SCU
+	bool "EcoNet/Airoha EN75xx SCU clock/reset controller"
+	default y if BOARD_EN7528_TPLINK_XC220_G3V
+	select CLK
+	select DM_RESET
+	select REGMAP
+	select RESET_AIROHA
+	help
+	  Enable the EN75xx System Control Unit regmap helpers together with
+	  the Airoha clock and reset-controller drivers.  EN7528 shares the
+	  EN7523 SCU reset layout.
+
 config SYS_DCACHE_SIZE
 	default 32768
 
@@ -56,4 +71,12 @@ config BOARD_EN7512_REFERENCE
 	  TPL initializes the serial flash controller, executes the legacy DDR
 	  calibration stage from FE SRAM and loads SPL into DDR.
 
+config BOARD_EN7528_TPLINK_XC220_G3V
+	bool "TP-Link XC220-G3V (EN7528, chainloaded)"
+	help
+	  Build U-Boot proper for the TP-Link XC220-G3V. This target assumes a
+	  previous boot stage has initialized DDR and the integrated switch PHYs.
+	  It intentionally produces a plain u-boot.bin for one-time serial loading,
+	  after which Ethernet/TFTP and the 16 MiB SPI-NOR can be used.
+
 endmenu
