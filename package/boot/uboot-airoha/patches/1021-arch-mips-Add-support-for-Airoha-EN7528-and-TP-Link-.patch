index 2f72659e583..cc4af3c47da 100644
--- a/arch/mips/Kconfig
+++ b/arch/mips/Kconfig
@@ -72,15 +72,19 @@ config ARCH_EN75XX
 	select OF_CONTROL
 	select ROM_EXCEPTION_VECTORS
 	select SUPPORT_BIG_ENDIAN
+	select SUPPORT_LITTLE_ENDIAN
 	select SUPPORTS_CPU_MIPS32_R2
 	select SUPPORT_SPL
 	select SPL_SKIP_LOWLEVEL_INIT if SPL
 	select SUPPORT_TPL
