+		dma_unmap_unaligned((dma_addr_t)desc, sizeof(*desc),
+				    DMA_FROM_DEVICE);
+		ctrl = READ_ONCE(desc->ctrl);
+		if (ctrl & QDMA_DESC_DONE_MASK)
+			break;
+		udelay(1);
+	}
+
+	dma_unmap_single(dma_addr, length, DMA_TO_DEVICE);
+	if (!(ctrl & QDMA_DESC_DONE_MASK))
+		return -ETIMEDOUT;
+
+	q->head = next;
+	return 0;
