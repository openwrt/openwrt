diff --git a/arch/mips/dts/econet,en751627-reference.dts b/arch/mips/dts/econet,en751627-reference.dts
new file mode 100644
index 00000000000..5b5570e3751
--- /dev/null
+++ b/arch/mips/dts/econet,en751627-reference.dts
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Generic chainload target; adapt flash type and wiring to the board. */
+/dts-v1/;
+#include "econet,en751627.dtsi"
+
+/ {
+	model = "Airoha EN7516/EN7527 reference board";
+	compatible = "econet,en751627-reference", "econet,en751627";
+
+	memory@0 {
+		device_type = "memory";
+		/* Placeholder; dram_init uses the vendor calibrated size. */
+		reg = <0x00000000 0x10000000>;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&spi0 {
+	status = "okay";
+
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+		spi-tx-bus-width = <1>;
+		spi-rx-bus-width = <1>;
+	};
+};
+
+&eth {
+	status = "okay";
+};
+
+&gdm1 {
+	status = "okay";
+};
+
+&switch {
+	status = "okay";
+};
diff --git a/arch/mips/dts/econet,en751627.dtsi b/arch/mips/dts/econet,en751627.dtsi
new file mode 100644
index 00000000000..2c46651e04d
--- /dev/null
+++ b/arch/mips/dts/econet,en751627.dtsi
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/* EN7516/EN7527 is the big-endian member of the EN7528 family. */
+#include "econet,en7528.dtsi"
+
+/ {
+	compatible = "econet,en751627", "airoha,en751627";
+};
+
+&chip_scu {
+	compatible = "airoha,scuclk", "airoha,en751627-chip-scu",
+		     "airoha,en7528-chip-scu", "syscon";
+	native-endian;
+};
+
+&scuclk {
+	compatible = "airoha,en751627-scu", "airoha,en7528-scu", "syscon";
+	native-endian;
+};
+
+&uart1 {
+	big-endian;
+};
+
+&spi0 {
+	native-endian;
+};
+
+&eth {
+	compatible = "econet,en751627-eth";
+};
+
+&switch {
+	compatible = "airoha,en751627-switch", "airoha,en7528-switch";
+};
diff --git a/arch/mips/mach-econet/Kconfig b/arch/mips/mach-econet/Kconfig
index 9bed7d2545d..bd763d690be 100644
--- a/arch/mips/mach-econet/Kconfig
+++ b/arch/mips/mach-econet/Kconfig
@@ -6,6 +6,15 @@ config TARGET_EN751221
 	select SYSCON
 	select MIPS_TUNE_34KC
 
+config TARGET_EN751627
+	bool "Airoha EN7516/EN7527 SoC (big-endian)"
+	select SYSCON
+	select MIPS_TUNE_1004KC
+	select MIPS_SKIP_CP0_COUNT_CLEAR
+	help
+	  EN7516/EN7527 shares the EN7528 peripheral and CPU support.
+	  This target uses the big-endian vendor first-stage handoff.
+
 config TARGET_EN7528
 	bool "Airoha EN7528 SoC"
 	select SYSCON
@@ -26,17 +35,17 @@ config SYS_VENDOR
 
 config SYS_SOC
 	default "en751221" if TARGET_EN751221
-	default "en7528" if TARGET_EN7528
+	default "en7528" if TARGET_EN7528 || TARGET_EN751627
 	default "en7580" if TARGET_EN7580
 
 config SYS_BOARD
 	default "en7512" if TARGET_EN751221
-	default "en7528" if TARGET_EN7528
+	default "en7528" if TARGET_EN7528 || TARGET_EN751627
 	default "en7580" if TARGET_EN7580
 
 config SYS_CONFIG_NAME
 	default "en7512" if TARGET_EN751221
-	default "en7528" if TARGET_EN7528
+	default "en7528" if TARGET_EN7528 || TARGET_EN751627
 	default "en7580" if TARGET_EN7580
 
 config SYS_MALLOC_F_LEN
@@ -111,4 +120,12 @@ config BOARD_EN7528_REFERENCE
 	  on the DASAN H660GM-A.  Like the XC220-G3V it is chainloaded after a
 	  previous stage has trained DDR, but boots from SPI-NAND.
 
+config BOARD_EN751627_REFERENCE
+	bool "Airoha EN7516/EN7527 reference board (chainloaded)"
+	depends on SYS_BIG_ENDIAN
+	select TARGET_EN751627
+	help
+	  Build U-Boot proper with integrated Ethernet and SPI-NAND support.
+	  A preceding stage must initialize DDR, CPU clocks and switch PHYs.
+
 endmenu
