diff --git a/arch/mips/dts/econet,en7580-xgz030-u-boot.dtsi b/arch/mips/dts/econet,en7580-xgz030-u-boot.dtsi
new file mode 100644
index 00000000000..e19f5822130
--- /dev/null
+++ b/arch/mips/dts/econet,en7580-xgz030-u-boot.dtsi
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0+
+#include <linux/stringify.h>
+
+/ {
+	binman: binman {
+		multiple-images;
+	};
+};
+
+&uart0 {
+	bootph-all;
+};
+
+&binman {
+	spl-img {
+		filename = "u-boot-spl.img";
+
+		mkimage {
+			args = "-A", "mips", "-T", "standalone", "-O", "u-boot",
+			       "-C", "none", "-n", "EN7580 U-Boot SPL",
+			       "-a", __stringify(CONFIG_SPL_TEXT_BASE),
+			       "-e", __stringify(CONFIG_SPL_TEXT_BASE);
+
+			u-boot-spl {
+			};
+		};
+	};
+
+	en7580-boot0 {
+		filename = "u-boot-boot0.bin";
+		pad-byte = <0xff>;
+		size = <0x00020000>;
+
+		u-boot-tpl {
+			offset = <0x00000000>;
+			size = <0x00008000>;
+		};
+
+
+		ddr-blob {
+			type = "blob-ext";
+			filename = "en7580_ddr.bin";
+			offset = <0x00010000>;
+			size = <0x0000b000>;
+		};
+	};
+
+	en7580-uboot {
+		filename = "u-boot-en7580.bin";
+		pad-byte = <0xff>;
+
+		u-boot-tpl {
+			offset = <0x00000000>;
+			size = <0x00008000>;
+		};
+
+
+		ddr-blob {
+			type = "blob-ext";
+			filename = "en7580_ddr.bin";
+			offset = <0x00010000>;
+			size = <0x0000b000>;
+		};
+
+		spl {
+			type = "blob";
+			filename = "u-boot-spl.img";
+			offset = <0x00020000>;
+			size = <0x00040000>;
+		};
+
+		u-boot {
+			type = "blob";
+			filename = "u-boot.img";
+			offset = <0x00060000>;
+		};
+	};
+};
diff --git a/arch/mips/dts/econet,en7580-xgz030.dts b/arch/mips/dts/econet,en7580-xgz030.dts
new file mode 100644
index 00000000000..f558a459d52
--- /dev/null
+++ b/arch/mips/dts/econet,en7580-xgz030.dts
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0+
+/dts-v1/;
+
+#include "econet,en7580.dtsi"
+
+/ {
+	model = "XGZ030 (Airoha EN7580)";
+	compatible = "xgz030,en7580", "econet,en7580", "airoha,en7580";
+
+	/* The RAM-training stage replaces this size during U-Boot startup. */
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x10000000>;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&spi0 {
+	status = "okay";
+
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+		spi-tx-bus-width = <1>;
+		spi-rx-bus-width = <1>;
+	};
+};
diff --git a/arch/mips/dts/econet,en7580.dtsi b/arch/mips/dts/econet,en7580.dtsi
new file mode 100644
index 00000000000..46ce0f818a9
--- /dev/null
+++ b/arch/mips/dts/econet,en7580.dtsi
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+
+#include <dt-bindings/reset/airoha,en7523-reset.h>
+
+/ {
+	compatible = "airoha,en7580";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			compatible = "mips,mips1004Kc";
+			device_type = "cpu";
+			reg = <0>;
+		};
+	};
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		chip_scu: syscon@1fa20000 {
+			compatible = "airoha,en7580-chip-scu",
+				     "airoha,en7528-chip-scu", "syscon";
+			reg = <0x1fa20000 0x400>;
+		};
+
+		scuclk: system-controller@1fb00000 {
+			compatible = "airoha,en7580-scu", "airoha,en7528-scu",
+				     "syscon";
+			reg = <0x1fb00000 0x1000>;
+			airoha,chip-scu = <&chip_scu>;
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+		};
+
+		uart0: serial@1fbf0000 {
+			compatible = "ns16550";
+			reg = <0x1fbf0000 0x30>;
+			reg-io-width = <4>;
+			reg-shift = <2>;
+			clock-frequency = <1843200>;
+			current-speed = <115200>;
+			status = "disabled";
+		};
+
+		spi0: spi@1fa10000 {
+			compatible = "airoha,en7523-spi";
+			reg = <0x1fa10000 0x140>,
+			      <0x1fa11000 0x600>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		eth: ethernet@1fb50000 {
+			compatible = "econet,en7580-eth";
+			reg = <0x1fb50000 0x2600>,
+			      <0x1fb54000 0x2000>,
+			      <0x1fb56000 0x2000>,
+			      <0x1fa40000 0x8000>;
+			reg-names = "fe", "qdma0", "qdma1", "gdmp";
+			resets = <&scuclk EN7523_FE_RST>,
+				 <&scuclk EN7523_FE_PDMA_RST>,
+				 <&scuclk EN7523_FE_QDMA_RST>;
+			reset-names = "fe", "pdma", "qdma";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+
+			gdm1: mac@1 {
+				compatible = "econet,eth-mac";
+				reg = <1>;
+				phy-mode = "internal";
+
+				fixed-link {
+					speed = <1000>;
+					full-duplex;
+					pause;
+				};
+			};
+		};
+
+		switch: switch@1fb58000 {
+			compatible = "airoha,en7580-switch";
+			reg = <0x1fb58000 0x8000>;
+			status = "disabled";
+		};
+	};
+};
diff --git a/arch/mips/mach-econet/Kconfig b/arch/mips/mach-econet/Kconfig
index 6c23635a972..9bed7d2545d 100644
--- a/arch/mips/mach-econet/Kconfig
+++ b/arch/mips/mach-econet/Kconfig
@@ -12,20 +12,32 @@ config TARGET_EN7528
 	select MIPS_TUNE_1004KC
 	select MIPS_SKIP_CP0_COUNT_CLEAR
 
+config TARGET_EN7580
+	bool "Airoha EN7580 SoC"
+	select SYSCON
+	select MIPS_TUNE_1004KC
+	select MIPS_SKIP_CP0_COUNT_CLEAR
+	help
+	  Select support for the little-endian MIPS32r2 EN7580 family.
+	  Initial support targets direct TPL/SPL bring-up on the XGZ030.
+
 config SYS_VENDOR
 	default "econet"
 
 config SYS_SOC
 	default "en751221" if TARGET_EN751221
 	default "en7528" if TARGET_EN7528
+	default "en7580" if TARGET_EN7580
 
 config SYS_BOARD
 	default "en7512" if TARGET_EN751221
 	default "en7528" if TARGET_EN7528
+	default "en7580" if TARGET_EN7580
 
 config SYS_CONFIG_NAME
 	default "en7512" if TARGET_EN751221
 	default "en7528" if TARGET_EN7528
+	default "en7580" if TARGET_EN7580
 
 config SYS_MALLOC_F_LEN
 	default 0x2000
@@ -59,7 +71,7 @@ config TPL_MAX_SIZE
 
 
 config BUILD_TARGET
-	default "u-boot.img" if TARGET_EN751221
+	default "u-boot.img"
 
 config BOARD_EN7512_REFERENCE
 	bool "EN7512/EN7521 reference board"
@@ -71,6 +83,17 @@ config BOARD_EN7512_REFERENCE
 	  TPL initializes the serial flash controller, executes the legacy DDR
 	  calibration stage from FE SRAM and loads SPL into DDR.
 
+config BOARD_EN7580_XGZ030
+	bool "XGZ030 (EN7580, experimental TPL/SPL)"
+	select TARGET_EN7580
+	select BINMAN
+	select SPL_LOADER_SUPPORT if SPL
+	help
+	  Experimental direct-boot target for the XGZ030 EN7580 platform.
+	  TPL runs from the reset mapping, loads the GPL RAM-training payload
+	  into FE SRAM and then loads SPL into DRAM. The DDR and CPS bring-up
+	  paths are not yet validated on hardware.
+
 config BOARD_EN7528_TPLINK_XC220_G3V
 	bool "TP-Link XC220-G3V (EN7528, chainloaded)"
 	select TARGET_EN7528
