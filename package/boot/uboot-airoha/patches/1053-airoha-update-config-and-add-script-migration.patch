 		stdout-path = "serial0:115200n8";
 	};
+
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <100>;
+
+		reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
+			debounce-interval = <60>;
+		};
+
+		wps {
+			label = "wps";
+			linux,code = <KEY_WPS_BUTTON>;
+			gpios = <&pinctrl 30 GPIO_ACTIVE_LOW>;
+			debounce-interval = <60>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		// Wireless
+		led@5 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WLAN;
+			function-enumerator = <5>;
+			gpios = <&pinctrl 5 GPIO_ACTIVE_LOW>;
+		};
+
+		// Internet
+		led@25 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_WAN_ONLINE;
+			function-enumerator = <25>;
+			gpios = <&pinctrl 25 GPIO_ACTIVE_LOW>;
+		};
+
+		// FXS1
+		led@27 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_VOIP;
+			function-enumerator = <27>;
+			gpios = <&pinctrl 27 GPIO_ACTIVE_LOW>;
+		};
+
+		// LOS
+		led@32 {
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_XPON_LOS;
+			function-enumerator = <32>;
+			gpios = <&pinctrl 32 GPIO_ACTIVE_LOW>;
+		};
+
+		// xPON
+		led@34 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_XPON;
+			function-enumerator = <34>;
+			gpios = <&pinctrl 34 GPIO_ACTIVE_LOW>;
+		};
+
+		// Power
+		led_power: led@36 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_POWER;
+			function-enumerator = <36>;
+			gpios = <&pinctrl 36 GPIO_ACTIVE_HIGH>;
+		};
+	};
 };
 
