--- /dev/null
+++ b/arch/mips/mach-econet/en751221/ddr/spram.c
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "en751221_ddr.h"
+
+#define ILOAD 4
+#define DLOAD 5
+#define ISTORE 8
+#define DSTORE 9
+#define IDATA 12
+#define K0 0x80000000U
+#define EN 0x80U
+#define PAM 0xfffff000U
+#define SZM 0xfffff000U
+#define ERR BIT(28)
+
+#define cop(op, a)                                                                           \
+	__asm__ __volatile__(                                                                \
+		".set push\n\t.set noreorder\n\t.set mips3\n\tcache %0,0(%1)\n\t.set pop" :: \
+			"i"(op),                                                             \
+		"r"((unsigned long)(a))                                                      \
+		: "memory")
+
+static inline void h(void)
+{
+	__asm__ __volatile__("ehb" ::: "memory");
+}
+
+static inline unsigned e(void)
+{
+	unsigned v;
+	__asm__("mfc0 %0,$26" : "=r"(v));
+	return v;
+}
+
+static inline void E(unsigned v)
+{
+	__asm__("mtc0 %0,$26" ::"r"(v));
+}
+
+static inline unsigned it(void)
+{
+	unsigned v;
+	__asm__("mfc0 %0,$28" : "=r"(v));
+	return v;
+}
+
+static inline void I(unsigned v)
+{
+	__asm__("mtc0 %0,$28" ::"r"(v));
+}
+
+static inline unsigned dt(void)
+{
+	unsigned v;
+	__asm__("mfc0 %0,$28,2" : "=r"(v));
+	return v;
+}
+
+static inline void D(unsigned v)
+{
+	__asm__("mtc0 %0,$28,2" ::"r"(v));
+}
+
+static unsigned load(unsigned o, int i)
+{
+	unsigned x = e(), v;
+	E(x | ERR);
+	h();
+	if (i)
+		cop(ILOAD, K0 | o);
+	else
+		cop(DLOAD, K0 | o);
+	h();
+	v = i ? it() : dt();
+	h();
+	E(x);
+	h();
+	return v;
+}
+
+static void store(unsigned o, unsigned v, int i)
+{
+	unsigned x = e();
+	E(x | ERR);
+	h();
+	if (i) {
+		I(v);
+		cop(ISTORE, K0 | o);
+	} else {
+		D(v);
+		cop(DSTORE, K0 | o);
+	}
+	h();
+	E(x);
+	h();
+}
+
+void probe_spram(unsigned base, unsigned enable)
+{
+	int i = (enable & 2) >> 1;
+	unsigned t = load(8, i), z = t & SZM;
+	if (!z)
+		return;
+	base = (base + z - 1) & ~(z - 1);
+	t = base & PAM;
+	if (enable & 1)
+		t |= EN;
+	store(0, t, i);
+}
+
+void ispram_fill(int size, unsigned from, unsigned to)
+{
+	unsigned p = load(0, 1) & PAM, z = size ? size : (load(8, 1) & SZM), o;
+	if (from)
+		p = from;
+	for (o = 0; o < z; o += 8) {
+		unsigned x = e(),
+				 a = *(unsigned *)(unsigned long)(K0 | p + o),
+				 b = *(unsigned *)(unsigned long)(K0 | p + o + 4);
+
+		E(x | ERR);
+		h();
+		__asm__("mtc0 %0,$28,1\n\tmtc0 %1,$29,1" ::"r"(a), "r"(b));
+		h();
+		cop(IDATA, K0 | to + o);
+		h();
+		E(x);
+	}
+}
diff --git a/arch/mips/mach-econet/en751221/ddr/string.c b/arch/mips/mach-econet/en751221/ddr/string.c
new file mode 100644
index 00000000000..65d16b1b0ee
--- /dev/null
+++ b/arch/mips/mach-econet/en751221/ddr/string.c
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+typedef unsigned int size_t;
+
+char *strcpy(char *d, const char *s)
+{
+	char *r = d;
+	while ((*d++ = *s++) != '\0')
+		;
+	return r;
+}
+
+int strcmp(const char *a, const char *b)
+{
+	signed char r;
+	for (;;) {
+		r = *a - *b++;
+		if (r || !*a++)
+			break;
+	}
+	return r;
+}
+
+size_t strlen(const char *s)
+{
+	const char *p;
+	for (p = s; *p; p++)
+		;
+	return p - s;
+}
+
+void *memset(void *d, int v, size_t c)
+{
+	unsigned char *p = d;
+	while (c--)
+		*p++ = v;
+	return d;
+}
+
+void *memcpy(void *d, const void *s, size_t c)
+{
+	unsigned char *x = d;
+	const unsigned char *y = s;
+	while (c--)
+		*x++ = *y++;
+	return d;
+}
+
+void *memcpy4(void *d, const void *s, size_t c)
+{
+	unsigned int *x = d;
+	const unsigned int *y = s;
+	if (((unsigned long)x & 3) || ((unsigned long)y & 3))
+		return memcpy(d, s, c);
+	while (c >= 4) {
+		*x++ = *y++;
+		c -= 4;
+	}
+	if (c)
+		memcpy(x, y, c);
+	return d;
+}
diff --git a/arch/mips/mach-econet/en751221/ddr/time.c b/arch/mips/mach-econet/en751221/ddr/time.c
new file mode 100644
index 00000000000..7abdcb6d3c8
--- /dev/null
+++ b/arch/mips/mach-econet/en751221/ddr/time.c
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "en751221_ddr.h"
+
+extern int get_SYS_HCLK(void);
+
+static unsigned int timer_ldv_reg(unsigned int timer)
+{
+	return CR_TIMER_BASE + 0x04 + timer * 8;
+}
+
+void timer_Configure(unsigned char n, unsigned char en, unsigned char mode,
+		     unsigned char halt)
+{
+	unsigned int w = MMIO32(CR_TIMER_CTL);
+	w |= ((unsigned int)en << n) | ((unsigned int)mode << (n + 8)) |
+	     ((unsigned int)halt << (n + 26));
+	MMIO32(CR_TIMER_CTL) = w;
+}
+
+void timerSet(unsigned int n, unsigned int time, unsigned int en,
+	      unsigned int mode, unsigned int halt)
+{
+	unsigned int w = (unsigned int)get_SYS_HCLK() * 1000U / 2U;
+	MMIO32(timer_ldv_reg(n)) = w * time;
+	timer_Configure(n, en, mode, halt);
+}
+
+void time_polling_init(void)
+{
+	timerSet(1, TIMERTICKS_10MS, ENABLE, TIMER_TOGGLEMODE,
+		 TIMER_HALTDISABLE);
+}
+
+void pause_polling(unsigned int us)
+{
+	volatile unsigned int now, last, ticks, ldv;
+	unsigned int unit = (unsigned int)get_SYS_HCLK() * 500U,
+		     wait = us * (unit / 1000U);
+	ldv = MMIO32(CR_TIMER1_LDV);
+	ticks = 0;
+	last = MMIO32(CR_TIMER1_VLR);
+	do {
+		now = MMIO32(CR_TIMER1_VLR);
+		ticks += last >= now ? last - now : ldv - now + last;
+		last = now;
+	} while (ticks < wait);
+}
diff --git a/arch/mips/mach-econet/flash/en751221/boot2.S b/arch/mips/mach-econet/flash/en751221/boot2.S
new file mode 100644
index 00000000000..7c909cf2023
--- /dev/null
+++ b/arch/mips/mach-econet/flash/en751221/boot2.S
@@ -0,0 +1,364 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * EN751221 second FE-SRAM stage.
+ *
+ * Source-level port of the active EN751221 cold-boot path from the
+ * EcoNet SDK en7512_boot/boot2/init/boot2.S.
+ *
+ * FPGA, debug and destructive cache-test paths from the vendor source
+ * are intentionally omitted.
+ */
+
+#include <asm/regdef.h>
+
+#define CR_ARB_BASE			0xbfb00000
+#define CR_SMC_BASE			0xbfb10000
+#define CR_INTC_BASE			0xbfb40000
+#define SCREG_WR0			0x280
+
+#define SHARE_FEMEM_SEL			0xbfb00958
+
+#define SRAM_DESC_ADDR			0xbfa30000
+#define MOVE_DATA_CACHED		0x9fa30040
+#define MOVE_DATA_UNCACHED		0xbfa30040
+#define DDR_STAGE_CACHED		0x9fa32800
+#define DDR_STAGE_UNCACHED		0xbfa32800
+
+#define ICACHE_INDEX_STORE_TAG		8
+#define DCACHE_INDEX_STORE_TAG		9
+#define ICACHE_ADDR_HIT_INVALIDATE	16
+#define DCACHE_ADDR_HIT_WRITEBACK	25
+
+#define CONFIG1_IS_SHIFT		22
+#define CONFIG1_IS_MASK			(0x7 << CONFIG1_IS_SHIFT)
+#define CONFIG1_IL_SHIFT		19
+#define CONFIG1_IL_MASK			(0x7 << CONFIG1_IL_SHIFT)
+#define CONFIG1_IA_SHIFT		16
+#define CONFIG1_IA_MASK			(0x7 << CONFIG1_IA_SHIFT)
+
+#define CONFIG1_DS_SHIFT		13
+#define CONFIG1_DS_MASK			(0x7 << CONFIG1_DS_SHIFT)
+#define CONFIG1_DL_SHIFT		10
+#define CONFIG1_DL_MASK			(0x7 << CONFIG1_DL_SHIFT)
+#define CONFIG1_DA_SHIFT		7
+#define CONFIG1_DA_MASK			(0x7 << CONFIG1_DA_SHIFT)
+
+/*
+ * Keep the hazard sequence used by the old EcoNet MTC0_SEL_OPCODE
+ * implementation.
+ */
+#define CP0_HAZARD			\
+	sll zero, zero, 1;		\
+	sll zero, zero, 1;		\
+	sll zero, zero, 1;		\
+	sll zero, zero, 3
+
+	.section .text, "ax", @progbits
+	.set	noreorder
+
+	.globl	boot2_entry
+boot2_entry:
+	/*
+	 * boot2 is initially entered through the bfa30800 uncached alias.
+	 * J-format calls therefore remain in the same physical FE SRAM
+	 * while sys_init_cache invalidates L1.
+	 */
+	jal	sys_init_cache
+	nop
+
+	/* Allow PBUS access to FE memory. */
+	li	v0, SHARE_FEMEM_SEL
+	lw	t6, 0(v0)
+	nop
+	ori	t6, t6, 1
+	sw	t6, 0(v0)
+	nop
+
+	/*
+	 * Copy the DDR calibration image from flash to FE SRAM using the
+	 * already resident move_data stage.
+	 */
+	li	t1, SRAM_DESC_ADDR
+	lw	s1, 0x08(t1)
+	nop
+	lw	s2, 0x0c(t1)
+	nop
+
+	li	s3, DDR_STAGE_UNCACHED
+	la	s4, move_ddr_calibration
+
+	li	t1, MOVE_DATA_CACHED
+	jr	t1
+	nop
+
+move_ddr_calibration:
+	nop
+
+	/*
+	 * The calibration code returns through SCREG_WR0, matching the
+	 * vendor DDR calibration ABI.
+	 */
+	la	k1, ddr_calibration_done
+	li	k0, CR_ARB_BASE
+	sw	k1, SCREG_WR0(k0)
+	nop
+
+	li	k0, DDR_STAGE_CACHED
+	jr	k0
+	nop
+
+ddr_calibration_done:
+	move	k1, zero
+	li	k0, CR_ARB_BASE
+	sw	k1, SCREG_WR0(k0)
+	nop
+
+#ifndef TCSUPPORT_SLM_EN
+	/* Vendor boot2 bypasses SLM on this configuration. */
+	li	k0, 0xbfa60000
+	lw	t7, 0(k0)
+	nop
+	ori	t7, t7, 1
+	sw	t7, 0(k0)
+	nop
+#endif
+
+	/* Arbiter configuration preserved from the EN7512 vendor stage. */
+	li	v1, CR_ARB_BASE
+
+	li	a0, 0x80071f1e
+	li	a1, 0x00071f1f
+	li	a2, 0x00040000
+
+	sw	a0, 0x20(v1)
+	sw	a1, 0x24(v1)
+	nop
+
+	/* SRAM rank 3/4/5. */
+	li	a0, 0x00040808
+	li	a1, 0xc0041010
+	li	a2, 0x80050000
+
+	sw	a2, 0x34(v1)
+	nop
+
+	/* SMC. */
+	li	v1, CR_SMC_BASE
+
+	li	a0, 0x102d1040
+	li	a2, 0x10aa8100
+	li	a3, 0x200028d0
+
+	sw	a0, 0x00(v1)
+	sw	a3, 0x14(v1)
+	nop
+
+	/* Disable all legacy interrupt routing/masks. */
+	li	t0, CR_INTC_BASE
+	sw	zero, 0x00(t0)
+	sw	zero, 0x04(t0)
+	nop
+
+	/*
+	 * Preserve the two legacy boot interval words expected by the old
+	 * loader ABI.
+	 */
+	li	t1, SRAM_DESC_ADDR
+
+	lw	t2, 0x18(t1)
+	nop
+	li	t3, 0x80010000
+	sw	t2, 0(t3)
+	nop
+
+	lw	t2, 0x1c(t1)
+	nop
+	li	t3, 0x80010020
+	sw	t2, 0(t3)
+	nop
+
+	/*
+	 * Descriptor +0x10/+0x14 is the .lzma interval in the legacy ABI.
+	 * In the new image it contains our small uncompressed flash loader.
+	 */
+	lw	s1, 0x10(t1)
+	nop
+	lw	s2, 0x14(t1)
+	nop
+
+	li	s3, 0x80000000
+	la	s4, loading_bootcode_done
+
+	li	k0, MOVE_DATA_UNCACHED
+	jr	k0
+	nop
+
+loading_bootcode_done:
+	nop
+
+	/*
+	 * The copied loader will execute from cached KSEG0.  Write the data
+	 * back and invalidate the corresponding I-cache range exactly as
+	 * the vendor boot2 does.
+	 */
+	li	t1, 0x80000000
+	li	t2, 0x80200000
+1:
+	cache	DCACHE_ADDR_HIT_WRITEBACK, 0(t1)
+	sync
+	cache	ICACHE_ADDR_HIT_INVALIDATE, 0(t1)
+
+	addiu	t1, t1, 32
+	bne	t2, t1, 1b
+	nop
+
+	li	t0, 0xf200ff15
+	mtc0	t0, $12
+	nop
+
+	li	t2, 0x80000000
+	jr	t2
+	nop
+
+/*
+ * L1 initialization.
+ *
+ * Config1:
+ *   IS/DS = sets per way
+ *   IL/DL = line-size encoding
+ *   IA/DA = associativity - 1
+ */
+sys_init_cache:
+	move	t4, ra
+
+	jal	sys_determine_icache_linesize
+	nop
+	move	t2, v0
+
+	jal	sys_determine_icache_lines
+	nop
+	multu	t2, v0
+	mflo	t3
+
+	jal	sys_determine_dcache_linesize
+	nop
+	move	t0, v0
+
+	jal	sys_determine_dcache_lines
+	nop
+	multu	t0, v0
+	mflo	t1
+
+	move	a0, t3
+	move	a1, t2
+	jal	sys_init_icache
+	nop
+
+	move	a0, t1
+	move	a1, t0
+	jal	sys_init_dcache
+	nop
+
+	jr	t4
+	move	v0, zero
+
+sys_init_icache:
+	/* Clear ITagLo. */
+	mtc0	zero, $28, 0
+	CP0_HAZARD
+
+	li	a2, 0x80000000
+	addu	a3, a2, a0
+	subu	a3, a3, a1
+1:
+	cache	ICACHE_INDEX_STORE_TAG, 0(a2)
+	bne	a2, a3, 1b
+	addu	a2, a2, a1
+
+	jr	ra
+	nop
+
+sys_init_dcache:
+	/* Clear DTagLo. */
+	mtc0	zero, $28, 2
+	CP0_HAZARD
+
+	li	a2, 0x80000000
+	addu	a3, a2, a0
+	subu	a3, a3, a1
+1:
+	cache	DCACHE_INDEX_STORE_TAG, 0(a2)
+	bne	a2, a3, 1b
+	addu	a2, a2, a1
+
+	jr	ra
+	nop
+
+sys_determine_icache_linesize:
+	mfc0	t9, $16, 1
+
+	li	t8, CONFIG1_IL_MASK
+	and	t8, t8, t9
+	srl	t8, t8, CONFIG1_IL_SHIFT
+
+	li	t7, 2
+	sllv	v0, t7, t8
+
+	jr	ra
+	nop
+
+sys_determine_icache_lines:
+	mfc0	t9, $16, 1
+
+	li	t8, CONFIG1_IA_MASK
+	and	t8, t8, t9
+	srl	t8, t8, CONFIG1_IA_SHIFT
+	addiu	t8, t8, 1
+
+	li	t7, CONFIG1_IS_MASK
+	and	t7, t7, t9
+	srl	t7, t7, CONFIG1_IS_SHIFT
+
+	li	t9, 0x40
+	sllv	t7, t9, t7
+
+	multu	t8, t7
+	mflo	v0
+
+	jr	ra
+	nop
+
+sys_determine_dcache_linesize:
+	mfc0	t9, $16, 1
+
+	li	t8, CONFIG1_DL_MASK
+	and	t8, t8, t9
+	srl	t8, t8, CONFIG1_DL_SHIFT
+
+	li	t7, 2
+	sllv	v0, t7, t8
+
+	jr	ra
+	nop
+
+sys_determine_dcache_lines:
+	mfc0	t9, $16, 1
+
+	li	t8, CONFIG1_DA_MASK
+	and	t8, t8, t9
+	srl	t8, t8, CONFIG1_DA_SHIFT
+	addiu	t8, t8, 1
+
+	li	t7, CONFIG1_DS_MASK
+	and	t7, t7, t9
+	srl	t7, t7, CONFIG1_DS_SHIFT
+
+	li	t9, 0x40
+	sllv	t7, t9, t7
+
+	multu	t8, t7
+	mflo	v0
+
+	jr	ra
+	nop
+
diff --git a/arch/mips/mach-econet/flash/en751221/boot2.lds b/arch/mips/mach-econet/flash/en751221/boot2.lds
new file mode 100644
index 00000000000..e0feb7e8ac8
--- /dev/null
+++ b/arch/mips/mach-econet/flash/en751221/boot2.lds
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+OUTPUT_ARCH(mips)
+ENTRY(boot2_entry)
+
+SECTIONS
+{
+	/*
+	 * boot2 executes from FE SRAM at the vendor SDK address.
+	 * The DDR calibration payload is copied to 0x9fa32800, therefore
+	 * boot2 must stay entirely below that address.
+	 */
+	. = 0x9fa30800;
+
+	.text : {
+		*(.text)
+		*(.text.*)
+		*(.rodata)
+		*(.rodata.*)
+	}
+
+	__stage_end = .;
+
+	ASSERT(__stage_end <= 0x9fa32800,
+	       "EN751221 boot2 overlaps DDR calibration SRAM window")
+
+	/DISCARD/ : {
+		*(.reginfo)
+		*(.MIPS.abiflags)
+		*(.pdr)
+		*(.comment)
+		*(.eh_frame)
+		*(.note*)
+	}
+}
diff --git a/arch/mips/mach-econet/flash/en751221/move_data.S b/arch/mips/mach-econet/flash/en751221/move_data.S
new file mode 100644
index 00000000000..c7ac42f606d
--- /dev/null
+++ b/arch/mips/mach-econet/flash/en751221/move_data.S
@@ -0,0 +1,419 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * EN751221 first-stage flash copier.
+ *
+ * Source-level port of the active EN751221 path from the EcoNet SDK
+ * en7512_boot/move_data/init/move_data.S.
+ *
+ * Runtime ABI:
+ *
+ *	s1	source address in the flash image
+ *	s2	last source address
+ *	s3	destination address
+ *	s4	return address
+ *
+ * The EN751221 SPI-NAND boot path uses fixed 2048-byte NAND pages.
+ */
+
+#include <asm/regdef.h>
+
+#define SF_READ_IDLE_EN			0xbfa10004
+#define SF_MTX_MODE_TOG			0xbfa10014
+#define SF_RDCTL_FSM			0xbfa10018
+#define SF_MACMUX_SEL			0xbfa1001c
+#define SF_MANUAL_EN			0xbfa10020
+#define SF_MANUAL_OPFIFO_EMPTY		0xbfa10024
+#define SF_MANUAL_OPFIFO_WDATA		0xbfa10028
+#define SF_MANUAL_OPFIFO_FULL		0xbfa1002c
+#define SF_MANUAL_OPFIFO_WR		0xbfa10030
+#define SF_MANUAL_DFIFO_FULL		0xbfa10034
+#define SF_MANUAL_DFIFO_WDATA		0xbfa10038
+#define SF_MANUAL_DFIFO_EMPTY		0xbfa1003c
+#define SF_MANUAL_DFIFO_RD		0xbfa10040
+#define SF_MANUAL_DFIFO_RDATA		0xbfa10044
+#define SF_SI_CK_SEL			0xbfa1009c
+#define SF_STRAP			0xbfa10114
+
+#define OP_CSH				0x00
+#define OP_CSL				0x01
+#define OP_CK				0x02
+#define OP_OUTS				0x08
+#define OP_INS				0x0c
+
+#define SF_OP_RD_DATA			0x03
+#define SF_OP_RD_PAGE			0x13
+#define SF_OP_GET_FEATURE		0x0f
+#define SF_COMMAND_STATUS		0xc0
+#define SF_STATUS_OIP			0x01
+
+#define OP_SHIFT			9
+#define OP_CMD_MASK			0x1f
+#define OP_LEN_MASK			0x1ff
+
+	.section .text, "ax", @progbits
+	.set	noreorder
+
+	.globl	move_data_entry
+move_data_entry:
+	/* SFC serial-input clock selector. */
+	li	t1, SF_SI_CK_SEL
+	li	t2, 9
+	sw	t2, 0(t1)
+	nop
+
+	/* Leave the automatic reader and switch the SFC to manual mode. */
+	li	t1, SF_READ_IDLE_EN
+	sw	zero, 0(t1)
+	nop
+
+sfc_wait_idle:
+	li	t1, SF_RDCTL_FSM
+	lw	t7, 0(t1)
+	nop
+	bnez	t7, sfc_wait_idle
+	nop
+
+	li	t1, SF_MTX_MODE_TOG
+	li	t2, 9
+	sw	t2, 0(t1)
+	nop
+
+	li	t1, SF_MACMUX_SEL
+	li	t2, 1
+	sw	t2, 0(t1)
+	nop
+
+	li	t1, SF_MANUAL_EN
+	li	t2, 1
+	sw	t2, 0(t1)
+	nop
+
+	/*
+	 * Strap:
+	 *  bit 1: 0 = NOR, 1 = NAND
+	 *  bit 0: 0 = 3-byte, 1 = 4-byte addressing
+	 *  bit 2: dummy-byte placement
+	 */
+	li	t1, SF_STRAP
+	lw	t4, 0(t1)
+	nop
+	andi	t4, t4, 0x2
+
+	lw	t8, 0(t1)
+	nop
+	andi	t8, t8, 0x1
+
+	lw	t0, 0(t1)
+	nop
+	andi	t0, t0, 0x4
+
+start_load:
+	/* NOR has no PAGE READ / GET FEATURE stage. */
+	beqz	t4, read_data
+	nop
+
+load_page:
+	slt	t3, s2, s1
+	bnez	t3, load_done
+	nop
+
+	/* CS low. */
+	li	t5, OP_CSL
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	/* PAGE READ, 13h. */
+	li	t5, OP_OUTS
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	li	t5, SF_OP_RD_PAGE
+	jal	send_datafifo_write_cmd
+	nop
+
+	/*
+	 * EN751221 boot NAND is addressed as 2 KiB pages.
+	 * s1 is a bfc0xxxx flash mapping, not a zero-based offset.
+	 */
+	li	t6, 0xbfc00000
+	subu	t6, s1, t6
+	srl	t6, t6, 11
+
+	li	t5, OP_OUTS
+	li	t7, 3
+	jal	send_opfifo_write_cmd
+	nop
+
+	srl	t5, t6, 16
+	andi	t5, t5, 0xff
+	jal	send_datafifo_write_cmd
+	nop
+
+	srl	t5, t6, 8
+	andi	t5, t5, 0xff
+	jal	send_datafifo_write_cmd
+	nop
+
+	andi	t5, t6, 0xff
+	jal	send_datafifo_write_cmd
+	nop
+
+	li	t5, OP_CSH
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	li	t5, OP_CK
+	li	t7, 5
+	jal	send_opfifo_write_cmd
+	nop
+
+get_feature:
+	/* GET FEATURE C0h until OIP clears. */
+	li	t5, OP_CSL
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	li	t5, OP_OUTS
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	li	t5, SF_OP_GET_FEATURE
+	jal	send_datafifo_write_cmd
+	nop
+
+	li	t5, OP_OUTS
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	li	t5, SF_COMMAND_STATUS
+	jal	send_datafifo_write_cmd
+	nop
+
+	li	t5, OP_INS
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	jal	send_datafifo_read_cmd
+	nop
+	andi	t9, t5, SF_STATUS_OIP
+
+	li	t5, OP_CSH
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	li	t5, OP_CK
+	li	t7, 5
+	jal	send_opfifo_write_cmd
+	nop
+
+	bnez	t9, get_feature
+	nop
+
+read_data:
+	slt	t3, s2, s1
+	bnez	t3, load_done
+	nop
+
+	li	t5, OP_CSL
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	li	t5, 0xbfc00000
+	subu	t9, s1, t5
+
+	/* NAND cache reads use only the column part here. */
+	beqz	t4, address_ready
+	nop
+	andi	t9, t9, 0x7ff
+
+address_ready:
+	li	t5, OP_OUTS
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	li	t5, SF_OP_RD_DATA
+	jal	send_datafifo_write_cmd
+	nop
+
+	/* Optional fourth address byte used by the strap-selected mode. */
+	beqz	t8, three_byte_tail
+	nop
+
+	li	t5, OP_OUTS
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	srl	t5, t9, 24
+	andi	t5, t5, 0xff
+	jal	send_datafifo_write_cmd
+	nop
+
+three_byte_tail:
+	li	t5, OP_OUTS
+	li	t7, 3
+	jal	send_opfifo_write_cmd
+	nop
+
+	/* Dummy-prepend mode consumes the high column/address byte here. */
+	bnez	t0, dummy_append
+	nop
+
+	srl	t5, t9, 16
+	andi	t5, t5, 0xff
+	jal	send_datafifo_write_cmd
+	nop
+
+dummy_append:
+	srl	t5, t9, 8
+	andi	t5, t5, 0xff
+	jal	send_datafifo_write_cmd
+	nop
+
+	andi	t5, t9, 0xff
+	jal	send_datafifo_write_cmd
+	nop
+
+	/* Dummy-append mode supplies the third byte after the column. */
+	beqz	t0, read_one_byte
+	nop
+
+	move	t5, zero
+	jal	send_datafifo_write_cmd
+	nop
+
+read_one_byte:
+	slt	t3, s2, s1
+	bnez	t3, load_done
+	nop
+
+	li	t5, OP_INS
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	jal	send_datafifo_read_cmd
+	nop
+
+	sb	t5, 0(s3)
+	nop
+
+	addiu	s1, s1, 1
+	addiu	s3, s3, 1
+	addiu	t9, t9, 1
+
+	/*
+	 * Preserve the SDK's 1 KiB cache-read chunks even though the
+	 * physical NAND page is 2 KiB.
+	 */
+	andi	t5, t9, 0x3ff
+	bnez	t5, read_one_byte
+	nop
+
+	li	t5, OP_CSH
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	li	t5, OP_CK
+	li	t7, 5
+	jal	send_opfifo_write_cmd
+	nop
+
+	b	start_load
+	nop
+
+load_done:
+	li	t5, OP_CSH
+	li	t7, 1
+	jal	send_opfifo_write_cmd
+	nop
+
+	li	t5, OP_CK
+	li	t7, 5
+	jal	send_opfifo_write_cmd
+	nop
+
+	jr	s4
+	nop
+
+send_datafifo_read_cmd:
+	li	t1, SF_MANUAL_DFIFO_EMPTY
+1:
+	lw	t2, 0(t1)
+	nop
+	li	t3, 1
+	beq	t2, t3, 1b
+	nop
+
+	li	t1, SF_MANUAL_DFIFO_RDATA
+	lw	t5, 0(t1)
+	nop
+	andi	t5, t5, 0xff
+
+	li	t1, SF_MANUAL_DFIFO_RD
+	li	t2, 1
+	sw	t2, 0(t1)
+	nop
+
+	jr	ra
+	nop
+
+send_opfifo_write_cmd:
+	andi	t2, t5, OP_CMD_MASK
+	sll	t2, t2, OP_SHIFT
+	andi	t3, t7, OP_LEN_MASK
+	or	t2, t2, t3
+
+	li	t1, SF_MANUAL_OPFIFO_WDATA
+	sw	t2, 0(t1)
+	nop
+
+	li	t1, SF_MANUAL_OPFIFO_FULL
+1:
+	lw	t2, 0(t1)
+	nop
+	bnez	t2, 1b
+	nop
+
+	li	t1, SF_MANUAL_OPFIFO_WR
+	li	t2, 1
+	sw	t2, 0(t1)
+	nop
+
+	li	t1, SF_MANUAL_OPFIFO_EMPTY
+1:
+	lw	t2, 0(t1)
+	nop
+	beqz	t2, 1b
+	nop
+
+	jr	ra
+	nop
+
+send_datafifo_write_cmd:
+	li	t1, SF_MANUAL_DFIFO_FULL
+1:
+	lw	t2, 0(t1)
+	nop
+	li	t3, 1
+	beq	t2, t3, 1b
+	nop
+
+	andi	t2, t5, 0xff
+	li	t1, SF_MANUAL_DFIFO_WDATA
+	sw	t2, 0(t1)
+	nop
+
+	jr	ra
+	nop
diff --git a/arch/mips/mach-econet/flash/en751221/move_data.lds b/arch/mips/mach-econet/flash/en751221/move_data.lds
