+	 nop
+
+	li	a0, ((SF_OP_OUTS << SF_OP_SHIFT) | 1)
+	bal	s1_sf_op
+	 nop
+
+	li	a0, 0x13
+	bal	s1_put_byte
+	 nop
+
+	li	a0, ((SF_OP_OUTS << SF_OP_SHIFT) | 3)
+	bal	s1_sf_op
+	 nop
+
+	/* DDR blob occupies NAND pages 0x10..0x19. */
+	move	a0, zero
+	bal	s1_put_byte
+	 nop
+
+	move	a0, zero
+	bal	s1_put_byte
+	 nop
+
+	move	a0, s0
+	bal	s1_put_byte
+	 nop
+
+	bal	s1_finish
+	 nop
+
