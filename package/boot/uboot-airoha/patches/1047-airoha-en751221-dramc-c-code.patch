+	for (shift = 28; shift >= 0; shift -= 4) {
+		unsigned int digit = (value >> shift) & 0xf;
+
+		serial_outc(digit < 10 ? '0' + digit : 'a' + digit - 10);
+	}
+}
+
 static void __attribute__((noreturn)) fail(const char *why)
 {
