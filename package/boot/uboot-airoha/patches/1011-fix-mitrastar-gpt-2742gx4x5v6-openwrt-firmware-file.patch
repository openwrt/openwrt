From 08d63543f25fccde7af8fdaaf2d97bb74dc75d83 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Wed, 8 Jul 2026 13:01:16 -0300
Subject: [PATCH 1011/1018] fix mitrastar gpt-2742gx4x5v6 openwrt firmware file

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 defenvs/en7523-mitrastar_gpt_2742gx4x5v6_env  |  4 +-
 .../en7523-mitrastar_gpt_2742gx4x5v6.dts      | 63 ++++++++++++++++++-
 dts/upstream/src/arm/airoha/en7523.dtsi       |  1 +
 3 files changed, 64 insertions(+), 4 deletions(-)

diff --git a/defenvs/en7523-mitrastar_gpt_2742gx4x5v6_env b/defenvs/en7523-mitrastar_gpt_2742gx4x5v6_env
index aa27c061724..89f438a0b69 100644
--- a/defenvs/en7523-mitrastar_gpt_2742gx4x5v6_env
+++ b/defenvs/en7523-mitrastar_gpt_2742gx4x5v6_env
@@ -1,10 +1,10 @@
 loadaddr=0x89400000
 ipaddr=192.168.1.1
 serverip=192.168.1.10
-bootled_pwr=green:power
+bootled_pwr=blue:power
 
 bootconf=config-1
-bootfile=openwrt-airoha-en7523-askey_rtf8225vw-initramfs-kernel.bin
+bootfile=openwrt-airoha-en7523-mitrastar-gpt-2742gx4x5v6-initramfs-kernel.bin
 
 boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
 ubi_read_openwrt=ubi read $loadaddr fit && iminfo $loadaddr
diff --git a/dts/upstream/src/arm/airoha/en7523-mitrastar_gpt_2742gx4x5v6.dts b/dts/upstream/src/arm/airoha/en7523-mitrastar_gpt_2742gx4x5v6.dts
index 4ab6134c481..30e818022e1 100644
--- a/dts/upstream/src/arm/airoha/en7523-mitrastar_gpt_2742gx4x5v6.dts
+++ b/dts/upstream/src/arm/airoha/en7523-mitrastar_gpt_2742gx4x5v6.dts
@@ -2,7 +2,7 @@
 /dts-v1/;
 
 #include <dt-bindings/input/linux-event-codes.h>
-#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
 #include "en7523.dtsi"
 
 / {
@@ -23,7 +23,6 @@
 		device_type = "memory";
 		reg = <0x80000000 0x20000000>;
 	};
-
 	keys {
 		compatible = "gpio-keys";
 
@@ -48,6 +47,66 @@
 			debounce-interval = <60>;
 		};
 	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		// red:internet
+		led_pon: led@3 {
+			function = LED_FUNCTION_WAN_ONLINE;
+			function-enumerator = <3>;
+			color = <LED_COLOR_ID_RED>;
+			gpios = <&pinctrl 3 GPIO_ACTIVE_HIGH>;
+		};
+
+		// blue:internet
+		led_power: led@10 {
+			function = LED_FUNCTION_WAN_ONLINE;
+			function-enumerator = <10>;
+			color = <LED_COLOR_ID_BLUE>;
+			gpios = <&pinctrl 10 GPIO_ACTIVE_LOW>;
+		};
+
+		// blue:wlan-2g
+		led@9 {
+			function = LED_FUNCTION_WLAN_2GHZ;
+			function-enumerator = <9>;
+			color = <LED_COLOR_ID_BLUE>;
+			gpios = <&pinctrl 9 GPIO_ACTIVE_LOW>;
+		};
+
+		// blue:wlan-5g
+		led@21 {
+			function = LED_FUNCTION_WLAN_5GHZ;
+			function-enumerator = <21>;
+			color = <LED_COLOR_ID_BLUE>;
+			gpios = <&pinctrl 21 GPIO_ACTIVE_LOW>;
+		};
+
+		// green:fxs
+		led@1 {
+			function = LED_FUNCTION_ACTIVITY;
+			function-enumerator = <1>;
+			color = <LED_COLOR_ID_GREEN>;
+			gpios = <&pinctrl 1 GPIO_ACTIVE_LOW>;
+		};
+
+		// red:fxs
+		led@26 {
+			function = LED_FUNCTION_ACTIVITY;
+			function-enumerator = <26>;
+			color = <LED_COLOR_ID_RED>;
+			gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
+		};
+
+		// blue:fxs
+		led@27 {
+			function = LED_FUNCTION_ACTIVITY;
+			function-enumerator = <27>;
+			color = <LED_COLOR_ID_BLUE>;
+			gpios = <&pinctrl 27 GPIO_ACTIVE_LOW>;
+		};
+	};
 };
 
 &pcie0 {
diff --git a/dts/upstream/src/arm/airoha/en7523.dtsi b/dts/upstream/src/arm/airoha/en7523.dtsi
index 620d92a62b1..3a10ffb6953 100644
--- a/dts/upstream/src/arm/airoha/en7523.dtsi
+++ b/dts/upstream/src/arm/airoha/en7523.dtsi
@@ -3,6 +3,7 @@
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
 #include <dt-bindings/clock/en7523-clk.h>
 #include <dt-bindings/reset/airoha,en7523-reset.h>
 
-- 
2.55.0

