 .../dts/econet,en751221-nokia_g240g-e.dts     |    2 +-
 arch/mips/dts/econet,en751221.dtsi            |   19 +-
 arch/mips/dts/econet,en7528.dtsi              |   39 +-
 arch/mips/mach-econet/Kconfig                 |    4 +
 drivers/pinctrl/airoha/Kconfig                |   18 +-
 drivers/pinctrl/airoha/Makefile               |    2 +
 drivers/pinctrl/airoha/airoha-common.h        |    9 +
 drivers/pinctrl/airoha/pinctrl-airoha.c       |   71 +-
 drivers/pinctrl/airoha/pinctrl-en751221.c     |  851 +++++++++++++
 drivers/pinctrl/airoha/pinctrl-en7528.c       | 1062 +++++++++++++++++
 10 files changed, 2044 insertions(+), 33 deletions(-)
 create mode 100644 drivers/pinctrl/airoha/pinctrl-en751221.c
 create mode 100644 drivers/pinctrl/airoha/pinctrl-en7528.c

diff --git a/arch/mips/dts/econet,en751221-nokia_g240g-e.dts b/arch/mips/dts/econet,en751221-nokia_g240g-e.dts
