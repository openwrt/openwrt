 			current-speed = <115200>;
+
 			status = "disabled";
 		};
 
@@ -57,25 +79,32 @@
 			compatible = "airoha,en7523-spi";
 			reg = <0x1fa10000 0x140>,
 			      <0x1fa11000 0x600>;
+
+			clocks = <&scuclk EN7528_CLK_SPI>;
+			clock-names = "spi";
+
