 			#size-cells = <0>;
+
 			status = "disabled";
 		};
 
 		eth: ethernet@1fb50000 {
 			compatible = "econet,en7528-eth";
+			status = "disabled";
 			reg = <0x1fb50000 0x2600>,
 			      <0x1fb54000 0x1000>,
 			      <0x1fb55000 0x1000>,
