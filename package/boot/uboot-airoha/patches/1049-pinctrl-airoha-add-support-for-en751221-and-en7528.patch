-				gpio-ranges = <&pinctrl 0 13 29>;
+				gpio-ranges = <&pinctrl 0 13 31>;
 
 				interrupt-controller;
 				#interrupt-cells = <2>;
@@ -73,16 +73,23 @@
 		uart0: serial@1fbf0000 {
 			compatible = "econet,en751221-uart";
 			reg = <0x1fbf0000 0x30>;
+
 			clock-frequency = <20000000>;
 			current-speed = <115200>;
