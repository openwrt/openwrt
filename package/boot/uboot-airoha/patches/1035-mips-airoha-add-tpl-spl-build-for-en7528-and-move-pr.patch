+
+	name = airoha_soc_variant_name_mips(pdidr_pkg, pkgid, np_scu_cfg,
+					     chip_scu_174, chip_scu_1ec,
+					     efuse0, efuse1);
+	if (name)
+		return name;
+
+	name = airoha_pkg_family_name(hir_pkg);
+	if (name)
+		return name;
+
+	name = airoha_pkg_family_name(pdidr_pkg);
+	if (name)
+		return name;
+
+	return "unknown";
+}
