+
+	return !!(value & BIT(1));
+}
+
+static inline bool airoha_efuse_is_ens_mod(u32 value)
+{
+	if (value & BIT(3))
+		return !!(value & BIT(6));
+
+	return !!(value & BIT(2));
+}
