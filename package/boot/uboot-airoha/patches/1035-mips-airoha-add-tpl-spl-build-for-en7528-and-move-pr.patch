 configs/en7528_reference_defconfig            |  15 +
 configs/en7528_tplink_xc220_g3v_defconfig     |  15 +
 include/soc/airoha/pkgids.h                   | 383 +++++++++++++++++-
 14 files changed, 536 insertions(+), 75 deletions(-)
 create mode 100644 arch/mips/dts/econet,en7528-reference-u-boot.dtsi
