diff --git a/defenvs/en7523-askey-rtf8225vw_env b/defenvs/en7523-askey-rtf8225vw_env
index aa27c061724..162acad3341 100644
--- a/defenvs/en7523-askey-rtf8225vw_env
+++ b/defenvs/en7523-askey-rtf8225vw_env
@@ -1,26 +1,33 @@
 loadaddr=0x89400000
 ipaddr=192.168.1.1
 serverip=192.168.1.10
-bootled_pwr=green:power
+bootled_pwr=blue:wan-online-8
 
 bootconf=config-1
 bootfile=openwrt-airoha-en7523-askey_rtf8225vw-initramfs-kernel.bin
+bootloaderfile=openwrt-airoha-en7523-askey_rtf8225vw-uboot-bootloader.bin
 
 boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
 ubi_read_openwrt=ubi read $loadaddr fit && iminfo $loadaddr
 
-boot_openwrt=led $bootled_pwr blink 155; run ubi_read_openwrt && bootm $loadaddr#$bootconf ; led $bootled_pwr off
+boot_openwrt=led $bootled_pwr blink 255; ( run ubi_read_openwrt || echo Install openwrt ; run boot_tftp ) && bootm $loadaddr#$bootconf ; led $bootled_pwr on
 boot_ubi=ubi part ubi && run boot_openwrt
 
+upgrade_uboot=\
+  mw.b 0x896C0000 0xff 0x100000 && tftpboot 0x896C0000 ${bootloaderfile} && \
+  mtd erase u-boot && mtd write u-boot 0x896C0000
+
 format_ubi_part=\
-  mtd read spi-nand0 0x89400000 0x50c0000 0x40000 && \  # bootenv0
-  mtd read spi-nand0 0x89440000 0x5100000 0x40000 && \  # bootenv1
-  mtd read spi-nand0 0x89480000 0x6dc0000 0x240000 && \ # ART/reservearea
+  mtd read spi-nand0 0x89400000 0x50c0000 0x040000 && \
+  mtd read spi-nand0 0x89440000 0x5100000 0x040000 && \
+  mtd read spi-nand0 0x89480000 0x6dc0000 0x240000 && \
   \
   mtd erase ubi && ubi part ubi && \
-  ubi create ubootenv 0x40000 && ubi write 0x89400000 ubootenv 0x400000 && \
-  ubi create ubootenv2 0x40000 && ubi write 0x89440000 ubootenv2 0x400000 && \
-  ubi create art 0x400000 && ubi write 0x89480000 art 0x400000
+  ubi create ubootenv 0x40000 && \
+  ubi create ubootenv2 0x40000 && \
+  ubi create art 0x400000 && ubi write 0x89480000 art 0x400000 && \
+  (env import -b 0x89400000 0x040000 ethaddr asp_gpon_sn asp_gpon_pw || env import -b 0x89440000 0x040000 ethaddr asp_gpon_sn asp_gpon_pw) && \
+  saveenv && saveenv && run upgrade_uboot
 
 bootcmd=run boot_ubi
 bootdelay=3
@@ -30,5 +37,6 @@ bootmenu_delay=3
 bootmenu_title=      34m( ( ( mOpenWrt34m ) ) )
 bootmenu_0=Run default boot command.=run boot_openwrt
 bootmenu_1=Boot system via TFTP.=run boot_tftp ; run bootmenu_confirm_return
-bootmenu_3=Format UBI partition.=ubi info ubi && (echo not require format again) || (run format_ubi_part && echo now install openwrt with initramfs)
+bootmenu_2=Format UBI partition and install openwrt u-boot.=ubi info ubi && (echo not require format again) || (run format_ubi_part && echo now install openwrt with initramfs)
+bootmenu_3=Upgrade u-boot.=run upgrade_uboot
 bootmenu_5=Reboot.=reset
