diff --git a/defenvs/en7523-mitrastar_gpt_2742gx4x5v6_env b/defenvs/en7523-mitrastar_gpt_2742gx4x5v6_env
new file mode 100644
index 00000000000..aa27c061724
--- /dev/null
+++ b/defenvs/en7523-mitrastar_gpt_2742gx4x5v6_env
@@ -0,0 +1,34 @@
+loadaddr=0x89400000
+ipaddr=192.168.1.1
+serverip=192.168.1.10
+bootled_pwr=green:power
+
+bootconf=config-1
+bootfile=openwrt-airoha-en7523-askey_rtf8225vw-initramfs-kernel.bin
+
+boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
+ubi_read_openwrt=ubi read $loadaddr fit && iminfo $loadaddr
+
+boot_openwrt=led $bootled_pwr blink 155; run ubi_read_openwrt && bootm $loadaddr#$bootconf ; led $bootled_pwr off
+boot_ubi=ubi part ubi && run boot_openwrt
+
+format_ubi_part=\
+  mtd read spi-nand0 0x89400000 0x50c0000 0x40000 && \  # bootenv0
+  mtd read spi-nand0 0x89440000 0x5100000 0x40000 && \  # bootenv1
+  mtd read spi-nand0 0x89480000 0x6dc0000 0x240000 && \ # ART/reservearea
+  \
+  mtd erase ubi && ubi part ubi && \
+  ubi create ubootenv 0x40000 && ubi write 0x89400000 ubootenv 0x400000 && \
+  ubi create ubootenv2 0x40000 && ubi write 0x89440000 ubootenv2 0x400000 && \
+  ubi create art 0x400000 && ubi write 0x89480000 art 0x400000
+
+bootcmd=run boot_ubi
+bootdelay=3
+bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 20
+bootmenu_default=0
+bootmenu_delay=3
+bootmenu_title=      34m( ( ( mOpenWrt34m ) ) )
+bootmenu_0=Run default boot command.=run boot_openwrt
+bootmenu_1=Boot system via TFTP.=run boot_tftp ; run bootmenu_confirm_return
+bootmenu_3=Format UBI partition.=ubi info ubi && (echo not require format again) || (run format_ubi_part && echo now install openwrt with initramfs)
+bootmenu_5=Reboot.=reset
diff --git a/dts/upstream/src/arm/airoha/en7523-mitrastar_gpt_2742gx4x5v6.dts b/dts/upstream/src/arm/airoha/en7523-mitrastar_gpt_2742gx4x5v6.dts
new file mode 100644
index 00000000000..4ab6134c481
--- /dev/null
+++ b/dts/upstream/src/arm/airoha/en7523-mitrastar_gpt_2742gx4x5v6.dts
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/dts-v1/;
+
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/gpio/gpio.h>
+#include "en7523.dtsi"
+
+/ {
+	model = "MitraStar GPT-2742GX4X5v6";
+	compatible = "mitrastar,gpt-2742gx4x5v6", "airoha,en7523";
+
+	aliases {
+		serial0 = &uart1;
+	};
+
+	chosen {
+		bootargs = "console=ttyS0,115200 earlycon";
+		stdout-path = "serial0:115200n8";
+		linux,usable-memory-range = <0x80200000 0x1fe00000>;
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x20000000>;
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
+			debounce-interval = <60>;
+		};
+
+		wps5 {
+			label = "wps5";
+			linux,code = <KEY_WPS_BUTTON>;
+			gpios = <&pinctrl 8 GPIO_ACTIVE_LOW>;
+			debounce-interval = <60>;
+		};
+
+		wps2 {
+			label = "wps2";
+			linux,code = <KEY_WPS_BUTTON>;
+			gpios = <&pinctrl 11 GPIO_ACTIVE_LOW>;
+			debounce-interval = <60>;
+		};
+	};
+};
+
+&pcie0 {
+	status = "okay";
+};
+
+&pcie1 {
+	status = "okay";
+};
+
+&snfi {
+	status = "okay";
+};
+
+&eth {
+	status = "okay";
+};
+
+&gdm1 {
+	status = "okay";
+};
+
+&spi_nand {
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0 {
+			label = "u-boot";
+			reg = <0x00000000 0x00100000>;
+			read-only;
+		};
+
+		partition@100000 {
+			label = "ubi";
+			compatible = "linux,ubi";
+			reg = <0x00100000 0x10000000>;
+		};
+	};
+};
