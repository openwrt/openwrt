From 10167cb1ba948b0a10de0f4566dc6ba25b3e1feb Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Fri, 18 Sep 2026 22:16:22 +0000
Subject: [PATCH] tools: econet: fill chainloader per-block CRC table

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 tools/build-econet-chainloader.sh |  2 +-
 tools/econet_chainloader_image.py | 32 +++++++++++++++++++++++--------
 2 files changed, 25 insertions(+), 9 deletions(-)

diff --git a/tools/build-econet-chainloader.sh b/tools/build-econet-chainloader.sh
index 7275f4262d6..d55607181c0 100755
--- a/tools/build-econet-chainloader.sh
+++ b/tools/build-econet-chainloader.sh
@@ -28,5 +28,5 @@ flags="$endian -mabi=32 -mips32r2 -msoft-float -mno-abicalls -fno-pic -fno-pie \
  -Map "$build/chainloader.map" -o "$build/chainloader.elf" \
  "$build/start.o" "$build/chainloader.o"
 "$objcopy" -O binary "$build/chainloader.elf" "$out"
-# Self-check word plus padding to the BootROM's XMODEM block size.
+# Per-128-byte self-check table plus padding to the BootROM XMODEM block size.
 "${PYTHON3:-python3}" "$srctree/tools/econet_chainloader_image.py" "$out"
diff --git a/tools/econet_chainloader_image.py b/tools/econet_chainloader_image.py
index 440210d244c..3b218b70b34 100755
--- a/tools/econet_chainloader_image.py
+++ b/tools/econet_chainloader_image.py
@@ -2,9 +2,10 @@
 # SPDX-License-Identifier: GPL-2.0+
 """Finalize the EN751221 chainloader binary.
 
-The BootROM validates its XMODEM download with an 8-bit checksum, which lets
-corruption through, so the last loaded word holds a CRC32 of everything before
-it and the chainloader verifies itself in DRAM before doing anything else.
+The chainloader reserves a CRC32 table at the end of its loadable image.  Each
+entry covers one 128-byte chunk of everything before the table, matching the
+self_check() implementation in arch/mips/mach-econet/chainloader/chainloader.c.
+The remaining table entries stay zero.
 
 The image is then padded to a multiple of 128 bytes so the BootROM does not
 invent padding of its own on top of .bss.
@@ -14,16 +15,31 @@ import struct
 import sys
 
 XMODEM_BLOCK = 128
+CRC_TABLE_ENTRIES = 96
+CRC_TABLE_SIZE = CRC_TABLE_ENTRIES * 4
 
 path = sys.argv[1]
 data = bytearray(open(path, 'rb').read())
-if len(data) < 8:
+if len(data) <= CRC_TABLE_SIZE:
     sys.exit('chainloader image too short')
 
-crc = binascii.crc32(bytes(data[:-4])) & 0xffffffff
-data[-4:] = struct.pack('>I', crc)          # MIPS big-endian
+chk_start = len(data) - CRC_TABLE_SIZE
+nchunks = (chk_start + XMODEM_BLOCK - 1) // XMODEM_BLOCK
+if nchunks > CRC_TABLE_ENTRIES:
+    sys.exit('chainloader CRC table too small')
+
+# .imgchk is linked as zero-filled storage.  Fill one big-endian CRC32 entry
+# per 128-byte chunk of the image preceding the table.
+data[chk_start:] = b'\x00' * CRC_TABLE_SIZE
+for i in range(nchunks):
+    start = i * XMODEM_BLOCK
+    end = min(start + XMODEM_BLOCK, chk_start)
+    crc = binascii.crc32(bytes(data[start:end])) & 0xffffffff
+    off = chk_start + i * 4
+    data[off:off + 4] = struct.pack('>I', crc)
+
 pad = (-len(data)) % XMODEM_BLOCK
 data += b'\x00' * pad
 open(path, 'wb').write(bytes(data))
-print('  CHAIN   %s: len=0x%x crc32=0x%08x size=%d'
-      % (path, len(data) - pad - 4, crc, len(data)))
+print('  CHAIN   %s: checked=0x%x blocks=%d table=%d size=%d'
+      % (path, chk_start, nchunks, CRC_TABLE_ENTRIES, len(data)))
-- 
