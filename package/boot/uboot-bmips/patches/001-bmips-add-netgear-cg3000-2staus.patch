+
+obj-y += cg3000_2staus.o
+obj-$(CONFIG_MIPS_MACH_EARLY_INIT) += lowlevel_init.o
--- /dev/null
+++ b/board/netgear/cg3000_2staus/cg3000_2staus.c
@@ -0,0 +1,6 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+/*
+ * The CG3000 second-stage loader only needs the common BMIPS init path and
+ * device-tree described UART/NAND devices.
+ */
--- /dev/null
+++ b/board/netgear/cg3000_2staus/lowlevel_init.S
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+
+#include <asm/asm.h>
+#include <asm/regdef.h>
+
+/* CP0 Broadcom Config ($22 select 0), matching Linux bcm3383_quirks(). */
+#define CP0_BRCM_CONFIG_ICSHEN	(1 << 31)
+#define CP0_BRCM_CONFIG_DCSHEN	(1 << 30)
+
+	.set noreorder
+
+LEAF(mips_mach_early_init)
+	/*
+	 * Generic MIPS cache setup updates Config.K0 later.  BMIPS also needs
+	 * these Broadcom-private shadow enable bits before cache initialization.
+	 */
+	mfc0	t0, $22, 0
+	li	t1, (CP0_BRCM_CONFIG_ICSHEN | CP0_BRCM_CONFIG_DCSHEN)
+	or	t0, t0, t1
+	mtc0	t0, $22, 0
+	ehb
+	jr	ra
+	 nop
+END(mips_mach_early_init)
--- /dev/null
+++ b/configs/netgear_cg3000_2staus_ram_defconfig
@@ -0,0 +1,68 @@
