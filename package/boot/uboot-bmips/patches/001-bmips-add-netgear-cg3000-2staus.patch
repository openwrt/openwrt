From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hang Zhou <929513338@qq.com>
Date: Sat, 18 Jul 2026 00:00:00 +0000
Subject: [PATCH] bmips: add Netgear CG3000-2STAUS RAM target

Add a minimal RAM-loaded second-stage U-Boot target for the BCM3383-based
Netgear CG3000-2STAUS.  The target reuses the existing BMIPS BCM6838 NAND
controller support because the BCM3383 NAND register layout matches the
same Broadcom NAND controller family closely enough for the boot path.

The only required runtime devices are UART0 and NAND.  The default boot
command attaches the image2-to-end-of-NAND partition as UBI, reads the
kernel volume, and boots it as a legacy uImage.

Signed-off-by: Hang Zhou <929513338@qq.com>
---
 arch/mips/dts/Makefile                        |  1 +
 arch/mips/dts/netgear,cg3000-2staus.dts       | 69 ++++++++++++++++++
 arch/mips/mach-bmips/Kconfig                  | 15 ++++
 board/netgear/cg3000_2staus/Kconfig           | 12 ++++
 board/netgear/cg3000_2staus/MAINTAINERS       |  6 ++
 board/netgear/cg3000_2staus/Makefile          |  4 ++
 board/netgear/cg3000_2staus/cg3000_2staus.c   |  6 ++
 board/netgear/cg3000_2staus/lowlevel_init.S   | 24 +++++++
 configs/netgear_cg3000_2staus_ram_defconfig   | 63 +++++++++++++++++
 include/configs/netgear_cg3000_2staus.h       |  8 +++
 10 files changed, 208 insertions(+)
 create mode 100644 arch/mips/dts/netgear,cg3000-2staus.dts
 create mode 100644 board/netgear/cg3000_2staus/Kconfig
create mode 100644 board/netgear/cg3000_2staus/MAINTAINERS
create mode 100644 board/netgear/cg3000_2staus/Makefile
create mode 100644 board/netgear/cg3000_2staus/cg3000_2staus.c
create mode 100644 board/netgear/cg3000_2staus/lowlevel_init.S
create mode 100644 configs/netgear_cg3000_2staus_ram_defconfig
create mode 100644 include/configs/netgear_cg3000_2staus.h

--- a/arch/mips/dts/Makefile
+++ b/arch/mips/dts/Makefile
@@ -29,6 +29,7 @@ dtb-$(CONFIG_BOARD_VOCORE2) += vocore_vo
 dtb-$(CONFIG_SOC_LUTON) += luton_pcb090.dtb luton_pcb091.dtb
 dtb-$(CONFIG_SOC_OCELOT) += ocelot_pcb120.dtb ocelot_pcb123.dtb
 dtb-$(CONFIG_SOC_JR2) += jr2_pcb110.dtb jr2_pcb111.dtb serval2_pcb112.dtb
+dtb-$(CONFIG_BOARD_NETGEAR_CG3000_2STAUS) += netgear,cg3000-2staus.dtb
 dtb-$(CONFIG_SOC_SERVALT) += servalt_pcb116.dtb
 dtb-$(CONFIG_SOC_SERVAL) += serval_pcb105.dtb serval_pcb106.dtb
 
--- /dev/null
+++ b/arch/mips/dts/netgear,cg3000-2staus.dts
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+/dts-v1/;
+
+#include "brcm,bcm6838.dtsi"
+
+/ {
+	model = "Netgear CG3000-2STAUS";
+	compatible = "netgear,cg3000-2staus", "brcm,bcm3383",
+		     "brcm,bcm6838";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+&memory {
+	force-size = <0x08000000>;
+};
+
+&uart0 {
+	bootph-all;
+	status = "okay";
+};
+
+&nand {
+	/*
+	 * BCM3383 exposes the same Broadcom NAND controller block as the
+	 * BCM6838 U-Boot driver, but the NAND interrupt-base window is at
+	 * 0x14e00070 on BCM3383, matching the working Linux device tree.
+	 */
+	compatible = "brcm,nand-bcm6838", "brcm,brcmnand-v5.0",
+		     "brcm,brcmnand";
+	reg-names = "nand", "nand-int-base", "nand-cache";
+	reg = <0x14e02200 0x400>, <0x14e00070 0x10>, <0x14e02600 0x200>;
+	status = "okay";
+
+	nandcs@0 {
+		compatible = "brcm,nandcs";
+		reg = <0>;
+		brcm,nand-ecc-use-strap;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "linuxapps";
+				reg = <0x00000000 0x01f40000>;
+				read-only;
+			};
+
+			partition@1f40000 {
+				label = "image1";
+				reg = <0x01f40000 0x00900000>;
+			};
+
+			partition@2840000 {
+				label = "image2";
+				reg = <0x02840000 0x057c0000>;
+			};
+		};
+	};
+};
--- a/arch/mips/mach-bmips/Kconfig
+++ b/arch/mips/mach-bmips/Kconfig
@@ -110,6 +110,20 @@ config BOARD_BROADCOM_BCM968380GERG
 	  ethernet ports, 2 USB ports, 1 UART, GPIO buttons and LEDs, and
 	  a BCM43217 (PCIe).
 
+config BOARD_NETGEAR_CG3000_2STAUS
+	bool "Netgear CG3000-2STAUS"
+	depends on SOC_BMIPS_BCM6838
+	select BMIPS_SUPPORTS_BOOT_RAM
+	help
+	  Netgear CG3000-2STAUS boards have a BCM3383 SoC with 128 MB of
+	  RAM, SPI NOR for bootloader/nonvol storage, and NAND for the
+	  runtime firmware images.
+
+	  This target intentionally reuses the existing BCM6838 U-Boot SoC
+	  support for the minimal second-stage boot path.  It only needs UART0
+	  and the Broadcom NAND controller so it can load an OpenWrt kernel
+	  image from UBI.
+
 config BOARD_COMTREND_AR5315U
 	bool "Comtrend AR-5315u"
 	depends on SOC_BMIPS_BCM6318
@@ -254,6 +268,7 @@ config BMIPS_SUPPORTS_BOOT_RAM
 	bool
 
 source "board/broadcom/bcm968380gerg/Kconfig"
+source "board/netgear/cg3000_2staus/Kconfig"
 source "board/comtrend/ar5315u/Kconfig"
 source "board/comtrend/ar5387un/Kconfig"
 source "board/comtrend/ct5361/Kconfig"
--- /dev/null
+++ b/board/netgear/cg3000_2staus/Kconfig
@@ -0,0 +1,12 @@
