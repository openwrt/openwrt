--- /dev/null
+++ b/defenvs/urant_u28_ax3000_env
@@ -0,0 +1,19 @@
+# U28-AX3000 default environment.
+# Persistent environment remains in the vendor u-boot-env MTD partition.
+
+bootmenu_default=3
+bootmenu_delay=2
+
+bootmenu_0=Flash preloader (BL2)=sf probe && tftpboot 0x42000000 openwrt-mediatek-filogic-urant_u28_ax3000-preloader.bin && sf erase 0x000000 0x040000 && sf write 0x42000000 0x000000 ${filesize}
+bootmenu_1=Flash u-boot (BL31)=sf probe && tftpboot 0x46000000 openwrt-mediatek-filogic-urant_u28_ax3000-bl31-uboot.fip && sf erase 0x100000 0x080000 && sf write 0x46000000 0x100000 ${filesize}
+bootmenu_2=Flash system (squashfs-sysupgrade)=sf probe && tftpboot 0x46000000 openwrt-mediatek-filogic-urant_u28_ax3000-squashfs-sysupgrade.itb && sf erase 0x180000 0xE80000 && sf write 0x46000000 0x180000 ${filesize}
+bootmenu_3=Boot openwrt=sf probe; sf read ${loadaddr} 0x180000 0xe80000; bootm ${loadaddr}#config-1
+
+loadaddr=0x46000000
+bootargs=console=ttyS0,115200n8 earlycon=uart8250,mmio32,0x11002000 root=/dev/fit0 rootwait
+bootcmd=bootmenu
+ipaddr=192.168.1.1
+serverip=192.168.1.2
+netmask=255.255.255.0
+ethaddr_factory=mtd read Factory 0x46000000 0xe000 0x6 && env readmem -b ethaddr 0x46000000 0x6 ; setenv ethaddr_factory
+preboot=if env info -d -q; then run ethaddr_factory; saveenv; fi
