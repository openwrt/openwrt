From b3dd98294a5ad431e2986ddb1a39d3c803f13089 Mon Sep 17 00:00:00 2001
From: Lucian Radu <lucianradu@hotmail.com>
Date: Tue, 29 Sep 2026 20:30:00 +0300
Subject: [PATCH] uboot-mediatek: add support for urant u28 ax3000

Signed-off-by: Lucian Radu <lucianradu@hotmail.com>
---
--- /dev/null
+++ b/arch/arm/dts/mt7981-urant-u28-ax3000.dts
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0
+/dts-v1/;
+
+/*
+ * URANT U28-AX3000
+ *
+ * Re-use the upstream MT7981 NOR RFB hardware description and only add
+ * the U28 board identity plus the SPI NOR alias used by U-Boot's generic
+ * "sf probe" path.
+ */
+#include "mt7981-rfb.dts"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "URANT U28-AX3000";
+	compatible = "urant,u28-ax3000", "mediatek,mt7981";
+
+	aliases {
+		/* U28 boot NOR: MT7981 SPI controller at 0x11009000, CS0. */
+		spi0 = "/spi@11009000";
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led-red {
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&pio 8 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		led-green {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&pio 34 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led-blue {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&pio 35 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+	};
+};
+
+/* Disabling SPI NAND controller at 0x1100a000, as it is not used on the U28-AX3000 board. */
+&{/spi@1100a000} {
+	status = "disabled";
+};
