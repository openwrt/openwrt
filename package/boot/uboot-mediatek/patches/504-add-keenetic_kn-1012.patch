--- /dev/null
+++ b/defenvs/keenetic_kn-1012_env
@@ -0,0 +1,23 @@
+ipaddr=192.168.1.1
+serverip=192.168.1.2
+loadaddr=0x46000000
+bootconf=config-copper
+kernel_off=0x600000
+kernel_size=0x700000
+bootdelay=3
+bootfile=openwrt-mediatek-filogic-keenetic_kn-1012-initramfs-kernel.bin
+altbootfile=openwrt-mediatek-filogic-netcraze_nc-1012-initramfs-kernel.bin
+bootled=green:power
+bootcmd=run boot_kn1012
+boot_kn1012=run sfp_detect ; run boot_flash ; run boot_tftp_forever
+sfp_detect=if gpio input 23 ; then run media_sfp ; else run media_copper ; fi
+media_sfp=gpio clear 27 ; setenv bootconf config-sfp
+media_copper=gpio set 27 ; setenv bootconf config-copper
+boot_flash=mtd read nmbm0 $loadaddr $kernel_off $kernel_size && bootm $loadaddr#$bootconf
+boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf ; tftpboot $loadaddr $altbootfile && bootm $loadaddr#$bootconf
+boot_tftp_forever=led $bootled on ; while true ; do run boot_tftp ; sleep 1 ; done
+bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 60
+bootmenu_0=Run default boot command.=run bootcmd
+bootmenu_1=Boot system via TFTP.=run sfp_detect ; run boot_tftp ; run bootmenu_confirm_return
+bootmenu_2=Boot copper media.=run media_copper ; run boot_flash ; run bootmenu_confirm_return
+bootmenu_3=Boot SFP media.=run media_sfp ; run boot_flash ; run bootmenu_confirm_return
