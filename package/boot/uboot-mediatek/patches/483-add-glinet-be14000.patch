--- /dev/null
+++ b/defenvs/glinet_gl-be14000_env
@@ -0,0 +1,56 @@
+ipaddr=192.168.1.1
+serverip=192.168.1.254
+loadaddr=0x50000000
+fwaddr=0x46000000
+bootcmd=run boot_emmc
+bootdelay=3
+bootfile=openwrt-mediatek-filogic-glinet_gl-be14000-ubootmod-initramfs-kernel.bin
+bootfile_bl2=openwrt-mediatek-filogic-glinet_gl-be14000-ubootmod-preloader.bin
+bootfile_fip=openwrt-mediatek-filogic-glinet_gl-be14000-ubootmod-bl31-uboot.fip
+bootfile_firmware=openwrt-mediatek-filogic-glinet_gl-be14000-ubootmod-squashfs-factory.bin
+bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 60
+bootmenu_default=0
+bootmenu_delay=3
+bootmenu_title=      [0;34m( ( ( [1;39mOpenWrt[0;34m ) ) )[0m
+bootmenu_0=Initialize environment.=run _firstboot
+bootmenu_0d=Run default boot command.=run boot_default
+bootmenu_1=Boot system from eMMC.=run boot_emmc ; run bootmenu_confirm_return
+bootmenu_2=Boot system via TFTP.=run boot_tftp ; run bootmenu_confirm_return
+bootmenu_3=Load firmware via TFTP then write to eMMC.=run load_tftp_firmware ; run bootmenu_confirm_return
+bootmenu_4=[31mLoad BL31+U-Boot FIP via TFTP then write to eMMC.[0m=run boot_tftp_write_fip ; run bootmenu_confirm_return
+bootmenu_5=[31mLoad BL2 preloader via TFTP then write to eMMC.[0m=run boot_tftp_write_bl2 ; run bootmenu_confirm_return
+bootmenu_6=Reboot.=reset
+bootmenu_7=Reset all settings to factory defaults.=run reset_factory ; reset
+boot_first=if button reset ; then run boot_tftp ; setenv flag_recover 1 ; run boot_default ; fi ; bootmenu
+boot_default=if env exists flag_recover ; then else run bootcmd ; fi ; run boot_tftp_forever
+boot_emmc=run emmc_read_kernel && bootm $loadaddr
+boot_tftp_forever=while true ; do run boot_tftp ; sleep 1 ; done
+boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr
+load_tftp_firmware=tftpboot $loadaddr $bootfile_firmware && run emmc_write_firmware
+boot_tftp_write_fip=tftpboot $loadaddr $bootfile_fip && run emmc_write_fip
+boot_tftp_write_bl2=tftpboot $loadaddr $bootfile_bl2 && run emmc_write_bl2
+filesize_to_blk=setexpr cnt $filesize + 0x1ff && setexpr cnt $cnt / 0x200
+emmc_read_kernel=part start mmc 0 kernel part_addr && part size mmc 0 kernel part_size && mmc read $loadaddr $part_addr 0x100 && imszb $loadaddr image_size && test 0x$image_size -le 0x$part_size && mmc read $loadaddr $part_addr $image_size
+#
+# factory.bin is the kernel padded to the 32 MiB kernel partition with the
+# rootfs appended, so writing it from the start of that partition lands the
+# rootfs exactly on the rootfs partition that follows.
+#
+emmc_write_firmware=part start mmc 0 kernel part_addr && run filesize_to_blk && mmc write $loadaddr $part_addr $cnt
+emmc_write_fip=part start mmc 0 fip part_addr && part size mmc 0 fip part_size && run filesize_to_blk && test 0x$cnt -le 0x$part_size && mmc write $loadaddr $part_addr $cnt
+#
+# BL2 lives in the first eMMC hardware boot partition, which is read only until
+# partconf unlocks it. The trailing partconf puts the board back to booting from
+# it, so a failed write cannot leave the board pointing at the wrong partition.
+#
+emmc_write_bl2=run filesize_to_blk && test 0x$cnt -le 0x2000 && mmc partconf 0 1 1 1 && mmc write $loadaddr 0x0 $cnt ; mmc partconf 0 1 1 0
+#
+# The MAC base sits at 0x4000 in the factory partition. gmac0, the port U-Boot
+# drives, is base plus two, matching the kernel nvmem cell.
+#
+ethaddr_factory=part start mmc 0 factory part_addr && mmc read $fwaddr $part_addr 0x100 && setexpr.b maclow *0x46004005 + 2 && mw.b 0x46004005 $maclow && env readmem -b ethaddr 0x46004000 0x6 ; setenv maclow ; setenv ethaddr_factory
+reset_factory=eraseenv && reset
+_init_env=setenv _init_env ; saveenv ; saveenv
+_firstboot=setenv _firstboot ; run ethaddr_factory ; run _switch_to_menu ; run _init_env ; run boot_first
+_switch_to_menu=setenv _switch_to_menu ; setenv bootdelay 3 ; setenv bootmenu_delay 3 ; setenv bootmenu_0 $bootmenu_0d ; setenv bootmenu_0d ; run _bootmenu_update_title
+_bootmenu_update_title=setenv _bootmenu_update_title ; setenv bootmenu_title "$bootmenu_title       [33m$ver[0m"
