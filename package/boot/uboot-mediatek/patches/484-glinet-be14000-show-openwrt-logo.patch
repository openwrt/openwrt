+++ b/configs/mt7988a_glinet_gl-be14000_defconfig
@@ -43,6 +43,7 @@ CONFIG_CMD_RNG=y
 CONFIG_CMD_STRINGS=y
 CONFIG_CMD_DM=y
 CONFIG_CMD_GPIO=y
+CONFIG_CMD_BMP=y
 CONFIG_CMD_GPT=y
 CONFIG_CMD_MMC=y
 CONFIG_CMD_PART=y
@@ -96,6 +97,16 @@ CONFIG_PINCONF=y
 CONFIG_PINCTRL_MT7988=y
 CONFIG_POWER_DOMAIN=y
 CONFIG_MTK_POWER_DOMAIN=y
+CONFIG_DM_PWM=y
+CONFIG_PWM_MTK=y
+CONFIG_VIDEO=y
+CONFIG_VIDEO_ST7789P3=y
