From 9a6b281a8d3c0ed7a0755de75162a267e1252b88 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Valentin?= <avalentin@marcant.net>
Date: Tue, 6 Oct 2026 18:00:00 +0200
Subject: [PATCH] board: mt7620: add Zyxel LTE3301-M209/Q222
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add the Zyxel LTE3301-M209 and its Q222 sibling: MT7620N, 64 MB DDR,
16 MB SPI-NOR, UART-lite console at 115200 baud, internal 5-port FE
switch and an LTE modem on the internal USB bus.

Both variants are the same board and share the device tree; they only
differ in where the vendor config partition keeps the base MAC, so each
gets its own defconfig and default environment.

Signed-off-by: André Valentin <avalentin@marcant.net>

diff --git a/arch/mips/dts/zyxel,lte3301.dts b/arch/mips/dts/zyxel,lte3301.dts
new file mode 100644
index 0000000..97f06cf
--- /dev/null
+++ b/arch/mips/dts/zyxel,lte3301.dts
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Zyxel LTE3301-M209 and LTE3301-Q222 (MT7620N)
+ *
+ * Based on mediatek,mt7620-rfb.dts (MediaTek Inc.).
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include "mt7620.dtsi"
+
+/ {
+	compatible = "zyxel,lte3301", "mediatek,mt7620-soc";
+	model = "Zyxel LTE3301";
+
+	aliases {
+		serial0 = &uartlite;
+		spi0 = &spi0;
+	};
+
+	chosen {
+		stdout-path = &uartlite;
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "reset";
+			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+
+		wps {
+			label = "wps";
+			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_WPS_BUTTON>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_power: power {
+			label = "green:power";
+			gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
+		};
+
+		wan {
+			label = "green:wan";
+			gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		/*
+		 * Pads 40-43 drive the front LEDs. They need defined levels
+		 * from gpio-leds: in EPHY mode the switch drives them, which
+		 * also touches the modem strap lines. Pad 72 is deliberately
+		 * left unclaimed, driving it keeps the modem from enumerating.
+		 */
+		mobile_green {
+			label = "green:mobile";
+			gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		mobile_red {
+			label = "red:mobile";
+			gpios = <&gpio2 1 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		lte {
+			label = "green:lte";
+			gpios = <&gpio2 2 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		lan {
+			label = "green:lan";
+			gpios = <&gpio2 3 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+	};
+
+	options {
+		u-boot {
+			boot-led = <&led_power>;
+		};
+	};
+};
+
+&uartlite {
+	status = "okay";
+};
+
+&pinctrl {
+	state_default: pin_state {
+		uart {
+			groups = "uartf";
+			function = "gpio";
+		};
+
+		/*
+		 * "ephy led" is bit 15 of GPIO1_MODE: without it the switch
+		 * drives pads 40-44, which blinks the front LEDs on LAN
+		 * traffic and touches the modem strap lines. "wled" (bit 13)
+		 * frees pad 72 the same way the vendor loader does.
+		 *
+		 * "wdt rst" is the bit 21:22 field. The vendor loader leaves
+		 * it at 0 (reset output on pad 17), gpio is what the stock
+		 * firmware selects - the extra board LEDs only work with it.
+		 */
+		led {
+			groups = "ephy led", "wled", "wdt rst";
+			function = "gpio";
+		};
+
+		/* reset and WPS button */
+		button {
+			groups = "i2c";
+			function = "gpio";
+		};
+	};
+};
+
+&spi0 {
+	status = "okay";
+	num-cs = <2>;
+
+	spi-flash@0 {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "jedec,spi-nor";
+		spi-max-frequency = <25000000>;
+		reg = <0>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x0 0x30000>;
+			};
+
+			partition@30000 {
+				label = "u-boot-env";
+				reg = <0x30000 0x10000>;
+			};
+
+			firmware: partition@40000 {
+				compatible = "denx,fit";
+				label = "firmware";
+				reg = <0x40000 0xfb0000>;
+			};
+
+			config: partition@ff0000 {
+				label = "config";
+				reg = <0xff0000 0x10000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&eth {
+	status = "okay";
+};
