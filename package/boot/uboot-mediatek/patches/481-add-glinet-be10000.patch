From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Crispin <john@phrozen.org>
Subject: [PATCH] mt7987: add the GL.iNet GL-BE10000

MT7987 board that boots from SPI-NAND on SPI2 with the FIP inside UBI.
gmac1 drives the SoC built-in 2.5G PHY.

--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -1118,6 +1118,7 @@
 	mt7987a-bpi-r4-lite-emmc.dtb \
 	mt7987a-bpi-r4-lite-sd.dtb \
 	mt7987a-emmc-rfb.dtb \
+	mt7987a-glinet-gl-be10000.dtb \
 	mt7987a-rfb.dtb \
 	mt7987a-routerich_be7200.dtb \
 	mt7987a-sd-rfb.dtb \
--- /dev/null
+++ b/arch/arm/dts/mt7987a-glinet-gl-be10000.dts
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2026 GL.iNet
+ */
+
+/dts-v1/;
+#include "mt7987a.dtsi"
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "GL.iNet GL-BE10000";
+	compatible = "glinet,gl-be10000",
+		     "mediatek,mt7987";
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		button-reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&pio 4 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+	};
+};
--- /dev/null
+++ b/arch/arm/dts/mt7987a-glinet-gl-be10000-u-boot.dtsi
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2026 GL.iNet
+ */
+
+#include "mt7987a-u-boot.dtsi"
+#include "mt7987-netsys-u-boot.dtsi"
+
+/ {
+	model = "GL.iNet GL-BE10000";
+	compatible = "glinet,gl-be10000",
+		     "mediatek,mt7987";
+};
+
+/*
+ * LAN port, and the one to use. gmac1 drives the SoC built-in 2.5G PHY, which
+ * mtk-2p5ge supports on MT7987. Its firmware is linked into U-Boot by
+ * board/mediatek/mt7987/i2p5ge_fw.c, so it needs no storage and works before
+ * any UBI exists.
+ */
+&eth1 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&mdio0_pins>;
+	phy-mode = "internal";
+	phy-handle = <&phy15>;
+
+	phy15: eth-phy@15 {
+		compatible = "ethernet-phy-ieee802.3-c45";
+		reg = <15>;
+	};
+};
+
+/*
+ * pio 0 is the MDIO bus reset, active low. mtk_eth only releases it on the
+ * switch code path, which this board does not take, so hog it high.
+ */
+&pio {
+	mdio-reset-hog {
+		gpio-hog;
+		gpios = <0 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "mdio-reset";
+	};
+};
+
+&spi2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi2_flash_pins>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+	must_tx;
+	enhance_timing;
+	dma_ext;
+	ipm_design;
+	support_quad;
+	tick_dly = <2>;
+	sample_sel = <0>;
+
+	spi_nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <52000000>;
+		spi-rx-bus-width = <4>;
+		spi-tx-bus-width = <4>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "bl2";
+				reg = <0x0 0x200000>;
+			};
+
+			partition@200000 {
+				label = "ubi";
+				reg = <0x200000 0x1fe00000>;
+				compatible = "linux,ubi";
+			};
+		};
+	};
+};
--- /dev/null
+++ b/board/mediatek/mt7987/i2p5ge_fw.c
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Firmware for the MT7987 built-in 2.5G ethernet PHY.
+ *
+ * mtk-2p5ge fetches the two blobs through a weak mt7987_i2p5ge_get_fw(), whose
+ * default implementation runs an environment script to read them out of
+ * storage. Link them into U-Boot instead: the PHY is the recovery path, so it
+ * has to come up before any UBI exists and while a broken UBI is being
+ * replaced. Returning 0 rather than a positive value tells the caller the
+ * buffers are static and must not be freed.
+ *
+ * The blobs are copied into this directory by the OpenWrt package before the
+ * build, from what linux-firmware stages.
+ */
+
+#include <linux/types.h>
+
+asm(
+"	.section .rodata\n"
+"	.balign 16\n"
+"	.globl i2p5ge_pmb_fw\n"
+"i2p5ge_pmb_fw:\n"
+"	.incbin \"board/mediatek/mt7987/i2p5ge-phy-pmb.bin\"\n"
+"	.globl i2p5ge_pmb_fw_end\n"
+"i2p5ge_pmb_fw_end:\n"
+"	.balign 16\n"
+"	.globl i2p5ge_dsp_fw\n"
+"i2p5ge_dsp_fw:\n"
+"	.incbin \"board/mediatek/mt7987/i2p5ge-phy-DSPBitTb.bin\"\n"
+"	.globl i2p5ge_dsp_fw_end\n"
+"i2p5ge_dsp_fw_end:\n"
+"	.previous\n"
+);
+
+extern const u8 i2p5ge_pmb_fw[], i2p5ge_pmb_fw_end[];
+extern const u8 i2p5ge_dsp_fw[], i2p5ge_dsp_fw_end[];
+
+int mt7987_i2p5ge_get_fw(void **fw, size_t *fwsize,
+			 void **dspfw, size_t *dspfwsize)
+{
+	*fw = (void *)i2p5ge_pmb_fw;
+	*fwsize = i2p5ge_pmb_fw_end - i2p5ge_pmb_fw;
+	*dspfw = (void *)i2p5ge_dsp_fw;
+	*dspfwsize = i2p5ge_dsp_fw_end - i2p5ge_dsp_fw;
+
+	return 0;
+}
--- a/board/mediatek/mt7987/Makefile
+++ b/board/mediatek/mt7987/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier:	GPL-2.0
 
 obj-y	+= mt7987_rfb.o
+obj-$(CONFIG_PHY_MEDIATEK_2P5GE)	+= i2p5ge_fw.o
