From 7f6f9b20e15cd388d98cef91cad80627ca9bf2a0 Mon Sep 17 00:00:00 2001
From: Murad Rabadanov <the21.21@mail.ru>
Date: Wed, 11 Nov 2026 18:56:27 +0300
Subject: [PATCH] board: mediatek: add Tenda BE12 Pro

Add an MT7987 SPI-NAND target with 512 MiB DDR3, the AN8855 switch
and an OpenWrt raw UBI layout.

Store redundant environment volumes in UBI and provide TFTP recovery
and production image handling.

Signed-off-by: Murad Rabadanov <the21.21@mail.ru>
---
 arch/arm/dts/mt7987a-tenda-be12-pro.dts  |  85 ++++++++++++++
 configs/mt7987a_tenda_be12-pro_defconfig | 139 +++++++++++++++++++++++
 defenvs/tenda_be12-pro_env               |  51 +++++++++
 3 files changed, 275 insertions(+)
 create mode 100644 arch/arm/dts/mt7987a-tenda-be12-pro.dts
 create mode 100644 configs/mt7987a_tenda_be12-pro_defconfig
 create mode 100644 defenvs/tenda_be12-pro_env

--- /dev/null
+++ b/arch/arm/dts/mt7987a-tenda-be12-pro.dts
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2025
+ * Author: Mikhail Zhilkin <csharper2005@gmail.com>
+ */
+
+/dts-v1/;
+#include "mt7987a.dtsi"
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "Tenda BE12 Pro";
+	compatible = "tenda,be12-pro-ubootmod", "mediatek,mt7987";
+	memory { reg = <0 0x40000000 0 0x20000000>; };
+	chosen { stdout-path = &uart0; };
+	keys {
+		compatible = "gpio-keys";
+		reset { label = "reset"; linux,code = <KEY_RESTART>; gpios = <&pio 1 GPIO_ACTIVE_LOW>; };
+		wps { label = "wps"; linux,code = <KEY_WPS_BUTTON>; gpios = <&pio 0 GPIO_ACTIVE_LOW>; };
+	};
+	leds {
+		compatible = "gpio-leds";
+		led-0 { label = "green:status"; gpios = <&pio 6 GPIO_ACTIVE_LOW>; };
+		led-1 { label = "red:status"; gpios = <&pio 7 GPIO_ACTIVE_LOW>; };
+	};
+};
+
+&watchdog { status = "disabled"; };
+&i2c0 { status = "disabled"; };
+&pcie0 { status = "disabled"; };
+&pwm { status = "disabled"; };
+&spi1 { status = "disabled"; };
+&xhci { status = "disabled"; };
+
+#include "mt7987a-u-boot.dtsi"
+#include "mt7987-netsys-u-boot.dtsi"
+
+&eth0 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&mdio0_pins>;
+	phy-mode = "2500base-x";
+	mediatek,switch = "auto";
+	reset-gpios = <&pio 42 GPIO_ACTIVE_HIGH>;
+
+	fixed-link {
+		speed = <2500>;
+		full-duplex;
+		pause;
+	};
+};
+
+&spi0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi0_flash_pins>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+	must_tx;
+	enhance_timing;
+	dma_ext;
+	ipm_design;
+	support_quad;
+	tick_dly = <2>;
+	sample_sel = <0>;
+
+	spi_nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <52000000>;
+		spi-rx-bus-width = <4>;
+		spi-tx-bus-width = <4>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+			partition@0 { label = "BL2"; reg = <0x0 0x100000>; read-only; };
+			partition@100000 { label = "FIP"; reg = <0x100000 0x200000>; read-only; };
+			partition@300000 { label = "u-boot-env"; reg = <0x300000 0x80000>; read-only; };
+			partition@380000 { label = "Factory"; reg = <0x380000 0x400000>; read-only; };
+			partition@780000 { label = "ubi"; reg = <0x780000 0x7880000>; };
+		};
+	};
+};
--- /dev/null
+++ b/configs/mt7987a_tenda_be12-pro_defconfig
@@ -0,0 +1,139 @@
+CONFIG_ARM=y
