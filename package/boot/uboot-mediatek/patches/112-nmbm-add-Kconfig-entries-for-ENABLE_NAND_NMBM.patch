From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Aleksei Sviridkin <f@lex.la>
Date: Thu, 20 Aug 2026 13:42:51 +0300
Subject: [PATCH] nmbm: add Kconfig entries for ENABLE_NAND_NMBM and its limits

The NMBM code and its call sites have been guarded by ifdef
CONFIG_ENABLE_NAND_NMBM without any Kconfig entry declaring the symbol,
so that code was unreachable from a defconfig. Boards whose stock
firmware manages bad blocks through NMBM need to enable it to see the
same flash layout, and to pin the reserved-block limits the stock
firmware uses.

Signed-off-by: Aleksei Sviridkin <f@lex.la>
---
--- a/drivers/mtd/nmbm/Kconfig
+++ b/drivers/mtd/nmbm/Kconfig
@@ -32,3 +32,17 @@ config NMBM_MTD
 	bool "Enable MTD based NAND mapping block management"
 	default n
 	depends on NMBM
+
+config ENABLE_NAND_NMBM
+	bool "Attach NMBM to the SPI-NAND flash at boot"
+	depends on NMBM_MTD
+
+config NMBM_MAX_RATIO
+	int "Maximum ratio of reserved blocks"
+	depends on ENABLE_NAND_NMBM
+	default 1
+
+config NMBM_MAX_BLOCKS
+	int "Maximum number of reserved blocks"
+	depends on ENABLE_NAND_NMBM
+	default 256
