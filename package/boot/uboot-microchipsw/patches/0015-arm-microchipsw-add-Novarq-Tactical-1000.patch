From 5890dc7c9453bc8e97dbaaf66531c5de7e451c86 Mon Sep 17 00:00:00 2001
From: Robert Marko <robert.marko@sartura.hr>
Date: Wed, 21 Jan 2026 11:34:22 +0100
Subject: [PATCH 15/17] arm: microchipsw: add Novarq Tactical 1000

Add support for Novarq Tactical 1000.

Signed-off-by: Robert Marko <robert.marko@sartura.hr>
---
 arch/arm/dts/Makefile                  |    3 +-
 arch/arm/dts/lan9696-tactical-1000.dts | 1401 ++++++++++++++++++++++++
 configs/novarq_tactical_1000_defconfig |   82 ++
 3 files changed, 1485 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/dts/lan9696-tactical-1000.dts
 create mode 100644 configs/novarq_tactical_1000_defconfig

--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -1171,7 +1171,8 @@ dtb-$(CONFIG_TARGET_CORSTONE1000) += cor
 
 dtb-$(CONFIG_TARGET_COREPRIMEVELTE) += pxa1908-samsung-coreprimevelte.dtb
 
-dtb-$(CONFIG_ARCH_MICROCHIPSW) += lan9696-ev23x71a.dtb
+dtb-$(CONFIG_ARCH_MICROCHIPSW) += lan9696-ev23x71a.dtb \
+				  lan9696-tactical-1000.dtb
 
 include $(srctree)/scripts/Makefile.dts
 
--- /dev/null
+++ b/arch/arm/dts/lan9696-tactical-1000.dts
@@ -0,0 +1,1401 @@
+// SPDX-License-Identifier: (GPL-2.0-or-later OR MIT)
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pwm/pwm.h>
+#include "lan9691.dtsi"
