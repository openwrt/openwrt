+static int ram_init(void __iomem *addr)
+{
+	writel(BIT(1), addr);
+
+	if (wait_for_bit_le32(addr, BIT(1), false, 2000, false)) {
+		printf("Timeout in memory reset, addr: %p = 0x%08x\n", addr, readl(addr));
+		return 1;
+	}
+
+	return 0;
+}
