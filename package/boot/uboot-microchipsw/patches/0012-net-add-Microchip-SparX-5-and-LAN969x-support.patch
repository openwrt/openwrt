+#ifndef _SPARX5_DATA_H_
+#define _SPARX5_DATA_H_
+
+#define FA_SERDES_TYPE_6G  6
+#define FA_SERDES_TYPE_10G 10
+#define FA_SERDES_TYPE_25G 25
+
+/* similar with phy_interface_t */
+#define	IF_SGMII	1
+#define	IF_SGMII_CISCO	2
+#define	IF_QSGMII	3
+#define	IF_RGMII	4
+
+#endif
