From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gregory Dymarek <gregd72002@gmail.com>
Date: Sun, 25 Oct 2026 00:00:00 +0000
Subject: [PATCH] MIPS: add board support for DrayTek Vigor 2862

xRX330 (GRX390), RAM variant chainloaded by DrayBoot (TEXT_BASE 0xA0024000).

Adds CONFIG_LTQ_SOC_GRX390 for the xRX330 differences from VRX200: CGU_SYS
clock decode, EBU at 0x16000000 and RAM sizing by probing. Names part 0x011
(GRX369) and maps boot strap 15 to SPI.

DrayBoot checks the checksum over the slot header length on every NAND boot
and restores its backup on a mismatch, so on first boot the board code shrinks
the header of a combined factory image to the U-Boot region, as on the 2860.

DrayBoot boots the GPHYs from a firmware copy at 0x200000, which the kernel
overwrites while the GPHYs still run from it. Copy it to the top 128 KiB of
RAM, hidden from U-Boot by the new CONFIG_SYS_MEM_TOP_HIDE and outside
Linux's memory, and restart the GPHYs from there, so Linux finds them
running and needs no GPHY firmware.

Signed-off-by: Gregory Dymarek <gregd72002@gmail.com>
---
--- a/arch/mips/cpu/mips32/vrx200/cgu.c
+++ b/arch/mips/cpu/mips32/vrx200/cgu.c
@@ -59,6 +59,50 @@
 	return (ltq_readl(&ltq_cgu_regs->sys) & mask) >> shift;
 }
 
+#ifdef CONFIG_LTQ_SOC_GRX390
+/*
+ * xRX330 (GRX390) uses a different CGU_SYS layout than VRX200:
+ * bits 10:9 select the system PLL output, bits 6:4 the CPU divider and
+ * bits 2:0 the FPI divider. Decoded as in Linux arch/mips/lantiq/xway/clk.c.
+ */
+static unsigned long ltq_grx390_sys_clock(void)
+{
+	switch (ltq_cgu_sys_readl(0x3 << 9, 9)) {
+	case 1:
+		return 666666667;
+	case 2:
+		return 720000000;
+	default:
+		return CLOCK_600_MHZ;
+	}
+}
+
+unsigned long ltq_get_io_region_clock(void)
+{
+	unsigned long clk = ltq_grx390_sys_clock();
+
+	switch (ltq_cgu_sys_readl(0x7, 0)) {
+	case 2:
+		return clk >> 2;
+	default:
+		return clk >> 1;
+	}
+}
+
+unsigned long ltq_get_cpu_clock(void)
+{
+	unsigned long clk = ltq_grx390_sys_clock();
+
+	switch (ltq_cgu_sys_readl(0x7 << 4, 4)) {
+	case 1:
+		return clk >> 1;
+	case 2:
+		return clk >> 2;
+	default:
+		return clk;
+	}
+}
+#else
 unsigned long ltq_get_io_region_clock(void)
 {
 	unsigned int ocp_sel;
@@ -135,6 +179,8 @@
 	return clk;
 }
 
+#endif /* CONFIG_LTQ_SOC_GRX390 */
+
 unsigned long ltq_get_bus_clock(void)
 {
 	return ltq_get_io_region_clock();
--- a/arch/mips/cpu/mips32/vrx200/chipid.c
+++ b/arch/mips/cpu/mips32/vrx200/chipid.c
@@ -54,6 +54,8 @@
 	case LTQ_SOC_GRX288:
 	case LTQ_SOC_GRX288_2:
 		return "GRX288";
