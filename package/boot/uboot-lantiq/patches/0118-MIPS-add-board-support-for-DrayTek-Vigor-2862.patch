@@ -25,6 +25,16 @@
 	return ltq_readl(ltq_mc_ddr_base + LTQ_MC_DDR_CCR_OFFSET(index));
 }
 
+#ifdef CONFIG_LTQ_SOC_GRX390
+/*
+ * The xRX330 DDR controller does not match the VRX200 CCR layout decoded
+ * below, so size the RAM by probing it instead.
+ */
+phys_size_t initdram(int board_type)
+{
+	return get_ram_size((long *)CONFIG_SYS_SDRAM_BASE, 256 << 20);
+}
+#else
 phys_size_t initdram(int board_type)
 {
 	u32 max_col_reg, max_row_reg, column_size, addr_pins;
@@ -55,3 +65,4 @@
 
 	return size;
 }
+#endif /* CONFIG_LTQ_SOC_GRX390 */
--- a/arch/mips/cpu/mips32/vrx200/rcu.c
+++ b/arch/mips/cpu/mips32/vrx200/rcu.c
@@ -160,6 +160,11 @@
 		return BOOT_SPI;
 	case 12:
 		return BOOT_NAND;
+#ifdef CONFIG_LTQ_SOC_GRX390
