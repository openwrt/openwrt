--- /dev/null
+++ b/board/draytek/vigor2862/vigor2862.c
@@ -0,0 +1,202 @@
+/*
+* Copyright (C) 2026 Gregory Dymarek
+* Based on board/draytek/vigor2860
+*
+* SPDX-License-Identifier:	GPL-2.0+
+*/
+
+#include <common.h>
+#include <asm/lantiq/chipid.h>
+#include <asm/lantiq/cpu.h>
+#include <nand.h>
+#include <malloc.h>
+#include <errno.h>
+#include <asm/addrspace.h>
+#include <asm/io.h>
+#include <u-boot/crc.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define DRAYBOOT_PRIMARY   0x01380000   /* DrayBoot primary slot (NAND) */
+#define UBOOT_LEN          0x00080104   /* 0x100 hdr + 0x80000 payload + 4 cksum */
+#define CHECKSUM_OFFSET    0x00080100   /* shrunk ~sum word lands here (in the pad) */
+#define CONVERT_LEN        0x000A0000   /* 5 x 128 KiB, block-aligned, below kernel */
+#define COMBINED_MIN       0x00100000   /* kernel starts here; smaller => not combined */
+
+/*
+ * DrayBoot verifies ~sum over the length in the slot header on every NAND
+ * boot and restores the slot from its backup on a mismatch. A combined
+ * factory image covers the kernel and rootfs, so shrink the header to the
+ * U-Boot region on first boot; later kernel/rootfs updates then leave
+ * DrayBoot's checksum valid.
+ */
+static int convert_drayboot_image(void)
+{
+	nand_info_t *nand = &nand_info[0];
+	nand_erase_options_t eopts;
+	unsigned char peek[CONFIG_SYS_NAND_PAGE_SIZE];
+	unsigned char *buf;
+	size_t len;
+	unsigned int image_len, sum, i;
+	loff_t off;
+	int ret;
+
+	/* Cheap peek: read only the first page to get word0 before any heavy work. */
+	len = CONFIG_SYS_NAND_PAGE_SIZE;
+	ret = nand_read(nand, DRAYBOOT_PRIMARY, &len, peek);
+	if (ret && ret != -EUCLEAN) {
+		printf("DRAYBOOT: header read failed (%d)\n", ret);
+		return -1;
+	}
+	image_len = ntohl(*(unsigned int *)peek);
+	printf("DRAYBOOT: image length = 0x%08x\n", image_len);
+
+	/* Already converted - every boot after the first lands here. */
+	if (image_len == UBOOT_LEN)
+		return 0;
+
+	/* Not a combined installer (uboot-only or malformed): leave the slot
+	 * untouched so DrayBoot keeps booting it with its original checksum. */
+	if (image_len < COMBINED_MIN) {
+		printf("DRAYBOOT: 0x%x not a combined image, skipping convert\n",
+		       image_len);
+		return 0;
+	}
+
+	/* Converting. Raw offsets are only valid if the whole span is good
+	 * blocks - matches DrayBoot's view and prevents silent corruption. */
+	for (off = DRAYBOOT_PRIMARY; off < DRAYBOOT_PRIMARY + CONVERT_LEN;
+	     off += nand->erasesize) {
+		if (nand_block_isbad(nand, off)) {
+			printf("DRAYBOOT: bad block @ 0x%08llx, aborting convert\n",
+			       (unsigned long long)off);
+			return -1;
+		}
+	}
+
+	buf = malloc(CONVERT_LEN);
+	if (!buf) {
+		printf("DRAYBOOT: malloc failed\n");
+		return -1;
+	}
+
+	len = CONVERT_LEN;
+	ret = nand_read(nand, DRAYBOOT_PRIMARY, &len, buf);
+	if (ret && ret != -EUCLEAN) {		/* -EUCLEAN = corrected, not fatal */
+		printf("DRAYBOOT: NAND read failed (%d)\n", ret);
+		goto out;
+	}
+
+	/* Shrink word0 to U-Boot only, recompute ~sum over [0, CHECKSUM_OFFSET). */
+	*(unsigned int *)buf = htonl(UBOOT_LEN);
+	sum = 0;
+	for (i = 0; i < CHECKSUM_OFFSET; i += 4)
+		sum += ntohl(*(unsigned int *)(buf + i));
+	*(unsigned int *)(buf + CHECKSUM_OFFSET) = htonl(~sum);
+
+	/* Erase via the options API (3-arg nand_erase does not exist in 2013.10). */
+	memset(&eopts, 0, sizeof(eopts));
+	eopts.offset = DRAYBOOT_PRIMARY;
+	eopts.length = CONVERT_LEN;
+	eopts.quiet  = 1;
+	ret = nand_erase_opts(nand, &eopts);
+	if (ret) {
+		printf("DRAYBOOT: NAND erase failed (%d)\n", ret);
+		goto out;	/* word0 now gone -> DrayBoot falls back to backup slot */
+	}
+
+	len = CONVERT_LEN;
+	ret = nand_write(nand, DRAYBOOT_PRIMARY, &len, buf);
+	if (ret) {
+		printf("DRAYBOOT: NAND write failed (%d)\n", ret);
+		goto out;
+	}
+
+	printf("DRAYBOOT: converted primary slot to U-Boot-only (0x%08x)\n",
+	       UBOOT_LEN);
+	ret = 0;
+out:
+	free(buf);
+	return ret;
+}
+
+#define RCU_RST_REQ        0x1f203010
+#define RCU_BASE           0x1f203000
+#define DRAYBOOT_GPHY_FW   0x00200000   /* DrayBoot's GPHY GE image */
+#define GPHY_FW_LEN        0x00010000
+
+/* GPHY0-3: firmware address register (RCU offset) and RST_REQ bit */
+static const struct {
+	u16 gfs_add;
+	u8 rst;
+} gphys[] = {
+	{ 0x020, 31 },
+	{ 0x058, 29 },
+	{ 0x0ac, 28 },
+	{ 0x264, 10 },
+};
+
+/*
+ * DrayBoot unpacks the GPHY firmware from SPI to RAM and boots the GPHYs
+ * from there, but the kernel is loaded over that RAM and the GPHYs run
+ * from it. Copy it to the RAM hidden from U-Boot and Linux
+ * (CONFIG_SYS_MEM_TOP_HIDE, 16 KiB aligned) and restart the GPHYs from the
+ * copy, so Linux finds them running and needs no firmware.
+ */
+static void boot_gphys(void)
+{
+	ulong base = CONFIG_SYS_SDRAM_BASE + gd->ram_size -
+		     CONFIG_SYS_MEM_TOP_HIDE;
+	void *fw = (void *)CKSEG1ADDR(base);
+	void *src = (void *)CKSEG1ADDR(DRAYBOOT_GPHY_FW);
+	u32 mask = 0;
+	int i;
+
+	if (readl(CKSEG1ADDR(RCU_BASE + gphys[0].gfs_add)) != DRAYBOOT_GPHY_FW) {
+		puts("GPHY:  no DrayBoot firmware\n");
+		return;
+	}
+
+	memcpy(fw, src, GPHY_FW_LEN);
+
+	for (i = 0; i < ARRAY_SIZE(gphys); i++)
+		mask |= 1 << gphys[i].rst;
+
+	/* the vendor BSP waits 200 ms after asserting the GPHY reset */
+	writel(readl(CKSEG1ADDR(RCU_RST_REQ)) | mask, CKSEG1ADDR(RCU_RST_REQ));
+	mdelay(200);
+	for (i = 0; i < ARRAY_SIZE(gphys); i++)
+		writel(CPHYSADDR(base), CKSEG1ADDR(RCU_BASE + gphys[i].gfs_add));
+	writel(readl(CKSEG1ADDR(RCU_RST_REQ)) & ~mask, CKSEG1ADDR(RCU_RST_REQ));
+
+	printf("GPHY:  booted from 0x%08lx, crc32 %08x\n",
+	       CPHYSADDR(base), crc32(0, fw, GPHY_FW_LEN));
+}
+
+/*
+ * xRX330 (GRX390). DrayBoot has already set up clocks, DDR, the DC/DC
+ * converter and the NAND/UART pinmux, and the VRX200 code for those does
+ * not match this SoC, so none of it is redone here.
+ */
+int board_early_init_f(void)
+{
+	return 0;
+}
+
+int checkboard(void)
+{
+	puts("Board: " CONFIG_BOARD_NAME "\n");
+	ltq_chip_print_info();
+
+	return 0;
+}
+
+int misc_init_r(void)
+{
+	/* shrink the DrayBoot slot header to U-Boot only (first boot only) */
+	convert_drayboot_image();
+
+	boot_gphys();
+
+	return 0;
+}
