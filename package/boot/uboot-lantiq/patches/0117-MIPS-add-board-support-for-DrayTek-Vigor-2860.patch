+#define CONFIG_LTQ_SUPPORT_UART			/* Enable ASC and UART */
+
+#define CONFIG_LTQ_SUPPORT_ETHERNET		/* Enable ethernet */
+
+#define CONFIG_LTQ_SUPPORT_NAND_FLASH		/* Have a TC58NVG0S3E NAND flash */
+
+#define CONFIG_SYS_NAND_PAGE_COUNT	64
+#define CONFIG_SYS_NAND_PAGE_SIZE	2048
+#define CONFIG_SYS_NAND_OOBSIZE		64
+#define CONFIG_SYS_NAND_BLOCK_SIZE	(128 * 1024)
+#define CONFIG_SYS_NAND_BAD_BLOCK_POS	NAND_LARGE_BADBLOCK_POS
+
+#define CONFIG_SYS_DRAM_PROBE
+
+#undef CONFIG_SYS_BOOTM_LEN
+#define CONFIG_SYS_BOOTM_LEN          0x2000000       /* 32 MB */
+
+/* Environment */
+#define CONFIG_ENV_IS_NOWHERE
+
+#define CONFIG_ENV_SIZE			(8 * 1024)
+#define CONFIG_LOADADDR            CONFIG_SYS_LOAD_ADDR
+
+/* Console */
+#define CONFIG_LTQ_ADVANCED_CONSOLE
+#define CONFIG_BAUDRATE			115200
+#define CONFIG_CONSOLE_ASC		1
+#define CONFIG_CONSOLE_DEV		"ttyLTQ0"
+
+/* Pull in default board configs for Lantiq XWAY VRX200 */
+#include <asm/lantiq/config.h>
+#include <asm/arch/config.h>
+
+/* Pull in default OpenWrt configs for Lantiq SoC */
+#include "openwrt-lantiq-common.h"
+
+/*
+ * No NAND SPL on this board, and NAND offset 0 belongs to DrayBoot:
+ * drop the default commands that load or write a U-Boot image there.
+ */
+#undef CONFIG_ENV_WRITE_UBOOT_NAND
+#define CONFIG_ENV_WRITE_UBOOT_NAND
+#undef CONFIG_ENV_LOAD_UBOOT_NAND
+#define CONFIG_ENV_LOAD_UBOOT_NAND
+
+#define CONFIG_EXTRA_ENV_SETTINGS	\
+	CONFIG_ENV_LANTIQ_DEFAULTS
+
+/* DrayBoot leaves caches in a state that linux cannot handle; force reset them */
+#define CONFIG_SYS_MIPS_CACHE_INIT_CHAINLOAD
+
+/* DrayBoot RAM entry: phys 0x20000, link at uncached KSEG1 alias */
+#undef  CONFIG_SYS_TEXT_BASE
+#define CONFIG_SYS_TEXT_BASE	0xA0020000
+
+#undef  CONFIG_BOARD_LATE_INIT
+#define CONFIG_MISC_INIT_R
+#undef  CONFIG_LOADADDR
+#define CONFIG_LOADADDR   0x82000000
+#undef  CONFIG_BOOTCOMMAND
+#define CONFIG_BOOTCOMMAND \
+    "nand read ${loadaddr} 0x1480000 0x400000 && bootm ${loadaddr}"
+
+
+#endif /* __CONFIG_H */
