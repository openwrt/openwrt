 Orphan  powerpc     mpc8xx         -           -               mbx8xx              MBX                                  -                                                                                                                                 -
 Orphan  powerpc     mpc8xx         -           -               mbx8xx              MBX860T                              -                                                                                                                                 -
 Orphan  powerpc     mpc8xx         -           -               nx823               NX823                                -                                                                                                                                 -
+Active	mips	mips32	vrx200	draytek	vigor2860	vigor2860_ram	vigor2860:SYS_BOOT_RAM	Gregory Dymarek
--- a/arch/mips/cpu/mips32/start.S
+++ b/arch/mips/cpu/mips32/start.S
@@ -123,8 +123,11 @@ reset:
 	la	t9, lowlevel_init
 	jalr	t9
 	 nop
+#endif
 
-	/* Initialize caches... */
+#if !defined(CONFIG_SKIP_LOWLEVEL_INIT) || defined(CONFIG_SYS_MIPS_CACHE_INIT_CHAINLOAD)
+	/* Initialize caches (needed even when chainloaded - DrayBoot leaves
+	 * the cache in a non-Linux state) */
 	la	t9, mips_cache_reset
 	jalr	t9
 	 nop
--- a/arch/mips/lib/bootm.c
+++ b/arch/mips/lib/bootm.c
@@ -216,6 +216,10 @@ static void boot_jump_linux(bootm_header
 	/* we assume that the kernel is in place */
 	printf("\nStarting kernel ...\n\n");
 
+#ifdef CONFIG_SYS_MIPS_CACHE_INIT_CHAINLOAD
+	flush_cache(images->os.load, CONFIG_SYS_BOOTM_LEN);
+#endif
+
 	kernel(linux_argc, (ulong)linux_argv, (ulong)linux_env, linux_extra);
 }
 
