+#ifndef CONFIG_SPL_BUILD
+int misc_init_r(void)
+{
+	writel(0x11111111, MVEBU_MPP_BASE + 0x00);
+	writel((readl(MVEBU_MPP_BASE + 0x04) & 0xffff0000) | 0x00001111, MVEBU_MPP_BASE + 0x04);
+	/* Configure MPP45 (GPIO1_13, Reset button, active-low) as GPIO input */
+	clrbits_le32(MVEBU_MPP_BASE + 0x14, 0xf << 20);
+	setbits_le32(MVEBU_GPIO1_BASE + 0x04, BIT(13));
+	ix4_populate_hw_macs();
+	if (!env_get("env_saved")) {
+		env_set("env_saved", "1");
+		printf("Saving default environment to NAND...\n");
+		env_save();
+	}
+	/* Power on: all LEDs off (0xfd, Top Blue off) */
+	ix4_set_leds(0xfd, false);
+	if (!(readl(MVEBU_GPIO1_BASE + 0x10) & BIT(13))) {
+		printf("Reset button pressed - switching to recovery boot (USB -> TFTP)!\n");
+		env_set("bootcmd", "run boot_recovery");
+	}
+	return 0;
+}
