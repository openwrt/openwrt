+static void ix4_set_leds(u8 hc595_val, bool hdd_blue)
+{
+	int b;
+
+	/* MPP25 (SCK, gpio0_25), MPP26 (HDD LED, gpio0_26), MPP27 (CS, gpio0_27), MPP47 (MOSI, gpio1_15) */
+	clrbits_le32(MVEBU_MPP_BASE + 0x0c, (0xf << 4) | (0xf << 8) | (0xf << 12));
+	clrbits_le32(MVEBU_MPP_BASE + 0x14, 0xf << 28);
+
+	/* Idle high for active-low SCK/CS/MOSI; set HDD blue LED on GPIO0_26 */
+	setbits_le32(MVEBU_GPIO0_BASE + 0x00, BIT(25) | BIT(27));
+	if (hdd_blue)
+		setbits_le32(MVEBU_GPIO0_BASE + 0x00, BIT(26));
+	else
+		clrbits_le32(MVEBU_GPIO0_BASE + 0x00, BIT(26));
+	setbits_le32(MVEBU_GPIO1_BASE + 0x00, BIT(15));
+
+	/* Configure GPIO0_25/26/27 and GPIO1_15 as outputs (0 = output on Armada XP) */
+	clrbits_le32(MVEBU_GPIO0_BASE + 0x04, BIT(25) | BIT(26) | BIT(27));
+	clrbits_le32(MVEBU_GPIO1_BASE + 0x04, BIT(15));
+
+	/* Assert active-low CS (GPIO0_27 = 0) and shift 8 bits MSB-first into 74HC595 */
+	clrbits_le32(MVEBU_GPIO0_BASE + 0x00, BIT(27));
+	udelay(5);
+	for (b = 7; b >= 0; b--) {
+		/* Active-low MOSI: logical 1 -> physical 0, logical 0 -> physical 1 */
+		if (hc595_val & BIT(b))
+			clrbits_le32(MVEBU_GPIO1_BASE + 0x00, BIT(15));
+		else
+			setbits_le32(MVEBU_GPIO1_BASE + 0x00, BIT(15));
+		udelay(5);
+		/* Active-low SCK pulse: assert (0) then idle (1) */
+		clrbits_le32(MVEBU_GPIO0_BASE + 0x00, BIT(25));
+		udelay(5);
+		setbits_le32(MVEBU_GPIO0_BASE + 0x00, BIT(25));
+		udelay(5);
+	}
+	/* Deassert active-low CS (GPIO0_27 = 1) to latch 74HC595 outputs */
+	setbits_le32(MVEBU_GPIO0_BASE + 0x00, BIT(27));
+}
+
+#ifndef CONFIG_XPL_BUILD
+static bool ix4_parse_uboot_ym(const char *s, int *yr, int *mo)
+{
+	const char *p = strstr(s, "U-Boot 20");
+	if (!p)
+		return false;
+	p += 7;
+	if (strlen(p) < 7 || p[4] != '.')
+		return false;
+	*yr = simple_strtoul(p, NULL, 10);
+	*mo = simple_strtoul(p + 5, NULL, 10);
+	return (*yr >= 2020 && *mo >= 1 && *mo <= 12);
+}
+
+static int do_ix4_usb_upgrade(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	ulong addr, size, i;
+	const u8 *buf;
+	int cur_yr = 0, cur_mo = 0, new_yr = 0, new_mo = 0;
+	bool found_ver = false, force;
+	char cmd[64];
+
+	if (argc < 3)
+		return CMD_RET_USAGE;
+
+	addr = hextoul(argv[1], NULL);
+	size = hextoul(argv[2], NULL);
+	buf = (const u8 *)addr;
+
+	if (size < 0x10000 || size > 0xe0000) {
+		printf("ix4_usb_upgrade: invalid .kwb size 0x%lx (must be 64K..896K)\n", size);
+		return CMD_RET_FAILURE;
+	}
+	/* Verify Marvell v1 NAND boot header magic (0x8b) and header version (0x01) */
+	if (buf[0] != 0x8b || buf[8] != 0x01) {
+		printf("ix4_usb_upgrade: invalid Marvell NAND .kwb header (0x%02x/0x%02x)\n", buf[0], buf[8]);
+		return CMD_RET_FAILURE;
+	}
+
+	ix4_parse_uboot_ym(U_BOOT_VERSION, &cur_yr, &cur_mo);
+	for (i = 0x200; i + 16 < size; i++) {
+		if (buf[i] == 'U' && !memcmp(&buf[i], "U-Boot 20", 9)) {
+			char tmp[32];
+			memcpy(tmp, &buf[i], sizeof(tmp) - 1);
+			tmp[sizeof(tmp) - 1] = '\0';
+			if (ix4_parse_uboot_ym(tmp, &new_yr, &new_mo)) {
+				found_ver = true;
+				break;
+			}
+		}
+	}
+
+	if (!found_ver) {
+		printf("ix4_usb_upgrade: could not detect U-Boot version in .kwb\n");
+		return CMD_RET_FAILURE;
+	}
+
+	force = (env_get_yesno("force_uboot") == 1);
+	printf("U-Boot version check: running=%d.%02d, USB .kwb=%d.%02d%s\n",
+	       cur_yr, cur_mo, new_yr, new_mo, force ? " (force_uboot=1)" : "");
+
+	if (!force && (new_yr < cur_yr || (new_yr == cur_yr && new_mo <= cur_mo))) {
+		printf("U-Boot on NAND is already up to date; skipping flash.\n");
+		return CMD_RET_SUCCESS;
+	}
+
+	printf("Upgrading U-Boot on NAND from USB (%lu bytes)...\n", size);
+	if (run_command("nand erase 0x0 0xe0000", 0) != 0)
+		return CMD_RET_FAILURE;
+	snprintf(cmd, sizeof(cmd), "nand write 0x%lx 0x0 0x%lx", addr, size);
+	if (run_command(cmd, 0) != 0)
+		return CMD_RET_FAILURE;
+
+	printf("U-Boot upgrade complete! Resetting into new U-Boot...\n");
+	udelay(100000);
+	do_reset(NULL, 0, 0, NULL);
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	ix4_usb_upgrade, 3, 0, do_ix4_usb_upgrade,
+	"upgrade NAND U-Boot from validated .kwb in RAM if version is newer",
+	"<addr> <size>"
+);
+
+void show_boot_progress(int status)
+{
+	if (status == BOOTSTAGE_ID_ENTER_CLI_LOOP) {
+		/* Active at U-Boot CLI prompt: Bottom White only (0xff, Top Blue off) */
+		ix4_set_leds(0xff, false);
+	} else if (status == BOOTSTAGE_ID_RUN_OS) {
+		/* Handing off to Linux kernel: all LEDs off (0xfd, Top Blue off) */
+		ix4_set_leds(0xfd, false);
+	}
+}
