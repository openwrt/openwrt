+static int do_ix4_patch_fdt(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	ulong addr = argc > 1 ? hextoul(*(argv + 1), NULL) : 0x04000000;
+	ulong raw_sz = argc > 2 ? hextoul(*(argv + 2), NULL) : 0x800000;
+	struct legacy_img_hdr *hdr = (struct legacy_img_hdr *)addr;
+	ulong data = addr;
+	ulong size = raw_sz;
+	u32 off, *cells;
+	void *fdt = NULL;
+	int node, len;
+
+	if (fdt_magic((void *)addr) == FDT_MAGIC) {
+		fdt = (void *)addr;
+	} else {
+		if (image_get_magic(hdr) == IH_MAGIC) {
+			data = addr + sizeof(*hdr);
+			if (image_get_type(hdr) == IH_TYPE_MULTI)
+				image_multi_getimg(hdr, 0, &data, &size);
+			else
+				size = image_get_size(hdr);
+		}
+		for (off = size & ~3U; off > (size > 0x10000 ? size - 0x10000 : 0); off -= 4) {
+			void *cand = (void *)(data + off);
+			if (fdt_magic(cand) == FDT_MAGIC && fdt_totalsize(cand) <= size - off) {
+				fdt = cand;
+				break;
+			}
+		}
+	}
+
+	if (!fdt) {
+		printf("ix4_patch_fdt: DTB not found at 0x%08lx\n", addr);
+		return CMD_RET_FAILURE;
+	}
+
+	node = fdt_path_offset(fdt, "/soc");
+	if (node < 0)
+		return CMD_RET_FAILURE;
+
+	cells = (u32 *)fdt_getprop_w(fdt, node, "ranges", &len);
+	if (!cells || len < 16)
+		return CMD_RET_FAILURE;
+
+	if (fdt32_to_cpu(*(cells + 3)) == 0xd0000000) {
+		*(cells + 3) = cpu_to_fdt32(0xf1000000);
+		printf("ix4_patch_fdt: patched /soc/ranges (0xd0000000 -> 0xf1000000) at 0x%p\n", fdt);
+	}
+
+	fdt_fixup_ethernet(fdt);
+
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	ix4_patch_fdt, 3, 0, do_ix4_patch_fdt,
+	"patch standalone or appended DTB /soc/ranges and MACs",
+	"[addr] [size]"
+);
+
+static int do_rubt(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	const char *fname = argc > 1 ? *(argv + 1) : "u-boot-with-spl.kwb";
+	ulong load_addr = 0x04000000;
+	u8 *hdr = (u8 *)load_addr;
+	u32 payload_sz, hdr_sz, src_addr, dest_addr, exec_addr;
+	u8 csum = 0;
+	u32 i;
+	int size;
+	void (*uboot_entry)(void);
+
+	if (!env_get("ipaddr"))
+		run_command("run net_init", 0);
+	image_load_addr = load_addr;
+	copy_filename(net_boot_file_name, fname, sizeof(net_boot_file_name));
+	if (net_loop(TFTPGET) < 0) {
+		printf("rubt: TFTP transfer failed\n");
+		return CMD_RET_FAILURE;
+	}
+	size = env_get_hex("filesize", 0);
+	if (size < 0x20) {
+		printf("rubt: TFTP transfer failed or file too small\n");
+		return CMD_RET_FAILURE;
+	}
+
+	if (*hdr != 0x8b && *hdr != 0x69 && *hdr != 0x8c && *hdr != 0xae) {
+		printf("rubt: invalid kwbimage magic 0x%02x\n", *hdr);
+		return CMD_RET_FAILURE;
+	}
+
+	payload_sz = readl(hdr + 0x04);
+	hdr_sz = (*(hdr + 0x09) << 16) | readw(hdr + 0x0a);
+	src_addr = readl(hdr + 0x0c);
+	dest_addr = readl(hdr + 0x10);
+	exec_addr = readl(hdr + 0x14);
+
+	if (hdr_sz < 0x20 || src_addr < hdr_sz || (u32)size < src_addr + 0x1000) {
+		printf("rubt: truncated kwbimage (size=0x%x src=0x%x)\n", size, src_addr);
+		return CMD_RET_FAILURE;
+	}
+
+	for (i = 0; i < hdr_sz; i++) {
+		if (i != 0x1f)
+			csum += *(hdr + i);
+	}
+	if (csum != *(hdr + 0x1f)) {
+		printf("rubt: header checksum mismatch (calc=0x%02x hdr=0x%02x)\n", csum, *(hdr + 0x1f));
+		return CMD_RET_FAILURE;
+	}
+
+	if (payload_sz > (u32)size - src_addr)
+		payload_sz = (u32)size - src_addr;
+
+	printf("rubt: running %s in RAM (src=0x%x -> dest=0x%08x, size=0x%x)\n",
+	       fname, src_addr, dest_addr, payload_sz);
+	memcpy((void *)(ulong)dest_addr, hdr + src_addr, payload_sz);
+	cleanup_before_linux();
+	uboot_entry = (void (*)(void))(ulong)exec_addr;
+	uboot_entry();
+
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	rubt, 2, 0, do_rubt,
+	"load a .kwb U-Boot image over TFTP and run it directly in RAM",
+	"[filename]"
+);
+
+int board_init(void)
+{
+	mdelay(50);
+	/* Reset NFCv2 NAND controller (NDCR, NDECCCTRL, NDSR) to cold-boot PIO state */
+	writel(0xfff, 0xf10d0000);
+	writel(0x0, 0xf10d0028);
+	writel(0xfff, 0xf10d0014);
+	/* Ungate PEX0 and PEX1 clocks (bits 5..8) without leaving PCIe BARs/windows active */
+	setbits_le32(0xf1018220, 0x3e0);
+	gd->bd->bi_boot_params = mvebu_sdram_bar(0) + 0x100;
+	return 0;
+}
+
+void ix4_populate_hw_macs(void)
+{
+	u32 uid0 = readl(0xf1018200);
+	u32 uid1 = readl(0xf1018204);
+	u32 uid2 = readl(0xf1018208);
+	u32 uid3 = readl(0xf101820c);
+	u32 h = uid0 ^ (uid1 * 0x9e3779b1U) ^ (uid2 * 0x85ebca6bU) ^ (uid3 * 0xc2b2ae35U);
+	u32 sfx0, sfx1;
+	static uchar mac0_buf, mac1_buf;
+	static u64 mac0_storage, mac1_storage;
+	uchar *mac0 = (uchar *)&mac0_storage;
+	uchar *mac1 = (uchar *)&mac1_storage;
+	(void)mac0_buf; (void)mac1_buf;
+
+	h ^= h >> 16;
+	h *= 0x85ebca6bU;
+	h ^= h >> 13;
+	sfx0 = h & 0x00ffffffU;
+	if (sfx0 == 0 || sfx0 >= 0x00fffffeU)
+		sfx0 = 0x00248f3dU;
+	sfx1 = (sfx0 + 1U) & 0x00ffffffU;
+
+	*(mac0 + 0) = 0x00;
+	*(mac0 + 1) = 0xd0;
+	*(mac0 + 2) = 0xb8;
+	*(mac0 + 3) = (sfx0 >> 16) & 0xff;
+	*(mac0 + 4) = (sfx0 >> 8) & 0xff;
+	*(mac0 + 5) = sfx0 & 0xff;
+
+	*(mac1 + 0) = 0x00;
+	*(mac1 + 1) = 0xd0;
+	*(mac1 + 2) = 0xb8;
+	*(mac1 + 3) = (sfx1 >> 16) & 0xff;
+	*(mac1 + 4) = (sfx1 >> 8) & 0xff;
+	*(mac1 + 5) = sfx1 & 0xff;
+
+	char mac_str[18];
+
+	if (!env_get("ethaddr")) {
+		snprintf(mac_str, sizeof(mac_str), "%02X:%02X:%02X:%02X:%02X:%02X",
+			 *(mac0 + 0), *(mac0 + 1), *(mac0 + 2), *(mac0 + 3), *(mac0 + 4), *(mac0 + 5));
+		env_set("ethaddr", mac_str);
+	}
+	if (!env_get("eth0addr") && env_get("ethaddr"))
+		env_set("eth0addr", env_get("ethaddr"));
+	if (!env_get("eth1addr")) {
+		snprintf(mac_str, sizeof(mac_str), "%02X:%02X:%02X:%02X:%02X:%02X",
+			 *(mac1 + 0), *(mac1 + 1), *(mac1 + 2), *(mac1 + 3), *(mac1 + 4), *(mac1 + 5));
+		env_set("eth1addr", mac_str);
+	}
+}
+
+static int ix4_on_ethaddr(const char *name, const char *value, enum env_op op, int flags)
+{
+	if (op == env_op_delete)
+		ix4_populate_hw_macs();
+	return 0;
+}
+U_BOOT_ENV_CALLBACK(ix4_eth, ix4_on_ethaddr);
