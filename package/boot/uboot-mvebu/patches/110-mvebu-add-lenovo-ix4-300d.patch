From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bob Sponge <myandroidiptvbox@gmail.com>
Date: Sat, 21 Nov 2026 13:00:00 +0000
Subject: [PATCH] arm: mvebu: add support for Lenovo Iomega ix4-300d

Add U-Boot board support (lenovo_ix4_300d) for the Lenovo Iomega
ix4-300d NAS based on Marvell Armada XP MV78230.

Signed-off-by: Bob Sponge <myandroidiptvbox@gmail.com>
---
--- a/arch/arm/mach-mvebu/Kconfig
+++ b/arch/arm/mach-mvebu/Kconfig
@@ -198,6 +198,10 @@
 	bool "Support Synology DS414"
 	select MV78230

+config TARGET_LENOVO_IX4_300D
+	bool "Support Lenovo Iomega ix4-300d"
+	select MV78230
+
 config TARGET_MAXBCM
 	bool "Support maxbcm"
 	select BOARD_ECC_SUPPORT
@@ -320,6 +324,7 @@
 	default "db-mv784mp-gp" if TARGET_DB_MV784MP_GP
 	default "ds116" if TARGET_DS116
 	default "ds414" if TARGET_DS414
+	default "ix4-300d" if TARGET_LENOVO_IX4_300D
 	default "maxbcm" if TARGET_MAXBCM
 	default "n2350" if TARGET_N2350
 	default "theadorable" if TARGET_THEADORABLE
@@ -345,6 +350,7 @@
 	default "db-mv784mp-gp" if TARGET_DB_MV784MP_GP
 	default "ds116" if TARGET_DS116
 	default "ds414" if TARGET_DS414
+	default "lenovo_ix4_300d" if TARGET_LENOVO_IX4_300D
 	default "maxbcm" if TARGET_MAXBCM
 	default "n2350" if TARGET_N2350
 	default "theadorable" if TARGET_THEADORABLE
@@ -361,6 +367,7 @@
 	default "mvebu_alleycat-5" if TARGET_MVEBU_ALLEYCAT5

 config SYS_VENDOR
+	default "lenovo" if TARGET_LENOVO_IX4_300D
 	default "Marvell" if TARGET_DB_MV784MP_GP
 	default "Marvell" if TARGET_MVEBU_ARMADA_37XX
 	default "Marvell" if TARGET_DB_88F6720
--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -142,6 +142,7 @@
 	armada-xp-db-xc3-24g4xg.dtb		\
 	armada-xp-gp.dtb			\
 	armada-xp-maxbcm.dtb			\
+	armada-xp-lenovo-ix4-300d.dtb		\
 	armada-xp-synology-ds414.dtb		\
 	armada-xp-theadorable.dtb
 endif
--- /dev/null
+++ b/arch/arm/dts/armada-xp-lenovo-ix4-300d.dts
@@ -0,0 +1,288 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Device Tree file for Lenovo Iomega ix4-300d
+ *
+ * Copyright (C) 2014, Benoit Masson <yahoo@perenite.com>
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/gpio/gpio.h>
+#include "armada-xp-mv78230.dtsi"
+
+/ {
+	model = "Lenovo Iomega ix4-300d";
+	compatible = "lenovo,ix4-300d", "marvell,armadaxp-mv78230",
+		     "marvell,armadaxp", "marvell,armada-370-xp";
+
+	chosen {
+		stdout-path = &uart0;
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0 0x00000000 0 0x20000000>; /* 512MB */
+	};
+
+	soc {
+		ranges = <MBUS_ID(0xf0, 0x01) 0 0 0xf1000000 0x100000
+			MBUS_ID(0x01, 0x1d) 0 0 0xfff00000 0x100000
+			MBUS_ID(0x09, 0x09) 0 0 0xf1100000 0x10000
+			MBUS_ID(0x09, 0x05) 0 0 0xf1110000 0x10000>;
+
+		internal-regs {
+			serial@12000 {
+				status = "okay";
+			};
+
+			ethernet@70000 {
+				pinctrl-0 = <&ge0_rgmii_pins>;
+				pinctrl-names = "default";
+				status = "okay";
+				phy = <&phy0>;
+				phy-mode = "rgmii-id";
+			};
+
+			ethernet@74000 {
+				pinctrl-0 = <&ge1_rgmii_pins>;
+				pinctrl-names = "default";
+				status = "okay";
+				phy = <&phy1>;
+				phy-mode = "rgmii-id";
+			};
+
+			usb@50000 {
+				status = "okay";
+			};
+
+			usb@51000 {
+				status = "okay";
+			};
+
+			i2c@11000 {
+				clock-frequency = <400000>;
+				status = "okay";
+
+				adt7473@2e {
+					compatible = "adi,adt7473";
+					reg = <0x2e>;
+				};
+
+				eeprom@50 {
+					compatible = "atmel,24c64";
+					reg = <0x50>;
+				};
+
+				pcf8563@51 {
+					compatible = "nxp,pcf8563";
+					reg = <0x51>;
+				};
+			};
+
+			nand@d0000 {
+				status = "okay";
+
+				nand@0 {
+					reg = <0>;
+					label = "pxa3xx_nand-0";
+					nand-rb = <0>;
+					nand-ecc-strength = <4>;
+					nand-ecc-step-size = <512>;
+					nand-on-flash-bbt;
+
+					partitions {
+						compatible = "fixed-partitions";
+						#address-cells = <1>;
+						#size-cells = <1>;
+
+						partition@0 {
+							label = "u-boot";
+							reg = <0x00000000 0x000e0000>;
+							read-only;
+						};
+
+						partition@e0000 {
+							label = "u-boot-env";
+							reg = <0x000e0000 0x00020000>;
+						};
+
+						partition@100000 {
+							label = "u-boot-env2";
+							reg = <0x00100000 0x00020000>;
+						};
+
+						partition@120000 {
+							label = "kernel";
+							reg = <0x00120000 0x01000000>;
+						};
+
+						partition@1120000 {
+							label = "ubi";
+							reg = <0x01120000 0x3eee0000>;
+						};
+					};
+				};
+			};
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&power_button_pin &reset_button_pin
+			&select_button_pin &scroll_button_pin>;
+		pinctrl-names = "default";
+
+		power-button {
+			label = "Power Button";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
+		};
+
+		reset-button {
+			label = "Reset Button";
+			linux,code = <KEY_RESTART>;
+			gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
+		};
+
+		select-button {
+			label = "Select Button";
+			linux,code = <BTN_0>;
+			gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
+		};
+
+		scroll-button {
+			label = "Scroll Button";
+			linux,code = <BTN_1>;
+			gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	spi-3 {
+		compatible = "spi-gpio";
+		pinctrl-0 = <&spi3_pins>;
+		pinctrl-names = "default";
+		status = "okay";
+		sck-gpios  = <&gpio0 25 GPIO_ACTIVE_LOW>;
+		mosi-gpios = <&gpio1 15 GPIO_ACTIVE_LOW>; /*gpio 47*/
+		cs-gpios = <&gpio0 27 GPIO_ACTIVE_LOW>;
+		num-chipselects = <1>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpio_spi: gpio_spi@0 {
+			compatible = "fairchild,74hc595";
+			gpio-controller;
+			#gpio-cells = <2>;
+			reg = <0>;
+			registers-number = <1>;
+			spi-max-frequency = <100000>;
+		};
+	};
+
+	gpio-leds {
+		compatible = "gpio-leds";
+		pinctrl-0 = <&hdd_led_pin>;
+		pinctrl-names = "default";
+
+		hdd-led {
+			label = "ix4-300d:hdd:blue";
+			gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		power-led {
+			label = "ix4-300d:power:white";
+			gpios = <&gpio_spi 1 GPIO_ACTIVE_LOW>;
+			/* init blinking while booting */
+			linux,default-trigger = "timer";
+			default-state = "on";
+		};
+
+		sysfail-led {
+			label = "ix4-300d:sysfail:red";
+			gpios = <&gpio_spi 2 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		sys-led {
+			label = "ix4-300d:sys:blue";
+			gpios = <&gpio_spi 3 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		hddfail-led {
+			label = "ix4-300d:hddfail:red";
+			gpios = <&gpio_spi 4 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+
+	gpio-poweroff {
+		compatible = "gpio-poweroff";
+		pinctrl-0 = <&poweroff_pin>;
+		pinctrl-names = "default";
+		gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&pciec {
+	status = "okay";
+
+	pcie@1,0 {
+		/* Port 0, Lane 0 */
+		status = "okay";
+	};
+
+	pcie@5,0 {
+		/* Port 1, Lane 0 */
+		status = "okay";
+	};
+};
+
+&mdio {
+	phy0: ethernet-phy@0 {
+		reg = <0>;
+	};
+
+	phy1: ethernet-phy@1 {
+		reg = <1>;
+	};
+};
+
+&pinctrl {
+	poweroff_pin: poweroff-pin {
+		marvell,pins = "mpp24";
+		marvell,function = "gpio";
+	};
+
+	power_button_pin: power-button-pin {
+		marvell,pins = "mpp44";
+		marvell,function = "gpio";
+	};
+
+	reset_button_pin: reset-button-pin {
+		marvell,pins = "mpp45";
+		marvell,function = "gpio";
+	};
+
+	select_button_pin: select-button-pin {
+		marvell,pins = "mpp41";
+		marvell,function = "gpio";
+	};
+
+	scroll_button_pin: scroll-button-pin {
+		marvell,pins = "mpp42";
+		marvell,function = "gpio";
+	};
+
+	hdd_led_pin: hdd-led-pin {
+		marvell,pins = "mpp26";
+		marvell,function = "gpio";
+	};
+
+	spi3_pins: spi3-pins {
+		marvell,pins = "mpp25", "mpp27", "mpp47";
+		marvell,function = "gpio";
+	};
+};
--- /dev/null
+++ b/arch/arm/dts/armada-xp-lenovo-ix4-300d-u-boot.dtsi
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+/ {
+/delete-node/ gpio-leds;
+/delete-node/ gpio-keys;
+/delete-node/ gpio-poweroff;
+/delete-node/ spi-3;
+
+soc {
+bootph-all;
+
+internal-regs {
+bootph-all;
+
+serial@12000 {
+bootph-all;
+clock-frequency = <250000000>;
+};
+
+timer@20300 {
+bootph-all;
+};
+
+nand@d0000 {
+num-cs = <1>;
+marvell,nand-enable-arbiter;
+nand-ecc-strength = <4>;
+nand-ecc-step-size = <512>;
+};
+};
+
+pcie@82000000 {
+pcie@2,0 {
+status = "disabled";
+};
+};
+
+pcie@82000000 {
+pcie@2,0 {
+status = "disabled";
+};
+};
+};
+};
