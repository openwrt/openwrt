+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef _CONFIG_RTX830_H
+#define _CONFIG_RTX830_H
+#include "mv-common.h"
+#if defined(CONFIG_USB_EHCI_MARVELL)
+/* Automatic selection follows the internal USB reader, never a USB disk index. */
+#define CFG_EXTRA_ENV_SETTINGS \
+	"kernel_addr_r=0x04000000\0" \
+	"fdt_addr_r=0x03000000\0" \
+	"ramdisk_addr_r=0x06000000\0" \
+	"bootpart=1\0" \
+	"rootpart=2\0" \
+	"kernel_file=zImage\0" \
+	"fdt_file=rtx830.dtb\0" \
+	"bootcmd_auto=if usb start && rtx830_sddev; then run bootcmd_sd; " \
+		"else echo Internal microSD unavailable; fi\0" \
+	"bootcmd_sd=" \
+		"if test -n \"${sddev}\"; then " \
+			"if usb start && " \
+			"fatload usb ${sddev}:${bootpart} ${kernel_addr_r} ${kernel_file} && " \
+			"fatload usb ${sddev}:${bootpart} ${fdt_addr_r} ${fdt_file} && " \
+			"part uuid usb ${sddev}:${rootpart} rootuuid; then " \
+				"setenv bootargs console=ttyS0,9600n8 " \
+				"earlycon=uart8250,mmio32,0xf1012000 " \
+				"root=PARTUUID=${rootuuid} rootwait rootfstype=ext4 rw " \
+				"usbcore.autosuspend=-1; " \
+				"bootz ${kernel_addr_r} - ${fdt_addr_r}; " \
+			"else echo SD boot files or root partition unavailable; fi; " \
+		"else echo Select the microSD with: setenv sddev N; fi\0"
+#else
+#define CFG_EXTRA_ENV_SETTINGS "bootcmd=echo UART experiment: automatic boot disabled\0"
+#endif
