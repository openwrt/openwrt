+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/* Flat CANZ chainload tree: clocks, DDR and pinmux are inherited. */
--- /dev/null
+++ b/arch/arm/dts/armada-385-rtx830-sdboot.dts
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/dts-v1/;
+/ {
+	model = "Yamaha RTX830 CANZ SD boot";
+	compatible = "yamaha,rtx830", "marvell,armada385";
+	#address-cells = <1>;
+	#size-cells = <1>;
+	aliases { serial0 = &uart0; };
+	chosen { stdout-path = "serial0:9600n8"; };
+	memory@0 { device_type = "memory"; reg = <0 0x10000000>; };
+	uart0: serial@f1012000 {
+		compatible = "ns16550a";
+		reg = <0xf1012000 0x100>;
+		reg-shift = <2>;
+		reg-io-width = <1>;
+		clock-frequency = <250000000>;
+		bootph-all;
+	};
+	/* USB2, not SDHCI: GL852G hub -> GL834L USB card reader. */
+	usb@f1058000 {
+		compatible = "marvell,orion-ehci";
+		reg = <0xf1058000 0x500>;
+		status = "okay";
+	};
+	timer@f1020300 {
+		compatible = "marvell,armada-xp-timer";
+		reg = <0xf1020300 0x30>;
+		bootph-all;
+	};
+};
