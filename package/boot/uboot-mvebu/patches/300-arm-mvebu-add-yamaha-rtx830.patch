--- /dev/null
+++ b/board/yamaha/rtx830/rtx830.c
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* RTX830 CANZ chainload: DDR, pinmux and peripherals are inherited. */
+#include <init.h>
+#include <stdio.h>
+#include <asm/global_data.h>
+#include <linux/sizes.h>
+#include <linux/mbus.h>
+#include "rtx830.h"
+DECLARE_GLOBAL_DATA_PTR;
+
+int board_early_init_f(void)
+{
+	return 0;
+}
+
+int board_init(void)
+{
+	gd->bd->bi_boot_params = 0x100;
+	if (IS_ENABLED(CONFIG_USB_EHCI_MARVELL)) {
+		/* Inherit CPU windows, including the BootROM SMP aperture. */
+		mvebu_mbus_read_dram_info();
+		if (rtx830_storage_power_enable())
+			printf("RTX830 storage power initialization failed; UART diagnostics remain available.\n");
+		else if (rtx830_status_boot_on())
+			printf("RTX830 STATUS initialization failed; UART diagnostics remain available.\n");
+	}
+	return 0;
+}
+
+int dram_init(void)
+{
+	gd->ram_size = SZ_256M;
+	return 0;
+}
+
+int dram_init_banksize(void)
+{
+	gd->dram[0].start = 0;
+	gd->dram[0].size = SZ_256M;
+	return 0;
+}
+
+int checkboard(void)
+{
+	if (IS_ENABLED(CONFIG_USB_EHCI_MARVELL))
+		puts("Board: RTX830 CANZ SD boot (no persistent environment)\n");
+	else
+		puts("Board: RTX830 CANZ UART experiment (no persistent environment)\n");
+	return 0;
+}
--- /dev/null
+++ b/board/yamaha/rtx830/rtx830.h
@@ -0,0 +1,8 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef _BOARD_YAMAHA_RTX830_H
+#define _BOARD_YAMAHA_RTX830_H
+
+int rtx830_storage_power_enable(void);
+int rtx830_status_boot_on(void);
+
+#endif
--- /dev/null
+++ b/board/yamaha/rtx830/sdboot.c
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Select the soldered GL834L reader without depending on USB disk numbering. */
+#include <blk.h>
+#include <command.h>
+#include <dm.h>
+#include <dm/device-internal.h>
+#include <dm/read.h>
+#include <dm/uclass.h>
+#include <env.h>
+#include <usb.h>
+
+static bool rtx830_internal_reader(struct udevice *storage)
+{
+	struct udevice *hub = dev_get_parent(storage);
+	struct udevice *root, *bus;
+	struct usb_device *reader, *hub_usb;
+
+	if (device_get_uclass_id(storage) != UCLASS_MASS_STORAGE ||
+	    !hub || device_get_uclass_id(hub) != UCLASS_USB_HUB)
+		return false;
+	reader = dev_get_parent_priv(storage);
+	hub_usb = dev_get_parent_priv(hub);
+	if (!reader || !hub_usb || reader->descriptor.idVendor != 0x05e3 ||
+	    reader->descriptor.idProduct != 0x0745 || reader->portnr != 2 ||
+	    hub_usb->descriptor.idVendor != 0x05e3 || hub_usb->portnr != 1)
+		return false;
+
+	/* EHCI root -> on-board Genesys hub port 2 -> GL834L. */
+	root = dev_get_parent(hub);
+	if (!root || device_get_uclass_id(root) != UCLASS_USB_HUB)
+		return false;
+	bus = dev_get_parent(root);
+	return bus && device_get_uclass_id(bus) == UCLASS_USB &&
+		dev_read_addr(bus) == 0xf1058000;
+}
+
+static int do_rtx830_sddev(struct cmd_tbl *cmdtp, int flag, int argc,
+			   char *const argv[])
+{
+	struct udevice *dev;
+	struct uclass *uc;
+	int found = -1;
+
+	/* Never leave a stale/manual selection after a failed automatic scan. */
+	if (env_set("sddev", NULL) || uclass_get(UCLASS_BLK, &uc))
+		return CMD_RET_FAILURE;
+	uclass_foreach_dev(dev, uc) {
+		struct blk_desc *desc = dev_get_uclass_plat(dev);
+
+		if (desc->uclass_id != UCLASS_USB ||
+		    !rtx830_internal_reader(dev_get_parent(dev)))
+			continue;
+		if (device_probe(dev) || !desc->lba)
+			continue;
+		if (found >= 0) {
+			puts("Ambiguous internal microSD devices; not booting\n");
+			return CMD_RET_FAILURE;
+		}
+		found = desc->devnum;
+	}
+	if (found < 0) {
+		puts("Internal microSD not found; use usb tree for diagnosis\n");
+		return CMD_RET_FAILURE;
+	}
+	if (env_set_ulong("sddev", found))
+		return CMD_RET_FAILURE;
+	printf("Internal microSD selected: usb %d\n", found);
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(rtx830_sddev, 1, 0, do_rtx830_sddev,
+	   "select the RTX830 internal microSD USB block device", "");
--- /dev/null
+++ b/board/yamaha/rtx830/storage_power.c
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Independently implemented from the supplied RTX830 SPI0 power specification. */
+#include <stdio.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/types.h>
+#include "rtx830.h"
+
+#define SPI0_BASE       0xf1010600UL
+#define SPI_CTRL        ((void __iomem *)(SPI0_BASE + 0x00))
+#define SPI_CFG         ((void __iomem *)(SPI0_BASE + 0x04))
+#define SPI_DOUT        ((void __iomem *)(SPI0_BASE + 0x08))
+#define SPI_DIN         ((void __iomem *)(SPI0_BASE + 0x0c))
+#define MPP_REG(offset) ((void __iomem *)(0xf1018000UL + (offset)))
+#define SPI_CS_ACTIVE   0x01
+#define SPI_READY       0x02
+#define SPI_CS_MASK     0x1c
+#define SPI_CS2         0x08
+
+static int storage_byte(u8 value)
+{
+	unsigned int i;
+
+	writel(value, SPI_DOUT);
+	udelay(2);
+	for (i = 0; i < 2000; i++) {
+		if (readl(SPI_CTRL) & SPI_READY)
+			return 0;
+		udelay(1);
+	}
+	return -ETIMEDOUT;
+}
+
+/* Only storage power (2) and LED output (4) are addressable. */
+static int board_reg(u8 reg, int write, u8 *value)
+{
+	u32 saved = readl(SPI_CTRL);
+	u32 selected;
+	int ret;
+
+	if (reg != 2 && reg != 4)
+		return -EINVAL;
+	if (saved & SPI_CS_ACTIVE)
+		return -EBUSY;
+	selected = (saved & ~SPI_CS_MASK) | SPI_CS2;
+	writel(selected, SPI_CTRL);
+	writel(selected | SPI_CS_ACTIVE, SPI_CTRL);
+	ret = storage_byte((reg << 2) | (write ? 0 : 0x80));
+	if (!ret)
+		ret = storage_byte(write ? *value : 0xff);
+	if (!ret && !write)
+		*value = readl(SPI_DIN) & 0xff;
+	/* Deassert CS2 even on timeout, then restore the inherited idle value. */
+	writel(selected, SPI_CTRL);
+	writel(saved, SPI_CTRL);
+	return ret;
+}
+
+int rtx830_storage_power_enable(void)
+{
+	u8 before, confirm, after, target, rollback;
+	int ret, rollback_write, rollback_read;
+
+	if (readl(SPI_CFG) != 0x1818 ||
+	    (readl(MPP_REG(8)) & 0xff000000) != 0x11000000 ||
+	    (readl(MPP_REG(12)) & 0x00000f0f) != 0x00000101 ||
+	    (readl(SPI_CTRL) & SPI_CS_ACTIVE)) {
+		printf("RTX830 storage power: inherited SPI0/MPP state rejected\n");
+		return -EINVAL;
+	}
+	ret = board_reg(2, 0, &before);
+	if (ret)
+		return ret;
+	ret = board_reg(2, 0, &confirm);
+	if (ret)
+		return ret;
+	if (before != confirm || before == 0xff) {
+		printf("RTX830 storage power: invalid register 2 reads %02x/%02x\n",
+		       before, confirm);
+		return -EIO;
+	}
+	target = before | 0x03;
+	if (target == before) {
+		printf("RTX830 storage power: register 2 %02x -> %02x (already enabled)\n",
+		       before, before);
+		return 0;
+	}
+	ret = board_reg(2, 1, &target);
+	if (!ret) {
+		ret = board_reg(2, 0, &after);
+		if (!ret && after != target)
+			ret = -EIO;
+	}
+	if (!ret) {
+		printf("RTX830 storage power: register 2 %02x -> %02x\n",
+		       before, after);
+		return 0;
+	}
+
+	/* A failed write may have taken effect: try exactly one rollback. */
+	rollback = before;
+	rollback_write = board_reg(2, 1, &rollback);
+	rollback_read = board_reg(2, 0, &rollback);
+	if (!rollback_write && !rollback_read && rollback == before)
+		printf("RTX830 storage power: enable failed (%d), rollback verified %02x\n",
+		       ret, before);
+	else if (!rollback_read)
+		printf("RTX830 storage power: enable failed (%d), rollback write=%d read=%02x expected=%02x\n",
+		       ret, rollback_write, rollback, before);
+	else
+		printf("RTX830 storage power: enable failed (%d), rollback write=%d read=%d\n",
+		       ret, rollback_write, rollback_read);
+	return ret;
+}
+
+/* Called only after storage power validated the inherited SPI/MPP state. */
+int rtx830_status_boot_on(void)
+{
+	u8 before, confirm, after, target, rollback;
+	int ret, wr, rd;
+
+	ret = board_reg(4, 0, &before);
+	if (ret)
+		return ret;
+	ret = board_reg(4, 0, &confirm);
+	if (ret)
+		return ret;
+	if (before != confirm || before == 0xff)
+		return -EIO;
+	target = before | 1;
+	if (target == before)
+		return 0;
+	ret = board_reg(4, 1, &target);
+	if (!ret) {
+		ret = board_reg(4, 0, &after);
+		if (!ret && after != target)
+			ret = -EIO;
+	}
+	if (!ret) {
+		printf("RTX830 STATUS: on during boot\n");
+		return 0;
+	}
+	rollback = before;
+	wr = board_reg(4, 1, &rollback);
+	rd = board_reg(4, 0, &rollback);
+	if (wr || rd || rollback != before)
+		printf("RTX830 STATUS: rollback could not be verified\n");
+	return ret;
+}
