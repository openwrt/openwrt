{#
 Nimbus theme for LuCI
 Licensed to the public under the Apache License 2.0.
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board');
	const hostname = striptags(boardinfo?.hostname ?? '?');
	const model = striptags(boardinfo?.model ?? '');

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-darkmode="false">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo?.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
		<meta name="darkreader-lock">
		<meta name="color-scheme" content="light dark">
		<script>
			(function() {
				var root = document.documentElement, pref = 'auto', mq = window.matchMedia('(prefers-color-scheme: dark)');
				try { pref = localStorage.getItem('nimbus-theme') || 'auto'; } catch (e) {}
				function apply() {
					var dark = (pref === 'dark') || (pref === 'auto' && mq.matches);
					root.setAttribute('data-darkmode', dark ? 'true' : 'false');
					root.setAttribute('data-theme-pref', pref);
				}
				apply();
				if (mq.addEventListener) mq.addEventListener('change', function() { if (pref === 'auto') apply(); });
				window.nimbusSetTheme = function(p) {
					pref = p;
					try { localStorage.setItem('nimbus-theme', p); } catch (e) {}
					apply();
				};
			})();
		</script>
		<link rel="stylesheet" href="{{ media }}/cascade.css">
		<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }} {{ entityencode(striptags(node?.title ?? ''), true) }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		<div class="nb-app">
			<aside class="nb-sidebar" id="nb-sidebar">
				<a class="nb-brand" href="{{ dispatcher.build_url() }}">
					<img class="nb-brand-logo" src="{{ media }}/logo.svg" alt="" width="34" height="34">
					<span class="nb-brand-text">
						<strong>{{ hostname }}</strong>
						{% if (model): %}<small>{{ model }}</small>{% endif %}
					</span>
				</a>
				<button type="button" class="nb-search-btn" id="nb-search-open" hidden>
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
					<span class="nb-search-label"></span>
					<kbd>⌘K</kbd>
				</button>
				<nav class="nb-nav" id="topmenu" aria-label="Main"></nav>
				<div class="nb-sidebar-foot" id="nb-sidebar-foot"></div>
			</aside>
			<div class="nb-backdrop" id="nb-backdrop"></div>

			<div class="nb-shell">
				<header class="nb-topbar">
					<button type="button" class="nb-icon-btn nb-nav-toggle" id="nb-nav-toggle" aria-label="Menu">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
					</button>
					<nav class="nb-crumbs" id="nb-crumbs" aria-label="Breadcrumb"></nav>
					<div class="nb-topbar-right">
						<div id="indicators" class="nb-indicators"></div>
						<button type="button" class="nb-icon-btn nb-search-mini" id="nb-search-mini" aria-label="Search" hidden>
							<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
						</button>
					</div>
				</header>

				<div id="maincontent" class="container">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
						<div class="alert-message warning">
							<h4>{{ _('No password set!') }}</h4>
							<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
							{% if (dispatcher.lookup("admin/system/admin")): %}
							  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					{% if (boardinfo?.rootfs_type == "initramfs"): %}
						<div class="alert-message warning">
							<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
							<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
							{% if (dispatcher.lookup("admin/system/flash")): %}
							  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					<noscript>
						<div class="alert-message warning">
							<h4>{{ _('JavaScript required!') }}</h4>
							<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
						</div>
					</noscript>

					<div id="tabmenu" style="display:none"></div>
		{% endif %}
