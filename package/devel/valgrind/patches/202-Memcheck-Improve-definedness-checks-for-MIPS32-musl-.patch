--- a/memcheck/tests/mips32/Makefile.am
+++ b/memcheck/tests/mips32/Makefile.am
@@ -7,11 +7,17 @@ dist_noinst_SCRIPTS = \
 EXTRA_DIST = $(noinst_SCRIPTS) \
 	bad_sioc.stderr.exp bad_sioc.stdout.exp bad_sioc.vgtest \
