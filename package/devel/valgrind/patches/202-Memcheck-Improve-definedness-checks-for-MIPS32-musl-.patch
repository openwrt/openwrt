--- /dev/null
+++ b/memcheck/tests/mips32/haszero.c
@@ -0,0 +1,44 @@
+#include <stdint.h>
+#include <stdio.h>
+
+#include "config.h"
+#include "memcheck/memcheck.h"
+
+extern unsigned haszero_add(const uint32_t *, uint32_t, uint32_t);
+extern unsigned haszero_sub(const uint32_t *, uint32_t, uint32_t);
+
+/* Keep the constants out of the translated block's immediate operands. */
+static volatile uint32_t addend = 0xfefefeffU;
+static volatile uint32_t subtrahend = 0x01010101U;
+static volatile uint32_t high_bits = 0x80808080U;
+
+int main(int argc, char **argv)
+{
+   if (argc > 1) {
+#if defined(MUSL_LIBC) && !defined(NVALGRIND)
+      return 0;
+#else
+      return 1;
+#endif
+   }
+
+   uint32_t word = 0x00414141U;
+   unsigned char *bytes = (unsigned char *)&word;
+
+   /* Leave the zero byte defined, regardless of byte order. */
+   for (unsigned i = 0; i < sizeof(word); i++)
+      if (bytes[i] != 0)
+         VALGRIND_MAKE_MEM_UNDEFINED(&bytes[i], 1);
+
+   if (!haszero_add(&word, addend, high_bits) ||
+       !haszero_sub(&word, subtrahend, high_bits)) {
+      fputs("Failed to find the defined zero byte\n", stderr);
+      return 1;
+   }
+
+   /* Both branches now depend on undefined data and should report it. */
+   VALGRIND_MAKE_MEM_UNDEFINED(&word, sizeof(word));
+   unsigned add = haszero_add(&word, addend, high_bits);
+   unsigned sub = haszero_sub(&word, subtrahend, high_bits);
+   return !(add && sub);
+}
--- /dev/null
+++ b/memcheck/tests/mips32/haszero.stderr.exp
@@ -0,0 +1,8 @@
+Conditional jump or move depends on uninitialised value(s)
+   at 0x........: haszero_add (haszero_mips.S:22)
+   by 0x........: main (haszero.c:41)
+
+Conditional jump or move depends on uninitialised value(s)
+   at 0x........: haszero_sub (haszero_mips.S:23)
+   by 0x........: main (haszero.c:42)
+
--- /dev/null
+++ b/memcheck/tests/mips32/haszero.vgtest
@@ -0,0 +1,3 @@
+prereq: ./haszero --supported
+prog: haszero
+vgopts: -q --num-callers=2 --expensive-definedness-checks=auto
--- /dev/null
+++ b/memcheck/tests/mips32/haszero_mips.S
@@ -0,0 +1,23 @@
+	.text
+	.set noreorder
+
+	.macro haszero name, arithmetic
+	.globl \name
+	.type \name, @function
+\name:
+	lw $t0, 0($a0)
+	\arithmetic $v0, $t0, $a1
+	nor $t0, $t0, $zero
+	and $v0, $v0, $t0
+	and $v0, $v0, $a2
+	beqz $v0, 1f
+	move $v0, $zero
+	li $v0, 1
+1:
+	jr $ra
+	nop
+	.size \name, .-\name
+	.endm
+
+	haszero haszero_add, addu
+	haszero haszero_sub, subu
