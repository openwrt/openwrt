       mce.dlbo.dl_CmpEQ64_CmpNE64 = DLexpensive;
 #     elif defined(VGA_arm)
       mce.dlbo.dl_CmpEQ32_CmpNE32 = DLexpensive;
+#     elif defined(VGA_mips32) && defined(MUSL_LIBC)
+      // musl's word-at-a-time string routines can test a word containing
