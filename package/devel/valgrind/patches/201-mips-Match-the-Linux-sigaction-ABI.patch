--- /dev/null
+++ b/none/tests/linux/mips_sigaction_abi.c
@@ -0,0 +1,77 @@
+#include <errno.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+/* MIPS uses a 128-bit mask and has no restorer in the kernel structure. */
+struct kernel_sigaction {
+   unsigned int flags;
+   void (*handler)(int);
+   unsigned long mask[16 / sizeof(unsigned long)];
+};
+
+struct result {
+   struct kernel_sigaction action;
+   volatile unsigned long sentinel;
+};
+
+static const unsigned long sentinel = 0x13579bdfUL;
+static volatile sig_atomic_t delivered;
+
+static void handler(int signo)
+{
+   delivered = signo;
+}
+
+static void check(int condition, const char *message)
+{
+   if (!condition) {
+      fprintf(stderr, "%s\n", message);
+      exit(1);
+   }
+}
+
+int main(void)
+{
+   const unsigned long low_mask = 1UL << (SIGUSR2 - 1);
+   struct kernel_sigaction act = {
+      .flags = SA_RESTART,
+      .handler = handler,
+      .mask = {low_mask, 1}
+   };
+   struct result old = { .sentinel = sentinel };
+
+   check(!syscall(SYS_rt_sigaction, SIGUSR1, &act, NULL, sizeof(act.mask)),
+         "rt_sigaction install failed");
+   check(!syscall(SYS_rt_sigaction, SIGUSR1, NULL, &old.action, sizeof(act.mask)),
+         "rt_sigaction query failed");
+   check(old.sentinel == sentinel, "rt_sigaction changed adjacent data");
+   check(old.action.handler == handler && old.action.flags == SA_RESTART &&
+         old.action.mask[0] == low_mask && old.action.mask[1] == 1,
+         "rt_sigaction returned the wrong action");
+   check(!raise(SIGUSR1) && delivered == SIGUSR1, "signal delivery failed");
+
+#ifdef SYS_sigaction
+   /* Legacy sigaction returns the first mask word and zeros the rest. */
+   if (syscall(SYS_sigaction, SIGUSR1, NULL, &old.action) == 0) {
+      check(old.sentinel == sentinel, "sigaction changed adjacent data");
+      check(old.action.handler == handler && old.action.flags == SA_RESTART &&
+            old.action.mask[0] == low_mask, "sigaction returned the wrong action");
+      for (unsigned i = 1; i < sizeof(act.mask) / sizeof(act.mask[0]); i++)
+         check(old.action.mask[i] == 0, "sigaction failed to clear the upper mask");
+
+      check(!syscall(SYS_sigaction, SIGUSR1, &act, NULL), "sigaction install failed");
+      check(!syscall(SYS_rt_sigaction, SIGUSR1, NULL, &old.action, sizeof(act.mask)),
+            "rt_sigaction query after legacy install failed");
+      check(old.action.mask[0] == low_mask && old.action.mask[1] == 0,
+            "sigaction used more than the first input mask word");
+   } else {
+      check(errno == ENOSYS, "sigaction query failed");
+   }
+#endif
+
+   puts("MIPS sigaction ABI OK");
+   return 0;
+}
