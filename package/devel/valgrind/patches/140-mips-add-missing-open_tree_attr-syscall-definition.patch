From 1378160766199b554aa60a7a7bd4f01449faaa85 Mon Sep 17 00:00:00 2001
From: Petar Jovanovic <mips32r2@gmail.com>
Date: Sun, 8 Nov 2026 01:44:21 +0000
Subject: [PATCH] mips: Add missing open_tree_attr syscall definition

Add missing __NR_open_tree_attr for mips32 and mips64 n32/n64.
This fixes a build break for mips variants.
---
 include/vki/vki-scnums-mips32-linux.h | 1 +
 include/vki/vki-scnums-mips64-linux.h | 2 ++
 2 files changed, 3 insertions(+)

--- a/include/vki/vki-scnums-mips32-linux.h
+++ b/include/vki/vki-scnums-mips32-linux.h
@@ -466,6 +466,7 @@
 #define __NR_lsm_set_self_attr          (__NR_Linux + 460)
 #define __NR_lsm_list_modules           (__NR_Linux + 461)
 #define __NR_mseal                      (__NR_Linux + 462)
+#define __NR_open_tree_attr             (__NR_Linux + 467)
 #define __NR_file_getattr               (__NR_Linux + 468)
 #define __NR_file_setattr               (__NR_Linux + 469)
 /*
--- a/include/vki/vki-scnums-mips64-linux.h
+++ b/include/vki/vki-scnums-mips64-linux.h
@@ -402,6 +402,7 @@
 #define __NR_lsm_set_self_attr      (__NR_Linux + 460)
 #define __NR_lsm_list_modules       (__NR_Linux + 461)
 #define __NR_mseal                  (__NR_Linux + 462)
+#define __NR_open_tree_attr         (__NR_Linux + 467)
 #define __NR_file_getattr           (__NR_Linux + 468)
 #define __NR_file_setattr           (__NR_Linux + 469)
 
@@ -803,6 +804,7 @@
 #define __NR_lsm_set_self_attr       (__NR_Linux + 460)
 #define __NR_lsm_list_modules        (__NR_Linux + 461)
 #define __NR_mseal                   (__NR_Linux + 462)
+#define __NR_open_tree_attr          (__NR_Linux + 467)
 #define __NR_file_getattr            (__NR_Linux + 468)
 #define __NR_file_setattr            (__NR_Linux + 469)
 
