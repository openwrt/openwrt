diff --git a/src/lib/ui/ui.h b/src/lib/ui/ui.h
index 718ed86..db38ba1 100644
--- a/src/lib/ui/ui.h
+++ b/src/lib/ui/ui.h
@@ -18,11 +18,35 @@ extern "C" {
 
 // E87N 统一赛博朋克色板：深色背景、青色主信息、紫色次信息。
 #define UI_CYBER_BG        0x020711
+#define UI_CYBER_PANEL     0x071426
 #define UI_CYBER_CYAN      0x20D9FF
 #define UI_CYBER_VIOLET    0x9B6CFF
 #define UI_CYBER_TRACK     0x17263D
 #define UI_CYBER_BORDER    0x27496D
 
+static inline void ui_cyber_hide_legacy_background(lv_obj_t *background)
+{
+    if (background) {
+        lv_obj_add_flag(background, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+static inline void ui_cyber_style_card(lv_obj_t *card, uint32_t accent)
+{
+    if (!card) {
+        return;
+    }
+
+    lv_obj_set_style_radius(card, 7, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_color(card, lv_color_hex(UI_CYBER_PANEL),
+                              LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_opa(card, 224, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_color(card, lv_color_hex(accent),
+                                  LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_opa(card, 150, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_width(card, 1, LV_PART_MAIN | LV_STATE_DEFAULT);
+}
+
 
