diff --git a/src/data/data_nvme.c b/src/data/data_nvme.c
new file mode 100644
index 0000000000000000000000000000000000000000..da79b3063e0a21d6230ce771b2f0dc47b115fcdd
--- /dev/null
+++ b/src/data/data_nvme.c
@@ -0,0 +1,171 @@
+#include "data_nvme.h"
+#include "data_manager.h"
+#include "../utils/file_utils.h"
+
+#include <ctype.h>
+#include <dirent.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define DEFAULT_HWMON_ROOT "/sys/class/hwmon"
+#define NVME_RAW_TEMP_MIN 0
+#define NVME_RAW_TEMP_MAX 150000
+
+typedef struct {
+    long hwmon_index;
+    int temperature;
+} nvme_sensor_t;
+
+static bool g_available[DATA_NVME_MAX_DEVICES];
+
+static data_type_t data_type_for_index(size_t index)
+{
+    return index == 0 ? DATA_TYPE_NVME0_TEMPERATURE :
+                        DATA_TYPE_NVME1_TEMPERATURE;
+}
+
+static const char *get_hwmon_root(void)
+{
+    const char *override = getenv("HIVETON_HWMON_ROOT");
+    return (override && override[0]) ? override : DEFAULT_HWMON_ROOT;
+}
+
+static void trim_trailing_space(char *value)
+{
+    size_t length = strlen(value);
+    while (length > 0 && isspace((unsigned char)value[length - 1])) {
+        value[--length] = '\0';
+    }
+}
+
+static int parse_hwmon_index(const char *name, long *index)
+{
+    char *end = NULL;
+
+    if (strncmp(name, "hwmon", 5) != 0 || name[5] == '\0') {
+        return -1;
+    }
+
+    *index = strtol(name + 5, &end, 10);
+    return (end && *end == '\0' && *index >= 0) ? 0 : -1;
+}
+
+static void insert_sensor(nvme_sensor_t *sensors, size_t *count,
+                          long hwmon_index, int temperature)
+{
+    size_t position = 0;
+
+    while (position < *count && sensors[position].hwmon_index < hwmon_index) {
+        position++;
+    }
+
+    if (position >= DATA_NVME_MAX_DEVICES) {
+        return;
+    }
+
+    size_t new_count = *count < DATA_NVME_MAX_DEVICES ?
+                       *count + 1 : *count;
+    for (size_t i = new_count - 1; i > position; i--) {
+        sensors[i] = sensors[i - 1];
+    }
+
+    sensors[position].hwmon_index = hwmon_index;
+    sensors[position].temperature = temperature;
+    *count = new_count;
+}
+
+static size_t scan_nvme_sensors(nvme_sensor_t *sensors)
+{
+    const char *root = get_hwmon_root();
+    DIR *directory = opendir(root);
+    struct dirent *entry;
+    size_t count = 0;
+
+    if (!directory) {
+        return 0;
+    }
+
+    while ((entry = readdir(directory)) != NULL) {
+        char path[512];
+        char name[64];
+        long hwmon_index;
+        int raw_temperature;
+
+        if (parse_hwmon_index(entry->d_name, &hwmon_index) != 0) {
+            continue;
+        }
+
+        if (snprintf(path, sizeof(path), "%s/%s/name", root, entry->d_name) >=
+            (int)sizeof(path) ||
+            file_read_line(path, name, sizeof(name)) != 0) {
+            continue;
+        }
+
+        trim_trailing_space(name);
+        if (strcmp(name, "nvme") != 0) {
+            continue;
+        }
+
+        if (snprintf(path, sizeof(path), "%s/%s/temp1_input", root,
+                     entry->d_name) >= (int)sizeof(path) ||
+            file_read_int(path, &raw_temperature) != 0 ||
+            raw_temperature < NVME_RAW_TEMP_MIN ||
+            raw_temperature > NVME_RAW_TEMP_MAX) {
+            continue;
+        }
+
+        int temperature = raw_temperature > 1000 ?
+                          raw_temperature / 1000 : raw_temperature;
+        if (temperature < 0 || temperature > 150) {
+            continue;
+        }
+
+        insert_sensor(sensors, &count, hwmon_index, temperature);
+    }
+
+    closedir(directory);
+    return count;
+}
+
+int data_nvme_init(void)
+{
+    memset(g_available, 0, sizeof(g_available));
+    data_nvme_update();
+    return 0;
+}
+
+void data_nvme_deinit(void)
+{
+    for (size_t i = 0; i < DATA_NVME_MAX_DEVICES; i++) {
+        g_available[i] = false;
+        data_manager_invalidate(data_type_for_index(i));
+    }
+}
+
+int data_nvme_update(void)
+{
+    nvme_sensor_t sensors[DATA_NVME_MAX_DEVICES] = {0};
+    size_t count = scan_nvme_sensors(sensors);
+
+    for (size_t i = 0; i < DATA_NVME_MAX_DEVICES; i++) {
+        data_type_t type = data_type_for_index(i);
+
+        if (i < count) {
+            char value[32];
+            snprintf(value, sizeof(value), "%d ℃", sensors[i].temperature);
+            data_manager_update(type, value, (uint32_t)sensors[i].temperature);
+            g_available[i] = true;
+        } else {
+            data_manager_invalidate(type);
+            g_available[i] = false;
+        }
+    }
+
+    return (int)count;
+}
+
+bool data_nvme_is_available(size_t index)
+{
+    return index < DATA_NVME_MAX_DEVICES && g_available[index];
+}
