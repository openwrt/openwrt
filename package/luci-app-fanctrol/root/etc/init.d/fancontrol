#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/fancontrol

start_service()
{
    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service()
{
    "$PROG" --stop >/dev/null 2>&1
}

reload_service()
{
    # The daemon reads UCI on every control cycle.  Restarting here used to
    # stack with the LuCI apply request and caused repeated service starts.
    return 0
}
