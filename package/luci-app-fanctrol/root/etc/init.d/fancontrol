#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/fancontrol
start_service()
{
    # Keep the daemon alive for both switch states. enable=0 means the live
    # controller continuously holds 0%; stopping the daemon is reserved for a
    # real service/upgrade boundary and therefore remains full-speed fail-safe.
    procd_open_instance controller
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service()
{
    # An ordinary service stop or package upgrade remains full-speed fail-safe.
    "$PROG" --stop >/dev/null 2>&1
}

reload_service()
{
    # The daemon rereads UCI on every control cycle. Restarting here would run
    # --stop and unnecessarily force both the physical fan and UI status to
    # the fail-safe full-speed state.
    return 0
}
