From 987992d1050eeff3ccf7deada2bcf35d8f982743 Mon Sep 17 00:00:00 2001
From: Christian Marangi <ansuelsmth@gmail.com>
Date: Mon, 19 Oct 2026 23:49:49 +0200
Subject: [PATCH] io: add support for libuclient io_url

Add support for an alternative io_url helper that use uclient library.

Signed-off-by: Christian Marangi <ansuelsmth@gmail.com>
---
 meson.build                  |   9 +-
 meson_options.txt            |   2 +-
 src/io_url_libuclient.c      | 135 +++++++++++++
 src/io_url_libuclient_spec.c | 363 +++++++++++++++++++++++++++++++++++
 src/io_url_libuclient_spec.h |  17 ++
 src/meson.build              |   8 +-
 6 files changed, 529 insertions(+), 5 deletions(-)
 create mode 100644 src/io_url_libuclient.c
 create mode 100644 src/io_url_libuclient_spec.c
 create mode 100644 src/io_url_libuclient_spec.h

diff --git a/meson.build b/meson.build
index c098c11cd60c..b6c8da45719f 100644
--- a/meson.build
+++ b/meson.build
@@ -32,6 +32,12 @@ endif
 
 apk_deps = [ crypto_dep, zlib_dep, libzstd_dep ]
 
+if get_option('url_backend') == 'libuclient'
+	url_backend_dep = dependency('uclient')
+else
+	url_backend_dep = dependency('', required: false)
+endif
+
 add_project_arguments('-D_GNU_SOURCE', language: 'c')
 
 # Needed for 64-bit off_t and friends on glibc.
@@ -82,8 +88,7 @@ subdir('doc')
 subdir('portability')
 if get_option('url_backend') == 'libfetch'
 	subdir('libfetch')
-else
-	libfetch_dep = dependency('', required: false)
+	url_backend_dep = libfetch_dep
 endif
 subdir('src')
 if lua_dep.found()
diff --git a/meson_options.txt b/meson_options.txt
index 6341145d9da5..e892a9594d5d 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -11,6 +11,6 @@ option('lua_version', description: 'Lua version to use with unset lua_bin and lu
 option('minimal', description: 'Build with minimal set of commands', type: 'boolean', value: false)
 option('python', description: 'Build python binding', type: 'feature', value: 'auto')
 option('tests', description: 'Build tests', type: 'feature', value: 'auto')
-option('url_backend', description: 'URL backend', type: 'combo', choices: ['libfetch', 'wget'], value: 'libfetch')
