diff --git a/jail/cgroups-bpf.c b/jail/cgroups-bpf.c
index f1bbeff..df8bf8a 100644
--- a/jail/cgroups-bpf.c
+++ b/jail/cgroups-bpf.c
@@ -18,6 +18,10 @@
  */
 
 #include <assert.h>
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <unistd.h>
 #include <linux/bpf.h>
 #ifdef __GLIBC__
 #include <sys/cdefs.h>
@@ -52,6 +56,10 @@ syscall_bpf (int cmd, union bpf_attr *attr, unsigned int size)
 	((struct bpf_insn){                    \
 		.code = BPF_LDX | BPF_SIZE (SIZE) | BPF_MEM, .dst_reg = DST, .src_reg = SRC, .off = OFF, .imm = 0 })
 
+#define BPF_STX_MEM(SIZE, DST, SRC, OFF) \
+	((struct bpf_insn){                    \
+		.code = BPF_STX | BPF_SIZE (SIZE) | BPF_MEM, .dst_reg = DST, .src_reg = SRC, .off = OFF, .imm = 0 })
+
 #define BPF_MOV64_REG(DST, SRC) \
 	((struct bpf_insn){ .code = BPF_ALU64 | BPF_MOV | BPF_X, .dst_reg = DST, .src_reg = SRC, .off = 0, .imm = 0 })
 
@@ -453,3 +461,50 @@ int attach_cgroups_ebpf(int cgroup_dirfd) {
 
 	return syscall_bpf(BPF_PROG_ATTACH, &attach_attr, sizeof (attach_attr));
 }
+
+/*
+ * attach eBPF program binding all AF_INET/AF_INET6 sockets created in the
+ * cgroup to the VRF device vrf_ifindex, the program 'ip vrf exec' uses
+ */
+int attach_vrf_ebpf(int cgroup_dirfd, int vrf_ifindex)
+{
+	struct bpf_insn prog[] = {
+		/* r1 = struct bpf_sock *; r1->bound_dev_if = vrf_ifindex */
+		BPF_MOV64_IMM(BPF_REG_3, vrf_ifindex),
+		BPF_STX_MEM(BPF_W, BPF_REG_1, BPF_REG_3,
+			    offsetof(struct bpf_sock, bound_dev_if)),
+		/* allow */
+		BPF_MOV64_IMM(BPF_REG_0, 1),
+		BPF_EXIT_INSN(),
+	};
+	union bpf_attr load_attr = {
+		.prog_type = BPF_PROG_TYPE_CGROUP_SOCK,
+		.expected_attach_type = BPF_CGROUP_INET_SOCK_CREATE,
+		.license   = (uint64_t)(uintptr_t)license,
+		.insns     = (uint64_t)(uintptr_t)prog,
+		.insn_cnt  = ARRAY_SIZE(prog),
+	};
+	int prog_fd, ret = 0;
+
+	prog_fd = syscall_bpf(BPF_PROG_LOAD, &load_attr, sizeof(load_attr));
+	if (prog_fd < 0) {
+		ret = -errno;
+		ERROR("vrf: BPF_PROG_LOAD: %m\n");
+		return ret;
+	}
+
+	union bpf_attr attach_attr = {
+		.attach_type = BPF_CGROUP_INET_SOCK_CREATE,
+		.target_fd = cgroup_dirfd,
+		.attach_bpf_fd = prog_fd,
+	};
+
+	/* replaces a program attached by an earlier start of the instance */
+	if (syscall_bpf(BPF_PROG_ATTACH, &attach_attr, sizeof(attach_attr))) {
+		ret = -errno;
+		ERROR("vrf: BPF_PROG_ATTACH: %m\n");
+	}
+
+	close(prog_fd);
+	return ret;
+}
