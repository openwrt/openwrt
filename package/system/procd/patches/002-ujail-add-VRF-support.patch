 	if ((opts.namespace & CLONE_NEWNS) && isolate_mountns()) {
 		ERROR("mount propagation failed: %m\n");
 		return EXIT_FAILURE;
@@ -6668,6 +6691,13 @@ int main(int argc, char **argv)
 			if (n_cred_targets < JAIL_MAX_CREDENTIALS)
