+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ */
+
+#ifndef _JAIL_VRF_H
+#define _JAIL_VRF_H
+
+#include <stdbool.h>
+
+bool vrf_name_valid(const char *name);
+
+/*
+ * Bind all AF_INET/AF_INET6 sockets the calling process creates from now on
+ * to the VRF device vrf_name, like 'ip vrf exec': create the cgroup
+ * "vrf/<vrf_name>" below cgroup_dirfd, attach a BPF program setting
+ * sk_bound_dev_if to it and move the calling process into it.
+ *
+ * The VRF is looked up in the current network namespace. Returns 0 or a
+ * negative errno.
+ */
+int vrf_join(int cgroup_dirfd, const char *vrf_name);
+
+#endif
