diff --git a/jail/vrf.c b/jail/vrf.c
new file mode 100644
index 0000000..53c8e41
--- /dev/null
+++ b/jail/vrf.c
@@ -0,0 +1,222 @@
+/*
+ * Copyright (C) 2026 Nick Hainke <vincent@systemli.org>
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU Lesser General Public License version 2.1
+ * as published by the Free Software Foundation
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * Native 'ip vrf exec': look the VRF device up via rtnetlink and bind all
+ * sockets of the process to it with a cgroup BPF program, without libbpf,
+ * libnl or iproute2.
+ */
+
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <sys/socket.h>
+#include <sys/stat.h>
+
+#include <linux/if.h>
+#include <linux/if_link.h>
+#include <linux/netlink.h>
+#include <linux/rtnetlink.h>
+
+#include <libubox/blobmsg.h>
+
+#include "cgroups-bpf.h"
+#include "log.h"
+#include "vrf.h"
+
+#define VRF_CGROUP_DIR "vrf"
+
+/*
+ * Same rules as the kernel's dev_valid_name(). The name is also used as a
+ * cgroup directory name, so this must reject anything containing '/'.
+ */
+bool vrf_name_valid(const char *name)
+{
+	size_t len = strlen(name);
+	size_t i;
+
+	if (len == 0 || len >= IFNAMSIZ)
+		return false;
+
+	if (!strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (i = 0; i < len; i++) {
+		unsigned char c = name[i];
+
+		if (c == '/' || c == ':' || c <= ' ' || c == 0x7f)
+			return false;
+	}
+
+	return true;
+}
+
+static bool vrf_linkinfo_is_vrf(struct rtattr *linkinfo)
+{
+	struct rtattr *rta = RTA_DATA(linkinfo);
+	int len = RTA_PAYLOAD(linkinfo);
+
+	for (; RTA_OK(rta, len); rta = RTA_NEXT(rta, len))
+		if (rta->rta_type == IFLA_INFO_KIND)
+			return RTA_PAYLOAD(rta) >= strlen("vrf") &&
+			       !strncmp(RTA_DATA(rta), "vrf", RTA_PAYLOAD(rta));
+
+	return false;
+}
+
+/* look vrf_name up in the current network namespace, returns its ifindex */
+static int vrf_get_ifindex(const char *vrf_name)
+{
+	struct {
+		struct nlmsghdr hdr;
+		struct ifinfomsg ifi;
+		char attrbuf[RTA_SPACE(IFNAMSIZ)];
+	} req = { 0 };
+	size_t namelen = strlen(vrf_name) + 1;
+	struct nlmsghdr *nh;
+	struct ifinfomsg *ifi;
+	struct rtattr *rta;
+	bool is_vrf = false;
+	char buf[16384];
+	int sock, len, ret;
+	ssize_t n;
+
+	req.hdr.nlmsg_len = NLMSG_LENGTH(sizeof(req.ifi));
+	req.hdr.nlmsg_type = RTM_GETLINK;
+	req.hdr.nlmsg_flags = NLM_F_REQUEST;
+	req.hdr.nlmsg_seq = 1;
+	req.ifi.ifi_family = AF_UNSPEC;
+
+	rta = (struct rtattr *)((char *)&req + NLMSG_ALIGN(req.hdr.nlmsg_len));
+	rta->rta_type = IFLA_IFNAME;
+	rta->rta_len = RTA_LENGTH(namelen);
+	memcpy(RTA_DATA(rta), vrf_name, namelen);
+	req.hdr.nlmsg_len = NLMSG_ALIGN(req.hdr.nlmsg_len) + RTA_ALIGN(rta->rta_len);
+
+	sock = socket(AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_ROUTE);
+	if (sock < 0) {
+		ret = -errno;
+		ERROR("vrf: socket(AF_NETLINK): %m\n");
+		return ret;
+	}
+
+	if (send(sock, &req, req.hdr.nlmsg_len, 0) < 0) {
+		ERROR("vrf: send: %m\n");
+		close(sock);
+		return -EIO;
+	}
+
+	n = recv(sock, buf, sizeof(buf), 0);
+	close(sock);
+	if (n < 0) {
+		ERROR("vrf: recv: %m\n");
+		return -EIO;
+	}
+
+	nh = (struct nlmsghdr *)buf;
+	if (!NLMSG_OK(nh, (size_t)n)) {
+		ERROR("vrf: short or malformed nlmsg (%zd bytes)\n", n);
+		return -EIO;
+	}
+
+	if (nh->nlmsg_type == NLMSG_ERROR) {
+		struct nlmsgerr *err = NLMSG_DATA(nh);
+
+		ERROR("vrf: interface %s: %s\n", vrf_name, strerror(-err->error));
+		return err->error ? err->error : -EIO;
+	}
+
+	if (nh->nlmsg_type != RTM_NEWLINK || nh->nlmsg_len < NLMSG_LENGTH(sizeof(*ifi))) {
+		ERROR("vrf: unexpected nlmsg type %d\n", nh->nlmsg_type);
+		return -EIO;
+	}
+
+	ifi = NLMSG_DATA(nh);
+	len = IFLA_PAYLOAD(nh);
+	for (rta = IFLA_RTA(ifi); RTA_OK(rta, len); rta = RTA_NEXT(rta, len))
+		if (rta->rta_type == IFLA_LINKINFO)
+			is_vrf = vrf_linkinfo_is_vrf(rta);
+
+	if (!is_vrf) {
+		ERROR("vrf: interface %s is not a VRF device\n", vrf_name);
+		return -EINVAL;
+	}
+
+	return ifi->ifi_index;
+}
+
+static int vrf_mkdirat(int dirfd, const char *name)
+{
+	if (mkdirat(dirfd, name, 0700) && errno != EEXIST) {
+		int ret = -errno;
+
+		ERROR("vrf: can't create cgroup %s: %m\n", name);
+		return ret;
+	}
+
+	return 0;
+}
+
+int vrf_join(int cgroup_dirfd, const char *vrf_name)
+{
+	char sub[sizeof(VRF_CGROUP_DIR "/") + IFNAMSIZ];
+	int ifindex, dirfd, fd, ret;
+
+	if (!vrf_name_valid(vrf_name))
+		return -EINVAL;
+
+	ifindex = vrf_get_ifindex(vrf_name);
+	if (ifindex < 0)
+		return ifindex;
+
+	/* named after the VRF, so restarts of the instance reuse it */
+	snprintf(sub, sizeof(sub), VRF_CGROUP_DIR "/%s", vrf_name);
+
+	ret = vrf_mkdirat(cgroup_dirfd, VRF_CGROUP_DIR);
+	if (!ret)
+		ret = vrf_mkdirat(cgroup_dirfd, sub);
+	if (ret)
+		return ret;
+
+	dirfd = openat(cgroup_dirfd, sub, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (dirfd < 0) {
+		ret = -errno;
+		ERROR("vrf: can't open cgroup %s: %m\n", sub);
+		return ret;
+	}
+
+	ret = attach_vrf_ebpf(dirfd, ifindex);
+	if (ret)
+		goto out;
+
+	fd = openat(dirfd, "cgroup.procs", O_WRONLY | O_CLOEXEC);
+	if (fd < 0) {
+		ret = -errno;
+		ERROR("vrf: can't open %s/cgroup.procs: %m\n", sub);
+		goto out;
+	}
+
+	/* "0" is the writing process, also inside a PID namespace */
+	if (write(fd, "0", 1) < 0) {
+		ret = -errno;
+		ERROR("vrf: can't join cgroup %s: %m\n", sub);
+	}
+	close(fd);
+
+out:
+	close(dirfd);
+	return ret;
+}
