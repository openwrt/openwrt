 }
 
+/* remove empty child cgroups, e.g. the VRF cgroups of ujail */
+static void
+instance_rmdir_cgroup_children(int dirfd)
+{
+	struct dirent *e;
+	DIR *dir;
+	int fd;
+
+	dir = fdopendir(dirfd);
+	if (!dir) {
+		close(dirfd);
+		return;
+	}
+
+	while ((e = readdir(dir)) != NULL) {
+		if (e->d_type != DT_DIR || !strcmp(e->d_name, ".") ||
+		    !strcmp(e->d_name, ".."))
+			continue;
+
+		fd = openat(dirfd, e->d_name, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+		if (fd < 0)
+			continue;
+
+		instance_rmdir_cgroup_children(fd);
+		unlinkat(dirfd, e->d_name, AT_REMOVEDIR);
+	}
+
+	closedir(dir);
+}
+
 static void
 instance_rmdir_cgroup(const char *service, const char *instance)
 {
 	char cgnamebuf[256];
 	char *sep;
-	int ret;
+	int fd, ret;
 
 	ret = snprintf(cgnamebuf, sizeof(cgnamebuf), "%s/%s/%s", CGROUP_BASEDIR,
 		       service, instance);
 	if (ret >= (int)sizeof(cgnamebuf))
 		return;
 
+	fd = open(cgnamebuf, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (fd >= 0)
+		instance_rmdir_cgroup_children(fd);
+
 	if (rmdir(cgnamebuf) && errno == EBUSY)
 		ULOG_WARN("failed to remove busy cgroup of %s::%s\n", service,
 			  instance);
@@ -1349,6 +1391,9 @@ instance_config_changed(struct service_instance *in, struct service_instance *in
 	if (string_changed(in->capabilities, in_new->capabilities))
 		return true;
 
+	if (string_changed(in->vrf, in_new->vrf))
+		return true;
+
 	if (!blobmsg_list_equal(&in->limits, &in_new->limits))
 		return true;
 
@@ -1495,12 +1540,11 @@ instance_jail_parse(struct service_instance *in, struct blob_attr *attr)
 {
 	struct blob_attr *tb[__JAIL_ATTR_MAX];
 	struct jail *jail = &in->jail;
-	struct blobmsg_list_node *var;
 
 	blobmsg_parse(jail_attr, __JAIL_ATTR_MAX, tb,
 		blobmsg_data(attr), blobmsg_data_len(attr));
 
-	jail->argc = 6;
+	jail->argc = 0;
 
 	if (tb[JAIL_ATTR_REQUIREJAIL] && blobmsg_get_bool(tb[JAIL_ATTR_REQUIREJAIL])) {
 		in->require_jail = true;
@@ -1601,43 +1645,59 @@ instance_jail_parse(struct service_instance *in, struct blob_attr *attr)
 		instance_fill_array(&jail->mount, tb[JAIL_ATTR_MOUNT], NULL, false);
 	}
 
+	return true;
+}
