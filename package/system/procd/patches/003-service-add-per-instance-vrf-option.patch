+/*
+ * Number of argv entries jail_run() adds for options outside of the jail
+ * table. They are passed to ujail whether or not the instance has one.
+ */
+static int
+instance_jail_common_argc(struct service_instance *in)
+{
+	struct blobmsg_list_node *var;
+	int argc = 6; /* ujail -t <timeout> -A <incarnation> -- */
+
 	blobmsg_list_for_each(&in->env, var)
-		jail->argc += 2;
+		argc += 2;
 
 	if (in->seccomp)
-		jail->argc += 2;
+		argc += 2;
 
 	if (in->seccomp_mode)
-		jail->argc += 2;
+		argc += 2;
 
 	if (in->seccomp_log)
-		jail->argc += 2;
+		argc += 2;
 
 	if (in->capabilities)
-		jail->argc += 2;
+		argc += 2;
+
+	if (in->vrf)
+		argc += 2;
 
 	if (in->user)
-		jail->argc += 2;
+		argc += 2;
 
 	if (in->group)
-		jail->argc += 2;
+		argc += 2;
 
 	if (in->extroot)
-		jail->argc += 2;
+		argc += 2;
 
 	if (in->overlaydir)
-		jail->argc += 2;
+		argc += 2;
 
 	if (in->tmpoverlaysize)
-		jail->argc += 2;
+		argc += 2;
 
 	if (in->no_new_privs)
-		jail->argc++;
+		argc++;
 
 	if (in->bundle)
-		jail->argc += 2;
+		argc += 2;
 
-	return true;
+	return argc;
 }
 
 static bool
@@ -1754,6 +1814,9 @@ instance_config_parse(struct service_instance *in)
 	if (tb[INSTANCE_ATTR_CAPABILITIES])
 		in->capabilities = strdup(blobmsg_get_string(tb[INSTANCE_ATTR_CAPABILITIES]));
 
+	if (tb[INSTANCE_ATTR_VRF] && *blobmsg_get_string(tb[INSTANCE_ATTR_VRF]))
+		in->vrf = strdup(blobmsg_get_string(tb[INSTANCE_ATTR_VRF]));
+
 	if (tb[INSTANCE_ATTR_EXTROOT])
 		in->extroot = strdup(blobmsg_get_string(tb[INSTANCE_ATTR_EXTROOT]));
 
@@ -1839,10 +1902,20 @@ instance_config_parse(struct service_instance *in)
 	if (!in->trace && tb[INSTANCE_ATTR_JAIL])
 		in->has_jail = instance_jail_parse(in, tb[INSTANCE_ATTR_JAIL]);
 
+	/* ujail binds to the VRF, never run the service outside of it */
+	if (in->vrf) {
+		if (in->trace) {
+			ERROR("Cannot trace service %s::%s with vrf %s\n",
+					in->srv->name, in->name, in->vrf);
+			return false;
+		}
+		in->has_jail = true;
+	}
+
 	if (in->has_jail) {
 		r = stat(UJAIL_BIN_PATH, &s);
 		if (r < 0) {
-			if (in->require_jail) {
+			if (in->require_jail || in->vrf) {
 				ERROR("Cannot jail service %s::%s. %s: %m (%d)\n",
 						in->srv->name, in->name, UJAIL_BIN_PATH, r);
 				return false;
@@ -1852,6 +1925,9 @@ instance_config_parse(struct service_instance *in)
 		}
 	}
 
+	if (in->has_jail)
+		in->jail.argc += instance_jail_common_argc(in);
+
 	return true;
 }
 
@@ -1928,6 +2004,7 @@ instance_config_move(struct service_instance *in, struct service_instance *in_sr
 	instance_config_move_strdup(&in->seccomp_mode, in_src->seccomp_mode);
 	instance_config_move_strdup(&in->seccomp_log, in_src->seccomp_log);
 	instance_config_move_strdup(&in->capabilities, in_src->capabilities);
+	instance_config_move_strdup(&in->vrf, in_src->vrf);
 	instance_config_move_strdup(&in->bundle, in_src->bundle);
 	instance_config_move_strdup(&in->extroot, in_src->extroot);
 	instance_config_move_strdup(&in->overlaydir, in_src->overlaydir);
@@ -2054,6 +2131,7 @@ instance_free(struct service_instance *in)
 	free(in->seccomp_mode);
 	free(in->seccomp_log);
 	free(in->capabilities);
+	free(in->vrf);
 	free(in->pidfile);
 	free(in);
 }
@@ -2196,6 +2274,9 @@ void instance_dump(struct blob_buf *b, struct service_instance *in, int verbose)
 	if (in->capabilities)
 		blobmsg_add_string(b, "capabilities", in->capabilities);
 
