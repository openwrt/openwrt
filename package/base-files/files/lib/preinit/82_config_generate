do_config_generate() {
	local generate force

	[ -s /etc/board-base.json ] || {
		# This allows /etc/board.d/* scripts to use values from the uboot environment
		mkdir -p /tmp/.uci
		[ -f /etc/uci-defaults/30_uboot-envtools ] && (. /etc/uci-defaults/30_uboot-envtools)

		# /tmp/board.json was generated by 10_indicate_preinit before
		# mount_root, without access to the uboot environment config
		[ -s /etc/fw_env.config ] && force=-f

		echo "- generating board file -"
		generate=1
	}

	# Earlier preinit code (10_indicate_preinit, x86 diag.sh) leaves its
	# jshn state exported in this shell, board.d scripts running with it
	# would generate a broken board file
	env -i PATH="$PATH" /bin/board_detect $force

	[ -n "$generate" ] && /bin/config_generate > /dev/null
}

boot_hook_add preinit_main do_config_generate
boot_hook_add initramfs do_config_generate
