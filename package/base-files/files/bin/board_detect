#!/bin/sh

REAL_CFG=$1

[ -n "$REAL_CFG" ] || REAL_CFG=/etc/board.json

if [ -d "/etc/board.d/" ] && [ ! -f "$(dirname "$REAL_CFG")/.$(basename "$REAL_CFG").stamp" ]; then
	# Use temp file to prevent incomplete file on power-cut, CFG is used by the sourced script to read/write the file
	CFG="/tmp/$(dirname "$REAL_CFG" | tr '/' '.').$(basename "$REAL_CFG").tmp"
	rm -f "$CFG" || exit
	for a in $(ls /etc/board.d/*); do
		[ -s "$a" ] || continue
		(. "$a")
	done
fi

if [ -s "$CFG" ]; then
	# Use stamp file to prevent incomplete file on power-cut.
	cp "$CFG" "$REAL_CFG" || exit
	touch "$(dirname "$REAL_CFG")/.$(basename "$REAL_CFG").stamp" || exit
else
	rm -f "$CFG"
	exit 1
fi
