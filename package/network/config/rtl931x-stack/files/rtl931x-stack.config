config stack 'main'
	option enabled '0'
	option interface 'lan49'
	option member_id '0'
	option peer_id '1'
	option master_id '0'
	option generation '1'
	option flags '0'
	option boot_policy 'wait'
	option ready_timeout '60'

# boot_policy controls when the network service may start:
#   wait      retry forever until the stack is ready
#   fallback  abandon stacking after ready_timeout and restore local ports
#   fail      stop retrying after ready_timeout and keep networking blocked
