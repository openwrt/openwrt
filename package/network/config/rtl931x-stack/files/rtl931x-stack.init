#!/bin/sh /etc/rc.common

START=18
STOP=89

USE_PROCD=1
PROG=/usr/sbin/rtl931x-stackd

start_service() {
	# Finish local naming before S20network; never wait for stack readiness.
	"$PROG" --name-ports || return 1
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger rtl931x-stack
}
