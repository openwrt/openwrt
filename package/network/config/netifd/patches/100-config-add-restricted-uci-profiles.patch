+ * as published by the Free Software Foundation.
+ */
+#ifndef __NETIFD_CONFIG_SELECTOR_H
+#define __NETIFD_CONFIG_SELECTOR_H
+
+int config_select_profile(void);
+
+#endif
diff --git a/config.c b/config.c
index 063a004..b6e8d76 100644
--- a/config.c
+++ b/config.c
@@ -21,6 +21,7 @@
 #include <libubox/blobmsg_json.h>
 
 #include "netifd.h"
+#include "config-selector.h"
 #include "interface.h"
 #include "interface-ip.h"
 #include "iprule.h"
@@ -46,6 +47,46 @@ struct vlan_config_entry {
 	char name[];
 };
 
+static bool
+config_section_is_loopback(struct uci_section *s)
+{
+	const char *device;
+
+	if (strcmp(s->type, "interface"))
+		return false;
+
+	device = uci_lookup_option_string(uci_ctx, s, "device");
+	if (!device)
+		device = uci_lookup_option_string(uci_ctx, s, "ifname");
+
+	return device && !strcmp(device, "lo");
+}
+
+static bool
+config_section_matches_profile(struct uci_section *s)
+{
+	struct uci_element *e;
+	struct uci_option *o;
+
+	if (!config_profile || config_section_is_loopback(s))
+		return true;
+
+	o = uci_lookup_option(uci_ctx, s, "profile");
+	if (!o)
+		return false;
+
+	if (o->type == UCI_TYPE_STRING)
+		return !strcmp(o->v.string, config_profile);
+	if (o->type != UCI_TYPE_LIST)
+		return false;
+
+	uci_foreach_element(&o->v.list, e)
+		if (!strcmp(e->name, config_profile))
+			return true;
+
+	return false;
+}
+
 static bool
 config_bridge_has_vlans(const char *br_name)
 {
@@ -365,6 +406,8 @@ config_init_devices(bool bridge)
 
 		if (strcmp(s->type, "device") != 0)
 			continue;
+		if (!config_section_matches_profile(s))
+			continue;
 
 		name = uci_lookup_option_string(uci_ctx, s, "name");
 		if (!name)
@@ -392,8 +435,10 @@ config_init_devices(bool bridge)
 		config_device_add(name, devtype, b.head);
 	}
 
-	netifd_ubus_get_procd_data("network-device",
-		bridge ? config_procd_bridge_cb : config_procd_device_cb);
+	if (!config_profile)
+		netifd_ubus_get_procd_data("network-device",
+					   bridge ? config_procd_bridge_cb :
+					   config_procd_device_cb);
 }
 
 enum {
@@ -543,6 +588,8 @@ config_load_vlans(void)
 
 		if (strcmp(s->type, "bridge-vlan") != 0)
 			continue;
+		if (!config_section_matches_profile(s))
+			continue;
 
 		name = uci_lookup_option_string(uci_ctx, s, "device");
 		if (!name)
@@ -551,7 +598,8 @@ config_load_vlans(void)
 		config_load_vlan(name, s);
 	}
 
-	netifd_ubus_get_procd_data("bridge-vlan", config_procd_vlan_cb);
+	if (!config_profile)
+		netifd_ubus_get_procd_data("bridge-vlan", config_procd_vlan_cb);
 }
 
 static void
@@ -627,18 +675,22 @@ config_init_interfaces(void)
 	uci_foreach_element(&uci_network->sections, e) {
 		struct uci_section *s = uci_to_section(e);
 
-		if (!strcmp(s->type, "interface"))
+		if (config_section_matches_profile(s) &&
+		    !strcmp(s->type, "interface"))
 			config_parse_interface(s, false);
 	}
 
 	uci_foreach_element(&uci_network->sections, e) {
 		struct uci_section *s = uci_to_section(e);
 
-		if (!strcmp(s->type, "alias"))
+		if (config_section_matches_profile(s) &&
+		    !strcmp(s->type, "alias"))
 			config_parse_interface(s, true);
 	}
 
-	netifd_ubus_get_procd_data("network-interface", config_procd_interface_cb);
+	if (!config_profile)
+		netifd_ubus_get_procd_data("network-interface",
+					   config_procd_interface_cb);
 	while (!list_empty(&config_ifaces)) {
 		iface = list_first_entry(&config_ifaces, struct interface, node.avl.list);
 		list_del(&iface->node.avl.list);
@@ -660,6 +712,9 @@ config_init_ip(void)
 	uci_foreach_element(&uci_network->sections, e) {
 		struct uci_section *s = uci_to_section(e);
 
+		if (!config_section_matches_profile(s))
+			continue;
+
 		if (!strcmp(s->type, "route"))
 			config_parse_route(s, false);
 		else if (!strcmp(s->type, "route6"))
@@ -684,6 +739,9 @@ config_init_rules(void)
 	uci_foreach_element(&uci_network->sections, e) {
 		struct uci_section *s = uci_to_section(e);
 
+		if (!config_section_matches_profile(s))
+			continue;
+
 		if (!strcmp(s->type, "rule"))
 			config_parse_rule(s, false);
 		else if (!strcmp(s->type, "rule6"))
@@ -815,6 +873,8 @@ config_init_all(void)
 		free(err);
 		return -1;
 	}
+	if (config_select_profile())
+		return -1;
 
 	config_init_board();
 
@@ -834,8 +894,9 @@ config_init_all(void)
 	config_init_devices(true);
 	config_init_vlans();
 	config_init_devices(false);
-	netifd_ucode_config_load(false);
+	if (!config_profile)
+		netifd_ucode_config_load(false);
 	config_init_interfaces();
 	config_free_vlans();
 	config_init_ip();
 	config_init_rules();
@@ -839,7 +900,8 @@ config_init_all(void)
 	vlist_flush(&interfaces);
 	interface_refresh_assignments(false);
 	interface_start_pending();
-	netifd_ucode_config_load(true);
+	if (!config_profile)
+		netifd_ucode_config_load(true);
 
 	return ret;
 }
