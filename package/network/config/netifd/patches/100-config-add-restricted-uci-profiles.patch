diff --git a/config-selector.c b/config-selector.c
new file mode 100644
index 0000000..a5ff993
--- /dev/null
+++ b/config-selector.c
@@ -0,0 +1,237 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * netifd - network interface daemon
+ * Copyright (C) 2026 OpenWrt.org
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2
+ * as published by the Free Software Foundation.
+ */
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <dirent.h>
+#include <errno.h>
+#include <limits.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "netifd.h"
+#include "config-selector.h"
+
+#define CONFIG_SELECTOR_DIRECTORY	"config-selectors.d"
+#define CONFIG_PROFILE_MAX		64
+#define CONFIG_SELECTOR_OUTPUT_MAX	256
+
+/*
+ * Executable selectors are called in lexical order with the UCI configuration
+ * directory as their only argument. Empty output abstains; otherwise stdout
+ * must contain one profile name. A selector error or disagreement aborts the
+ * configuration reload before active state is changed.
+ */
+static bool
+config_profile_char_valid(char c)
+{
+	return isalnum((unsigned char)c) || c == '_' || c == '-' || c == '.';
+}
+
+static int
+config_selector_read(int fd, char *profile, size_t size)
+{
+	bool overflow = false;
+	size_t offset = 0;
+	ssize_t len;
+	char buf[128];
+
+	while ((len = read(fd, buf, sizeof(buf))) != 0) {
+		if (len < 0)
+			return -1;
+
+		if ((size_t)len >= size - offset) {
+			overflow = true;
+			continue;
+		}
+
+		memcpy(profile + offset, buf, len);
+		offset += len;
+	}
+
+	if (overflow)
+		return -1;
+
+	profile[offset] = '\0';
+
+	return 0;
+}
+
+static int
+config_selector_parse(char *profile)
+{
+	char *end;
+	char *start = profile;
+
+	while (isspace((unsigned char)*start))
+		start++;
+
+	end = start + strlen(start);
+	while (end > start && isspace((unsigned char)end[-1]))
+		end--;
+	*end = '\0';
+
+	if (start != profile)
+		memmove(profile, start, end - start + 1);
+	if (!profile[0])
+		return 0;
+	if (strlen(profile) > CONFIG_PROFILE_MAX)
+		return -1;
+
+	for (start = profile; *start; start++)
+		if (!config_profile_char_valid(*start))
+			return -1;
+
+	return 0;
+}
+
+static int
+config_selector_run(const char *path, char *profile, size_t size)
+{
+	int read_error;
+	int pfds[2];
+	int status;
+	pid_t pid;
+
+	if (pipe(pfds))
+		return -1;
+
+	pid = fork();
+	if (pid < 0) {
+		close(pfds[0]);
+		close(pfds[1]);
+		return -1;
+	}
+
+	if (!pid) {
+		close(pfds[0]);
+		if (dup2(pfds[1], STDOUT_FILENO) < 0)
+			_exit(127);
+		close(pfds[1]);
+		execl(path, path, config_path ? config_path : "", NULL);
+		_exit(127);
+	}
+
+	close(pfds[1]);
+	read_error = config_selector_read(pfds[0], profile, size);
+	close(pfds[0]);
+	if (read_error)
+		kill(pid, SIGKILL);
+
+	while (waitpid(pid, &status, 0) < 0) {
+		if (errno == EINTR)
+			continue;
+		return -1;
+	}
+
+	if (read_error || !WIFEXITED(status) || WEXITSTATUS(status))
+		return -1;
+
+	return config_selector_parse(profile);
+}
+
+static int
+config_profile_set(const char *profile)
+{
+	char *new_profile = NULL;
+
+	if (profile[0]) {
+		new_profile = strdup(profile);
+		if (!new_profile)
+			return -1;
+	}
+
+	free(config_profile);
+	config_profile = new_profile;
+	if (config_profile)
+		netifd_log_message(L_NOTICE,
+				   "Using configuration profile %s\n",
+				   config_profile);
+
+	return 0;
+}
+
+int
+config_select_profile(void)
+{
+	char output[CONFIG_SELECTOR_OUTPUT_MAX];
+	char selected[CONFIG_PROFILE_MAX + 1] = {};
+	struct dirent **entries;
+	struct stat st;
+	char directory[PATH_MAX];
+	char path[PATH_MAX];
+	int count;
+	int err = 0;
+	int i;
+	int len;
+
+	len = snprintf(directory, sizeof(directory), "%s/%s", main_path,
+		       CONFIG_SELECTOR_DIRECTORY);
+	if (len < 0 || (size_t)len >= sizeof(directory))
+		return -1;
+
+	count = scandir(directory, &entries, NULL, alphasort);
+	if (count < 0) {
+		if (errno == ENOENT)
+			return config_profile_set("");
+
+		netifd_log_message(L_CRIT,
+				   "Failed to scan configuration selectors: %s\n",
+				   strerror(errno));
+		return -1;
+	}
+
+	for (i = 0; i < count; i++) {
+		if (entries[i]->d_name[0] == '.')
+			goto next;
+		len = snprintf(path, sizeof(path), "%s/%s", directory,
+			       entries[i]->d_name);
+		if (len < 0 || (size_t)len >= sizeof(path)) {
+			err = -1;
+			goto next;
+		}
+		if (stat(path, &st) || !S_ISREG(st.st_mode) ||
+		    access(path, X_OK))
+			goto next;
+
+		output[0] = '\0';
+		if (config_selector_run(path, output, sizeof(output))) {
+			netifd_log_message(L_CRIT,
+					   "Configuration selector %s failed\n",
+					   path);
+			err = -1;
+			goto next;
+		}
+		if (!output[0])
+			goto next;
+		if (selected[0] && strcmp(selected, output)) {
+			netifd_log_message(L_CRIT,
+					   "Configuration selectors disagree: %s and %s\n",
+					   selected, output);
+			err = -1;
+			goto next;
+		}
+		strcpy(selected, output);
+next:
+		free(entries[i]);
+	}
+
+	free(entries);
+	if (err)
+		return err;
+
+	return config_profile_set(selected);
+}
