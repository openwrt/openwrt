new file mode 100644
index 0000000..e846e72
--- /dev/null
+++ b/config-selector.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * netifd - network interface daemon
+ * Copyright (C) 2026 OpenWrt.org
