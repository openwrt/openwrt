-/* Set until and including the next DTIM Beacon (IEEE Std 802.11be-2024,
- * 35.3.10); the driver counts DTIMs. */
+/* A nontransmitted BSSID sends no Beacon frames of its own, so the driver does
+ * not end its flag */
+static bool hostapd_crit_update_offload(struct hostapd_data *hapd)
+{
+	return (hapd->iface->drv_flags2 &
+		WPA_DRIVER_FLAGS2_BEACON_CRIT_UPDATE) &&
+		hostapd_mbssid_get_tx_bss(hapd) == hapd;
+}
+
+
+/* Until and including the next DTIM Beacon (IEEE Std 802.11be-2024, 35.3.10).
+ * Without the driver, which sees the DTIM Count, the flag is set for DTIM
+ * period + 1 counts, which hold the next DTIM Beacon also when a Beacon update
+ * takes effect later than the one before it. */
 bool hostapd_link_remove_critical_update(struct hostapd_data *hapd)
 {
 	struct hostapd_data *link_bss;
@@ -464,6 +476,9 @@ bool hostapd_link_remove_critical_update
 	if (!hapd->conf->mld_ap || !hapd->mld)
 		return false;
 
+	if (hostapd_crit_update_offload(hapd))
+		return hapd->eht_mld_crit_update;
+
 	for_each_mld_link(link_bss, hapd) {
 		u16 announced = link_bss->eht_mld_link_removal_start -
 			link_bss->eht_mld_link_removal_count;
@@ -754,6 +769,23 @@ static void hostapd_link_remove_timeout_
 }
 
 
+/* A new ID starts a new critical update in the driver, also before hostapd
+ * reads the event of the previous one */
+static void hostapd_mld_crit_update_start(struct hostapd_data *hapd)
+{
+	struct hostapd_data *link_bss;
+
+	for_each_mld_link(link_bss, hapd) {
+		if (!link_bss->started || !hostapd_crit_update_offload(link_bss))
+			continue;
+
+		link_bss->eht_mld_crit_update = true;
+		if (!++link_bss->eht_mld_crit_update_id)
+			link_bss->eht_mld_crit_update_id = 1;
+	}
+}
+
+
 /* A repeated request must not set the AP Removal Timer back (IEEE Std
  * 802.11be-2024, 35.3.6.3). */
 int hostapd_link_remove(struct hostapd_data *hapd, u32 count)
@@ -795,12 +827,34 @@ int hostapd_link_remove(struct hostapd_d
 	if (hapd->eht_mld_bss_param_change == 255)
 		hapd->eht_mld_bss_param_change = 0;
 
+	hostapd_mld_crit_update_start(hapd);
 	ieee802_11_set_beacon(hapd);
 	os_get_reltime(&hapd->eht_mld_link_removal_due);
 	hostapd_link_remove_timeout_register(hapd);
 	return 0;
 }
 
+
+/* Unlike switch_link_hapd(), a link that hostapd no longer has is not
+ * replaced by the first link */
+void hostapd_crit_update_done(struct hostapd_data *hapd, int link_id, u32 id)
+{
+	if (link_id < 0 || !hapd->conf->mld_ap || !hapd->mld)
+		return;
+
+	hapd = hostapd_mld_get_link_bss(hapd, link_id);
+	if (!hapd || !hapd->eht_mld_crit_update ||
+	    id != hapd->eht_mld_crit_update_id)
+		return;
+
+	wpa_printf(MSG_DEBUG, "MLD: Critical update done, link_id=%u",
+		   hapd->mld_link_id);
+
+	hapd->eht_mld_crit_update = false;
+	if (hapd->started && hapd->beacon_set_done)
+		ieee802_11_set_beacon(hapd);
+}
+
