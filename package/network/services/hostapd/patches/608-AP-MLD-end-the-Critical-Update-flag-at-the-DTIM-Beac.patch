+static void nl80211_crit_update_done_event(struct i802_bss *bss,
+					   struct nlattr *tb[])
+{
+	union wpa_event_data data;
+
+	os_memset(&data, 0, sizeof(data));
+	data.crit_update_done.link_id = NL80211_DRV_LINK_ID_NA;
+
+	if (tb[NL80211_ATTR_MLO_LINK_ID]) {
+		data.crit_update_done.link_id =
+			nla_get_u8(tb[NL80211_ATTR_MLO_LINK_ID]);
+
+		if (!nl80211_link_valid(bss->valid_links,
+					data.crit_update_done.link_id)) {
+			wpa_printf(MSG_DEBUG,
+				   "nl80211: Invalid critical update event link ID %d",
+				   data.crit_update_done.link_id);
+			return;
+		}
+	}
+
+	if (tb[NL80211_ATTR_CRIT_UPDATE_ID])
+		data.crit_update_done.id =
+			nla_get_u32(tb[NL80211_ATTR_CRIT_UPDATE_ID]);
+
+	wpa_printf(MSG_DEBUG,
+		   "nl80211: Critical update done - Link ID %d ID %u",
+		   data.crit_update_done.link_id, data.crit_update_done.id);
+
+	wpa_supplicant_event(bss->ctx, EVENT_CRIT_UPDATE_DONE, &data);
+}
+
