--- a/src/ap/ieee802_1x.c
+++ b/src/ap/ieee802_1x.c
@@ -1550,6 +1550,30 @@ void ieee802_1x_free_station(struct host
 }
 
 
+/* The links of an AP MLD share the authenticator, so the state machine of a
+ * non-AP MLD goes on with the STA that becomes its association STA. */
+void ieee802_1x_move_station(struct hostapd_data *new_hapd,
+			     struct sta_info *sta, struct sta_info *new_sta)
+{
+	struct eapol_state_machine *sm = sta->eapol_sm;
+
+	os_free(new_sta->identity);
+	new_sta->identity = sta->identity;
+	sta->identity = NULL;
+	os_free(new_sta->radius_cui);
+	new_sta->radius_cui = sta->radius_cui;
+	sta->radius_cui = NULL;
+
+	if (!sm)
+		return;
+
+	ieee802_1x_free_station(new_hapd, new_sta);
+	sta->eapol_sm = NULL;
+	sm->sta = new_sta;
+	new_sta->eapol_sm = sm;
+}
+
