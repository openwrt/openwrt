+/* The links of an AP MLD share the IEEE 802.1X authenticator of the first BSS,
+ * which calls back with that BSS. A non-MLO station has its entry on the link
+ * it associated to alone. */
+static struct hostapd_data * ieee802_1x_sta_bss(struct hostapd_data *hapd,
+						 struct sta_info *sta)
+{
+#ifdef CONFIG_IEEE80211BE
+	struct hostapd_data *link;
+
+	if (!hapd->conf->mld_ap || !hapd->mld || ap_sta_is_mld(hapd, sta))
+		return hapd;
+
+	for_each_mld_link(link, hapd) {
+		if (ap_get_sta(link, sta->addr) == sta)
+			return link;
+	}
+#endif /* CONFIG_IEEE80211BE */
+
+	return hapd;
+}
+
