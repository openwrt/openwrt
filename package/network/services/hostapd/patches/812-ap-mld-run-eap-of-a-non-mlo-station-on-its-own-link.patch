+/* An entry of an MLO station on a link other than its association link */
+static bool hostapd_das_partner_sta(struct hostapd_data *hapd,
+				    struct sta_info *sta)
+{
+#ifdef CONFIG_IEEE80211BE
+	return ap_sta_is_mld(hapd, sta) &&
+		sta->mld_assoc_link_id != hapd->mld_link_id;
+#else /* CONFIG_IEEE80211BE */
+	return false;
+#endif /* CONFIG_IEEE80211BE */
+}
+
+
+/* RADIUS DAS of an AP MLD is that of its first BSS, while a non-MLO station
+ * has its entry on the link it associated to alone. */
+static struct sta_info * hostapd_das_find_mld_sta(struct hostapd_data **hapd,
+						  struct radius_das_attrs *attr,
+						  int *multi)
+{
+	struct hostapd_data *first = *hapd;
+	struct sta_info *sta, *found = NULL;
+#ifdef CONFIG_IEEE80211BE
+	struct hostapd_data *link;
+#endif /* CONFIG_IEEE80211BE */
+
+	sta = hostapd_das_find_sta(first, attr, multi);
+	if (sta && !hostapd_das_partner_sta(first, sta))
+		found = sta;
+
+#ifdef CONFIG_IEEE80211BE
+	if (*multi || !first->conf->mld_ap || !first->mld)
+		return found;
+
+	for_each_mld_link(link, first) {
+		if (link == first)
+			continue;
+		sta = hostapd_das_find_sta(link, attr, multi);
+		if (*multi)
+			return NULL;
+		if (!sta || hostapd_das_partner_sta(link, sta))
+			continue;
+		if (found) {
+			*multi = 1;
+			return NULL;
+		}
+		found = sta;
+		*hapd = link;
+	}
+#endif /* CONFIG_IEEE80211BE */
+
+	return found;
+}
