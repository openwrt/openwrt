 }
 
 
+/* The EAP-SIM DB of an AP MLD is that of its first BSS, while a non-MLO
+ * station has its entry on the link it associated to alone. */
+static int hostapd_sim_db_cb_links(struct hostapd_data *hapd,
+				   void *session_ctx)
+{
+#ifdef CONFIG_IEEE80211BE
+	struct hostapd_data *link;
+
+	if (!hapd->conf->mld_ap || !hapd->mld)
+		return 0;
+
+	for_each_mld_link(link, hapd) {
+		if (link != hapd &&
+		    ap_for_each_sta(link, hostapd_sim_db_cb_sta, session_ctx))
+			return 1;
+	}
+#endif /* CONFIG_IEEE80211BE */
+
+	return 0;
+}
