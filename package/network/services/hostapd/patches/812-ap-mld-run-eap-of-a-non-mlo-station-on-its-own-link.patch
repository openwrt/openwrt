+/**
+ * ap_get_sta_mld_links - Find a station entry on a BSS or the links of its MLD
+ * @hapd: BSS to search first; set to the BSS of the returned entry
+ * @addr: Station address
+ * @match: Filter for the entries, or %NULL to accept any entry
+ * Returns: The station entry or %NULL if no entry matches
+ *
+ * The links of an AP MLD share objects whose callbacks name the first BSS,
+ * while a non-MLO station has its entry on the link it associated to alone.
+ */
+struct sta_info * ap_get_sta_mld_links(struct hostapd_data **hapd,
+				       const u8 *addr,
+				       bool (*match)(struct hostapd_data *hapd,
+						     struct sta_info *sta))
+{
+	struct hostapd_data *bss = *hapd;
+	struct sta_info *sta;
+#ifdef CONFIG_IEEE80211BE
+	struct hostapd_data *link;
+#endif /* CONFIG_IEEE80211BE */
+
+	sta = ap_get_sta(bss, addr);
+	if (sta && (!match || match(bss, sta)))
+		return sta;
+
+#ifdef CONFIG_IEEE80211BE
+	if (!bss->conf->mld_ap || !bss->mld)
+		return NULL;
+
+	for_each_mld_link(link, bss) {
+		if (link == bss)
+			continue;
+		sta = ap_get_sta(link, addr);
+		if (sta && (!match || match(link, sta))) {
+			*hapd = link;
+			return sta;
+		}
+	}
+#endif /* CONFIG_IEEE80211BE */
+
+	return NULL;
+}
