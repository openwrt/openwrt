+/* The colours of the OBSSs around the radio, which the kernel's BSS colour
+ * collision events and the BSS Color Collision reports of stations name. A
+ * colour stays BSS_COLOR_EVENT_AGE seconds after an event names it, and
+ * BSS_COLOR_REPORT_AGE seconds after a report does:
+ * - the kernel repeats an event every 500 ms while it hears the colliding
+ *   OBSS, and hostapd judges a collision persistent within
+ *   DOT11BSS_COLOR_COLLISION_AP_PERIOD + 10 s;
+ * - a station repeats its report every dot11BSSColorCollisionSTAPeriod, at
+ *   most 120 s (IEEE Std 802.11-2024 26.17.3.5.2), and the 10 s margin, the
+ *   one hostapd gives its own period, covers a report that the station's
+ *   power save or retries delay.
+ * Stations stop reporting while the AP disables BSS Color (26.17.3.5.2), and
+ * mac80211 compares no OBSS colour then, so the ageing pauses while BSS Color
+ * is disabled: its clock stays at the start of the pause, and the length of
+ * the pause is added to each expiry when it resumes. */
+#define BSS_COLOR_EVENT_AGE (DOT11BSS_COLOR_COLLISION_AP_PERIOD + 10)
+#define BSS_COLOR_REPORT_AGE (120 + 10)
+
+static void hostapd_bss_colors_in_use_age(struct hostapd_iface *iface,
+					  u64 added, os_time_t age)
+{
+	struct os_reltime now;
+	os_time_t next = 0, clock;
+	u64 in_use = 0;
+	bool paused;
+	int i;
+
+	if (os_get_reltime(&now))
+		return;
+
+	eloop_cancel_timeout(hostapd_bss_colors_in_use_timeout, iface, NULL);
+
+	paused = iface->conf->he_op.he_bss_color_disabled;
+	if (paused && !iface->bss_color_aging_paused) {
+		iface->bss_color_aging_paused = true;
+		iface->bss_color_paused_at = now;
+	} else if (!paused && iface->bss_color_aging_paused) {
+		iface->bss_color_aging_paused = false;
+		for (i = 1; i < 64; i++)
+			iface->bss_color_expiry[i].sec +=
+				now.sec - iface->bss_color_paused_at.sec;
+	}
+	clock = paused ? iface->bss_color_paused_at.sec : now.sec;
+
+	for (i = 1; i < 64; i++) {
+		os_time_t left;
+
+		if (!((iface->bss_colors_in_use | added) & BIT_ULL(i)))
+			continue;
+
+		if ((added & BIT_ULL(i)) &&
+		    (!(iface->bss_colors_in_use & BIT_ULL(i)) ||
+		     iface->bss_color_expiry[i].sec < clock + age))
+			iface->bss_color_expiry[i].sec = clock + age;
+
+		left = iface->bss_color_expiry[i].sec - clock;
+		if (!paused && left <= 0)
+			continue;
+
+		in_use |= BIT_ULL(i);
+		if (!paused && (!next || left < next))
+			next = left;
+	}
+
+	if (next)
+		eloop_register_timeout(next, 0,
+				       hostapd_bss_colors_in_use_timeout,
+				       iface, NULL);
+
+	iface->bss_colors_in_use = in_use;
+}
+
+
+void hostapd_bss_colors_in_use_timeout(void *eloop_data, void *user_ctx)
+{
+	hostapd_bss_colors_in_use_age(eloop_data, 0, 0);
+}
+
+
+/* BSS Color Disabled pauses and resumes the ageing, so each runtime change of
+ * it goes through here. */
+void hostapd_bss_color_disabled_set(struct hostapd_iface *iface, u8 disabled)
+{
+	iface->conf->he_op.he_bss_color_disabled = disabled;
+	hostapd_bss_colors_in_use_age(iface, 0, 0);
+}
+
+
+/* The colours of a kernel BSS colour collision event. Colour 0 is no colour. */
+void hostapd_bss_colors_collision_event(struct hostapd_iface *iface,
+					u64 bitmap)
+{
+	hostapd_bss_colors_in_use_age(iface, bitmap & ~BIT_ULL(0),
+				      BSS_COLOR_EVENT_AGE);
+}
+
+
+/* The colours of a BSS Color Collision report of a station. */
+void hostapd_bss_colors_collision_report(struct hostapd_iface *iface,
+					 u64 bitmap)
+{
+	hostapd_bss_colors_in_use_age(iface, bitmap & ~BIT_ULL(0),
+				      BSS_COLOR_REPORT_AGE);
+}
+
+
+/* The colours a colour change avoids: those of the OBSSs, and those that
+ * associated stations use with a peer (BSS Color In Use reports, IEEE Std
+ * 802.11-2024 11.21.2.8), which hold until the station cancels its report
+ * with colour 0 or leaves. A station's colour is no OBSS colour, so it is not
+ * one of bss_colors_in_use. */
+u64 hostapd_bss_colors_avoided(struct hostapd_iface *iface)
+{
+	u64 avoided = iface->bss_colors_in_use;
+	struct sta_info *sta;
+	size_t j;
+
+	for (j = 0; j < iface->num_bss; j++)
+		for (sta = iface->bss[j]->sta_list; sta; sta = sta->next)
+			if (sta->bss_color_in_use)
+				avoided |= BIT_ULL(sta->bss_color_in_use);
+
+	return avoided;
+}
+
