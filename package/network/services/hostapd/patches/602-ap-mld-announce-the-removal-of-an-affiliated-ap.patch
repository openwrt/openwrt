 {
-#ifdef CONFIG_TESTING_OPTIONS
 	struct hostapd_data *other_hapd;
 	u16 control;
 	u8 *pos = eid;
@@ -818,9 +815,6 @@ static u8 * hostapd_eid_eht_reconf_ml(st
 
 	wpa_hexdump(MSG_DEBUG, "MLD: Reconfiguration ML", eid, eid[1] + 2);
 	return pos;
-#else /* CONFIG_TESTING_OPTIONS */
