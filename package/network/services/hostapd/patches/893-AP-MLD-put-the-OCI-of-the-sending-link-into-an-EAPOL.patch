+static int hostapd_sta_eapol_link_id(struct hostapd_data *hapd,
+				     struct sta_info *sta)
+{
+#ifdef CONFIG_IEEE80211BE
+	bool ocv = false;
+
+	if (!hapd->conf->mld_ap)
+		return -1;
+	if (!sta)
+		return hapd->mld_link_id;
+#ifdef CONFIG_OCV
+	ocv = wpa_auth_uses_ocv(sta->wpa_sm);
+#endif /* CONFIG_OCV */
+	/* The OCI of an EAPOL-Key frame names the channel of the link that
+	 * carries it */
+	if (ap_sta_is_mld(hapd, sta) && (sta->flags & WLAN_STA_AUTHORIZED) &&
+	    !ocv)
+		return -1;
+	return hostapd_mld_sta_tx_link_id(hapd, sta);
+#else /* CONFIG_IEEE80211BE */
+	return -1;
+#endif /* CONFIG_IEEE80211BE */
+}
