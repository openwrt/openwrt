From: Felix Fietkau <nbd@nbd.name>
Date: Sat, 7 Feb 2026 09:20:30 +0000
Subject: [PATCH] DPP: Move to the next chirp channel when the TX request fails

If the TX request for a Presence Announcement fails,
wpas_dpp_chirp_start() and hostapd_dpp_chirp_start() stop chirping. The
chirp channel list includes the channels of APs from the scan results
that advertise the Configurator Connectivity element. These can be DFS
channels, where the TX request can fail.

Continue with the next channel instead. In wpa_supplicant, handle the
failure like a failed TX status.

Signed-off-by: Felix Fietkau <nbd@nbd.name>
---

--- a/src/ap/dpp_hostapd.c
+++ b/src/ap/dpp_hostapd.c
@@ -3654,8 +3654,16 @@ static void hostapd_dpp_chirp_start(stru
 		MAC2STR(broadcast), hapd->dpp_chirp_freq, type);
 	if (hostapd_drv_send_action(
 		    hapd, hapd->dpp_chirp_freq, 2000, broadcast,
-		    wpabuf_head(msg), wpabuf_len(msg)) < 0 ||
-	    eloop_register_timeout(2, 0, hostapd_dpp_chirp_timeout,
+		    wpabuf_head(msg), wpabuf_len(msg)) < 0) {
+		wpa_printf(MSG_DEBUG, "DPP: Failed to send chirp on %d MHz",
+			   hapd->dpp_chirp_freq);
+		if (eloop_register_timeout(0, 0, hostapd_dpp_chirp_next,
+					   hapd, NULL) < 0)
+			hostapd_dpp_chirp_stop(hapd);
+		return;
+	}
+
+	if (eloop_register_timeout(2, 0, hostapd_dpp_chirp_timeout,
 				   hapd, NULL) < 0)
 		hostapd_dpp_chirp_stop(hapd);
 }
--- a/wpa_supplicant/dpp_supplicant.c
+++ b/wpa_supplicant/dpp_supplicant.c
@@ -5136,7 +5136,10 @@ static void wpas_dpp_chirp_start(struct
 		    wpa_s->own_addr, broadcast,
 		    wpabuf_head(msg), wpabuf_len(msg),
 		    2000, wpas_dpp_chirp_tx_status, 0) < 0)
-		wpas_dpp_chirp_stop(wpa_s);
+		wpas_dpp_chirp_tx_status(wpa_s, wpa_s->dpp_chirp_freq,
+					 broadcast, wpa_s->own_addr, broadcast,
+					 wpabuf_head(msg), wpabuf_len(msg),
+					 OFFCHANNEL_SEND_ACTION_FAILED);
 
 	wpabuf_free(announce);
 }
