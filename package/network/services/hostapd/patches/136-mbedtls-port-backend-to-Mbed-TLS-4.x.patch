+static psa_algorithm_t crypto_mbedtls_psa_hash_alg(mbedtls_md_type_t md_type)
+{
+	psa_algorithm_t alg = mbedtls_md_psa_alg_from_type(md_type);
+	return PSA_ALG_IS_HASH(alg) ? alg : PSA_ALG_NONE;
+}
+
+static int crypto_mbedtls_psa_cipher(psa_key_type_t type, psa_algorithm_t alg,
+                                     psa_key_usage_t usage,
+                                     const u8 *key, size_t key_len,
+                                     const u8 *iv, size_t iv_len,
+                                     u8 *data, size_t data_len)
+{
+	psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
+	psa_cipher_operation_t op = PSA_CIPHER_OPERATION_INIT;
+	psa_key_id_t key_id = PSA_KEY_ID_NULL;
+	size_t olen = 0, flen = 0;
+	psa_status_t status;
+
+	psa_set_key_type(&attr, type);
+	psa_set_key_algorithm(&attr, alg);
+	psa_set_key_usage_flags(&attr, usage);
+	status = psa_import_key(&attr, key, key_len, &key_id);
+	psa_reset_key_attributes(&attr);
+	if (status != PSA_SUCCESS)
+		return -1;
+
+	status = (usage == PSA_KEY_USAGE_ENCRYPT)
+	  ? psa_cipher_encrypt_setup(&op, key_id, alg)
+	  : psa_cipher_decrypt_setup(&op, key_id, alg);
+	if (status == PSA_SUCCESS && iv_len)
+		status = psa_cipher_set_iv(&op, iv, iv_len);
+	if (status == PSA_SUCCESS)
+		status = psa_cipher_update(&op, data, data_len, data, data_len,
+		                           &olen);
+	if (status == PSA_SUCCESS)
+		status = psa_cipher_finish(&op, data + olen, data_len - olen,
+		                           &flen);
+	psa_cipher_abort(&op);
+	psa_destroy_key(key_id);
+	return (status == PSA_SUCCESS && olen + flen == data_len) ? 0 : -1;
+}
+
+int aes_128_encrypt_block_psa(const u8 *key, const u8 *in, u8 *out)
+{
+	os_memcpy(out, in, 16);
+	return crypto_mbedtls_psa_cipher(PSA_KEY_TYPE_AES, PSA_ALG_ECB_NO_PADDING,
+	                                 PSA_KEY_USAGE_ENCRYPT, key, 16,
+	                                 NULL, 0, out, 16);
+}
+
+int aes_128_cbc_encrypt_psa(const u8 *key, const u8 *iv, u8 *data,
+                            size_t data_len)
+{
+	return crypto_mbedtls_psa_cipher(PSA_KEY_TYPE_AES, PSA_ALG_CBC_NO_PADDING,
+	                                 PSA_KEY_USAGE_ENCRYPT, key, 16,
+	                                 iv, 16, data, data_len);
+}
+
+int aes_128_cbc_decrypt_psa(const u8 *key, const u8 *iv, u8 *data,
+                            size_t data_len)
+{
+	return crypto_mbedtls_psa_cipher(PSA_KEY_TYPE_AES, PSA_ALG_CBC_NO_PADDING,
+	                                 PSA_KEY_USAGE_DECRYPT, key, 16,
+	                                 iv, 16, data, data_len);
+}
+
+int aes_ctr_encrypt_psa(const u8 *key, size_t key_len, const u8 *nonce,
+                        u8 *data, size_t data_len)
+{
+	return crypto_mbedtls_psa_cipher(PSA_KEY_TYPE_AES, PSA_ALG_CTR,
+	                                 PSA_KEY_USAGE_ENCRYPT, key, key_len,
+	                                 nonce, 16, data, data_len);
+}
+
+static int crypto_mbedtls_psa_mac(psa_key_type_t type, psa_algorithm_t alg,
+                                  const u8 *key, size_t key_len,
+                                  size_t num_elem, const u8 *addr[],
+                                  const size_t *len, u8 *mac, size_t mac_size)
+{
+	psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
+	psa_mac_operation_t op = PSA_MAC_OPERATION_INIT;
+	psa_key_id_t key_id = PSA_KEY_ID_NULL;
+	static const u8 zero = 0;
+	size_t olen = 0;
+	psa_status_t status;
+
+	/* HMAC pads the key with zeros to the block size, so an empty key and
+	 * a single zero byte give the same result; PSA rejects empty keys. */
+	if (key_len == 0 && type == PSA_KEY_TYPE_HMAC) {
+		key = &zero;
+		key_len = 1;
 	}
+
+	psa_set_key_type(&attr, type);
+	psa_set_key_algorithm(&attr, alg);
+	psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_SIGN_MESSAGE);
+	status = psa_import_key(&attr, key, key_len, &key_id);
+	psa_reset_key_attributes(&attr);
+	if (status != PSA_SUCCESS)
+		return -1;
+
+	status = psa_mac_sign_setup(&op, key_id, alg);
+	for (size_t i = 0; status == PSA_SUCCESS && i < num_elem; ++i)
+		status = psa_mac_update(&op, addr[i], len[i]);
+	if (status == PSA_SUCCESS)
+		status = psa_mac_sign_finish(&op, mac, mac_size, &olen);
+	psa_mac_abort(&op);
+	psa_destroy_key(key_id);
+	return status == PSA_SUCCESS ? 0 : -1;
+}
+
+int omac1_aes_vector_psa(const u8 *key, size_t key_len, size_t num_elem,
+                         const u8 *addr[], const size_t *len, u8 *mac)
+{
+	if (key_len != 16 && key_len != 24 && key_len != 32)
+		return -1;
+	return crypto_mbedtls_psa_mac(PSA_KEY_TYPE_AES, PSA_ALG_CMAC,
+	                              key, key_len, num_elem, addr, len,
+	                              mac, 16);
 }
 
