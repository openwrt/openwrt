From ad66108dbc5a8a28b7164c6cd05eda6550f94481 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Old=C5=99ich=20Jedli=C4=8Dka?= <oldium.pro@gmail.com>
Date: Fri, 20 Nov 2026 20:35:22 +0100
Subject: [PATCH] FT: Use the VLAN ID of the PSK with ft_psk_generate_local=1
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A PSK in wpa_psk_file can have a VLAN ID (vlanid=<VLAN ID>). After the
4-way handshake, wpa_auth_update_vlan() assigns the STA to the VLAN of
the PSK that matched. With ft_psk_generate_local=1, FT-PSK finds the
PSK in wpa_ft_psk_pmk_r1() without fetching its VLAN ID, and
wpa_ft_set_vlan() then sets the VLAN that the STA entry on the target
AP has, which is normally none. The STA thus leaves the VLAN of its PSK
when it roams with FT.

Fetch the VLAN ID together with the PSK. If the matching PSK has a VLAN
ID, use it as the VLAN of the STA in place of the VLAN of the STA
entry, which wpa_auth_update_vlan() replaces in the same way. Leave the
VLAN as it is with CONFIG_NO_VLAN, where wpa_auth_update_vlan() does
not change it either.

This is based on a fix by regae in an OpenWrt fork:
https://github.com/regae/openwrt/commit/f5c03f58cf7ee11d5eee3805d78d83786c21adaa

Backport of hostap commit ad66108dbc5a.

Signed-off-by: Oldřich Jedlička <oldium.pro@gmail.com>
Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
--- a/src/ap/wpa_auth_ft.c
+++ b/src/ap/wpa_auth_ft.c
@@ -664,12 +664,12 @@ static int wpa_ft_action_send(struct wpa
 
 static const u8 * wpa_ft_get_psk(struct wpa_authenticator *wpa_auth,
 				 const u8 *addr, const u8 *p2p_dev_addr,
-				 const u8 *prev_psk)
+				 const u8 *prev_psk, int *vlan_id)
 {
 	if (wpa_auth->cb->get_psk == NULL)
 		return NULL;
 	return wpa_auth->cb->get_psk(wpa_auth->cb_ctx, addr, p2p_dev_addr,
-				     prev_psk, NULL, NULL);
+				     prev_psk, NULL, vlan_id);
 }
 
 
@@ -2951,12 +2951,13 @@ static int wpa_ft_psk_pmk_r1(struct wpa_
 	const u8 *ssid = wpa_auth->conf.ssid;
 	size_t ssid_len = wpa_auth->conf.ssid_len;
 	int pairwise;
+	int vlan_id = 0;
 
 	pairwise = sm->pairwise;
 
 	for (;;) {
 		pmk = wpa_ft_get_psk(wpa_auth, sm->addr, sm->p2p_dev_addr,
-				     pmk);
+				     pmk, &vlan_id);
 		if (pmk == NULL)
 			break;
 
@@ -2978,6 +2979,16 @@ static int wpa_ft_psk_pmk_r1(struct wpa_
 			*out_pairwise = pairwise;
 		os_memcpy(sm->PMK, pmk, PMK_LEN);
 		sm->pmk_len = PMK_LEN;
+#ifndef CONFIG_NO_VLAN
+		if (out_vlan && vlan_id) {
+			/* The VLAN ID of the PSK replaces the VLAN of the STA
+			 * as in wpa_auth_update_vlan() after the 4-way
+			 * handshake. */
+			os_memset(out_vlan, 0, sizeof(*out_vlan));
+			out_vlan->notempty = 1;
+			out_vlan->untagged = vlan_id;
+		} else
+#endif /* CONFIG_NO_VLAN */
 		if (out_vlan &&
 		    wpa_ft_get_vlan(sm->wpa_auth, sm->addr, out_vlan) < 0) {
 			wpa_printf(MSG_DEBUG, "FT: vlan not available for STA "
