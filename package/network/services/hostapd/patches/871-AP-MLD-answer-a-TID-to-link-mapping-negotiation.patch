+	bool neg_ttlm_valid;
+	struct eht_neg_ttlm neg_ttlm;
+	/* Accepted request, applied once its Response frame is acknowledged */
+	bool neg_ttlm_req_pending;
+	bool neg_ttlm_req_dflt;
+	u8 neg_ttlm_req_token;
+	struct eht_neg_ttlm neg_ttlm_req;
 #endif /* CONFIG_IEEE80211BE */
 
 	u16 max_idle_period; /* if nonzero, the granted BSS max idle period in
--- a/src/drivers/driver_nl80211.c
+++ b/src/drivers/driver_nl80211.c
@@ -3207,6 +3207,12 @@ static int nl80211_action_subscribe_ap(s
 	/* Protected EHT - Link Reconfiguration Request */
 	if (nl80211_register_action_frame(bss, (u8 *) "\x25\x0b", 2) < 0)
 		ret = -1;
+	/* Protected EHT - TID-To-Link Mapping Request */
