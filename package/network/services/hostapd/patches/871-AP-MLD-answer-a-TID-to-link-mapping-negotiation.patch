+++ b/src/ap/sta_info.h
@@ -363,6 +363,16 @@ struct sta_info {
 	u8 mld_assoc_link_id;
 	struct link_reconf_req_list *reconf_req;
 	bool link_removal_tx;
+
+	/* Negotiated TID-to-link mapping, on the station of the association
