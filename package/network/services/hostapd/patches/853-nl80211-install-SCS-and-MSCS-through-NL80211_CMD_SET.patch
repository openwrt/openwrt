 }
 
 
+struct nl80211_scs_status {
+	u8 id;
+	int status;
+};
+
+
+static int nl80211_set_scs_handler(struct nl_msg *msg, void *arg)
+{
+	struct nlattr *tb[NL80211_ATTR_MAX + 1];
+	struct nlattr *desc[NL80211_SCS_DESC_ATTR_MAX + 1];
+	struct genlmsghdr *gnlh = nlmsg_data(nlmsg_hdr(msg));
+	struct nl80211_scs_status *res = arg;
+	struct nlattr *entry;
+	int rem;
+
+	nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0),
+		  genlmsg_attrlen(gnlh, 0), NULL);
+	if (!tb[NL80211_ATTR_SCS_DESCRIPTORS])
+		return NL_SKIP;
+
+	nla_for_each_nested(entry, tb[NL80211_ATTR_SCS_DESCRIPTORS], rem) {
+		if (nla_parse_nested(desc, NL80211_SCS_DESC_ATTR_MAX, entry,
+				     NULL) ||
+		    !desc[NL80211_SCS_DESC_ATTR_ID] ||
+		    !desc[NL80211_SCS_DESC_ATTR_STATUS] ||
+		    nla_get_u8(desc[NL80211_SCS_DESC_ATTR_ID]) != res->id)
+			continue;
+
+		res->status = nla_get_u16(desc[NL80211_SCS_DESC_ATTR_STATUS]);
+		break;
+	}
+
+	return NL_SKIP;
+}
+
+
+static int nl80211_set_scs(void *priv, const u8 *addr,
+			   const struct hostapd_scs_desc *desc, u16 *status)
+{
+	struct i802_bss *bss = priv;
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct nl80211_scs_status res = { .id = desc->id, .status = -1 };
+	struct nlattr *list, *entry;
+	struct nl_msg *msg;
+	int ret;
+
+	msg = nl80211_cmd_msg(bss, 0, NL80211_CMD_SET_SCS);
+	if (!msg ||
+	    nla_put(msg, NL80211_ATTR_MAC, ETH_ALEN, addr) ||
+	    !(list = nla_nest_start(msg, NL80211_ATTR_SCS_DESCRIPTORS)) ||
+	    !(entry = nla_nest_start(msg, 1)) ||
+	    nla_put_u8(msg, NL80211_SCS_DESC_ATTR_ID, desc->id) ||
+	    nla_put_u8(msg, NL80211_SCS_DESC_ATTR_REQ_TYPE, desc->req_type) ||
+	    (desc->up >= 0 &&
+	     nla_put_u8(msg, NL80211_SCS_DESC_ATTR_UP, desc->up)) ||
+	    (desc->tclas &&
+	     nla_put(msg, NL80211_SCS_DESC_ATTR_TCLAS, desc->tclas_len,
+		     desc->tclas)) ||
+	    (desc->qos_char &&
+	     nla_put(msg, NL80211_SCS_DESC_ATTR_QOS_CHAR, desc->qos_char_len,
+		     desc->qos_char))) {
+		nlmsg_free(msg);
+		return -ENOBUFS;
+	}
+	nla_nest_end(msg, entry);
+	nla_nest_end(msg, list);
+
+	ret = send_and_recv_resp(drv, msg, nl80211_set_scs_handler, &res);
+	if (ret) {
+		wpa_printf(MSG_DEBUG, "nl80211: SET_SCS failed: %d (%s)",
+			   ret, strerror(-ret));
+		return ret;
+	}
+	if (res.status < 0)
+		return -EINVAL;
+
+	*status = res.status;
+	return 0;
+}
+
+
+static int nl80211_set_mscs_handler(struct nl_msg *msg, void *arg)
+{
+	struct nlattr *tb[NL80211_ATTR_MAX + 1];
+	struct genlmsghdr *gnlh = nlmsg_data(nlmsg_hdr(msg));
+	int *status = arg;
+
+	nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0),
+		  genlmsg_attrlen(gnlh, 0), NULL);
+	if (tb[NL80211_ATTR_STATUS_CODE])
+		*status = nla_get_u16(tb[NL80211_ATTR_STATUS_CODE]);
+
+	return NL_SKIP;
+}
+
+
+static int nl80211_set_mscs(void *priv, const u8 *addr,
+			    const struct hostapd_mscs_desc *desc, u16 *status)
+{
+	struct i802_bss *bss = priv;
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct nlattr *attr;
+	struct nl_msg *msg;
+	int res = -1;
+	int ret;
+
+	msg = nl80211_cmd_msg(bss, 0, NL80211_CMD_SET_MSCS);
+	if (!msg ||
+	    nla_put(msg, NL80211_ATTR_MAC, ETH_ALEN, addr) ||
+	    !(attr = nla_nest_start(msg, NL80211_ATTR_MSCS_DESCRIPTOR)) ||
+	    nla_put_u8(msg, NL80211_MSCS_DESC_ATTR_REQ_TYPE, desc->req_type) ||
+	    nla_put_u8(msg, NL80211_MSCS_DESC_ATTR_UP_BITMAP,
+		       desc->up_bitmap) ||
+	    nla_put_u8(msg, NL80211_MSCS_DESC_ATTR_UP_LIMIT, desc->up_limit) ||
+	    nla_put_u32(msg, NL80211_MSCS_DESC_ATTR_STREAM_TIMEOUT,
+			desc->stream_timeout) ||
+	    (desc->tclas_mask &&
+	     nla_put(msg, NL80211_MSCS_DESC_ATTR_TCLAS_MASK,
+		     desc->tclas_mask_len, desc->tclas_mask))) {
+		nlmsg_free(msg);
+		return -ENOBUFS;
+	}
+	nla_nest_end(msg, attr);
+
+	ret = send_and_recv_resp(drv, msg, nl80211_set_mscs_handler, &res);
+	if (ret) {
+		wpa_printf(MSG_DEBUG, "nl80211: SET_MSCS failed: %d (%s)",
+			   ret, strerror(-ret));
+		return ret;
+	}
+	if (res < 0)
+		return -EINVAL;
+
+	*status = res;
+	return 0;
+}
