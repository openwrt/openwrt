 /**
+ * struct hostapd_scs_desc - One SCS Descriptor element of an SCS Request
+ * @id: SCSID
+ * @req_type: Request Type (enum scs_request_type)
+ * @up: User Priority of the Intra-Access Category Priority element, or -1
+ *	where the descriptor holds no such element
+ * @tclas: The TCLAS elements and the TCLAS Processing element as received,
+ *	or %NULL
+ * @tclas_len: Length of @tclas
+ * @qos_char: The QoS Characteristics element as received, or %NULL
+ * @qos_char_len: Length of @qos_char
+ */
+struct hostapd_scs_desc {
+	u8 id;
+	u8 req_type;
+	int up;
+	const u8 *tclas;
+	size_t tclas_len;
+	const u8 *qos_char;
+	size_t qos_char_len;
+};
+
+/**
+ * struct hostapd_mscs_desc - The MSCS Descriptor element of an MSCS request
+ * @req_type: Request Type (enum scs_request_type)
+ * @up_bitmap: User Priority Bitmap
+ * @up_limit: User Priority Limit
+ * @stream_timeout: Stream Timeout in TUs
+ * @tclas_mask: The TCLAS Mask elements as received, or %NULL for a removal
+ * @tclas_mask_len: Length of @tclas_mask
+ */
+struct hostapd_mscs_desc {
+	u8 req_type;
+	u8 up_bitmap;
+	u8 up_limit;
+	u32 stream_timeout;
+	const u8 *tclas_mask;
+	size_t tclas_mask_len;
+};
