-	freq = params.freqs;
+static int * acs_add_scan_freqs(struct hostapd_iface *iface, int *start,
+				int *next)
+{
+	struct hostapd_hw_modes *mode;
+	int *added, *end, *pos;
+	int i;
 
+	end = next;
 	for (i = 0; i < iface->num_hw_features; i++) {
 		mode = &iface->hw_features[i];
 		if (!hostapd_hw_skip_mode(iface, mode))
-			freq = acs_request_scan_add_freqs(iface, mode, freq);
+			end = acs_request_scan_add_freqs(iface, mode, end);
 	}
 
+	for (added = next; added < end; added++) {
+		for (pos = start; pos < next; pos++)
+			if (*pos == *added)
+				break;
+		if (pos == next)
+			*next++ = *added;
+	}
+
+	return next;
+}
+
+
+static int acs_request_scan(struct hostapd_iface *iface)
+{
+	struct hostapd_iface *partners[MAX_NUM_MLD_LINKS];
+	struct wpa_driver_scan_params params;
+	int *freq, ret;
+	int num_channels;
+	size_t i, n;
+
+	os_memset(&params, 0, sizeof(params));
+
+	n = acs_mld_partners(iface, partners, false);
+
+	num_channels = acs_num_scan_channels(iface);
+	for (i = 0; i < n; i++)
+		num_channels += acs_num_scan_channels(partners[i]);
+
+	params.freqs = os_calloc(num_channels + 1, sizeof(params.freqs[0]));
+	if (params.freqs == NULL)
+		return -1;
+
+	freq = acs_add_scan_freqs(iface, params.freqs, params.freqs);
+	for (i = 0; i < n; i++)
+		freq = acs_add_scan_freqs(partners[i], params.freqs, freq);
+
 	*freq = 0;
 
 	if (params.freqs == freq) {
@@ -1484,7 +1615,8 @@ static int acs_request_scan(struct hosta
 			return -1;
 		}
 
-		wpa_printf(MSG_INFO,
+		wpa_printf(hostapd_mld_partner_scanning(iface->bss[0]) ?
+			   MSG_DEBUG : MSG_INFO,
 			   "Failed to request acs scan ret=%d (%s) - try to scan after %d seconds",
 			   ret, strerror(-ret), ACS_SCAN_RETRY_INTERVAL);
 		eloop_cancel_timeout(acs_scan_retry, iface, NULL);
@@ -1501,6 +1633,17 @@ static int acs_request_scan(struct hosta
 
 	iface->scan_cb = acs_scan_complete;
 
+	for (i = 0; i < n; i++) {
+		partners[i]->scan_cb = acs_scan_complete;
+		partners[i]->acs_num_retries = 0;
+		eloop_cancel_timeout(acs_scan_retry, partners[i], NULL);
+		eloop_cancel_timeout(acs_scan_next, partners[i], NULL);
+		eloop_cancel_timeout(acs_scan_wait_timeout, partners[i], NULL);
+		eloop_register_timeout(ACS_SCAN_WAIT_TIMEOUT, 0,
+				       acs_scan_wait_timeout, partners[i],
+				       NULL);
+	}
+
 	return 0;
 }
 
