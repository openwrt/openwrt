+/* The links of an AP MLD share one wiphy, which runs one scan at a time */
+static size_t acs_mld_partners(struct hostapd_iface *iface,
+			       struct hostapd_iface **partners, bool scanning)
+{
+	size_t n = 0;
+#ifdef CONFIG_IEEE80211BE
+	struct hapd_interfaces *interfaces = iface->interfaces;
+	size_t i;
+
+	if (!interfaces || !iface->num_bss || !iface->bss[0]->conf->mld_ap)
+		return 0;
+
+	for (i = 0; i < interfaces->count && n < MAX_NUM_MLD_LINKS; i++) {
+		struct hostapd_iface *h = interfaces->iface[i];
+
+		if (!h || h == iface || !h->num_bss ||
+		    h->state != HAPD_IFACE_ACS ||
+		    !hostapd_is_ml_partner(iface->bss[0], h->bss[0]))
+			continue;
+
+		if (scanning && h->scan_cb != acs_scan_complete)
+			continue;
+
+		if (!scanning &&
+		    (h->scan_cb ||
+		     h->acs_num_completed_scans >= h->conf->acs_num_scans))
+			continue;
+
+		partners[n++] = h;
+	}
+#endif /* CONFIG_IEEE80211BE */
+
+	return n;
+}
+
+
+static void acs_scan_failed(struct hostapd_iface *iface)
+{
+	hostapd_acs_completed(iface, 1);
+	acs_fail(iface);
+}
+
+
+static void acs_study_timeout(void *eloop_data, void *user_data)
+{
+	acs_study(eloop_data);
+}
+
+
+static void acs_scan_next(void *eloop_data, void *user_data)
+{
+	struct hostapd_iface *iface = eloop_data;
+
+	if (acs_request_scan(iface)) {
+		wpa_printf(MSG_ERROR, "ACS: Failed to request scan");
+		acs_scan_failed(iface);
+	}
+}
+
+
+static void acs_scan_wait_timeout(void *eloop_data, void *user_data)
+{
+	struct hostapd_iface *iface = eloop_data;
+
+	wpa_printf(MSG_DEBUG,
+		   "ACS: No results of the scan of a partner link - scan again");
+	iface->scan_cb = NULL;
+	acs_scan_next(eloop_data, user_data);
+}
+
+
 static void acs_scan_complete(struct hostapd_iface *iface)
 {
+	struct hostapd_iface *ifaces[MAX_NUM_MLD_LINKS + 1];
+	size_t i, n;
 	int err;
 
-	iface->scan_cb = NULL;
-	iface->acs_num_retries = 0;
+	ifaces[0] = iface;
+	n = 1 + acs_mld_partners(iface, &ifaces[1], true);
 
 	wpa_printf(MSG_DEBUG, "ACS: Using survey based algorithm (acs_num_scans=%d)",
 		   iface->conf->acs_num_scans);
 
+	/* Each link keeps its scan_cb until the survey event, which goes to the
+	 * link that requested the scan. */
 	err = hostapd_drv_get_survey(iface->bss[0], 0);
+
+	for (i = 0; i < n; i++) {
+		ifaces[i]->scan_cb = NULL;
+		ifaces[i]->acs_num_retries = 0;
+		eloop_cancel_timeout(acs_scan_wait_timeout, ifaces[i], NULL);
+	}
+
 	if (err) {
 		wpa_printf(MSG_ERROR, "ACS: Failed to get survey data");
-		goto fail;
+		for (i = 0; i < n; i++)
+			acs_scan_failed(ifaces[i]);
+		return;
 	}
 
-	if (++iface->acs_num_completed_scans < iface->conf->acs_num_scans) {
-		err = acs_request_scan(iface);
-		if (err && err != -EBUSY) {
-			wpa_printf(MSG_ERROR, "ACS: Failed to request scan");
-			goto fail;
+	/* EVENT_SCAN_RESULTS may still call the scan_cb of the partners */
+	for (i = 0; i < n; i++) {
+		struct hostapd_iface *h = ifaces[i];
+
+		if (++h->acs_num_completed_scans >= h->conf->acs_num_scans) {
+			eloop_register_timeout(0, 0, acs_study_timeout, h,
+					       NULL);
+		} else {
+			eloop_cancel_timeout(acs_scan_retry, h, NULL);
+			eloop_register_timeout(0, 0, acs_scan_next, h, NULL);
 		}
-
-		return;
 	}
-
-	acs_study(iface);
-	return;
-fail:
-	hostapd_acs_completed(iface, 1);
-	acs_fail(iface);
 }
 
 
@@ -1425,34 +1519,71 @@ static int * acs_request_scan_add_freqs(
 }
 
 
-static int acs_request_scan(struct hostapd_iface *iface)
+static int acs_num_scan_channels(struct hostapd_iface *iface)
