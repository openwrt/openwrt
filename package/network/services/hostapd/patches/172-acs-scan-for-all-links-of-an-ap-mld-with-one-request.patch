+bool hostapd_mld_partner_scanning(struct hostapd_data *hapd)
+{
+#ifdef CONFIG_IEEE80211BE
+	unsigned int i;
+
+	if (!hapd->conf->mld_ap || !hapd->iface->interfaces)
+		return false;
+
+	for (i = 0; i < hapd->iface->interfaces->count; i++) {
+		struct hostapd_iface *h_iface =
+			hapd->iface->interfaces->iface[i];
+
+		if (!h_iface || h_iface == hapd->iface ||
+		    h_iface->num_bss == 0)
+			continue;
+
+		if (hostapd_is_ml_partner(hapd, h_iface->bss[0]) &&
+		    h_iface->scan_cb)
+			return true;
+	}
+#endif /* CONFIG_IEEE80211BE */
+
+	return false;
+}
+
