 	if (category == WLAN_ACTION_VENDOR_SPECIFIC_PROTECTED && plen > 4 &&
 	    WPA_GET_BE32(payload) == QM_ACTION_VENDOR_TYPE) {
 		wpas_handle_qos_mgmt_recv_action(wpa_s, mgmt->da, mgmt->sa,
-						 payload + 4, plen - 4);
+						 payload + 4, plen - 4, freq);
 		return;
 	}
 #endif /* CONFIG_NO_ROBUST_AV */
