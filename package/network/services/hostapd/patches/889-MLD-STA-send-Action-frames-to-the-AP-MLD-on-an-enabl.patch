 	    payload[0] == WLAN_RRM_LINK_MEASUREMENT_REQUEST) {
 		wpas_rrm_handle_link_measurement_request(wpa_s, mgmt->sa,
 							 payload + 1, plen - 1,
-							 rssi);
+							 rssi, freq);
 		return;
 	}
