+++ b/src/drivers/driver_nl80211_capa.c
@@ -620,6 +620,9 @@ static void wiphy_info_ext_feature_flags
 	if (ext_feature_isset(ext_features, len, NL80211_EXT_FEATURE_MSCS))
 		capa->flags2 |= WPA_DRIVER_FLAGS2_MSCS;
 	if (ext_feature_isset(ext_features, len,
+			      NL80211_EXT_FEATURE_AP_NEG_TTLM))
+		capa->flags2 |= WPA_DRIVER_FLAGS2_AP_NEG_TTLM;
+	if (ext_feature_isset(ext_features, len,
 			      NL80211_EXT_FEATURE_SCHED_SCAN_RELATIVE_RSSI))
 		capa->flags |= WPA_DRIVER_FLAGS_SCHED_SCAN_RELATIVE_RSSI;
 	if (ext_feature_isset(ext_features, len,
--- a/src/drivers/nl80211_copy.h
