+/* The link of the EAPOL-Key frame that the station answers; the OCI of the
+ * answer names the channel of that link */
+static int wpa_sm_eapol_link_id(struct wpa_sm *sm)
+{
+	if (!sm->mlo.valid_links)
+		return -1;
+	if (sm->eapol_rx_link_id >= 0)
+		return sm->eapol_rx_link_id;
+	return sm->mlo.assoc_link_id;
+}
