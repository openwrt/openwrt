+++ b/src/ap/scs.c
@@ -131,17 +131,70 @@ static u16 hostapd_scs_desc_set(struct h
 
 
 /*
- * The TCLAS elements and the TCLAS Processing element go to the driver as one
- * list, in the order received, without the other elements of the descriptor.
+ * The optional elements of an SCS Descriptor element of Request Type Add or
+ * Change. The TCLAS elements and the TCLAS Processing element go to the
+ * driver as one list, in the order received, in *tclas, which the caller
+ * frees.
  */
+static bool scs_desc_elems_parse(const struct element *scs,
+				 struct hostapd_scs_desc *desc, u8 **tclas)
+{
+	const struct element *elem;
+	size_t tclas_len = 0;
+
+	*tclas = os_malloc(scs->datalen);
+	if (!*tclas)
+		return false;
+
+	for_each_element(elem, scs->data + 2, scs->datalen - 2) {
+		switch (elem->id) {
+		case WLAN_EID_INTRA_ACCESS_CATEGORY_PRIORITY:
+			if (elem->datalen < 1 || desc->up >= 0)
+				return false;
+			desc->up = elem->data[0] & 0x07;
+			break;
+		case WLAN_EID_TCLAS:
+		case WLAN_EID_TCLAS_PROCESSING:
+			os_memcpy(*tclas + tclas_len, elem, 2 + elem->datalen);
+			tclas_len += 2 + elem->datalen;
+			break;
+		case WLAN_EID_EXTENSION:
+			if (elem->datalen < 1 ||
+			    elem->data[0] != WLAN_EID_EXT_QOS_CHARACTERISTICS)
+				break;
+			if (desc->qos_char)
+				return false;
+			desc->qos_char = (const u8 *) elem;
+			desc->qos_char_len = 2 + elem->datalen;
+			break;
+		default:
+			break;
+		}
+	}
+
+	if (!for_each_element_completed(elem, scs->data + 2,
+					scs->datalen - 2)) {
+		wpa_printf(MSG_DEBUG,
+			   "SCS: Truncated element in SCS Descriptor %u",
+			   desc->id);
+		return false;
+	}
+
+	if (tclas_len) {
+		desc->tclas = *tclas;
+		desc->tclas_len = tclas_len;
+	}
+
+	return true;
+}
+
