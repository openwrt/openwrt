 /* Remove the MSCS of a station and tell it with an unsolicited MSCS Response */
 int hostapd_del_mscs(struct hostapd_data *hapd, const u8 *addr)
 {
@@ -373,12 +423,8 @@ int hostapd_del_mscs(struct hostapd_data
 	struct sta_info *sta;
 	u16 status;
 
-	sta = ap_get_sta(hapd, addr);
-	if (!sta || !(sta->flags & WLAN_STA_ASSOC))
-		return -1;
-
-	sta = robust_av_sta(&hapd, sta);
-	if (!sta->mscs_active)
+	sta = robust_av_assoc_sta(&hapd, addr);
+	if (!sta || !sta->mscs_active)
 		return -1;
 
 	os_memset(&desc, 0, sizeof(desc));
@@ -459,6 +505,102 @@ u8 * hostapd_eid_mscs_assoc(struct hosta
 }
 
 
+static int robust_av_configure_scs(struct hostapd_data *hapd,
+				   struct sta_info *sta, const u8 *client,
+				   const u8 *elem, u16 *status)
+{
+	const struct element *scs = (const struct element *) elem;
+	struct hostapd_scs_desc desc;
+	u8 *tclas = NULL;
+	int ret = -EINVAL;
+
+	if (scs->id != WLAN_EID_SCS_DESCRIPTOR || scs->datalen < 2 ||
+	    !scs->data[0])
+		return -EINVAL;
+
+	os_memset(&desc, 0, sizeof(desc));
+	desc.id = scs->data[0];
+	desc.req_type = scs->data[1];
+	desc.up = -1;
+	desc.client = client;
+
+	switch (desc.req_type) {
+	case SCS_REQ_ADD:
+	case SCS_REQ_CHANGE:
+		if (!scs_desc_elems_parse(scs, &desc, &tclas))
+			goto out;
+		break;
+	case SCS_REQ_REMOVE:
+		break;
+	default:
+		goto out;
+	}
+
+	ret = hostapd_drv_set_scs(hapd, sta->addr, &desc, status);
+out:
+	os_free(tclas);
+	return ret;
+}
+
+
+static int robust_av_configure_mscs(struct hostapd_data *hapd,
+				    struct sta_info *sta, const u8 *client,
+				    const u8 *elem, u16 *status)
+{
+	struct hostapd_mscs_desc desc;
+	u8 *masks = NULL;
+	int ret = -EINVAL;
+
+	if (elem[0] != WLAN_EID_EXTENSION || elem[1] < 1 ||
+	    elem[2] != WLAN_EID_EXT_MSCS_DESCRIPTOR)
+		return -EINVAL;
+
+	os_memset(&desc, 0, sizeof(desc));
+	desc.client = client;
+	desc.configured = true;
+
+	if (mscs_desc_parse(&elem[2], elem[1], &desc, &masks))
+		ret = hostapd_drv_set_mscs(hapd, sta->addr, &desc, status);
+
+	os_free(masks);
+	return ret;
+}
+
+
+/*
+ * A rule that the AP configures on behalf of the network, for example for a
+ * Multi-AP Controller (EasyMesh 6.1, 20.2.4), and not at the request of the
+ * peer: hostapd keeps no state of it and reports nothing about it.
+ * @addr: The associated peer, the MLD address of a non-AP MLD
+ * @client: A host behind the 4-address peer @addr, or %NULL for the peer
+ * @elem: The whole SCS Descriptor or MSCS Descriptor element
+ * @len: Length of @elem
+ * @status: Buffer for the status code of the driver
+ * Returns: 0 where the driver answered with @status, -ENOENT where @addr is
+ * not associated, -EINVAL for a malformed element, or another negative value
+ * from the driver
+ */
+int hostapd_robust_av_configure(struct hostapd_data *hapd, const u8 *addr,
+				const u8 *client,
+				enum hostapd_robust_av_kind kind,
+				const u8 *elem, size_t len, u16 *status)
+{
+	struct sta_info *sta;
+
+	sta = robust_av_assoc_sta(&hapd, addr);
+	if (!sta)
+		return -ENOENT;
+
+	if (len < 3 || elem[1] != len - 2)
+		return -EINVAL;
+
+	if (kind == HOSTAPD_ROBUST_AV_SCS)
+		return robust_av_configure_scs(hapd, sta, client, elem, status);
+
+	return robust_av_configure_mscs(hapd, sta, client, elem, status);
+}
+
