+/*
+ * @elem: The MSCS Descriptor element from its Element ID Extension
+ * @len: Length of @elem
+ * Returns: the status code for the request
+ */
+static u16 hostapd_set_mscs(struct hostapd_data *hapd, struct sta_info *sta,
+			    const u8 *elem, size_t len)
+{
+	struct hostapd_mscs_desc desc;
+	u8 *masks = NULL;
+	u16 status = WLAN_STATUS_REQUEST_DECLINED;
+
+	os_memset(&desc, 0, sizeof(desc));
+
+	if (hostapd_ubus_robust_av_disallowed(hapd, HOSTAPD_ROBUST_AV_MSCS,
+					      sta->addr)) {
+		wpa_printf(MSG_DEBUG, "MSCS: " MACSTR " is disallowed",
+			   MAC2STR(sta->addr));
 		goto out;
 	}
 
-	desc.tclas_mask = masks;
-	desc.tclas_mask_len = masks_len;
+	if (!mscs_desc_parse(elem, len, &desc, &masks))
+		goto out;
 
-set:
 	if (hostapd_drv_set_mscs(hapd, sta->addr, &desc, &status)) {
 		status = WLAN_STATUS_REQUEST_DECLINED;
 		goto out;
@@ -366,6 +392,30 @@ out:
 }
 
 
+static bool robust_av_sta_associated(struct hostapd_data *hapd,
+				     struct sta_info *sta)
+{
+	return sta->flags & WLAN_STA_ASSOC;
+}
+
+
+/*
+ * DEL_MSCS names the first BSS of an AP MLD, while a non-MLO station has
+ * its entry on the link it associated to alone.
+ */
+static struct sta_info * robust_av_assoc_sta(struct hostapd_data **hapd,
+					     const u8 *addr)
+{
+	struct sta_info *sta;
+
+	sta = ap_get_sta_mld_links(hapd, addr, robust_av_sta_associated);
+	if (!sta)
+		return NULL;
+
+	return robust_av_sta(hapd, sta);
+}
+
