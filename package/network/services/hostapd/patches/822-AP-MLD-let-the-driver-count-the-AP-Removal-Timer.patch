--- a/src/drivers/driver.h
+++ b/src/drivers/driver.h
@@ -2593,6 +2593,10 @@ struct wpa_driver_capa {
 /** Driver advertises a TID-to-link mapping of an AP MLD and reports its steps
  * with EVENT_ADV_TTLM */
