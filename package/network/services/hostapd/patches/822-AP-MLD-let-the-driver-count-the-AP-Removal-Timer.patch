 #endif /* CONFIG_IEEE80211BE */
 
 	if (hapd->csa_in_progress) {
@@ -2917,6 +2920,11 @@ static int __ieee802_11_set_beacon(struc
 		wpa_printf(MSG_ERROR, "Failed to set beacon parameters");
