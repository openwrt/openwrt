 	bool eht_mld_crit_update;
 	u32 eht_mld_crit_update_id;
@@ -1033,6 +1040,9 @@ u64 hostapd_link_remove_expiry_ms(struct
 u64 hostapd_link_remove_ms(struct hostapd_data *hapd);
