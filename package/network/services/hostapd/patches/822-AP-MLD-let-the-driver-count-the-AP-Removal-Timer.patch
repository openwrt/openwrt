--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -477,6 +477,7 @@ static int hostapd_broadcast_wep_set(str
 
 static void hostapd_link_remove_timeout_handler(void *eloop_data,
 						void *user_ctx);
+static void hostapd_link_remove_offload_expire(struct hostapd_data *hapd);
 
 
 /* A nontransmitted BSSID sends no Beacon frames of its own, so the driver does
@@ -542,6 +543,47 @@ static unsigned int hostapd_link_remove_
 }
 
 
+static u64 hostapd_link_remove_until_us(struct os_reltime *t)
+{
+	struct os_reltime now, left;
+
+	os_get_reltime(&now);
+	if (!os_reltime_before(&now, t))
+		return 0;
+
+	os_reltime_sub(t, &now, &left);
+	return (u64) left.sec * 1000000 + left.usec;
+}
+
+
+static void hostapd_link_remove_return_after(struct hostapd_data *hapd,
+					     unsigned int beacons,
+					     struct os_reltime *t)
+{
+	u64 us = (u64) beacons * TU_TO_USEC(hapd->iconf->beacon_int);
+
+	*t = hapd->eht_mld_link_removal_return;
+	t->sec += us / 1000000;
+	t->usec += us % 1000000;
+	t->sec += t->usec / 1000000;
+	t->usec %= 1000000;
+}
+
+
+/* The first Beacon frame with the element goes out less than one beacon
+ * interval after the update returns, so the removal TBTT comes before
+ * start + 1 intervals after that return */
+static u64 hostapd_link_remove_tbtt_after_us(struct hostapd_data *hapd)
+{
+	struct os_reltime t;
+
+	hostapd_link_remove_return_after(hapd,
+					 hapd->eht_mld_link_removal_start + 1,
+					 &t);
+	return hostapd_link_remove_until_us(&t);
+}
+
+
 static u64 hostapd_link_remove_expiry_us(struct hostapd_data *hapd)
 {
 	struct os_reltime now, left;
@@ -575,21 +617,98 @@ u64 hostapd_link_remove_expiry_ms(struct
  * caller commits no earlier than the link stops. */
 u64 hostapd_link_remove_ms(struct hostapd_data *hapd)
 {
+	u64 us;
+
 	if (!hapd->eht_mld_link_removal_count)
 		return 0;
 
-	return (hostapd_link_remove_expiry_us(hapd) +
-		hostapd_link_remove_tx_wait_us(hapd) + 999) / 1000;
+	if (hapd->eht_mld_link_removal_offload)
+		us = hostapd_link_remove_tbtt_after_us(hapd);
+	else
+		us = hostapd_link_remove_expiry_us(hapd);
+
+	return (us + hostapd_link_remove_tx_wait_us(hapd) + 999) / 1000;
 }
 
 
 static bool hostapd_link_remove_pending(struct hostapd_data *hapd)
 {
 	return hapd->eht_mld_link_removal_count ||
+		hapd->eht_mld_link_removal_offload ||
 		hapd->eht_mld_link_removal_expired;
 }
 
 
+static bool hostapd_link_remove_offload(struct hostapd_data *hapd)
+{
+	return !!(hapd->iface->drv_flags2 &
+		  WPA_DRIVER_FLAGS2_AP_REMOVAL_TIMER_OFFLOAD);
+}
+
+
+/* The driver counts the AP Removal Timer from the Beacon frames it took at the
+ * start, so no link of the AP MLD gets another one until the expiry. */
+bool hostapd_link_remove_beacon_held(struct hostapd_data *hapd)
+{
+	struct hostapd_data *link_bss;
+
+	if (!hapd->conf->mld_ap || !hapd->mld)
+		return false;
+
+	for_each_mld_link(link_bss, hapd) {
+		if (!link_bss->eht_mld_link_removal_offload)
+			continue;
+
+		wpa_printf(MSG_DEBUG,
+			   "MLD: No Beacon update for link_id=%u while the driver counts the removal of link_id=%u",
+			   hapd->mld_link_id, link_bss->mld_link_id);
+		return true;
+	}
+
+	return false;
+}
+
+
+static void hostapd_link_remove_offload_missing(void *eloop_data,
+						void *user_ctx)
+{
+	struct hostapd_data *hapd = eloop_data;
+
+	wpa_printf(MSG_WARNING,
+		   "MLD: The driver reported no expiry of the AP Removal Timer of link_id=%u, expire it",
+		   hapd->mld_link_id);
+	hostapd_link_remove_offload_expire(hapd);
+}
+
+
+/* The driver times the expiry in whole seconds, and counts one removal of an
+ * AP MLD at a time */
+static bool hostapd_link_remove_offload_check(struct hostapd_data *hapd,
+					      u32 count)
+{
+	struct hostapd_data *link_bss;
+
+	if ((hapd->iconf->beacon_int * count) % 1000) {
+		wpa_printf(MSG_INFO,
+			   "MLD: Do not remove link_id=%u in %u beacons, the driver needs a whole number of seconds",
+			   hapd->mld_link_id, count);
+		return false;
+	}
+
+	for_each_mld_link(link_bss, hapd) {
+		if (link_bss == hapd || !hostapd_link_remove_pending(link_bss))
+			continue;
+
+		wpa_printf(MSG_INFO,
+			   "MLD: Do not remove link_id=%u while link_id=%u is being removed",
+			   hapd->mld_link_id, link_bss->mld_link_id);
+		return false;
+	}
+
+	return true;
+}
+
+
 static struct hostapd_data *
 hostapd_link_remove_partner(struct hostapd_data *hapd, struct sta_info *sta)
 {
@@ -741,21 +860,28 @@ static void hostapd_link_remove_notify_s
 }
 
 
-static void hostapd_link_remove_expire(struct hostapd_data *hapd)
+/* The other links drop the element */
+static bool hostapd_link_remove_expire_beacons(struct hostapd_data *hapd)
 {
-	unsigned int wait_us;
-
 	if (!hostapd_link_remove_partner(hapd, NULL)) {
 		wpa_printf(MSG_INFO,
 			   "MLD: Keep link_id=%u, no other link beacons",
 			   hapd->mld_link_id);
 		ieee802_11_set_beacon(hapd);
-		return;
+		return false;
 	}
 
 	hapd->eht_mld_link_removal_expired = true;
 	hapd->beacon_set_done = 0;
 	hostapd_mld_beacons_update(hapd);
+	return true;
+}
+
+
+static void hostapd_link_remove_expire_stas(struct hostapd_data *hapd)
+{
+	unsigned int wait_us;
+
 	hostapd_free_link_stas(hapd);
 	hostapd_link_remove_notify_stas(hapd);
 
@@ -773,6 +899,88 @@ static void hostapd_link_remove_expire(s
 }
 
 
+static void hostapd_link_remove_expire(struct hostapd_data *hapd)
+{
+	if (hostapd_link_remove_expire_beacons(hapd))
+		hostapd_link_remove_expire_stas(hapd);
+}
+
+
+static void hostapd_link_remove_offload_tbtt(void *eloop_data, void *user_ctx)
+{
+	struct hostapd_data *hapd = eloop_data;
+
+	wpa_printf(MSG_DEBUG, "MLD: Removal TBTT of link_id=%u passed",
+		   hapd->mld_link_id);
+	hostapd_link_remove_expire_stas(hapd);
+}
+
+
+static bool hostapd_link_remove_sta_single_link(struct hostapd_data *hapd,
+						struct sta_info *sta)
+{
+	struct mld_link_info *link;
+	unsigned int i;
+
+	for (i = 0; i < MAX_NUM_MLD_LINKS; i++) {
+		link = &sta->mld_info.links[i];
+		if (i != hapd->mld_link_id && link->valid &&
+		    link->status == WLAN_STATUS_SUCCESS)
+			return false;
+	}
+
+	return sta->mld_info.links[hapd->mld_link_id].valid;
+}
+
+
+/* A non-AP MLD whose only setup link is the removed one counts itself
+ * disassociated at the removal TBTT (IEEE Std 802.11be-2024, 35.3.6.3) */
+static void
+hostapd_link_remove_unauth_single_link_stas(struct hostapd_data *hapd)
+{
+	struct sta_info *sta;
+
+	for (sta = hapd->sta_list; sta; sta = sta->next) {
+		if (!(sta->flags & WLAN_STA_ASSOC) || !ap_sta_is_mld(hapd, sta) ||
+		    !hostapd_link_remove_sta_single_link(hapd, sta))
+			continue;
+
+		wpa_printf(MSG_DEBUG,
+			   "MLD: " MACSTR " loses its only link_id=%u at the removal TBTT",
+			   MAC2STR(sta->addr), hapd->mld_link_id);
+		ap_sta_set_authorized(hapd, sta, 0);
+		hostapd_set_sta_flags(hapd, sta);
+	}
+}
+
+
+/* The expiry comes before the removal TBTT, after the driver stopped the TX of
+ * the link. The other links drop the element before that TBTT, and the
+ * stations get their frames and the link stops after it (IEEE Std
+ * 802.11be-2024, 35.3.6.3). */
+static void hostapd_link_remove_offload_expire(struct hostapd_data *hapd)
+{
+	u64 us;
+
+	eloop_cancel_timeout(hostapd_link_remove_timeout_handler, hapd, NULL);
+	eloop_cancel_timeout(hostapd_link_remove_offload_missing, hapd, NULL);
+	us = hostapd_link_remove_tbtt_after_us(hapd);
+	hapd->eht_mld_link_removal_offload = false;
+	hapd->eht_mld_link_removal_count = 0;
+
+	if (!hostapd_link_remove_expire_beacons(hapd))
+		return;
+
+	hostapd_link_remove_unauth_single_link_stas(hapd);
+
+	wpa_printf(MSG_DEBUG,
+		   "MLD: link_id=%u stops after the removal TBTT, in %llu us",
+		   hapd->mld_link_id, (unsigned long long) us);
+	eloop_register_timeout(us / 1000000, us % 1000000,
+			       hostapd_link_remove_offload_tbtt, hapd, NULL);
+}
+
+
 /* hostapd sees no TBTT: the countdown runs from the return of the first
  * Beacon update and expires before the TBTT that the count names. */
 static void hostapd_link_remove_timeout_handler(void *eloop_data,
@@ -780,7 +988,9 @@ static void hostapd_link_remove_timeout_
 {
 	struct hostapd_data *hapd = (struct hostapd_data *) eloop_data;
 
-	if (hapd->eht_mld_link_removal_count == 0)
+	if (hapd->eht_mld_link_removal_count == 0 ||
+	    (hapd->eht_mld_link_removal_offload &&
+	     hapd->eht_mld_link_removal_count == 1))
 		return;
 	hapd->eht_mld_link_removal_count--;
 
@@ -788,6 +998,14 @@ static void hostapd_link_remove_timeout_
 		   hapd->mld_link_id,
 		   hapd->eht_mld_link_removal_count);
 
+	/* The count of the Probe Response frames follows the Beacon frames
+	 * and stays at 1 until the expiry */
+	if (hapd->eht_mld_link_removal_offload) {
+		if (hapd->eht_mld_link_removal_count > 1)
+			hostapd_link_remove_timeout_register(hapd);
+		return;
+	}
+
 	if (!hapd->eht_mld_link_removal_count) {
 		hostapd_link_remove_expire(hapd);
 		return;
@@ -850,6 +1068,10 @@ int hostapd_link_remove(struct hostapd_d
 		return -1;
 	}
 
+	if (hostapd_link_remove_offload(hapd) &&
+	    !hostapd_link_remove_offload_check(hapd, count))
+		return -1;
+
 	wpa_printf(MSG_DEBUG,
 		   "MLD: Remove link_id=%u in %u beacons",
 		   hapd->mld_link_id, count);
@@ -861,13 +1083,87 @@ int hostapd_link_remove(struct hostapd_d
 		hapd->eht_mld_bss_param_change = 0;
 
 	hostapd_mld_crit_update_start(hapd);
+	hapd->eht_mld_link_removal_start_pending =
+		hostapd_link_remove_offload(hapd);
 	ieee802_11_set_beacon(hapd);
-	os_get_reltime(&hapd->eht_mld_link_removal_due);
+	/* without the template, the driver does not count the timer */
+	if (hapd->eht_mld_link_removal_start_pending) {
+		wpa_printf(MSG_INFO,
+			   "MLD: The driver took no Beacon frame with the removal of link_id=%u",
+			   hapd->mld_link_id);
+		hapd->eht_mld_link_removal_start_pending = false;
+		hapd->eht_mld_link_removal_start = 0;
+		hapd->eht_mld_link_removal_count = 0;
+		hostapd_mld_crit_update_start(hapd);
+		ieee802_11_set_beacon(hapd);
+		return -1;
+	}
+	hapd->eht_mld_link_removal_offload = hostapd_link_remove_offload(hapd);
+	if (!hapd->eht_mld_link_removal_offload)
+		os_get_reltime(&hapd->eht_mld_link_removal_due);
+	hapd->eht_mld_link_removal_return = hapd->eht_mld_link_removal_due;
 	hostapd_link_remove_timeout_register(hapd);
+
+	if (hapd->eht_mld_link_removal_offload) {
+		struct os_reltime t;
+		u64 us;
+
+		hostapd_link_remove_return_after(hapd, count + 2, &t);
+		us = hostapd_link_remove_until_us(&t);
+		eloop_register_timeout(us / 1000000, us % 1000000,
+				       hostapd_link_remove_offload_missing,
+				       hapd, NULL);
+	}
 	return 0;
 }
 
 
+/* The driver counts from the first TBTT after it took the template of the
+ * removed link, and the Probe Response frames must not count ahead of the
+ * Beacon frames, so the host count starts when that update returns */
+void hostapd_link_remove_beacon_set(struct hostapd_data *hapd)
+{
+	if (!hapd->eht_mld_link_removal_start_pending)
+		return;
+
+	os_get_reltime(&hapd->eht_mld_link_removal_due);
+	hapd->eht_mld_link_removal_start_pending = false;
+}
+
+
+/* One removal runs at a time on an AP MLD, see
+ * hostapd_link_remove_offload_check(). The expiry can free the BSS of the
+ * link and end the AP MLD of hapd. */
+void hostapd_link_remove_expired(struct hostapd_data *hapd, u16 links)
+{
+	struct hostapd_data *link_bss, *removed = NULL;
+
+	if (!hapd->conf->mld_ap || !hapd->mld)
+		return;
+
+	for_each_mld_link(link_bss, hapd) {
+		if ((links & BIT(link_bss->mld_link_id)) &&
+		    link_bss->eht_mld_link_removal_offload) {
+			removed = link_bss;
+			break;
+		}
+	}
+
+	if (!removed) {
+		wpa_printf(MSG_DEBUG,
+			   "MLD: No removal of links 0x%x runs, ignore their expiry",
+			   links);
+		return;
+	}
+
+	wpa_printf(MSG_DEBUG,
+		   "MLD: The driver reported the expiry of the AP Removal Timer of link_id=%u, %u beacons left",
+		   removed->mld_link_id, removed->eht_mld_link_removal_count);
+
+	hostapd_link_remove_offload_expire(removed);
+}
+
+
 /* Unlike switch_link_hapd(), a link that hostapd no longer has is not
  * replaced by the first link */
 void hostapd_crit_update_done(struct hostapd_data *hapd, int link_id, u32 id)
@@ -1133,7 +1429,11 @@ void hostapd_free_hapd_data(struct hosta
 #ifdef CONFIG_IEEE80211BE
 	eloop_cancel_timeout(hostapd_link_remove_timeout_handler, hapd, NULL);
 	eloop_cancel_timeout(hostapd_link_remove_finish, hapd, NULL);
+	eloop_cancel_timeout(hostapd_link_remove_offload_missing, hapd, NULL);
+	eloop_cancel_timeout(hostapd_link_remove_offload_tbtt, hapd, NULL);
 	hapd->eht_mld_link_removal_count = 0;
+	hapd->eht_mld_link_removal_offload = false;
+	hapd->eht_mld_link_removal_start_pending = false;
 	hapd->eht_mld_link_removal_expired = false;
 	hapd->eht_mld_link_removal_tx = 0;
 	hapd->eht_mld_crit_update = false;
--- a/src/ap/hostapd.h
+++ b/src/ap/hostapd.h
@@ -555,6 +555,13 @@ struct hostapd_data {
 	struct os_reltime eht_mld_link_removal_due;
 	bool eht_mld_link_removal_expired;
 	unsigned int eht_mld_link_removal_tx;
+	/* The driver counts the AP Removal Timer until
