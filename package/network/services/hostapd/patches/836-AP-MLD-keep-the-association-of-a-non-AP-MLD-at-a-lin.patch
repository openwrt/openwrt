From: Felix Fietkau <nbd@nbd.name>
Date: Sat, 24 Oct 2026 03:00:00 +0200
Subject: [PATCH] AP MLD: keep the association of a non-AP MLD at a link
 removal

Depends on 603-ap-mld-remove-an-affiliated-ap-at-the-expiry.patch.

At the expiry of the AP Removal Timer, hostapd sent a Deauthentication to
each non-AP MLD whose association link was the removed link, also where
the non-AP MLD had other setup links. IEEE Std 802.11be-2024, 35.3.6.3
disassociates only a non-AP MLD whose only setup link is the removed
one; a non-AP MLD with other setup links deletes the link and stays
associated.

Move the association of such a non-AP MLD to its lowest other setup
link, as hostapd_link_reconf_resp_tx_status() already does for a Link
Reconfiguration that deletes the association link, and free the STA of
the removed link as a link STA. That link must be one whose affiliated
AP runs and has not reached its own expiry, and must hold a link STA of
the non-AP MLD. A link whose removal is announced counts: it is still a
setup link, and its own expiry moves the association again. The move of
the Link Reconfiguration path becomes hostapd_ml_move_assoc_sta(), which
both paths call.

wpa_reset_assoc_sm_info() moved sm->wpa_auth to the new association link
but left sm->group on the group of the old link. At the expiry that group
is freed with the removed AP, and a later PTK rekey reads it in
wpa_group_sm_step() and wpa_free_sta_sm() puts it. sm->group now moves
to the group of the new link with the same VLAN ID. It takes over the
reference that the new link holds as a partner link, and the old link
drops its reference when its STA is freed as a link STA. The Link
Reconfiguration path of hostapd_link_reconf_resp_tx_status() has the same
omission in hostap main as of 741d70dd8e32: the old AP keeps running
there, so sm->group stays valid but belongs to another link.

A non-MLD STA and a non-AP MLD with no such link get their frame as
before.

Signed-off-by: Felix Fietkau <nbd@nbd.name>
---
--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -866,8 +866,70 @@ void hostapd_link_remove_tx_status(struc
 }
 
 
-/* A non-AP MLD gets a Deauthentication on a partner link, as hostapd
- * cannot move an association to another link. */
+static int hostapd_link_remove_new_assoc_link(struct hostapd_data *hapd,
+					      struct sta_info *sta)
+{
+	struct hostapd_data *link_bss;
+	struct mld_link_info *link;
+	unsigned int i;
+
+	for (i = 0; i < MAX_NUM_MLD_LINKS; i++) {
+		link = &sta->mld_info.links[i];
+		if (i == hapd->mld_link_id || !link->valid ||
+		    link->status != WLAN_STATUS_SUCCESS)
+			continue;
+
+		link_bss = hostapd_mld_get_link_bss(hapd, i);
+		if (!link_bss || !link_bss->started ||
+		    link_bss->eht_mld_link_removal_expired ||
+		    !ap_get_sta(link_bss, sta->addr))
+			continue;
+
+		return i;
+	}
+
+	return -1;
+}
+
+
+/* A non-AP MLD with another setup link stays associated (IEEE Std
+ * 802.11be-2024, 35.3.6.3), so its association moves to the lowest such link,
+ * as for a Link Reconfiguration that deletes the association link. */
+static void hostapd_link_remove_move_assoc_stas(struct hostapd_data *hapd)
+{
+	struct hostapd_data *assoc_hapd;
+	struct sta_info *sta, *next, *assoc_sta;
+	int link_id;
+
+	for (sta = hapd->sta_list; sta; sta = next) {
+		next = sta->next;
+
+		if (!(sta->flags & WLAN_STA_ASSOC) || !ap_sta_is_mld(hapd, sta) ||
+		    hostapd_sta_is_link_sta(hapd, sta))
+			continue;
+
+		link_id = hostapd_link_remove_new_assoc_link(hapd, sta);
+		if (link_id < 0)
+			continue;
+
+		assoc_sta = hostapd_ml_move_assoc_sta(hapd, sta, link_id,
+						      &assoc_hapd);
+		if (!assoc_sta)
+			continue;
+
+		wpa_printf(MSG_DEBUG,
+			   "MLD: " MACSTR " moves its association from the removed link_id=%u to link_id=%d",
+			   MAC2STR(sta->addr), hapd->mld_link_id, link_id);
+		ap_sta_link_event(hapd, WPA_EVENT_LINK_STA_REMOVED, sta->addr,
+				  hapd->mld_link_id);
+		ap_free_link_sta(hapd, sta);
+		hostapd_ubus_notify_sta_links(assoc_hapd, assoc_sta);
+	}
+}
+
+
+/* A non-AP MLD left here has no other setup link and gets a Deauthentication,
+ * on a partner link where one beacons. */
 static void hostapd_link_remove_notify_stas(struct hostapd_data *hapd)
 {
 	struct hostapd_data *tx_hapd;
@@ -927,6 +989,7 @@ static void hostapd_link_remove_expire_s
 	unsigned int wait_us;
 
 	hostapd_free_link_stas(hapd);
+	hostapd_link_remove_move_assoc_stas(hapd);
 	hostapd_link_remove_notify_stas(hapd);
 
 	if (!hapd->eht_mld_link_removal_tx) {
--- a/src/ap/ieee802_11.h
+++ b/src/ap/ieee802_11.h
@@ -326,6 +326,9 @@ void ieee80211_ml_build_assoc_resp(struc
 void ieee802_11_rx_protected_eht_action(struct hostapd_data *hapd,
 					const struct ieee80211_mgmt *mgmt,
 					size_t len);
+struct sta_info * hostapd_ml_move_assoc_sta(struct hostapd_data *hapd,
+					    struct sta_info *sta, u8 link_id,
+					    struct hostapd_data **assoc_hapd);
 void hostapd_link_reconf_resp_tx_status(struct hostapd_data *hapd,
 					struct sta_info *sta,
 					const struct ieee80211_mgmt *mgmt,
--- a/src/ap/ieee802_11_eht.c
+++ b/src/ap/ieee802_11_eht.c
@@ -1644,14 +1644,42 @@ static void hostapd_ml_reconf_adds_rever
 }
 
 
+/* Makes the STA of the non-AP MLD on link_id its association STA, which takes
+ * over the wpa_sm. sta stays, as a link STA, for the caller to free. */
+struct sta_info * hostapd_ml_move_assoc_sta(struct hostapd_data *hapd,
+					    struct sta_info *sta, u8 link_id,
+					    struct hostapd_data **assoc_hapd)
+{
+	struct hostapd_data *other_hapd;
+	struct sta_info *assoc_sta, *other_sta;
+
+	for_each_mld_link(other_hapd, hapd) {
+		other_sta = ap_get_sta(other_hapd, sta->addr);
+		if (other_sta)
+			other_sta->mld_assoc_link_id = link_id;
+	}
+
+	assoc_sta = hostapd_ml_get_assoc_sta(hapd, sta, assoc_hapd);
+	if (!assoc_sta || *assoc_hapd == hapd) {
+		wpa_printf(MSG_ERROR,
+			   "MLD: assoc_hapd is not updated; please check");
+		return NULL;
+	}
+
+	wpa_reset_assoc_sm_info(assoc_sta->wpa_sm, (*assoc_hapd)->wpa_auth,
+				link_id);
+	return assoc_sta;
+}
+
+
 void hostapd_link_reconf_resp_tx_status(struct hostapd_data *hapd,
 					struct sta_info *sta,
 					const struct ieee80211_mgmt *mgmt,
 					size_t len, int ok)
 {
 	u8 dialog_token = mgmt->u.action.u.link_reconf_resp.dialog_token;
-	struct hostapd_data *assoc_hapd, *lhapd, *other_hapd;
-	struct sta_info *assoc_sta, *lsta, *other_sta;
+	struct hostapd_data *assoc_hapd, *lhapd;
+	struct sta_info *assoc_sta, *lsta;
 	struct link_reconf_req_list *req_list;
 	struct link_reconf_req_info *info;
 	uint8_t link_id;
@@ -1754,35 +1782,16 @@ void hostapd_link_reconf_resp_tx_status(
 			}
 			wpa_printf(MSG_DEBUG, "MLD: New assoc link=%d", i);
 
-			/* Reset wpa_auth and assoc link ID */
-			for_each_mld_link(other_hapd, lhapd) {
-				other_sta = ap_get_sta(other_hapd, mgmt->da);
-				if (other_sta)
-					other_sta->mld_assoc_link_id = i;
-			}
-
 			/* Reset reconfig request queue which will be freed
 			 * at the end */
 			assoc_sta->reconf_req = NULL;
 
-			/* assoc_sta switched */
-			assoc_sta = hostapd_ml_get_assoc_sta(lhapd, lsta,
-							     &assoc_hapd);
-
-			/* assoc_sta cannot be NULL since both AP and STA are
-			 * MLD and new valid assoc_sta is already found */
+			assoc_sta = hostapd_ml_move_assoc_sta(lhapd, lsta, i,
+							      &assoc_hapd);
 			if (!assoc_sta)
 				goto exit;
 
-			if (assoc_hapd == lhapd) {
-				wpa_printf(MSG_ERROR,
-					   "MLD: assoc_hapd is not updated; please check");
-				goto exit;
-			}
-
 			assoc_sta->reconf_req = req_list;
-			wpa_reset_assoc_sm_info(assoc_sta->wpa_sm,
-						assoc_hapd->wpa_auth, i);
 		}
 
 		/* Free as a link STA */
--- a/src/ap/wpa_auth.c
+++ b/src/ap/wpa_auth.c
@@ -8228,6 +8228,11 @@ void wpa_reset_assoc_sm_info(struct wpa_
 			     u8 mld_assoc_link_id)
 {
 #ifdef CONFIG_IEEE80211BE
+	/* The group reference of the new association link as a partner link
+	 * becomes that of sm->group. The old association link drops its
+	 * reference when its STA is freed as a link STA. */
+	assoc_sm->group = wpa_select_vlan_wpa_group(wpa_auth->group,
+						    assoc_sm->group->vlan_id);
 	assoc_sm->wpa_auth = wpa_auth;
 	assoc_sm->mld_assoc_link_id = mld_assoc_link_id;
 #endif /* CONFIG_IEEE80211BE */
