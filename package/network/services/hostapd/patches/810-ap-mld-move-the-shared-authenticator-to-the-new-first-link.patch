--- a/src/ap/authsrv.c
+++ b/src/ap/authsrv.c
@@ -387,6 +387,9 @@ int authsrv_init(struct hostapd_data *ha
 #ifdef EAP_SIM_DB
 		hapd->eap_sim_db_priv = first->eap_sim_db_priv;
 #endif /* EAP_SIM_DB */
+#ifdef RADIUS_SERVER
+		hapd->radius_srv = first->radius_srv;
+#endif /* RADIUS_SERVER */
 		return 0;
 	}
 #endif /* CONFIG_IEEE80211BE */
@@ -503,6 +506,41 @@ int authsrv_init(struct hostapd_data *ha
 }
 
 
+#ifdef CONFIG_IEEE80211BE
+/* The authentication server that the links of an AP MLD share calls back with
+ * the first BSS and holds its WPS context, message context and EAP server
+ * mode. radius_server_init() enables that mode for the RADIUS server. */
+void authsrv_mld_first_bss_moved(struct hostapd_data *old,
+				 struct hostapd_data *first)
+{
+	if (first->eap_cfg && first->eap_cfg == old->eap_cfg) {
+		first->eap_cfg->wps = first->wps;
+		first->eap_cfg->msg_ctx = first->msg_ctx;
+		if (!first->radius_srv)
+			first->eap_cfg->eap_server = first->conf->eap_server;
+	}
+
+#ifdef CRYPTO_RSA_OAEP_SHA256
+	if (!first->imsi_privacy_key) {
+		first->imsi_privacy_key = old->imsi_privacy_key;
+		old->imsi_privacy_key = NULL;
+	}
+#endif /* CRYPTO_RSA_OAEP_SHA256 */
+
+#ifdef EAP_SIM_DB
+	if (first->eap_sim_db_priv &&
+	    first->eap_sim_db_priv == old->eap_sim_db_priv)
+		eap_sim_db_set_ctx(first->eap_sim_db_priv, first);
+#endif /* EAP_SIM_DB */
+
+#ifdef RADIUS_SERVER
+	if (first->radius_srv && first->radius_srv == old->radius_srv)
+		radius_server_set_conf_ctx(first->radius_srv, first);
+#endif /* RADIUS_SERVER */
+}
+#endif /* CONFIG_IEEE80211BE */
