--- a/src/ap/accounting.c
+++ b/src/ap/accounting.c
@@ -457,6 +457,14 @@ static void accounting_report_state(stru
 }
 
 
+static bool accounting_sta_interim_pending(struct hostapd_data *hapd,
+					   struct sta_info *sta)
+{
+	return eloop_is_timeout_registered(accounting_interim_update, hapd,
+					   sta);
+}
+
+
 static void accounting_interim_error_cb(const u8 *addr, void *ctx)
 {
 	struct hostapd_data *hapd = ctx;
@@ -464,7 +472,9 @@ static void accounting_interim_error_cb(
 	unsigned int i, wait_time;
 	int res;
 
-	sta = ap_get_sta(hapd, addr);
+	sta = ap_get_sta_mld_links(&hapd, addr, accounting_sta_interim_pending);
+	if (!sta)
+		sta = ap_get_sta_mld_links(&hapd, addr, NULL);
 	if (!sta)
 		return;
 	sta->acct_interim_errors++;
@@ -514,6 +524,21 @@ static void accounting_interim_error_cb(
 }
 
 
+/* The links of an AP MLD share the RADIUS client of the first BSS, and the
+ * client has one interim accounting error callback. */
+static void * accounting_interim_error_ctx(struct hostapd_data *hapd)
+{
+#ifdef CONFIG_IEEE80211BE
+	struct hostapd_data *first = hostapd_mld_get_first_bss(hapd);
+
+	if (first && !hostapd_mld_is_first_bss(hapd))
+		return first;
+#endif /* CONFIG_IEEE80211BE */
+
+	return hapd;
+}
+
+
 /**
  * accounting_init: Initialize accounting
  * @hapd: hostapd BSS data
@@ -529,7 +554,8 @@ int accounting_init(struct hostapd_data
 				   accounting_receive, hapd))
 		return -1;
 	radius_client_set_interim_error_cb(hapd->radius,
-					   accounting_interim_error_cb, hapd);
+					   accounting_interim_error_cb,
+					   accounting_interim_error_ctx(hapd));
 
 	accounting_report_state(hapd, 1);
 
@@ -537,6 +563,18 @@ int accounting_init(struct hostapd_data
 }
 
 
+#ifdef CONFIG_IEEE80211BE
+void accounting_mld_first_bss_moved(struct hostapd_data *old,
+				    struct hostapd_data *first)
+{
+	if (first->radius && first->radius == old->radius)
+		radius_client_set_interim_error_cb(first->radius,
+						   accounting_interim_error_cb,
+						   first);
+}
+#endif /* CONFIG_IEEE80211BE */
+
+
 /**
  * accounting_deinit: Deinitialize accounting
  * @hapd: hostapd BSS data
@@ -544,4 +582,7 @@ int accounting_init(struct hostapd_data
 void accounting_deinit(struct hostapd_data *hapd)
 {
 	accounting_report_state(hapd, 0);
+	radius_client_unregister(hapd->radius, RADIUS_ACCT,
+				 accounting_receive, hapd);
+	radius_client_unset_interim_error_cb(hapd->radius, hapd);
 }
