--- a/src/radius/radius_client.c
+++ b/src/radius/radius_client.c
@@ -324,6 +324,102 @@ int radius_client_register(struct radius
 
 
 /**
+ * radius_client_unregister - Unregister a RADIUS client RX handler
+ * @radius: RADIUS client context from radius_client_init()
+ * @msg_type: RADIUS client type (RADIUS_AUTH or RADIUS_ACCT)
+ * @handler: Handler registered with radius_client_register()
+ * @data: Context pointer the handler was registered with
+ *
+ * This function is used by a user of a RADIUS client that is shared with
+ * other users and stays in use after this user is deinitialised.
+ */
+void radius_client_unregister(struct radius_client_data *radius,
+			      RadiusType msg_type,
+			      RadiusRxResult (*handler)(struct radius_msg *msg,
+							struct radius_msg *req,
+							const u8 *shared_secret,
+							size_t shared_secret_len,
+							void *data),
+			      void *data)
+{
+	struct radius_rx_handler *handlers;
+	size_t *num, i;
+
+	if (!radius)
+		return;
+
+	if (msg_type == RADIUS_ACCT) {
+		handlers = radius->acct_handlers;
+		num = &radius->num_acct_handlers;
+	} else {
+		handlers = radius->auth_handlers;
+		num = &radius->num_auth_handlers;
+	}
+
+	for (i = 0; i < *num; i++) {
+		if (handlers[i].handler != handler || handlers[i].data != data)
+			continue;
+		os_memmove(&handlers[i], &handlers[i + 1],
+			   (*num - i - 1) * sizeof(*handlers));
+		(*num)--;
+		return;
+	}
+}
+
+
+/**
+ * radius_client_handler_data_replace - Move a RX handler to another context
+ * @radius: RADIUS client context from radius_client_init()
+ * @msg_type: RADIUS client type (RADIUS_AUTH or RADIUS_ACCT)
+ * @handler: Handler registered with radius_client_register()
+ * @old_data: Context pointer the handler was registered with
+ * @new_data: Context pointer to use from now on
+ */
+void radius_client_handler_data_replace(struct radius_client_data *radius,
+					RadiusType msg_type,
+					RadiusRxResult (*handler)
+					(struct radius_msg *msg,
+					 struct radius_msg *req,
+					 const u8 *shared_secret,
+					 size_t shared_secret_len,
+					 void *data),
+					void *old_data, void *new_data)
+{
+	struct radius_rx_handler *handlers;
+	size_t num, i;
+
+	if (!radius)
+		return;
+
+	if (msg_type == RADIUS_ACCT) {
+		handlers = radius->acct_handlers;
+		num = radius->num_acct_handlers;
+	} else {
+		handlers = radius->auth_handlers;
+		num = radius->num_auth_handlers;
+	}
+
+	for (i = 0; i < num; i++) {
+		if (handlers[i].handler == handler &&
+		    handlers[i].data == old_data)
+			handlers[i].data = new_data;
+	}
+}
+
+
+/**
+ * radius_client_set_ctx - Change the context pointer for hostapd_logger()
+ * @radius: RADIUS client context from radius_client_init()
+ * @ctx: Context pointer to use from now on
+ */
+void radius_client_set_ctx(struct radius_client_data *radius, void *ctx)
+{
+	if (radius)
+		radius->ctx = ctx;
+}
+
+
+/**
  * radius_client_set_interim_erro_cb - Register an interim acct error callback
  * @radius: RADIUS client context from radius_client_init()
  * @addr: Station address from the failed message
@@ -342,6 +438,24 @@ void radius_client_set_interim_error_cb(
 }
 
 
+/**
+ * radius_client_unset_interim_error_cb - Remove an interim acct error callback
+ * @radius: RADIUS client context from radius_client_init()
+ * @ctx: Context pointer the callback was registered with
+ *
+ * The callback is removed only if it was registered with @ctx.
+ */
+void radius_client_unset_interim_error_cb(struct radius_client_data *radius,
+					  void *ctx)
+{
+	if (!radius || radius->interim_error_cb_ctx != ctx)
+		return;
+
+	radius->interim_error_cb = NULL;
+	radius->interim_error_cb_ctx = NULL;
+}
