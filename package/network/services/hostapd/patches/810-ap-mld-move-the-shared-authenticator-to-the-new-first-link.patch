+static void hostapd_mld_move_radius(struct hostapd_data *old_fbss,
+				    struct hostapd_data *new_fbss)
+{
+#ifndef CONFIG_NO_RADIUS
+	struct hostapd_radius_servers *servers;
+
+	if (!new_fbss->radius || new_fbss->radius != old_fbss->radius)
+		return;
+
+	/* The RADIUS client and its pending messages point into the server
+	 * list of the configuration it was set up with. */
+	servers = new_fbss->conf->radius;
+	new_fbss->conf->radius = old_fbss->conf->radius;
+	old_fbss->conf->radius = servers;
+	radius_client_set_ctx(new_fbss->radius, new_fbss);
+
+	if (new_fbss->radius_das == old_fbss->radius_das)
+		radius_das_set_ctx(new_fbss->radius_das, new_fbss);
+#endif /* CONFIG_NO_RADIUS */
+}
