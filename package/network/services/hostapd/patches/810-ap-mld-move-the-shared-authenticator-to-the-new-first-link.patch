--- a/src/ap/ieee802_1x.c
+++ b/src/ap/ieee802_1x.c
@@ -2678,6 +2678,54 @@ void ieee802_1x_erp_flush(struct hostapd
 }
 
 
+#ifdef CONFIG_IEEE80211BE
+/* The IEEE 802.1X authenticator that the links of an AP MLD share calls back
+ * with the first BSS, which also holds its ERP keys and WEP rekey timer. */
+void ieee802_1x_mld_first_bss_moved(struct hostapd_data *old,
+				    struct hostapd_data *first)
+{
+	struct eapol_authenticator *eapol = first->eapol_auth;
+#ifdef CONFIG_WEP
+	struct os_reltime remaining;
+#endif /* CONFIG_WEP */
+
+	if (!eapol || eapol != old->eapol_auth)
+		return;
+
+	if (eapol->conf.ctx == old)
+		eapol->conf.ctx = first;
+
+#ifdef CONFIG_WEP
+	if (eloop_cancel_timeout_one(ieee802_1x_rekey, old, NULL, &remaining))
+		eloop_register_timeout(remaining.sec, remaining.usec,
+				       ieee802_1x_rekey, first, NULL);
+#endif /* CONFIG_WEP */
+
+#ifdef CONFIG_ERP
+	while (!dl_list_empty(&old->erp_keys)) {
+		struct eap_server_erp_key *erp;
+
+		erp = dl_list_first(&old->erp_keys, struct eap_server_erp_key,
+				    list);
+		dl_list_del(&erp->list);
+		dl_list_add_tail(&first->erp_keys, &erp->list);
+	}
+#endif /* CONFIG_ERP */
+
+#ifndef CONFIG_NO_RADIUS
+	if (first->radius && first->radius == old->radius)
+		radius_client_handler_data_replace(first->radius, RADIUS_AUTH,
+						   ieee802_1x_receive_auth,
+						   old, first);
+#endif /* CONFIG_NO_RADIUS */
+
+	wpa_printf(MSG_DEBUG,
+		   "MLD: IEEE 802.1X state machine moved to the first BSS %s",
+		   first->conf->iface);
+}
+#endif /* CONFIG_IEEE80211BE */
+
+
 void ieee802_1x_deinit(struct hostapd_data *hapd)
 {
 #ifdef CONFIG_IEEE80211BE
@@ -2694,6 +2742,11 @@ void ieee802_1x_deinit(struct hostapd_da
 	eloop_cancel_timeout(ieee802_1x_rekey, hapd, NULL);
 #endif /* CONFIG_WEP */
 
+#ifndef CONFIG_NO_RADIUS
+	radius_client_unregister(hapd->radius, RADIUS_AUTH,
+				 ieee802_1x_receive_auth, hapd);
+#endif /* CONFIG_NO_RADIUS */
+
 	if (hapd->driver && hapd->drv_priv &&
 	    (hapd->conf->ieee802_1x || hapd->conf->wpa))
 		hostapd_set_drv_ieee8021x(hapd, hapd->conf->iface, 0);
