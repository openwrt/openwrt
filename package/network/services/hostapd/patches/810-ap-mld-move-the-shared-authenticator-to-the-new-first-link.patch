+		ieee802_1x_mld_first_bss_moved(hapd, next_fbss);
+		authsrv_mld_first_bss_moved(hapd, next_fbss);
 	}
 
 	wpa_printf(MSG_DEBUG, "AP MLD %s: First link BSS set to %p",
--- a/src/ap/ieee802_11_auth.c
