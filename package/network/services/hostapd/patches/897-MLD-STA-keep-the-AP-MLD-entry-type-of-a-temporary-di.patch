From: Felix Fietkau <nbd@nbd.name>
Date: Fri, 30 Oct 2026 03:10:00 +0100
Subject: [PATCH] MLD STA: keep the AP MLD entry type of a temporary disable

After more than three consecutive connection failures,
wpas_connection_failed() disables the network for a time and records
the failed address in disabled_due_to. At the end of that time,
wpas_clear_temp_disabled() puts the address on the BSSID ignore list.
For a disconnection from an AP MLD the address is the AP MLD address,
and the BSSID entry then excludes the link whose BSSID equals it.

Record whether disabled_due_to is an AP MLD address, and list it with
the same entry type.

Signed-off-by: Felix Fietkau <nbd@nbd.name>
---
--- a/wpa_supplicant/config_ssid.h
+++ b/wpa_supplicant/config_ssid.h
@@ -903,6 +903,11 @@ struct wpa_ssid {
 	u8 disabled_due_to[ETH_ALEN];
 
 	/**
+	 * disabled_due_to_ap_mld - disabled_due_to is an AP MLD address
+	 */
+	bool disabled_due_to_ap_mld;
+
+	/**
 	 * parent_cred - Pointer to parent wpa_cred entry
 	 *
 	 * This pointer can be used to delete temporary networks when a wpa_cred
--- a/wpa_supplicant/wpa_supplicant.c
+++ b/wpa_supplicant/wpa_supplicant.c
@@ -9684,8 +9684,12 @@ void wpas_auth_failed(struct wpa_supplic
 		ssid->id, wpa_ssid_txt(ssid->ssid, ssid->ssid_len),
 		ssid->auth_failures, dur, reason);
 
-	if (bssid)
+	if (bssid) {
 		os_memcpy(ssid->disabled_due_to, bssid, ETH_ALEN);
+		ssid->disabled_due_to_ap_mld =
+			wpa_bssid_ignore_type_of(wpa_s, bssid) ==
+			WPA_BSSID_IGNORE_AP_MLD;
+	}
 }
 
 
@@ -9708,7 +9712,10 @@ void wpas_clear_temp_disabled(struct wpa
 		wpa_printf(MSG_DEBUG, "Mark BSSID " MACSTR
 			   " ignored to allow a lower priority BSS, if any, to be tried next",
 			   MAC2STR(ssid->disabled_due_to));
-		wpa_bssid_ignore_add(wpa_s, ssid->disabled_due_to);
+		wpa_bssid_ignore_add_type(wpa_s, ssid->disabled_due_to,
+					  ssid->disabled_due_to_ap_mld ?
+					  WPA_BSSID_IGNORE_AP_MLD :
+					  WPA_BSSID_IGNORE_BSS);
 		os_memset(ssid->disabled_due_to, 0, ETH_ALEN);
 	}
 }
--- a/wpa_supplicant/events.c
+++ b/wpa_supplicant/events.c
@@ -5721,7 +5721,10 @@ static void wpas_event_disconnect(struct
 		(wpa_s->key_mgmt & WPA_KEY_MGMT_IEEE8021X_NO_WPA)) &&
 	       eapol_sm_failed(wpa_s->eapol))) &&
 	     !wpa_s->eap_expected_failure))
-		wpas_auth_failed(wpa_s, "AUTH_FAILED", addr);
+		wpas_auth_failed(wpa_s, "AUTH_FAILED",
+				 wpa_s->valid_links && addr &&
+				 ether_addr_equal(addr, wpa_s->bssid) ?
+				 wpa_s->bssid : addr);
 
 #ifdef CONFIG_P2P
 	if (deauth && reason_code > 0) {
