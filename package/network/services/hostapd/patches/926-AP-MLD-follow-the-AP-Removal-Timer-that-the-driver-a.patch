+static void nl80211_ap_removal_timer_started(struct i802_bss *bss,
+					     struct nlattr *tb[])
+{
+	union wpa_event_data data;
+
+	if (!tb[NL80211_ATTR_MLO_LINK_ID] ||
+	    !tb[NL80211_ATTR_AP_REMOVAL_COUNT] ||
+	    !tb[NL80211_ATTR_AP_REMOVAL_TSF])
+		return;
+
+	os_memset(&data, 0, sizeof(data));
+	data.ap_removal_timer_started.link_id =
+		nla_get_u8(tb[NL80211_ATTR_MLO_LINK_ID]);
+	data.ap_removal_timer_started.count =
+		nla_get_u16(tb[NL80211_ATTR_AP_REMOVAL_COUNT]);
+	data.ap_removal_timer_started.tsf =
+		nla_get_u64(tb[NL80211_ATTR_AP_REMOVAL_TSF]);
+	data.ap_removal_timer_started.tbtt_valid =
+		nl80211_tbtt_age(tb[NL80211_ATTR_AP_REMOVAL_TBTT_BOOTTIME],
+				 &data.ap_removal_timer_started.tbtt_age_us);
+	if (!nl80211_link_valid(bss->valid_links,
+				data.ap_removal_timer_started.link_id))
+		return;
+
+	wpa_printf(MSG_DEBUG,
+		   "nl80211: AP Removal Timer started - Link ID %u count %u TSF %llu",
+		   data.ap_removal_timer_started.link_id,
+		   data.ap_removal_timer_started.count,
+		   (unsigned long long) data.ap_removal_timer_started.tsf);
+
+	wpa_supplicant_event(bss->ctx, EVENT_AP_REMOVAL_TIMER_STARTED, &data);
+}
+
+
