From: Felix Fietkau <nbd@nbd.name>
Date: Sat, 14 Nov 2026 19:00:00 +0100
Subject: [PATCH] AP MLD: follow the AP Removal Timer that the driver applies

Depends on the mac80211 patch that adds
NL80211_CMD_AP_REMOVAL_TIMER_STARTED.

A driver that counts the AP Removal Timer can put another count on air
than the Beacon frame named, such as the count of a whole number of
seconds, and removes the link at its own count. hostapd then counts the
Probe Response frames, times the stop of the link, gives up on the
expiry and tells the caller of the removal from the count it asked for.

Take the count and the removal TBTT from
NL80211_CMD_AP_REMOVAL_TIMER_STARTED: the host count shifts by the
difference, the stop of the link follows the removal TBTT, and the wait
for a missing expiry starts from it. The times of a removal hold at the
start of a removal that hostapd counts, and at the driver's report of an
offloaded one, or three beacon intervals after its start without one;
the ucode hook bss_link_remove_timed tells the caller where that comes
after the request, and the ucode method link_remove_times reads them.

Signed-off-by: Felix Fietkau <nbd@nbd.name>
---
--- a/src/ap/drv_callbacks.c
+++ b/src/ap/drv_callbacks.c
@@ -3113,6 +3113,10 @@ void hostapd_wpa_event(void *ctx, enum w
 		hostapd_link_remove_expired(
 			hapd, data->ap_removal_timer_expired.links);
 		break;
+	case EVENT_AP_REMOVAL_TIMER_STARTED:
+		hostapd_link_remove_timer_started(
+			hapd, &data->ap_removal_timer_started);
+		break;
 #endif /* CONFIG_IEEE80211BE */
 	default:
 		wpa_printf(MSG_DEBUG, "Unknown event %d", event);
--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -479,6 +479,7 @@ static void hostapd_link_remove_timeout_
 						void *user_ctx);
 static void hostapd_link_remove_offload_expire(struct hostapd_data *hapd);
 static void hostapd_link_remove_next(struct hostapd_data *hapd);
+static void hostapd_reltime_ago(struct os_reltime *t, s64 age_us);
 
 
 /* A nontransmitted BSSID sends no Beacon frames of its own, so the driver does
@@ -576,11 +577,15 @@ static void hostapd_link_remove_return_a
 
 /* The first Beacon frame with the element goes out less than one beacon
  * interval after the update returns, so the removal TBTT comes before
- * start + 1 intervals after that return */
+ * start + 1 intervals after that return, where the driver did not report it */
 static u64 hostapd_link_remove_tbtt_after_us(struct hostapd_data *hapd)
 {
 	struct os_reltime t;
 
+	if (hapd->eht_mld_link_removal_tbtt_valid)
+		return hostapd_link_remove_until_us(
+			&hapd->eht_mld_link_removal_tbtt);
+
 	hostapd_link_remove_return_after(hapd,
 					 hapd->eht_mld_link_removal_start + 1,
 					 &t);
@@ -758,6 +763,96 @@ static void hostapd_link_remove_offload_
 }
 
 
+static void hostapd_link_remove_report_missing(void *eloop_data,
+					       void *user_ctx);
+
+/* The caller of a removal waits for its times until they hold */
+static void hostapd_link_remove_timed_set(struct hostapd_data *hapd)
+{
+	eloop_cancel_timeout(hostapd_link_remove_report_missing, hapd, NULL);
+	if (hapd->eht_mld_link_removal_timed)
+		return;
+
+	hapd->eht_mld_link_removal_timed = true;
+	hostapd_ucode_bss_cb(hapd, "bss_link_remove_timed");
+}
+
+
+bool hostapd_link_remove_timed(struct hostapd_data *hapd)
+{
+	return hapd->eht_mld_link_removal_timed;
+}
+
+
+static void hostapd_link_remove_report_missing(void *eloop_data,
+					       void *user_ctx)
+{
+	struct hostapd_data *hapd = eloop_data;
+
+	wpa_printf(MSG_DEBUG,
+		   "MLD: The driver reported no start of the AP Removal Timer of link_id=%u, keep %u beacons",
+		   hapd->mld_link_id, hapd->eht_mld_link_removal_start);
+	hostapd_link_remove_timed_set(hapd);
+}
+
+
+/* The device can put another count on air than the template names, such as
+ * the count of a whole number of seconds, and removes the link at its own
+ * count */
+void hostapd_link_remove_timer_started(struct hostapd_data *hapd,
+				       struct ap_removal_timer_started *started)
+{
+	struct os_reltime t;
+	u16 count;
+	int left;
+	u64 us;
+
+	if (!hapd->conf->mld_ap || !hapd->mld)
+		return;
+
+	hapd = hostapd_mld_get_link_bss(hapd, started->link_id);
+	if (!hapd || !hapd->eht_mld_link_removal_offload ||
+	    !hapd->eht_mld_link_removal_count) {
+		wpa_printf(MSG_DEBUG,
+			   "MLD: No offloaded removal of link_id=%u counts, ignore the start of its timer",
+			   started->link_id);
+		return;
+	}
+
+	wpa_printf(MSG_DEBUG,
+		   "MLD: The driver removes link_id=%u in %u beacons, the Beacon frame named %u",
+		   hapd->mld_link_id, started->count,
+		   hapd->eht_mld_link_removal_start);
+
+	count = hapd->eht_mld_link_removal_count;
+	left = count + started->count - hapd->eht_mld_link_removal_start;
+	hapd->eht_mld_link_removal_start = started->count;
+	hapd->eht_mld_link_removal_count = left > 1 ? left : 1;
+	/* the host count stops at 1 */
+	if (count <= 1 && hapd->eht_mld_link_removal_count > 1)
+		hostapd_link_remove_timeout_register(hapd);
+
+	hapd->eht_mld_link_removal_tbtt_valid = started->tbtt_valid;
+	if (started->tbtt_valid) {
+		hostapd_reltime_ago(&hapd->eht_mld_link_removal_tbtt,
+				    started->tbtt_age_us);
+		t = hapd->eht_mld_link_removal_tbtt;
+		us = 2 * TU_TO_USEC(hapd->iconf->beacon_int);
+		t.sec += (t.usec + us) / 1000000;
+		t.usec = (t.usec + us) % 1000000;
+	} else {
+		hostapd_link_remove_return_after(hapd, started->count + 2, &t);
+	}
+
+	us = hostapd_link_remove_until_us(&t);
+	eloop_cancel_timeout(hostapd_link_remove_offload_missing, hapd, NULL);
+	eloop_register_timeout(us / 1000000, us % 1000000,
+			       hostapd_link_remove_offload_missing, hapd, NULL);
+
+	hostapd_link_remove_timed_set(hapd);
+}
+
+
 static struct hostapd_data *
 hostapd_link_remove_partner(struct hostapd_data *hapd, struct sta_info *sta)
 {
@@ -1197,9 +1292,11 @@ static void hostapd_link_remove_offload_
 	if (!hostapd_link_remove_expire_beacons(hapd)) {
 		eloop_cancel_timeout(hostapd_link_remove_offload_tbtt, hapd,
 				     NULL);
+		hostapd_link_remove_timed_set(hapd);
 		return;
 	}
 
+	hostapd_link_remove_timed_set(hapd);
 	hostapd_link_remove_unauth_stas(hapd);
 }
 
@@ -1318,6 +1415,8 @@ static int hostapd_link_remove_start(str
 	if (!hapd->eht_mld_link_removal_offload)
 		os_get_reltime(&hapd->eht_mld_link_removal_due);
 	hapd->eht_mld_link_removal_return = hapd->eht_mld_link_removal_due;
+	hapd->eht_mld_link_removal_tbtt_valid = false;
+	hapd->eht_mld_link_removal_timed = !hapd->eht_mld_link_removal_offload;
 	hostapd_link_remove_timeout_register(hapd);
 
 	if (hapd->eht_mld_link_removal_offload) {
@@ -1329,6 +1428,13 @@ static int hostapd_link_remove_start(str
 		eloop_register_timeout(us / 1000000, us % 1000000,
 				       hostapd_link_remove_offload_missing,
 				       hapd, NULL);
+
+		/* the driver reports the start at the first TBTT at the latest */
+		hostapd_link_remove_return_after(hapd, 3, &t);
+		us = hostapd_link_remove_until_us(&t);
+		eloop_register_timeout(us / 1000000, us % 1000000,
+				       hostapd_link_remove_report_missing,
+				       hapd, NULL);
 	}
 	return 0;
 }
@@ -1368,12 +1474,17 @@ static void hostapd_link_remove_queued_s
 
 	hapd->eht_mld_link_removal_queued = 0;
 	if (hostapd_link_remove_allowed(hapd) &&
-	    !hostapd_link_remove_start(hapd, count))
+	    !hostapd_link_remove_start(hapd, count)) {
+		/* the caller of the request waits for these times */
+		if (hapd->eht_mld_link_removal_timed)
+			hostapd_ucode_bss_cb(hapd, "bss_link_remove_timed");
 		return;
+	}
 
 	wpa_printf(MSG_INFO,
 		   "MLD: The queued removal of link_id=%u did not start",
 		   hapd->mld_link_id);
+	hostapd_link_remove_timed_set(hapd);
 	hostapd_link_remove_next(hapd);
 }
 
@@ -1404,6 +1515,7 @@ int hostapd_link_remove(struct hostapd_d
 		return hostapd_link_remove_start(hapd, count);
 
 	hapd->eht_mld_link_removal_queued = count;
+	hapd->eht_mld_link_removal_timed = false;
 	wpa_printf(MSG_DEBUG,
 		   "MLD: Remove link_id=%u in %u beacons after the removal of link_id=%u",
 		   hapd->mld_link_id, count, before->mld_link_id);
@@ -1761,6 +1873,7 @@ void hostapd_free_hapd_data(struct hosta
 	eloop_cancel_timeout(hostapd_link_remove_held_start, hapd,
 			     ELOOP_ALL_CTX);
 	eloop_cancel_timeout(hostapd_link_remove_queued_start, hapd, NULL);
+	eloop_cancel_timeout(hostapd_link_remove_report_missing, hapd, NULL);
 	hapd->eht_mld_link_removal_count = 0;
 	hapd->eht_mld_link_removal_offload = false;
 	hapd->eht_mld_link_removal_start_pending = false;
@@ -1768,6 +1881,8 @@ void hostapd_free_hapd_data(struct hosta
 	hapd->eht_mld_link_removal_expired = false;
 	hapd->eht_mld_link_removal_tx = 0;
 	hapd->eht_mld_link_removal_queued = 0;
+	hapd->eht_mld_link_removal_tbtt_valid = false;
+	hapd->eht_mld_link_removal_timed = false;
 	hapd->eht_mld_crit_update = false;
 	/* The removal ends here without the expiry that starts these links */
 	if (removal_offload && hapd->conf && hapd->conf->mld_ap && hapd->mld)
--- a/src/ap/hostapd.h
+++ b/src/ap/hostapd.h
@@ -566,6 +566,12 @@ struct hostapd_data {
 	bool eht_mld_link_removal_start_pending;
 	/* The return of the update that started the driver's count */
 	struct os_reltime eht_mld_link_removal_return;
