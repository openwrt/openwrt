+		if (is_ap_interface(drv->nlmode))
+			nl80211_ap_removal_timer_started(bss, tb);
+		break;
 	case NL80211_CMD_ASSOC_MLO_RECONF:
 		mlme_event_link_addition(bss, nla_data(frame), nla_len(frame));
 		break;
