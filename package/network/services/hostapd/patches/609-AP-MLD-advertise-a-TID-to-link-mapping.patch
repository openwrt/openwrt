+/* IEEE Std 802.11be-2024, 9.4.2.324 and 35.3.7.2.4 */
+static u8 * hostapd_eid_adv_ttlm(struct hostapd_data *hapd, u8 *eid,
+				 u32 duration)
+{
+	u16 links = hapd->mld->adv_ttlm_links;
+	bool one_octet = !(links & 0xff00);
+	u8 *pos = eid, *len, control;
+	int i;
+
+	control = EHT_TID_TO_LINK_MAP_DIRECTION_BOTH |
+		EHT_TID_TO_LINK_MAP_EXPECT_DUR_PRESENT;
+	if (hapd->mld->adv_ttlm_state == HOSTAPD_ADV_TTLM_REQUESTED)
+		control |= EHT_TID_TO_LINK_MAP_SWITCH_TIME_PRESENT;
+	if (one_octet)
+		control |= EHT_TID_TO_LINK_MAP_LINK_MAPPING_SIZE;
+
+	*pos++ = WLAN_EID_EXTENSION;
+	len = pos++;
+	*pos++ = WLAN_EID_EXT_TID_TO_LINK_MAPPING;
+	*pos++ = control;
+	*pos++ = 0xff; /* link mapping presence bitmap */
+
+	if (control & EHT_TID_TO_LINK_MAP_SWITCH_TIME_PRESENT) {
+		WPA_PUT_LE16(pos, hapd->adv_ttlm_switch_tsf);
+		pos += 2;
+	}
+
+	WPA_PUT_LE24(pos, duration);
+	pos += 3;
+
+	for (i = 0; i < 8; i++) {
+		if (one_octet) {
+			*pos++ = links;
+			continue;
+		}
+
+		WPA_PUT_LE16(pos, links);
+		pos += 2;
+	}
+
+	*len = pos - len - 1;
+
+	return pos;
+}
