+	if (!msg ||
+	    nla_put_u16(msg, NL80211_ATTR_MLO_ADV_TTLM_LINKS, links) ||
+	    nla_put_u32(msg, NL80211_ATTR_MLO_ADV_TTLM_SWITCH_TIME,
+			switch_time) ||
+	    nla_put_u32(msg, NL80211_ATTR_MLO_ADV_TTLM_DURATION, duration)) {
+		nlmsg_free(msg);
+		return -ENOBUFS;
+	}
+
+	*cookie = 0;
+	ret = send_and_recv_resp(bss->drv, msg, cookie_handler, cookie);
+	if (ret)
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: Advertised TTLM request failed: ret=%d (%s)",
+			   ret, strerror(-ret));
+
+	return ret;
