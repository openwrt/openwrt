+/* The driver reports CLOCK_BOOTTIME, which os_get_reltime() need not use */
+static bool nl80211_adv_ttlm_tbtt_age(struct nlattr *attr, s64 *age_us)
+{
+	struct timespec ts;
+	u64 now;
+
+#ifndef CLOCK_BOOTTIME
+#define CLOCK_BOOTTIME 7
+#endif
+	if (!attr || clock_gettime(CLOCK_BOOTTIME, &ts))
+		return false;
+
+	now = (u64) ts.tv_sec * 1000000000 + ts.tv_nsec;
+	*age_us = (s64) (now - nla_get_u64(attr)) / 1000;
+	return true;
+}
+
+
+static void nl80211_adv_ttlm_event(struct i802_bss *bss, int cmd,
+				   struct nlattr *tb[])
+{
+	union wpa_event_data data;
+
+	if (!tb[NL80211_ATTR_COOKIE])
+		return;
+
+	os_memset(&data, 0, sizeof(data));
+	data.adv_ttlm.link_id = NL80211_DRV_LINK_ID_NA;
+	data.adv_ttlm.cookie = nla_get_u64(tb[NL80211_ATTR_COOKIE]);
+	data.adv_ttlm.tbtt_valid =
+		nl80211_adv_ttlm_tbtt_age(
+			tb[NL80211_ATTR_MLO_ADV_TTLM_TBTT_BOOTTIME],
+			&data.adv_ttlm.tbtt_age_us);
+
+	switch (cmd) {
+	case NL80211_CMD_ADV_TTLM_STARTED:
+		if (!tb[NL80211_ATTR_MLO_LINK_ID] ||
+		    !tb[NL80211_ATTR_MLO_ADV_TTLM_SWITCH_TSF])
+			return;
+		data.adv_ttlm.step = ADV_TTLM_STARTED;
+		data.adv_ttlm.link_id = nla_get_u8(tb[NL80211_ATTR_MLO_LINK_ID]);
+		data.adv_ttlm.switch_tsf =
+			nla_get_u16(tb[NL80211_ATTR_MLO_ADV_TTLM_SWITCH_TSF]);
+		if (!nl80211_link_valid(bss->valid_links,
+					data.adv_ttlm.link_id))
+			return;
+		break;
+	case NL80211_CMD_ADV_TTLM_ESTABLISHED:
+		data.adv_ttlm.step = ADV_TTLM_ESTABLISHED;
+		break;
+	default:
+		data.adv_ttlm.step = ADV_TTLM_ENDED;
+		break;
+	}
+
+	wpa_printf(MSG_DEBUG,
+		   "nl80211: Advertised TTLM step %d - Link ID %d switch %u cookie 0x%llx",
+		   data.adv_ttlm.step, data.adv_ttlm.link_id,
+		   data.adv_ttlm.switch_tsf,
+		   (unsigned long long) data.adv_ttlm.cookie);
+
+	wpa_supplicant_event(bss->ctx, EVENT_ADV_TTLM, &data);
+}
