+
+static void hostapd_adv_ttlm_clear(struct hostapd_data *hapd)
+{
+	struct hostapd_data *link_bss;
+
+	hapd->mld->adv_ttlm_state = HOSTAPD_ADV_TTLM_NONE;
+	hapd->mld->adv_ttlm_cookie = 0;
+	for_each_mld_link(link_bss, hapd) {
+		link_bss->adv_ttlm_started = false;
+		link_bss->adv_ttlm_tbtt_valid = false;
+	}
+}
+
+
+static s64 hostapd_reltime_us(const struct os_reltime *t)
+{
+	return t->sec * 1000000LL + t->usec;
+}
+
+
+static void hostapd_reltime_ago(struct os_reltime *t, s64 age_us)
+{
+	s64 us;
+
+	os_get_reltime(t);
+	us = hostapd_reltime_us(t) - age_us;
+	t->sec = us / 1000000;
+	t->usec = us % 1000000;
+}
+
+
+int hostapd_adv_ttlm_request(struct hostapd_data *hapd, u16 links,
+			     u32 switch_time, u32 duration)
+{
+	struct hostapd_data *link_bss;
+	u16 valid_links = 0;
+	int ret;
+
+	if (!hapd->conf->mld_ap || !hapd->mld ||
+	    !(hapd->iface->drv_flags2 & WPA_DRIVER_FLAGS2_AP_ADV_TTLM))
+		return -EOPNOTSUPP;
+
+	if (hapd->mld->adv_ttlm_state != HOSTAPD_ADV_TTLM_NONE)
+		return -EBUSY;
+
+	for_each_mld_link(link_bss, hapd) {
+		/* Each link that the mapping disables or enables sets the
+		 * Critical Update flag (IEEE Std 802.11be-2024, 35.3.10) */
+		if (!hostapd_crit_update_offload(link_bss))
+			return -EOPNOTSUPP;
+
+		if (hostapd_link_remove_pending(link_bss))
+			return -EBUSY;
+
+		valid_links |= BIT(link_bss->mld_link_id);
+	}
+
+	/* Two DTIM intervals hold a DTIM Beacon, which an associated non-AP
+	 * MLD in power save receives before the switch
+	 * (IEEE Std 802.11be-2024, 35.3.7.2.4) */
+	if (!switch_time)
+		switch_time = 2 * hapd->conf->dtim_period *
+			hapd->iconf->beacon_int;
+
+	/* The Mapping Switch Time field holds bits 10 to 25 of the TSF */
+	if (!links || (links & ~valid_links) || links == valid_links ||
+	    switch_time > 0xffff || !duration || duration > 0xffffff)
+		return -EINVAL;
+
+	hostapd_adv_ttlm_clear(hapd);
+	hapd->mld->adv_ttlm_links = links;
+	hapd->mld->adv_ttlm_duration = duration;
+	hapd->mld->adv_ttlm_state = HOSTAPD_ADV_TTLM_REQUESTED;
+
+	wpa_printf(MSG_DEBUG,
+		   "MLD: Advertised TTLM request links=0x%x switch_time=%u duration=%u",
+		   links, switch_time, duration);
+
+	ret = hostapd_drv_adv_ttlm_request(hapd, links, switch_time, duration,
+					   &hapd->mld->adv_ttlm_cookie);
+	if (ret)
+		hostapd_adv_ttlm_clear(hapd);
+
+	return ret;
+}
+
+
+/* The Expected Duration field: constant until the mapping is established,
+ * then the time that remains from the most recent TBTT. Only Beacon and Probe
+ * Response frames carry the Mapping Switch Time field of a mapping that is
+ * not yet established (IEEE Std 802.11be-2024, 9.4.2.324). */
+u32 hostapd_adv_ttlm_duration(struct hostapd_data *hapd, u16 stype)
+{
+	struct hostapd_mld *mld = hapd->mld;
+	s64 beacon_us, tbtt_us, end_us, tbtts;
+	struct os_reltime now;
+
+	if (!hapd->conf->mld_ap || !mld)
+		return 0;
+
+	if (mld->adv_ttlm_state == HOSTAPD_ADV_TTLM_REQUESTED) {
+		if (stype != WLAN_FC_STYPE_BEACON &&
+		    stype != WLAN_FC_STYPE_PROBE_RESP)
+			return 0;
+
+		return hapd->adv_ttlm_started ? mld->adv_ttlm_duration : 0;
+	}
+
+	if (mld->adv_ttlm_state != HOSTAPD_ADV_TTLM_ESTABLISHED)
+		return 0;
+
+	/* The TBTTs of the link follow the one that the driver reported, or
+	 * else the establishment */
+	tbtt_us = hostapd_reltime_us(hapd->adv_ttlm_tbtt_valid ?
+				     &hapd->adv_ttlm_tbtt :
+				     &mld->adv_ttlm_established);
+	beacon_us = TU_TO_USEC(hapd->iconf->beacon_int);
+	os_get_reltime(&now);
+	tbtts = hostapd_reltime_us(&now) - tbtt_us;
+	tbtts = tbtts >= 0 ? tbtts / beacon_us :
+		-((-tbtts + beacon_us - 1) / beacon_us);
+
+	/* A Beacon frame counts from its own TBTT, the next one */
+	if (stype == WLAN_FC_STYPE_BEACON)
+		tbtts++;
+
+	tbtt_us += tbtts * beacon_us;
+	end_us = hostapd_reltime_us(&mld->adv_ttlm_established) +
+		TU_TO_USEC((s64) mld->adv_ttlm_duration);
+	if (tbtt_us >= end_us)
+		return 0;
+
+	return MIN((end_us - tbtt_us + 512) / 1024, mld->adv_ttlm_duration);
+}
+
+
+bool hostapd_adv_ttlm_link_disabled(struct hostapd_data *hapd)
+{
+	struct hostapd_mld *mld = hapd->mld;
+
+	return hapd->conf->mld_ap && mld &&
+		mld->adv_ttlm_state == HOSTAPD_ADV_TTLM_ESTABLISHED &&
+		!(mld->adv_ttlm_links & BIT(hapd->mld_link_id));
+}
+
+
+/* An affiliated AP that a new advertised TTLM disables or enables is a
+ * critical update (IEEE Std 802.11be-2024, 35.3.10) */
+static void hostapd_adv_ttlm_update(struct hostapd_data *hapd,
+				    bool links_changed)
+{
+	if (links_changed)
+		hostapd_mld_crit_update_start(hapd);
+	hostapd_mld_beacons_update(hapd);
+	hostapd_ubus_notify_adv_ttlm(hapd);
+}
+
+
+/* cfg80211 ends the mapping when a link of the AP MLD stops */
+static void hostapd_adv_ttlm_stop(struct hostapd_data *hapd)
+{
+	bool links_changed;
+
+	if (!hapd->conf->mld_ap || !hapd->mld ||
+	    hapd->mld->adv_ttlm_state == HOSTAPD_ADV_TTLM_NONE)
+		return;
+
+	wpa_printf(MSG_DEBUG, "MLD: Advertised TTLM ended, link_id=%u stopped",
+		   hapd->mld_link_id);
+
+	links_changed =
+		hapd->mld->adv_ttlm_state == HOSTAPD_ADV_TTLM_ESTABLISHED;
+	hostapd_adv_ttlm_clear(hapd);
+	hostapd_adv_ttlm_update(hapd, links_changed);
+}
+
+
+static void hostapd_adv_ttlm_started(struct hostapd_data *hapd,
+				     struct adv_ttlm *adv_ttlm)
+{
+	hapd = hostapd_mld_get_link_bss(hapd, adv_ttlm->link_id);
+	if (!hapd)
+		return;
+
+	hapd->adv_ttlm_started = true;
+	hapd->adv_ttlm_switch_tsf = adv_ttlm->switch_tsf;
+	hapd->adv_ttlm_tbtt_valid = adv_ttlm->tbtt_valid;
+	if (adv_ttlm->tbtt_valid)
+		hostapd_reltime_ago(&hapd->adv_ttlm_tbtt,
+				    adv_ttlm->tbtt_age_us);
+	if (hapd->started && hapd->beacon_set_done)
+		ieee802_11_set_beacon(hapd);
+}
+
+
+void hostapd_adv_ttlm_event(struct hostapd_data *hapd,
+			    struct adv_ttlm *adv_ttlm)
+{
+	struct hostapd_mld *mld = hapd->mld;
+	bool links_changed;
+
+	if (!hapd->conf->mld_ap || !mld ||
+	    mld->adv_ttlm_state == HOSTAPD_ADV_TTLM_NONE ||
+	    adv_ttlm->cookie != mld->adv_ttlm_cookie)
+		return;
+
+	links_changed = adv_ttlm->step == ADV_TTLM_ESTABLISHED ||
+		mld->adv_ttlm_state == HOSTAPD_ADV_TTLM_ESTABLISHED;
+
+	switch (adv_ttlm->step) {
+	case ADV_TTLM_STARTED:
+		if (mld->adv_ttlm_state == HOSTAPD_ADV_TTLM_REQUESTED)
+			hostapd_adv_ttlm_started(hapd, adv_ttlm);
+		return;
+	case ADV_TTLM_ESTABLISHED:
+		if (mld->adv_ttlm_state != HOSTAPD_ADV_TTLM_REQUESTED)
+			return;
+
+		if (adv_ttlm->tbtt_valid)
+			hostapd_reltime_ago(&mld->adv_ttlm_established,
+					    adv_ttlm->tbtt_age_us);
+		else
+			os_get_reltime(&mld->adv_ttlm_established);
+		mld->adv_ttlm_state = HOSTAPD_ADV_TTLM_ESTABLISHED;
+		break;
+	case ADV_TTLM_ENDED:
+		hostapd_adv_ttlm_clear(hapd);
+		break;
+	}
+
+	wpa_printf(MSG_DEBUG, "MLD: Advertised TTLM %s, links=0x%x",
+		   mld->adv_ttlm_state == HOSTAPD_ADV_TTLM_NONE ?
+		   "ended" : "established", mld->adv_ttlm_links);
+
+	hostapd_adv_ttlm_update(hapd, links_changed);
+}
+
 #endif /* CONFIG_IEEE80211BE */
 
 
