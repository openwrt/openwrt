+
 size_t hostapd_eid_eht_ml_tid_to_link_map_len(struct hostapd_data *hapd)
 {
 	if (!hapd->conf->mld_ap)
 		return 0;
 
+	/* Control, Mapping Switch Time, Expected Duration, 8 link mappings.
+	 * Whether the element is present depends on the frame and the time. */
+	if (hapd->mld && hapd->mld->adv_ttlm_state != HOSTAPD_ADV_TTLM_NONE)
+		return 3 + 2 + 2 + 3 + 8 * 2;
+
 #ifdef CONFIG_TESTING_OPTIONS
 	/*
 	 * Allocate enough space for mld_indicate_disabled. i.e.:
@@ -2850,7 +2901,8 @@ size_t hostapd_eid_eht_ml_tid_to_link_ma
 }
 
 
-u8 * hostapd_eid_eht_ml_tid_to_link_map(struct hostapd_data *hapd, u8 *eid)
