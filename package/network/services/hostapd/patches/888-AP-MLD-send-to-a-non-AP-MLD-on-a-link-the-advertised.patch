From: Felix Fietkau <nbd@nbd.name>
Date: Thu, 29 Oct 2026 14:36:37 +0100
Subject: [PATCH] AP MLD: send to a non-AP MLD on a link the advertised TTLM
 enables

hostapd sends the EAPOL frames and the Management frames of an
associated non-AP MLD on the link of the hapd that sends them, mostly
the association link, and the Action frames on the frequency of that
link. An established advertised TID-to-link mapping can disable that
link. IEEE Std 802.11be-2024, 35.3.7.2.1: "If a link is disabled for a
non-AP MLD, it shall not be used for individually addressed frame
exchange ..., including Management and Control frames". A non-AP MLD
that associated through such a link suspends it (35.3.7.2.1,
35.3.7.2.4) and misses message 3 of the 4-way handshake, so the
association fails.

A negotiated mapping disables links in the same way. Send such a frame
on the link of the hapd where the mappings enable it, else on the first
setup link of the station that the established advertised mapping and
the negotiated mapping enable: the EAPOL frames before the
station is authorized and the frames of hostapd_drv_send_mlme(),
hostapd_drv_sta_deauth() and hostapd_drv_sta_disassoc() with that link,
and the Action frames on its frequency, since mac80211 sends a frame to
an MLO station on the link whose channel is the frequency of the frame.
A station that is not yet associated keeps the link of its frame
exchange, and a frame from the address of a link stays on that link,
since mac80211 sends it nowhere else without a remain-on-channel.

Signed-off-by: Felix Fietkau <nbd@nbd.name>

--- a/src/ap/ap_drv_ops.c
+++ b/src/ap/ap_drv_ops.c
@@ -938,8 +938,16 @@ int hostapd_drv_send_mlme(struct hostapd
 	int link_id = -1;
 
 #ifdef CONFIG_IEEE80211BE
-	if (hapd->conf->mld_ap)
-		link_id = hapd->mld_link_id;
+	if (hapd->conf->mld_ap) {
+		const struct ieee80211_hdr *hdr = msg;
+		struct sta_info *sta = NULL;
+
+		/* A link address binds the frame to its link */
+		if (len >= IEEE80211_HDRLEN &&
+		    ether_addr_equal(hdr->addr2, hapd->mld->mld_addr))
+			sta = ap_get_sta(hapd, hdr->addr1);
+		link_id = hostapd_mld_sta_tx_link_id(hapd, sta);
+	}
 #endif /* CONFIG_IEEE80211BE */
 
 	if (!hapd->driver || !hapd->driver->send_mlme || !hapd->drv_priv)
@@ -960,7 +968,7 @@ int hostapd_drv_sta_deauth(struct hostap
 	if (hapd->conf->mld_ap) {
 		struct sta_info *sta = ap_get_sta(hapd, addr);
 
-		link_id = hapd->mld_link_id;
+		link_id = hostapd_mld_sta_tx_link_id(hapd, sta);
 		if (ap_sta_is_mld(hapd, sta))
 			own_addr = hapd->mld->mld_addr;
 	}
@@ -983,7 +991,7 @@ int hostapd_drv_sta_disassoc(struct host
 	if (hapd->conf->mld_ap) {
 		struct sta_info *sta = ap_get_sta(hapd, addr);
 
-		link_id = hapd->mld_link_id;
+		link_id = hostapd_mld_sta_tx_link_id(hapd, sta);
 		if (ap_sta_is_mld(hapd, sta))
 			own_addr = hapd->mld->mld_addr;
 	}
@@ -1084,6 +1092,9 @@ static int hapd_drv_send_action(struct h
 		bssid = wildcard_bssid;
 #ifdef CONFIG_IEEE80211BE
 	} else if (hapd->conf->mld_ap) {
+		struct hostapd_data *link_bss = NULL;
+		int tx_link_id;
+
 		sta = ap_get_sta(hapd, dst);
 
 		if (ap_sta_is_mld(hapd, sta)) {
@@ -1091,9 +1102,17 @@ static int hapd_drv_send_action(struct h
 			bssid = own_addr;
 		}
 
+		tx_link_id = hostapd_mld_sta_tx_link_id(hapd, sta);
 		if (!hostapd_is_action_frame_link_agnostic(data[0], data[1]) ||
 		    (sta && !ap_sta_is_mld(hapd, sta)))
-			link_id = hapd->mld_link_id;
+			link_id = tx_link_id;
+
+		/* The driver sends on the link whose channel is the frequency
+		 * of the frame, also with a link ID */
+		if (tx_link_id != hapd->mld_link_id)
+			link_bss = hostapd_mld_get_link_bss(hapd, tx_link_id);
+		if (link_bss)
+			freq = link_bss->iface->freq;
 #endif /* CONFIG_IEEE80211BE */
 	}
 
--- a/src/ap/ieee802_11.h
+++ b/src/ap/ieee802_11.h
@@ -337,6 +337,8 @@ void hostapd_link_reconf_resp_tx_status(
 					const struct ieee80211_mgmt *mgmt,
 					size_t len, int ok);
 u16 hostapd_mld_neg_ttlm_capa(struct hostapd_data *hapd);
+int hostapd_mld_sta_tx_link_id(struct hostapd_data *hapd,
+			       struct sta_info *sta);
 void hostapd_neg_ttlm_resp_tx_status(struct hostapd_data *hapd,
 				     struct sta_info *sta,
 				     const struct ieee80211_mgmt *mgmt,
--- a/src/ap/ieee802_11_eht.c
+++ b/src/ap/ieee802_11_eht.c
@@ -2913,6 +2913,10 @@ static u16 hostapd_sta_setup_links(struc
 }
 
 
+/* The link of an individually addressed frame to an associated non-AP MLD:
+ * one that the established advertised TTLM enables, since a disabled link
+ * carries no individually addressed frame (IEEE Std 802.11be-2024,
+ * 35.3.7.2.1) */
 static u16 hostapd_neg_ttlm_links(const struct eht_neg_ttlm *ttlm)
 {
 	u16 links = 0;
@@ -2925,6 +2929,37 @@ static u16 hostapd_neg_ttlm_links(const
 }
 
 
+int hostapd_mld_sta_tx_link_id(struct hostapd_data *hapd,
+			       struct sta_info *sta)
+{
+	struct hostapd_data *assoc_hapd;
+	struct sta_info *assoc_sta;
+	u16 links;
+	int link_id;
+
+	if (!sta || !(sta->flags & (WLAN_STA_ASSOC | WLAN_STA_AUTH)) ||
+	    !ap_sta_is_mld(hapd, sta))
+		return hapd->mld_link_id;
+
+	links = hostapd_sta_setup_links(sta);
+	if (hapd->mld->adv_ttlm_state == HOSTAPD_ADV_TTLM_ESTABLISHED)
+		links &= hapd->mld->adv_ttlm_links;
+	assoc_sta = hostapd_ml_get_assoc_sta(hapd, sta, &assoc_hapd);
+	if (assoc_sta && assoc_sta->neg_ttlm_valid)
+		links &= hostapd_neg_ttlm_links(&assoc_sta->neg_ttlm);
+
+	if (links & BIT(hapd->mld_link_id))
+		return hapd->mld_link_id;
+
+	for (link_id = 0; link_id < MAX_NUM_MLD_LINKS; link_id++) {
+		if (links & BIT(link_id))
+			return link_id;
+	}
+
+	return hapd->mld_link_id;
+}
+
+
 /* The map of one TID: setup links of the station alone, none that an
  * advertised mapping disables for all TIDs (35.3.7.2.4), and with support
  * value 1 the map of TID 0 for every TID (35.3.7.2.3) */
--- a/src/ap/ieee802_1x.c
+++ b/src/ap/ieee802_1x.c
@@ -98,7 +98,8 @@ static void ieee802_1x_send(struct hosta
 		int link_id = -1;
 
 #ifdef CONFIG_IEEE80211BE
-		link_id = hapd->conf->mld_ap ? hapd->mld_link_id : -1;
+		if (hapd->conf->mld_ap)
+			link_id = hostapd_mld_sta_tx_link_id(hapd, sta);
 #endif /* CONFIG_IEEE80211BE */
 		hostapd_drv_hapd_send_eapol(
 			hapd, sta->addr, buf, len,
--- a/src/ap/wpa_auth_glue.c
+++ b/src/ap/wpa_auth_glue.c
@@ -730,6 +730,8 @@ int hostapd_wpa_auth_send_eapol(void *ct
 		if (ap_sta_is_mld(hapd, sta) &&
 		    (sta->flags & WLAN_STA_AUTHORIZED))
 			link_id = -1;
+		else if (hapd->conf->mld_ap)
+			link_id = hostapd_mld_sta_tx_link_id(hapd, sta);
 #endif /* CONFIG_IEEE80211BE */
 	}
 
