#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0

START=35
STOP=85
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/gpond
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger gpon
}

reload_service() {
	procd_send_signal gpond '*' HUP
}
