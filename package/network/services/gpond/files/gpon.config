# AN7552/AN7563 GPON configuration - read by gpond (/etc/init.d/gpond reload
# or "ubus call gpon reload").

config global 'global'
	option enabled '1'
	# 1: gpond writes /etc/config/gpon only; the network, omcproxy and
	# easycwmp sections OMCI asks for are logged and left to the admin
	#option own_config_only '0'
	#option sn 'ABCD12345678'
	#option password ''

config onu 'onu'
	option vendor_id 'AIRO'
	option version 'AN7563'
	option equipment_id 'AN7563-ONU'
	option omcc_version '0xa0'
	# version of the running image; sw_version0 and sw_version1 name a
	# slot directly and take precedence.  An empty inactive slot is
	# reported (ME 7) with the running version as its backup copy; no
	# image is copied on flash.
	option sw_version 'V1.0.0'
	option sw_store '0'
	option reboot_mode '0'
	option setup_cwmp '0'
	# Optional physical UNI port to bridge with PON (e.g. lan3 for IPTV)
	#list uni_dev 'lan3'
	# Drop the multicast GEM port in the MAC while no IPTV group has a
	# listener here (bridge MDB / socket membership on pon0 and the
	# devices on top of it); the OLT sends every ONU the groups of the
	# whole tree.  '0' keeps it open.
	#option mcast_gate '1'
