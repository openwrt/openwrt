# AN7552/AN7563 GPON configuration - read by gpond

config global 'global'
	option enabled '1'
	# 1: gpond writes /etc/config/gpon only, nothing to network, omcproxy
	# or easycwmp.  The data path is still brought up: the bridges and
	# VLAN devices the OLT asks for that are missing from the system are
	# made at run time (ifalias "gpond ...", removed when the OLT drops
	# them; a device that exists and is not gpond's is never touched, a
	# port of another bridge stays there).  IP/VEIP interfaces with DHCP,
	# UNI speed/MTU/lock and the IGMP proxy are only logged
	# (logread -e gpond), so the admin decides what to copy.
	# 0: (the default) gpond writes those sections itself (comment "gpond *")
	# and reloads netifd; it never touches the firewall.
	option own_config_only '0'
	#option sn 'ABCD12345678'
	#option password ''

config onu 'onu'
	option vendor_id 'AIRO'
	option version 'AN7563'
	option equipment_id 'AN7563-ONU'
	option omcc_version '0xa0'
	option reboot_mode '0'
	option setup_cwmp '0'
	# Optional physical UNI port to bridge with PON (e.g. lan4 for IPTV)
	#list uni_dev 'lan4'
	# 1 (the default): drop the multicast GEM port if nobody listens for it.
	# 0: gate is open all the time
	#option mcast_gate '1'
