# modemsignal-leds - drive cellular signal-strength LEDs from modem RSSI.
#
# With NO 'config modem' section below, the service auto-discovers the LEDs of
# a single modem and polls the first ncm/qmi/mbim network interface. It looks
# for a same-colour set named <color>:signal<N>, <color>:rssi<N> or
# <color>:mobile[-<N>], sorted by index: one LED becomes a connection
# indicator (status), a set becomes a signal bar graph.
#
# LEDs that already have a job in /etc/config/system (a netdev, switch,
# usbport or rssi trigger, or your own assignment) are never taken, so a board
# running rssileds for wireless keeps its display.
#
# Nothing is started when no modem interface exists. A mixed-colour set is
# ambiguous, and so is <color>:mobile-<N> on a multi-modem device, where the
# index is the module and not a level; both need an explicit config below.
#
# Configure explicitly to override, or for multi-modem devices:
#
# config modem 'wwan'
#     option interface 'wwan'       # netif to derive backend + device from
#     option backend   'auto'       # auto | at | qmi | mbim
#     option device    '/dev/ttyUSB2'  # control node (when backend != auto)
#     option mode      'bars'       # bars (signal graph) | status (1 indicator)
#     option refresh   '10'         # poll interval, seconds
#
# config led
#     option modem 'wwan'
#     option sysfs 'green:mobile-1'
#     option min   '0'              # optional quality window; auto-distributed
#     option max   '33'             #   across the modem's LEDs when unset
