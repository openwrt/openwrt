# JRD modem profiles
#
# The default profile is used when an interface with "option proto 'jrd'"
# does not explicitly set "option profile" in /etc/config/network.
#
# Interface-specific values in /etc/config/network override values from the
# selected profile.

config globals 'globals'
	option default_profile 'hh70'

config profile 'hh70'
	option label 'Alcatel HH70'
	option modem_ip '192.168.225.1'
	option port '2016'
	option local_ip '192.168.225.111'
	option prefix '24'
	option gateway '192.168.225.1'

	# HH70 front-panel LAN indication is controlled by the JRD/modem side.
	# jrd-modem mirrors this logical OpenWrt interface's up/down state using
	# ethWanStatus {"ethlan_status":...}. Override per JRD interface if needed.
	option ethernet_interface 'wan'

	# Optional protocol timing overrides. If omitted, jrd-modem uses the
	# generic defaults shown below.
	# option rpc_timeout '3'
	# option timeout '30'

# Per-interface options belong in /etc/config/network, for example:
#
# config interface 'wwan'
#	option device 'usb0'
#	option proto 'jrd'
#
#	# Optional profile selection. If omitted, default_profile above is used.
#	# option profile 'hh70'
#
#	# Any modem-profile value may be overridden for this interface.
#	# option modem_ip '192.168.225.1'
#	# option port '2016'
#	# option local_ip '192.168.225.111'
#	# option prefix '24'
#	# option gateway '192.168.225.1'
#	# option ethernet_interface 'wan'
#	# option rpc_timeout '3'
#	# option timeout '30'
#
#	# Normal netifd route/DNS controls understood by the JRD protocol.
#	# option defaultroute '1'
#	# option metric '0'
#	# option peerdns '1'
#	# list dns '1.1.1.1'
#	# list dns '8.8.8.8'
#
# Cellular/PDP profile settings are deliberately not changed by jrd-modem yet.
# If no APN-related options are configured, the modem's existing profile is
# left untouched and Connect uses the modem's own automatic/default behavior.
# This is known to work on the HH70 with a blank APN profile.
#
# The stock HH70 web application confirms these profile RPC methods:
#
#	GetProfileList
#	getCurrentProfile
#	EditProfile
#	AddNewProfile
#	DeleteProfile
#	SetDefaultProfile
#
# It also confirms the profile fields ProfileID, ProfileName, APN, UserName,
# Password, AuthType, DailNumber (stock spelling) and PdpType. Known enums:
#
#	AuthType: 0 = none, 1 = PAP, 2 = CHAP, 3 = PAP & CHAP
#	PdpType:  0 = IPv4, 2 = IPv6, 3 = IPv4v6
#
# Intended future per-interface UCI names are shown below. They are documentation
# only in this release and setting them has no effect yet.
#
#	# option data_profile '1'
#	# option apn 'internet'
#	# option dial_number '*99#'
#	# option auth_type '0'
#	# option username 'user'
#	# option password 'pass'
#	# option pdp_type '0'
#
# Keeping these unset preserves automatic modem APN/profile selection.
