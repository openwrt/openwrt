From: Julius Bairaktaris <julius@bairaktaris.de>
Subject: [PATCH] tc: cake: add ce_threshold and ce_threshold_selector

Expose CAKE's L4S marking, with the same syntax as fq_codel:
ce_threshold TIME marks CE on packets that queued longer, on a ramp up
to twice that, and ce_threshold_selector VALUE/MASK limits that to
packets whose DS field matches, e.g. 0x01/0x03 for ECT(1). Each option
is sent whenever it is given, so ce_threshold 0 and
ce_threshold_selector 0/0 turn them off on a change. The per-tin count
of these marks is printed as ce_thr.

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
---
--- a/include/uapi/linux/pkt_sched.h
+++ b/include/uapi/linux/pkt_sched.h
@@ -1014,6 +1014,9 @@
 	TCA_CAKE_ACK_FILTER,
 	TCA_CAKE_SPLIT_GSO,
 	TCA_CAKE_FWMARK,
+	TCA_CAKE_CE_THRESHOLD,
+	TCA_CAKE_CE_THRESHOLD_SELECTOR,
+	TCA_CAKE_CE_THRESHOLD_MASK,
 	__TCA_CAKE_MAX
 };
 #define TCA_CAKE_MAX	(__TCA_CAKE_MAX - 1)
@@ -1067,6 +1070,7 @@
 	TCA_CAKE_TIN_STATS_UNRESPONSIVE_FLOWS,
 	TCA_CAKE_TIN_STATS_MAX_SKBLEN,
 	TCA_CAKE_TIN_STATS_FLOW_QUANTUM,
+	TCA_CAKE_TIN_STATS_CE_THRESHOLD_MARKS,
 	__TCA_CAKE_TIN_STATS_MAX
 };
 #define TCA_CAKE_TIN_STATS_MAX (__TCA_CAKE_TIN_STATS_MAX - 1)
--- a/tc/q_cake.c
+++ b/tc/q_cake.c
@@ -83,6 +83,8 @@
 		"                [ ack-filter | ack-filter-aggressive | no-ack-filter* ]\n"
 		"                [ memlimit LIMIT ]\n"
 		"                [ fwmark MASK ]\n"
+		"                [ ce_threshold TIME ]\n"
+		"                [ ce_threshold_selector VALUE/MASK ]\n"
 		"                [ ptm | atm | noatm* ] [ overhead N | conservative | raw* ]\n"
 		"                [ mpu N ] [ ingress | egress* ]\n"
 		"                (* marks defaults)\n");
@@ -99,6 +101,9 @@
 	unsigned int memlimit = 0;
 	unsigned int fwmark = 0;
 	unsigned int target = 0;
+	unsigned int ce_threshold = ~0U;
+	__u8 ce_threshold_selector = 0xFF;
+	__u8 ce_threshold_mask = 0;
 	__u64 bandwidth = 0;
 	int ack_filter = -1;
 	struct rtattr *tail;
@@ -340,6 +345,30 @@
 					"Illegal value for \"fwmark\": \"%s\"\n", *argv);
 				return -1;
 			}
+		} else if (strcmp(*argv, "ce_threshold") == 0) {
+			NEXT_ARG();
+			if (get_time(&ce_threshold, *argv)) {
+				fprintf(stderr, "Illegal \"ce_threshold\"\n");
+				return -1;
+			}
+		} else if (strcmp(*argv, "ce_threshold_selector") == 0) {
+			char *sep;
+
+			NEXT_ARG();
+			sep = strchr(*argv, '/');
+			if (!sep) {
+				fprintf(stderr, "Missing mask for \"ce_threshold_selector\"\n");
+				return -1;
+			}
+			*sep++ = '\0';
+			if (get_u8(&ce_threshold_mask, sep, 0)) {
+				fprintf(stderr, "Illegal mask for \"ce_threshold_selector\"\n");
+				return -1;
+			}
+			if (get_u8(&ce_threshold_selector, *argv, 0)) {
+				fprintf(stderr, "Illegal \"ce_threshold_selector\"\n");
+				return -1;
+			}
 		} else if (strcmp(*argv, "help") == 0) {
 			explain();
 			return -1;
@@ -387,6 +416,15 @@
 	if (fwmark)
 		addattr_l(n, 1024, TCA_CAKE_FWMARK, &fwmark,
 			  sizeof(fwmark));
+	if (ce_threshold != ~0U)
+		addattr_l(n, 1024, TCA_CAKE_CE_THRESHOLD, &ce_threshold,
+			  sizeof(ce_threshold));
+	if (ce_threshold_selector != 0xFF) {
+		addattr8(n, 1024, TCA_CAKE_CE_THRESHOLD_SELECTOR,
+			 ce_threshold_selector);
+		addattr8(n, 1024, TCA_CAKE_CE_THRESHOLD_MASK,
+			 ce_threshold_mask);
+	}
 	if (nat != -1)
 		addattr_l(n, 1024, TCA_CAKE_NAT, &nat, sizeof(nat));
 	if (wash != -1)
@@ -578,6 +616,23 @@
 		print_uint(PRINT_FP, NULL, "fwmark 0x%x ", fwmark);
 	print_0xhex(PRINT_JSON, "fwmark", NULL, fwmark);
 
+	if (tb[TCA_CAKE_CE_THRESHOLD] &&
+	    RTA_PAYLOAD(tb[TCA_CAKE_CE_THRESHOLD]) >= sizeof(__u32)) {
+		__u32 ce = rta_getattr_u32(tb[TCA_CAKE_CE_THRESHOLD]);
+
+		print_uint(PRINT_JSON, "ce_threshold", NULL, ce);
+		print_string(PRINT_FP, NULL, "ce_threshold %s ",
+			     sprint_time(ce, b2));
+	}
+	if (tb[TCA_CAKE_CE_THRESHOLD_SELECTOR] &&
+	    tb[TCA_CAKE_CE_THRESHOLD_MASK]) {
+		print_0xhex(PRINT_ANY, "ce_threshold_selector",
+			    "ce_threshold_selector %#x",
+			    rta_getattr_u8(tb[TCA_CAKE_CE_THRESHOLD_SELECTOR]));
+		print_0xhex(PRINT_ANY, "ce_threshold_mask", "/%#x ",
+			    rta_getattr_u8(tb[TCA_CAKE_CE_THRESHOLD_MASK]));
+	}
+
 	return 0;
 }
 
@@ -603,6 +658,7 @@
 	PRINT_TSTAT_JSON(u32, "way_collisions", WAY_COLLISIONS);
 	PRINT_TSTAT_JSON(u32, "drops", DROPPED_PACKETS);
 	PRINT_TSTAT_JSON(u32, "ecn_mark", ECN_MARKED_PACKETS);
+	PRINT_TSTAT_JSON(u32, "ce_threshold_marks", CE_THRESHOLD_MARKS);
 	PRINT_TSTAT_JSON(u32, "ack_drops", ACKS_DROPPED_PACKETS);
 	PRINT_TSTAT_JSON(u32, "sparse_flows", SPARSE_FLOWS);
 	PRINT_TSTAT_JSON(u32, "bulk_flows", BULK_FLOWS);
@@ -805,6 +861,7 @@
 		PRINT_TSTAT_U32("  way_cols", WAY_COLLISIONS);
 		PRINT_TSTAT_U32("  drops   ", DROPPED_PACKETS);
 		PRINT_TSTAT_U32("  marks   ", ECN_MARKED_PACKETS);
+		PRINT_TSTAT_U32("  ce_thr  ", CE_THRESHOLD_MARKS);
 		PRINT_TSTAT_U32("  ack_drop", ACKS_DROPPED_PACKETS);
 		PRINT_TSTAT_U32("  sp_flows", SPARSE_FLOWS);
 		PRINT_TSTAT_U32("  bk_flows", BULK_FLOWS);
