config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'auto'

# Bridge for LAN — eth0 + wifi AP
config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

# WAN — eth1 (GMAC1/fixed-link, connects to LAN9500A USB-ethernet)
config interface 'wan'
	option device 'eth1'
	option proto 'dhcp'

config interface 'wan6'
	option device 'eth1'
	option proto 'dhcpv6'

# batman-adv mesh overlay
config interface 'mesh'
	option proto 'batadv'
	option mesh 'bat0'

# 802.11s wireless mesh link (bridged into bat0)
config interface 'wmesh'
	option device 'wlan0'
	option proto 'batadv_hardif'
	option master 'bat0'
