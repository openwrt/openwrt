#!/bin/sh /etc/rc.common
# Link state polling daemon.
# Runs linkstate.uc one-shot; procd respawn handles the interval.
START=96
USE_PROCD=1

service_triggers() {
	procd_add_reload_trigger linkstate
}

start_service() {
	. /lib/functions.sh
	config_load linkstate
	local interval
	config_get interval linkstate interval 2

	procd_open_instance
	procd_set_param command /usr/bin/linkstate.uc 0
	procd_set_param respawn 1 "$interval" 0
	procd_close_instance
}
