#!/bin/sh /etc/rc.common
# Sends MAVLink RADIO_STATUS with RSSI from linkstate ubus events.
START=98
USE_PROCD=1

start_service() {
	local enabled
	config_load mavlink
	config_get enabled settings rssi_enabled 0
	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/mavlink-rssi.uc
	procd_set_param respawn
	procd_close_instance
}
