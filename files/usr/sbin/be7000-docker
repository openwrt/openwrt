#!/bin/sh
# 在此路由器上设置 Docker。
#
# 这里容易踩坑的地方是镜像存放位置。dockerd 默认把 data-root 设为
# /opt/docker，它位于 overlay 上：在这块板子上约 19 MB，如果备用分区
# 留给了原厂固件则只有 7 MB。一个镜像就能填满。因此本脚本选择一个真实
# 磁盘，让 dockerd 指向它。
#
# 用法：
#   be7000-docker status
#   be7000-docker setup [--data-root /mnt/sda1/docker] [--yes]
#   be7000-docker portainer [--yes]

set -e

PKGS="dockerd docker docker-compose luci-app-dockerman"
MIN_FREE_MB=1024

die() { echo "$*" >&2; exit 1; }

# 消息跟随 LuCI 语言：zh* 用中文，en* 用英文，其他回退到中文
L=zh
case "$(uci -q get luci.main.lang)" in
	en*) L=en ;;
	zh*) L=zh ;;
	*)   L=zh ;;
esac
# t <中文> <英文>
t() { [ "$L" = en ] && echo "$2" || echo "$1"; }

data_root_now() {
	uci -q get dockerd.globals.data_root || echo "/opt/docker/"
}

free_mb_of() {
	local path="$1"
	while [ ! -d "$path" ] && [ "$path" != "/" ]; do path="$(dirname "$path")"; done
	df -m "$path" 2>/dev/null | awk 'NR==2 { print $4 }'
}

installed() {
	command -v dockerd >/dev/null 2>&1
}

# 一个已挂载的、不是根文件系统且有足够空间的磁盘。
suggest_data_root() {
	local dev mp free
	mount | while read -r dev _ mp _; do
		case "$dev" in /dev/sd*|/dev/mmcblk*) ;; *) continue ;; esac
		case "$mp" in /|/rom|/overlay|/tmp) continue ;; esac
		free="$(free_mb_of "$mp")"
		[ -n "$free" ] && [ "$free" -ge "$MIN_FREE_MB" ] && { echo "$mp/docker"; return 0; }
	done
	return 1
}

cmd_status() {
	if installed; then
		echo "dockerd: $(t "已安装" "installed"), $(dockerd --version 2>/dev/null | head -1)"
	else
		echo "dockerd: $(t "未安装" "not installed")"
	fi
	local dr free
	dr="$(data_root_now)"
	free="$(free_mb_of "$dr")"
	echo "$(t "数据目录" "data"): $dr"
	echo "$(t "该处可用空间：${free:-?} MB" "free there: ${free:-?} MB")"
	if [ -n "$free" ] && [ "$free" -lt "$MIN_FREE_MB" ]; then
		echo
		t "这太少了。Docker 镜像动辄数百 MB。" "That is not enough. Docker images take hundreds of megabytes."
		t "请连接磁盘并运行：be7000-docker setup" "Plug in a disk and run: be7000-docker setup"
	fi
	echo
	echo "$(t "服务" "service"): $(/etc/init.d/dockerd status 2>/dev/null || t '未运行' 'not running')"
}

cmd_setup() {
	local want="$1" yes="$2" dr free

	if [ -n "$want" ]; then
		dr="$want"
	else
		dr="$(suggest_data_root)" || die "$(t "未找到已连接的、可用空间至少 ${MIN_FREE_MB} MB 的磁盘。
请连接磁盘、挂载它并指定路径：be7000-docker setup --data-root /mnt/sda1/docker" "No mounted disk with at least ${MIN_FREE_MB} MB free found.
Plug in a disk, mount it and give the path: be7000-docker setup --data-root /mnt/sda1/docker")"
	fi

	free="$(free_mb_of "$dr")"
	[ -n "$free" ] || die "$(t "无法确定 $dr 的可用空间" "Could not find out the free space for $dr")"
	if [ "$free" -lt "$MIN_FREE_MB" ]; then
		t "总共只有 ${free} MB 可用，这对 Docker 来说太少了。" "Only ${free} MB free, that is not enough for Docker." >&2
		[ "$yes" = 1 ] || die "$(t "如果确定，请加上 --yes 重试" "If you are sure, repeat with --yes")"
	fi

	if [ "$yes" != 1 ]; then
		echo "$(t "将安装" "Will install"): $PKGS"
		t "Docker 数据将存放在：$dr（可用 ${free} MB）" "Docker data will live in: $dr (${free} MB free)"
		t "请加上 --yes 以执行。" "Repeat with --yes to do it."
		exit 1
	fi

	if ! installed; then
		t "正在安装软件包" "Installing packages"
		apk update >/dev/null 2>&1 || true
		# shellcheck disable=SC2086
		apk add $PKGS || die "$(t "无法安装软件包。请检查 apk update。" "Could not install the packages. Check apk update.")"
	fi

	mkdir -p "$dr"
	t "正在设置 data-root" "Setting data-root"
	uci -q set dockerd.globals.data_root="$dr"
	uci -q commit dockerd

	/etc/init.d/dockerd enable >/dev/null 2>&1 || true
	/etc/init.d/dockerd restart

	echo
	t "完成。在 LuCI 中管理：服务，Dockerman。" "Done. Manage it in LuCI: Services, Dockerman."
	t "那里有容器、镜像、网络、卷、日志以及进入容器的控制台。" "Containers, images, networks, volumes, logs and a console into containers are there."
}

cmd_portainer() {
	local yes="$1"
	installed || die "$(t "请先运行 be7000-docker setup" "Run be7000-docker setup first")"
	if [ "$yes" != 1 ]; then
		t "将以容器方式启动 Portainer CE，Web 界面在 https 的 9443 端口。" "Will start Portainer CE as a container, web interface on port 9443 over https."
		t "这是 Docker 之上的独立界面，支持堆栈和 compose。" "It is a separate interface on top of Docker, with stacks and compose."
		t "请加上 --yes 重试。" "Repeat with --yes."
		exit 1
	fi
	docker volume create portainer_data >/dev/null
	docker run -d --name portainer --restart=always \
		-p 9443:9443 \
		-v /var/run/docker.sock:/var/run/docker.sock \
		-v portainer_data:/data \
		portainer/portainer-ce:latest
	t "Portainer 已启动。请打开 https://<路由器地址>:9443 并设置密码。" "Portainer is up. Open https://<router address>:9443 and set a password."
}

ACTION="$1"
[ $# -gt 0 ] && shift
YES=0; DR=""
while [ $# -gt 0 ]; do
	case "$1" in
	--yes) YES=1 ;;
	--data-root) shift; DR="$1" ;;
	*) ;;
	esac
	shift
done

case "$ACTION" in
status)    cmd_status ;;
setup)     cmd_setup "$DR" "$YES" ;;
portainer) cmd_portainer "$YES" ;;
*)
	echo "用法：be7000-docker {status|setup [--data-root PATH] [--yes]|portainer [--yes]}"
	exit 1
	;;
esac
