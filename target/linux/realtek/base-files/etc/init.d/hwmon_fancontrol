#!/bin/sh /etc/rc.common

START=18

plasmacloud_common() {
	# configuring onboard temp/fan controller to run the fan on its own
	# for more information, please read https://www.kernel.org/doc/Documentation/hwmon/sysfs-interface

	local path_to_hwmon="$(find /sys/bus/i2c/devices/4-002e/hwmon/ -type d -maxdepth 1 -mindepth 1 -name 'hwmon*')"

	# adt7476 fan control chip
	# 3 temp sensors. Set to lowest speed at 35C and max speed at 70C
	# set critical temp to 80 as per the datasheet
	echo 7 > "$path_to_hwmon/pwm2_auto_channels_temp"
	echo 1 > "$path_to_hwmon/pwm2_auto_point1_pwm"
	echo 255 > "$path_to_hwmon/pwm2_auto_point2_pwm"
	echo 22500 > "$path_to_hwmon/pwm2_freq"

	echo 80000 > "$path_to_hwmon/temp1_crit"
	echo 80000 > "$path_to_hwmon/temp2_crit"
	echo 80000 > "$path_to_hwmon/temp3_crit"

	echo 75000 > "$path_to_hwmon/temp1_crit_hyst"
	echo 75000 > "$path_to_hwmon/temp2_crit_hyst"
	echo 75000 > "$path_to_hwmon/temp3_crit_hyst"

	echo 50000 > "$path_to_hwmon/temp1_auto_point1_temp"
	echo 50000 > "$path_to_hwmon/temp2_auto_point1_temp"
	echo 50000 > "$path_to_hwmon/temp3_auto_point1_temp"

	echo 70000 > "$path_to_hwmon/temp1_auto_point2_temp"
	echo 70000 > "$path_to_hwmon/temp2_auto_point2_temp"
	echo 70000 > "$path_to_hwmon/temp3_auto_point2_temp"

	echo 2 > "$path_to_hwmon/pwm2_enable"
}

dlink_dgs_1210() {
	local path_to_hwmon="$(find -L /sys/bus/i2c/devices/4-004c -type d -maxdepth 2 -mindepth 2 -name 'hwmon*' || true)"

	if [ -z "$path_to_hwmon" ]; then
		logger -t hwmon_fancontrol "LM63 hwmon interface not found on i2c 4-004c (kmod lm63 loaded?)"
		return 1
	fi

	# Set to manual mode temporarily to allow LUT and frequency setup
	echo 1 > "$path_to_hwmon/pwm1_enable"

	# Configure PWM frequency (~7826 Hz / PFR divisor 23) matching OEM defaults
	echo 7826 > "$path_to_hwmon/pwm1_freq"

	# Point 1: If temp > 0 C, set fan speed to PWM 155/255 (OEM default 0x1c)
	echo 0 > "$path_to_hwmon/pwm1_auto_point1_temp"
	echo $((0x1c * 255 / 46)) > "$path_to_hwmon/pwm1_auto_point1_pwm"

	# Point 2: If temp > 51 C, set fan speed to PWM 255/255 (OEM default 0x2e)
	echo 51000 > "$path_to_hwmon/pwm1_auto_point2_temp"
	echo $((0x2e * 255 / 46)) > "$path_to_hwmon/pwm1_auto_point2_pwm"

	# Point 3-8: Set the chip default values for unused points as reboot does not clean them
	for p in 3 4 5 6 7 8; do
		echo 127000 > "$path_to_hwmon/pwm1_auto_point${p}_temp"
		echo 255 > "$path_to_hwmon/pwm1_auto_point${p}_pwm"
	done

	# Hysteresis: Set 3 C (3000 mC) hysteresis for LUT (OEM default 0x03)
	echo 3000 > "$path_to_hwmon/pwm1_auto_point_temp_hyst"

	# Switch to hardware auto mode
	echo 2 > "$path_to_hwmon/pwm1_enable"
}

dlink_dgs_1250() {
	local path_temp_hwmon="$(find /sys/devices/platform/i2c-gpio-4/i2c-4/4-0048/hwmon/ -type d -maxdepth 1 -mindepth 1 -name 'hwmon*')"
	local path_fan_hwmon="$(find /sys/devices/platform/gpio-fan/hwmon/ -type d -maxdepth 1 -mindepth 1 -name 'hwmon*')"

	# Activate fan and let LM75 steer high/low speed via alert pin
	# vendor defaults for DGS-1250-28X are 69C low->high and 57C high->low
	echo 1 > "$path_fan_hwmon/fan1_target"
	echo 69000 > "$path_temp_hwmon/temp1_max"
	echo 57000 > "$path_temp_hwmon/temp1_max_hyst"
}

linksys_lgs328mpc_v2() {
	# The U-Boot of this device does not set up the LM63 fan controller for us, so we do it ourselves:
	# Let LM63 steer high/low speed full automatically, vendor defaults are 40C low->high and 31C high->low.
	# For this, reduce PMW frequency as otherwise the fan won't start at low speeds.
	# Temperature point 1 is set to 1C and a hysteresis of 9C gives 1C - 9C = -8C - most likely always on.
	# Temperature point 2 is set to 40C and a hysteresis of 9C gives 40C - 9C = 31C.
	# Other points must be monotonic for the kernel to accept auto mode.
	local path_to_hwmon="$(find /sys/bus/i2c/devices/0-004c/hwmon/ -type d -maxdepth 1 -mindepth 1 -name 'hwmon*')"

	[ -n "$path_to_hwmon" ] || return 0

	# switch to manual mode, otherwise LUT is not writable
	echo 1 > "$path_to_hwmon/pwm1_enable"
	# Set PWM Frequency to 22Hz as otherwise the fan doesn't spin at low duty cycles.
	echo 22 > "$path_to_hwmon/pwm1_freq"

	echo 1000  > "$path_to_hwmon/pwm1_auto_point1_temp" # 1°C
	echo 128   > "$path_to_hwmon/pwm1_auto_point1_pwm"  # 50% fan speed
	echo 40000 > "$path_to_hwmon/pwm1_auto_point2_temp" # 40°C
	echo 255   > "$path_to_hwmon/pwm1_auto_point2_pwm"  # 100% fan speed
	echo 41000 > "$path_to_hwmon/pwm1_auto_point3_temp" # monotonically increasing entries so the driver accepts this LUT
	echo 255   > "$path_to_hwmon/pwm1_auto_point3_pwm"
	echo 42000 > "$path_to_hwmon/pwm1_auto_point4_temp"
	echo 255   > "$path_to_hwmon/pwm1_auto_point4_pwm"
	echo 43000 > "$path_to_hwmon/pwm1_auto_point5_temp"
	echo 255   > "$path_to_hwmon/pwm1_auto_point5_pwm"
	echo 44000 > "$path_to_hwmon/pwm1_auto_point6_temp"
	echo 255   > "$path_to_hwmon/pwm1_auto_point6_pwm"
	echo 45000 > "$path_to_hwmon/pwm1_auto_point7_temp"
	echo 255   > "$path_to_hwmon/pwm1_auto_point7_pwm"
	echo 46000 > "$path_to_hwmon/pwm1_auto_point8_temp"
	echo 255   > "$path_to_hwmon/pwm1_auto_point8_pwm"

	# set temperature hysteresis to 9K
	echo 9000 > "$path_to_hwmon/pwm1_auto_point_temp_hyst"

	# switch to automatic, LUT driven mode
	echo 2 > "$path_to_hwmon/pwm1_enable"
}

horaco_zx_swtgw2c48ns() {
	# Locate the DT-instantiated ADT7476 without relying on dynamic bus or
	# hwmon numbering.
	local device
	local path_to_hwmon
	local candidate
	local attr
	local value

	for candidate in /sys/bus/i2c/devices/*-002c; do
		[ -e "$candidate/of_node" ] || continue
		[ "$(cat "$candidate/name" 2>/dev/null)" = "adt7476" ] || continue
		[ -z "$device" ] || {
			logger -t hwmon_fancontrol -p daemon.err \
				"multiple DT-backed ADT7476 devices found; leaving fans at power-on defaults"
			return 1
		}
		device="$candidate"
	done

	[ -n "$device" ] || {
		logger -t hwmon_fancontrol -p daemon.err \
			"DT-backed ADT7476 not found; leaving fans at power-on defaults"
		return 1
	}

	for candidate in "$device"/hwmon/hwmon*; do
		[ -d "$candidate" ] || continue
		[ "$(cat "$candidate/name" 2>/dev/null)" = "adt7476" ] || continue
		[ -z "$path_to_hwmon" ] || {
			logger -t hwmon_fancontrol -p daemon.err \
				"multiple hwmon interfaces for $device; leaving fans at power-on defaults"
			return 1
		}
		path_to_hwmon="$candidate"
	done

	[ -n "$path_to_hwmon" ] || {
		logger -t hwmon_fancontrol -p daemon.err \
			"ADT7476 hwmon interface not found; leaving fans at power-on defaults"
		return 1
	}

	# Any failure after locating the controller falls back to manual full duty.
	horaco_fan_failsafe() {
		echo 1 > "$path_to_hwmon/pwm1_enable" 2>/dev/null
		echo 255 > "$path_to_hwmon/pwm1" 2>/dev/null
		logger -t hwmon_fancontrol -p daemon.err \
			"ADT7476 setup failed; requested manual full fan duty"
		return 1
	}

	horaco_fan_write() {
		echo "$2" > "$path_to_hwmon/$1" 2>/dev/null || return 1
		value="$(cat "$path_to_hwmon/$1" 2>/dev/null)" || return 1
		[ "$value" = "$2" ]
	}

	# Do not start programming unless every control used below is available.
	for attr in \
		pwm1_enable pwm1 pwm1_auto_channels_temp pwm1_stall_disable \
		pwm1_auto_point1_pwm pwm1_auto_point2_pwm \
		temp1_auto_point1_temp temp1_auto_point2_temp temp1_crit temp1_crit_hyst \
		temp2_auto_point1_temp temp2_auto_point2_temp temp2_crit temp2_crit_hyst \
		temp3_auto_point1_temp temp3_auto_point2_temp temp3_crit temp3_crit_hyst; do
		[ -w "$path_to_hwmon/$attr" ] || {
			logger -t hwmon_fancontrol -p daemon.err \
				"required ADT7476 attribute $attr is unavailable"
			horaco_fan_failsafe
			return 1
		}
	done

	# Establish a safe manual state before changing the automatic table.
	horaco_fan_write pwm1_enable 1 || { horaco_fan_failsafe; return 1; }
	horaco_fan_write pwm1 255 || { horaco_fan_failsafe; return 1; }

	# Allow all three temperature channels to drive the fan.
	horaco_fan_write pwm1_auto_channels_temp 7 || { horaco_fan_failsafe; return 1; }

	# Keep the fan running below the control window.
	horaco_fan_write pwm1_stall_disable 1 || { horaco_fan_failsafe; return 1; }

	# Use the validated stable duty floor and full duty at the upper point.
	# Duty 40 matches the stock idle fan speed; lower duty was unstable on
	# this fan.
	horaco_fan_write pwm1_auto_point1_pwm 40 || { horaco_fan_failsafe; return 1; }
	horaco_fan_write pwm1_auto_point2_pwm 255 || { horaco_fan_failsafe; return 1; }

	# Ramp window and critical limits, per temperature channel.
	for i in 1 2 3; do
		horaco_fan_write "temp${i}_auto_point1_temp" 45000 || { horaco_fan_failsafe; return 1; }
		# ADT7475 represents the 45 C ramp span on a discrete grid; 71670
		# is the validated grid value nearest the intended 70 C endpoint.
		horaco_fan_write "temp${i}_auto_point2_temp" 71670 || { horaco_fan_failsafe; return 1; }
		horaco_fan_write "temp${i}_crit" 85000 || { horaco_fan_failsafe; return 1; }
		horaco_fan_write "temp${i}_crit_hyst" 80000 || { horaco_fan_failsafe; return 1; }
	done

	# Enter the hardware closed loop only after every setting read back cleanly.
	horaco_fan_write pwm1_enable 2 || { horaco_fan_failsafe; return 1; }
}

boot() {
	case $(board_name) in
	plasmacloud,esx28|\
	plasmacloud,psx28)
		plasmacloud_common
		;;
	d-link,dgs-1210-28p-f|\
	d-link,dgs-1210-28mp-f)
		dlink_dgs_1210
		;;
	d-link,dgs-1250-28x)
		dlink_dgs_1250
		;;
	horaco,zx-swtgw2c48ns)
		horaco_zx_swtgw2c48ns
		;;
	linksys,lgs328mpc-v2)
		linksys_lgs328mpc_v2
		;;
	esac
}
