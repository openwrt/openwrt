/dts-v1/;

#include "rtl9607c-va.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "tcl,t20-pro", "realtek,rtl8198d-soc", "realtek,rtl960x-soc";
	model = "TCL T20 Pro";

	aliases {
		led-boot = &led_red;
		led-failsafe = &led_red;
		led-running = &led_green;
		led-upgrade = &led_red;
	};

	chosen {
		bootargs = "earlycon ubi.mtd=ubi_device,2048 ubi.block=0,ubi_r1 root=/dev/ubiblock0_4";
	};

	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		key-wps {
			label = "wps";
			gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_green: led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
		};

		led_red: led-1 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio1 24 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
	};
};

&mdio_ctrl {
	PHY_C22(0, 0)
	PHY_C22(1, 1)
	PHY_C22(2, 2)
	PHY_C22(3, 3)
};

&switch0 {
	ethernet-ports {
		SWITCH_PORT(0, 1, internal)
		SWITCH_PORT(1, 2, internal)
		SWITCH_PORT(2, 3, internal)
		port@3 {
			reg = <3>;
			label = "wan";
			phy-handle = <&phy3>;
			phy-mode = "internal";
		};
	};
};

&pcie0 {
	linux,pci-domain = <0>;
	status = "okay";

	wifi@1,0 {
		compatible = "pci10ec,8852";
		reg = <0x800 0 0 0 0>;
		ieee80211-freq-limit = <4900000 5925000>;
		realtek,efuse-file = "rtw89/tcl-t20-pro-5g-efuse.bin";
	};
};

&pcie1 {
	linux,pci-domain = <1>;
	status = "okay";

	wifi@1,0 {
		compatible = "pci10ec,8852";
		reg = <0x800 0 0 0 0>;
		ieee80211-freq-limit = <2400000 2500000>;
		realtek,efuse-file = "rtw89/tcl-t20-pro-2g-efuse.bin";
	};
};

&ecc0 {
	status = "okay";
};

&snand {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&ecc0>;
		nand-ecc-strength = <6>;
		nand-ecc-step-size = <512>;
		nand-ecc-algo = "bch";
		nand-ecc-placement = "oob";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* Keep U-Boot and both environments outside Linux MTD. */
			partition@100000 {
				label = "ubi_device";
				reg = <0x100000 0x7c80000>;
			};
		};
	};
};
