#include "rtl931x.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/phy/phy.h>

/ {
	compatible = "xikestor,sks8300-12x-v2", "realtek,rtl9313-soc";
	model = "XikeStor SKS8300-12X V2";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>; /* 256 MiB */
	};

	aliases {
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_sys;
		led-upgrade = &led_sys;
	};

	leds {
		compatible = "gpio-leds";
                pinctrl-names = "default";
                pinctrl-0 = <&pinmux_disable_sys_led>;

		led_sys: led-0 {
			gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
		};
	};

	sfp1: sfp-p1 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda0>;
	};

	sfp2: sfp-p2 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda1>;
	};

	sfp3: sfp-p3 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda2>;
	};

	sfp4: sfp-p4 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda3>;
	};

	sfp5: sfp-p5 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda4>;
	};

	sfp6: sfp-p6 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda5>;
	};

	sfp7: sfp-p7 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda6>;
	};

	sfp8: sfp-p8 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda7>;
	};

	sfp9: sfp-p9 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda8>;
	};

	sfp10: sfp-p10 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda9>;
	};

	sfp11: sfp-p11 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda10>;
	};

	sfp12: sfp-p12 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda11>;
	};

	thermal_zones: thermal-zones {
		switch_thermal {
			polling-delay-passive = <2000>;
			polling-delay = <5000>;
			thermal-sensors = <&lm75>;

			trips {
				switch_idle: trip0 {
					temperature = <0>;
					hysteresis = <0>;
					type = "passive";
				};

				switch_low: trip1 {
					temperature = <35000>;
					hysteresis = <2000>;
					type = "active";
				};

				switch_medium: trip2 {
					temperature = <40000>;
					hysteresis = <2000>;
					type = "active";
				};

				switch_high: trip3 {
					temperature = <45000>;
					hysteresis = <2000>;
					type = "active";
				};

				switch_very_high: trip4 {
					temperature = <50000>;
					hysteresis = <2000>;
					type = "active";
				};

			};

			cooling-maps {
				map0 {
					trip = <&switch_idle>;
					cooling-device = <&fan_controller 0 0>;
				};

				map1 {
					trip = <&switch_low>;
					cooling-device = <&fan_controller 103 103>;
				};

				map2 {
					trip = <&switch_medium>;
					cooling-device = <&fan_controller 169 169>;
				};

				map3 {
					trip = <&switch_high>;
					cooling-device = <&fan_controller 235 235>;
				};

				map4 {
					trip = <&switch_very_high>;
					cooling-device = <&fan_controller 255 255>;
				};

			};
		};
	};
};

&i2c_mst1 {
	status = "okay";

	i2c1_sda0: i2c@0 {
		reg = <0>;

		fan_controller: fan-controller@48 {
			compatible = "maxim,max6651";
			reg = <0x48>;
			#cooling-cells = <2>;
                };

		lm75: lm75@4c {
			compatible = "national,lm75";
			reg = <0x4c>;
			#thermal-sensor-cells = <0>;
		};
	};
	i2c1_sda1: i2c@1 {
		reg = <1>;
	};
	i2c1_sda2: i2c@2 {
		reg = <2>;
	};
	i2c1_sda3: i2c@3 {
		reg = <3>;
	};
	i2c1_sda4: i2c@4 {
		reg = <4>;
	};
	i2c1_sda5: i2c@5 {
		reg = <5>;
	};
	i2c1_sda6: i2c@6 {
		reg = <6>;
	};
	i2c1_sda7: i2c@7 {
		reg = <7>;
	};
	i2c1_sda8: i2c@8 {
		reg = <8>;
	};
	i2c1_sda9: i2c@9 {
		reg = <9>;
	};
	i2c1_sda10: i2c@a {
		reg = <10>;
	};
	i2c1_sda11: i2c@b {
		reg = <11>;
	};

};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* stock is LOADER */
			partition@0 {
				label = "u-boot";
				reg = <0x0 0x140000>;
				read-only;
			};

                        /* stock is BDINFO */
                        partition@140000 {
                                label = "u-boot-env";
                                reg = <0x140000 0x10000>;
                        };

                        /* stock is SYSINFO */
                        partition@150000 {
                                label = "u-boot-env2";
                                reg = <0x150000 0x10000>;
                        };

                        /* stock is JFFS2_CFG */
                        partition@160000 {
                                label = "JFFS2_CFG";
                                reg = <0x160000 0xa0000>;
                        };

                        /* stock is JFFS2_LOG */
                        partition@200000 {
                                label = "JFFS2_LOG";
                                reg = <0x200000 0x400000>;
                        };

                        /* stock is RUNTIME1 */
                        partition@600000 {
                                compatible = "openwrt,uimage", "denx,uimage";
                                label = "firmware";
                                reg = <0x600000 0xd00000>;
                                openwrt,offset = <0x10>;
                        };

                        /* stock is RUNTIME2 */
                        partition@1300000 {
                                label = "runtime2";
                                reg = <0x1300000 0xd00000>;
				read-only;
                        };
		};
	};
};

&switch0 {
	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		SWITCH_PORT_SFP(0, 1, 2, 0, 1)
		SWITCH_PORT_SFP(8, 2, 3, 0, 2)
		SWITCH_PORT_SFP(16, 3, 4, 0, 3)
		SWITCH_PORT_SFP(24, 4, 5, 0, 4)
		SWITCH_PORT_SFP(32, 5, 6, 0, 5)
		SWITCH_PORT_SFP(40, 6, 7, 0, 6)
		SWITCH_PORT_SFP(48, 7, 8, 0, 7)
		SWITCH_PORT_SFP(50, 8, 9, 0, 8)
		SWITCH_PORT_SFP(52, 9, 10, 0, 9)
		SWITCH_PORT_SFP(53, 10, 11, 0, 10)
		SWITCH_PORT_SFP(54, 11, 12, 0, 11)
		SWITCH_PORT_SFP(55, 12, 13, 0, 12)

		/* CPU port */
		port@56 {
			ethernet = <&ethernet0>;
			reg = <56>;
			phy-mode = "internal";
			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};
	};
};

&serdes2 {
	tx-polarity = <PHY_POL_INVERT>;
};

&serdes3 {
	tx-polarity = <PHY_POL_INVERT>;
};

&serdes4 {
	tx-polarity = <PHY_POL_INVERT>;
};

&serdes5 {
	tx-polarity = <PHY_POL_INVERT>;
};

&serdes6 {
	tx-polarity = <PHY_POL_INVERT>;
};

&serdes7 {
	tx-polarity = <PHY_POL_INVERT>;
};

&serdes8 {
	tx-polarity = <PHY_POL_INVERT>;
};

&serdes9 {
	tx-polarity = <PHY_POL_INVERT>;
};

&serdes10 {
	tx-polarity = <PHY_POL_INVERT>;
};

&serdes11 {
	tx-polarity = <PHY_POL_INVERT>;
};

&serdes12 {
	tx-polarity = <PHY_POL_INVERT>;
};

&serdes13 {
	tx-polarity = <PHY_POL_INVERT>;
};
