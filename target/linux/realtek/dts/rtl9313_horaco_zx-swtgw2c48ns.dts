/dts-v1/;

#include "rtl931x.dtsi"

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/phy/phy.h>

/ {
	compatible = "horaco,zx-swtgw2c48ns", "realtek,rtl9313-soc";
	model = "Horaco ZX-SWTGW2C48NS";

	aliases {
		label-mac-device = &ethernet0;
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_sys;
		led-upgrade = &led_sys;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>, /* 256 MiB lowmem  */
		      <0x90000000 0x10000000>; /* 256 MiB highmem */
	};

	chosen {
		/* The kernel console runs 38400n8; U-Boot itself talks 115200. */
		stdout-path = "serial0:38400n8";
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_disable_sys_led>;

		led_sys: led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		};
	};

	led_set {
		compatible = "realtek,rtl9300-leds";
		realtek,led-mode = <RTL93XX_LED_MODE_SINGLE_COLOR_SCAN>;
		/*
		 * No active-low property, deliberately: the shared led_init
		 * sets the polarity bit exactly when the property is absent,
		 * which is the state this board needs. Adding it inverts every
		 * port LED (empty cages light, active ports go dark).
		 */

		/* The board is wired for three LEDs per port; the first is unused. */
		led_set0 = <RTL93XX_LED_SET_NONE
			    (RTL93XX_LED_SET_5G | RTL93XX_LED_SET_2P5G |
			     RTL93XX_LED_SET_1G | RTL93XX_LED_SET_100M |
			     RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)
			    (RTL93XX_LED_SET_10G | RTL93XX_LED_SET_LINK |
			     RTL93XX_LED_SET_ACT)>;
	};

	i2c_sys: i2c-system {
		compatible = "i2c-gpio";
		status = "disabled";
		#address-cells = <1>;
		#size-cells = <0>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_disable_jtag>;

		scl-gpios = <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		sda-gpios = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <28>;
	};

	sfp5: sfp-p5 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda0>;
		mod-def0-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
	};

	sfp6: sfp-p6 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda1>;
		mod-def0-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
	};

	sfp7: sfp-p7 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda2>;
		mod-def0-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
	};

	sfp8: sfp-p8 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda3>;
		mod-def0-gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
	};

	sfp9: sfp-p9 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda4>;
		mod-def0-gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
	};

	sfp10: sfp-p10 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c1_sda5>;
		mod-def0-gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
	};

	sfp11: sfp-p11 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c2_sda6>;
		mod-def0-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
	};

	sfp12: sfp-p12 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c2_sda7>;
		mod-def0-gpios = <&gpio1 32 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&gpio1 33 GPIO_ACTIVE_HIGH>;
	};

	keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0000000 0x00e0000>;
				read-only;
			};

			partition@e0000 {
				label = "u-boot-env";
				reg = <0x00e0000 0x0010000>;
				read-only;

				nvmem-layout {
					compatible = "u-boot,env";

					macaddr_ubootenv_ethaddr: ethaddr {
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@f0000 {
				label = "u-boot-env2";
				reg = <0x00f0000 0x0010000>;
				read-only;
			};

			partition@100000 {
				label = "jffs";
				reg = <0x0100000 0x0100000>;
				read-only;
			};

			partition@200000 {
				label = "jffs2";
				reg = <0x0200000 0x0100000>;
				read-only;
			};

			partition@300000 {
				label = "firmware";
				compatible = "openwrt,uimage", "denx,uimage";
				reg = <0x0300000 0x1c00000>;
				openwrt,ih-magic = <0x83800000>;
			};

			partition@1f00000 {
				label = "oeminfo";
				reg = <0x1f00000 0x0100000>;
				read-only;
			};
		};
	};
};

&i2c_mst1 {
	status = "okay";

	i2c1_sda0: i2c@0 { reg = <0>; };
	i2c1_sda1: i2c@1 { reg = <1>; };
	i2c1_sda2: i2c@2 { reg = <2>; };
	i2c1_sda3: i2c@3 { reg = <3>; };
	i2c1_sda4: i2c@4 { reg = <4>; };
	i2c1_sda5: i2c@5 { reg = <5>; };
};

&i2c_mst2 {
	status = "okay";

	i2c2_sda6: i2c@6 { reg = <6>; };
	i2c2_sda7: i2c@7 { reg = <7>; };

	i2c2_fan: i2c@8 {
		reg = <8>;
		#address-cells = <1>;
		#size-cells = <0>;

		hwmon@2c {
			compatible = "adi,adt7476";
			reg = <0x2c>;
		};
	};
};

&mdio_aux {
	status = "okay";

	gpio1: gpio@0 {
		compatible = "realtek,rtl8231";
		reg = <0>;

		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&gpio1 0 0 37>;

		led-controller {
			compatible = "realtek,rtl8231-leds";
			status = "disabled";
		};
	};
};

&ethernet0 {
	nvmem-cells = <&macaddr_ubootenv_ethaddr 0>;
	nvmem-cell-names = "mac-address";
};

&mdio_ctrl {
	pinctrl-names = "default";
	pinctrl-0 = <&pinmux_enable_mdc_mdio_0>;
};

&mdio_bus0 {
	/* RTL8264B */
	ethernet-phy-package@0 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;

		PHY_C45(0, 0)
		PHY_C45(8, 1)
		PHY_C45(16, 2)
		PHY_C45(24, 3)
	};
};

&switch0 {
	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		SWITCH_PORT_LED(0,  1, 2, 0, 0, usxgmii)
		SWITCH_PORT_LED(8,  2, 3, 0, 0, usxgmii)
		SWITCH_PORT_LED(16, 3, 4, 0, 0, usxgmii)
		SWITCH_PORT_LED(24, 4, 5, 0, 0, usxgmii)

		SWITCH_PORT_SFP(32, 5,  6,  0, 5)
		SWITCH_PORT_SFP(40, 6,  7,  0, 6)
		SWITCH_PORT_SFP(48, 7,  8,  0, 7)
		SWITCH_PORT_SFP(50, 8,  9,  0, 8)
		SWITCH_PORT_SFP(52, 9,  10, 0, 9)
		SWITCH_PORT_SFP(53, 10, 11, 0, 10)
		SWITCH_PORT_SFP(54, 11, 12, 0, 11)
		SWITCH_PORT_SFP(55, 12, 13, 0, 12)

		/* CPU port */
		port@56 {
			ethernet = <&ethernet0>;
			reg = <56>;
			phy-mode = "internal";
			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};
	};
};

&serdes6 {
	tx-polarity = <PHY_POL_INVERT>;
	realtek,sfp-dac-detect;
};

&serdes7 {
	tx-polarity = <PHY_POL_INVERT>;
	realtek,sfp-dac-detect;
};

&serdes8 {
	tx-polarity = <PHY_POL_INVERT>;
	realtek,sfp-dac-detect;
};

&serdes9 {
	tx-polarity = <PHY_POL_INVERT>;
	realtek,sfp-dac-detect;
};

&serdes10 {
	tx-polarity = <PHY_POL_INVERT>;
	realtek,sfp-dac-detect;
};

&serdes11 {
	tx-polarity = <PHY_POL_INVERT>;
	realtek,sfp-dac-detect;
};

&serdes12 {
	tx-polarity = <PHY_POL_INVERT>;
	realtek,sfp-dac-detect;
};

&serdes13 {
	tx-polarity = <PHY_POL_INVERT>;
	realtek,sfp-dac-detect;
};
