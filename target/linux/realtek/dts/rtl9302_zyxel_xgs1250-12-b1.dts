/dts-v1/;

#include "rtl9302_zyxel_xgs1250-12-common.dtsi"

/ {
	compatible = "zyxel,xgs1250-12-b1", "realtek,rtl9302-soc";
	model = "Zyxel XGS1250-12 B1 Switch";
};

&chassis_fan {
	gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
	gpio-fan,speed-map = <0    0
			      8000 1>;
};

&gpio0 {
	fan-normal-speed-hog {
		gpio-hog;
		gpios = <11 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "fan-normal-speed";
	};
};

&mdio_bus1 {
	phy24: ethernet-phy@0 {
		reg = <0>;
		compatible = "ethernet-phy-ieee802.3-c45";
		// Disabled because we do not know how to bring up again
		// reset-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
		#thermal-sensor-cells = <0>;
	};
};

&mdio_bus2 {
	phy25: ethernet-phy@1 {
		reg = <1>;
		compatible = "ethernet-phy-ieee802.3-c45";
		// Disabled because we do not know how to bring up again
		// reset-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
		#thermal-sensor-cells = <0>;
	};
};

&mdio_bus3 {
	phy26: ethernet-phy@2 {
		reg = <2>;
		compatible = "ethernet-phy-ieee802.3-c45";
		// Disabled because we do not know how to bring up again
		// reset-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
		#thermal-sensor-cells = <0>;
	};
};
