/dts-v1/;

#include "rtl9607c-va.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "buffalo,wsr-1500ax2s", "realtek,rtl8198d-soc", "realtek,rtl960x-soc";
	model = "Buffalo WSR-1500AX2S";

	chosen {
		bootargs = "earlycon ubi.block=0,ubi_r0 root=/dev/ubiblock0_2";
	};

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power_amber;
		led-running = &led_power;
		led-upgrade = &led_power_amber;
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_keys>;

		key-reset {
			label = "reset";
			gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		key-aoss {
			label = "wps";
			gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};

		/*
		 * 3-position mode switch: ROUTER and AP assert one input
		 * each, WB asserts neither.
		 */
		key-ap {
			label = "ap";
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_0>;
			linux,input-type = <EV_SW>;
		};

		key-router {
			label = "router";
			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_1>;
			linux,input-type = <EV_SW>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinmux_leds>;

		led_power: led-power {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
		};

		led_power_amber: led-power-amber {
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
		};

		led-wlan-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
		};

		led-wlan-amber {
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_WLAN;
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
		};

		led-internet-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;
		};

		led-router-green {
			color = <LED_COLOR_ID_GREEN>;
			function = "router";
			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
		};
	};
};

&mdio_ctrl {
	PHY_C22(0, 0)
	PHY_C22(1, 1)
	PHY_C22(2, 2)
	PHY_C22(3, 3)
};

&switch0 {
	ethernet-ports {
		SWITCH_PORT(0, 1, internal)
		SWITCH_PORT(1, 2, internal)
		SWITCH_PORT(2, 3, internal)

		/* Port 3 is the WAN jack on this board. */
		port@3 {
			reg = <3>;
			label = "wan";
			phy-mode = "internal";
			phy-handle = <&phy3>;
		};
	};
};

&pinmux {
	/*
	 * GPIO function enable for the key and LED pins, as set by the
	 * stock firmware. GPIO 5 (ROUTER position of the mode switch) is
	 * unusable without this, the input keeps changing.
	 */
	pinmux_keys: keys {
		/* bank 0: 0, 5, 28; bank 1: 2 */
		pinctrl-single,bits = <0x0 0x10000021 0x10000021>,
				      <0x4 0x4 0x4>;
	};

	pinmux_leds: leds {
		/* bank 0: 8, 9, 12; bank 1: 1, 3, 6 */
		pinctrl-single,bits = <0x0 0x1300 0x1300>,
				      <0x4 0x4a 0x4a>;
	};
};

&ecc0 {
	status = "okay";
};

&gmac0 {
	status = "okay";
};

&snand {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;

		nand-ecc-engine = <&ecc0>;
		nand-ecc-strength = <6>;
		nand-ecc-step-size = <512>;
		nand-ecc-algo = "bch";
		nand-ecc-placement = "oob";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0xc0000>;
				read-only;
			};

			partition@c0000 {
				compatible = "u-boot,env-redundant-count";
				label = "u-boot-env";
				reg = <0xc0000 0x20000>;
			};

			partition@e0000 {
				compatible = "u-boot,env-redundant-count";
				label = "u-boot-env2";
				reg = <0xe0000 0x20000>;
			};

			partition@100000 {
				label = "ubi";
				reg = <0x100000 0x7c80000>;
			};
		};
	};
};

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};
