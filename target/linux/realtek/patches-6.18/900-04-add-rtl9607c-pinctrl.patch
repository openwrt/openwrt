From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Zavertkin <misha.zavertkin@mail.ru>
Date: Thu, 27 Aug 2026 21:29:31 +0700
Subject: pinctrl: add driver for rtl9607c

Add dedicated driver to control SoC pin routing.

Signed-off-by: Michael Zavertkin <misha.zavertkin@mail.ru>
---
--- a/drivers/pinctrl/Makefile
+++ b/drivers/pinctrl/Makefile
@@ -81,6 +81,7 @@ obj-y				+= nxp/
 obj-$(CONFIG_PINCTRL_PXA)	+= pxa/
 obj-y				+= qcom/
 obj-$(CONFIG_ARCH_REALTEK)      += realtek/
+obj-$(CONFIG_MACH_REALTEK_RTL)  += realtek/
 obj-$(CONFIG_PINCTRL_RENESAS)	+= renesas/
 obj-$(CONFIG_PINCTRL_SAMSUNG)	+= samsung/
 obj-y				+= sophgo/
--- a/drivers/pinctrl/realtek/Kconfig
+++ b/drivers/pinctrl/realtek/Kconfig
@@ -22,3 +22,9 @@ config PINCTRL_RTD1315E
 	tristate "Realtek DHC 1315E pin controller driver"
 	depends on PINCTRL_RTD
 	default y
+
+config PINCTRL_RTL9607C
+	tristate "Realtek RTL9607C pin controller driver"
+	depends on MACH_REALTEK_RTL && RTL960X
+	select PINMUX
+	default n
--- a/drivers/pinctrl/realtek/Makefile
+++ b/drivers/pinctrl/realtek/Makefile
@@ -4,3 +4,4 @@ obj-$(CONFIG_PINCTRL_RTD)		+= pinctrl-rt
 obj-$(CONFIG_PINCTRL_RTD1619B)		+= pinctrl-rtd1619b.o
 obj-$(CONFIG_PINCTRL_RTD1319D)		+= pinctrl-rtd1319d.o
 obj-$(CONFIG_PINCTRL_RTD1315E)		+= pinctrl-rtd1315e.o
+obj-$(CONFIG_PINCTRL_RTL9607C)		+= pinctrl-rtl9607c.o
