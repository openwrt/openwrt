+static void rtl8_4_rtl9607c_write_tag(struct sk_buff *skb, struct net_device *dev,
+			     void *tag)
+{
+	struct dsa_port *dp = dsa_user_to_port(dev);
+	__be16 tag16[RTL8_4_TAG_LEN / 2];
+	u16 pmask_low = FIELD_GET(RTL8_4_RTL9607C_RX_LO, BIT(dp->index));
+	u16 pmask_high = FIELD_GET(RTL9607C_RX_HI_MSK, BIT(dp->index));
+
+	/* Set Realtek EtherType */
+	tag16[0] = htons(ETH_P_REALTEK);
+
+	/* Set Protocol; set RX (CPU->switch) low forwarding port mask */
+	tag16[1] = htons(FIELD_PREP(RTL8_4_PROTOCOL, RTL8_4_PROTOCOL_RTL8365MB) |
+			 FIELD_PREP(RTL8_4_RTL9607C_RX_LO, pmask_low));
+
+	/* set high forwarding port mask, KEEP, LEARN_DIS and DIRTX */
+	tag16[2] = htons(FIELD_PREP(RTL8_4_RTL9607C_RX_HI, pmask_high) |
+			 RTL8_4_LEARN_DIS | RTL8_4_KEEP | RTL8_4_RTL9607C_DIRTX);
+
+	/* Zero EXTSPA, PPPOE_ACT/IDX and PON_STREAM_ID */
+	tag16[3] = 0;
+
+	memcpy(tag, tag16, RTL8_4_TAG_LEN);
+}
