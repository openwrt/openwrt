--- a/drivers/net/mdio/Kconfig
+++ b/drivers/net/mdio/Kconfig
@@ -225,6 +225,13 @@ config MDIO_REALTEK_OTTO_SERDES
         help
           This driver provides MDIO access to the RTL83xx/RTL93xx SerDes.
 
+config MDIO_REALTEK_OTTO_RTL960X
+	tristate "Realtek Otto RTL960X MDIO interface support"
+	default MACH_REALTEK_RTL && RTL960X
+	depends on (MACH_REALTEK_RTL && RTL960X) || COMPILE_TEST
+	help
+	  This driver supports the internal MDIO bus on RTL960x SoCs.
+
 config MDIO_THUNDER
 	tristate "ThunderX SOCs MDIO buses"
 	depends on 64BIT
--- a/drivers/net/mdio/Makefile
+++ b/drivers/net/mdio/Makefile
@@ -26,6 +26,7 @@ obj-$(CONFIG_MDIO_REGMAP)		+= mdio-regma
 obj-$(CONFIG_MDIO_REALTEK_OTTO)	+= mdio-realtek-otto.o
 obj-$(CONFIG_MDIO_REALTEK_OTTO_AUX)	+= mdio-realtek-otto-aux.o
 obj-$(CONFIG_MDIO_REALTEK_OTTO_SERDES)	+= mdio-realtek-otto-serdes.o
+obj-$(CONFIG_MDIO_REALTEK_OTTO_RTL960X)	+= mdio-realtek-otto-rtl960x.o
 obj-$(CONFIG_MDIO_SMBUS)		+= mdio-smbus.o
 obj-$(CONFIG_MDIO_SUN4I)		+= mdio-sun4i.o
 obj-$(CONFIG_MDIO_THUNDER)		+= mdio-thunder.o
