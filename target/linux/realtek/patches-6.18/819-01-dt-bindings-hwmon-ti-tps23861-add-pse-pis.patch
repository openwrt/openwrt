--- a/Documentation/devicetree/bindings/hwmon/ti,tps23861.yaml
+++ b/Documentation/devicetree/bindings/hwmon/ti,tps23861.yaml
@@ -30,6 +30,9 @@ properties:
     minimum: 250000
     maximum: 255000
 
+  pse-pis:
+    $ref: /schemas/net/pse-pd/pse-controller.yaml#/properties/pse-pis
+
 required:
   - compatible
   - reg
