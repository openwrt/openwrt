#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# RAM-only backup, install gate, and stock-firmware restore for the IX2106.
set -eu
umask 077

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

FACTORY_SIZE=131072
FACTORY_DATA_SIZE=4063232
FIRMWARE_SIZE=27000832
SYSUPGRADE_MAX_SIZE=27066368
BOOT_RESERVED_SIZE=2359296
ERASE_SIZE=131072
FIRMWARE_OFFSET=4194304
FIRMWARE_END=31195136
BACKUP_ARCHIVE_MAX=34000000

usage() {
	cat >&2 <<'EOF'
Usage:
  ix2106-nor backup /tmp/ix2106-nor-backup.tar
  ix2106-nor verify /tmp/ix2106-nor-backup.tar
  ix2106-nor install /tmp/ix2106-nor-backup.tar /tmp/openwrt-sysupgrade.bin
  ix2106-nor restore /tmp/ix2106-nor-backup.tar

All operations require the TFTP initramfs recovery environment and a RAM-backed /tmp.
The archive is user-specific. Save it off-device before install; it contains stock data.
EOF
	exit 2
}

die() {
	echo "ix2106-nor: ERROR: $*" >&2
	exit 1
}

check_ram_environment() {
	[ "$(id -u)" = 0 ] || die "must run as root"
	awk '$2 == "/" && $3 ~ /^(tmpfs|ramfs|rootfs)$/ { root = 1 }
	     $2 == "/tmp" && $3 == "tmpfs" { tmp = 1 }
	     END { exit !(root && tmp) }' /proc/mounts \
		|| die "use TFTP initramfs recovery with root and /tmp in RAM"
	compatible=/proc/device-tree/compatible
	[ -r "$compatible" ] || compatible=/sys/firmware/devicetree/base/compatible
	[ -r "$compatible" ] || die "device-tree compatible is unavailable"
	tr '\000' '\n' < "$compatible" | grep -Fxq 'nec,ix2106' \
		|| die "device is not a NEC IX2106"
	[ -d /sys/class/mtd ] || die "MTD sysfs is unavailable"
	[ -r /proc/mtd ] || die "/proc/mtd is unavailable"
	[ -r /lib/upgrade/ix2106.sh ] || die "IX2106 upgrade validation is unavailable"
	. /lib/upgrade/ix2106.sh
	ix2106_check_mtd_layout || die "active MTD layout is not the supported IX2106 NOR layout"
}

in_tmp_regular() {
	local file resolved
	file=$1
	case "$file" in /tmp/*) ;; *) die "files must be under /tmp" ;; esac
	[ -f "$file" ] && [ ! -L "$file" ] || die "not a regular non-symlink file: $file"
	resolved=$(readlink -f "$file") || die "cannot resolve file path: $file"
	case "$resolved" in /tmp/*) ;; *) die "file path resolves outside /tmp: $file" ;; esac
}

ix2106_sysupgrade_size_valid() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	[ "$1" -gt 0 ] && [ "$1" -le "$SYSUPGRADE_MAX_SIZE" ]
}

publish_backup() {
	local temporary_archive output temporary_parent output_parent
	temporary_archive=$1
	output=$2
	case "$temporary_archive:$output" in /tmp/*:/tmp/*) ;; *) die "archive paths must be under /tmp" ;; esac
	[ -f "$temporary_archive" ] && [ ! -L "$temporary_archive" ] \
		|| die "temporary archive is missing"
	temporary_parent=$(readlink -f "$(dirname "$temporary_archive")") || die "cannot resolve temporary archive directory"
	output_parent=$(readlink -f "$(dirname "$output")") || die "cannot resolve output archive directory"
	case "$output_parent" in /tmp|/tmp/*) ;; *) die "output archive directory resolves outside /tmp" ;; esac
	[ "$temporary_parent" = "$output_parent" ] || die "temporary archive must be adjacent to the output"
	[ ! -e "$output" ] && [ ! -L "$output" ] || die "refusing to overwrite $output"
	mv "$temporary_archive" "$output" || die "cannot atomically publish backup archive"
}

find_mtd_ro() {
	wanted=$1
	expect_offset=$2
	expect_size=$3
	expect_writeable=$4
	found=
	for sys in /sys/class/mtd/mtd[0-9]*; do
		[ -f "$sys/name" ] || continue
		[ "$(cat "$sys/name")" = "$wanted" ] || continue
		[ -z "$found" ] || die "duplicate MTD partition: $wanted"
		found=$sys
	done
	[ -n "$found" ] || die "missing MTD partition: $wanted"
	[ "$(cat "$found/type")" = nor ] || die "$wanted is not NOR"
	[ "$(cat "$found/offset")" = "$expect_offset" ] || die "$wanted offset mismatch"
	[ "$(cat "$found/size")" = "$expect_size" ] || die "$wanted size mismatch"
	[ "$(cat "$found/erasesize")" = "$ERASE_SIZE" ] || die "$wanted erase-size mismatch"
	flags=$(cat "$found/flags")
	case "$flags" in 0x*) ;; *) die "$wanted has invalid MTD flags" ;; esac
	[ $((flags & 0x400)) -eq "$expect_writeable" ] || die "$wanted has unexpected MTD writeability"
	device=/dev/$(basename "$found")ro
	[ -c "$device" ] || die "read-only MTD device is missing: $device"
	printf '%s\n' "$device"
}

check_factory() {
	factory=$1
	[ "$(wc -c < "$factory" | tr -d '[:space:]')" = "$FACTORY_SIZE" ] \
		|| die "factory member has the wrong size"
	sum=$(hexdump -v -s 12 -n 244 -e '1/1 "%u\n"' "$factory" |
		awk 'NR % 2 { high = $1; next } { total += high * 256 + $1 }
			END { if (NR != 244) exit 1; printf "%04x", total % 65536 }') \
		|| die "factory checksum data is incomplete"
	[ "$sum" = 0000 ] || die "factory BE16 checksum is invalid"
	set -- $(hexdump -v -s 14 -n 2 -e '2/1 "%u "' "$factory")
	mac_count=$(($1 * 256 + $2))
	[ "$mac_count" -ge 2 ] && [ "$mac_count" -le 27 ] \
		|| die "factory MAC count is unsupported"
	mac0=$(hexdump -v -s 16 -n 6 -e '6/1 "%02x"' "$factory")
	mac1=$(hexdump -v -s 22 -n 6 -e '6/1 "%02x"' "$factory")
	[ "$mac0" != "$mac1" ] || die "factory MAC addresses are identical"
	for offset in 16 22; do
		mac=$(hexdump -v -s "$offset" -n 6 -e '6/1 "%02x"' "$factory")
		[ "$mac" != 000000000000 ] && [ "$mac" != ffffffffffff ] \
			|| die "factory MAC is blank"
		first=$(hexdump -v -s "$offset" -n 1 -e '1/1 "%u"' "$factory")
		[ $((first & 1)) -eq 0 ] || die "factory MAC is multicast"
	done
}

make_backup() {
	local output parent tmp temporary_archive archive_sha factory factory_data firmware boot_reserved
	output=$1
	case "$output" in /tmp/*) ;; *) die "archive path must be under /tmp" ;; esac
	parent=$(dirname "$output")
	parent=$(readlink -f "$parent") || die "cannot resolve archive directory"
	case "$parent" in /tmp|/tmp/*) ;; *) die "archive directory resolves outside /tmp" ;; esac
	[ -d "$parent" ] || die "archive directory does not exist"
	[ ! -e "$output" ] && [ ! -L "$output" ] || die "refusing to overwrite $output"
	tmp=$(mktemp -d /tmp/ix2106-nor.XXXXXX) || die "cannot create temporary directory"
	temporary_archive=
	trap 'rm -rf "$tmp"; [ -z "$temporary_archive" ] || rm -f "$temporary_archive"' EXIT HUP INT TERM
	temporary_archive=$(mktemp "$parent/.ix2106-nor-backup.XXXXXX") || die "cannot create temporary archive"
	factory=$(find_mtd_ro factory 0 "$FACTORY_SIZE" 0)
	factory_data=$(find_mtd_ro factory-data "$FACTORY_SIZE" "$FACTORY_DATA_SIZE" 0)
	firmware=$(find_mtd_ro firmware "$FIRMWARE_OFFSET" "$FIRMWARE_SIZE" 1024)
	boot_reserved=$(find_mtd_ro boot-reserved "$FIRMWARE_END" "$BOOT_RESERVED_SIZE" 0)
	cat "$factory" > "$tmp/factory.bin"
	cat "$factory_data" > "$tmp/factory-data.bin"
	cat "$firmware" > "$tmp/firmware.bin"
	cat "$boot_reserved" > "$tmp/boot-reserved.bin"
	check_backup_sizes "$tmp"
	check_factory "$tmp/factory.bin"
	(cd "$tmp" && sha256sum factory.bin factory-data.bin firmware.bin boot-reserved.bin > manifest.sha256)
	tar -C "$tmp" -cf "$temporary_archive" factory.bin factory-data.bin firmware.bin boot-reserved.bin manifest.sha256
	archive_sha=$(sha256sum "$temporary_archive" | awk '{print $1}')
	publish_backup "$temporary_archive" "$output"
	printf '%s  %s\n' "$archive_sha" "$output"
	trap - EXIT HUP INT TERM
	rm -rf "$tmp"
}

check_backup_sizes() {
	local tmp
	tmp=$1
	[ "$(wc -c < "$tmp/factory.bin" | tr -d '[:space:]')" = "$FACTORY_SIZE" ] || die "factory backup size mismatch"
	[ "$(wc -c < "$tmp/factory-data.bin" | tr -d '[:space:]')" = "$FACTORY_DATA_SIZE" ] || die "factory-data backup size mismatch"
	[ "$(wc -c < "$tmp/firmware.bin" | tr -d '[:space:]')" = "$FIRMWARE_SIZE" ] || die "firmware backup size mismatch"
	[ "$(wc -c < "$tmp/boot-reserved.bin" | tr -d '[:space:]')" = "$BOOT_RESERVED_SIZE" ] || die "boot-reserved backup size mismatch"
}

validate_backup() {
	local archive current_factory tmp member archive_size
	archive=$1
	current_factory=$2
	tmp=$3
	in_tmp_regular "$archive"
	archive_size=$(wc -c < "$archive" | tr -d '[:space:]')
	[ "$archive_size" -le "$BACKUP_ARCHIVE_MAX" ] || die "backup archive exceeds its maximum size"
	[ -f "$current_factory" ] && [ ! -L "$current_factory" ] || die "current factory image is unavailable"
	printf '%s\n' factory.bin factory-data.bin firmware.bin boot-reserved.bin manifest.sha256 > "$tmp/expected-members"
	tar -tf "$archive" > "$tmp/actual-members" || die "cannot read backup archive"
	cmp -s "$tmp/expected-members" "$tmp/actual-members" || die "backup archive has missing, extra, or duplicate members"
	tar -tvf "$archive" > "$tmp/verbose-members" || die "cannot inspect backup member types"
	awk '$1 !~ /^-/ { bad = 1 } END { exit bad }' "$tmp/verbose-members" \
		|| die "backup archive contains a non-regular member"
	tar -xOf "$archive" manifest.sha256 > "$tmp/manifest.sha256" || die "cannot read archive manifest"
	tar -xOf "$archive" factory.bin > "$tmp/factory.bin" || die "cannot read factory archive member"
	check_factory "$tmp/factory.bin"
	for member in factory.bin factory-data.bin firmware.bin boot-reserved.bin; do
		size=$(tar -xOf "$archive" "$member" | wc -c | tr -d '[:space:]')
		case "$member" in
			factory.bin) expected_size=$FACTORY_SIZE ;;
			factory-data.bin) expected_size=$FACTORY_DATA_SIZE ;;
			firmware.bin) expected_size=$FIRMWARE_SIZE ;;
			boot-reserved.bin) expected_size=$BOOT_RESERVED_SIZE ;;
		esac
		[ "$size" = "$expected_size" ] || die "$member backup size mismatch"
		hash=$(tar -xOf "$archive" "$member" | sha256sum | awk '{print $1}')
		printf '%s  %s\n' "$hash" "$member" >> "$tmp/expected.sha256"
	done
	cmp -s "$tmp/expected.sha256" "$tmp/manifest.sha256" || die "backup member checksum or manifest name mismatch"
	cmp -s "$tmp/factory.bin" "$current_factory" || die "backup belongs to a different factory identity"
}

current_factory_device() {
	local output factory
	output=$1
	factory=$(find_mtd_ro factory 0 "$FACTORY_SIZE" 0)
	cat "$factory" > "$output"
	check_factory "$output"
}

verify_archive_on_device() {
	local archive tmp
	archive=$1
	tmp=$2
	current_factory_device "$tmp/current-factory.bin"
	validate_backup "$archive" "$tmp/current-factory.bin" "$tmp"
}

install_openwrt() {
	local archive image image_size tmp status
	archive=$1
	image=$2
	in_tmp_regular "$archive"
	in_tmp_regular "$image"
	image_size=$(wc -c < "$image" | tr -d '[:space:]')
	ix2106_sysupgrade_size_valid "$image_size" || die "sysupgrade image size exceeds the firmware and metadata bounds"
	tmp=$(mktemp -d /tmp/ix2106-nor.XXXXXX) || die "cannot create temporary directory"
	trap 'rm -rf "$tmp"' EXIT HUP INT TERM
	verify_archive_on_device "$archive" "$tmp"
	echo "Backup SHA-256: $(sha256sum "$archive" | awk '{print $1}')"
	echo "Validated IX2106 identity and backup. Starting standard sysupgrade -n."
	if sysupgrade -n "$image"; then
		trap - EXIT HUP INT TERM
		rm -rf "$tmp"
	else
		status=$?
		trap - EXIT HUP INT TERM
		rm -rf "$tmp"
		return "$status"
	fi
}

restore_firmware() {
	local archive tmp firmware expected_fw actual_fw
	archive=$1
	in_tmp_regular "$archive"
	tmp=$(mktemp -d /tmp/ix2106-nor.XXXXXX) || die "cannot create temporary directory"
	trap 'rm -rf "$tmp"' EXIT HUP INT TERM
	verify_archive_on_device "$archive" "$tmp"
	tar -xOf "$archive" firmware.bin > "$tmp/firmware.bin" || die "cannot read firmware archive member"
	[ "$(wc -c < "$tmp/firmware.bin" | tr -d '[:space:]')" = "$FIRMWARE_SIZE" ] || die "firmware member size changed"
	expected_fw=$(awk '$2 == "firmware.bin" { print $1 }' "$tmp/manifest.sha256")
	actual_fw=$(sha256sum "$tmp/firmware.bin" | awk '{ print $1 }')
	[ -n "$expected_fw" ] && [ "$actual_fw" = "$expected_fw" ] || die "firmware member changed after archive validation"
	echo "Restoring only the verified archived firmware partition."
	mtd write "$tmp/firmware.bin" firmware || die "firmware partition write failed"
	firmware=$(find_mtd_ro firmware "$FIRMWARE_OFFSET" "$FIRMWARE_SIZE" 1024)
	cmp -s "$tmp/firmware.bin" "$firmware" || die "archived firmware readback differs; do not reboot"
	echo "Archived firmware readback verified. Reboot when ready."
	trap - EXIT HUP INT TERM
	rm -rf "$tmp"
}

main() {
	[ "$#" -ge 1 ] || usage
	command=$1
	shift
	check_ram_environment
	case "$command" in
		backup)
			[ "$#" -eq 1 ] || usage
			make_backup "$1"
			;;
		verify)
			[ "$#" -eq 1 ] || usage
			tmp=$(mktemp -d /tmp/ix2106-nor.XXXXXX) || die "cannot create temporary directory"
			trap 'rm -rf "$tmp"' EXIT HUP INT TERM
			verify_archive_on_device "$1" "$tmp"
			echo "IX2106 identity and backup archive verified. No Flash writes performed."
			;;
		install)
			[ "$#" -eq 2 ] || usage
			install_openwrt "$1" "$2"
			;;
		restore)
			[ "$#" -eq 1 ] || usage
			restore_firmware "$1"
			;;
		*) usage ;;
	esac
}

if [ "${IX2106_NOR_LIBRARY:-0}" != 1 ]; then
	main "$@"
fi
