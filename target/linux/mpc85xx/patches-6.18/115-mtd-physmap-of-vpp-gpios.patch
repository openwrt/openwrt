From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kosuke Shibuya <kakiringopcneko@gmail.com>
Date: Wed, 4 Nov 2026 17:38:07 +0900
Subject: [PATCH] mtd: physmap: support a VPP GPIO for CFI probe and writes

Use the existing refcounted physmap set_vpp hook for an optional GPIO
when platform data does not provide a callback. Bracket each map probe
with the GPIO because IX2106 requires its write-enable gate for CFI query
mode. Reject sleeping GPIOs because the hook is called under a spinlock.
Keep platform-data behavior unchanged and reject ambiguous VPP controls.

Signed-off-by: Kosuke Shibuya <kakiringopcneko@gmail.com>
---
--- a/drivers/mtd/maps/physmap-core.c
+++ b/drivers/mtd/maps/physmap-core.c
@@ -59,10 +59,13 @@ struct physmap_flash_info {
 	unsigned int		nparts;
 	const struct mtd_partition *parts;
 	struct gpio_descs	*gpios;
+	struct gpio_desc	*vpp_gpio;
 	unsigned int		gpio_values;
 	unsigned int		win_order;
 };
 
+static void physmap_set_vpp(struct map_info *map, int state);
+
 static void physmap_flash_remove(struct platform_device *dev)
 {
 	struct physmap_flash_info *info;
@@ -79,8 +82,13 @@ static void physmap_flash_remove(struct
 	}
 
 	for (i = 0; i < info->nmaps; i++) {
-		if (info->mtds[i])
+		if (info->mtds[i]) {
+			if (info->vpp_gpio)
+				physmap_set_vpp(&info->maps[i], 1);
 			map_destroy(info->mtds[i]);
+			if (info->vpp_gpio)
+				physmap_set_vpp(&info->maps[i], 0);
+		}
 	}
 
 	physmap_data = dev_get_platdata(&dev->dev);
@@ -100,23 +108,47 @@ static void physmap_set_vpp(struct map_i
 
 	pdev = (struct platform_device *)map->map_priv_1;
 	physmap_data = dev_get_platdata(&pdev->dev);
+	info = platform_get_drvdata(pdev);
 
-	if (!physmap_data->set_vpp)
+	if ((!physmap_data || !physmap_data->set_vpp) && !info->vpp_gpio)
 		return;
 
-	info = platform_get_drvdata(pdev);
-
 	spin_lock_irqsave(&info->vpp_lock, flags);
 	if (state) {
-		if (++info->vpp_refcnt == 1)    /* first nested 'on' */
-			physmap_data->set_vpp(pdev, 1);
+		if (++info->vpp_refcnt == 1) { /* first nested 'on' */
+			if (physmap_data && physmap_data->set_vpp)
+				physmap_data->set_vpp(pdev, 1);
+			else
+				gpiod_set_value(info->vpp_gpio, 1);
+		}
 	} else {
-		if (--info->vpp_refcnt == 0)    /* last nested 'off' */
-			physmap_data->set_vpp(pdev, 0);
+		if (--info->vpp_refcnt == 0) { /* last nested 'off' */
+			if (physmap_data && physmap_data->set_vpp)
+				physmap_data->set_vpp(pdev, 0);
+			else
+				gpiod_set_value(info->vpp_gpio, 0);
+		}
 	}
 	spin_unlock_irqrestore(&info->vpp_lock, flags);
 }
 
+static struct mtd_info *physmap_do_map_probe(struct physmap_flash_info *info,
+						     struct map_info *map,
+						     const char *type)
+{
+	struct mtd_info *mtd;
+
+	if (info->vpp_gpio)
+		physmap_set_vpp(map, 1);
+
+	mtd = do_map_probe(type, map);
+
+	if (info->vpp_gpio)
+		physmap_set_vpp(map, 0);
+
+	return mtd;
+}
+
 #if IS_ENABLED(CONFIG_MTD_PHYSMAP_GPIO_ADDR)
 static void physmap_set_addr_gpios(struct physmap_flash_info *info,
 				   unsigned long ofs)
@@ -475,6 +507,23 @@ static int physmap_flash_probe(struct pl
 		return -ENOMEM;
 
 	platform_set_drvdata(dev, info);
+	spin_lock_init(&info->vpp_lock);
+
+	info->vpp_gpio = devm_gpiod_get_optional(&dev->dev, "vpp", GPIOD_OUT_LOW);
+	if (IS_ERR(info->vpp_gpio))
+		return dev_err_probe(&dev->dev, PTR_ERR(info->vpp_gpio),
+				     "failed to get VPP GPIO\n");
+	if (info->vpp_gpio) {
+		struct physmap_flash_data *physmap_data;
+
+		physmap_data = dev_get_platdata(&dev->dev);
+		if (physmap_data && physmap_data->set_vpp)
+			return dev_err_probe(&dev->dev, -EINVAL,
+					     "VPP GPIO conflicts with platform data callback\n");
+	}
+	if (info->vpp_gpio && gpiod_cansleep(info->vpp_gpio))
+		return dev_err_probe(&dev->dev, -EINVAL,
+				     "VPP GPIO must not sleep\n");
 
 	info->gpios = devm_gpiod_get_array_optional(&dev->dev, "addr",
 						    GPIOD_OUT_LOW);
@@ -525,6 +574,17 @@ static int physmap_flash_probe(struct pl
 
 		info->maps[i].map_priv_1 = (unsigned long)dev;
 
+		if (info->vpp_gpio) {
+			if (info->maps[i].set_vpp &&
+			    info->maps[i].set_vpp != physmap_set_vpp) {
+				dev_err(&dev->dev,
+					"VPP GPIO conflicts with map set_vpp callback\n");
+				err = -EINVAL;
+				goto err_out;
+			}
+			info->maps[i].set_vpp = physmap_set_vpp;
+		}
+
 		if (info->gpios) {
 			err = physmap_addr_gpios_map_init(&info->maps[i]);
 			if (err)
@@ -544,8 +604,9 @@ static int physmap_flash_probe(struct pl
 #endif
 
 		if (info->probe_type) {
-			info->mtds[i] = do_map_probe(info->probe_type,
-						     &info->maps[i]);
+			info->mtds[i] = physmap_do_map_probe(info,
+							   &info->maps[i],
+							   info->probe_type);
 
 			/* Fall back to mapping region as ROM */
 			if (!info->mtds[i] && IS_ENABLED(CONFIG_MTD_ROM) &&
@@ -554,15 +615,17 @@ static int physmap_flash_probe(struct pl
 					 "map_probe() failed for type %s\n",
 					 info->probe_type);
 
-				info->mtds[i] = do_map_probe("map_rom",
-							     &info->maps[i]);
+				info->mtds[i] = physmap_do_map_probe(info,
+								   &info->maps[i],
+								   "map_rom");
 			}
 		} else {
 			int j;
 
 			for (j = 0; j < ARRAY_SIZE(rom_probe_types); j++) {
-				info->mtds[i] = do_map_probe(rom_probe_types[j],
-							     &info->maps[i]);
+				info->mtds[i] = physmap_do_map_probe(info,
+								   &info->maps[i],
+								   rom_probe_types[j]);
 				if (info->mtds[i])
 					break;
 			}
@@ -590,8 +653,6 @@ static int physmap_flash_probe(struct pl
 	if (err)
 		goto err_out;
 
-	spin_lock_init(&info->vpp_lock);
-
 	mtd_set_of_node(info->cmtd, dev->dev.of_node);
 	err = mtd_device_parse_register(info->cmtd, info->part_types, NULL,
 					info->parts, info->nparts);
--- a/Documentation/devicetree/bindings/mtd/mtd-physmap.yaml
+++ b/Documentation/devicetree/bindings/mtd/mtd-physmap.yaml
@@ -109,6 +109,15 @@ properties:
     description: The chip's physical erase block size in bytes.
     $ref: /schemas/types.yaml#/definitions/uint32
 
+  vpp-gpios:
+    description:
+      GPIO that controls the flash programming-voltage or write-enable input.
+      The signal must be asserted before command cycles are issued,
+      including entry into query mode and program or erase commands.
+      It may be deasserted once the command operation has completed.
+      Normal array reads do not require the signal to be asserted.
+    maxItems: 1
+
   addr-gpios:
     description:
       List of GPIO descriptors that will be used to address the MSBs address
