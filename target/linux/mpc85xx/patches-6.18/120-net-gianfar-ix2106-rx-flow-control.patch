From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kosuke Shibuya <kakiringopcneko@gmail.com>
Date: Mon, 9 Nov 2026 23:00:00 +0900
Subject: [PATCH] net: gianfar: set IX2106 RX flow-control values

IX2106 drops receive frames with the default headroom and pause time,
even with receive stashing and symmetric fixed-link pause enabled.
Select the tested threshold and pause time only for this machine;
other boards keep the existing defaults. Clamp the threshold to half
the RX ring size on IX2106.

Signed-off-by: Kosuke Shibuya <kakiringopcneko@gmail.com>
---
--- a/drivers/net/ethernet/freescale/gianfar.c
+++ b/drivers/net/ethernet/freescale/gianfar.c
@@ -103,6 +103,9 @@
 
 #define TX_TIMEOUT      (5*HZ)
 
+#define IX2106_RX_LFC_THRESHOLD	128
+#define IX2106_LFC_PTV_VALUE	256
+
 MODULE_AUTHOR("Freescale Semiconductor, Inc");
 MODULE_DESCRIPTION("Gianfar Ethernet Driver");
 MODULE_LICENSE("GPL");
@@ -146,12 +149,19 @@ static void gfar_init_rqprm(struct gfar_
 {
 	struct gfar __iomem *regs = priv->gfargrp[0].regs;
 	u32 __iomem *baddr;
+	bool ix2106 = of_machine_is_compatible("nec,ix2106");
 	int i;
 
 	baddr = &regs->rqprm0;
 	for (i = 0; i < priv->num_rx_queues; i++) {
+		u32 threshold = DEFAULT_RX_LFC_THR;
+
+		if (ix2106)
+			threshold = min_t(u32, IX2106_RX_LFC_THRESHOLD,
+					  priv->rx_queue[i]->rx_ring_size / 2);
+
 		gfar_write(baddr, priv->rx_queue[i]->rx_ring_size |
-			   (DEFAULT_RX_LFC_THR << FBTHR_SHIFT));
+			   (threshold << FBTHR_SHIFT));
 		baddr++;
 	}
 }
@@ -205,7 +215,8 @@ static void gfar_mac_rx_config(struct gf
 	gfar_write(&regs->rctrl, rctrl);
 	/* Init flow control threshold values */
 	gfar_init_rqprm(priv);
-	gfar_write(&regs->ptv, DEFAULT_LFC_PTVVAL);
+	gfar_write(&regs->ptv, of_machine_is_compatible("nec,ix2106") ?
+		   IX2106_LFC_PTV_VALUE : DEFAULT_LFC_PTVVAL);
 	rctrl |= RCTRL_LFC;
 
 	/* Init rctrl based on our settings */
