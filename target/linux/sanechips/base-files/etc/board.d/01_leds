. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
zte,zxhn-h3600)
	ucidef_set_led_wlan "wifi2g" "wifi2g" ":wlan-2ghz" "phy0tpt"
	ucidef_set_led_wlan "wifi5g" "wifi5g" "green:wlan-5ghz" "phy1tpt"
	ucidef_set_led_netdev "broadband" "broadband" ":wan" "wan" "link"
	ucidef_set_led_netdev "internet" "internet" "green:wan-online" "wan" "link tx rx"
	ucidef_set_led_usbport "usb" "USB" "green:usb" "usb1-port1" "usb2-port1"
	;;
esac

board_config_flush

exit 0
