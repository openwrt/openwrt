From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Navid Ghahremani <ghahramani.navid@gmail.com>
Date: Mon, 28 Sep 2026 00:00:00 +0100
Subject: [PATCH] net: mdio: add the ZTE ZX279128S MDIO controller

Add a driver for the MDIO bus of the ZX279128S that reaches the PHYs
of its integrated switch.

Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
---
--- a/drivers/net/mdio/Kconfig
+++ b/drivers/net/mdio/Kconfig
@@ -44,6 +44,14 @@ config MDIO_XGENE
 	  This module provides a driver for the MDIO busses found in the
 	  APM X-Gene SoC's.
 
+config MDIO_ZX279128
+	tristate "ZTE ZX279128S MDIO bus controller"
+	depends on HAS_IOMEM && OF_MDIO
+	default y
+	help
+	  This module provides a driver for the MDIO bus controller found in the
+	  ZTE / Sanechips ZX279128S SoC.
+
 config MDIO_ASPEED
 	tristate "ASPEED MDIO bus controller"
 	depends on ARCH_ASPEED || COMPILE_TEST
--- a/drivers/net/mdio/Makefile
+++ b/drivers/net/mdio/Makefile
@@ -34,3 +34,4 @@ obj-$(CONFIG_MDIO_BUS_MUX_MESON_G12A)	+=
 obj-$(CONFIG_MDIO_BUS_MUX_MESON_GXL)	+= mdio-mux-meson-gxl.o
 obj-$(CONFIG_MDIO_BUS_MUX_MMIOREG) 	+= mdio-mux-mmioreg.o
 obj-$(CONFIG_MDIO_BUS_MUX_MULTIPLEXER) 	+= mdio-mux-multiplexer.o
+obj-$(CONFIG_MDIO_ZX279128)		+= mdio-zx279128.o
--- /dev/null
+++ b/drivers/net/mdio/mdio-zx279128.c
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MDIO bus driver for ZTE / Sanechips ZX279128S SoC
+ *
+ * Copyright (C) 2026 Navid & Antigravity
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of_mdio.h>
+#include <linux/platform_device.h>
+
+#define ZX_MDIO_DATA_WR		0x04
+#define ZX_MDIO_DATA_RD		0x08
+#define ZX_MDIO_CFG		0x0c
+#define ZX_MDIO_STATUS		0x10
+#define  ZX_MDIO_DONE		BIT(0)
+#define ZX_MDIO_CMD		0x14
+#define  ZX_MDIO_CMD_REG_MASK	GENMASK(4, 0)
+#define  ZX_MDIO_CMD_ADDR_SHIFT	5
+#define  ZX_MDIO_CMD_ADDR_MASK	GENMASK(9, 5)
+#define  ZX_MDIO_CMD_WR		BIT(10)
+#define  ZX_MDIO_CMD_RD		BIT(11)
+#define  ZX_MDIO_CMD_CLK_DIV	BIT(12)
+#define  ZX_MDIO_CMD_START	BIT(14)
+
+struct zx_mdio_priv {
+	void __iomem *base;
+	struct clk *clk;
+};
+
+static int zx_mdio_wait_done(void __iomem *base)
+{
+	u32 val;
+	int ret;
+
+	ret = readl_poll_timeout_atomic(base + ZX_MDIO_STATUS, val,
+					(val & ZX_MDIO_DONE), 1, 2000);
+	if (ret)
+		return ret;
+
+	writel(0, base + ZX_MDIO_STATUS);
+	writel(readl(base + ZX_MDIO_CMD) & ~ZX_MDIO_CMD_START, base + ZX_MDIO_CMD);
+	return 0;
+}
+
+static int zx_mdio_read(struct mii_bus *bus, int addr, int regnum)
+{
+	struct zx_mdio_priv *priv = bus->priv;
+	void __iomem *base = priv->base;
+	u32 cmd;
+	int ret;
+
+	/* Clear any pending status */
+	writel(readl(base + ZX_MDIO_CMD) & ~ZX_MDIO_CMD_START, base + ZX_MDIO_CMD);
+	writel(0, base + ZX_MDIO_STATUS);
+
+	cmd = readl(base + ZX_MDIO_CMD);
+	cmd &= ~(ZX_MDIO_CMD_WR | ZX_MDIO_CMD_RD | ZX_MDIO_CMD_ADDR_MASK | ZX_MDIO_CMD_REG_MASK);
+	cmd |= ZX_MDIO_CMD_RD;
+	cmd |= ((addr & 0x1f) << ZX_MDIO_CMD_ADDR_SHIFT);
+	cmd |= (regnum & 0x1f);
+	cmd |= ZX_MDIO_CMD_START;
+
+	writel(cmd, base + ZX_MDIO_CMD);
+
+	ret = zx_mdio_wait_done(base);
+	if (ret) {
+		dev_err_ratelimited(&bus->dev, "MDIO read timeout (addr=%d, reg=%d)\n", addr, regnum);
+		return ret;
+	}
+
+	return readl(base + ZX_MDIO_DATA_RD) & 0xffff;
+}
+
+static int zx_mdio_write(struct mii_bus *bus, int addr, int regnum, u16 val)
+{
+	struct zx_mdio_priv *priv = bus->priv;
+	void __iomem *base = priv->base;
+	u32 cmd;
+	int ret;
+
+	writel(readl(base + ZX_MDIO_CMD) & ~ZX_MDIO_CMD_START, base + ZX_MDIO_CMD);
+	writel(0, base + ZX_MDIO_STATUS);
+
+	cmd = readl(base + ZX_MDIO_CMD);
+	cmd &= ~(ZX_MDIO_CMD_WR | ZX_MDIO_CMD_RD | ZX_MDIO_CMD_ADDR_MASK | ZX_MDIO_CMD_REG_MASK);
+	cmd |= ZX_MDIO_CMD_WR;
+	cmd |= ((addr & 0x1f) << ZX_MDIO_CMD_ADDR_SHIFT);
+	cmd |= (regnum & 0x1f);
+
+	writel(val, base + ZX_MDIO_DATA_WR);
+	writel(cmd | ZX_MDIO_CMD_START, base + ZX_MDIO_CMD);
+
+	ret = zx_mdio_wait_done(base);
+	if (ret) {
+		dev_err_ratelimited(&bus->dev, "MDIO write timeout (addr=%d, reg=%d)\n", addr, regnum);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int zx_mdio_probe(struct platform_device *pdev)
+{
+	struct zx_mdio_priv *priv;
+	struct mii_bus *bus;
+	u32 val;
+	int ret;
+
+	bus = devm_mdiobus_alloc_size(&pdev->dev, sizeof(*priv));
+	if (!bus)
+		return -ENOMEM;
+
+	priv = bus->priv;
+	priv->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(priv->base))
+		return PTR_ERR(priv->base);
+
+	priv->clk = devm_clk_get_optional_enabled(&pdev->dev, NULL);
+	if (IS_ERR(priv->clk))
+		return PTR_ERR(priv->clk);
+
+	/* Un-gate external ZX5201 PHY on WAN port via CRM register (0x9420000c) */
+	{
+		void __iomem *crm_reg = ioremap(0x9420000c, 4);
+		if (crm_reg) {
+			writel(readl(crm_reg) & ~(BIT(11) | BIT(19) | BIT(20)), crm_reg);
+			iounmap(crm_reg);
+			msleep(10);
+		}
+	}
+
+	/* Initialize hardware registers */
+	val = readl(priv->base + ZX_MDIO_CMD);
+	val &= ~(ZX_MDIO_CMD_START | BIT(15) | BIT(13));
+	val |= ZX_MDIO_CMD_CLK_DIV;
+	writel(val, priv->base + ZX_MDIO_CMD);
+	writel(0, priv->base + ZX_MDIO_STATUS);
+	writel(0, priv->base + ZX_MDIO_CFG);
+
+	bus->name = "zx-mdio";
+	bus->read = zx_mdio_read;
+	bus->write = zx_mdio_write;
+	snprintf(bus->id, MII_BUS_ID_SIZE, "%s", dev_name(&pdev->dev));
+	bus->parent = &pdev->dev;
+
+	/* Initialize ZX5201 PHY at MDIO 8/9 if present */
+	if ((zx_mdio_read(bus, 8, 2) & 0xffff) == 0x84b9) {
+		u16 v20, v21, v22;
+
+		dev_info(&pdev->dev, "Found Sanechips ZX5201 PHY at MDIO 8/9, initializing\n");
+		/* MDIO 8 (Copper PHY) */
+		zx_mdio_write(bus, 8, 18, 0x8402);
+		zx_mdio_write(bus, 9, 22, 0x0a0f);
+		zx_mdio_write(bus, 9, 27, 0x0800);
+		zx_mdio_write(bus, 8, 29, 0x0355);
+		zx_mdio_write(bus, 8, 16, 0xb62d);
+		zx_mdio_write(bus, 8, 17, 0x0006);
+
+		/* MDIO 9 (SerDes MAC interface) */
+		zx_mdio_write(bus, 9, 18, 0x0004);
+		v21 = zx_mdio_read(bus, 9, 21);
+		v20 = zx_mdio_read(bus, 9, 20);
+		zx_mdio_write(bus, 9, 17, (v21 & 0xc1ff) | 0x2800);
+		zx_mdio_write(bus, 9, 16, v20);
+		zx_mdio_write(bus, 9, 18, 0x0204);
+		v22 = zx_mdio_read(bus, 9, 22);
+		zx_mdio_write(bus, 9, 22, (v22 & 0xfff3) | 0x0004);
+
+		/* MDIO 8 LEDs */
+		zx_mdio_write(bus, 8, 16, 0xb409);
+		zx_mdio_write(bus, 8, 17, 0x0000);
+		zx_mdio_write(bus, 8, 16, 0xb407);
+		zx_mdio_write(bus, 8, 17, 0x0000);
+		zx_mdio_write(bus, 8, 16, 0xb406);
+		zx_mdio_write(bus, 8, 17, 0x0000);
+		zx_mdio_write(bus, 8, 16, 0xb408);
+		zx_mdio_write(bus, 8, 17, 0x0000);
+	}
+
+	ret = of_mdiobus_register(bus, pdev->dev.of_node);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to register MDIO bus: %d\n", ret);
+		return ret;
+	}
+
+	platform_set_drvdata(pdev, bus);
+	dev_info(&pdev->dev, "ZTE ZX279128S MDIO bus driver registered\n");
+	return 0;
+}
+
+static void zx_mdio_remove(struct platform_device *pdev)
+{
+	struct mii_bus *bus = platform_get_drvdata(pdev);
+
+	mdiobus_unregister(bus);
+}
+
+static const struct of_device_id zx_mdio_dt_ids[] = {
+	{ .compatible = "zte,zx279128s-mdio" },
+	{ .compatible = "zte,zx-mdio" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, zx_mdio_dt_ids);
+
+static struct platform_driver zx_mdio_driver = {
+	.probe = zx_mdio_probe,
+	.remove = zx_mdio_remove,
+	.driver = {
+		.name = "zx-mdio",
+		.of_match_table = zx_mdio_dt_ids,
+	},
+};
+module_platform_driver(zx_mdio_driver);
+
+MODULE_AUTHOR("Antigravity");
+MODULE_DESCRIPTION("ZTE ZX279128S MDIO bus driver");
+MODULE_LICENSE("GPL");
