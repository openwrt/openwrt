From 7045b54d4fc6cc6b383482c5e435bc0491b13ce2 Mon Sep 17 00:00:00 2001
From: Zoltan HERPAI <wigyori@uid0.hu>
Date: Tue, 15 Sep 2026 18:32:14 +0200
Subject: [PATCH] arm64: dts: imx8mp-olimex: status leds

Add the status LED aliases.
---
 arch/arm64/boot/dts/freescale/imx8mp-olimex-som-evb.dts | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

--- a/arch/arm64/boot/dts/freescale/imx8mp-olimex-som-evb.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-olimex-som-evb.dts
@@ -15,6 +15,13 @@
 	model = "Olimex i.MX8MP-SOM-EVB";
 	compatible = "olimex,imx8mp-som-evb", "fsl,imx8mp";
 
+	aliases {
+		led-boot = &led_status;
+		led-failsafe = &led_status;
+		led-running = &led_status;
+		led-upgrade = &led_status;
+	};
+
 	chosen {
 		stdout-path = &uart2;
 	};
@@ -24,7 +31,7 @@
 		pinctrl-names = "default";
 		pinctrl-0 = <&pinctrl_gpio_led>;
 
-		status {
+		led_status: status {
 			color = <LED_COLOR_ID_YELLOW>;
 			function = LED_FUNCTION_STATUS;
 			gpios = <&gpio3 16 GPIO_ACTIVE_HIGH>;
