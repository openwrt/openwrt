From 75b911ddc15ecf4f11a7cb537488d7349d99c313 Mon Sep 17 00:00:00 2001
From: Luka Perkov <luka@openwrt.org>
Date: Mon, 15 Jul 2013 00:03:40 +0000
Subject: [PATCH] ARM: dts: imx6dl-wandboard: set console bootargs

Add a chosen node to set "console=ttymxc0,115200" as boot arguments.
---
--- a/arch/arm/boot/dts/nxp/imx/imx6dl-wandboard.dts
+++ b/arch/arm/boot/dts/nxp/imx/imx6dl-wandboard.dts
@@ -16,4 +16,8 @@
 		device_type = "memory";
 		reg = <0x10000000 0x40000000>;
 	};
+
+	chosen {
+		bootargs = "console=ttymxc0,115200";
+	};
 };
