/dts-v1/;
#include "alpine-al31400.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Check Point L-72";
	compatible = "checkpoint,l-72", "annapurna-labs,alpine";

	aliases {
		led-boot = &led_alarm_green;
		led-failsafe = &led_alarm_red;
		led-running = &led_power_green;
		led-upgrade = &led_disk_green;
		serial0 = &uart0;
	};

	keys {
		compatible = "gpio-keys";

		button-reset {
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
			gpios = <&gpio5 5 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_alarm_green: alarm-green {
			function = LED_FUNCTION_ALARM;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio5 2 GPIO_ACTIVE_HIGH>;
		};

		led_alarm_red: alarm-red {
			function = LED_FUNCTION_ALARM;
			color = <LED_COLOR_ID_RED>;
			gpios = <&gpio5 3 GPIO_ACTIVE_HIGH>;
		};

		led_disk_green: disk-green {
			function = LED_FUNCTION_DISK;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio5 4 GPIO_ACTIVE_HIGH>;
		};

		led_internet_green: internet-green {
			function = LED_FUNCTION_WAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&expander_u71 7 GPIO_ACTIVE_HIGH>;
		};

		led_internet_red: internet-red {
			function = LED_FUNCTION_WAN;
			color = <LED_COLOR_ID_RED>;
			gpios = <&expander_u71 6 GPIO_ACTIVE_HIGH>;
		};

		led_power_green: power-green {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio5 0 GPIO_ACTIVE_LOW>;
		};

		led_power_red: power-red {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_RED>;
			gpios = <&gpio5 1 GPIO_ACTIVE_HIGH>;
		};

		led_usb_green: usb-green {
			function = LED_FUNCTION_USB;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&expander_u71 5 GPIO_ACTIVE_HIGH>;
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x80000000>;
	};
};

&eth0 {		/* 2.5G SGMII uplink -> DX3234 */
	status = "okay";
	al,media-type = <6>;
	al,serdes-grp = <3>;
	al,serdes-lane = <3>;
	al,mdio-freq = <1>;
	al,an-disable;
};

&eth1 {
	status = "okay";
	al,media-type = <1>;
	al,mdio-freq = <0>;
};

&eth1_mdio {
	eth1_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		interrupt-parent = <&gpio4>;
		interrupts = <6 IRQ_TYPE_LEVEL_LOW>;
	};
};

&eth2 {		/* 2.5G SGMII uplink -> DX3234 */
	status = "okay";
	al,media-type = <6>;
	al,serdes-grp = <3>;
	al,serdes-lane = <1>;
	al,mdio-freq = <1>;
	al,an-disable;
};

&i2c0 {
	status = "okay";

	expander_u59: gpio@22 {
		compatible = "nxp,pca9555";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	expander_u68: gpio@24 {
		compatible = "nxp,pca9555";
		reg = <0x24>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	expander_u70: gpio@20 {
		compatible = "nxp,pcf8575";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	expander_u71: gpio@21 {
		compatible = "nxp,pcf8575";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	hwmon@2b {
		compatible = "nuvoton,nct7802";
		reg = <0x2b>;
	};

	hwmon@2c {
		compatible = "nuvoton,nct7802";
		reg = <0x2c>;
	};

	rtc@68 {
		compatible = "dallas,ds1337";
		reg = <0x68>;
	};
};

&nand {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "u-boot";
			reg = <0x00000000 0x00280000>;
			read-only;
		};

		partition@280000 {
			label = "u-boot-env";
			reg = <0x00280000 0x00080000>;
		};

		partition@300000 {
			label = "checkpoint-settings";
			reg = <0x00300000 0x00080000>;
			read-only;
		};

		partition@380000 {
			label = "kernel";
			reg = <0x00380000 0x01000000>;
		};

		partition@1380000 {
			label = "ubi";
			reg = <0x01380000 0x7ec80000>;
		};
	};
};

&uart0 {
	status = "okay";
};
