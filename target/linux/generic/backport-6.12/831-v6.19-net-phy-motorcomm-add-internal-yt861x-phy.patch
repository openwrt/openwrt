 /**
+ * yt861x_config_init() - initialize the internal PHY
+ * @phydev: a pointer to a &struct phy_device
+ *
+ * Apply the vendor init sequence required by the internal YT861x PHYs on a
+ * YT921x switch. Auto sleep is disabled by default on these PHYs and a BMCR
+ * soft reset does not restore it, so apply the setting from config_init. It
+ * can be disabled with the "motorcomm,auto-sleep-disabled" device property.
+ *
+ * Returns: 0 or negative errno code
+ */
+static int yt861x_config_init(struct phy_device *phydev)
+{
+	static const struct {
+		u16 reg;
+		u16 val;
+	} lan_phys[] = {
+		{ 0x51,  0x14e6 },
+		{ 0x57,  0x2774 },
+		{ 0x12,  0x24c0 },
+	};
+	static const struct {
+		u16 reg;
+		u16 val;
+	} all_phys[] = {
+		{ 0x50,  0x411a },
+		{ 0x400, 0x121a },
+		{ 0x401, 0xc145 },
+		{ 0x00,  0x1c08 },
+	};
+	bool sleep;
+	int i, ret;
+
+	if (phydev->mdio.addr <= 2) {
+		for (i = 0; i < ARRAY_SIZE(lan_phys); i++) {
+			ret = ytphy_write_ext_with_lock(phydev, lan_phys[i].reg,
+							lan_phys[i].val);
+			if (ret)
+				return ret;
+		}
+	}
+
+	for (i = 0; i < ARRAY_SIZE(all_phys); i++) {
+		ret = ytphy_write_ext_with_lock(phydev, all_phys[i].reg,
+						all_phys[i].val);
+		if (ret)
+			return ret;
+	}
+
+	sleep = !device_property_read_bool(&phydev->mdio.dev,
+					   "motorcomm,auto-sleep-disabled");
+
+	return ytphy_modify_ext_with_lock(phydev,
+					 YT8521_EXTREG_SLEEP_CONTROL1_REG,
+					 YT8521_ESC1R_SLEEP_SW,
+					 sleep ? YT8521_ESC1R_SLEEP_SW : 0);
+}
