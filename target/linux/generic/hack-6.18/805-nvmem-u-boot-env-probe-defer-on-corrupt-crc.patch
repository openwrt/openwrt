From 2806a9cb2562d10eb3ef081de5645e79c5ad71ab Mon Sep 17 00:00:00 2001
From: Michael Pratt <mcpratt@pm.me>
Date: Tue, 18 Aug 2026 23:27:20 -0400
Subject: [PATCH] nvmem: layouts: u-boot-env: optionally defer probe on CRC error

Return -EPROBE_DEFER instead of -EINVAL on a CRC mismatch if the device
tree node has the allow-probe-defer property, so that probing is retried
later instead of failing permanently.
---
--- a/drivers/nvmem/layouts/u-boot-env.c
+++ b/drivers/nvmem/layouts/u-boot-env.c
@@ -133,6 +133,7 @@ static int u_boot_env_parse_cells(struct
 int u_boot_env_parse(struct device *dev, struct nvmem_device *nvmem,
 		     enum u_boot_env_format format)
 {
+	struct device_node *np = dev->of_node;
 	size_t crc32_data_offset;
 	size_t crc32_data_len;
 	size_t crc32_offset;
@@ -197,7 +198,7 @@ int u_boot_env_parse(struct device *dev,
 	calc = crc32_le(~0, buf + crc32_data_offset, crc32_data_len) ^ ~0L;
 	if (calc != crc32) {
 		dev_err(dev, "Invalid calculated CRC32: 0x%08x (expected: 0x%08x)\n", calc, crc32);
-		err = -EINVAL;
+		err = of_property_read_bool(np, "allow-probe-defer") ? -EPROBE_DEFER : -EINVAL;
 		goto err_kfree;
 	}
 
