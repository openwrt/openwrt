From d9116582e5425b97ec84736e84b0662afeaed968 Mon Sep 17 00:00:00 2001
From: Mieczyslaw Nalewaj <namiltd@yahoo.com>
Date: Sat, 19 Sep 2026 12:00:00 +0200
Subject: [PATCH 8/8] net: dsa: realtek: rtl8365mb: re-latch the family D
 SerDes from the PCS poll

With the previous patch the trunk on a TP-Link Archer AX55 v1 (IPQ5018 +
RTL8367S-VB) reports 2.5Gbps/Full on both sides but moves no frames: the
CPU MAC transmits, s00_p06_ifInOctets stays at zero and so does
mmc_rx_framecount_gb, with no CRC, alignment or FIFO errors.

The receiver latches on the DISABLE -> HSGMII edge in SDS_MISC rather
than on the value, and it will not latch until the MAC at the other end
of the trunk has brought its own half of the link up. On this board the
two are far apart:

  5.27  rtl8365mb: configuring for fixed/2500base-x   <- pcs_config()
  7.72  ipq5018-gmac-dwmac eth0: configuring for fixed/2500base-x
  8.02  ipq5018-gmac-dwmac eth0: Link is Up - 2.5Gbps/Full
  8.56  SerDes latches

pcs_config() runs seconds before the SoC MAC even starts configuring,
so the edge cannot be driven from there, whatever the sequence. Neither
from pcs_link_up(), which fires about a millisecond before phylink
reports the switch-side link and is still seconds early.

Bit 8 of the SDS link-status word reports far-end signal presence
independently of the latched link bit: it reads 0x0100 as soon as the
far end signals, and stays so until the receiver latches. Drive the
edge from rtl8365mb_pcs_get_state() - the periodic re-evaluation point
phylink already runs for this PCS (mb->pcs.poll) - whenever far-end
presence is observed without a latched link. Each subsequent PCS poll
re-evaluates the condition; once the receiver latches, state->link goes
up and requests stop. There is no private retry timer and no attempt
budget: persistence comes from the poll loop phylink runs anyway.

The edge itself (park for 20 ms, then restore the target mode) is
performed by a short one-shot work: sleeping is not permitted in the
PCS ops, and the work also serializes against pcs_config() re-runs,
which cancel it. The work carries no decision logic; the next poll
observes the result.

The work is cancelled in teardown(), and in pcs_config() before
SDS_MISC is touched, since a link that flaps would otherwise re-arm
the sequence against a half-reconfigured SerDes.

Co-developed-by: Oleg Gavrilov <gabonpivovich@gmail.com>
Signed-off-by: Oleg Gavrilov <gabonpivovich@gmail.com>
Signed-off-by: Mieczyslaw Nalewaj <namiltd@yahoo.com>
---
 drivers/net/dsa/realtek/rtl8365mb_main.c | 229 ++++++++++++++++++++---
 1 file changed, 202 insertions(+), 27 deletions(-)

--- a/drivers/net/dsa/realtek/rtl8365mb_main.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_main.c
@@ -103,6 +103,7 @@
 #include <linux/if_bridge.h>
 #include <linux/if_vlan.h>
 #include <linux/phylink.h>
+#include <linux/workqueue.h>
 
 #include "realtek.h"
 #include "realtek-smi.h"
@@ -285,6 +286,18 @@
 #define   RTL8365MB_SDS_MISC_SGMII_SPD_MASK		0x0180
 #define   RTL8365MB_SDS_MISC_MAC8_SEL_SGMII_MASK	0x0040
 
+/* Family D SerDes re-latch: bit 8 of the SDS link-status word reports
+ * far-end signal presence independently of the latched link bit. On
+ * RTL8367S-VB it reads 0x0100 as soon as the far end signals, and stays
+ * so until the receiver latches.
+ */
+#define RTL8365MB_D_SDS_LINK_STATUS_FAR_END_MASK	0x0100
+
+/* Throttle for re-latch requests; matches the phylink PCS poll period
+ * and only guards against bursts (e.g. link flaps).
+ */
+#define RTL8365MB_D_SDS_RELATCH_THROTTLE	(HZ)
+
 /* SerDes internal registers, accessed via the SDS_INDACS registers. The BMCR
  * data path reset holds BMCR_ANENABLE | BMCR_ISOLATE while toggling the
  * vendor-specific low bits from phase 1 to phase 2, which triggers a data path
@@ -930,9 +943,18 @@ struct rtl8365mb {
 	const struct rtl8365mb_chip_info *chip_info;
 	struct rtl8365mb_cpu cpu;
 	struct mutex mib_lock;
+	/* Serializes access to the shared SDS_INDACS ADR/CMD/DATA window and
+	 * to RTL8365MB_SDS_MISC_REG, reachable both from phylink's PCS poll
+	 * (mb->pcs.poll) and from the family D SerDes re-latch work.
+	 */
+	struct mutex sds_lock;
 	struct rtl8365mb_port ports[RTL8365MB_MAX_NUM_PORTS];
 	struct phylink_pcs pcs;
 	bool sds_supported;
+	struct delayed_work sds_relatch;	/* one-shot edge executor */
+	unsigned long sds_relatch_last;		/* throttle timestamp */
+	unsigned int sds_relatch_count;		/* diagnostics only */
+	u32 sds_misc_target_val;
 };
 
 #define pcs_to_rtl8365mb(_pcs) container_of((_pcs), struct rtl8365mb, pcs)
@@ -1274,43 +1296,53 @@ static int rtl8365mb_ext_config_rgmii(st
 static int rtl8365mb_sds_write(struct realtek_priv *priv, u8 index,
 			       u16 addr, u16 data)
 {
+	struct rtl8365mb *mb = priv->chip_data;
 	int ret;
 
+	mutex_lock(&mb->sds_lock);
+
 	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_DATA_REG, data);
 	if (ret)
-		return ret;
+		goto out_unlock;
 
 	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_ADR_REG, addr);
 	if (ret)
-		return ret;
+		goto out_unlock;
 
 	/* The SerDes indirect access engine completes the command within the
 	 * register write transaction, so there is no need to wait or poll for
 	 * completion before the next access, matching the vendor driver.
 	 */
-	return regmap_write(priv->map, RTL8365MB_SDS_INDACS_CMD_REG,
-			    RTL8365MB_SDS_INDACS_CMD_RUN_MASK |
-			    RTL8365MB_SDS_INDACS_CMD_WR_MASK |
-			    FIELD_PREP(RTL8365MB_SDS_INDACS_CMD_INDEX_MASK,
-				       index));
+	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_CMD_REG,
+			   RTL8365MB_SDS_INDACS_CMD_RUN_MASK |
+			   RTL8365MB_SDS_INDACS_CMD_WR_MASK |
+			   FIELD_PREP(RTL8365MB_SDS_INDACS_CMD_INDEX_MASK,
+				      index));
+
+out_unlock:
+	mutex_unlock(&mb->sds_lock);
+	return ret;
 }
 
 static int rtl8365mb_sds_read(struct realtek_priv *priv, u8 index,
 			      u16 addr, u16 *data)
 {
+	struct rtl8365mb *mb = priv->chip_data;
 	u32 val;
 	int ret;
 
+	mutex_lock(&mb->sds_lock);
+
 	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_ADR_REG, addr);
 	if (ret)
-		return ret;
+		goto out_unlock;
 
 	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_CMD_REG,
 			   RTL8365MB_SDS_INDACS_CMD_RUN_MASK |
 			   FIELD_PREP(RTL8365MB_SDS_INDACS_CMD_INDEX_MASK,
 				      index));
 	if (ret)
-		return ret;
+		goto out_unlock;
 
 	/* Wait for the indirect read to complete: the engine clears the BUSY
 	 * bit once the data register holds the result.
@@ -1320,15 +1352,19 @@ static int rtl8365mb_sds_read(struct rea
 				       !(val & RTL8365MB_SDS_INDACS_CMD_BUSY_MASK),
 				       10, 1000);
 	if (ret)
-		return ret;
+		goto out_unlock;
 
 	ret = regmap_read(priv->map, RTL8365MB_SDS_INDACS_DATA_REG, &val);
 	if (ret)
-		return ret;
+		goto out_unlock;
 
 	*data = val;
 
-	return 0;
+	ret = 0;
+
+out_unlock:
+	mutex_unlock(&mb->sds_lock);
+	return ret;
 }
 
 /* The vendor driver selects between two sets of SerDes tuning parameters based
@@ -1450,6 +1486,13 @@ static int rtl8365mb_pcs_config(struct p
 
 	is_d = rtl8365mb_get_family(priv) == RTL8365MB_FAMILY_D;
 
+	/* Cancel any in-flight re-latch edge before touching SDS_MISC: the
+	 * work drops sds_lock across its sleep and could otherwise interleave
+	 * with the reconfiguration below.
+	 */
+	if (is_d)
+		cancel_delayed_work_sync(&mb->sds_relatch);
+
 	/* Select the appropriate tuning table and SDS mode */
 	if (interface == PHY_INTERFACE_MODE_2500BASEX) {
 		if (is_d) {
@@ -1517,10 +1560,6 @@ static int rtl8365mb_pcs_config(struct p
 		if (ret)
 			return ret;
 
-		misc_mask = RTL8365MB_D_SDS_MISC_PA33PC_EN |
-			    RTL8365MB_D_SDS_MISC_PA12PC_EN |
-			    RTL8365MB_D_SDS_MISC_MODE_FIELD_MASK |
-			    RTL8365MB_D_SDS_MISC_MAC6_SEL_SDS0;
 		misc_val  = RTL8365MB_D_SDS_MISC_PA33PC_EN |
 			    RTL8365MB_D_SDS_MISC_PA12PC_EN |
 			    RTL8365MB_D_SDS_MISC_MAC6_SEL_SDS0 | sds_mode;
@@ -1533,12 +1572,33 @@ static int rtl8365mb_pcs_config(struct p
 			    RTL8365MB_SDS_MISC_MAC8_SEL_HSGMII_MASK;
 	}
 
-	ret = regmap_update_bits(priv->map, RTL8365MB_SDS_MISC_REG,
-				 misc_mask, misc_val);
-	if (ret)
-		return ret;
+	if (is_d) {
+		/* Full write rather than update_bits: misc_val carries every
+		 * field of SDS_MISC that matters here (the PA enables,
+		 * MAC6_SEL_SDS0 and the mode), and comes out as 0x0E12 for
+		 * HSGMII - the same value the stock firmware holds with the
+		 * trunk up.
+		 *
+		 * The receiver latches on a DISABLE -> mode edge rather than
+		 * on the value; that edge is driven later by the re-latch
+		 * work once the far end is signalling (see
+		 * rtl8365mb_sds_relatch_work()).
+		 */
+		mutex_lock(&mb->sds_lock);
+		ret = regmap_write(priv->map, RTL8365MB_SDS_MISC_REG, misc_val);
+		mutex_unlock(&mb->sds_lock);
+		if (ret)
+			return ret;
+
+		WRITE_ONCE(mb->sds_misc_target_val, misc_val);
+	} else {
+		mutex_lock(&mb->sds_lock);
+		ret = regmap_update_bits(priv->map, RTL8365MB_SDS_MISC_REG,
+					 misc_mask, misc_val);
+		mutex_unlock(&mb->sds_lock);
+		if (ret)
+			return ret;
 
-	if (!is_d) {
 		val = sds_mode << RTL8365MB_DIGITAL_INTERFACE_SELECT_MODE_OFFSET(id);
 		ret = regmap_update_bits(priv->map,
 					 RTL8365MB_DIGITAL_INTERFACE_SELECT_REG(id),
@@ -1585,8 +1645,91 @@ static int rtl8365mb_pcs_config(struct p
 	val &= ~RTL8365MB_SDS_NWAY_EN_MASK;
 	val |= RTL8365MB_SDS_NWAY_RESTART_MASK;
 
-	return rtl8365mb_sds_write(priv, sds_index,
-				   RTL8365MB_SDS_REG_NWAY, val);
+	ret = rtl8365mb_sds_write(priv, sds_index,
+				  RTL8365MB_SDS_REG_NWAY, val);
+	if (ret)
+		return ret;
+
+	if (is_d)
+		/* Allow the next PCS poll to request a re-latch edge
+		 * without waiting out the throttle.
+		 */
+		WRITE_ONCE(mb->sds_relatch_last,
+			   jiffies - RTL8365MB_D_SDS_RELATCH_THROTTLE);
+
+	return 0;
+}
+
+/* The family D receiver latches on a DISABLE -> mode edge in SDS_MISC
+ * rather than on the value, and only once the far-end MAC has brought up
+ * its half of the link. Bit 8 of the SDS link-status word reports far-end
+ * signal presence independently of the latched link bit, so
+ * rtl8365mb_pcs_get_state() - which phylink calls periodically for this
+ * PCS (mb->pcs.poll) - drives the edge whenever it observes far-end
+ * presence without a latched link. Each subsequent PCS poll re-evaluates
+ * the condition; once the receiver latches, state->link goes up and
+ * requests stop. There is no private retry timer or attempt budget:
+ * persistence comes from the poll loop phylink runs anyway.
+ */
+
+static void rtl8365mb_sds_relatch_schedule(struct rtl8365mb *mb)
+{
+	unsigned long last;
+
+	if (delayed_work_pending(&mb->sds_relatch))
+		return;
+
+	last = READ_ONCE(mb->sds_relatch_last);
+	if (time_before(jiffies, last + RTL8365MB_D_SDS_RELATCH_THROTTLE))
+		return;
+
+	WRITE_ONCE(mb->sds_relatch_last, jiffies);
+	/* Diagnostics-only counter; an occasional lost increment under
+	 * concurrent scheduling is harmless and not worth a lock.
+	 */
+	mb->sds_relatch_count++;
+	schedule_delayed_work(&mb->sds_relatch, 0);
+}
+
+/* Drive a single DISABLE -> target edge on SDS_MISC. Whether the receiver
+ * latched is evaluated by the next phylink PCS poll in
+ * rtl8365mb_pcs_get_state(); this work performs the edge only.
+ */
+static void rtl8365mb_sds_relatch_work(struct work_struct *work)
+{
+	struct rtl8365mb *mb = container_of(to_delayed_work(work),
+					    struct rtl8365mb, sds_relatch);
+	struct realtek_priv *priv = mb->priv;
+	u32 park = (READ_ONCE(mb->sds_misc_target_val) &
+		    ~RTL8365MB_D_SDS_MISC_MODE_FIELD_MASK) |
+		   RTL8365MB_D_PORT_SDS_MODE_DISABLE;
+	int ret;
+
+	mutex_lock(&mb->sds_lock);
+	ret = regmap_write(priv->map, RTL8365MB_SDS_MISC_REG, park);
+	mutex_unlock(&mb->sds_lock);
+	if (ret) {
+		dev_err_ratelimited(priv->dev,
+				    "failed to park SDS_MISC: %pe\n",
+				    ERR_PTR(ret));
+		return;
+	}
+
+	msleep(20);
+
+	mutex_lock(&mb->sds_lock);
+	ret = regmap_write(priv->map, RTL8365MB_SDS_MISC_REG,
+			   READ_ONCE(mb->sds_misc_target_val));
+	mutex_unlock(&mb->sds_lock);
+	if (ret) {
+		dev_err_ratelimited(priv->dev,
+				    "failed to restore SDS_MISC: %pe\n",
+				    ERR_PTR(ret));
+		return;
+	}
+
+	dev_dbg(priv->dev, "SerDes re-latch edge driven (attempt %u)\n",
+		mb->sds_relatch_count);
 }
 
 static bool rtl8365mb_interface_is_serdes(phy_interface_t interface)
@@ -1612,9 +1755,12 @@ static void rtl8365mb_pcs_get_state(stru
 	struct realtek_priv *priv = mb->priv;
 	u8 sds_index = 0;
 	u16 status;
+	bool is_d;
 	u32 val;
 	int ret;
 
+	is_d = rtl8365mb_get_family(priv) == RTL8365MB_FAMILY_D;
+
 	/* In-band autonegotiation is not implemented, so the link parameters are
 	 * forced from rtl8365mb_pcs_link_up(). The real link state must still be
 	 * read from the SerDes itself: the embedded DW8051 microcontroller that
@@ -1622,7 +1768,7 @@ static void rtl8365mb_pcs_get_state(stru
 	 * rtl8365mb_pcs_config()), so the link status register can be read
 	 * directly through the SDS_INDACS window without racing the auto-poll.
 	 */
-	if (rtl8365mb_get_family(priv) == RTL8365MB_FAMILY_D)
+	if (is_d)
 		sds_index = RTL8365MB_D_SDS_EXT0_INDEX;
 
 	ret = rtl8365mb_sds_read(priv, sds_index,
@@ -1634,16 +1780,31 @@ static void rtl8365mb_pcs_get_state(stru
 
 	state->link = !!(status & RTL8365MB_SDS_LINK_STATUS_LINK_MASK);
 	state->an_complete = state->link;
-	if (!state->link)
-		return;
+	if (is_d) {
+		if (!state->link) {
+			/* Not latched yet. If the far end is already
+			 * signalling, request a DISABLE -> mode edge; the
+			 * next poll observes the result. As long as the
+			 * condition (far-end present, no link) holds, each
+			 * PCS poll re-arms the edge, and the moment the
+			 * receiver latches, state->link goes up and requests
+			 * stop.
+			 */
+			if (READ_ONCE(mb->sds_misc_target_val) &&
+			    (status & RTL8365MB_D_SDS_LINK_STATUS_FAR_END_MASK))
+				rtl8365mb_sds_relatch_schedule(mb);
+			return;
+		}
 
-	if (rtl8365mb_get_family(priv) == RTL8365MB_FAMILY_D) {
 		state->duplex = DUPLEX_FULL;
 		state->speed = state->interface == PHY_INTERFACE_MODE_2500BASEX ?
 				SPEED_2500 : SPEED_1000;
 		return;
 	}
 
+	if (!state->link)
+		return;
+
 	/* The speed and duplex are forced; read them back from the values
 	 * programmed into the SerDes MISC register.
 	 */
@@ -2017,11 +2178,13 @@ static void rtl8365mb_phylink_mac_link_u
 			if (rx_pause)
 				val |= RTL8365MB_SDS_MISC_SGMII_RXFC_MASK;
 
+			mutex_lock(&mb->sds_lock);
 			ret = regmap_update_bits(priv->map,
 						 RTL8365MB_SDS_MISC_REG,
 						 RTL8365MB_SDS_MISC_SGMII_TXFC_MASK |
 							 RTL8365MB_SDS_MISC_SGMII_RXFC_MASK,
 						 val);
+			mutex_unlock(&mb->sds_lock);
 			if (ret)
 				dev_err(priv->dev,
 					"failed to force SerDes pause modes on port %d: %pe\n",
@@ -3233,6 +3396,10 @@ static int rtl8365mb_setup(struct dsa_sw
 	 */
 	mb->pcs.poll = true;
 
+	if (rtl8365mb_get_family(priv) == RTL8365MB_FAMILY_D)
+		INIT_DELAYED_WORK(&mb->sds_relatch,
+				  rtl8365mb_sds_relatch_work);
+
 	ret = rtl8365mb_reset_chip(priv);
 	if (ret) {
 		dev_err(priv->dev, "failed to reset chip: %pe\n",
@@ -3417,6 +3584,10 @@ out_error:
 static void rtl8365mb_teardown(struct dsa_switch *ds)
 {
 	struct realtek_priv *priv = ds->priv;
+	struct rtl8365mb *mb = priv->chip_data;
+
+	if (rtl8365mb_get_family(priv) == RTL8365MB_FAMILY_D)
+		cancel_delayed_work_sync(&mb->sds_relatch);
 
 	rtl8365mb_stats_teardown(priv);
 	rtl8365mb_irq_teardown(priv);
@@ -3487,6 +3658,10 @@ static int rtl8365mb_detect(struct realt
 	else
 		priv->num_ports = RTL8365MB_MAX_NUM_PORTS;
 
+	ret = devm_mutex_init(priv->dev, &mb->sds_lock);
+	if (ret)
+		return ret;
+
 	mb->priv = priv;
 	mb->cpu.trap_port = RTL8365MB_MAX_NUM_PORTS;
 	mb->cpu.insert = RTL8365MB_CPU_INSERT_TO_ALL;
