From: Julius Bairaktaris <julius@bairaktaris.de>
Subject: [PATCH] net: dsa: forward devlink trap group and policer ops

A switch that sends trapped frames to the CPU through queues it can
rate-limit offers devlink trap policers, but DSA does not forward the
trap group and policer ops. Forward them to the switch driver.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
--- a/include/net/dsa.h
+++ b/include/net/dsa.h
@@ -1223,6 +1223,21 @@ struct dsa_switch_ops {
 	int	(*devlink_trap_drop_counter_get)(struct dsa_switch *ds,
 						 const struct devlink_trap *trap,
 						 u64 *p_drops);
+	int	(*devlink_trap_group_init)(struct dsa_switch *ds,
+					   const struct devlink_trap_group *group);
+	int	(*devlink_trap_group_set)(struct dsa_switch *ds,
+					  const struct devlink_trap_group *group,
+					  const struct devlink_trap_policer *policer,
+					  struct netlink_ext_ack *extack);
+	int	(*devlink_trap_policer_init)(struct dsa_switch *ds,
+					     const struct devlink_trap_policer *policer);
+	int	(*devlink_trap_policer_set)(struct dsa_switch *ds,
+					    const struct devlink_trap_policer *policer,
+					    u64 rate, u64 burst,
+					    struct netlink_ext_ack *extack);
+	int	(*devlink_trap_policer_counter_get)(struct dsa_switch *ds,
+						    const struct devlink_trap_policer *policer,
+						    u64 *p_drops);
 
 	/*
 	 * MTU change functionality. Switches can also adjust their MRU through
--- a/net/dsa/devlink.c
+++ b/net/dsa/devlink.c
@@ -216,6 +216,68 @@ static int dsa_devlink_trap_drop_counter
 	return ds->ops->devlink_trap_drop_counter_get(ds, trap, p_drops);
 }
 
+static int dsa_devlink_trap_group_init(struct devlink *dl,
+				       const struct devlink_trap_group *group)
+{
+	struct dsa_switch *ds = dsa_devlink_to_ds(dl);
+
+	if (!ds->ops->devlink_trap_group_init)
+		return 0;
+
+	return ds->ops->devlink_trap_group_init(ds, group);
+}
+
+static int dsa_devlink_trap_group_set(struct devlink *dl,
+				      const struct devlink_trap_group *group,
+				      const struct devlink_trap_policer *policer,
+				      struct netlink_ext_ack *extack)
+{
+	struct dsa_switch *ds = dsa_devlink_to_ds(dl);
+
+	if (!ds->ops->devlink_trap_group_set)
+		return -EOPNOTSUPP;
+
+	return ds->ops->devlink_trap_group_set(ds, group, policer, extack);
+}
+
+static int dsa_devlink_trap_policer_init(struct devlink *dl,
+					 const struct devlink_trap_policer *policer)
+{
+	struct dsa_switch *ds = dsa_devlink_to_ds(dl);
+
+	if (!ds->ops->devlink_trap_policer_init)
+		return 0;
+
+	return ds->ops->devlink_trap_policer_init(ds, policer);
+}
+
+static int dsa_devlink_trap_policer_set(struct devlink *dl,
+					const struct devlink_trap_policer *policer,
+					u64 rate, u64 burst,
+					struct netlink_ext_ack *extack)
+{
+	struct dsa_switch *ds = dsa_devlink_to_ds(dl);
+
+	if (!ds->ops->devlink_trap_policer_set)
+		return -EOPNOTSUPP;
+
+	return ds->ops->devlink_trap_policer_set(ds, policer, rate, burst,
+						 extack);
+}
+
+static int
+dsa_devlink_trap_policer_counter_get(struct devlink *dl,
+				     const struct devlink_trap_policer *policer,
+				     u64 *p_drops)
+{
+	struct dsa_switch *ds = dsa_devlink_to_ds(dl);
+
+	if (!ds->ops->devlink_trap_policer_counter_get)
+		return -EOPNOTSUPP;
+
+	return ds->ops->devlink_trap_policer_counter_get(ds, policer, p_drops);
+}
+
 static const struct devlink_ops dsa_devlink_ops = {
 	.info_get			= dsa_devlink_info_get,
 	.flash_update			= dsa_devlink_flash_update,
@@ -232,6 +294,11 @@ static const struct devlink_ops dsa_devl
 	.trap_init			= dsa_devlink_trap_init,
 	.trap_action_set		= dsa_devlink_trap_action_set,
 	.trap_drop_counter_get		= dsa_devlink_trap_drop_counter_get,
+	.trap_group_init		= dsa_devlink_trap_group_init,
+	.trap_group_set			= dsa_devlink_trap_group_set,
+	.trap_policer_init		= dsa_devlink_trap_policer_init,
+	.trap_policer_set		= dsa_devlink_trap_policer_set,
+	.trap_policer_counter_get	= dsa_devlink_trap_policer_counter_get,
 };
 
 int dsa_devlink_param_get(struct devlink *dl, u32 id,
