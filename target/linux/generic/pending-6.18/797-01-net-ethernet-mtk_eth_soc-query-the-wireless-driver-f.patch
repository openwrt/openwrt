 		if (found ||
 		    !mtk_flow_entry_match(ppe->eth, entry, &foe, entry_len)) {
@@ -817,9 +1059,16 @@ void __mtk_ppe_check_skb(struct mtk_ppe
 			continue;
 		}
 
+		found = true;
+		if (!mtk_foe_entry_set_prio(ppe, entry, &entry->data, dscp)) {
+			entry->hash = 0xffff;
+			continue;
+		}
