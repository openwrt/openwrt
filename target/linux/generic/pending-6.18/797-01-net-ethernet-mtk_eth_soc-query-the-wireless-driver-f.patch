+void mtk_flow_offload_unbind_wcid(struct mtk_eth *eth, int wed_index, u16 wcid,
+				  struct mtk_flow_match *match)
+{
+	mtk_flow_offload_walk_wcid(eth, wed_index, wcid,
+				   mtk_flow_entry_unbind_cb, match);
+}
