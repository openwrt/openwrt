+/* @rx is set for an entry that carries the frames of the station */
+static bool
+mtk_flow_entry_wcid_match(struct mtk_flow_entry *entry, int wed_index, u16 wcid,
+			  bool *rx)
+{
+	*rx = false;
+	if (entry->wed_index == wed_index && entry->wcid == wcid)
+		return true;
+
+	*rx = true;
