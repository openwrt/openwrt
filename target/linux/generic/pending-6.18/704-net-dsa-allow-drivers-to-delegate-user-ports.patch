 EXPORT_SYMBOL_GPL(dsa_port_phylink_mac_change);
 
+/**
+ * dsa_port_set_delegated() - set DSA user-port ownership
+ * @dp: user port
+ * @delegated: desired delegation state
+ * @extack: optional error-reporting context
+ *
+ * Setting delegation transfers the data and configuration plane to the switch
+ * driver.  DSA keeps phylink and the switch port enabled, but detaches the
+ * local user netdevice and drops packets racing either data path.  The port
+ * must be up, standalone and have no uppers.  Before clearing delegation, the
+ * caller must restore normal hardware ownership.  If userspace closed the
+ * user netdevice while it was delegated, DSA completes the deferred host
+ * address, port and phylink shutdown instead of reopening it.
+ *
+ * The operation is idempotent so desired-state control planes can safely
+ * retry it.
+ *
+ * Context: RTNL must be held.
+ */
+int dsa_port_set_delegated(struct dsa_port *dp, bool delegated,
+			   struct netlink_ext_ack *extack)
+{
+	struct net_device *user;
+	int err;
+
+	ASSERT_RTNL();
+
+	if (!dp || !dsa_port_is_user(dp) || !dp->user) {
+		NL_SET_ERR_MSG_MOD(extack, "Port is not a DSA user port");
+		return -EINVAL;
+	}
+
+	if (READ_ONCE(dp->delegated) == delegated)
+		return 0;
+
+	user = dp->user;
+	if (delegated) {
+		if (!netif_running(user) || !netif_device_present(user)) {
+			NL_SET_ERR_MSG_MOD(extack,
+					   "DSA user port must be up to delegate it");
+			return -ENETDOWN;
+		}
+		if (dp->bridge || dp->lag || dp->hsr_dev ||
+		    netdev_has_any_upper_dev(user)) {
+			NL_SET_ERR_MSG_MOD(extack,
+					   "DSA user port must be standalone to delegate it");
+			return -EBUSY;
+		}
+
+		/* Finish configuration work queued before the RTNL handoff. */
+		dsa_flush_workqueue();
+
+		/* Fence address-list callbacks while publishing the drop gate. */
+		netif_addr_lock_bh(user);
+		WRITE_ONCE(dp->delegated_admin_up, true);
+		WRITE_ONCE(dp->delegated, true);
+		netif_addr_unlock_bh(user);
+
+		/* Drain work queued by callbacks which raced with publication. */
+		dsa_flush_workqueue();
+		netif_device_detach(user);
+		netif_tx_disable(user);
+		synchronize_net();
+
+		return 0;
+	}
+
+	if (!netif_running(user)) {
+		if (READ_ONCE(dp->delegated_admin_up))
+			dsa_port_disable_rt(dp);
+		dsa_user_host_uc_uninstall(user);
+	} else if (!READ_ONCE(dp->delegated_admin_up)) {
+		err = dsa_port_enable_rt(dp, user->phydev);
+		if (err)
+			return err;
+	}
+
+	/* Make the netdevice usable before opening the RX drop gate. */
+	netif_device_attach(user);
+	netif_addr_lock_bh(user);
+	WRITE_ONCE(dp->delegated, false);
+	WRITE_ONCE(dp->delegated_admin_up, false);
+	netif_addr_unlock_bh(user);
+	if (netif_running(user))
+		dev_set_rx_mode(user);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(dsa_port_set_delegated);
+
+/**
+ * dsa_port_set_delegated_admin_state() - set delegated port state
+ * @dp: delegated user port
+ * @up: desired administrative state
+ *
+ * Enable or disable a port while its data and configuration planes are owned
+ * by the delegating switch driver.  The operation is idempotent and leaves
+ * the original user netdevice detached.  It does not invoke DSA bridge-state
+ * transitions; forwarding remains owned by the delegating driver.
+ *
+ * Context: RTNL must be held.
+ */
+int dsa_port_set_delegated_admin_state(struct dsa_port *dp, bool up)
+{
+	struct dsa_switch *ds;
+	int err;
+
+	ASSERT_RTNL();
+	if (!dp || !dsa_port_is_user(dp) || !dp->user)
+		return -EINVAL;
+	if (!READ_ONCE(dp->delegated))
+		return -EPERM;
+	if (READ_ONCE(dp->delegated_admin_up) == up)
+		return 0;
+
+	ds = dp->ds;
+	if (up) {
+		if (ds->ops->port_enable) {
+			err = ds->ops->port_enable(ds, dp->index,
+						   dp->user->phydev);
+			if (err)
+				return err;
+		}
+		if (dp->pl)
+			phylink_start(dp->pl);
+	} else {
+		if (dp->pl)
+			phylink_stop(dp->pl);
+		if (ds->ops->port_disable)
+			ds->ops->port_disable(ds, dp->index);
+	}
+	WRITE_ONCE(dp->delegated_admin_up, up);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(dsa_port_set_delegated_admin_state);
+
 static void dsa_user_phylink_fixed_state(struct phylink_config *config,
 					 struct phylink_link_state *state)
 {
@@ -2730,7 +2936,10 @@ int dsa_user_suspend(struct net_device *user_dev)
 {
 	struct dsa_port *dp = dsa_user_to_port(user_dev);
+	bool delegated = dsa_user_is_delegated(user_dev);
+	bool active = delegated ? READ_ONCE(dp->delegated_admin_up) :
+				  netif_running(user_dev);
 
-	if (!netif_running(user_dev))
+	if (!active)
 		return 0;
 
 	netif_device_detach(user_dev);
@@ -2746,10 +2955,14 @@ int dsa_user_resume(struct net_device *user_dev)
 {
 	struct dsa_port *dp = dsa_user_to_port(user_dev);
+	bool delegated = dsa_user_is_delegated(user_dev);
+	bool active = delegated ? READ_ONCE(dp->delegated_admin_up) :
+				  netif_running(user_dev);
 
-	if (!netif_running(user_dev))
+	if (!active)
 		return 0;
 
-	netif_device_attach(user_dev);
+	if (!delegated)
+		netif_device_attach(user_dev);
 
 	rtnl_lock();
 	phylink_start(dp->pl);
@@ -2885,6 +3098,12 @@ void dsa_user_destroy(struct net_device
 
 	netif_carrier_off(user_dev);
 	rtnl_lock();
+	if (WARN_ON_ONCE(dsa_user_is_delegated(user_dev))) {
+		if (netif_running(user_dev))
+			dev_close(user_dev);
+		dsa_port_set_delegated(dp, false, NULL);
+	}
+
 	netdev_upper_dev_unlink(conduit, user_dev);
 	unregister_netdevice(user_dev);
 	phylink_disconnect_phy(dp->pl);
@@ -2909,6 +3128,12 @@ int dsa_user_change_conduit(struct net_d
 	struct list_head *iter;
 	int err;
 
+	if (dsa_user_is_delegated(dev)) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Delegated DSA user port cannot change conduit");
+		return -EBUSY;
+	}
+
 	if (conduit == old_conduit)
 		return 0;
 
@@ -3190,6 +3415,14 @@ dsa_user_prechangeupper_sanity_check(str
 	dp = dsa_user_to_port(dev);
 	ds = dp->ds;
 
+	if (info->linking && dsa_user_is_delegated(dev)) {
+		struct netlink_ext_ack *extack;
+
+		extack = netdev_notifier_info_to_extack(&info->info);
+		NL_SET_ERR_MSG_MOD(extack, "Delegated DSA user port cannot gain uppers");
+		return notifier_from_errno(-EBUSY);
+	}
+
 	if (ds->ops->port_prechangeupper) {
 		err = ds->ops->port_prechangeupper(ds, dp->index, info);
 		if (err)
@@ -3640,6 +3873,9 @@ static void dsa_user_switchdev_event_wor
 	dp = dsa_user_to_port(dev);
 	ds = dp->ds;
 
+	if (dsa_user_is_delegated(dev))
+		goto out_free;
+
 	switch (switchdev_work->event) {
 	case SWITCHDEV_FDB_ADD_TO_DEVICE:
 		if (switchdev_work->host_addr)
@@ -3676,6 +3912,7 @@ static void dsa_user_switchdev_event_wor
 		break;
 	}
 
+out_free:
 	kfree(switchdev_work);
 }
 
@@ -3710,6 +3947,9 @@ static int dsa_user_fdb_event(struct net
 	if (ctx && ctx != dp)
 		return 0;
 
+	if (dsa_user_is_delegated(dev))
+		return -EBUSY;
+
 	if (!dp->bridge)
 		return 0;
 
