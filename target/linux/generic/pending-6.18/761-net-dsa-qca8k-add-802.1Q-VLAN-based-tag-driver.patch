--- /dev/null
+++ b/net/dsa/tag_qca_8021q.c
@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (C) 2026 Stanislaw Pal <kuncy7@gmail.com>
+ *
+ * 802.1Q VLAN-based tag driver for the Qualcomm Atheros QCA8K switches,
+ * built on the tag_8021q framework: the source port travels in a VLAN tag
+ * the switch itself inserts, instead of the 2-byte Atheros header that
+ * only the switch and tag_qca understand. That keeps the conduit's frames
+ * plain 802.1Q, which any MAC - and any hardware in front of it - parses.
+ */
+#include <linux/dsa/8021q.h>
+#include <linux/if_vlan.h>
+#include <net/dsa.h>
+
+#include "tag.h"
+#include "tag_8021q.h"
+
+#define QCA_8021Q_NAME "qca-8021q"
+
+/* @dev's own 802.1Q upper with this VID, if any. Not the deep lookup:
+ * from a port without VLAN state of its own that climbs to the bridge
+ * and answers with the bridge's L3 VLAN interface.
+ */
+static struct net_device *qca_8021q_vlan_upper_of(struct net_device *dev,
+						 __be16 proto, u16 vid)
+{
+	struct net_device *upper;
+	struct list_head *iter;
+
+	netdev_for_each_upper_dev_rcu(dev, upper, iter) {
+		if (is_vlan_dev(upper) && vlan_dev_vlan_proto(upper) == proto &&
+		    vlan_dev_vlan_id(upper) == vid)
+			return upper;
+	}
+
+	return NULL;
+}
+
+/* Did an 802.1Q upper of this port tag the frame? The tag is hwaccel
+ * metadata, or - a user port offers no VLAN TX offload, so
+ * validate_xmit_vlan() pushes it in - already in the frame. A frame the
+ * bridge forwards (offload_fwd_mark) stays in the bridge's VLAN whatever
+ * it carries inside.
+ */
+static bool qca_8021q_upper_tagged(struct sk_buff *skb, struct net_device *netdev)
+{
+	u16 tci;
+
+	if (skb_vlan_tag_present(skb))
+		return !vid_is_dsa_8021q(skb_vlan_tag_get_id(skb));
+
+	if (skb->offload_fwd_mark || skb->protocol != htons(ETH_P_8021Q) ||
+	    __vlan_get_tag(skb, &tci))
+		return false;
+
+	tci &= VLAN_VID_MASK;
+	return !vid_is_dsa_8021q(tci) &&
+	       qca_8021q_vlan_upper_of(netdev, htons(ETH_P_8021Q), tci);
+}
+
+static struct sk_buff *qca_8021q_xmit(struct sk_buff *skb,
+				      struct net_device *netdev)
+{
+	struct dsa_port *dp = dsa_user_to_port(netdev);
+	u16 queue_mapping = skb_get_queue_mapping(skb);
+	u16 tx_vid = dsa_tag_8021q_standalone_vid(dp);
+	u8 pcp;
+
+	if (skb->offload_fwd_mark) {
+		unsigned int bridge_num = dsa_port_bridge_num_get(dp);
+		struct net_device *br = dsa_port_bridge_dev_get(dp);
+
+		/* A VLAN-aware bridge carries its own VID; the switch
+		 * forwards on that one.
+		 */
+		if (br_vlan_enabled(br))
+			return skb;
+
+		tx_vid = dsa_tag_8021q_bridge_vid(bridge_num);
+	}
+
+	/* An 802.1Q upper of the port (wan.35 for a PPPoE ISP, wan.99 next
+	 * to the port's place in a VLAN-unaware bridge) already tagged the
+	 * frame. The switch carries that VLAN as it is - the port and the
+	 * CPU port are tagged members of it (see qca8k_port_vlan_add) -
+	 * so send the frame with that tag alone instead of stacking the
+	 * port's standalone tag_8021q VID in front of it: a bridged port is
+	 * no longer a member of that VID and the switch would drop it.
+	 */
+	if (qca_8021q_upper_tagged(skb, netdev))
+		return skb;
+
+	pcp = netdev_txq_to_tc(netdev, queue_mapping);
+
+	return dsa_8021q_xmit(skb, netdev, ETH_P_8021Q,
+			      ((pcp << VLAN_PRIO_SHIFT) | tx_vid));
+}
+
+/* The user port that owns an 802.1Q upper with this VID, for a frame the
+ * switch delivered in a VLAN that is not a tag_8021q one. Such a VLAN is
+ * only ever installed for one port (qca8k_port_vlan_add refuses a second),
+ * so the first match is the only match.
+ */
+static struct net_device *qca_8021q_find_vlan_upper(struct net_device *conduit,
+						    __be16 proto, u16 vid)
+{
+	struct dsa_port *cpu_dp = conduit->dsa_ptr;
+	struct dsa_port *dp;
+
+	dsa_tree_for_each_user_port(dp, cpu_dp->dst) {
+		if (dp->cpu_dp != cpu_dp)
+			continue;
+		if (qca_8021q_vlan_upper_of(dp->user, proto, vid))
+			return dp->user;
+	}
+
+	return NULL;
+}
+
+static struct sk_buff *qca_8021q_rcv(struct sk_buff *skb,
+				     struct net_device *netdev)
+{
+	int src_port = -1, switch_id = -1, vbid = -1, vid = -1;
+
+	/* The conduit is promiscuous for the sake of the tag_8021q VIDs,
+	 * and a promiscuous MAC passes MAC control frames up as well. The
+	 * switch sends PAUSE at the CPU port whenever a slow user port
+	 * cannot drain what the CPU pushes; they carry no VLAN tag and
+	 * nothing above wants them.
+	 */
+	if (unlikely(eth_hdr(skb)->h_proto == htons(ETH_P_PAUSE)))
+		return NULL;
+
+	dsa_8021q_rcv(skb, &src_port, &switch_id, &vbid, &vid);
+
+	/* A VLAN that is not a tag_8021q one: dsa_8021q_rcv left its tag
+	 * on the skb as hwaccel metadata. It is the VLAN of an 802.1Q upper
+	 * of a port (the kernel's VLAN demux hands the frame to the upper
+	 * once we pick the port), or one of a VLAN-aware bridge, handed to
+	 * a port of that bridge which is in the VLAN. Which of the bridge's
+	 * ports the frame came from is not known - the same imprecise RX
+	 * as for a VLAN-unaware bridge - and the bridge does its own VLAN
+	 * handling on the tag.
+	 */
+	if (vid >= 0 && !vid_is_dsa_8021q(vid) && skb_vlan_tag_present(skb)) {
+		skb->dev = qca_8021q_find_vlan_upper(netdev, skb->vlan_proto, vid);
+		if (!skb->dev)
+			skb->dev = dsa_find_designated_bridge_port_by_vid(netdev, vid);
+	} else
+		skb->dev = dsa_tag_8021q_find_user(netdev, src_port, switch_id,
+						   vid, vbid);
+	if (!skb->dev) {
+		net_warn_ratelimited("%s: dropped frame from %pM proto 0x%04x: src_port=%d switch_id=%d vid=%d vbid=%d\n",
+				     netdev->name, eth_hdr(skb)->h_source,
+				     ntohs(eth_hdr(skb)->h_proto), src_port,
+				     switch_id, vid, vbid);
+		return NULL;
+	}
+
+	dsa_default_offload_fwd_mark(skb);
+
+	return skb;
+}
+
+static const struct dsa_device_ops qca_8021q_netdev_ops = {
+	.name			= QCA_8021Q_NAME,
+	.proto			= DSA_TAG_PROTO_QCA_8021Q,
+	.xmit			= qca_8021q_xmit,
+	.rcv			= qca_8021q_rcv,
+	.needed_headroom	= VLAN_HLEN,
+	.promisc_on_conduit	= true,
+};
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("DSA tag driver for Qualcomm Atheros QCA8K switches, using VLAN");
+MODULE_ALIAS_DSA_TAG_DRIVER(DSA_TAG_PROTO_QCA_8021Q, QCA_8021Q_NAME);
+
+module_dsa_tag_driver(qca_8021q_netdev_ops);
--- a/drivers/net/dsa/qca/qca8k.h
+++ b/drivers/net/dsa/qca/qca8k.h
@@ -191,6 +191,12 @@
 #define   QCA8K_PORT_VLAN_SVID_MASK			GENMASK(11, 0)
 #define   QCA8K_PORT_VLAN_SVID(x)			FIELD_PREP(QCA8K_PORT_VLAN_SVID_MASK, x)
 #define QCA8K_REG_PORT_VLAN_CTRL1(_i)			(0x424 + (_i * 8))
+#define   QCA8K_PORT_VLAN_CTRL1_EG_MODE_MASK		GENMASK(13, 12)
+#define   QCA8K_PORT_VLAN_CTRL1_EG_MODE(x)		FIELD_PREP(QCA8K_PORT_VLAN_CTRL1_EG_MODE_MASK, x)
+#define   QCA8K_PORT_VLAN_CTRL1_EG_MODE_UNMOD		QCA8K_PORT_VLAN_CTRL1_EG_MODE(0x0)
+#define   QCA8K_PORT_VLAN_CTRL1_EG_MODE_UNTAG		QCA8K_PORT_VLAN_CTRL1_EG_MODE(0x1)
+#define   QCA8K_PORT_VLAN_CTRL1_EG_MODE_TAG		QCA8K_PORT_VLAN_CTRL1_EG_MODE(0x2)
+#define   QCA8K_PORT_VLAN_CTRL1_EG_MODE_UNTOUCH		QCA8K_PORT_VLAN_CTRL1_EG_MODE(0x3)
 #define QCA8K_REG_IPV4_PRI_BASE_ADDR			0x470
 #define QCA8K_REG_IPV4_PRI_ADDR_MASK			0x474
 
@@ -453,6 +459,10 @@ struct qca8k_priv {
 	 */
 	u8 port_enabled_map;
 	u8 port_isolated_map;
+	/* Bridge ports with BR_FLOOD, BR_MCAST_FLOOD or BR_BCAST_FLOOD off */
+	u8 port_uc_flood_off;
+	u8 port_mc_flood_off;
+	u8 port_bc_flood_off;
 	struct qca8k_ports_config ports_config;
 	struct regmap *regmap;
 	struct mii_bus *bus;
@@ -469,6 +479,17 @@ struct qca8k_priv {
 	struct qca8k_pcs pcs_port_6;
 	const struct qca8k_match_data *info;
 	struct qca8k_led ports_led[QCA8K_LED_COUNT];
+	/* The tagger in use: DSA_TAG_PROTO_QCA (Atheros header) or
+	 * DSA_TAG_PROTO_QCA_8021Q (tag_8021q, the switch's own VLAN tag).
+	 */
+	enum dsa_tag_protocol tag_proto;
+	/* The PVID a port carries under the qca-8021q tagger: its tag_8021q
+	 * VLAN (standalone, or the VLAN of a VLAN-unaware bridge) or, while
+	 * it sits in a VLAN-aware bridge, that bridge's. One register holds
+	 * it, qca8k_commit_pvid() picks.
+	 */
+	u16 tag_8021q_pvid[QCA8K_NUM_PORTS];
+	u16 bridge_pvid[QCA8K_NUM_PORTS];
 };
 
 struct qca8k_mib_desc {
@@ -524,6 +545,7 @@ int qca8k_set_mac_eee(struct dsa_switch
 
 /* Common bridge function */
 void qca8k_port_stp_state_set(struct dsa_switch *ds, int port, u8 state);
+int qca8k_write_flood_masks(struct qca8k_priv *priv, bool tag_8021q);
 int qca8k_port_pre_bridge_flags(struct dsa_switch *ds, int port,
 				struct switchdev_brport_flags flags,
 				struct netlink_ext_ack *extack);
@@ -578,11 +600,18 @@ void qca8k_port_mirror_del(struct dsa_sw
 			   struct dsa_mall_mirror_tc_entry *mirror);
 
 /* Common port VLAN function */
+int qca8k_port_set_pvid(struct qca8k_priv *priv, int port, u16 vid);
+int qca8k_commit_pvid(struct dsa_switch *ds, int port, bool vlan_aware);
+int qca8k_port_prechangeupper(struct dsa_switch *ds, int port,
+			      struct netdev_notifier_changeupper_info *info);
 int qca8k_port_vlan_filtering(struct dsa_switch *ds, int port, bool vlan_filtering,
 			      struct netlink_ext_ack *extack);
 int qca8k_port_vlan_add(struct dsa_switch *ds, int port,
 			const struct switchdev_obj_port_vlan *vlan,
 			struct netlink_ext_ack *extack);
+int qca8k_tag_8021q_vlan_add(struct dsa_switch *ds, int port, u16 vid,
+			     u16 flags);
+int qca8k_tag_8021q_vlan_del(struct dsa_switch *ds, int port, u16 vid);
 int qca8k_port_vlan_del(struct dsa_switch *ds, int port,
 			const struct switchdev_obj_port_vlan *vlan);
 
--- a/drivers/net/dsa/qca/qca8k-8xxx.c
+++ b/drivers/net/dsa/qca/qca8k-8xxx.c
@@ -20,6 +20,7 @@
 #include <linux/gpio/consumer.h>
 #include <linux/etherdevice.h>
 #include <linux/dsa/tag_qca.h>
+#include <linux/dsa/8021q.h>
 
 #include "qca8k.h"
 #include "qca8k_leds.h"
@@ -1880,7 +1881,11 @@ qca8k_conduit_change(struct dsa_switch *
 	mutex_lock(&priv->mgmt_eth_data.mutex);
 	mutex_lock(&priv->mib_eth_data.mutex);
 
-	priv->mgmt_conduit = operational ? (struct net_device *)conduit : NULL;
+	/* Management over Ethernet rides on the Atheros header, which
+	 * tag_8021q has turned off in the switch; MDIO does the job then.
+	 */
+	priv->mgmt_conduit = operational && priv->tag_proto == DSA_TAG_PROTO_QCA ?
+			     (struct net_device *)conduit : NULL;
 
 	mutex_unlock(&priv->mib_eth_data.mutex);
 	mutex_unlock(&priv->mgmt_eth_data.mutex);
@@ -1892,6 +1897,9 @@ static int qca8k_connect_tag_protocol(st
 	struct qca_tagger_data *tagger_data;
 
 	switch (proto) {
+	case DSA_TAG_PROTO_QCA_8021Q:
+		/* Nothing to connect: the tagger carries no management. */
+		break;
 	case DSA_TAG_PROTO_QCA:
 		tagger_data = ds->tagger_data;
 
@@ -1906,6 +1914,162 @@ static int qca8k_connect_tag_protocol(st
 	return 0;
 }
 
+static int qca8k_set_hdr_mode(struct qca8k_priv *priv, u32 mode)
+{
+	struct dsa_port *dp;
+	int ret;
+
+	dsa_switch_for_each_cpu_port(dp, priv->ds) {
+		ret = qca8k_write(priv, QCA8K_REG_PORT_HDR_CTRL(dp->index),
+				  FIELD_PREP(QCA8K_PORT_HDR_CTRL_TX_MASK, mode) |
+				  FIELD_PREP(QCA8K_PORT_HDR_CTRL_RX_MASK, mode));
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/* tag_8021q wants every port VLAN-aware: an untagged frame then takes the
+ * port's tag_8021q PVID and reaches the CPU port tagged with it. That
+ * second half needs the port's egress mode set to "untouched", so the
+ * VLAN table's per-port tag/untag bits decide what leaves a port; the
+ * reset default, "unmodified", sends every frame out the way it came in,
+ * and the CPU never sees a tag. With the Atheros header the ports go back
+ * to port-based forwarding, except where a bridge asked for VLAN
+ * filtering itself. The flood masks follow (qca8k_write_flood_masks()).
+ */
+static int qca8k_set_tag_8021q_vlan_mode(struct qca8k_priv *priv, bool on)
+{
+	struct dsa_port *dp;
+	u32 mode;
+	int ret;
+
+	dsa_switch_for_each_available_port(dp, priv->ds) {
+		if (on || dsa_port_is_vlan_filtering(dp))
+			mode = QCA8K_PORT_LOOKUP_VLAN_MODE_SECURE;
+		else
+			mode = QCA8K_PORT_LOOKUP_VLAN_MODE_NONE;
+
+		ret = qca8k_rmw(priv, QCA8K_PORT_LOOKUP_CTRL(dp->index),
+				QCA8K_PORT_LOOKUP_VLAN_MODE_MASK, mode);
+		if (ret)
+			return ret;
+
+		ret = qca8k_rmw(priv, QCA8K_REG_PORT_VLAN_CTRL1(dp->index),
+				QCA8K_PORT_VLAN_CTRL1_EG_MODE_MASK,
+				on ? QCA8K_PORT_VLAN_CTRL1_EG_MODE_UNTOUCH :
+				     QCA8K_PORT_VLAN_CTRL1_EG_MODE_UNMOD);
+		if (ret)
+			return ret;
+	}
+
+	return qca8k_write_flood_masks(priv, on);
+}
+
+/* DSA offloads the 802.1Q uppers of a standalone port only while the port
+ * advertises NETIF_F_HW_VLAN_CTAG_FILTER (vlan_vid_add() asks the driver
+ * through ndo_vlan_rx_add_vid only then). The core sets it for
+ * ds->needs_standalone_vlan_filtering switches; the qca-8021q tagger needs
+ * the same for its user ports - an ISP's VLAN on the WAN port has to go
+ * into the VLAN table or the switch drops it on ingress - without taking
+ * on that flag's other consequences. Set it on the user ports ourselves.
+ */
+static void qca8k_user_vlan_filter_feature(struct dsa_switch *ds, bool on)
+{
+	struct dsa_port *dp;
+
+	dsa_switch_for_each_user_port(dp, ds) {
+		if (!dp->user)
+			continue;
+		if (on)
+			dp->user->features |= NETIF_F_HW_VLAN_CTAG_FILTER;
+		else
+			dp->user->features &= ~NETIF_F_HW_VLAN_CTAG_FILTER;
+	}
+}
+
+static int qca8k_change_tag_protocol(struct dsa_switch *ds,
+				     enum dsa_tag_protocol proto)
+{
+	struct qca8k_priv *priv = ds->priv;
+	struct dsa_port *dp;
+	int ret;
+
+	if (proto == priv->tag_proto)
+		return 0;
+
+	/* A port in a bridge cannot change over. tag_8021q keeps a VLAN for
+	 * each bridge and a PVID for each port, and neither its teardown nor
+	 * its setup brings back what the other mode had: the PVID and the
+	 * VLAN mode of a VLAN-aware bridge's port, or the tag_8021q VLAN of a
+	 * bridge the port is already in. The ports have to be down for the
+	 * change anyway; take them out of their bridges as well.
+	 */
+	dsa_switch_for_each_user_port(dp, ds) {
+		if (dsa_port_bridge_dev_get(dp)) {
+			dev_err(ds->dev,
+				"port %d is in a bridge, take it out to change the tagging protocol\n",
+				dp->index);
+			return -EBUSY;
+		}
+	}
+
+	switch (proto) {
+	case DSA_TAG_PROTO_QCA:
+		dsa_tag_8021q_unregister(ds);
