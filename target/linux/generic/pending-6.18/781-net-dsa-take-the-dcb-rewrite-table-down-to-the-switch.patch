@@ -2500,7 +2495,8 @@
 	if (!ds->pcp_prio_mapping_is_global)
 		return 0;
 
-	err = dsa_user_dcbnl_ieee_global_setdel(dev, app, true);
+	err = dsa_user_dcbnl_global_setdel(dev, app, dcb_ieee_delapp,
+					   dcb_ieee_setapp);
 	if (err) {
