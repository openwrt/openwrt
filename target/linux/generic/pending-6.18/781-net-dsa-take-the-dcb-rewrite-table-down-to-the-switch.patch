 			ds->ops->port_add_pcp_prio(ds, port, pcp,
@@ -2533,6 +2529,149 @@
 	}
 }
 
+/* A rewrite entry is an app entry read the other way round: the priority is
+ * the key and the protocol the value a packet of that priority leaves with,
+ * so a priority has one value. The table can still hold two entries for one
+ * priority - dcb rewr replace adds the new one before removing the old - and
+ * what the switch is told is whichever of them the mask map picks.
+ */
+static int dsa_user_dcbnl_rewr_push(struct net_device *dev, u8 selector,
+				    u8 prio)
+{
+	int (*add)(struct dsa_switch *ds, int port, u8 prio, u8 proto);
+	int (*del)(struct dsa_switch *ds, int port, u8 prio);
+	struct dsa_port *dp = dsa_user_to_port(dev);
+	struct dcb_ieee_app_prio_map dscp;
+	struct dcb_rewr_prio_pcp_map pcp;
+	struct dsa_switch *ds = dp->ds;
+	u64 mask;
+
+	if (selector == IEEE_8021QAZ_APP_SEL_DSCP) {
+		dcb_getrewr_prio_dscp_mask_map(dev, &dscp);
+		mask = dscp.map[prio];
+		add = ds->ops->port_add_dscp_rewr;
+		del = ds->ops->port_del_dscp_rewr;
+	} else {
+		dcb_getrewr_prio_pcp_mask_map(dev, &pcp);
+		mask = pcp.map[prio];
+		add = ds->ops->port_add_pcp_rewr;
+		del = ds->ops->port_del_pcp_rewr;
+	}
+
+	if (mask)
+		return add(ds, dp->index, prio, fls64(mask) - 1);
+
+	return del(ds, dp->index, prio);
+}
+
+/* Both halves of a pair are required, because removing one of two entries for
+ * a priority leaves the other one to be written rather than a slot to clear.
+ * The protocol is bounded by the selector and the priority by the mask map the
+ * entry lands in.
+ */
+static int dsa_user_dcbnl_rewr_check(struct net_device *dev,
+				     struct dcb_app *app, bool *is_global)
+{
+	struct dsa_port *dp = dsa_user_to_port(dev);
+	struct dsa_switch *ds = dp->ds;
+	u16 limit;
+
+	switch (app->selector) {
+	case IEEE_8021QAZ_APP_SEL_DSCP:
+		if (!ds->ops->port_add_dscp_rewr ||
+		    !ds->ops->port_del_dscp_rewr)
+			return -EOPNOTSUPP;
+		*is_global = ds->dscp_prio_mapping_is_global;
+		limit = 64;
+		break;
+	case DCB_APP_SEL_PCP:
+		if (!ds->ops->port_add_pcp_rewr ||
+		    !ds->ops->port_del_pcp_rewr)
+			return -EOPNOTSUPP;
+		*is_global = ds->pcp_prio_mapping_is_global;
+		limit = 16;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	if (app->protocol >= limit || app->priority >= IEEE_8021QAZ_MAX_TCS) {
+		netdev_err(dev, "rewrite entry %u:%u is invalid\n",
+			   app->priority, app->protocol);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int __maybe_unused dsa_user_dcbnl_setrewr(struct net_device *dev,
+						 struct dcb_app *app)
+{
+	bool is_global;
+	int err;
+
+	err = dsa_user_dcbnl_rewr_check(dev, app, &is_global);
+	if (err)
+		return err;
+
+	err = dcb_setrewr(dev, app);
+	if (err)
+		return err;
+
+	err = dsa_user_dcbnl_rewr_push(dev, app->selector, app->priority);
+	if (err)
+		goto err_undo;
+
+	if (!is_global)
+		return 0;
+
+	err = dsa_user_dcbnl_global_setdel(dev, app, dcb_setrewr, dcb_delrewr);
+	if (err)
+		goto err_undo;
+
+	return 0;
+
+err_undo:
+	dcb_delrewr(dev, app);
+	dsa_user_dcbnl_rewr_push(dev, app->selector, app->priority);
+
+	return err;
+}
+
+static int __maybe_unused dsa_user_dcbnl_delrewr(struct net_device *dev,
+						 struct dcb_app *app)
+{
+	bool is_global;
+	int err;
+
+	err = dsa_user_dcbnl_rewr_check(dev, app, &is_global);
+	if (err)
+		return err;
+
+	err = dcb_delrewr(dev, app);
+	if (err)
+		return err;
+
+	err = dsa_user_dcbnl_rewr_push(dev, app->selector, app->priority);
+	if (err)
+		goto err_undo;
+
+	if (!is_global)
+		return 0;
+
+	err = dsa_user_dcbnl_global_setdel(dev, app, dcb_delrewr, dcb_setrewr);
+	if (err)
+		goto err_undo;
+
+	return 0;
+
+err_undo:
+	dcb_setrewr(dev, app);
+	dsa_user_dcbnl_rewr_push(dev, app->selector, app->priority);
+
+	return err;
+}
+
 /* Pre-populate the DCB application priority table with the priorities
  * configured during switch setup, which we read from hardware here.
  */
@@ -2650,6 +2789,8 @@
 	.ieee_delapp		= dsa_user_dcbnl_ieee_delapp,
 	.dcbnl_setapptrust	= dsa_user_dcbnl_set_apptrust,
 	.dcbnl_getapptrust	= dsa_user_dcbnl_get_apptrust,
+	.dcbnl_setrewr		= dsa_user_dcbnl_setrewr,
+	.dcbnl_delrewr		= dsa_user_dcbnl_delrewr,
 };
 
 static void dsa_user_get_stats64(struct net_device *dev,
