-static int dsa_user_dcbnl_ieee_global_setdel(struct net_device *dev,
-					     struct dcb_app *app, bool del)
+static int dsa_user_dcbnl_global_setdel(struct net_device *dev,
+					struct dcb_app *app,
+					int (*setdel)(struct net_device *dev,
+						      struct dcb_app *app),
