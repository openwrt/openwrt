+/**
+ * ip4ip6_fmr_calc - calculate target / source IPv6-address based on FMR
+ *   @dest: destination IPv6 address buffer
+ *   @skb: socket buffer
+ *   @fmr: MAP FMR
+ *   @xmit: Calculate for xmit or rcv
+ **/
+static void ip4ip6_fmr_calc(struct in6_addr *dest,
+		const struct sk_buff *skb,
+		const struct __ip6_tnl_fmr *fmr, bool xmit)
+{
+	unsigned int frombyte = fmr->ip6_prefix_len / 8;
+	int fromrem = fmr->ip6_prefix_len % 8;
+	unsigned int bytes = min_t(unsigned int, sizeof(u64),
+				   sizeof(struct in6_addr) - frombyte);
+	const u32 *addr;
+	u64 eabits = 0, mask;
+	u64 t = 0;
+	u16 psidbits = 0;
+	int psidlen = max_t(int, 0, fmr->ea_len - (32 - fmr->ip4_prefix_len));
+	struct iphdr iph_buf, dsth_buf;
+	const struct iphdr *iph, *dsth;
+	struct icmphdr ih_buf;
+	const struct icmphdr *ih;
+	__be16 ports_buf[2];
+	const __be16 *ports;
+	__be16 port = 0;
+	bool use_dest_addr = xmit;
+	int offset = skb_network_offset(skb);
+
+	iph = skb_header_pointer(skb, offset, sizeof(iph_buf), &iph_buf);
+	if (!iph || iph->version != 4 || iph->ihl < 5)
+		return;
+
+	dsth = iph;
+	offset += iph->ihl * 4;
+	if (offset > skb->len)
+		return;
+
+	/* Find the quoted IP header in ICMP errors. */
+	if (iph->protocol == IPPROTO_ICMP &&
+	    !(iph->frag_off & htons(IP_OFFSET))) {
+		ih = skb_header_pointer(skb, offset, sizeof(ih_buf), &ih_buf);
+		if (!ih)
+			return;
+
+		switch (ih->type) {
+		case ICMP_DEST_UNREACH:
+		case ICMP_SOURCE_QUENCH:
+		case ICMP_TIME_EXCEEDED:
+		case ICMP_PARAMETERPROB:
+		case ICMP_REDIRECT:
+			offset += sizeof(ih_buf);
+			dsth = skb_header_pointer(skb, offset, sizeof(dsth_buf),
+						  &dsth_buf);
+			if (!dsth || dsth->version != 4 || dsth->ihl < 5)
+				return;
+			offset += dsth->ihl * 4;
+			if (offset > skb->len)
+				return;
+			use_dest_addr = !xmit;
+			break;
+		}
+	}
+
+	if (psidlen > 0) {
+		/* Non-initial fragments do not contain transport headers. */
+		if (dsth->frag_off & htons(IP_OFFSET))
+			return;
+
+		switch (dsth->protocol) {
+		case IPPROTO_UDP:
+		case IPPROTO_TCP:
+		case IPPROTO_SCTP:
+		case IPPROTO_DCCP:
+			ports = skb_header_pointer(skb, offset, sizeof(ports_buf),
+						   ports_buf);
+			if (!ports)
+				return;
+			port = ports[use_dest_addr];
+			break;
+		case IPPROTO_ICMP:
+			ih = skb_header_pointer(skb, offset, sizeof(ih_buf), &ih_buf);
+			if (!ih)
+				return;
+
+			/* Use the ICMP identifier as the port. */
+			if ((use_dest_addr &&
+			     (ih->type == ICMP_ECHOREPLY ||
+			      ih->type == ICMP_TIMESTAMPREPLY ||
+			      ih->type == ICMP_INFO_REPLY ||
+			      ih->type == ICMP_ADDRESSREPLY)) ||
+			    (!use_dest_addr &&
+			     (ih->type == ICMP_ECHO ||
+			      ih->type == ICMP_TIMESTAMP ||
+			      ih->type == ICMP_INFO_REQUEST ||
+			      ih->type == ICMP_ADDRESS)))
+				port = ih->un.echo.id;
+			else
+				return;
+			break;
+		default:
+			return;
+		}
+	}
+
+	addr = use_dest_addr ? &iph->daddr : &iph->saddr;
+	if (fmr->ip4_prefix_len < 32)
+		eabits = ((u64)ntohl(*addr)) << (32 + fmr->ip4_prefix_len);
+
+	/* extract PSID from port and add it to eabits */
+	if (psidlen > 0) {
+		psidbits = ntohs(port);
+		psidbits >>= 16 - psidlen - fmr->offset;
+		psidbits = (u16)(psidbits << (16 - psidlen));
+		eabits |= ((u64)psidbits) << (48 - (fmr->ea_len - psidlen));
+	}
+
+	/* rewrite destination address */
+	*dest = fmr->ip6_prefix;
+	memcpy(&dest->s6_addr[10], addr, sizeof(*addr));
+	dest->s6_addr16[7] = htons(psidbits >> (16 - psidlen));
+
+	if (!fmr->ea_len)
+		return;
+
+	/* insert eabits */
+	memcpy(&t, &dest->s6_addr[frombyte], bytes);
+	mask = ((1ULL << fmr->ea_len) - 1) << (64 - fmr->ea_len - fromrem);
+	t = be64_to_cpu(t) & ~mask;
+	t = cpu_to_be64(t | ((eabits >> fromrem) & mask));
+	memcpy(&dest->s6_addr[frombyte], &t, bytes);
+}
