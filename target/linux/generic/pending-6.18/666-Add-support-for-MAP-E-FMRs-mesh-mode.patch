+static const struct nla_policy ip6_tnl_fmr_policy[IFLA_IPTUN_FMR_MAX + 1] = {
+	[IFLA_IPTUN_FMR_IP6_PREFIX] = { .len = sizeof(struct in6_addr) },
+	[IFLA_IPTUN_FMR_IP4_PREFIX] = { .len = sizeof(struct in_addr) },
+	[IFLA_IPTUN_FMR_IP6_PREFIX_LEN] = NLA_POLICY_MAX(NLA_U8, 128),
+	[IFLA_IPTUN_FMR_IP4_PREFIX_LEN] = NLA_POLICY_MAX(NLA_U8, 32),
+	[IFLA_IPTUN_FMR_EA_LEN] = NLA_POLICY_MAX(NLA_U8, 48),
+	[IFLA_IPTUN_FMR_OFFSET] = NLA_POLICY_MAX(NLA_U8, 16)
+};
+
+static int ip6_tnl_fmr_validate(struct nlattr *fmrs,
+				struct netlink_ext_ack *extack)
+{
+	struct nlattr *fmr;
+	int rem;
+
+	nla_for_each_nested(fmr, fmrs, rem) {
+		struct nlattr *tb[IFLA_IPTUN_FMR_MAX + 1];
+		u8 ip6_prefix_len = 0, ip4_prefix_len = 0, ea_len = 0, offset = 6;
+		int psidlen, err;
+
+		err = nla_parse_nested(tb, IFLA_IPTUN_FMR_MAX, fmr,
+				       ip6_tnl_fmr_policy, extack);
+		if (err)
+			return err;
+
+		if (tb[IFLA_IPTUN_FMR_IP6_PREFIX_LEN])
+			ip6_prefix_len = nla_get_u8(tb[IFLA_IPTUN_FMR_IP6_PREFIX_LEN]);
+		if (tb[IFLA_IPTUN_FMR_IP4_PREFIX_LEN])
+			ip4_prefix_len = nla_get_u8(tb[IFLA_IPTUN_FMR_IP4_PREFIX_LEN]);
+		if (tb[IFLA_IPTUN_FMR_EA_LEN])
+			ea_len = nla_get_u8(tb[IFLA_IPTUN_FMR_EA_LEN]);
+		if (tb[IFLA_IPTUN_FMR_OFFSET])
+			offset = nla_get_u8(tb[IFLA_IPTUN_FMR_OFFSET]);
+
+		psidlen = max_t(int, 0, ea_len - (32 - ip4_prefix_len));
+		if (ip6_prefix_len + ea_len > 128 || psidlen + offset > 16) {
+			NL_SET_ERR_MSG(extack, "Invalid MAP-E FMR bit lengths");
+			return -EINVAL;
+		}
+	}
+
+	return rem ? -EINVAL : 0;
+}
