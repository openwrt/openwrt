From 0869817efec6c8022d1cc04c74d4e59171a2befb Mon Sep 17 00:00:00 2001
From: Eric Woudstra <ericwouds@gmail.com>
Date: Mon, 14 Sep 2026 09:09:14 +0200
Subject: [PATCH] netfilter: flowtable: teardown direct xmit flows when the fdb entry moves

A direct xmit flow stores the bridge port and the destination address that
the bridge fdb resolved when the flow was created. When the host moves to
another port of the same bridge, for example a station roaming to another
access point, the bridge updates its fdb entry and the flow keeps sending
to the old port. Packets from the other end keep hitting the flow and
refresh it, so it does not expire while the sender retransmits. A hardware
offloaded flow behaves the same, and none of its packets reaches the
software path.

After every change of an fdb entry the bridge notifies
SWITCHDEV_FDB_ADD_TO_DEVICE with the port the entry now points to, and
SWITCHDEV_FDB_DEL_TO_DEVICE when it removes an entry; a switchdev driver
reports the entries it learns and forgets with SWITCHDEV_FDB_ADD_TO_BRIDGE
and SWITCHDEV_FDB_DEL_TO_BRIDGE. On an add, tear down every direct xmit
flow that sends the entry's address and vid to another bridge port, on a
delete every one that sends them to the entry's port. The bridge port is
stored in the tuple for this: the out interface is the lowest device of
the path and differs from the port when the port is a vlan device.

The notifier runs in atomic context, so the events are queued and one
work item walks the flowtables for all events queued since its last run;
the latest event for an address decides. The bridge notifies an add and
the delete of a removed entry after the change, and the walk starts after
an RCU grace period, so a flow set up from the old entry is already in
its flowtable. When an event cannot be queued, or 256 are pending, the
walk tears down every direct xmit flow through a bridge port, and those
flows are offloaded again.

The bridge does not notify switchdev about entries added with "bridge fdb
add ... master dynamic", nor at all with CONFIG_NET_SWITCHDEV=n, so a flow
to such an entry keeps its port as before.

Signed-off-by: Eric Woudstra <ericwouds@gmail.com>
Co-developed-by: Julius Bairaktaris <julius@bairaktaris.de>
Link: https://lore.kernel.org/netfilter-devel/20260914072541.897040-1-julius@bairaktaris.de/
Assisted-by: Claude:claude-fable-5-1
Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
---
 net/netfilter/nf_flow_table_core.c    |  159 +++++++++++++++++++++++++++++++++
 include/net/netfilter/nf_flow_table.h |    2 
 net/netfilter/nf_flow_table_path.c    |    6 +
 3 files changed, 167 insertions(+)

--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -4,7 +4,9 @@
 #include <linux/module.h>
 #include <linux/netfilter.h>
 #include <linux/rhashtable.h>
+#include <linux/etherdevice.h>
 #include <linux/netdevice.h>
+#include <net/switchdev.h>
 #include <net/ip.h>
 #include <net/ip6_route.h>
 #include <net/netfilter/nf_tables.h>
@@ -127,6 +129,8 @@ static int flow_offload_fill_route(struc
 		memcpy(flow_tuple->out.h_source, route->tuple[dir].out.h_source,
 		       ETH_ALEN);
 		flow_tuple->out.ifidx = route->tuple[dir].out.ifindex;
+		flow_tuple->out.bridge_ifidx =
+			route->tuple[dir].out.bridge_ifindex;
 		flow_tuple->out.hw_ifidx = route->tuple[dir].out.hw_ifindex;
 		flow_tuple->out.bridge_vid = route->tuple[dir].out.bridge_vid;
 		dst_release(dst);
@@ -759,6 +763,153 @@ void nf_flow_table_cleanup(struct net_de
 }
 EXPORT_SYMBOL_GPL(nf_flow_table_cleanup);
 
+/* Past this many queued fdb events every bridged flow is torn down. */
+#define NF_FLOW_FDB_MAX		256
+
+struct nf_flow_fdb_event {
+	struct list_head	list;
+	const struct net	*net;
+	int			ifindex;
+	u16			vid;
+	u8			addr[ETH_ALEN];
+	bool			del;
+};
+
+static LIST_HEAD(nf_flow_fdb_list);
+static unsigned int nf_flow_fdb_len;
+static bool nf_flow_fdb_overflow;
+static DEFINE_SPINLOCK(nf_flow_fdb_lock);
+
+struct nf_flow_fdb_ctx {
+	struct list_head	*list;
+	bool			overflow;
+	bool			found;
+};
+
+/* The latest event for the destination decides: a flow is stale on the
+ * port of a deleted entry, and on any other port than that of an added
+ * or moved one.
+ */
+static bool nf_flow_tuple_fdb_stale(const struct flow_offload_tuple *tuple,
+				    const struct net *net,
+				    const struct nf_flow_fdb_ctx *ctx)
+{
+	const struct nf_flow_fdb_event *fe;
+
+	if (tuple->xmit_type != FLOW_OFFLOAD_XMIT_DIRECT ||
+	    !tuple->out.bridge_ifidx)
+		return false;
+
+	if (ctx->overflow)
+		return true;
+
+	list_for_each_entry_reverse(fe, ctx->list, list) {
+		if (fe->net == net && fe->vid == tuple->out.bridge_vid &&
+		    ether_addr_equal(fe->addr, tuple->out.h_dest))
+			return (fe->ifindex == tuple->out.bridge_ifidx) == fe->del;
+	}
+
+	return false;
+}
+
+static void nf_flow_table_do_fdb_event(struct nf_flowtable *flow_table,
+				       struct flow_offload *flow, void *data)
+{
+	const struct net *net = read_pnet(&flow_table->net);
+	struct nf_flow_fdb_ctx *ctx = data;
+
+	if (nf_flow_tuple_fdb_stale(&flow->tuplehash[0].tuple, net, ctx) ||
+	    nf_flow_tuple_fdb_stale(&flow->tuplehash[1].tuple, net, ctx)) {
+		flow_offload_teardown(flow);
+		ctx->found = true;
+	}
+}
+
+static void nf_flow_table_fdb_work(struct work_struct *work)
+{
+	struct nf_flow_fdb_event *fe, *next;
+	struct nf_flowtable *flowtable;
+	LIST_HEAD(list);
+	struct nf_flow_fdb_ctx ctx = { .list = &list };
+
+	spin_lock_bh(&nf_flow_fdb_lock);
+	list_splice_init(&nf_flow_fdb_list, &list);
+	ctx.overflow = nf_flow_fdb_overflow;
+	nf_flow_fdb_overflow = false;
+	nf_flow_fdb_len = 0;
+	spin_unlock_bh(&nf_flow_fdb_lock);
+
+	/* The bridge notifies after it changed or removed the entry. A flow
+	 * set up from the old entry is in its flowtable once the readers that
+	 * saw it are done.
+	 */
+	synchronize_rcu();
+
+	mutex_lock(&flowtable_lock);
+	list_for_each_entry(flowtable, &flowtables, list) {
+		ctx.found = false;
+		nf_flow_table_iterate(flowtable, nf_flow_table_do_fdb_event,
+				      &ctx);
+		if (ctx.found)
+			mod_delayed_work(system_power_efficient_wq,
+					 &flowtable->gc_work, 0);
+	}
+	mutex_unlock(&flowtable_lock);
+
+	list_for_each_entry_safe(fe, next, &list, list)
+		kfree(fe);
+}
+
+static DECLARE_WORK(nf_flow_fdb_work, nf_flow_table_fdb_work);
+
+static int nf_flow_table_switchdev_event(struct notifier_block *nb,
+					 unsigned long event, void *ptr)
+{
+	struct switchdev_notifier_fdb_info *fdb_info = ptr;
+	struct nf_flow_fdb_event *fe = NULL;
+	bool del;
+
+	switch (event) {
+	case SWITCHDEV_FDB_ADD_TO_DEVICE:
+	case SWITCHDEV_FDB_ADD_TO_BRIDGE:
+		del = false;
+		break;
+	case SWITCHDEV_FDB_DEL_TO_DEVICE:
+	case SWITCHDEV_FDB_DEL_TO_BRIDGE:
+		del = true;
+		break;
+	default:
+		return NOTIFY_DONE;
+	}
+
+	if (fdb_info->is_local)
+		return NOTIFY_DONE;
+
+	spin_lock_bh(&nf_flow_fdb_lock);
+	if (!nf_flow_fdb_overflow && nf_flow_fdb_len < NF_FLOW_FDB_MAX)
+		fe = kzalloc_obj(*fe, GFP_ATOMIC);
+	if (fe) {
+		fe->net = dev_net(fdb_info->info.dev);
+		fe->ifindex = fdb_info->info.dev->ifindex;
+		fe->vid = fdb_info->vid;
+		ether_addr_copy(fe->addr, fdb_info->addr);
+		fe->del = del;
+		list_add_tail(&fe->list, &nf_flow_fdb_list);
+		nf_flow_fdb_len++;
+	} else {
+		nf_flow_fdb_overflow = true;
+	}
+	spin_unlock_bh(&nf_flow_fdb_lock);
+
+	queue_work(system_unbound_wq, &nf_flow_fdb_work);
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block nf_flow_table_switchdev_nb = {
+	.notifier_call = nf_flow_table_switchdev_event,
+};
+
 void nf_flow_table_free(struct nf_flowtable *flow_table)
 {
 	mutex_lock(&flowtable_lock);
@@ -849,6 +1000,10 @@ static int __init nf_flow_table_module_i
 	if (ret)
 		goto out_offload;
 
+	ret = register_switchdev_notifier(&nf_flow_table_switchdev_nb);
+	if (ret)
+		goto out_switchdev;
+
 	ret = nf_flow_register_bpf();
 	if (ret)
 		goto out_bpf;
@@ -860,6 +1015,8 @@ static int __init nf_flow_table_module_i
 	return 0;
 
 out_bpf:
+	unregister_switchdev_notifier(&nf_flow_table_switchdev_nb);
+out_switchdev:
 	nf_flow_table_offload_exit();
 out_offload:
 	unregister_pernet_subsys(&nf_flow_table_net_ops);
@@ -868,6 +1025,8 @@ out_offload:
 
 static void __exit nf_flow_table_module_exit(void)
 {
+	unregister_switchdev_notifier(&nf_flow_table_switchdev_nb);
+	flush_work(&nf_flow_fdb_work);
 	unregister_netdevice_notifier(&flow_offload_netdev_notifier);
 	rcu_barrier();
 	nf_flow_table_offload_exit();
--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -147,6 +147,7 @@ struct flow_offload_tuple {
 		struct {
 			u32		ifidx;
 			u32		hw_ifidx;
+			u32		bridge_ifidx;
 			u16		bridge_vid;
 			u8		h_source[ETH_ALEN];
 			u8		h_dest[ETH_ALEN];
@@ -214,6 +215,7 @@ struct nf_flow_route {
 		struct {
 			u32			ifindex;
 			u32			hw_ifindex;
+			u32			bridge_ifindex;
 			u16			bridge_vid;
 			u8			h_source[ETH_ALEN];
 			u8			h_dest[ETH_ALEN];
--- a/net/netfilter/nf_flow_table_path.c
+++ b/net/netfilter/nf_flow_table_path.c
@@ -82,6 +82,7 @@ struct nft_forward_info {
 		__u16	id;
 		__be16	proto;
 	} encap[NF_FLOW_TABLE_ENCAP_MAX];
+	u32 bridge_ifidx;
 	u16 bridge_vid;
 	u8 num_encaps;
 	u8 ingress_vlans;
@@ -156,6 +157,10 @@ static void nft_dev_path_info(const stru
 			case DEV_PATH_BR_VLAN_KEEP:
 				break;
 			}
+			/* dev_fill_forward_path() adds the bridge port after
+			 * the bridge.
+			 */
+			info->bridge_ifidx = stack->path[i + 1].dev->ifindex;
 			info->bridge_vid = path->bridge.vlan_id;
 			info->xmit_type = FLOW_OFFLOAD_XMIT_DIRECT;
 			break;
@@ -225,6 +230,7 @@ static void nft_dev_forward_path(struct
 		memcpy(route->tuple[dir].out.h_source, info.h_source, ETH_ALEN);
 		memcpy(route->tuple[dir].out.h_dest, info.h_dest, ETH_ALEN);
 		route->tuple[dir].out.hw_ifindex = info.hw_outdev->ifindex;
+		route->tuple[dir].out.bridge_ifindex = info.bridge_ifidx;
 		route->tuple[dir].out.bridge_vid = info.bridge_vid;
 		route->tuple[dir].xmit_type = info.xmit_type;
 	}
