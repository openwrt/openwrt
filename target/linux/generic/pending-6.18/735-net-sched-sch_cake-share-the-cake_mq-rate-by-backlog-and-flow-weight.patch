-		q->hosts[flow->dsthost].dsthost_bulk_flow_count--;
+		WRITE_ONCE(q->hosts[flow->dsthost].dsthost_bulk_flow_count,
+			   q->hosts[flow->dsthost].dsthost_bulk_flow_count - 1);
 }
 
