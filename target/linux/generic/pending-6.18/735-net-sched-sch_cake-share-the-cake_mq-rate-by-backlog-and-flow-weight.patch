 }
 
-static u16 cake_get_flow_quantum(struct cake_tin_data *q,
-				 struct cake_flow *flow,
-				 int flow_mode)
+static u32 cake_host_load(struct cake_tin_data *q, struct cake_flow *flow,
+			  int flow_mode)
 {
-	u16 host_load = 1;
+	struct cake_host *srchost = &q->hosts[flow->srchost];
+	struct cake_host *dsthost = &q->hosts[flow->dsthost];
+	u32 host_load = 1;
 
 	if (cake_dsrc(flow_mode))
-		host_load = max(host_load,
-				q->hosts[flow->srchost].srchost_bulk_flow_count);
+		host_load = max_t(u32, host_load,
+				  srchost->srchost_bulk_flow_count +
+				  srchost->srchost_mq_count);
 
 	if (cake_ddst(flow_mode))
-		host_load = max(host_load,
-				q->hosts[flow->dsthost].dsthost_bulk_flow_count);
+		host_load = max_t(u32, host_load,
+				  dsthost->dsthost_bulk_flow_count +
+				  dsthost->dsthost_mq_count);
+
+	if (cake_hosts_only(flow_mode))
+		host_load = 1 + flow->mq_count;
+
+	return min(host_load, CAKE_QUEUES);
+}
 
+static u16 cake_get_flow_quantum(struct cake_tin_data *q,
+				 struct cake_flow *flow,
