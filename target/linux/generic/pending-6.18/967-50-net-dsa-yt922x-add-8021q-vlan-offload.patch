+		hdr->h_vlan_TCI = htons(tci | pvid);
+		return skb;
+	}
+	if (__vlan_insert_tag(skb, htons(ETH_P_8021Q), tci | pvid))
+		return NULL;
+	skb->protocol = htons(ETH_P_8021Q);
+	return skb;
+drop:
+	return NULL;
+}
