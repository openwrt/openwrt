+		if (skb_ensure_writable(skb, VLAN_ETH_HLEN))
+			goto drop;
+		hdr = skb_vlan_eth_hdr(skb);
+		tci = ntohs(hdr->h_vlan_TCI);
+		if (tci & VLAN_VID_MASK)
