+static int rtl8366ub_init_apply(struct rtl8366ub_priv *priv, int port,
+				const struct rtl8366ub_init_patch *patch,
+				size_t count, const char *stage)
+{
+	size_t i;
+	int ret;
+
+	for (i = 0; i < count; i++) {
+		ret = rtl8366ub_ocp_write(priv, port, patch[i].reg,
+					 patch[i].val);
+		if (ret)
+			return dev_err_probe(priv->dev, ret,
+				"%s patch failed on port %d at entry %zu\n",
+				stage, port, i);
+	}
+	return 0;
+}
+
+static int rtl8366ub_init_patch_request(struct rtl8366ub_priv *priv,
+					bool enable)
+{
+	int port;
+
+	for (port = 0; port < RTL8366UB_NUM_PORTS; port++) {
+		u16 val;
+		int ret;
+		int i;
+
+		if (enable) {
+			ret = rtl8366ub_ocp_read(priv, port,
+					 RTL8366UB_PATCH_STATE_REG, &val);
+			if (ret)
+				return ret;
+			val = FIELD_GET(RTL8366UB_PATCH_STATE_MASK, val);
+			if (val != RTL8366UB_PATCH_STATE_3 &&
+			    val != RTL8366UB_PATCH_STATE_5)
+				return dev_err_probe(priv->dev, -EIO,
+					"unexpected PHY patch state %u on port %d\n",
+					val, port);
+		}
+
+		ret = rtl8366ub_ocp_write(priv, port,
+					  RTL8366UB_PATCH_REQUEST_REG,
+					  enable ? RTL8366UB_PATCH_REQUEST_ENABLE : 0);
+		if (ret)
+			return ret;
+		if (!enable)
+			continue;
+
+		for (i = 0; i < RTL8366UB_PATCH_POLL_RETRIES; i++) {
+			ret = rtl8366ub_ocp_read(priv, port,
+						 RTL8366UB_PATCH_READY_REG, &val);
+			if (ret)
+				return ret;
+			if (val & RTL8366UB_PATCH_READY)
+				break;
+		}
+		if (i == RTL8366UB_PATCH_POLL_RETRIES)
+			return dev_err_probe(priv->dev, -ETIMEDOUT,
+				"PHY patch request timed out on port %d\n", port);
+	}
+	return 0;
+}
+
+static int rtl8366ub_init_selected_patch(struct rtl8366ub_priv *priv,
+					 bool want_2p5g,
+					 const struct rtl8366ub_init_patch *patch,
+					 size_t count, const char *stage)
+{
+	int port;
+
+	for (port = 0; port < RTL8366UB_NUM_PORTS; port++) {
+		const struct rtl8366ub_port_info *info;
+		int ret;
+
+		info = rtl8366ub_get_port_info(port);
+		if (!info || info->supports_2p5g != want_2p5g)
+			continue;
+		ret = rtl8366ub_init_apply(priv, port, patch, count, stage);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
