+static int rtl8366ub_init_dataram(struct rtl8366ub_priv *priv)
+{
+	int port;
+
+	for (port = 0; port < RTL8366UB_NUM_PORTS; port++) {
+		const struct rtl8366ub_port_info *info;
+		u16 val;
+		int ret;
+
+		info = rtl8366ub_get_port_info(port);
+		if (!info || !info->supports_2p5g)
+			continue;
+
+		ret = rtl8366ub_ocp_read(priv, port, 0xb820, &val);
+		if (ret)
+			return ret;
+		ret = rtl8366ub_ocp_write(priv, port, 0xb820, val & ~BIT(7));
+		if (ret)
+			return ret;
+		ret = rtl8366ub_ocp_read(priv, port, 0xb896, &val);
+		if (ret)
+			return ret;
+		ret = rtl8366ub_ocp_write(priv, port, 0xb896, val & ~BIT(0));
+		if (ret)
+			return ret;
+		ret = rtl8366ub_ocp_read(priv, port, 0xb892, &val);
+		if (ret)
+			return ret;
+		ret = rtl8366ub_ocp_write(priv, port, 0xb892,
+					  val & ~GENMASK(15, 8));
+		if (ret)
+			return ret;
+		ret = rtl8366ub_init_apply(priv, port, rtl8366ub_dataram_patch,
+					   ARRAY_SIZE(rtl8366ub_dataram_patch),
+					   "data RAM");
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int rtl8366ub_init_alg_giga(struct rtl8366ub_priv *priv)
+{
+	int port;
+
+	for (port = 0; port < RTL8366UB_NUM_PORTS; port++) {
+		const struct rtl8366ub_port_info *info;
+		u16 val;
+		int ret;
+
+		info = rtl8366ub_get_port_info(port);
+		if (!info || info->supports_2p5g)
+			continue;
+		ret = rtl8366ub_ocp_read(priv, port, 0xa87e, &val);
+		if (ret)
+			return ret;
+		val = (val & ~GENMASK(12, 8)) |
+		      FIELD_PREP(GENMASK(12, 8), 0x10);
+		ret = rtl8366ub_ocp_write(priv, port, 0xa87e, val);
+		if (ret)
+			return ret;
+		ret = rtl8366ub_init_apply(priv, port, rtl8366ub_alg_giga_patch,
+					   ARRAY_SIZE(rtl8366ub_alg_giga_patch),
+					   "ALG Giga");
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int rtl8366ub_init_ncrp(struct rtl8366ub_priv *priv)
+{
+	int port;
+
+	for (port = 0; port < RTL8366UB_NUM_PORTS; port++) {
+		const struct rtl8366ub_port_info *info;
+		u16 val;
+		int ret;
+
+		info = rtl8366ub_get_port_info(port);
+		if (!info || !info->supports_2p5g)
+			continue;
+		ret = rtl8366ub_ocp_read(priv, port, 0xb820, &val);
+		if (ret)
+			return ret;
+		ret = rtl8366ub_ocp_write(priv, port, 0xb820, val | BIT(7));
+		if (ret)
+			return ret;
+		ret = rtl8366ub_init_apply(priv, port, rtl8366ub_ncrp_patch,
+					   ARRAY_SIZE(rtl8366ub_ncrp_patch),
+					   "NCRP");
+		if (ret)
+			return ret;
+		ret = rtl8366ub_ocp_read(priv, port, 0xb820, &val);
+		if (ret)
+			return ret;
+		ret = rtl8366ub_ocp_write(priv, port, 0xb820, val & ~BIT(7));
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+int rtl8366ub_hw_init(struct rtl8366ub_priv *priv)
+{
+	int ret;
+
+	ret = rtl8366ub_init_patch_request(priv, true);
+	if (ret)
+		return ret;
+	ret = rtl8366ub_reg_write(priv, RTL8366UB_TX_POLARITY_REG, 0x00a5);
+	if (ret)
+		return dev_err_probe(priv->dev, ret, "top patch failed\n");
+	ret = rtl8366ub_init_selected_patch(priv, true, rtl8366ub_afe_patch,
+			ARRAY_SIZE(rtl8366ub_afe_patch), "AFE");
+	if (ret)
+		return ret;
+	ret = rtl8366ub_init_selected_patch(priv, false,
+			rtl8366ub_giga_phy_patch,
+			ARRAY_SIZE(rtl8366ub_giga_phy_patch), "Giga PHY");
+	if (ret)
+		return ret;
+	ret = rtl8366ub_init_dataram(priv);
+	if (ret)
+		return ret;
+	ret = rtl8366ub_init_alg_giga(priv);
+	if (ret)
+		return ret;
+	ret = rtl8366ub_init_ncrp(priv);
+	if (ret)
+		return ret;
+	ret = rtl8366ub_init_selected_patch(priv, true,
+			rtl8366ub_alg_2p5g_patch,
+			ARRAY_SIZE(rtl8366ub_alg_2p5g_patch), "ALG 2.5G");
+	if (ret)
+		return ret;
+	return rtl8366ub_init_patch_request(priv, false);
+}
diff --git a/drivers/net/dsa/realtek/rtl8366ub_l2.c b/drivers/net/dsa/realtek/rtl8366ub_l2.c
new file mode 100644
index 0000000..784bd00
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl8366ub_l2.c
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/etherdevice.h>
+#include <linux/string.h>
+
+#include "rtl8366ub_dsa.h"
+#include "rtl8366ub_l2.h"
+#include "rtl8366ub_reg.h"
+#include "rtl8366ub_table.h"
+
+#define RTL8366UB_L2_BYTE_LO            GENMASK(7, 0)
+#define RTL8366UB_L2_BYTE_HI            GENMASK(15, 8)
+#define RTL8366UB_L2_VID                GENMASK(11, 0)
+#define RTL8366UB_L2_IVL                BIT(13)
+#define RTL8366UB_L2_PORT_LO            GENMASK(15, 14)
+#define RTL8366UB_L2_PORT_HI            BIT(0)
+#define RTL8366UB_L2_AGE                GENMASK(3, 1)
+#define RTL8366UB_L2_MEMBER_LO          GENMASK(15, 14)
+#define RTL8366UB_L2_MEMBER_HI          GENMASK(5, 0)
+#define RTL8366UB_L2_STATIC             BIT(6)
+#define RTL8366UB_L2_FLUSH_CMD_REG      0x369e
+#define RTL8366UB_L2_FLUSH_MODE_REG     0x36a2
+#define RTL8366UB_L2_FLUSH_BUSY         GENMASK(15, 8)
+#define RTL8366UB_L2_FLUSH_RETRIES      100
+#define RTL8366UB_L2_LEARN_LIMIT_BASE   0x3674
+#define RTL8366UB_L2_LEARN_LIMIT_MASK   GENMASK(11, 0)
+#define RTL8366UB_L2_LEARN_LIMIT_MAX    2056
+#define RTL8366UB_L2_LUT_CONFIG_REG     0x3698
+#define RTL8366UB_L2_BCAM_DISABLE       BIT(6)
+#define RTL8366UB_L2_IPMC_HASH          BIT(4)
+#define RTL8366UB_L2_AGE_TIMER_REG      0x369c
+#define RTL8366UB_L2_AGE_TIME           300
+
+static int rtl8366ub_l2_update_bits(struct rtl8366ub_priv *priv, u16 reg,
+                                    u16 mask, u16 val)
+{
+    u16 data;
+    int ret;
+
+    ret = rtl8366ub_reg_read(priv, reg, &data);
+    if (ret)
+        return ret;
+    data = (data & ~mask) | (val & mask);
+    return rtl8366ub_reg_write(priv, reg, data);
+}
+
+static int rtl8366ub_l2_set_learning_limit(struct rtl8366ub_priv *priv,
+                                           int port, u16 limit)
+{
+    const struct rtl8366ub_port_info *info;
+
+    if (limit > RTL8366UB_L2_LEARN_LIMIT_MAX)
+        return -EINVAL;
+    info = rtl8366ub_get_port_info(port);
+    if (!info)
+        return -EINVAL;
+    return rtl8366ub_l2_update_bits(priv,
+            RTL8366UB_L2_LEARN_LIMIT_BASE + info->physical_port * 2,
+            RTL8366UB_L2_LEARN_LIMIT_MASK, limit);
+}
+
+int rtl8366ub_l2_setup(struct rtl8366ub_priv *priv, int cpu_port)
+{
+    int port;
+    int ret;
+
+    ret = rtl8366ub_l2_update_bits(priv, RTL8366UB_L2_LUT_CONFIG_REG,
+                                   RTL8366UB_L2_IPMC_HASH, 0);
+    if (ret)
+        return ret;
+    ret = rtl8366ub_l2_update_bits(priv, RTL8366UB_L2_LUT_CONFIG_REG,
+                                   RTL8366UB_L2_BCAM_DISABLE, 0);
+    if (ret)
+        return ret;
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_L2_AGE_TIMER_REG,
+                              RTL8366UB_L2_AGE_TIME * 10);
+    if (ret)
+        return ret;
+
+    for (port = 0; port <= RTL8366UB_MAX_LOGICAL_PORT; port++) {
+        if (!rtl8366ub_get_port_info(port))
+            continue;
+        ret = rtl8366ub_l2_set_learning_limit(priv, port,
+                                      RTL8366UB_L2_LEARN_LIMIT_MAX);
+        if (ret)
+            return ret;
+    }
+
+    return rtl8366ub_l2_set_learning_limit(priv, cpu_port, 0);
+}
+
+static int rtl8366ub_l2_phys_port(int port)
+{
+    const struct rtl8366ub_port_info *info = rtl8366ub_get_port_info(port);
+
+    if (!info || info->physical_port > 7)
+        return -EINVAL;
+
+    return info->physical_port;
+}
+
+static void rtl8366ub_l2_set_key(u16 *data, const u8 *mac, u16 vid)
+{
+    memset(data, 0, RTL8366UB_L2_ENTRY_WORDS * sizeof(*data));
+    data[0] = mac[5] | mac[4] << 8;
+    data[1] = mac[3] | mac[2] << 8;
+    data[2] = mac[1] | mac[0] << 8;
+    data[3] = FIELD_PREP(RTL8366UB_L2_VID, vid) | RTL8366UB_L2_IVL;
+}
+
+static void rtl8366ub_l2_get_key(const u16 *data, u8 *mac, u16 *vid)
+{
+    mac[5] = FIELD_GET(RTL8366UB_L2_BYTE_LO, data[0]);
+    mac[4] = FIELD_GET(RTL8366UB_L2_BYTE_HI, data[0]);
+    mac[3] = FIELD_GET(RTL8366UB_L2_BYTE_LO, data[1]);
+    mac[2] = FIELD_GET(RTL8366UB_L2_BYTE_HI, data[1]);
+    mac[1] = FIELD_GET(RTL8366UB_L2_BYTE_LO, data[2]);
+    mac[0] = FIELD_GET(RTL8366UB_L2_BYTE_HI, data[2]);
+    *vid = FIELD_GET(RTL8366UB_L2_VID, data[3]);
+}
+
+static int rtl8366ub_l2_lookup(struct rtl8366ub_priv *priv, const u8 *mac,
+                               u16 vid, u16 *address, u16 *data)
+{
+    rtl8366ub_l2_set_key(data, mac, vid);
+    return rtl8366ub_table_l2_query(priv, RTL8366UB_TABLE_OP_READ, address,
+                                    RTL8366UB_L2_METHOD_MAC, 0, data);
+}
+
+static bool rtl8366ub_l2_entry_matches(const u8 *mac, const u16 *actual,
+                                       const u16 *expected)
+{
+    if (memcmp(actual, expected, 4 * sizeof(*actual)))
+        return false;
+
+    if (is_multicast_ether_addr(mac))
+        return (actual[4] & GENMASK(6, 0)) ==
+               (expected[4] & GENMASK(6, 0));
+
+    return (actual[4] & (RTL8366UB_L2_PORT_HI | RTL8366UB_L2_STATIC)) ==
+           (expected[4] & (RTL8366UB_L2_PORT_HI | RTL8366UB_L2_STATIC));
+}
+
+static int rtl8366ub_l2_commit(struct rtl8366ub_priv *priv, const u8 *mac,
+                               u16 vid, u16 *data, bool present)
+{
+    u16 expected[RTL8366UB_L2_ENTRY_WORDS];
+    u16 address = 0;
+    int ret;
+
+    memcpy(expected, data, sizeof(expected));
+    ret = rtl8366ub_table_l2_query(priv, RTL8366UB_TABLE_OP_WRITE,
+                                   &address, RTL8366UB_L2_METHOD_MAC, 0, data);
+    if (ret)
+        return ret;
+
+    address = 0;
+    ret = rtl8366ub_l2_lookup(priv, mac, vid, &address, data);
+    if (!present)
+        return ret == -ENOENT ? 0 : ret ? ret : -EIO;
+    if (ret == -ENOENT)
+        return -ENOSPC;
+    if (ret)
+        return ret;
+
+    return rtl8366ub_l2_entry_matches(mac, data, expected) ? 0 : -EIO;
+}
+
+int rtl8366ub_fdb_add(struct rtl8366ub_priv *priv, const u8 *mac, u16 vid,
+                      u8 port, bool is_static)
+{
+    u16 data[RTL8366UB_L2_ENTRY_WORDS];
+    int physical = rtl8366ub_l2_phys_port(port);
+
+    if (!is_unicast_ether_addr(mac) || physical < 0)
+        return -EINVAL;
+    rtl8366ub_l2_set_key(data, mac, vid);
+    data[3] |= FIELD_PREP(RTL8366UB_L2_PORT_LO, physical & 3);
+    data[4] |= FIELD_PREP(RTL8366UB_L2_PORT_HI, physical >> 2) |
+               FIELD_PREP(RTL8366UB_L2_AGE, 6);
+    if (is_static)
+        data[4] |= RTL8366UB_L2_STATIC;
+
+    return rtl8366ub_l2_commit(priv, mac, vid, data, true);
+}
+
+int rtl8366ub_fdb_del(struct rtl8366ub_priv *priv, const u8 *mac, u16 vid)
+{
+    u16 data[RTL8366UB_L2_ENTRY_WORDS];
+    u16 address = 0;
+    int ret;
+
+    if (!is_unicast_ether_addr(mac))
+        return -EINVAL;
+    ret = rtl8366ub_l2_lookup(priv, mac, vid, &address, data);
+    if (ret == -ENOENT)
+        return 0;
+    if (ret)
+        return ret;
+    rtl8366ub_l2_set_key(data, mac, vid);
+    return rtl8366ub_l2_commit(priv, mac, vid, data, false);
+}
+
+int rtl8366ub_fdb_next(struct rtl8366ub_priv *priv, u16 *address, int port,
+                       struct rtl8366ub_fdb_entry *entry)
+{
+    u16 data[RTL8366UB_L2_ENTRY_WORDS] = { 0 };
+    u16 requested;
+    int physical = rtl8366ub_l2_phys_port(port);
+    int ret;
+
+    if (!address || !entry || physical < 0)
+        return -EINVAL;
+    requested = *address;
+    ret = rtl8366ub_table_l2_query(priv, RTL8366UB_TABLE_OP_READ, address,
+                                    RTL8366UB_L2_METHOD_NEXT_FDB_PORT,
+                                    physical, data);
+    if (ret)
+        return ret;
+    if (*address < requested)
+        return -ENOENT;
+    rtl8366ub_l2_get_key(data, entry->mac, &entry->vid);
+    entry->port = port;
+    entry->is_static = !!(data[4] & RTL8366UB_L2_STATIC);
+    return 0;
+}
+
+int rtl8366ub_fdb_flush(struct rtl8366ub_priv *priv, int port)
+{
+    unsigned int retries;
+    int physical = rtl8366ub_l2_phys_port(port);
+    u16 val;
+    int ret;
+
+    if (physical < 0)
+        return -EINVAL;
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_L2_FLUSH_MODE_REG, 0);
+    if (ret)
+        return ret;
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_L2_FLUSH_CMD_REG,
+                              BIT(physical));
+    if (ret)
+        return ret;
+    for (retries = 0; retries < RTL8366UB_L2_FLUSH_RETRIES; retries++) {
+        ret = rtl8366ub_reg_read(priv, RTL8366UB_L2_FLUSH_CMD_REG, &val);
+        if (ret)
+            return ret;
+        if (!(FIELD_GET(RTL8366UB_L2_FLUSH_BUSY, val) & BIT(physical)))
+            return 0;
+        usleep_range(10, 20);
+    }
+    return -ETIMEDOUT;
+}
+
+static u8 rtl8366ub_l2_members(const u16 *data)
+{
+    return FIELD_GET(RTL8366UB_L2_MEMBER_LO, data[3]) |
+           FIELD_GET(RTL8366UB_L2_MEMBER_HI, data[4]) << 2;
+}
+
+static void rtl8366ub_l2_set_members(u16 *data, u8 members)
+{
+    data[3] |= FIELD_PREP(RTL8366UB_L2_MEMBER_LO, members & 3);
+    data[4] |= FIELD_PREP(RTL8366UB_L2_MEMBER_HI, members >> 2);
+}
+
+int rtl8366ub_mdb_add(struct rtl8366ub_priv *priv, const u8 *mac, u16 vid,
+                      int port)
+{
+    u16 data[RTL8366UB_L2_ENTRY_WORDS];
+    u16 address = 0;
+    int physical = rtl8366ub_l2_phys_port(port);
+    u8 members;
+    int ret;
+
+    if (!is_multicast_ether_addr(mac) || physical < 0)
+        return -EINVAL;
+    ret = rtl8366ub_l2_lookup(priv, mac, vid, &address, data);
+    members = ret == -ENOENT ? 0 : rtl8366ub_l2_members(data);
+    if (ret && ret != -ENOENT)
+        return ret;
+    members |= BIT(physical);
+    rtl8366ub_l2_set_key(data, mac, vid);
+    rtl8366ub_l2_set_members(data, members);
+    data[4] |= RTL8366UB_L2_STATIC;
+
+    return rtl8366ub_l2_commit(priv, mac, vid, data, true);
+}
+
+int rtl8366ub_mdb_del(struct rtl8366ub_priv *priv, const u8 *mac, u16 vid,
+                      int port)
+{
+    u16 data[RTL8366UB_L2_ENTRY_WORDS];
+    u16 address = 0;
+    int physical = rtl8366ub_l2_phys_port(port);
+    u8 members;
+    int ret;
+
+    if (!is_multicast_ether_addr(mac) || physical < 0)
+        return -EINVAL;
+    ret = rtl8366ub_l2_lookup(priv, mac, vid, &address, data);
+    if (ret == -ENOENT)
+        return 0;
+    if (ret)
+        return ret;
+    members = rtl8366ub_l2_members(data) & ~BIT(physical);
+    rtl8366ub_l2_set_key(data, mac, vid);
+    rtl8366ub_l2_set_members(data, members);
+    if (members)
+        data[4] |= RTL8366UB_L2_STATIC;
+
+    return rtl8366ub_l2_commit(priv, mac, vid, data, members != 0);
+}
diff --git a/drivers/net/dsa/realtek/rtl8366ub_mib.c b/drivers/net/dsa/realtek/rtl8366ub_mib.c
new file mode 100644
index 0000000..f286cbd
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl8366ub_mib.c
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/ethtool.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+
+#include "rtl8366ub_dsa.h"
+#include "rtl8366ub_mib.h"
+#include "rtl8366ub_reg.h"
+
+#define RTL8366UB_MIB_DATA_BASE       0x04e0
+#define RTL8366UB_MIB_ADDR_REG        0x04e8
+#define RTL8366UB_MIB_CMD_REG         0x04ea
+#define RTL8366UB_MIB_BUSY            BIT(0)
+#define RTL8366UB_MIB_PORT_OFFSET     0x60
+#define RTL8366UB_MIB_TIMEOUT         100
+
+struct rtl8366ub_mib_desc {
+    char name[ETH_GSTRING_LEN];
+    u8 index;
+    u8 words;
+};
+
+static const u8 rtl8366ub_mib_words[] = {
+    4, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2,
+    4, 2, 2, 2, 2, 2, 2, 2, 2,
+    4, 2, 2, 2, 2, 2, 2, 2, 2,
+    4, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2,
+};
+
+static const struct rtl8366ub_mib_desc rtl8366ub_mibs[] = {
+    { "ifInOctets", 0, 4 },
+    { "ifOutOctets", 29, 4 },
+    { "ifInUcastPkts", 7, 2 },
+    { "ifInMulticastPkts", 9, 2 },
+    { "ifInBroadcastPkts", 10, 2 },
+    { "ifOutUcastPkts", 39, 2 },
+    { "ifOutMulticastPkts", 40, 2 },
+    { "ifOutBroadcastPkts", 41, 2 },
+    { "dot3StatsFCSErrors", 1, 2 },
+    { "dot3StatsSymbolErrors", 2, 2 },
+    { "dot3InPauseFrames", 3, 2 },
+    { "dot3OutPauseFrames", 36, 2 },
+    { "etherStatsFragments", 5, 2 },
+    { "etherStatsJabbers", 6, 2 },
+    { "etherStatsDropEvents", 8, 2 },
+    { "dot1dTpPortInDiscards", 38, 2 },
+    { "ifOutDiscards", 37, 2 },
+};
+
+static int rtl8366ub_mib_read(struct rtl8366ub_priv *priv, int port,
+                              const struct rtl8366ub_mib_desc *desc,
+                              u64 *value)
+{
+    const struct rtl8366ub_port_info *info;
+    unsigned int offset = 0;
+    u16 val;
+    int slot;
+    int ret;
+    int i;
+
+    info = rtl8366ub_get_port_info(port);
+    if (!info || desc->index >= ARRAY_SIZE(rtl8366ub_mib_words))
+        return -EINVAL;
+    for (i = 0; i < desc->index; i++)
+        offset += rtl8366ub_mib_words[i];
+    offset += RTL8366UB_MIB_PORT_OFFSET * info->physical_port;
+
+    mutex_lock(&priv->mib_mutex);
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_MIB_ADDR_REG, offset >> 2);
+    if (ret)
+        goto out;
+    for (i = 0; i < RTL8366UB_MIB_TIMEOUT; i++) {
+        ret = rtl8366ub_reg_read(priv, RTL8366UB_MIB_CMD_REG, &val);
+        if (ret || !(val & RTL8366UB_MIB_BUSY))
+            break;
+    }
+    if (!ret && (val & RTL8366UB_MIB_BUSY))
+        ret = -ETIMEDOUT;
+    if (ret)
+        goto out;
+
+    *value = 0;
+    slot = desc->words == 4 ? 3 : (offset + 1) % 4;
+    for (i = 0; i < desc->words; i++, slot--) {
+        ret = rtl8366ub_reg_read(priv,
+                RTL8366UB_MIB_DATA_BASE + slot * 2, &val);
+        if (ret)
+            goto out;
+        *value = (*value << 16) | val;
+    }
+out:
+    mutex_unlock(&priv->mib_mutex);
+    return ret;
+}
+
+int rtl8366ub_mib_count(void)
+{
+    return ARRAY_SIZE(rtl8366ub_mibs);
+}
+
+void rtl8366ub_mib_get_strings(u8 *data)
+{
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(rtl8366ub_mibs); i++)
+        ethtool_puts(&data, rtl8366ub_mibs[i].name);
+}
+
+void rtl8366ub_mib_get_stats(struct rtl8366ub_priv *priv, int port, u64 *data)
+{
+    int i;
+
+    memset(data, 0, sizeof(*data) * ARRAY_SIZE(rtl8366ub_mibs));
+    for (i = 0; i < ARRAY_SIZE(rtl8366ub_mibs); i++)
+        rtl8366ub_mib_read(priv, port, &rtl8366ub_mibs[i], &data[i]);
+}
diff --git a/drivers/net/dsa/realtek/rtl8366ub_phy.c b/drivers/net/dsa/realtek/rtl8366ub_phy.c
new file mode 100644
index 0000000..73a46a8
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl8366ub_phy.c
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/ethtool.h>
+#include <linux/mii.h>
+#include <linux/of.h>
+#include <linux/phy.h>
+#include <net/dsa.h>
+
+#include "rtl8366ub_dsa.h"
+
+#define RTL8366UB_PHY_2P5G_ADV_REG 0xa5d4
+#define RTL8366UB_PHY_2P5G_ADV     BIT(7)
+#define RTL8366UB_PHY_RESOLVED_REG 0xa434
+
+static struct rtl8366ub_priv *rtl8366ub_phy_priv(struct phy_device *phydev)
+{
+    return dev_get_drvdata(phydev->mdio.bus->parent);
+}
+
+static int rtl8366ub_phy_match(struct phy_device *phydev,
+                               const struct phy_driver *phydrv)
+{
+    struct device *parent = phydev->mdio.bus->parent;
+
+    return phydev->mdio.addr < RTL8366UB_NUM_PORTS && parent->of_node &&
+           of_device_is_compatible(parent->of_node, "realtek,rtl8366ub");
+}
+
+static int rtl8366ub_phy_get_features(struct phy_device *phydev)
+{
+    const struct rtl8366ub_port_info *info;
+
+    linkmode_zero(phydev->supported);
+    linkmode_set_bit(ETHTOOL_LINK_MODE_TP_BIT, phydev->supported);
+    linkmode_set_bit(ETHTOOL_LINK_MODE_MII_BIT, phydev->supported);
+    linkmode_set_bit(ETHTOOL_LINK_MODE_Autoneg_BIT, phydev->supported);
+    linkmode_set_bit(ETHTOOL_LINK_MODE_Pause_BIT, phydev->supported);
+    linkmode_set_bit(ETHTOOL_LINK_MODE_Asym_Pause_BIT, phydev->supported);
+    linkmode_set_bit(ETHTOOL_LINK_MODE_10baseT_Half_BIT, phydev->supported);
+    linkmode_set_bit(ETHTOOL_LINK_MODE_10baseT_Full_BIT, phydev->supported);
+    linkmode_set_bit(ETHTOOL_LINK_MODE_100baseT_Half_BIT, phydev->supported);
+    linkmode_set_bit(ETHTOOL_LINK_MODE_100baseT_Full_BIT, phydev->supported);
+    linkmode_set_bit(ETHTOOL_LINK_MODE_1000baseT_Full_BIT, phydev->supported);
+    info = rtl8366ub_get_port_info(phydev->mdio.addr);
+    if (info && info->supports_2p5g)
+        linkmode_set_bit(ETHTOOL_LINK_MODE_2500baseT_Full_BIT,
+                         phydev->supported);
+
+    return 0;
+}
+
+static int rtl8366ub_phy_config_aneg(struct phy_device *phydev)
+{
+    struct rtl8366ub_priv *priv = rtl8366ub_phy_priv(phydev);
+    u16 adv;
+    u16 ctrl1000;
+    u16 ctrl;
+    u16 adv2p5g;
+    int ret;
+
+    if (!priv)
+        return -ENODEV;
+
+    if (phydev->autoneg == AUTONEG_ENABLE) {
+        adv = linkmode_adv_to_mii_adv_t(phydev->advertising);
+        ctrl1000 = linkmode_adv_to_mii_ctrl1000_t(phydev->advertising);
+
+        ret = rtl8366ub_phy_read(priv, phydev->mdio.addr, MII_ADVERTISE,
+                                 &ctrl);
+        if (ret)
+            return ret;
+        adv = (ctrl & ~(ADVERTISE_ALL | ADVERTISE_PAUSE_CAP |
+                        ADVERTISE_PAUSE_ASYM)) |
+              (adv & (ADVERTISE_ALL | ADVERTISE_PAUSE_CAP |
+                      ADVERTISE_PAUSE_ASYM));
+        ret = rtl8366ub_phy_write(priv, phydev->mdio.addr, MII_ADVERTISE,
+                                  adv);
+        if (ret)
+            return ret;
+
+        ret = rtl8366ub_phy_read(priv, phydev->mdio.addr, MII_CTRL1000,
+                                 &ctrl);
+        if (ret)
+            return ret;
+        ctrl = (ctrl & ~ADVERTISE_1000FULL) |
+               (ctrl1000 & ADVERTISE_1000FULL);
+        ret = rtl8366ub_phy_write(priv, phydev->mdio.addr, MII_CTRL1000,
+                                  ctrl);
+        if (ret)
+            return ret;
+
+        ret = rtl8366ub_ocp_read(priv, phydev->mdio.addr,
+                                 RTL8366UB_PHY_2P5G_ADV_REG, &adv2p5g);
+        if (ret)
+            return ret;
+        if (linkmode_test_bit(ETHTOOL_LINK_MODE_2500baseT_Full_BIT,
+                              phydev->advertising))
+            adv2p5g |= RTL8366UB_PHY_2P5G_ADV;
+        else
+            adv2p5g &= ~RTL8366UB_PHY_2P5G_ADV;
+        ret = rtl8366ub_ocp_write(priv, phydev->mdio.addr,
+                                  RTL8366UB_PHY_2P5G_ADV_REG, adv2p5g);
+        if (ret)
+            return ret;
+
+        ret = rtl8366ub_phy_read(priv, phydev->mdio.addr, MII_BMCR,
+                                 &ctrl);
+        if (ret)
+            return ret;
+        ctrl &= ~(BMCR_SPEED1000 | BMCR_SPEED100 | BMCR_FULLDPLX);
+        ctrl |= BMCR_ANENABLE | BMCR_ANRESTART;
+
+        return rtl8366ub_phy_write(priv, phydev->mdio.addr, MII_BMCR,
+                                   ctrl);
+    }
+
+    if (phydev->speed != SPEED_10 && phydev->speed != SPEED_100)
+        return -EINVAL;
+    if (phydev->duplex != DUPLEX_HALF && phydev->duplex != DUPLEX_FULL)
+        return -EINVAL;
+
+    ctrl = phydev->speed == SPEED_100 ? BMCR_SPEED100 : 0;
+    if (phydev->duplex == DUPLEX_FULL)
+        ctrl |= BMCR_FULLDPLX;
+
+    ret = rtl8366ub_phy_write(priv, phydev->mdio.addr, MII_BMCR,
+                              ctrl | BMCR_PDOWN);
+    if (ret)
+        return ret;
+
+    return rtl8366ub_phy_write(priv, phydev->mdio.addr, MII_BMCR, ctrl);
+}
+
+static int rtl8366ub_phy_read_status(struct phy_device *phydev)
+{
+    struct rtl8366ub_priv *priv = rtl8366ub_phy_priv(phydev);
+    bool tx_pause;
+    bool rx_pause;
+    u16 resolved;
+    u16 bmsr;
+    u16 lpa;
+    int ret;
+
+    if (!priv)
+        return -ENODEV;
+
+    ret = rtl8366ub_ocp_read(priv, phydev->mdio.addr,
+                             RTL8366UB_PHY_RESOLVED_REG, &resolved);
+    if (ret)
+        return ret;
+
+    phydev->link = !!(resolved & BIT(2));
+    if (!phydev->link) {
+        phydev->speed = SPEED_UNKNOWN;
+        phydev->duplex = DUPLEX_UNKNOWN;
+        phydev->pause = 0;
+        phydev->asym_pause = 0;
+        phydev->autoneg_complete = 0;
+        linkmode_zero(phydev->lp_advertising);
+        return 0;
+    }
+
+    if (!(resolved & BIT(10)) && (resolved & BIT(9)) &&
+        !(resolved & BIT(5)) && (resolved & BIT(4)))
+        phydev->speed = SPEED_2500;
+    else if (!(resolved & BIT(10)) && !(resolved & BIT(9)) &&
+             (resolved & BIT(5)) && !(resolved & BIT(4)))
+        phydev->speed = SPEED_1000;
+    else if (!(resolved & BIT(10)) && !(resolved & BIT(9)) &&
+             !(resolved & BIT(5)) && (resolved & BIT(4)))
+        phydev->speed = SPEED_100;
+    else if (!(resolved & BIT(10)) && !(resolved & BIT(9)) &&
+             !(resolved & BIT(5)) && !(resolved & BIT(4)))
+        phydev->speed = SPEED_10;
+    else
+        phydev->speed = SPEED_UNKNOWN;
+
+    phydev->duplex = resolved & BIT(3) ? DUPLEX_FULL : DUPLEX_HALF;
+    phydev->pause = 0;
+    phydev->asym_pause = 0;
+    linkmode_zero(phydev->lp_advertising);
+
+    if (phydev->autoneg == AUTONEG_ENABLE) {
+        ret = rtl8366ub_phy_read(priv, phydev->mdio.addr, MII_BMSR, &bmsr);
+        if (ret)
+            return ret;
+        phydev->autoneg_complete = !!(bmsr & BMSR_ANEGCOMPLETE);
+
+        ret = rtl8366ub_phy_read(priv, phydev->mdio.addr, MII_LPA, &lpa);
+        if (ret)
+            return ret;
+        mii_lpa_to_linkmode_lpa_t(phydev->lp_advertising, lpa);
+    } else {
+        phydev->autoneg_complete = 0;
+    }
+
+    ret = rtl8366ub_port_get_mac_pause(priv, phydev->mdio.addr,
+                                       &tx_pause, &rx_pause);
+    if (!ret) {
+        linkmode_mod_bit(ETHTOOL_LINK_MODE_Pause_BIT,
+                         phydev->lp_advertising, tx_pause);
+        linkmode_mod_bit(ETHTOOL_LINK_MODE_Asym_Pause_BIT,
+                         phydev->lp_advertising, tx_pause != rx_pause);
+    }
+    if (phydev->autoneg == AUTONEG_ENABLE)
+        phy_resolve_aneg_pause(phydev);
+
+    return 0;
+}
+
+static struct phy_driver rtl8366ub_phy_driver = {
+    .phy_id = 0,
+    .phy_id_mask = 0,
+    .name = "Realtek RTL8366UB internal PHY",
+    .match_phy_device = rtl8366ub_phy_match,
+    .get_features = rtl8366ub_phy_get_features,
+    .config_aneg = rtl8366ub_phy_config_aneg,
+    .read_status = rtl8366ub_phy_read_status,
+};
+
+int rtl8366ub_phy_driver_register(void)
+{
+    return phy_drivers_register(&rtl8366ub_phy_driver, 1, THIS_MODULE);
+}
+
+void rtl8366ub_phy_driver_unregister(void)
+{
+    phy_drivers_unregister(&rtl8366ub_phy_driver, 1);
+}
diff --git a/drivers/net/dsa/realtek/rtl8366ub_port.c b/drivers/net/dsa/realtek/rtl8366ub_port.c
new file mode 100644
index 0000000..866dca9
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl8366ub_port.c
@@ -0,0 +1,252 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/bitfield.h>
+#include <linux/errno.h>
+#include <linux/mii.h>
+
+#include "rtl8366ub_dsa.h"
+#include "rtl8366ub_reg.h"
+
+#define RTL8366UB_OCP_MSB_REG          0x0028
+#define RTL8366UB_INDACC_CTRL_REG      0x1f00
+#define RTL8366UB_INDACC_STATUS_REG    0x1f02
+#define RTL8366UB_INDACC_ADDR_REG      0x1f04
+#define RTL8366UB_INDACC_WDATA_REG     0x1f06
+#define RTL8366UB_INDACC_RDATA_REG     0x1f08
+
+#define RTL8366UB_OCP_MSB_MASK         GENMASK(11, 6)
+#define RTL8366UB_INDACC_CMD           BIT(0)
+#define RTL8366UB_INDACC_WRITE         BIT(1)
+#define RTL8366UB_INDACC_BUSY          BIT(2)
+#define RTL8366UB_INDACC_PHY           BIT(13)
+#define RTL8366UB_INDACC_TIMEOUT       100
+
+#define RTL8366UB_PHY_REG_BASE         0xa400
+#define RTL8366UB_PHY_ENABLE_REG       0xa610
+#define RTL8366UB_PHY_ENABLED          0x2058
+#define RTL8366UB_PHY_DISABLED         0x2858
+
+#define RTL8366UB_MAC_FORCE_BASE       0x283c
+#define RTL8366UB_MAC_STATUS_BASE      0x284c
+#define RTL8366UB_MAC_PORT_STRIDE      2
+#define RTL8366UB_MAC_FORCE_MASK       GENMASK(9, 0)
+#define RTL8366UB_MAC_FORCE_RX_PAUSE   BIT(8)
+#define RTL8366UB_MAC_FORCE_TX_PAUSE   BIT(7)
+#define RTL8366UB_MAC_STATUS_TX_PAUSE  BIT(8)
+#define RTL8366UB_MAC_STATUS_RX_PAUSE  BIT(7)
+#define RTL8366UB_MAC_SPEED_MASK       GENMASK(6, 3)
+#define RTL8366UB_MAC_DUPLEX           BIT(2)
+#define RTL8366UB_MAC_LINK             BIT(1)
+
+static int rtl8366ub_ocp_prepare(struct rtl8366ub_priv *priv, int port,
+                                 u16 addr)
+{
+    const struct rtl8366ub_port_info *info;
+    u16 val;
+    int ret;
+
+    info = rtl8366ub_get_port_info(port);
+    if (!info || info->type != RTL8366UB_PORT_UTP || addr & 1)
+        return -EINVAL;
+
+    ret = rtl8366ub_reg_read(priv, RTL8366UB_OCP_MSB_REG, &val);
+    if (ret)
+        return ret;
+
+    val &= ~RTL8366UB_OCP_MSB_MASK;
+    val |= FIELD_PREP(RTL8366UB_OCP_MSB_MASK, addr >> 10);
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_OCP_MSB_REG, val);
+    if (ret)
+        return ret;
+
+    val = RTL8366UB_INDACC_PHY | ((addr >> 6 & 0xf) << 8) |
+          (info->physical_port << 5) | (addr >> 1 & 0x1f);
+
+    return rtl8366ub_reg_write(priv, RTL8366UB_INDACC_ADDR_REG, val);
+}
+
+static int rtl8366ub_ocp_wait(struct rtl8366ub_priv *priv)
+{
+    u16 val;
+    int ret;
+    int i;
+
+    for (i = 0; i < RTL8366UB_INDACC_TIMEOUT; i++) {
+        ret = rtl8366ub_reg_read(priv, RTL8366UB_INDACC_STATUS_REG, &val);
+        if (ret)
+            return ret;
+        if (!(val & RTL8366UB_INDACC_BUSY))
+            return 0;
+    }
+
+    return -ETIMEDOUT;
+}
+
+int rtl8366ub_ocp_read(struct rtl8366ub_priv *priv, int port, u16 addr,
+                       u16 *val)
+{
+    int ret;
+
+    if (!val)
+        return -EINVAL;
+
+    mutex_lock(&priv->phy_mutex);
+
+    ret = rtl8366ub_ocp_prepare(priv, port, addr);
+    if (ret)
+        goto out;
+
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_INDACC_CTRL_REG,
+                              RTL8366UB_INDACC_CMD);
+    if (ret)
+        goto out;
+
+    ret = rtl8366ub_ocp_wait(priv);
+    if (ret)
+        goto out;
+
+    ret = rtl8366ub_reg_read(priv, RTL8366UB_INDACC_RDATA_REG, val);
+
+out:
+    mutex_unlock(&priv->phy_mutex);
+    return ret;
+}
+
+int rtl8366ub_ocp_write(struct rtl8366ub_priv *priv, int port, u16 addr,
+                        u16 val)
+{
+    int ret;
+
+    mutex_lock(&priv->phy_mutex);
+
+    ret = rtl8366ub_ocp_prepare(priv, port, addr);
+    if (ret)
+        goto out;
+
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_INDACC_WDATA_REG, val);
+    if (ret)
+        goto out;
+
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_INDACC_CTRL_REG,
+                              RTL8366UB_INDACC_WRITE |
+                              RTL8366UB_INDACC_CMD);
+    if (ret)
+        goto out;
+
+    ret = rtl8366ub_ocp_wait(priv);
+
+out:
+    mutex_unlock(&priv->phy_mutex);
+    return ret;
+}
+
+int rtl8366ub_phy_read(struct rtl8366ub_priv *priv, int port, int reg,
+                       u16 *val)
+{
+    if (reg < 0 || reg > 0x1f)
+        return -EINVAL;
+
+    return rtl8366ub_ocp_read(priv, port,
+                              RTL8366UB_PHY_REG_BASE + reg * 2, val);
+}
+
+int rtl8366ub_phy_write(struct rtl8366ub_priv *priv, int port, int reg,
+                        u16 val)
+{
+    if (reg < 0 || reg > 0x1f)
+        return -EINVAL;
+
+    return rtl8366ub_ocp_write(priv, port,
+                               RTL8366UB_PHY_REG_BASE + reg * 2, val);
+}
+
+int rtl8366ub_port_set_enabled(struct rtl8366ub_priv *priv, int port,
+                               bool enabled)
+{
+    return rtl8366ub_ocp_write(priv, port, RTL8366UB_PHY_ENABLE_REG,
+                               enabled ? RTL8366UB_PHY_ENABLED :
+                                         RTL8366UB_PHY_DISABLED);
+}
+
+int rtl8366ub_port_set_mac(struct rtl8366ub_priv *priv, int port, int speed,
+                           int duplex, bool link, bool tx_pause,
+                           bool rx_pause)
+{
+    const struct rtl8366ub_port_info *info;
+    u16 reg;
+    u16 val;
+    int hw_speed;
+    int ret;
+
+    info = rtl8366ub_get_port_info(port);
+    if (!info || info->type != RTL8366UB_PORT_UTP)
+        return -EINVAL;
+
+    switch (speed) {
+    case SPEED_10:
+        hw_speed = 0;
+        break;
+    case SPEED_100:
+        hw_speed = 1;
+        break;
+    case SPEED_1000:
+        hw_speed = 2;
+        break;
+    case SPEED_2500:
+        if (!info->supports_2p5g)
+            return -EINVAL;
+        hw_speed = 5;
+        break;
+    default:
+        if (link)
+            return -EINVAL;
+        hw_speed = 0;
+        break;
+    }
+
+    reg = RTL8366UB_MAC_FORCE_BASE +
+          info->physical_port * RTL8366UB_MAC_PORT_STRIDE;
+    ret = rtl8366ub_reg_read(priv, reg, &val);
+    if (ret)
+        return ret;
+
+    val &= ~RTL8366UB_MAC_FORCE_MASK;
+    val |= FIELD_PREP(RTL8366UB_MAC_SPEED_MASK, hw_speed);
+    if (duplex == DUPLEX_FULL)
+        val |= RTL8366UB_MAC_DUPLEX;
+    if (link)
+        val |= RTL8366UB_MAC_LINK;
+    if (tx_pause)
+        val |= RTL8366UB_MAC_FORCE_TX_PAUSE;
+    if (rx_pause)
+        val |= RTL8366UB_MAC_FORCE_RX_PAUSE;
+
+    return rtl8366ub_reg_write(priv, reg, val);
+}
+
+int rtl8366ub_port_get_mac_pause(struct rtl8366ub_priv *priv, int port,
+                                 bool *tx_pause, bool *rx_pause)
+{
+    const struct rtl8366ub_port_info *info;
+    u16 val;
+    int ret;
+
+    if (!tx_pause || !rx_pause)
+        return -EINVAL;
+
+    info = rtl8366ub_get_port_info(port);
+    if (!info || info->type != RTL8366UB_PORT_UTP)
+        return -EINVAL;
+
+    ret = rtl8366ub_reg_read(priv,
+                             RTL8366UB_MAC_STATUS_BASE +
+                             info->physical_port * RTL8366UB_MAC_PORT_STRIDE,
+                             &val);
+    if (ret)
+        return ret;
+
+    *tx_pause = !!(val & RTL8366UB_MAC_STATUS_TX_PAUSE);
+    *rx_pause = !!(val & RTL8366UB_MAC_STATUS_RX_PAUSE);
+
+    return 0;
+}
diff --git a/drivers/net/dsa/realtek/rtl8366ub_reg.c b/drivers/net/dsa/realtek/rtl8366ub_reg.c
new file mode 100644
index 0000000..14709d8
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl8366ub_reg.c
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/errno.h>
+#include <linux/mdio.h>
+#include <linux/phy.h>
+
+#include "rtl8366ub_dsa.h"
+#include "rtl8366ub_reg.h"
+
+#define RTL8366UB_MDIO_CTRL0_REG       31
+#define RTL8366UB_MDIO_CTRL1_REG       21
+#define RTL8366UB_MDIO_ADDRESS_REG     23
+#define RTL8366UB_MDIO_DATA_WRITE_REG  24
+#define RTL8366UB_MDIO_DATA_READ_REG   25
+#define RTL8366UB_MDIO_ADDR_OP         0x000e
+#define RTL8366UB_MDIO_READ_OP         0x0001
+#define RTL8366UB_MDIO_WRITE_OP        0x0003
+
+int rtl8366ub_reg_read(struct rtl8366ub_priv *priv, u16 reg, u16 *val)
+{
+	int ret;
+
+	if (!priv || !priv->bus || !val)
+		return -EINVAL;
+
+	mutex_lock(&priv->bus->mdio_lock);
+	ret = __mdiobus_write(priv->bus, priv->mdio_addr,
+			      RTL8366UB_MDIO_CTRL0_REG,
+			      RTL8366UB_MDIO_ADDR_OP);
+	if (ret < 0)
+		goto out;
+	ret = __mdiobus_write(priv->bus, priv->mdio_addr,
+			      RTL8366UB_MDIO_ADDRESS_REG, reg);
+	if (ret < 0)
+		goto out;
+	ret = __mdiobus_write(priv->bus, priv->mdio_addr,
+			      RTL8366UB_MDIO_CTRL1_REG,
+			      RTL8366UB_MDIO_READ_OP);
+	if (ret < 0)
+		goto out;
+	ret = __mdiobus_read(priv->bus, priv->mdio_addr,
+			     RTL8366UB_MDIO_DATA_READ_REG);
+	if (ret >= 0) {
+		*val = ret;
+		ret = 0;
+	}
+out:
+	mutex_unlock(&priv->bus->mdio_lock);
+	return ret;
+}
+
+int rtl8366ub_reg_write(struct rtl8366ub_priv *priv, u16 reg, u16 val)
+{
+	int ret;
+
+	if (!priv || !priv->bus)
+		return -EINVAL;
+
+	mutex_lock(&priv->bus->mdio_lock);
+	ret = __mdiobus_write(priv->bus, priv->mdio_addr,
+			      RTL8366UB_MDIO_CTRL0_REG,
+			      RTL8366UB_MDIO_ADDR_OP);
+	if (ret < 0)
+		goto out;
+	ret = __mdiobus_write(priv->bus, priv->mdio_addr,
+			      RTL8366UB_MDIO_ADDRESS_REG, reg);
+	if (ret < 0)
+		goto out;
+	ret = __mdiobus_write(priv->bus, priv->mdio_addr,
+			      RTL8366UB_MDIO_DATA_WRITE_REG, val);
+	if (ret < 0)
+		goto out;
+	ret = __mdiobus_write(priv->bus, priv->mdio_addr,
+			      RTL8366UB_MDIO_CTRL1_REG,
+			      RTL8366UB_MDIO_WRITE_OP);
+out:
+	mutex_unlock(&priv->bus->mdio_lock);
+	return ret < 0 ? ret : 0;
+}
diff --git a/drivers/net/dsa/realtek/rtl8366ub_switch.c b/drivers/net/dsa/realtek/rtl8366ub_switch.c
new file mode 100644
index 0000000..bf40d83
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl8366ub_switch.c
@@ -0,0 +1,430 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/bitfield.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+
+#include "rtl8366ub_dsa.h"
+#include "rtl8366ub_reg.h"
+
+#define RTL8366UB_TABLE_CMD_REG          0x39e0
+#define RTL8366UB_TABLE_ADDR_REG         0x39e2
+#define RTL8366UB_TABLE_READ_DATA_REG    0x39e8
+#define RTL8366UB_TABLE_WRITE_DATA_REG   0x39fc
+#define RTL8366UB_TABLE_TYPE_MASK        GENMASK(2, 0)
+#define RTL8366UB_TABLE_WRITE            BIT(3)
+#define RTL8366UB_TABLE_METHOD_MASK      GENMASK(6, 4)
+#define RTL8366UB_TABLE_EXECUTE          BIT(7)
+#define RTL8366UB_TABLE_VLAN             3
+#define RTL8366UB_TABLE_TIMEOUT          100
+
+#define RTL8366UB_VLAN_CTRL_REG          0x3080
+#define RTL8366UB_VLAN_FILTERING         BIT(0)
+#define RTL8366UB_VLAN_INGRESS_REG       0x3082
+#define RTL8366UB_VLAN_EGRESS_MODE_BASE  0x1fbe
+#define RTL8366UB_VLAN_EGRESS_MODE_STRIDE 0x80
+#define RTL8366UB_VLAN_EGRESS_MODE_MASK  GENMASK(1, 0)
+#define RTL8366UB_VLAN_EGRESS_ORIGINAL   0
+#define RTL8366UB_VLAN_EGRESS_KEEP_BASE  0x2ac2
+#define RTL8366UB_VLAN_EGRESS_TRANS_BASE 0x3140
+#define RTL8366UB_VLAN_EGRESS_PORT_MASK  GENMASK(7, 0)
+#define RTL8366UB_VLAN_PVID_BASE         0x3084
+#define RTL8366UB_VLAN_PVID_MASK         GENMASK(11, 0)
+#define RTL8366UB_VLAN_ACCEPT_REG         0x3094
+#define RTL8366UB_VLAN_ACCEPT_MASK        GENMASK(1, 0)
+#define RTL8366UB_VLAN_ACCEPT_ALL         0
+#define RTL8366UB_VLAN_ACCEPT_TAGGED_ONLY 1
+#define RTL8366UB_IGMP_CTRL_REG           0x35a0
+#define RTL8366UB_IGMP_MLD_VLAN_LEAKY     BIT(14)
+#define RTL8366UB_IPMC_VLAN_LEAKY_REG     0x31b4
+#define RTL8366UB_ISOLATION_BASE         0x32d4
+#define RTL8366UB_STP_STATE_REG          0x35e0
+#define RTL8366UB_VALID_PHYSICAL_MASK    0xef
+
+static int rtl8366ub_switch_update_bits(struct rtl8366ub_priv *priv, u16 reg,
+                                        u16 mask, u16 val)
+{
+    u16 data;
+    int ret;
+
+    ret = rtl8366ub_reg_read(priv, reg, &data);
+    if (ret)
+        return ret;
+
+    data = (data & ~mask) | (val & mask);
+    return rtl8366ub_reg_write(priv, reg, data);
+}
+
+static int rtl8366ub_port_to_phys(int port)
+{
+    const struct rtl8366ub_port_info *info = rtl8366ub_get_port_info(port);
+
+    return info ? info->physical_port : -EINVAL;
+}
+
+static int rtl8366ub_portmask_to_phys(u32 portmask, u8 *physical)
+{
+    const struct rtl8366ub_port_info *info;
+    u8 mask = 0;
+    int port;
+
+    for (port = 0; port <= RTL8366UB_MAX_LOGICAL_PORT; port++) {
+        if (!(portmask & BIT(port)))
+            continue;
+        info = rtl8366ub_get_port_info(port);
+        if (!info)
+            return -EINVAL;
+        mask |= BIT(info->physical_port);
+    }
+
+    *physical = mask;
+    return 0;
+}
+
+static u32 rtl8366ub_portmask_from_phys(u8 physical)
+{
+    const struct rtl8366ub_port_info *info;
+    u32 mask = 0;
+    int port;
+
+    for (port = 0; port <= RTL8366UB_MAX_LOGICAL_PORT; port++) {
+        info = rtl8366ub_get_port_info(port);
+        if (info && (physical & BIT(info->physical_port)))
+            mask |= BIT(port);
+    }
+
+    return mask;
+}
+
+static int rtl8366ub_table_wait(struct rtl8366ub_priv *priv)
+{
+    u16 cmd;
+    int ret;
+    int i;
+
+    for (i = 0; i < RTL8366UB_TABLE_TIMEOUT; i++) {
+        ret = rtl8366ub_reg_read(priv, RTL8366UB_TABLE_CMD_REG, &cmd);
+        if (ret)
+            return ret;
+        if (!(cmd & RTL8366UB_TABLE_EXECUTE))
+            return 0;
+    }
+
+    return -ETIMEDOUT;
+}
+
+static int rtl8366ub_table_xfer(struct rtl8366ub_priv *priv, bool write,
+                                u16 addr, u16 *data, int words)
+{
+    u16 cmd;
+    int ret;
+    int i;
+
+    if (addr > 0xfff || words < 1 || words > 10)
+        return -EINVAL;
+
+    mutex_lock(&priv->table_mutex);
+
+    ret = rtl8366ub_table_wait(priv);
+    if (ret)
+        goto out;
+
+    if (write) {
+        for (i = 0; i < words; i++) {
+            ret = rtl8366ub_reg_write(priv,
+                    RTL8366UB_TABLE_WRITE_DATA_REG + i * 2, data[i]);
+            if (ret)
+                goto out;
+        }
+    }
+
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_TABLE_ADDR_REG, addr);
+    if (ret)
+        goto out;
+
+    ret = rtl8366ub_reg_read(priv, RTL8366UB_TABLE_CMD_REG, &cmd);
+    if (ret)
+        goto out;
+    cmd &= ~(RTL8366UB_TABLE_TYPE_MASK | RTL8366UB_TABLE_WRITE |
+             RTL8366UB_TABLE_METHOD_MASK | RTL8366UB_TABLE_EXECUTE);
+    cmd |= RTL8366UB_TABLE_VLAN | RTL8366UB_TABLE_EXECUTE;
+    if (write)
+        cmd |= RTL8366UB_TABLE_WRITE;
+
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_TABLE_CMD_REG, cmd);
+    if (ret)
+        goto out;
+    ret = rtl8366ub_table_wait(priv);
+    if (ret || write)
+        goto out;
+
+    for (i = 0; i < words; i++) {
+        ret = rtl8366ub_reg_read(priv,
+                RTL8366UB_TABLE_READ_DATA_REG + i * 2, &data[i]);
+        if (ret)
+            goto out;
+    }
+
+out:
+    mutex_unlock(&priv->table_mutex);
+    return ret;
+}
+
+int rtl8366ub_vlan_get(struct rtl8366ub_priv *priv, u16 vid,
+                       struct rtl8366ub_vlan *vlan)
+{
+    u16 data[2];
+    int ret;
+
+    if (!vlan || vid > 4095)
+        return -EINVAL;
+
+    ret = rtl8366ub_table_xfer(priv, false, vid, data, ARRAY_SIZE(data));
+    if (ret)
+        return ret;
+
+    vlan->member = data[0] & 0xff;
+    vlan->untag = data[0] >> 8;
+    vlan->fid_msti = data[1] & 0x7;
+    vlan->ivl = !!(data[1] & BIT(4));
+
+    return 0;
+}
+
+int rtl8366ub_vlan_set(struct rtl8366ub_priv *priv, u16 vid,
+                       const struct rtl8366ub_vlan *vlan)
+{
+    u16 data[2];
+
+    if (!vlan || vid > 4095 || vlan->fid_msti > 7 ||
+        (vlan->member & ~RTL8366UB_VALID_PHYSICAL_MASK) ||
+        (vlan->untag & ~vlan->member))
+        return -EINVAL;
+
+    data[0] = vlan->member | vlan->untag << 8;
+    data[1] = vlan->fid_msti | (vlan->ivl ? BIT(4) : 0);
+
+    return rtl8366ub_table_xfer(priv, true, vid, data, ARRAY_SIZE(data));
+}
+
+int rtl8366ub_vlan_set_pvid(struct rtl8366ub_priv *priv, int port, u16 vid)
+{
+    int physical = rtl8366ub_port_to_phys(port);
+
+    if (physical < 0 || vid > 4095)
+        return -EINVAL;
+
+    return rtl8366ub_switch_update_bits(priv,
+            RTL8366UB_VLAN_PVID_BASE + physical * 2,
+            RTL8366UB_VLAN_PVID_MASK, vid);
+}
+
+int rtl8366ub_vlan_get_pvid(struct rtl8366ub_priv *priv, int port, u16 *vid)
+{
+    int physical = rtl8366ub_port_to_phys(port);
+    u16 val;
+    int ret;
+
+    if (physical < 0 || !vid)
+        return -EINVAL;
+
+    ret = rtl8366ub_reg_read(priv,
+            RTL8366UB_VLAN_PVID_BASE + physical * 2, &val);
+    if (ret)
+        return ret;
+
+    *vid = val & RTL8366UB_VLAN_PVID_MASK;
+    return 0;
+}
+
+int rtl8366ub_vlan_set_accept_tagged_only(struct rtl8366ub_priv *priv,
+                                           int port, bool tagged_only)
+{
+    int physical = rtl8366ub_port_to_phys(port);
+    u16 shift;
+    u16 mask;
+    u16 val;
+
+    if (physical < 0)
+        return -EINVAL;
+
+    shift = physical * 2;
+    mask = RTL8366UB_VLAN_ACCEPT_MASK << shift;
+    val = (tagged_only ? RTL8366UB_VLAN_ACCEPT_TAGGED_ONLY :
+                         RTL8366UB_VLAN_ACCEPT_ALL) << shift;
+
+    return rtl8366ub_switch_update_bits(priv, RTL8366UB_VLAN_ACCEPT_REG,
+                                        mask, val);
+}
+
+int rtl8366ub_vlan_set_egress_original(struct rtl8366ub_priv *priv, int port)
+{
+    int physical = rtl8366ub_port_to_phys(port);
+
+    if (physical < 0)
+        return -EINVAL;
+
+    return rtl8366ub_switch_update_bits(priv,
+            RTL8366UB_VLAN_EGRESS_MODE_BASE +
+            physical * RTL8366UB_VLAN_EGRESS_MODE_STRIDE,
+            RTL8366UB_VLAN_EGRESS_MODE_MASK,
+            RTL8366UB_VLAN_EGRESS_ORIGINAL);
+}
+
+int rtl8366ub_vlan_clear_egress_overrides(struct rtl8366ub_priv *priv,
+                                           int port)
+{
+    int physical = rtl8366ub_port_to_phys(port);
+    int ret;
+
+    if (physical < 0)
+        return -EINVAL;
+
+    ret = rtl8366ub_switch_update_bits(priv,
+            RTL8366UB_VLAN_EGRESS_KEEP_BASE + physical * 2,
+            RTL8366UB_VLAN_EGRESS_PORT_MASK, 0);
+    if (ret)
+        return ret;
+
+    return rtl8366ub_switch_update_bits(priv,
+            RTL8366UB_VLAN_EGRESS_TRANS_BASE + physical * 2,
+            RTL8366UB_VLAN_EGRESS_PORT_MASK, 0);
+}
+
+int rtl8366ub_vlan_get_egress_mode(struct rtl8366ub_priv *priv, int port,
+                                    u16 *mode)
+{
+    int physical = rtl8366ub_port_to_phys(port);
+    u16 val;
+    int ret;
+
+    if (physical < 0 || !mode)
+        return -EINVAL;
+
+    ret = rtl8366ub_reg_read(priv,
+            RTL8366UB_VLAN_EGRESS_MODE_BASE +
+            physical * RTL8366UB_VLAN_EGRESS_MODE_STRIDE, &val);
+    if (ret)
+        return ret;
+
+    *mode = val & RTL8366UB_VLAN_EGRESS_MODE_MASK;
+    return 0;
+}
+
+int rtl8366ub_vlan_set_filtering(struct rtl8366ub_priv *priv, bool enabled)
+{
+    int ret;
+
+    ret = rtl8366ub_switch_update_bits(priv, RTL8366UB_VLAN_CTRL_REG,
+                                       RTL8366UB_VLAN_FILTERING,
+                                       enabled ? RTL8366UB_VLAN_FILTERING : 0);
+    if (ret)
+        return ret;
+
+    return rtl8366ub_reg_write(priv, RTL8366UB_VLAN_INGRESS_REG,
+                               enabled ? RTL8366UB_VALID_PHYSICAL_MASK : 0);
+}
+
+static int rtl8366ub_vlan_disable_leaky(struct rtl8366ub_priv *priv)
+{
+    int ret;
+
+    ret = rtl8366ub_switch_update_bits(priv, RTL8366UB_IGMP_CTRL_REG,
+                                       RTL8366UB_IGMP_MLD_VLAN_LEAKY, 0);
+    if (ret)
+        return ret;
+
+    return rtl8366ub_switch_update_bits(priv,
+            RTL8366UB_IPMC_VLAN_LEAKY_REG,
+            RTL8366UB_VALID_PHYSICAL_MASK, 0);
+}
+
+int rtl8366ub_isolation_get(struct rtl8366ub_priv *priv, int port,
+                            u32 *portmask)
+{
+    int physical = rtl8366ub_port_to_phys(port);
+    u16 data;
+    int ret;
+
+    if (physical < 0 || !portmask)
+        return -EINVAL;
+
+    ret = rtl8366ub_reg_read(priv,
+            RTL8366UB_ISOLATION_BASE + physical * 2, &data);
+    if (ret)
+        return ret;
+
+    *portmask = rtl8366ub_portmask_from_phys(data & 0xff);
+    return 0;
+}
+
+int rtl8366ub_isolation_set(struct rtl8366ub_priv *priv, int port,
+                            u32 portmask)
+{
+    int physical = rtl8366ub_port_to_phys(port);
+    u8 mask;
+    int ret;
+
+    if (physical < 0)
+        return -EINVAL;
+    ret = rtl8366ub_portmask_to_phys(portmask, &mask);
+    if (ret)
+        return ret;
+
+    return rtl8366ub_switch_update_bits(priv,
+            RTL8366UB_ISOLATION_BASE + physical * 2, 0xff, mask);
+}
+
+int rtl8366ub_stp_state_set(struct rtl8366ub_priv *priv, int port, u8 state)
+{
+    int physical = rtl8366ub_port_to_phys(port);
+    u16 mask;
+
+    if (physical < 0 || state > 3)
+        return -EINVAL;
+
+    mask = 0x3 << (physical * 2);
+    return rtl8366ub_switch_update_bits(priv, RTL8366UB_STP_STATE_REG,
+                                        mask, state << (physical * 2));
+}
+
+int rtl8366ub_switch_init(struct rtl8366ub_priv *priv)
+{
+    struct rtl8366ub_vlan vlan = {
+        .member = RTL8366UB_VALID_PHYSICAL_MASK,
+        .untag = RTL8366UB_VALID_PHYSICAL_MASK,
+        .ivl = false,
+    };
+    int port;
+    int ret;
+
+    ret = rtl8366ub_vlan_set(priv, 1, &vlan);
+    if (ret)
+        return ret;
+
+    for (port = 0; port <= RTL8366UB_MAX_LOGICAL_PORT; port++) {
+        if (!rtl8366ub_get_port_info(port))
+            continue;
+        ret = rtl8366ub_vlan_set_pvid(priv, port, 1);
+        if (ret)
+            return ret;
+        ret = rtl8366ub_vlan_set_accept_tagged_only(priv, port, false);
+        if (ret)
+            return ret;
+        ret = rtl8366ub_vlan_set_egress_original(priv, port);
+        if (ret)
+            return ret;
+        if (port < RTL8366UB_NUM_PORTS) {
+            priv->ports[port].pvid = 0;
+            priv->ports[port].tag_pvid = 0;
+            priv->ports[port].pvid_configured = false;
+            priv->ports[port].tag_pvid_configured = false;
+        }
+    }
+
+    ret = rtl8366ub_vlan_set_filtering(priv, true);
+    if (ret)
+        return ret;
+
+    return rtl8366ub_vlan_disable_leaky(priv);
+}
diff --git a/drivers/net/dsa/realtek/rtl8366ub_table.c b/drivers/net/dsa/realtek/rtl8366ub_table.c
new file mode 100644
index 0000000..21ef14a
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl8366ub_table.c
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+
+#include "rtl8366ub_dsa.h"
+#include "rtl8366ub_reg.h"
+#include "rtl8366ub_table.h"
+
+#define RTL8366UB_TABLE_CMD_REG             0x39e0
+#define RTL8366UB_TABLE_CMD_TYPE            GENMASK(2, 0)
+#define RTL8366UB_TABLE_CMD_OP              BIT(3)
+#define RTL8366UB_TABLE_CMD_METHOD          GENMASK(6, 4)
+#define RTL8366UB_TABLE_CMD_EXECUTE         BIT(7)
+#define RTL8366UB_TABLE_CMD_PORT            GENMASK(10, 8)
+#define RTL8366UB_TABLE_TYPE_L2             4
+#define RTL8366UB_TABLE_ADDRESS_REG         0x39e2
+#define RTL8366UB_TABLE_L2_STATUS_REG       0x39e4
+#define RTL8366UB_TABLE_L2_STATUS_ADDRESS   GENMASK(10, 0)
+#define RTL8366UB_TABLE_L2_STATUS_TYPE      BIT(11)
+#define RTL8366UB_TABLE_L2_STATUS_HIT       BIT(12)
+#define RTL8366UB_TABLE_READ_BASE           0x39e8
+#define RTL8366UB_TABLE_WRITE_BASE          0x39fc
+#define RTL8366UB_TABLE_POLL_RETRIES        100
+
+static int rtl8366ub_table_wait(struct rtl8366ub_priv *priv)
+{
+    unsigned int retries;
+    u16 cmd;
+    int ret;
+
+    for (retries = 0; retries < RTL8366UB_TABLE_POLL_RETRIES; retries++) {
+        ret = rtl8366ub_reg_read(priv, RTL8366UB_TABLE_CMD_REG, &cmd);
+        if (ret)
+            return ret;
+        if (!(cmd & RTL8366UB_TABLE_CMD_EXECUTE))
+            return 0;
+        usleep_range(10, 20);
+    }
+    return -ETIMEDOUT;
+}
+
+int rtl8366ub_table_l2_query(struct rtl8366ub_priv *priv,
+                             enum rtl8366ub_table_op op, u16 *address,
+                             enum rtl8366ub_l2_method method, u8 port,
+                             u16 data[RTL8366UB_L2_ENTRY_WORDS])
+{
+    u16 cmd, status;
+    int ret, i;
+
+    if (!address || !data || method > RTL8366UB_L2_METHOD_NEXT_FDB_PORT ||
+        method == 5 || method == 6)
+        return -EINVAL;
+
+    mutex_lock(&priv->table_mutex);
+    ret = rtl8366ub_table_wait(priv);
+    if (ret)
+        goto out;
+
+    if (op == RTL8366UB_TABLE_OP_WRITE || method == RTL8366UB_L2_METHOD_MAC) {
+        for (i = 0; i < RTL8366UB_L2_ENTRY_WORDS; i++) {
+            ret = rtl8366ub_reg_write(priv,
+                    RTL8366UB_TABLE_WRITE_BASE + i * 2, data[i]);
+            if (ret)
+                goto out;
+        }
+    }
+
+    if (op == RTL8366UB_TABLE_OP_READ && method != RTL8366UB_L2_METHOD_MAC) {
+        ret = rtl8366ub_reg_write(priv, RTL8366UB_TABLE_ADDRESS_REG,
+                                  *address & 0xfff);
+        if (ret)
+            goto out;
+    }
+
+    cmd = FIELD_PREP(RTL8366UB_TABLE_CMD_TYPE, RTL8366UB_TABLE_TYPE_L2) |
+          FIELD_PREP(RTL8366UB_TABLE_CMD_OP, op) |
+          RTL8366UB_TABLE_CMD_EXECUTE;
+    if (op == RTL8366UB_TABLE_OP_READ) {
+        cmd |= FIELD_PREP(RTL8366UB_TABLE_CMD_METHOD, method);
+        if (method == RTL8366UB_L2_METHOD_NEXT_FDB_PORT)
+            cmd |= FIELD_PREP(RTL8366UB_TABLE_CMD_PORT, port);
+    }
+
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_TABLE_CMD_REG, cmd);
+    if (ret)
+        goto out;
+    ret = rtl8366ub_table_wait(priv);
+    if (ret)
+        goto out;
+    ret = rtl8366ub_reg_read(priv, RTL8366UB_TABLE_L2_STATUS_REG, &status);
+    if (ret)
+        goto out;
+    if (op == RTL8366UB_TABLE_OP_READ &&
+        !(status & RTL8366UB_TABLE_L2_STATUS_HIT)) {
+        ret = -ENOENT;
+        goto out;
+    }
+
+    if (op == RTL8366UB_TABLE_OP_READ) {
+        *address = FIELD_GET(RTL8366UB_TABLE_L2_STATUS_ADDRESS, status);
+        if (status & RTL8366UB_TABLE_L2_STATUS_TYPE)
+            *address |= BIT(11);
+
+        for (i = 0; i < RTL8366UB_L2_ENTRY_WORDS; i++) {
+            ret = rtl8366ub_reg_read(priv,
+                    RTL8366UB_TABLE_READ_BASE + i * 2, &data[i]);
+            if (ret)
+                goto out;
+        }
+    }
+out:
+    mutex_unlock(&priv->table_mutex);
+    return ret;
+}
diff --git a/drivers/net/dsa/realtek/rtl8366ub_dsa.h b/drivers/net/dsa/realtek/rtl8366ub_dsa.h
new file mode 100644
index 0000000..bb7de67
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl8366ub_dsa.h
@@ -0,0 +1,114 @@
+#ifndef __RTL8366_DSA_H__
+#define __RTL8366_DSA_H__
+
+#include <linux/mutex.h>
+#include <linux/phy.h>
+#include <linux/types.h>
+
+#define RTL8366UB_NUM_PORTS          4
+#define RTL8366UB_MAX_LOGICAL_PORT   18
+#define RTL8366UB_EXT_PORT0          16
+#define RTL8366UB_EXT_PORT1          17
+#define RTL8366UB_EXT_PORT2          18
+#ifndef DRIVER_VERSION
+#define DRIVER_VERSION "unknown"
+#endif
+
+struct phylink_link_state;
+
+struct rtl8366ub_port {
+    bool enable;
+    u32 pm;
+    u16 pvid;
+    u16 tag_pvid;
+    bool pvid_configured;
+    bool tag_pvid_configured;
+};
+
+enum rtl8366ub_port_type {
+    RTL8366UB_PORT_UTP,
+    RTL8366UB_PORT_EXT,
+};
+
+struct rtl8366ub_port_info {
+    u8 logical_port;
+    u8 physical_port;
+    enum rtl8366ub_port_type type;
+    bool supports_2p5g;
+    bool supports_hsgmii;
+};
+
+struct rtl8366ub_priv {
+    struct device *dev;
+    struct regmap *map;
+    struct mii_bus *bus;
+    int mdio_addr;
+    int cpu_port;
+    struct dsa_switch *ds;
+    struct gpio_desc *reset;
+    unsigned int id;
+
+    struct mutex reg_mutex;
+    struct mutex phy_mutex;
+    struct mutex table_mutex;
+    struct mutex mib_mutex;
+
+    struct rtl8366ub_port ports[RTL8366UB_NUM_PORTS];
+};
+
+const struct rtl8366ub_port_info *rtl8366ub_get_port_info(int port);
+int rtl8366ub_detect(struct rtl8366ub_priv *priv);
+
+int rtl8366ub_phy_read(struct rtl8366ub_priv *priv, int port, int reg,
+                       u16 *val);
+int rtl8366ub_phy_write(struct rtl8366ub_priv *priv, int port, int reg,
+                        u16 val);
+int rtl8366ub_ocp_read(struct rtl8366ub_priv *priv, int port, u16 addr,
+                       u16 *val);
+int rtl8366ub_ocp_write(struct rtl8366ub_priv *priv, int port, u16 addr,
+                        u16 val);
+int rtl8366ub_port_set_enabled(struct rtl8366ub_priv *priv, int port,
+                               bool enabled);
+int rtl8366ub_port_set_mac(struct rtl8366ub_priv *priv, int port, int speed,
+                           int duplex, bool link, bool tx_pause,
+                           bool rx_pause);
+int rtl8366ub_port_get_mac_pause(struct rtl8366ub_priv *priv, int port,
+                                 bool *tx_pause, bool *rx_pause);
+
+int rtl8366ub_cpu_port_config(struct rtl8366ub_priv *priv, int port,
+                              phy_interface_t interface);
+int rtl8366ub_cpu_tag_enable(struct rtl8366ub_priv *priv, int port);
+int rtl8366ub_cpu_tag_disable(struct rtl8366ub_priv *priv, int port);
+
+struct rtl8366ub_vlan {
+    u8 member;
+    u8 untag;
+    u8 fid_msti;
+    bool ivl;
+};
+
+int rtl8366ub_switch_init(struct rtl8366ub_priv *priv);
+int rtl8366ub_isolation_get(struct rtl8366ub_priv *priv, int port,
+                            u32 *portmask);
+int rtl8366ub_isolation_set(struct rtl8366ub_priv *priv, int port,
+                            u32 portmask);
+int rtl8366ub_stp_state_set(struct rtl8366ub_priv *priv, int port, u8 state);
+int rtl8366ub_vlan_get(struct rtl8366ub_priv *priv, u16 vid,
+                       struct rtl8366ub_vlan *vlan);
+int rtl8366ub_vlan_set(struct rtl8366ub_priv *priv, u16 vid,
+                       const struct rtl8366ub_vlan *vlan);
+int rtl8366ub_vlan_set_pvid(struct rtl8366ub_priv *priv, int port, u16 vid);
+int rtl8366ub_vlan_get_pvid(struct rtl8366ub_priv *priv, int port, u16 *vid);
+int rtl8366ub_vlan_set_accept_tagged_only(struct rtl8366ub_priv *priv,
+                                           int port, bool tagged_only);
+int rtl8366ub_vlan_set_egress_original(struct rtl8366ub_priv *priv, int port);
