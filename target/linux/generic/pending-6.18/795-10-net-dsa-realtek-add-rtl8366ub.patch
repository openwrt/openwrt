+static int rtl8366ub_sw_port_vlan_add(struct dsa_switch *ds, int port,
+                                      const struct switchdev_obj_port_vlan *vlan,
+                                      struct netlink_ext_ack *extack)
+{
+    struct rtl8366ub_priv *priv = ds->priv;
+    const struct rtl8366ub_port_info *info;
+    struct rtl8366ub_vlan entry;
+    struct rtl8366ub_vlan original;
+    bool old_pvid_configured = false;
+    u16 old_pvid = 0;
+    int physical;
+    int ret;
+
+    if (vid_is_dsa_8021q(vlan->vid)) {
+        NL_SET_ERR_MSG_MOD(extack,
+                           "VLAN range 3072-4095 is reserved for DSA tag_8021q");
+        return -EBUSY;
+    }
+
+    info = rtl8366ub_get_port_info(port);
+    if (!info)
+        return -EINVAL;
+    physical = info->physical_port;
+    mutex_lock(&priv->reg_mutex);
+
+    ret = rtl8366ub_vlan_get(priv, vlan->vid, &entry);
+    if (ret)
+        goto out;
+    original = entry;
+    entry.member |= BIT(physical);
+    if (dsa_is_cpu_port(ds, port))
+        entry.untag &= ~BIT(physical);
+    else if (vlan->flags & BRIDGE_VLAN_INFO_UNTAGGED)
+        entry.untag |= BIT(physical);
+    else
+        entry.untag &= ~BIT(physical);
+    entry.ivl = true;
+
+    ret = rtl8366ub_vlan_set(priv, vlan->vid, &entry);
+    if (ret)
+        goto out;
+
+    if (dsa_is_user_port(ds, port)) {
+        old_pvid = priv->ports[port].pvid;
+        old_pvid_configured = priv->ports[port].pvid_configured;
+
+        if (vlan->flags & BRIDGE_VLAN_INFO_PVID) {
+            priv->ports[port].pvid = vlan->vid;
+            priv->ports[port].pvid_configured = true;
+        } else if (priv->ports[port].pvid_configured &&
+                   priv->ports[port].pvid == vlan->vid) {
+            priv->ports[port].pvid = 0;
+            priv->ports[port].pvid_configured = false;
+        }
+
+        if (dsa_port_is_vlan_filtering(dsa_to_port(ds, port)))
+            ret = rtl8366ub_vlan_commit_pvid(priv, port, true);
+        if (ret) {
+            priv->ports[port].pvid = old_pvid;
+            priv->ports[port].pvid_configured =
+                old_pvid_configured;
+            rtl8366ub_vlan_set(priv, vlan->vid, &original);
+        }
+    }
+
+out:
+    mutex_unlock(&priv->reg_mutex);
+    return ret;
+}
+
+static int rtl8366ub_sw_port_vlan_del(struct dsa_switch *ds, int port,
+                                      const struct switchdev_obj_port_vlan *vlan)
+{
+    struct rtl8366ub_priv *priv = ds->priv;
+    const struct rtl8366ub_port_info *info;
+    struct rtl8366ub_vlan entry;
+    struct rtl8366ub_vlan original;
+    bool old_pvid_configured = false;
+    u16 old_pvid = 0;
+    int physical;
+    int ret;
+
+    info = rtl8366ub_get_port_info(port);
+    if (!info)
+        return -EINVAL;
+    physical = info->physical_port;
+    mutex_lock(&priv->reg_mutex);
+
+    ret = rtl8366ub_vlan_get(priv, vlan->vid, &entry);
+    if (ret)
+        goto out;
+    original = entry;
+
+    entry.member &= ~BIT(physical);
+    entry.untag &= ~BIT(physical);
+    ret = rtl8366ub_vlan_set(priv, vlan->vid, &entry);
+    if (ret)
+        goto out;
+
+    if (dsa_is_user_port(ds, port)) {
+        old_pvid = priv->ports[port].pvid;
+        old_pvid_configured = priv->ports[port].pvid_configured;
+
+        if (priv->ports[port].pvid_configured &&
+            priv->ports[port].pvid == vlan->vid) {
+            priv->ports[port].pvid = 0;
+            priv->ports[port].pvid_configured = false;
+        }
+
+        if (dsa_port_is_vlan_filtering(dsa_to_port(ds, port)))
+            ret = rtl8366ub_vlan_commit_pvid(priv, port, true);
+        if (ret) {
+            priv->ports[port].pvid = old_pvid;
+            priv->ports[port].pvid_configured =
+                old_pvid_configured;
+            rtl8366ub_vlan_set(priv, vlan->vid, &original);
+        }
+    }
+
+out:
+    mutex_unlock(&priv->reg_mutex);
+    return ret;
+}
+
+static void rtl8366ub_sw_phylink_get_caps(struct dsa_switch *ds, int port,
+                                           struct phylink_config *config)
+{
+    if (port < RTL8366UB_NUM_PORTS) {
+        __set_bit(PHY_INTERFACE_MODE_INTERNAL,
+                  config->supported_interfaces);
+        __set_bit(PHY_INTERFACE_MODE_GMII,
+                  config->supported_interfaces);
+        config->mac_capabilities = MAC_ASYM_PAUSE | MAC_SYM_PAUSE |
+                                   MAC_10 | MAC_100 | MAC_1000FD |
+                                   MAC_2500FD;
+        return;
+    }
+
+    __set_bit(PHY_INTERFACE_MODE_2500BASEX,
+              config->supported_interfaces);
+    __set_bit(PHY_INTERFACE_MODE_USXGMII,
+              config->supported_interfaces);
+    config->mac_capabilities = MAC_ASYM_PAUSE | MAC_SYM_PAUSE |
+                               MAC_1000FD | MAC_2500FD | MAC_10000FD;
+}
+
+static void rtl8366ub_sw_phylink_mac_config(struct phylink_config *config,
+        unsigned int mode, const struct phylink_link_state *state)
+{
+}
+
+static void rtl8366ub_sw_phylink_mac_link_down(struct phylink_config *config,
+        unsigned int mode, phy_interface_t interface)
+{
+    struct dsa_port *dp = dsa_phylink_to_port(config);
+    struct rtl8366ub_priv *priv = dp->ds->priv;
+    int port = dp->index;
+
+    if (port >= RTL8366UB_NUM_PORTS)
+        return;
+
+    rtl8366ub_port_set_mac(priv, port, SPEED_UNKNOWN, DUPLEX_HALF,
+                           false, false, false);
+}
+
+
+static void rtl8366ub_sw_phylink_mac_link_up(struct phylink_config *config,
+        struct phy_device *phydev, unsigned int mode,
+        phy_interface_t interface, int speed, int duplex,
+        bool tx_pause, bool rx_pause)
+{
+    struct dsa_port *dp = dsa_phylink_to_port(config);
+    struct rtl8366ub_priv *priv = dp->ds->priv;
+    int port = dp->index;
+
+    if (port >= RTL8366UB_NUM_PORTS)
+        return;
+
+    rtl8366ub_port_set_mac(priv, port, speed, duplex, true,
+                           tx_pause, rx_pause);
+}
+
+static const struct phylink_mac_ops rtl8366ub_phylink_mac_ops = {
+    .mac_config = rtl8366ub_sw_phylink_mac_config,
+    .mac_link_down = rtl8366ub_sw_phylink_mac_link_down,
+    .mac_link_up = rtl8366ub_sw_phylink_mac_link_up,
+};
+
+static const struct dsa_switch_ops rtl8366ub_switch_ops = {
+    .get_tag_protocol = rtl8366ub_sw_get_tag_protocol,
+    .setup = rtl8366ub_sw_setup,
+    .teardown = rtl8366ub_sw_teardown,
+    .get_strings = rtl8366ub_sw_get_strings,
