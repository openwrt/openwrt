+static int rtl8366ub_sw_port_fdb_add(struct dsa_switch *ds, int port,
+                                     const unsigned char *addr, u16 vid,
+                                     struct dsa_db db)
+{
+    struct rtl8366ub_priv *priv = ds->priv;
+    int ret;
+
+    if (db.type != DSA_DB_PORT && db.type != DSA_DB_BRIDGE)
+        return -EOPNOTSUPP;
+    vid = rtl8366ub_sw_l2_vid(vid, db);
+
+    mutex_lock(&priv->reg_mutex);
+    ret = rtl8366ub_fdb_add(priv, addr, vid, port, true);
+    mutex_unlock(&priv->reg_mutex);
+    return ret;
+}
+
+static int rtl8366ub_sw_port_fdb_del(struct dsa_switch *ds, int port,
+                                     const unsigned char *addr, u16 vid,
+                                     struct dsa_db db)
+{
+    struct rtl8366ub_priv *priv = ds->priv;
+    int ret;
+
+    if (db.type != DSA_DB_PORT && db.type != DSA_DB_BRIDGE)
+        return -EOPNOTSUPP;
+    if (dsa_fdb_present_in_other_db(ds, port, addr, vid, db))
+        return 0;
+    vid = rtl8366ub_sw_l2_vid(vid, db);
+
+    mutex_lock(&priv->reg_mutex);
+    ret = rtl8366ub_fdb_del(priv, addr, vid);
+    mutex_unlock(&priv->reg_mutex);
+    return ret;
+}
+
+static int rtl8366ub_sw_port_fdb_dump(struct dsa_switch *ds, int port,
+                                      dsa_fdb_dump_cb_t *cb, void *data)
+{
+    struct rtl8366ub_priv *priv = ds->priv;
+    struct rtl8366ub_fdb_entry entry;
+    u16 address = 0;
+    int ret;
+    int i;
+
+    mutex_lock(&priv->reg_mutex);
+    for (i = 0; i < 4096; i++) {
+        ret = rtl8366ub_fdb_next(priv, &address, port, &entry);
+        if (ret == -ENOENT) {
+            ret = 0;
+            break;
+        }
+        if (ret)
+            break;
+        ret = cb(entry.mac, entry.vid, entry.is_static, data);
+        if (ret || address == 0xfff)
+            break;
+        address++;
+    }
+    mutex_unlock(&priv->reg_mutex);
+    return ret;
+}
