+static int rtl8366ub_cpu_mac_config(struct dsa_switch *ds, int port,
+                                    phy_interface_t phy_mode)
+{
+    struct rtl8366ub_priv *priv = ds->priv;
+
+    return rtl8366ub_cpu_port_config(priv, port, phy_mode);
+}
+
+static int rtl8366ub_sw_setup(struct dsa_switch *ds)
+{
+    struct rtl8366ub_priv *priv = ds->priv;
+    u32 portmask = 0;
+    u32 cpu_portmask;
+    phy_interface_t phy_mode;
+    u16 egress_mode;
+    int ret, i;
+
+    /* Reset whole chip through gpio pin or memory-mapped registers for
+     * different type of hardware
+     */
+    gpiod_set_value_cansleep(priv->reset, 1);
+    usleep_range(100000, 150000);
+    gpiod_set_value_cansleep(priv->reset, 0);
+    usleep_range(1000000, 1500000);
+
+    ret = rtl8366ub_detect(priv);
+    if (ret)
+        return ret;
+
+    priv->cpu_port = rtl8366ub_find_cpu_port(ds);
+    if (priv->cpu_port < 0) {
+        dev_err(priv->dev, "no HSGMII-capable CPU port configured\n");
+        return -EINVAL;
+    }
+
+    ret = of_get_phy_mode(dsa_to_port(ds, priv->cpu_port)->dn, &phy_mode);
+    if (ret) {
+        dev_err(priv->dev, "can't get phy-mode for CPU port: %d\n", ret);
+        return ret;
+    }
+
+    ret = rtl8366ub_hw_init(priv);
+    if (ret)
+        return dev_err_probe(priv->dev, ret,
+                             "failed to apply switch initialization patch\n");
+
+    ret = rtl8366ub_l2_setup(priv, priv->cpu_port);
+    if (ret)
+        return dev_err_probe(priv->dev, ret,
+                             "failed to initialize L2 defaults\n");
+
+    ret = rtl8366ub_switch_init(priv);
+    if (ret)
+        return dev_err_probe(priv->dev, ret,
+                             "failed to initialize VLANs\n");
+
+    cpu_portmask = BIT(priv->cpu_port);
+    for (i = 0; i < RTL8366UB_NUM_PORTS; i++) {
+        ret = rtl8366ub_isolation_set(priv, i, cpu_portmask);
+        if (ret)
+            return dev_err_probe(priv->dev, ret,
+                                 "failed to isolate port %d\n", i);
+
+        portmask |= BIT(i);
+    }
+    ret = rtl8366ub_isolation_set(priv, RTL8366UB_EXT_PORT0, portmask);
+    if (ret)
+        return dev_err_probe(priv->dev, ret,
+                             "failed to configure EXT port isolation\n");
+
+    ret = rtl8366ub_isolation_set(priv, priv->cpu_port, portmask);
+    if (ret)
+        return dev_err_probe(priv->dev, ret,
+                             "failed to configure CPU port isolation\n");
+
+    ret = rtl8366ub_cpu_mac_config(ds, priv->cpu_port, phy_mode);
+    if (ret)
+        return ret;
+
+    ret = rtl8366ub_cpu_tag_disable(priv, priv->cpu_port);
+    if (ret)
+        return dev_err_probe(priv->dev, ret,
+                             "failed to disable RTL8_4 CPU tagging\n");
+
+    ret = rtl8366ub_vlan_set_egress_original(priv, priv->cpu_port);
+    if (ret)
+        return dev_err_probe(priv->dev, ret,
+                             "failed to configure CPU VLAN egress mode\n");
+
+    ret = rtl8366ub_vlan_clear_egress_overrides(priv, priv->cpu_port);
+    if (ret)
+        return dev_err_probe(priv->dev, ret,
+                             "failed to clear CPU VLAN egress overrides\n");
+
+    ret = rtl8366ub_vlan_get_egress_mode(priv, priv->cpu_port,
+                                         &egress_mode);
+    if (ret)
+        return dev_err_probe(priv->dev, ret,
+                             "failed to read CPU VLAN egress mode\n");
+    dev_info(priv->dev, "CPU VLAN egress mode: %u\n", egress_mode);
+
+    for (i = 0; i < RTL8366UB_NUM_PORTS; i++) {
+        ret = rtl8366ub_port_set_enabled(priv, i, true);
+        if (ret)
+            return dev_err_probe(priv->dev, ret,
+                                 "failed to enable PHY on port %d\n", i);
+    }
+
+    ds->max_num_bridges = DSA_TAG_8021Q_MAX_NUM_BRIDGES;
+    ds->fdb_isolation = true;
+    rtnl_lock();
+    ret = dsa_tag_8021q_register(ds, htons(ETH_P_8021Q));
+    rtnl_unlock();
+    if (ret)
+        return dev_err_probe(priv->dev, ret,
+                             "failed to configure 802.1Q CPU tagging\n");
+
+    ds->assisted_learning_on_cpu_port = true;
+
+    return 0;
+}
+
+static void rtl8366ub_sw_teardown(struct dsa_switch *ds)
+{
+    rtnl_lock();
+    dsa_tag_8021q_unregister(ds);
+    rtnl_unlock();
+}
