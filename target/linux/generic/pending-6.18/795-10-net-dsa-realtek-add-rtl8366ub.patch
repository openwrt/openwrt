+static void rtl8366ub_sw_port_disable(struct dsa_switch *ds, int port)
+{
+    struct rtl8366ub_priv *priv = ds->priv;
+    if (!dsa_is_user_port(ds, port))
+        return;
+
+    mutex_lock(&priv->reg_mutex);
+
+    /* Clear up all port matrix which could be restored in the next
+     * enablement for the port.
+     */
+    if (!rtl8366ub_port_set_enabled(priv, port, false))
+        priv->ports[port].enable = false;
+
+    mutex_unlock(&priv->reg_mutex);
+}
+
+static void rtl8366ub_sw_stp_state_set(struct dsa_switch *ds, int port, u8 state)
+{
+    struct rtl8366ub_priv *priv = ds->priv;
+    u8 stp_state;
+
+    if (dsa_is_unused_port(ds, port))
+        return;
+
+    switch (state) {
+    case BR_STATE_DISABLED:
+        stp_state = 0;
+        break;
+    case BR_STATE_BLOCKING:
+    case BR_STATE_LISTENING:
+        stp_state = 1;
+        break;
+    case BR_STATE_LEARNING:
+        stp_state = 2;
+        break;
+    case BR_STATE_FORWARDING:
+    default:
+        stp_state = 3;
+        break;
+    }
+
+    mutex_lock(&priv->reg_mutex);
+    rtl8366ub_stp_state_set(priv, port, stp_state);
+    mutex_unlock(&priv->reg_mutex);
+}
+
+static int rtl8366ub_sw_port_bridge_join(struct dsa_switch *ds, int port,
+                                          struct dsa_bridge bridge,
+                                          bool *tx_fwd_offload,
+                                          struct netlink_ext_ack *extack)
+{
+    struct rtl8366ub_priv *priv = ds->priv;
+    u32 original_masks[RTL8366UB_NUM_PORTS];
+    bool restore_port[RTL8366UB_NUM_PORTS] = { false };
+    u32 original_portmask;
+    u32 portmask_tmp;
+    u32 portmask;
+    int ret;
+    int i;
+
+    mutex_lock(&priv->reg_mutex);
+    ret = rtl8366ub_isolation_get(priv, port, &portmask);
+    if (ret)
+        goto out_unlock;
+    original_portmask = portmask;
+
+    for (i = 0; i < RTL8366UB_NUM_PORTS; i++) {
+        if (i == port)
+            continue;
+        if (dsa_port_bridge_dev_get(dsa_to_port(ds, i)) != bridge.dev)
+            continue;
+
+        ret = rtl8366ub_isolation_get(priv, i, &portmask_tmp);
+        if (ret)
+            goto rollback;
+        original_masks[i] = portmask_tmp;
+        restore_port[i] = true;
+        portmask_tmp |= BIT(port);
+        ret = rtl8366ub_isolation_set(priv, i, portmask_tmp);
+        if (ret)
+            goto rollback;
+        portmask |= BIT(i);
+    }
+
+    ret = rtl8366ub_isolation_set(priv, port, portmask);
+    if (ret)
+        goto rollback;
+
+    mutex_unlock(&priv->reg_mutex);
+    ret = dsa_tag_8021q_bridge_join(ds, port, bridge, tx_fwd_offload,
+                                    extack);
+    if (!ret)
+        return 0;
+
+    mutex_lock(&priv->reg_mutex);
+    goto rollback;
+
+rollback:
+    for (i = 0; i < RTL8366UB_NUM_PORTS; i++) {
+        if (restore_port[i])
+            rtl8366ub_isolation_set(priv, i, original_masks[i]);
+    }
+    rtl8366ub_isolation_set(priv, port, original_portmask);
+out_unlock:
+    mutex_unlock(&priv->reg_mutex);
+    return ret;
+}
+
+static void rtl8366ub_sw_port_bridge_leave(struct dsa_switch *ds, int port,
+                                           struct dsa_bridge bridge)
+{
+    struct rtl8366ub_priv *priv = ds->priv;
+    u32 portmask_tmp;
+    u32 portmask;
+    int i;
+
+    dsa_tag_8021q_bridge_leave(ds, port, bridge);
+    mutex_lock(&priv->reg_mutex);
+    if (rtl8366ub_isolation_get(priv, port, &portmask))
+        goto out;
+
+    for (i = 0; i < RTL8366UB_NUM_PORTS; i++) {
+        if (i == port)
+            continue;
+        if (dsa_port_bridge_dev_get(dsa_to_port(ds, i)) != bridge.dev)
+            continue;
+        if (rtl8366ub_isolation_get(priv, i, &portmask_tmp))
+            continue;
+        portmask_tmp &= ~BIT(port);
+        rtl8366ub_isolation_set(priv, i, portmask_tmp);
+        portmask &= ~BIT(i);
+    }
+
+    rtl8366ub_isolation_set(priv, port, portmask);
+out:
+    mutex_unlock(&priv->reg_mutex);
+}
+
+static u16 rtl8366ub_sw_l2_vid(u16 vid, struct dsa_db db)
+{
+    if (vid)
+        return vid;
+
+    switch (db.type) {
+    case DSA_DB_PORT:
+        return dsa_tag_8021q_standalone_vid(db.dp);
+    case DSA_DB_BRIDGE:
+        return dsa_tag_8021q_bridge_vid(db.bridge.num);
+    default:
+        return 0;
+    }
+}
