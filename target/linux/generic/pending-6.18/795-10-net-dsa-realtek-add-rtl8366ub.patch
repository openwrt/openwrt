From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GL.iNet Test Build <support@gl-inet.com>
Date: Fri, 4 Sep 2026 00:00:00 +0800
Subject: [PATCH] net: dsa: realtek: add RTL8366UB driver

Move the native RTL8366UB DSA MDIO driver into the Linux Realtek DSA
family so OpenWrt can build it as part of the kernel instead of as an
out-of-tree package module.

Signed-off-by: GL.iNet Test Build <support@gl-inet.com>
---
diff --git a/drivers/net/dsa/realtek/Kconfig b/drivers/net/dsa/realtek/Kconfig
index d6eb671..85bd3c2 100644
--- a/drivers/net/dsa/realtek/Kconfig
+++ b/drivers/net/dsa/realtek/Kconfig
@@ -43,6 +43,13 @@ config NET_DSA_REALTEK_RTL8366RB
 	help
 	  Select to enable support for Realtek RTL8366RB.
 
+config NET_DSA_REALTEK_RTL8366UB
+	tristate "Realtek RTL8366UB switch driver"
+	depends on NET_DSA_REALTEK_MDIO
+	select NET_DSA_TAG_RTL8366UB_8021Q
+	help
+	  Select to enable support for Realtek RTL8366UB switches.
+
 config NET_DSA_REALTEK_RTL8366RB_LEDS
 	bool
 	depends on (LEDS_CLASS=y || LEDS_CLASS=NET_DSA_REALTEK_RTL8366RB)
diff --git a/drivers/net/dsa/realtek/Makefile b/drivers/net/dsa/realtek/Makefile
index 72bb42e..cebedfa 100644
--- a/drivers/net/dsa/realtek/Makefile
+++ b/drivers/net/dsa/realtek/Makefile
@@ -21,3 +21,16 @@ rtl8365mb-objs := rtl8365mb_main.o \
 		  rtl8365mb_vlan.o \
 		  rtl8365mb_l2.o \
 # end of rtl8365mb-objs
+
+obj-$(CONFIG_NET_DSA_REALTEK_RTL8366UB) += rtl8366ub.o
+rtl8366ub-objs := rtl8366ub_reg.o \
+		rtl8366ub_init.o \
+		rtl8366ub_core.o \
+		rtl8366ub_port.o \
+		rtl8366ub_cpu.o \
+		rtl8366ub_switch.o \
+		rtl8366ub_table.o \
+		rtl8366ub_l2.o \
+		rtl8366ub_mib.o \
+		rtl8366ub_dsa.o \
+		rtl8366ub_phy.o
diff --git a/drivers/net/dsa/realtek/rtl8366ub_core.c b/drivers/net/dsa/realtek/rtl8366ub_core.c
new file mode 100644
index 0000000..2e0813f
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl8366ub_core.c
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/types.h>
+
+#include "rtl8366ub_dsa.h"
+#include "rtl8366ub_reg.h"
+
+#define RTL8366UB_CHIP_ID_REG           0x0004
+#define RTL8366UB_CHIP_NAME_REG         0x0006
+#define RTL8366UB_CHIP_ID               0x8366
+#define RTL8366UB_CHIP_NAME_CHAR1_SHIFT 9
+#define RTL8366UB_CHIP_NAME_CHAR2_SHIFT 4
+#define RTL8366UB_CHIP_NAME_CHAR_MASK   0x1f
+#define RTL8366UB_CHIP_CHAR(c)          ((c) + 1 - 'A')
+
+static const struct rtl8366ub_port_info rtl8366ub_ports[] = {
+    { 0, 0, RTL8366UB_PORT_UTP, true, false },
+    { 1, 1, RTL8366UB_PORT_UTP, true, false },
+    { 2, 2, RTL8366UB_PORT_UTP, false, false },
+    { 3, 3, RTL8366UB_PORT_UTP, false, false },
+    { 16, 6, RTL8366UB_PORT_EXT, false, true },
+    { 17, 7, RTL8366UB_PORT_EXT, false, true },
+    { 18, 5, RTL8366UB_PORT_EXT, false, false },
+};
+
+const struct rtl8366ub_port_info *rtl8366ub_get_port_info(int port)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(rtl8366ub_ports); i++) {
+        if (rtl8366ub_ports[i].logical_port == port)
+            return &rtl8366ub_ports[i];
+    }
+
+    return NULL;
+}
+
+int rtl8366ub_detect(struct rtl8366ub_priv *priv)
+{
+    u16 chip_id;
+    u16 chip_name;
+    u32 char1;
+    u32 char2;
+    int ret;
+
+    ret = rtl8366ub_reg_read(priv, RTL8366UB_CHIP_ID_REG, &chip_id);
+    if (ret)
+        return ret;
+
+    ret = rtl8366ub_reg_read(priv, RTL8366UB_CHIP_NAME_REG, &chip_name);
+    if (ret)
+        return ret;
+
+    char1 = (chip_name >> RTL8366UB_CHIP_NAME_CHAR1_SHIFT) &
+            RTL8366UB_CHIP_NAME_CHAR_MASK;
+    char2 = (chip_name >> RTL8366UB_CHIP_NAME_CHAR2_SHIFT) &
+            RTL8366UB_CHIP_NAME_CHAR_MASK;
+    if (chip_id != RTL8366UB_CHIP_ID ||
+        char1 != RTL8366UB_CHIP_CHAR('U') ||
+        char2 != RTL8366UB_CHIP_CHAR('B')) {
+        dev_err(priv->dev,
+                "unsupported switch id=0x%04x name=0x%04x\n",
+                chip_id, chip_name);
+        return -ENODEV;
+    }
+
+    priv->id = chip_id;
+    dev_info(priv->dev, "found an RTL8366UB switch\n");
+
+    return 0;
+}
diff --git a/drivers/net/dsa/realtek/rtl8366ub_cpu.c b/drivers/net/dsa/realtek/rtl8366ub_cpu.c
new file mode 100644
index 0000000..4261f69
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl8366ub_cpu.c
@@ -0,0 +1,290 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/bitfield.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+
+#include "rtl8366ub_dsa.h"
+#include "rtl8366ub_reg.h"
+
+#define RTL8366UB_CPU_LOGICAL_PORT       17
+#define RTL8366UB_CPU_PHYSICAL_PORT      7
+
+#define RTL8366UB_SDS_MODE_CTRL_REG      0x00b0
+#define RTL8366UB_SDS1_MODE_MASK         GENMASK(12, 8)
+#define RTL8366UB_SDS_MODE_DISABLE       0x1f
+#define RTL8366UB_SDS_MODE_HSGMII        0x12
+#define RTL8366UB_SDS_MISC_2_REG         0x01da
+#define RTL8366UB_SDS_USX_SUBMODE_MASK   GENMASK(11, 7)
+#define RTL8366UB_SDS_INDACS_CMD_REG     0x6600
+#define RTL8366UB_SDS_INDACS_ADDR_REG    0x6602
+#define RTL8366UB_SDS_INDACS_DATA_REG    0x6604
+#define RTL8366UB_SDS_INDACS_BUSY        BIT(8)
+#define RTL8366UB_SDS1_READ_CMD          0x0081
+#define RTL8366UB_SDS1_WRITE_CMD         0x00c1
+#define RTL8366UB_SDS_TIMEOUT            100
+#define RTL8366UB_SDS1_2500BX_NWAY_REG   0x0040
+#define RTL8366UB_SDS1_2500BX_NWAY       BIT(12)
+#define RTL8366UB_SDS1_HSGMII_NWAY_REG   0x0001
+#define RTL8366UB_SDS1_HSGMII_NWAY_MASK  GENMASK(11, 8)
+#define RTL8366UB_SDS1_TGR_NWAY_REG      0x03eb
+#define RTL8366UB_SDS1_TGR_NWAY          BIT(4)
+#define RTL8366UB_SDS1_USXGMII_NWAY_REG  0x00f1
+#define RTL8366UB_SDS1_USXGMII_NWAY_MASK GENMASK(3, 0)
+
+#define RTL8366UB_MAC_FORCE_BASE         0x283c
+#define RTL8366UB_MAC_FORCE_PORT_STRIDE  2
+#define RTL8366UB_MAC_FORCE_VALUE        0x03af
+
+#define RTL8366UB_CPU_TAG_AWARE_REG      0x2642
+#define RTL8366UB_CPU_TAG_CTRL_REG       0x2644
+#define RTL8366UB_CPU_TAG_FORMAT_MASK    (BIT(10) | BIT(9) | BIT(6))
+#define RTL8366UB_CPU_TAG_ROUTE_MASK     GENMASK(5, 0)
+#define RTL8366UB_CPU_TAG_FIELDS_MASK    (RTL8366UB_CPU_TAG_FORMAT_MASK | \
+                                          RTL8366UB_CPU_TAG_ROUTE_MASK)
+#define RTL8366UB_CPU_TAG_ENABLE         BIT(0)
+#define RTL8366UB_CPU_TAG_TRAP_MASK      GENMASK(5, 3)
+
+struct rtl8366ub_sds_patch {
+    u16 addr;
+    u16 val;
+};
+
+static const struct rtl8366ub_sds_patch rtl8366ub_sds1_hsgmii_patch[] = {
+    { 0x0530, 0x1e58 },
+    { 0x0521, 0x8023 },
+};
+
+static int rtl8366ub_cpu_update_bits(struct rtl8366ub_priv *priv, u16 reg,
+                                     u16 mask, u16 val)
+{
+    u16 data;
+    int ret;
+
+    ret = rtl8366ub_reg_read(priv, reg, &data);
+    if (ret)
+        return ret;
+
+    data &= ~mask;
+    data |= val & mask;
+
+    return rtl8366ub_reg_write(priv, reg, data);
+}
+
+static int rtl8366ub_sds1_set_mode(struct rtl8366ub_priv *priv, u16 mode)
+{
+    return rtl8366ub_cpu_update_bits(priv, RTL8366UB_SDS_MODE_CTRL_REG,
+                                     RTL8366UB_SDS1_MODE_MASK,
+                                     FIELD_PREP(RTL8366UB_SDS1_MODE_MASK,
+                                                mode));
+}
+
+static int rtl8366ub_sds_wait(struct rtl8366ub_priv *priv)
+{
+    u16 val;
+    int ret;
+    unsigned int i;
+
+    for (i = 0; i < RTL8366UB_SDS_TIMEOUT; i++) {
+        ret = rtl8366ub_reg_read(priv, RTL8366UB_SDS_INDACS_CMD_REG,
+                                 &val);
+        if (ret)
+            return ret;
+        if (!(val & RTL8366UB_SDS_INDACS_BUSY))
+            return 0;
+    }
+
+    return -ETIMEDOUT;
+}
+
+static int rtl8366ub_sds1_read(struct rtl8366ub_priv *priv, u16 addr,
+                               u16 *val)
+{
+    int ret;
+
+    ret = rtl8366ub_sds_wait(priv);
+    if (ret)
+        return ret;
+
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_SDS_INDACS_ADDR_REG, addr);
+    if (ret)
+        return ret;
+
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_SDS_INDACS_CMD_REG,
+                              RTL8366UB_SDS1_READ_CMD);
+    if (ret)
+        return ret;
+
+    ret = rtl8366ub_sds_wait(priv);
+    if (ret)
+        return ret;
+
+    return rtl8366ub_reg_read(priv, RTL8366UB_SDS_INDACS_DATA_REG, val);
+}
+
+static int rtl8366ub_sds1_write(struct rtl8366ub_priv *priv, u16 addr,
+                                u16 val)
+{
+    int ret;
+
+    ret = rtl8366ub_sds_wait(priv);
+    if (ret)
+        return ret;
+
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_SDS_INDACS_DATA_REG, val);
+    if (ret)
+        return ret;
+
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_SDS_INDACS_ADDR_REG, addr);
+    if (ret)
+        return ret;
+
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_SDS_INDACS_CMD_REG,
+                              RTL8366UB_SDS1_WRITE_CMD);
+    if (ret)
+        return ret;
+
+    return rtl8366ub_sds_wait(priv);
+}
+
+static int rtl8366ub_sds1_update_bits(struct rtl8366ub_priv *priv, u16 addr,
+                                      u16 mask, u16 val)
+{
+    u16 data;
+    int ret;
+
+    ret = rtl8366ub_sds1_read(priv, addr, &data);
+    if (ret)
+        return ret;
+
+    data = (data & ~mask) | (val & mask);
+
+    return rtl8366ub_sds1_write(priv, addr, data);
+}
+
+static int rtl8366ub_sds1_disable_nway(struct rtl8366ub_priv *priv)
+{
+    static const struct {
+        u16 reg;
+        u16 mask;
+    } nway_regs[] = {
+        { RTL8366UB_SDS1_2500BX_NWAY_REG,
+          RTL8366UB_SDS1_2500BX_NWAY },
+        { RTL8366UB_SDS1_HSGMII_NWAY_REG,
+          RTL8366UB_SDS1_HSGMII_NWAY_MASK },
+        { RTL8366UB_SDS1_TGR_NWAY_REG,
+          RTL8366UB_SDS1_TGR_NWAY },
+        { RTL8366UB_SDS1_USXGMII_NWAY_REG,
+          RTL8366UB_SDS1_USXGMII_NWAY_MASK },
+    };
+    int ret;
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(nway_regs); i++) {
+        ret = rtl8366ub_sds1_update_bits(priv, nway_regs[i].reg,
+                                         nway_regs[i].mask, 0);
+        if (ret)
+            return ret;
+    }
+
+    return 0;
+}
+
+int rtl8366ub_cpu_port_config(struct rtl8366ub_priv *priv, int port,
+                              phy_interface_t interface)
+{
+    const struct rtl8366ub_port_info *info;
+    int ret;
+    int i;
+
+    info = rtl8366ub_get_port_info(port);
+    if (!info || port != RTL8366UB_CPU_LOGICAL_PORT ||
+        info->physical_port != RTL8366UB_CPU_PHYSICAL_PORT ||
+        interface != PHY_INTERFACE_MODE_2500BASEX)
+        return -EOPNOTSUPP;
+
+    ret = rtl8366ub_sds1_set_mode(priv, RTL8366UB_SDS_MODE_DISABLE);
+    if (ret)
+        return ret;
+    ret = rtl8366ub_sds1_set_mode(priv, RTL8366UB_SDS_MODE_HSGMII);
+    if (ret)
+        return ret;
+    ret = rtl8366ub_cpu_update_bits(priv, RTL8366UB_SDS_MISC_2_REG,
+                                    RTL8366UB_SDS_USX_SUBMODE_MASK, 0);
+    if (ret)
+        return ret;
+
+    for (i = 0; i < ARRAY_SIZE(rtl8366ub_sds1_hsgmii_patch); i++) {
+        ret = rtl8366ub_sds1_write(priv,
+                                   rtl8366ub_sds1_hsgmii_patch[i].addr,
+                                   rtl8366ub_sds1_hsgmii_patch[i].val);
+        if (ret)
+            return ret;
+    }
+
+    ret = rtl8366ub_sds1_set_mode(priv, RTL8366UB_SDS_MODE_DISABLE);
+    if (ret)
+        return ret;
+    ret = rtl8366ub_sds1_set_mode(priv, RTL8366UB_SDS_MODE_HSGMII);
+    if (ret)
+        return ret;
+    ret = rtl8366ub_cpu_update_bits(priv, RTL8366UB_SDS_MISC_2_REG,
+                                    RTL8366UB_SDS_USX_SUBMODE_MASK, 0);
+    if (ret)
+        return ret;
+
+    ret = rtl8366ub_reg_write(priv,
+            RTL8366UB_MAC_FORCE_BASE +
+            info->physical_port * RTL8366UB_MAC_FORCE_PORT_STRIDE,
+            RTL8366UB_MAC_FORCE_VALUE);
+    if (ret)
+        return ret;
+
+    return rtl8366ub_sds1_disable_nway(priv);
+}
+
+int rtl8366ub_cpu_tag_disable(struct rtl8366ub_priv *priv, int port)
+{
+    const struct rtl8366ub_port_info *info;
+    int ret;
+
+    info = rtl8366ub_get_port_info(port);
+    if (!info || port != RTL8366UB_CPU_LOGICAL_PORT ||
+        info->physical_port != RTL8366UB_CPU_PHYSICAL_PORT)
+        return -EOPNOTSUPP;
+
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_CPU_TAG_AWARE_REG, 0);
+    if (ret)
+        return ret;
+
+    return rtl8366ub_cpu_update_bits(priv, RTL8366UB_CPU_TAG_CTRL_REG,
+                                     RTL8366UB_CPU_TAG_ENABLE, 0);
+}
+
+int rtl8366ub_cpu_tag_enable(struct rtl8366ub_priv *priv, int port)
+{
+    const struct rtl8366ub_port_info *info;
+    u16 ctrl;
+    int ret;
+
+    info = rtl8366ub_get_port_info(port);
+    if (!info || port != RTL8366UB_CPU_LOGICAL_PORT ||
+        info->physical_port != RTL8366UB_CPU_PHYSICAL_PORT)
+        return -EOPNOTSUPP;
+
+    ret = rtl8366ub_reg_write(priv, RTL8366UB_CPU_TAG_AWARE_REG,
+                              BIT(info->physical_port));
+    if (ret)
+        return ret;
+
+    ret = rtl8366ub_reg_read(priv, RTL8366UB_CPU_TAG_CTRL_REG, &ctrl);
+    if (ret)
+        return ret;
+
+    ctrl &= ~RTL8366UB_CPU_TAG_FIELDS_MASK;
+    ctrl |= RTL8366UB_CPU_TAG_ENABLE;
+    ctrl |= FIELD_PREP(RTL8366UB_CPU_TAG_TRAP_MASK,
+                       info->physical_port & 7);
+
+    return rtl8366ub_reg_write(priv, RTL8366UB_CPU_TAG_CTRL_REG, ctrl);
+}
diff --git a/drivers/net/dsa/realtek/rtl8366ub_dsa.c b/drivers/net/dsa/realtek/rtl8366ub_dsa.c
new file mode 100644
index 0000000..c4752f2
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl8366ub_dsa.c
@@ -0,0 +1,993 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * This is a sparsely documented chip, the only viable documentation seems
+ * to be a patched up code drop from the vendor that appear in various
+ * GPL source trees.
+ *
+ * Copyright (C) 2024 Jianhui Zhao <jianhui.zhao@gl-inet.com>
+ */
+
+#include <linux/if_bridge.h>
+#include <linux/dsa/8021q.h>
+#include <linux/etherdevice.h>
+#include <linux/of_net.h>
+#include <linux/bitops.h>
+#include <net/dsa.h>
+#include <linux/gpio/consumer.h>
+
+#include "rtl8366ub_dsa.h"
+#include "rtl8366ub_init.h"
+#include "rtl8366ub_l2.h"
+#include "rtl8366ub_mib.h"
+
+struct rtl8366ub_dbg {
+    const char *name;
+    struct file_operations ops;
+};
+
+static int rtl8366ub_find_cpu_port(struct dsa_switch *ds)
+{
+    const struct rtl8366ub_port_info *info;
+    int port;
+
+    for (port = 0; port <= RTL8366UB_MAX_LOGICAL_PORT; port++) {
+        info = rtl8366ub_get_port_info(port);
+        if (info && info->supports_hsgmii && dsa_is_cpu_port(ds, port))
+            return port;
+    }
+
+    return -EINVAL;
+}
+
+static enum dsa_tag_protocol rtl8366ub_sw_get_tag_protocol(struct dsa_switch *ds, int port, enum dsa_tag_protocol mp)
+{
+    const struct rtl8366ub_port_info *info;
+    struct rtl8366ub_priv *priv = ds->priv;
+
+    info = rtl8366ub_get_port_info(port);
+    if (!info || !info->supports_hsgmii) {
+        dev_warn(priv->dev, "port not matched with tagging CPU port\n");
+        return DSA_TAG_PROTO_NONE;
+    }
+
+    return DSA_TAG_PROTO_RTL8366UB_8021Q;
+}
+
+static int rtl8366ub_vlan_commit_pvid(struct rtl8366ub_priv *priv, int port,
+                                      bool vlan_filtering)
+{
+    struct rtl8366ub_port *p = &priv->ports[port];
+    bool configured;
+    u16 verify;
+    u16 vid;
+    int ret;
+
+    if (vlan_filtering) {
+        configured = p->pvid_configured;
+        vid = p->pvid;
+    } else {
+        configured = p->tag_pvid_configured;
+        vid = p->tag_pvid;
+    }
+
+    if (!configured) {
+        /* Fail closed for a VLAN-aware trunk without a PVID. */
+        ret = rtl8366ub_vlan_set_accept_tagged_only(priv, port, true);
+        if (ret)
+            return ret;
+
+        return rtl8366ub_vlan_set_pvid(priv, port, 0);
+    }
+
+    ret = rtl8366ub_vlan_set_pvid(priv, port, vid);
+    if (ret)
+        return ret;
+
+    ret = rtl8366ub_vlan_get_pvid(priv, port, &verify);
+    if (ret)
+        return ret;
+    if (verify != vid)
+        return -EIO;
+
+    return rtl8366ub_vlan_set_accept_tagged_only(priv, port, false);
+}
+
+static int rtl8366ub_tag_8021q_vlan_add(struct dsa_switch *ds, int port,
+                                        u16 vid, u16 flags)
+{
+    struct rtl8366ub_priv *priv = ds->priv;
+    const struct rtl8366ub_port_info *info;
+    struct rtl8366ub_vlan vlan;
+    struct rtl8366ub_vlan original;
+    bool old_tag_pvid_configured = false;
+    u16 old_tag_pvid = 0;
+    u8 bit;
+    int ret;
+
+    info = rtl8366ub_get_port_info(port);
+    if (!info)
+        return -EINVAL;
+    bit = BIT(info->physical_port);
+
+    mutex_lock(&priv->reg_mutex);
+    ret = rtl8366ub_vlan_get(priv, vid, &vlan);
+    if (ret)
+        goto out;
+    original = vlan;
+
+    vlan.member |= bit;
+    vlan.ivl = true;
+    if (flags & BRIDGE_VLAN_INFO_UNTAGGED)
+        vlan.untag |= bit;
+    else
+        vlan.untag &= ~bit;
+
+    ret = rtl8366ub_vlan_set(priv, vid, &vlan);
+    if (!ret) {
+        struct rtl8366ub_vlan verify;
+
+        ret = rtl8366ub_vlan_get(priv, vid, &verify);
+        if (!ret && verify.member != vlan.member)
+            ret = -EIO;
+        if (!ret && verify.untag != vlan.untag)
+            ret = -EIO;
+    }
+    if (!ret && dsa_is_user_port(ds, port) &&
+        (flags & BRIDGE_VLAN_INFO_PVID)) {
+        old_tag_pvid = priv->ports[port].tag_pvid;
+        old_tag_pvid_configured =
+            priv->ports[port].tag_pvid_configured;
+        priv->ports[port].tag_pvid = vid;
+        priv->ports[port].tag_pvid_configured = true;
+
+        if (!dsa_port_is_vlan_filtering(dsa_to_port(ds, port)))
+            ret = rtl8366ub_vlan_commit_pvid(priv, port, false);
+        if (ret) {
+            priv->ports[port].tag_pvid = old_tag_pvid;
+            priv->ports[port].tag_pvid_configured =
+                old_tag_pvid_configured;
+            rtl8366ub_vlan_set(priv, vid, &original);
+        }
+    }
+out:
+    mutex_unlock(&priv->reg_mutex);
+    return ret;
+}
+
+static int rtl8366ub_tag_8021q_vlan_del(struct dsa_switch *ds, int port,
+                                        u16 vid)
+{
+    struct rtl8366ub_priv *priv = ds->priv;
+    const struct rtl8366ub_port_info *info;
+    struct rtl8366ub_vlan vlan;
+    struct rtl8366ub_vlan original;
+    bool old_tag_pvid_configured = false;
+    u16 old_tag_pvid = 0;
+    u8 bit;
+    int ret;
+
+    info = rtl8366ub_get_port_info(port);
+    if (!info)
+        return -EINVAL;
+    bit = BIT(info->physical_port);
+
+    mutex_lock(&priv->reg_mutex);
+    ret = rtl8366ub_vlan_get(priv, vid, &vlan);
+    if (ret)
+        goto out;
+    original = vlan;
+
+    vlan.member &= ~bit;
+    vlan.untag &= ~bit;
+    ret = rtl8366ub_vlan_set(priv, vid, &vlan);
+    if (!ret && dsa_is_user_port(ds, port) &&
+        priv->ports[port].tag_pvid_configured &&
+        priv->ports[port].tag_pvid == vid) {
+        old_tag_pvid = priv->ports[port].tag_pvid;
+        old_tag_pvid_configured =
+            priv->ports[port].tag_pvid_configured;
+        priv->ports[port].tag_pvid = 0;
+        priv->ports[port].tag_pvid_configured = false;
+
+        if (!dsa_port_is_vlan_filtering(dsa_to_port(ds, port)))
+            ret = rtl8366ub_vlan_commit_pvid(priv, port, false);
+        if (ret) {
+            priv->ports[port].tag_pvid = old_tag_pvid;
+            priv->ports[port].tag_pvid_configured =
+                old_tag_pvid_configured;
+            rtl8366ub_vlan_set(priv, vid, &original);
+        }
+    }
+out:
+    mutex_unlock(&priv->reg_mutex);
+    return ret;
+}
