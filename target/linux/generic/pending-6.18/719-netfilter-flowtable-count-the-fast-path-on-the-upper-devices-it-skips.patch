From: Julius Bairaktaris <julius@bairaktaris.de>
Date: Sat, 12 Sep 2026 22:40:00 +0200
Subject: [PATCH] netfilter: flowtable: count the fast path on the interfaces it skips

The fast path receives a flow on the device under a bridge, VLAN, PPP
or tunnel interface and transmits on the device under them with the
encapsulation pushed by itself, so the statistics of the interfaces
above stop moving for every offloaded flow: a router with the
flowtable on its switch ports shows megabytes on br-lan for gigabytes
on wan.

Record the interfaces above the ingress device from the forward path
and update their counters from the fast path: on receive with the
packet as the interface would have delivered it, on transmit with the
frame handed to the device it is sent on. The bridge, ppp and the
tunnels keep their statistics in the per-cpu tstats, a VLAN interface
in its own per-cpu block.

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
Assisted-by: Claude:claude-fable-5-1
--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -106,6 +106,8 @@ enum flow_offload_xmit_type {
 };
 
 #define NF_FLOW_TABLE_ENCAP_MAX		2
+/* The forward path less the device the flow enters on. */
+#define NF_FLOW_TABLE_UPPER_MAX		(NET_DEVICE_PATH_STACK_MAX - 1)
 
 struct flow_offload_tuple {
 	union {
@@ -136,8 +138,10 @@ struct flow_offload_tuple {
 	u8				dir:2,
 					xmit_type:3,
 					encap_num:2,
-					in_vlan_ingress:2;
+					in_vlan_ingress:2,
+					num_uppers:3;
 	u16				mtu;
+	u32				upper_ifidx[NF_FLOW_TABLE_UPPER_MAX];
 	union {
 		struct {
 			struct dst_entry *dst_cache;
@@ -210,6 +214,8 @@ struct nf_flow_route {
 			} encap[NF_FLOW_TABLE_ENCAP_MAX];
 			u8			num_encaps:2,
 						ingress_vlans:2;
+			u32			upper_ifidx[NF_FLOW_TABLE_UPPER_MAX];
+			u8			num_uppers;
 		} in;
 		struct {
 			u32			ifindex;
--- a/net/netfilter/nf_flow_table_core.c
