--- a/net/netfilter/nf_flow_table_ip.c
+++ b/net/netfilter/nf_flow_table_ip.c
@@ -8,6 +8,7 @@
 #include <linux/ipv6.h>
 #include <linux/netdevice.h>
 #include <linux/if_ether.h>
+#include <linux/if_vlan.h>
 #include <net/gso.h>
 #include <net/ip.h>
 #include <net/ipv6.h>
@@ -333,11 +334,51 @@ static void nf_flow_encap_pop(struct sk_
 	}
 }
 
+/* The fast path takes a packet off the device under a bridge, VLAN or PPP
+ * interface and puts it back on the path below them, so those interfaces
+ * never see it. Their counters get it anyway: on the way in as the packet
+ * the interface would have delivered, on the way out as the frame it would
+ * have sent. A transmit re-enters the path at the device it sends on, and
+ * from there down the devices count for themselves.
+ */
+static void nf_flow_upper_stats_add(struct net *net,
+				    const struct flow_offload_tuple *tuple,
+				    u32 xmit_ifidx, unsigned int len)
+{
+	bool rx = !xmit_ifidx;
+	struct net_device *dev;
+	int i;
+
+	for (i = 0; i < tuple->num_uppers &&
+		    tuple->upper_ifidx[i] != xmit_ifidx; i++) {
+		dev = dev_get_by_index_rcu(net, tuple->upper_ifidx[i]);
+		if (!dev)
+			continue;
+
+		if (is_vlan_dev(dev)) {
+			struct vlan_pcpu_stats *s;
+
+			s = this_cpu_ptr(vlan_dev_priv(dev)->vlan_pcpu_stats);
+			u64_stats_update_begin(&s->syncp);
+			u64_stats_inc(rx ? &s->rx_packets : &s->tx_packets);
+			u64_stats_add(rx ? &s->rx_bytes : &s->tx_bytes, len);
+			u64_stats_update_end(&s->syncp);
+		} else if (dev->pcpu_stat_type == NETDEV_PCPU_STAT_TSTATS) {
+			if (rx)
+				dev_sw_netstats_rx_add(dev, len);
+			else
+				dev_sw_netstats_tx_add(dev, 1, len);
+		}
+	}
+}
+
 static unsigned int nf_flow_queue_xmit(struct net *net, struct sk_buff *skb,
 				       const struct flow_offload_tuple_rhash *tuplehash,
 				       unsigned short type)
 {
+	enum flow_offload_tuple_dir dir = tuplehash->tuple.dir;
 	struct net_device *outdev;
+	struct flow_offload *flow;
 
 	outdev = dev_get_by_index_rcu(net, tuplehash->tuple.out.ifidx);
 	if (!outdev)
@@ -346,6 +387,9 @@ static unsigned int nf_flow_queue_xmit(s
 	skb->dev = outdev;
 	dev_hard_header(skb, skb->dev, type, tuplehash->tuple.out.h_dest,
 			tuplehash->tuple.out.h_source, skb->len);
+	flow = container_of(tuplehash, struct flow_offload, tuplehash[dir]);
+	nf_flow_upper_stats_add(net, &flow->tuplehash[!dir].tuple,
+				tuplehash->tuple.out.ifidx, skb->len);
 	dev_queue_xmit(skb);
 
 	return NF_STOLEN;
@@ -437,6 +481,9 @@ static int nf_flow_offload_forward(struc
 	if (flow_table->flags & NF_FLOWTABLE_COUNTER)
 		nf_ct_acct_update(flow->ct, tuplehash->tuple.dir, skb->len);
 
+	nf_flow_upper_stats_add(dev_net(ctx->in), &tuplehash->tuple, 0,
+				skb->len);
+
 	return 1;
 }
 
@@ -721,6 +768,9 @@ static int nf_flow_offload_ipv6_forward(
 	if (flow_table->flags & NF_FLOWTABLE_COUNTER)
 		nf_ct_acct_update(flow->ct, tuplehash->tuple.dir, skb->len);
 
+	nf_flow_upper_stats_add(dev_net(ctx->in), &tuplehash->tuple, 0,
+				skb->len);
+
 	return 1;
 }
 
