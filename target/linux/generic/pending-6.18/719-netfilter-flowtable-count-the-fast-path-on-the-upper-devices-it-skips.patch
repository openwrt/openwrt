 };
 
 #define NF_FLOW_TABLE_ENCAP_MAX		2
+/* The forward path less the device the flow enters on. */
+#define NF_FLOW_TABLE_UPPER_MAX		(NET_DEVICE_PATH_STACK_MAX - 1)
 
 struct flow_offload_tuple {
 	union {
@@ -137,7 +139,9 @@ struct flow_offload_tuple {
 					xmit_type:3,
 					encap_num:2,
 					in_vlan_ingress:2;
+	u8				num_uppers;
 	u16				mtu;
+	u32				upper_ifidx[NF_FLOW_TABLE_UPPER_MAX];
 	union {
 		struct {
 			struct dst_entry *dst_cache;
@@ -209,6 +213,8 @@ struct nf_flow_route {
 			} encap[NF_FLOW_TABLE_ENCAP_MAX];
 			u8			num_encaps:2,
 						ingress_vlans:2;
+			u32			upper_ifidx[NF_FLOW_TABLE_UPPER_MAX];
+			u8			num_uppers;
 		} in;
 		struct {
 			u32			ifindex;
--- a/net/netfilter/nf_flow_table_core.c
