From 9a684868076c31a1afc3da1f3ea84c9ecc855629 Mon Sep 17 00:00:00 2001
From: Andrew Sim <andrewsimz@gmail.com>
Date: Wed, 18 Nov 2026 19:00:00 +0100
Subject: [PATCH] net: dsa: realtek: rtl8365mb: learn in SVL in a VLAN-unaware
 bridge

The driver always enables Independent VLAN Learning (IVL), so the switch
keys its L2 table by MAC address, VID and EFID. In a VLAN-unaware bridge,
DSA programs FDB and MDB entries with VID 0, but the switch learns
addresses in the port's PVID (VID 1 by default). A static entry from DSA
therefore never replaces the entry the switch learned for the same
address, and lookups only hit the learned one.

This breaks roaming. When a Wi-Fi client moves from an AP wired behind a
user port onto this device's Wi-Fi, DSA adds its address towards the CPU
port, but the switch keeps forwarding to the old port until the learned
entry ages out. The client's frames enter from the CPU port, which does
not learn, so nothing corrects it. On an RTL8367S this meant no DHCP
lease and no traffic for about 100 seconds after each roam.

Use Shared VLAN Learning (SVL, FID 0) while no user port is
VLAN-filtering, and program VID 0 entries with the SVL key, so that DSA's
entries and learned entries share a key. Use IVL again while any user
port is VLAN-filtering, since DSA then programs real VIDs. When that
switch-wide state changes, update IVL_EN of the VLAN 4K entries in use,
which a bitmap tracks so that the whole table is not read over the
management bus. Entries read back in SVL are reported with VID 0.

"net: dsa: realtek: rtl8365mb: set and get vlan 4k for family D" makes
the same change for family D.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Andrew Sim <andrewsimz@gmail.com>
---
 drivers/net/dsa/realtek/realtek.h        |  7 +++
 drivers/net/dsa/realtek/rtl8365mb_l2.c   | 22 +++++--
 drivers/net/dsa/realtek/rtl8365mb_main.c | 11 ++++
 drivers/net/dsa/realtek/rtl8365mb_vlan.c | 79 +++++++++++++++++++++++-
 drivers/net/dsa/realtek/rtl8365mb_vlan.h |  2 +
 5 files changed, 115 insertions(+), 6 deletions(-)

--- a/drivers/net/dsa/realtek/realtek.h
+++ b/drivers/net/dsa/realtek/realtek.h
@@ -8,6 +8,8 @@
 #ifndef _REALTEK_H
 #define _REALTEK_H
 
+#include <linux/bitmap.h>
+#include <linux/if_vlan.h>
 #include <linux/phy.h>
 #include <linux/platform_device.h>
 #include <linux/gpio/consumer.h>
@@ -65,6 +67,11 @@ struct realtek_priv {
 	 * deleting port VLAN memberships and PVID configurations.
 	 */
 	struct mutex		vlan_lock;
+	/* VIDs with a non-empty 4K VLAN entry, protected by vlan_lock. Lets
+	 * a switch-wide update visit only the entries in use instead of
+	 * reading all 4094 over the slow management bus.
+	 */
+	DECLARE_BITMAP(vlan_4k_used, VLAN_N_VID);
 	/* l2_lock is used to prevent concurrent modifications of L2 table
 	 * entries while another function is reading it. l2_(add,del)_mc
 	 * is an example that first read current table entry and then
--- a/drivers/net/dsa/realtek/rtl8365mb_l2.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_l2.c
@@ -163,6 +163,7 @@ static void rtl8365mb_l2_data_to_uc(cons
 
 static void rtl8365mb_l2_uc_to_data(const struct rtl8365mb_l2_uc *uc, u16 *data)
 {
+	bool ivl;
 	u32 val;
 
 	memset(data, 0, RTL8365MB_L2_ENTRY_SIZE * 2);
@@ -178,8 +179,15 @@ static void rtl8365mb_l2_uc_to_data(cons
 		FIELD_PREP(RTL8365MB_L2_UC_D2_MAC1_MSK, uc->key.mac_addr[1]);
 	data[2] |=
 		FIELD_PREP(RTL8365MB_L2_UC_D2_MAC0_MSK, uc->key.mac_addr[0]);
-	data[3] |= FIELD_PREP(RTL8365MB_L2_UC_D3_VID_MSK, uc->key.vid);
-	data[3] |= FIELD_PREP(RTL8365MB_L2_UC_D3_IVL_MSK, uc->key.ivl);
+	/* VID 0 is a VLAN-unaware bridge or a standalone port, whose traffic
+	 * the switch learns in SVL (IVL=0, FID=0), see
+	 * rtl8365mb_vlan_want_ivl(). Use the same key here, otherwise a static
+	 * entry would not replace the learned one. A non-zero VID selects IVL.
+	 */
+	ivl = uc->key.ivl && uc->key.vid;
+	data[3] |= FIELD_PREP(RTL8365MB_L2_UC_D3_VID_MSK,
+			      ivl ? uc->key.vid : 0);
+	data[3] |= FIELD_PREP(RTL8365MB_L2_UC_D3_IVL_MSK, ivl);
 
 	val = FIELD_GET(RTL8365MB_L2_UC_PORT_HI_MSK, uc->port);
 	data[3] |= FIELD_PREP(RTL8365MB_L2_UC_D3_PORT_EXT_MSK, val);
@@ -230,6 +238,7 @@ static void rtl8365mb_l2_data_to_mc(cons
 
 static void rtl8365mb_l2_mc_to_data(const struct rtl8365mb_l2_mc *mc, u16 *data)
 {
+	bool ivl;
 	u32 val;
 
 	memset(data, 0, RTL8365MB_L2_ENTRY_SIZE * 2);
@@ -239,8 +248,10 @@ static void rtl8365mb_l2_mc_to_data(cons
 	data[1] |= FIELD_PREP(RTL8365MB_L2_MC_D1_MAC2_MSK, mc->key.mac_addr[2]);
 	data[2] |= FIELD_PREP(RTL8365MB_L2_MC_D2_MAC1_MSK, mc->key.mac_addr[1]);
 	data[2] |= FIELD_PREP(RTL8365MB_L2_MC_D2_MAC0_MSK, mc->key.mac_addr[0]);
-	data[3] |= FIELD_PREP(RTL8365MB_L2_MC_D3_VID_MSK, mc->key.vid);
-	data[3] |= FIELD_PREP(RTL8365MB_L2_MC_D3_IVL_MSK, mc->key.ivl);
+	/* Same as for unicast: VID 0 means SVL, and FID 0 then */
+	ivl = mc->key.ivl && mc->key.vid;
+	data[3] |= FIELD_PREP(RTL8365MB_L2_MC_D3_VID_MSK, ivl ? mc->key.vid : 0);
+	data[3] |= FIELD_PREP(RTL8365MB_L2_MC_D3_IVL_MSK, ivl);
 
 	val = FIELD_GET(RTL8365MB_L2_MC_MBR_HI1_MSK, mc->member);
 	data[3] |= FIELD_PREP(RTL8365MB_L2_MC_D3_MBR_HI1_MSK, val);
@@ -296,7 +307,8 @@ int rtl8365mb_l2_get_next_uc(struct real
 	rtl8365mb_l2_data_to_uc(data, &uc);
 
 	ether_addr_copy(entry->mac_addr, uc.key.mac_addr);
-	entry->vid = uc.key.vid;
+	/* an SVL entry belongs to a VLAN-unaware bridge or a standalone port */
+	entry->vid = uc.key.ivl ? uc.key.vid : 0;
 	entry->is_static = uc.is_static;
 
 	return 0;
--- a/drivers/net/dsa/realtek/rtl8365mb_main.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_main.c
@@ -2004,8 +2004,19 @@ static int rtl8365mb_port_vlan_filtering
 	if (ret)
 		goto undo_set_framefilter;
 
+	mutex_lock(&priv->vlan_lock);
+	ret = rtl8365mb_vlan_4k_refresh_ivl(ds, port, vlan_filtering);
+	mutex_unlock(&priv->vlan_lock);
+	if (ret)
+		goto undo_egress_mode;
+
 	return ret;
 
+undo_egress_mode:
+	/* The previous state was the opposite of the new one, see below */
+	(void)rtl8365mb_port_set_vlan_egress_mode(priv, port,
+		vlan_filtering ? RTL8365MB_VLAN_EGRESS_MODE_REAL_KEEP :
+				 RTL8365MB_VLAN_EGRESS_MODE_ORIGINAL);
 undo_set_framefilter:
 	if (prev_accepted_frame != accepted_frame)
 		rtl8365mb_vlan_port_set_framefilter(priv, port,
--- a/drivers/net/dsa/realtek/rtl8365mb_vlan.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_vlan.c
@@ -49,6 +49,7 @@
 #include "rtl8365mb_vlan.h"
 #include "rtl8365mb_table.h"
 #include <linux/if_bridge.h>
+#include <linux/if_vlan.h>
 #include <linux/lockdep.h>
 #include <linux/regmap.h>
 
@@ -276,6 +277,77 @@ static int rtl8365mb_vlan_4k_write(struc
 				     data, ARRAY_SIZE(data));
 }
 
+/* A VLAN-unaware bridge has DSA program FDB and MDB entries with VID 0, while
+ * the switch learns an address in the VLAN that it classifies the frame to.
+ * With Independent VLAN Learning (IVL) these are two different keys: a static
+ * entry for an address does not replace the entry learned for it, and the
+ * switch keeps forwarding to the port it learned the address on after the
+ * address moved behind the CPU port. Learn in SVL (IVL=0, FID=0) while no user
+ * port is VLAN-filtering, so that static and learned entries use the same key,
+ * and use IVL only while at least one is. @port/@filtering override the state
+ * of the port being changed, as DSA updates dp->vlan_filtering only after the
+ * driver callback returns.
+ */
+static bool rtl8365mb_vlan_want_ivl(struct dsa_switch *ds, int port,
+				    bool filtering)
+{
+	struct dsa_port *dp;
+
+	dsa_switch_for_each_user_port(dp, ds) {
+		if (dp->index == port ? filtering :
+					dsa_port_is_vlan_filtering(dp))
+			return true;
+	}
+
+	return false;
+}
+
+/*
+ * rtl8365mb_vlan_4k_refresh_ivl() - Follow a VLAN filtering change in IVL_EN
+ * @ds: dsa switch instance
+ * @port: port whose VLAN filtering state changes
+ * @filtering: new VLAN filtering state of @port
+ *
+ * Updates IVL_EN of the VLAN 4K entries in use when the change of @port flips
+ * the switch-wide choice between IVL and SVL, see rtl8365mb_vlan_want_ivl().
+ *
+ * Context: Can sleep. Must be called with &priv->vlan_lock held.
+ * Return: 0 on success, or a negative error code on failure.
+ */
+int rtl8365mb_vlan_4k_refresh_ivl(struct dsa_switch *ds, int port,
+				  bool filtering)
+{
+	struct realtek_priv *priv = ds->priv;
+	struct rtl8365mb_vlan4k vlan4k;
+	bool want_ivl;
+	u16 vid;
+	int ret;
+
+	lockdep_assert_held(&priv->vlan_lock);
+
+	want_ivl = rtl8365mb_vlan_want_ivl(ds, port, filtering);
+	/* The scan below reads every entry in use, so do it only if this
+	 * change flips the switch-wide state, not for each port of a bridge.
+	 */
+	if (want_ivl == rtl8365mb_vlan_want_ivl(ds, -1, false))
+		return 0;
+
+	for_each_set_bit(vid, priv->vlan_4k_used, VLAN_N_VID) {
+		ret = rtl8365mb_vlan_4k_read(priv, vid, &vlan4k);
+		if (ret)
+			return ret;
+		if (!vlan4k.member || vlan4k.ivl_en == want_ivl)
+			continue;
+
+		vlan4k.ivl_en = want_ivl;
+		ret = rtl8365mb_vlan_4k_write(priv, &vlan4k);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
 static int
 rtl8365mb_vlan_4k_port_set(struct dsa_switch *ds, int port,
 			   const struct switchdev_obj_port_vlan *vlan,
@@ -311,7 +383,7 @@ rtl8365mb_vlan_4k_port_set(struct dsa_sw
 		vlan4k.untag |= BIT(port);
 	else
 		vlan4k.untag &= ~BIT(port);
-	vlan4k.ivl_en = true; /* always use Independent VLAN Learning */
+	vlan4k.ivl_en = rtl8365mb_vlan_want_ivl(ds, -1, false);
 
 	ret = rtl8365mb_vlan_4k_write(priv, &vlan4k);
 	if (ret) {
@@ -319,6 +391,11 @@ rtl8365mb_vlan_4k_port_set(struct dsa_sw
 		return ret;
 	}
 
+	if (vlan4k.member)
+		set_bit(vlan->vid, priv->vlan_4k_used);
+	else
+		clear_bit(vlan->vid, priv->vlan_4k_used);
+
 	return 0;
 }
 
--- a/drivers/net/dsa/realtek/rtl8365mb_vlan.h
+++ b/drivers/net/dsa/realtek/rtl8365mb_vlan.h
@@ -36,4 +36,6 @@ int rtl8365mb_vlan_4k_port_del(struct ds
 int rtl8365mb_vlan_pvid_port_set(struct dsa_switch *ds, int port, u16 vid,
 				 struct netlink_ext_ack *extack);
 int rtl8365mb_vlan_pvid_port_clear(struct dsa_switch *ds, int port, u16 vid);
+int rtl8365mb_vlan_4k_refresh_ivl(struct dsa_switch *ds, int port,
+				  bool filtering);
 #endif /* _REALTEK_RTL8365MB_VLAN_H */
