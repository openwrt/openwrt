--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -1073,6 +1073,7 @@ static int airoha_ppe_flow_offload_repla
 		case FLOW_ACTION_REDIRECT:
 			odev = act->dev;
 			break;
