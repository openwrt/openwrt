From: Chad Monroe <chad@monroe.io>
Date: Mon, 09 Mar 2026 12:45:43 -0700
Subject: [PATCH] net: phy: realtek: add RTL8261C LED support

Implement LED hw_control, brightness, and polarity callbacks for the
RTL8261C using its LCR2-LCR5 (speed select), LCR9 (activity blink),
and LCR10 (enable/polarity) registers.

Rebased onto the mainline RTL8261C/D support merged for v7.3, which has a
single phy_driver entry matching both PHY IDs rather than the separate
RTL8261C_CG and RTL8261CE entries of the v5 posting this was written
against. Only the struct member and the callback assignments moved; the
LED code itself is unchanged.

Confirmed on a Gemtek W1700K (Airoha AN7581), where LED index 2 drives an
orange and index 3 a green LED. The stock configuration is 0x0040 and
0x0010, i.e. 5G and 10G, so both stay dark on a slower link; pointing
either at RTL8261C_LEDCR_LINK_1000 lights it and it blinks with traffic.
The LED count of 4 matters here, index 3 being outside RTL8211x_LED_COUNT.

Signed-off-by: Chad Monroe <chad@monroe.io>
Tested-by: Simon Polack <spolack+git@mailbox.org>
Signed-off-by: Simon Polack <spolack+git@mailbox.org>
---

--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -337,6 +337,21 @@ struct rtl8261x_fw_entry {
 
 #define RTL826X_VND2_INSR			0xA43A
 
+/* RTL8261C-CG LED configuration (MMD VEND2) */
+#define RTL8261C_LED_COUNT			4
+#define RTL8261C_LEDCR_BASE			0xd032
+#define RTL8261C_LEDCR_STRIDE			2
+
+#define RTL8261C_LEDCR_LINK_10			BIT(0)
+#define RTL8261C_LEDCR_LINK_100			BIT(1)
+#define RTL8261C_LEDCR_LINK_1000		BIT(2)
+#define RTL8261C_LEDCR_LINK_10000		BIT(4)
+#define RTL8261C_LEDCR_LINK_2500		BIT(5)
+#define RTL8261C_LEDCR_LINK_5000		BIT(6)
+
+#define RTL8261C_LED_BCR			0xd040
+#define RTL8261C_LED_ECR			0xd044
+
 MODULE_DESCRIPTION("Realtek PHY driver");
 MODULE_AUTHOR("Johnson Leung");
 MODULE_LICENSE("GPL");
@@ -353,6 +368,7 @@ struct rtl8261x_priv {
 	const char *fw_name;
 	bool fw_loaded;
 	u8 sub_phy_id;
+	u8 led_active_low;
 };
 
 struct rtl822x_priv {
@@ -1631,6 +1647,214 @@ static int rtl8211e_led_hw_control_set(s
 	return ret;
 }
 
+static int rtl8261c_led_hw_is_supported(struct phy_device *phydev, u8 index,
+					unsigned long rules)
+{
+	const unsigned long activity_mask = BIT(TRIGGER_NETDEV_TX) |
+					    BIT(TRIGGER_NETDEV_RX);
+	const unsigned long mask = BIT(TRIGGER_NETDEV_LINK) |
+				   BIT(TRIGGER_NETDEV_LINK_10) |
+				   BIT(TRIGGER_NETDEV_LINK_100) |
+				   BIT(TRIGGER_NETDEV_LINK_1000) |
+				   BIT(TRIGGER_NETDEV_LINK_2500) |
+				   BIT(TRIGGER_NETDEV_LINK_5000) |
+				   BIT(TRIGGER_NETDEV_LINK_10000) |
+				   activity_mask;
+
+	if (index >= RTL8261C_LED_COUNT)
+		return -EINVAL;
+
+	if (rules & ~mask)
+		return -EOPNOTSUPP;
+
+	/* HW activity blink is speed-dependent; reject activity-only */
+	if ((rules & activity_mask) && !(rules & ~activity_mask))
+		return -EOPNOTSUPP;
+
+	return 0;
+}
+
+static int rtl8261c_led_hw_control_get(struct phy_device *phydev, u8 index,
+				       unsigned long *rules)
+{
+	u16 reg = RTL8261C_LEDCR_BASE + index * RTL8261C_LEDCR_STRIDE;
+	int val;
+
+	if (index >= RTL8261C_LED_COUNT)
+		return -EINVAL;
+
+	val = phy_read_mmd(phydev, MDIO_MMD_VEND2, reg);
+	if (val < 0)
+		return val;
+
+	if (val & RTL8261C_LEDCR_LINK_10)
+		__set_bit(TRIGGER_NETDEV_LINK_10, rules);
+
+	if (val & RTL8261C_LEDCR_LINK_100)
+		__set_bit(TRIGGER_NETDEV_LINK_100, rules);
+
+	if (val & RTL8261C_LEDCR_LINK_1000)
+		__set_bit(TRIGGER_NETDEV_LINK_1000, rules);
+
+	if (val & RTL8261C_LEDCR_LINK_2500)
+		__set_bit(TRIGGER_NETDEV_LINK_2500, rules);
+
+	if (val & RTL8261C_LEDCR_LINK_5000)
+		__set_bit(TRIGGER_NETDEV_LINK_5000, rules);
+
+	if (val & RTL8261C_LEDCR_LINK_10000)
+		__set_bit(TRIGGER_NETDEV_LINK_10000, rules);
+
+	if ((val & RTL8261C_LEDCR_LINK_10) &&
+	    (val & RTL8261C_LEDCR_LINK_100) &&
+	    (val & RTL8261C_LEDCR_LINK_1000) &&
+	    (val & RTL8261C_LEDCR_LINK_2500) &&
+	    (val & RTL8261C_LEDCR_LINK_5000) &&
+	    (val & RTL8261C_LEDCR_LINK_10000))
+		__set_bit(TRIGGER_NETDEV_LINK, rules);
+
+	val = phy_read_mmd(phydev, MDIO_MMD_VEND2, RTL8261C_LED_BCR);
+	if (val < 0)
+		return val;
+
+	if (val & BIT(index)) {
+		__set_bit(TRIGGER_NETDEV_TX, rules);
+		__set_bit(TRIGGER_NETDEV_RX, rules);
+	}
+
+	return 0;
+}
+
+static int rtl8261c_led_hw_control_set(struct phy_device *phydev, u8 index,
+				       unsigned long rules)
+{
+	struct rtl8261x_priv *priv = phydev->priv;
+	u16 reg = RTL8261C_LEDCR_BASE + index * RTL8261C_LEDCR_STRIDE;
+	u16 ecr_mask = BIT(index) | BIT(index + 4);
+	u16 ecr_val, val = 0;
+	int ret;
+
+	if (index >= RTL8261C_LED_COUNT)
+		return -EINVAL;
+
+	if (test_bit(TRIGGER_NETDEV_LINK, &rules) ||
+	    test_bit(TRIGGER_NETDEV_LINK_10, &rules))
+		val |= RTL8261C_LEDCR_LINK_10;
+
+	if (test_bit(TRIGGER_NETDEV_LINK, &rules) ||
+	    test_bit(TRIGGER_NETDEV_LINK_100, &rules))
+		val |= RTL8261C_LEDCR_LINK_100;
+
+	if (test_bit(TRIGGER_NETDEV_LINK, &rules) ||
+	    test_bit(TRIGGER_NETDEV_LINK_1000, &rules))
+		val |= RTL8261C_LEDCR_LINK_1000;
+
+	if (test_bit(TRIGGER_NETDEV_LINK, &rules) ||
+	    test_bit(TRIGGER_NETDEV_LINK_2500, &rules))
+		val |= RTL8261C_LEDCR_LINK_2500;
+
+	if (test_bit(TRIGGER_NETDEV_LINK, &rules) ||
+	    test_bit(TRIGGER_NETDEV_LINK_5000, &rules))
+		val |= RTL8261C_LEDCR_LINK_5000;
+
+	if (test_bit(TRIGGER_NETDEV_LINK, &rules) ||
+	    test_bit(TRIGGER_NETDEV_LINK_10000, &rules))
+		val |= RTL8261C_LEDCR_LINK_10000;
+
+	ret = phy_write_mmd(phydev, MDIO_MMD_VEND2, reg, val);
+	if (ret < 0)
+		return ret;
+
+	ret = phy_modify_mmd(phydev, MDIO_MMD_VEND2, RTL8261C_LED_BCR,
+			     BIT(index),
+			     (test_bit(TRIGGER_NETDEV_TX, &rules) ||
+			      test_bit(TRIGGER_NETDEV_RX, &rules)) ?
+			     BIT(index) : 0);
+	if (ret < 0)
+		return ret;
+
+	/* active-high: polarity=0 (LOW=OFF when idle)
+	 * active-low:  polarity=1 (HIGH=OFF when idle)
+	 */
+	ecr_val = BIT(index + 4);
+	if (priv->led_active_low & BIT(index))
+		ecr_val |= BIT(index);
+
+	return phy_modify_mmd(phydev, MDIO_MMD_VEND2, RTL8261C_LED_ECR,
+			      ecr_mask, ecr_val);
+}
+
+static int rtl8261c_led_brightness_set(struct phy_device *phydev, u8 index,
+				       enum led_brightness brightness)
+{
+	struct rtl8261x_priv *priv = phydev->priv;
+	u16 reg = RTL8261C_LEDCR_BASE + index * RTL8261C_LEDCR_STRIDE;
+	u16 ecr_mask = BIT(index) | BIT(index + 4);
+	bool active;
+	u16 ecr_val;
+	int ret;
+
+	if (index >= RTL8261C_LED_COUNT)
+		return -EINVAL;
+
+	ret = phy_write_mmd(phydev, MDIO_MMD_VEND2, reg, 0);
+	if (ret < 0)
+		return ret;
+
+	ret = phy_clear_bits_mmd(phydev, MDIO_MMD_VEND2, RTL8261C_LED_BCR,
+				 BIT(index));
+	if (ret < 0)
+		return ret;
+
+	active = (brightness != LED_OFF) ^
+		 !!(priv->led_active_low & BIT(index));
+
+	ecr_val = BIT(index + 4);
+	if (active)
+		ecr_val |= BIT(index);
+
+	return phy_modify_mmd(phydev, MDIO_MMD_VEND2, RTL8261C_LED_ECR,
+			      ecr_mask, ecr_val);
+}
+
+static int rtl8261c_led_polarity_set(struct phy_device *phydev, int index,
+				     unsigned long modes)
+{
+	struct rtl8261x_priv *priv = phydev->priv;
+	bool active_low = false, active_high = false;
+	u32 mode;
+
+	if (index >= RTL8261C_LED_COUNT)
+		return -EINVAL;
+
+	for_each_set_bit(mode, &modes, __PHY_LED_MODES_NUM) {
+		switch (mode) {
+		case PHY_LED_ACTIVE_LOW:
+			active_low = true;
+			break;
+		case PHY_LED_ACTIVE_HIGH:
+			active_high = true;
+			break;
+		default:
+			return -EINVAL;
+		}
+	}
+
+	if (active_low) {
+		priv->led_active_low |= BIT(index);
+		return phy_clear_bits_mmd(phydev, MDIO_MMD_VEND2,
+					  RTL8261C_LED_ECR, BIT(index));
+	}
+
+	if (active_high) {
+		priv->led_active_low &= ~BIT(index);
+		return phy_set_bits_mmd(phydev, MDIO_MMD_VEND2,
+					RTL8261C_LED_ECR, BIT(index));
+	}
+
+	return -EINVAL;
+}
+
 static int rtl8211e_config_init(struct phy_device *phydev)
 {
 	u16 val;
@@ -3923,6 +4147,11 @@ static struct phy_driver realtek_drvs[]
 		.soft_reset		= genphy_c45_pma_soft_reset,
 		.suspend		= genphy_c45_pma_suspend,
 		.resume			= genphy_c45_pma_resume,
+		.led_hw_is_supported	= rtl8261c_led_hw_is_supported,
+		.led_hw_control_get	= rtl8261c_led_hw_control_get,
+		.led_hw_control_set	= rtl8261c_led_hw_control_set,
+		.led_brightness_set	= rtl8261c_led_brightness_set,
+		.led_polarity_set	= rtl8261c_led_polarity_set,
 	}, {
 		.name           = "RTL8251L 5Gbps PHY",
 		.config_init    = rtl826x_config_init,
