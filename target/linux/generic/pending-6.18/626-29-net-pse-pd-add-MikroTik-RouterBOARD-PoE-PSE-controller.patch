+/* ---------------------------------------------------------------------------
+ * debugfs: forced mode control and raw MCU state for diagnostics
+ * ---------------------------------------------------------------------------
+ */
+
+static ssize_t rbpoe_force_mode_read(struct file *file, char __user *buf,
+				     size_t count, loff_t *ppos)
+{
+	struct rbpoe_priv *priv = file->private_data;
+	char value[2];
+
+	mutex_lock(&priv->lock);
+	value[0] = priv->force_mode ? 'Y' : 'N';
+	mutex_unlock(&priv->lock);
+	value[1] = '\n';
+
+	return simple_read_from_buffer(buf, count, ppos, value, sizeof(value));
+}
+
+static ssize_t rbpoe_force_mode_write(struct file *file, const char __user *buf,
+				      size_t count, loff_t *ppos)
+{
+	struct rbpoe_priv *priv = file->private_data;
+	bool force_mode;
+	int ret;
+
+	ret = kstrtobool_from_user(buf, count, &force_mode);
+	if (ret)
+		return ret;
+
+	mutex_lock(&priv->lock);
+	priv->force_mode = force_mode;
+	mutex_unlock(&priv->lock);
+
+	return count;
+}
+
+static const struct file_operations rbpoe_force_mode_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = rbpoe_force_mode_read,
+	.write = rbpoe_force_mode_write,
+	.llseek = default_llseek,
+};
