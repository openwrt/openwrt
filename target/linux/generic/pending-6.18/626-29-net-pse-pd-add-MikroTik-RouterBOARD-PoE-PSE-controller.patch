+static const struct spi_device_id rbpoe_spi_id[] = {
+	{ "rb960pgs", (kernel_ulong_t)&rbpoe_rb960pgs_model },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, rbpoe_spi_id);
