+int patch_phys_v008_rls_lockmain(struct rtl837x_priv *priv, u16 phy_mask)
+{
+	int ret;
+
+	for (int p = 0; p < 8; p++) {
+		if (!(phy_mask&BIT(p)))
+			continue;
+
+		ret = patch_phy_v008_rls_lockmain(priv, p);
+		if (ret)
+			dev_err(priv->dev, "Failed to apply %s port(%d) %d\n", __func__, p, ret);
+	}
+	dev_info(priv->dev, "Apply %s Finish\n", __func__);
+	return 0;
+}
