+#define RTL8372N_GLOBAL_RESET_REG		0x0024
+/* Soft reset of the whole chip, clears itself when done */
+#define RTL8372N_GLOBAL_RESET_SOFT		BIT(0)
+/* Embedded 8051 and hardware setup */
+#define RTL8372N_HW_CONFIG_REG			0x6040
+/* Set once initialisation is complete */
+#define RTL8372N_HW_CONFIG_8051_READY		BIT(0)
+
+/* GPIO and pin multiplexing */
+/* GPIO data registers, one bit per pin (LO: pins 0-31, HI: pins 32-63) */
+#define RTL8372N_GPIO_OUT_LO_REG		0x003c
+#define RTL8372N_GPIO_OUT_HI_REG		0x0040
+#define RTL8372N_GPIO_IN_LO_REG			0x0044
+#define RTL8372N_GPIO_IN_HI_REG			0x0048
+#define RTL8372N_GPIO_DIR_LO_REG		0x004c
+#define RTL8372N_GPIO_DIR_HI_REG		0x0050
+/* Pin function selection; the driver sets these bits to give a pin to the GPIO block */
+#define RTL8372N_PINMUX0_REG			0x7f8c
+#define RTL8372N_PINMUX1_REG			0x7f90
+#define RTL8372N_PINMUX2_REG			0x7f94
+#define RTL8372N_PINMUX_MDIO0_AS_GPIO		BIT(4)
+#define RTL8372N_PINMUX_MDIO1_A			BIT(5)
+#define RTL8372N_PINMUX_MDIO1_B			BIT(6)
+#define RTL8372N_PINMUX_PWM_OUT			BIT(30)
+#define RTL8372N_PINMUX_SDA4			BIT(29)
+#define RTL8372N_PINMUX_UART0_TX		BIT(0)
+#define RTL8372N_PINMUX_UART0_RX		BIT(1)
+#define RTL8372N_PINMUX_GPIO30			BIT(3)
+
+/* Internal PHY wiring options */
+/* Reverse the MDI pair order of the four internal PHYs */
+#define RTL8372N_PHY_MDI_REVERSE_REG		0x0a90
+#define RTL8372N_PHY_MDI_REVERSE_PHY0		BIT(0)
+#define RTL8372N_PHY_MDI_REVERSE_PHY1		BIT(1)
+#define RTL8372N_PHY_MDI_REVERSE_PHY2		BIT(2)
+#define RTL8372N_PHY_MDI_REVERSE_PHY3		BIT(3)
+/* Swap the TX pair polarity of the four internal PHYs */
+#define RTL8372N_PHY_TX_POL_SWAP_REG		0x0a94
+#define RTL8372N_PHY_TX_POL_SWAP_PHY0		GENMASK(3, 0)
+#define RTL8372N_PHY_TX_POL_SWAP_PHY1		GENMASK(7, 4)
+#define RTL8372N_PHY_TX_POL_SWAP_PHY2		GENMASK(11, 8)
+#define RTL8372N_PHY_TX_POL_SWAP_PHY3		GENMASK(15, 12)
+
+/* MDIO master and PHY access */
+/* Target PHYs of a write, one bit per PHY */
+#define RTL8372N_PHY_ACC_PORTMASK_REG		0x6438
+/* PHY access command */
+#define RTL8372N_PHY_ACC_CMD_REG		0x643c
+/* Start; reads back 1 while busy */
+#define RTL8372N_PHY_ACC_CMD_EXEC		BIT(0)
+#define RTL8372N_PHY_ACC_CMD_FAIL		GENMASK(26, 24)
+#define RTL8372N_PHY_ACC_CMD_DEVAD		GENMASK(23, 19)
+#define RTL8372N_PHY_ACC_CMD_REGNUM		GENMASK(18, 3)
+/* 1 = write, 0 = read */
+#define RTL8372N_PHY_ACC_CMD_WRITE		BIT(2)
+/* 1 = clause 45 frame */
+#define RTL8372N_PHY_ACC_CMD_C45		BIT(1)
+/* Data returned by a read */
+#define RTL8372N_PHY_ACC_RDATA_REG		0x6440
+#define RTL8372N_PHY_ACC_RDATA_MASK		GENMASK(15, 0)
+/* Data for a write; PHY address for a read */
+#define RTL8372N_PHY_ACC_WDATA_REG		0x6444
+#define RTL8372N_PHY_ACC_WDATA_MASK		GENMASK(15, 0)
