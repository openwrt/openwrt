+#define RTL8372N_SMI_CTRL_REG			0x6454
+#define RTL8372N_SMI_CTRL_MDC_EN_BUS0		BIT(12)
+#define RTL8372N_SMI_CTRL_MDC_EN_BUS1		BIT(13)
+#define RTL8372N_SMI_CTRL_MDC_EN_BUS2		BIT(14)
+/* Automatic PHY status polling */
+#define RTL8372N_PHY_POLL_CTRL_REG		0x632c
+#define RTL8372N_PHY_POLL_CTRL_PORTMASK		GENMASK(20, 12)
+/* MAC type used for polling ports 3 and 8 */
+#define RTL8372N_PHY_POLL_MAC_TYPE_REG		0x6330
+#define RTL8372N_PHY_POLL_MAC_TYPE_P3		GENMASK(7, 6)
+#define RTL8372N_PHY_POLL_MAC_TYPE_P8		GENMASK(17, 16)
+/* Polling source selection, one bit per port */
+#define RTL8372N_PHY_POLL_SEL_REG		0x6334
+#define RTL8372N_PHY_POLL_SEL_P4		BIT(4)
+#define RTL8372N_PHY_POLL_SEL_P5		BIT(5)
+#define RTL8372N_PHY_POLL_SEL_P6		BIT(6)
+#define RTL8372N_PHY_POLL_SEL_P7		BIT(7)
+
+/* SerDes */
+/* Indirect SerDes register access */
+#define RTL8372N_SDS_ACC_CMD_REG		0x03f8
+/* Start; reads back 1 while busy */
+#define RTL8372N_SDS_ACC_CMD_EXEC		BIT(15)
+#define RTL8372N_SDS_ACC_CMD_INDEX		BIT(0)
+#define RTL8372N_SDS_ACC_CMD_PAGE		GENMASK(6, 1)
+#define RTL8372N_SDS_ACC_CMD_REGNUM		GENMASK(11, 7)
+/* 1 = write, 0 = read */
+#define RTL8372N_SDS_ACC_CMD_WRITE		BIT(14)
+#define RTL8372N_SDS_ACC_RDATA_REG		0x03fc
+#define RTL8372N_SDS_ACC_WDATA_REG		0x0400
+/* Operating mode of the two SerDes */
+#define RTL8372N_SDS_MODE_REG			0x7b20
+/* External 2.5G PHY attached to MAC port 3 */
+#define RTL8372N_SDS_MODE_EXT_2500_P3		BIT(21)
+/* External 2.5G PHY attached to MAC port 8 */
+#define RTL8372N_SDS_MODE_EXT_2500_P8		BIT(22)
+#define RTL8372N_SDS_MODE_SDS0			GENMASK(4, 0)
+#define RTL8372N_SDS_MODE_SDS0_USX_SUBMODE	GENMASK(14, 10)
+#define RTL8372N_SDS_MODE_SDS1			GENMASK(9, 5)
+#define RTL8372N_SDS_MODE_SDS1_USX_SUBMODE	GENMASK(20, 16)
+/* Reconciliation layer setup */
+#define RTL8372N_RECONCILE_CFG_REG		0x0b7c
+/* Do not signal link faults */
+#define RTL8372N_RECONCILE_CFG_NO_FAULT_IND	BIT(5)
+
+/* MAC control and link status */
+/* Forwarding of MAC control frames */
+#define RTL8372N_MAC_GLOBAL_CTRL_REG		0x5fd4
+/* Two forwarding options for MAC control frames, always set together */
+#define RTL8372N_MAC_GLOBAL_CTRL_FWD_CTL_FRAMES	GENMASK(20, 19)
+/* Per-port MAC setup */
+#define RTL8372N_PORT_MAC_CTRL_REG(port)	(0x1238 + (port) * 0x100)
+#define RTL8372N_PORT_MAC_CTRL_CLK_SWITCH	BIT(8)
+#define RTL8372N_PORT_MAC_CTRL_RX_CRC_CHECK	BIT(4)
+/* Per-port half duplex back pressure */
+#define RTL8372N_PORT_BACKPRESSURE_REG(port)	(0x122c + (port) * 0x100)
+#define RTL8372N_PORT_BACKPRESSURE_EN		BIT(0)
+/* Link state bitmaps, one bit per port */
+#define RTL8372N_LINK_UP_STATUS_REG		0x63e8
+#define RTL8372N_DUPLEX_STATUS_REG		0x63f8
+#define RTL8372N_RX_PAUSE_STATUS_REG		0x6400
+#define RTL8372N_TX_PAUSE_STATUS_REG		0x63fc
+/* Current speed, a 4-bit field per port */
+#define RTL8372N_SPEED_STATUS_REG(port)		(0x63f0 + ((port) / 8) * 4)
+#define RTL8372N_SPEED_STATUS_MASK(port)	(0xfU << (((port) % 8) * 4))
+
+/* CPU tag */
+/* Ports that carry the CPU tag (bit 9 is the CPU port) */
+#define RTL8372N_CPU_TAG_AWARE_PORTS_REG	0x603c
+/* CPU tag insertion */
+#define RTL8372N_CPU_TAG_CTRL_REG		0x6720
+#define RTL8372N_CPU_TAG_CTRL_INSERT_EN		BIT(1)
+#define RTL8372N_CPU_TAG_CTRL_INSERT_MODE	GENMASK(11, 10)
+/* Port number of the external CPU */
+#define RTL8372N_EXT_CPU_PORT_REG		0x6724
+#define RTL8372N_EXT_CPU_PORT_MASK		GENMASK(3, 0)
+
+/* VLAN */
+/* Global VLAN control */
+#define RTL8372N_VLAN_CTRL_REG			0x4e14
+#define RTL8372N_VLAN_CTRL_EGRESS_FILTER	BIT(2)
+#define RTL8372N_VLAN_CTRL_TABLE_RESET		BIT(3)
+/* Disable address learning per VLAN, word n */
+#define RTL8372N_VLAN_LEARN_DIS_REG(n)		(0x4e30 + (n) * 4)
