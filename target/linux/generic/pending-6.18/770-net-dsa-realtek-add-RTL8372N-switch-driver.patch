+	if (ret)
+		return ret;
+
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xb820, 1<<7, 1);
+	if (ret)
+		return ret;
+	// n0_patch_RL6818C_230703 start
+	for (int i = 0; i < sizeof(rst_smtr_patch_6818C_230703_patch)/(sizeof(u16)*2); i++) {
+		ret = rtl837x_phy_write_c45(priv, phy, 31,
+			  rst_smtr_patch_6818C_230703_patch[i][0],
+			  rst_smtr_patch_6818C_230703_patch[i][1]
+			);
+		if (ret)
+			return ret;
+	}
+	// n0_patch_RL6818C_230703 stop
+
+	// n2_patch_6818C_231206 start
+	for (int i = 0; i < sizeof(n2_patch_6818C_231206_patch)/(sizeof(u16)*2); i++) {
