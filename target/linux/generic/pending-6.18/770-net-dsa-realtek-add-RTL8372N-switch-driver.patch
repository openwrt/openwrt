+
+	data[2] |=
+		FIELD_PREP(RTL837X_L3_D2_IGMPIDX_MSK, l3->igmp_idx);
+	data[2] |=
+		FIELD_PREP(RTL837X_L3_D2_IGMPASIC_MSK, l3->igmp_asic);
+}
