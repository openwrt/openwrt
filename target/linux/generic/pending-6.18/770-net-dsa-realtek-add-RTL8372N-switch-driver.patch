+static int rtl8372n_mdio_phy_read_c22(struct mii_bus *bus, int addr, int regnum)
+{
+	struct rtl837x_priv *priv = bus->priv;
+	u16 val;
+
+	int ret = priv->ops->phy_read_c22(priv, addr, regnum, &val);
+
+	if (ret)
+		return ret;
+
+	return val;
+}
