+
+	ret = uc1_sram_write_8b(priv, phy, 0x8ffb, 0x01);
+	if (ret)
+		return ret;
+	ret = uc1_sram_write_8b(priv, phy, 0x80dc, 0x0a);
+	if (ret)
+		return ret;
+	ret = uc1_sram_write_8b(priv, phy, 0x8378, 0x22);
+	if (ret)
+		return ret;
+
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xa47e, 0x3<<6, 0x1);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8217, 0x1e);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8384, 0x04);
+	if (ret)
+		return ret;
+
+	// add for sub_echo_chnest
+	ret = uc2_sram_write_8b(priv, phy, 0x8fd6, 0x00);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fd7, 0x00);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fd8, 0x0c);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fd9, 0x80);
