+				FIELD_PREP(RTL8372N_SDS_ACC_CMD_PAGE, sds_page) |
+				FIELD_PREP(RTL8372N_SDS_ACC_CMD_REGNUM, sds_reg) |
+				FIELD_PREP(RTL8372N_SDS_ACC_CMD_WRITE, 0) |
+				FIELD_PREP(RTL8372N_SDS_ACC_CMD_EXEC, 1);
+
+	ret = rtl837x_reg_write(priv, RTL8372N_SDS_ACC_CMD_REG, tmp);
+	if (ret)
+		return ret;
+
+	ret = regmap_read_poll_timeout(priv->map, RTL8372N_SDS_ACC_CMD_REG, tmp,
+		  ((tmp & RTL8372N_SDS_ACC_CMD_EXEC) == 0),
