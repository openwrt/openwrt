+static int rtl8372n_mdio_phy_read_c45(struct mii_bus *bus, int port, int devad, int regnum)
+{
+	struct rtl837x_priv *priv = bus->priv;
+	u16 val;
+	int ret = priv->ops->phy_read_c45(priv, port, devad, regnum, &val);
+
+	if (ret)
+		return ret;
+
