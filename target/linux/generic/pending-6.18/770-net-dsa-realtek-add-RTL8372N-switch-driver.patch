+#define RTL837X_L2_MC_D0_MAC3_MSK		GENMASK(23, 16)
+#define RTL837X_L2_MC_D0_MAC2_MSK		GENMASK(31, 24)
+#define RTL837X_L2_MC_D1_MAC1_MSK		GENMASK(7, 0)
+#define RTL837X_L2_MC_D1_MAC0_MSK		GENMASK(15, 8)
