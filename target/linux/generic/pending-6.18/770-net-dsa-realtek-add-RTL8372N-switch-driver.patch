+#define RTL8372N_VLAN_ACCEPT_FRAME_REG(port)	(0x4e10 + ((port) / 10) * 4)
+#define RTL8372N_VLAN_ACCEPT_FRAME_MASK(port)	(0x3U << (((port) % 10) * 2))
+/* Ingress membership check, 1 bit per port */
+#define RTL8372N_VLAN_INGRESS_FILTER_REG(port)	(0x4e18 + ((port) / 10) * 4)
+#define RTL8372N_VLAN_INGRESS_FILTER_BIT(port)	(0x1U << ((port) % 10))
+/* Port VLAN id, 12 bits per port */
+#define RTL8372N_VLAN_PVID_REG(port)		(0x4e1c + ((port) / 2) * 4)
+#define RTL8372N_VLAN_PVID_MASK(port)		(0xfffU << (((port) % 2) * 12))
+/* Egress tagging mode, 2 bits per port */
+#define RTL8372N_VLAN_EGRESS_TAG_MODE_REG(port)	(0x6738 + ((port) / 10) * 4)
+#define RTL8372N_VLAN_EGRESS_TAG_MODE_MASK(port)	(0x3U << (((port) % 10) * 2))
+/* Egress ports that keep the received tag, 10-bit mask per port */
+#define RTL8372N_VLAN_EGRESS_KEEP_REG(port)	(0x6728 + ((port) / 3) * 4)
+#define RTL8372N_VLAN_EGRESS_KEEP_MASK(port)	(0x3ffU << (((port) % 3) * 10))
+#define RTL8372N_VLAN_EGRESS_KEEP_SHIFT(port)	(((port) % 3) * 10)
+/* Egress ports forwarded transparently, 10-bit mask per port */
+#define RTL8372N_VLAN_EGRESS_TRANSP_REG(port)	(0x4eb8 + ((port) / 3) * 4)
+#define RTL8372N_VLAN_EGRESS_TRANSP_MASK(port)	(0x3ffU << (((port) % 3) * 10))
+#define RTL8372N_VLAN_EGRESS_TRANSP_SHIFT(port)	(((port) % 3) * 10)
+
+/* Table access and L2 address table */
+/* Indirect access to the VLAN and L2 tables */
+#define RTL8372N_TBL_ACC_CMD_REG		0x5cac
+#define RTL8372N_TBL_ACC_CMD_INDEX		GENMASK(28, 16)
+/* 1 = write, 0 = read */
+#define RTL8372N_TBL_ACC_CMD_WRITE		BIT(1)
+/* Start; reads back 1 while busy */
+#define RTL8372N_TBL_ACC_CMD_EXEC		BIT(0)
+/* 3 = VLAN table, 4 = L2 table */
+#define RTL8372N_TBL_ACC_CMD_TYPE		GENMASK(10, 8)
+/* Data words of the table entry */
+#define RTL8372N_TBL_RDATA_REG(i)		(0x5ccc + (i) * 4)
+#define RTL8372N_TBL_WDATA_REG(i)		(0x5cb8 + (i) * 4)
+/* L2 table lookup */
+#define RTL8372N_L2_LOOKUP_CTRL_REG		0x5cb0
+#define RTL8372N_L2_LOOKUP_HIT			BIT(12)
+#define RTL8372N_L2_LOOKUP_CLEAR		BIT(18)
+#define RTL8372N_L2_LOOKUP_PORT			GENMASK(22, 19)
+#define RTL8372N_L2_LOOKUP_METHOD		GENMASK(17, 14)
+#define RTL8372N_L2_LOOKUP_INDEX		GENMASK(11, 0)
+/* What to do when the learning limit is reached */
+#define RTL8372N_L2_LIMIT_ACTION_REG		0x4f80
+#define RTL8372N_L2_LIMIT_ACTION_MASK		GENMASK(1, 0)
+/* Clear the whole L2 table */
+#define RTL8372N_L2_CLEAR_ALL_REG		0x53d8
+#define RTL8372N_L2_CLEAR_ALL_START		BIT(0)
+/* Flush learned entries */
+#define RTL8372N_L2_FLUSH_CMD_REG		0x53d4
+#define RTL8372N_L2_FLUSH_CMD_START		BIT(16)
+#define RTL8372N_L2_FLUSH_CMD_BUSY		BIT(17)
+#define RTL8372N_L2_FLUSH_CMD_PORTMASK		GENMASK(9, 0)
+#define RTL8372N_L2_FLUSH_MODE_REG		0x53dc
+#define RTL8372N_L2_FLUSH_MODE_MASK		GENMASK(1, 0)
+
+/* MIB counters */
+/* MIB counter read command */
+#define RTL8372N_MIB_ACC_CMD_REG		0x0f60
+/* Start; reads back 1 while busy */
+#define RTL8372N_MIB_ACC_CMD_BUSY		BIT(0)
+#define RTL8372N_MIB_ACC_CMD_COUNTER		GENMASK(10, 5)
+#define RTL8372N_MIB_ACC_CMD_PORT		GENMASK(4, 1)
+#define RTL8372N_MIB_DATA_HI_REG		0x0f64
+#define RTL8372N_MIB_DATA_LO_REG		0x0f68
+
+/* Mirroring, port isolation and spanning tree */
+/* Mirror control, including leaky bits */
+#define RTL8372N_MIRROR_CTRL_REG		0x50e8
+#define RTL8372N_MIRROR_CTRL_ISO_LEAKY_B	BIT(6)
+#define RTL8372N_MIRROR_CTRL_VLAN_LEAKY_B	BIT(4)
+#define RTL8372N_MIRROR_CTRL_ISO_LEAKY_A	BIT(5)
+#define RTL8372N_MIRROR_CTRL_VLAN_LEAKY_A	BIT(3)
+/* Ports a given port may forward to */
+#define RTL8372N_PORT_ISOLATION_REG(port)	(0x50c0 + (port) * 4)
+/* Spanning tree port states of instance i, 2 bits per port */
+#define RTL8372N_MSTP_STATE_REG(i)		(0x5310 + (i) * 4)
+
+/* Energy efficient Ethernet */
+/* Per-port EEE enable */
+#define RTL8372N_PORT_EEE_CTRL_REG(port)	(0x125c + (port) * 0x100)
+#define RTL8372N_PORT_EEE_CTRL_RX_EN		BIT(0)
+#define RTL8372N_PORT_EEE_CTRL_TX_EN		BIT(1)
+
+/* Flow control */
+/* Per-port flow control setup */
+#define RTL8372N_PORT_FLOWCTRL_REG(port)	(0x7124 + (port) * 4)
+
+#endif /* _RTL8372N_REGS_H */
