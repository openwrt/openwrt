+int rtl837x_vlan_set(struct rtl837x_priv *priv, struct rtl837x_vlan_data *vlan)
+{
+	int ret;
+	u32 tmp;
+
+	mutex_lock(&priv->ita_lock);
+
+	ret = rtl837x_reg_write(priv, RTL8372N_TBL_WDATA_REG(0), vlan->val);
+	if (ret)
+		goto out;
+
+	tmp = FIELD_PREP(RTL8372N_TBL_ACC_CMD_INDEX, vlan->vid) |
+		  FIELD_PREP(RTL8372N_TBL_ACC_CMD_TYPE, TB_TARGET_CVLAN) |
+		  FIELD_PREP(RTL8372N_TBL_ACC_CMD_WRITE, TB_OP_WRITE) |
+		  FIELD_PREP(RTL8372N_TBL_ACC_CMD_EXEC, TB_EXECUTE);
+
+	ret = rtl837x_reg_write(priv, RTL8372N_TBL_ACC_CMD_REG, tmp);
+	if (ret)
+		goto out;
+
+	ret = regmap_read_poll_timeout(priv->map, RTL8372N_TBL_ACC_CMD_REG, tmp,
+		  ((tmp & RTL8372N_TBL_ACC_CMD_EXEC) == 0),
+		  0, 1000);
+	if (ret)
+		goto out;
+out:
+	mutex_unlock(&priv->ita_lock);
+	return ret;
+}
+
+int rtl837x_vlan_get(struct rtl837x_priv *priv, struct rtl837x_vlan_data *vlan)
+{
+	int ret;
+	u32 tmp;
+
+	mutex_lock(&priv->ita_lock);
+
+	ret = regmap_read_poll_timeout(priv->map, RTL8372N_TBL_ACC_CMD_REG, tmp,
+		  ((tmp & RTL8372N_TBL_ACC_CMD_EXEC) == 0),
+		  0, 1000);
+	if (ret)
+		goto out;
+
+	tmp = FIELD_PREP(RTL8372N_TBL_ACC_CMD_INDEX, vlan->vid) |
+		  FIELD_PREP(RTL8372N_TBL_ACC_CMD_TYPE, TB_TARGET_CVLAN) |
+		  FIELD_PREP(RTL8372N_TBL_ACC_CMD_WRITE, TB_OP_READ) |
+		  FIELD_PREP(RTL8372N_TBL_ACC_CMD_EXEC, TB_EXECUTE);
+
+	ret = rtl837x_reg_write(priv, RTL8372N_TBL_ACC_CMD_REG, tmp);
+	if (ret)
+		return ret;
+
+	ret = regmap_read_poll_timeout(priv->map, RTL8372N_TBL_ACC_CMD_REG, tmp,
+		  ((tmp & RTL8372N_TBL_ACC_CMD_EXEC) == 0),
+		  0, 1000);
+	if (ret)
+		goto out;
+
+	ret = rtl837x_reg_read(priv, RTL8372N_TBL_RDATA_REG(0), &tmp);
+	if (ret)
+		goto out;
+	vlan->val = tmp;
+
+out:
+	mutex_unlock(&priv->ita_lock);
+	return ret;
+}
