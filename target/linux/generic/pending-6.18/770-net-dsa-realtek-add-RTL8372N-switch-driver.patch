+	if (ret1)
+		return ret1;
+
+    // Lock Main
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xa4a0, 1<<10, 1);
+	if (ret)
+		return ret;
+
+	// Wait pcs status == 1
+	ret = read_poll_timeout(rtl837x_phy_bits_read_c45, ret1,
+			  (tmp16 == 1) || (ret1),
+			  50, 250*1000, true,
+			  priv, phy, 31, 0xa600, 0xff, &tmp16);
+	if (ret)
+		return ret;
+	if (ret1)
+		return ret1;
+
+	// RTCT patch
+	// RTCT_para_6818C_231206 start
+	for (int i = 0; i < sizeof(RTCT_para_6818C_231206_patch)/(sizeof(u16)*4); i++) {
