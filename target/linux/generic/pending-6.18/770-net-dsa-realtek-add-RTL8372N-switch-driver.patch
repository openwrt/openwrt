From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: StarField Xu <air_jinkela@163.com>
Subject: [PATCH] net: dsa: realtek: add RTL8372N switch driver

Driver for the Realtek RTL8372N 2.5G switch, managed over MDIO, as used
for the LAN and 10G RJ45 ports of the Ubiquiti UniFi Cloud Gateway Fiber.

Taken from https://github.com/RuijieNetworksCommunity/rtl837x-dsa-driver
(release 0.0.2, commit 7f3b64c7f3a3), moved into drivers/net/dsa/realtek
with a kernel Kconfig and Makefile. The debugfs interface, which gives
root raw register access, is built only with
CONFIG_NET_DSA_REALTEK_RTL8372N_DEBUGFS (default n).

The register definitions (rtl8372n_regs.h) were written for this patch
from the behaviour of the vendor firmware and cross-checked with
RTLPlayground (MIT License); the original driver's register header is
not used. Changes against the original driver: only the RTL8_4 tag
protocol is supported (the 802.1Q-based tagging is dropped), C22 PHY
registers are accessed as MMD 31 registers 0xa400 + 2 * reg through the
clause 45 path, the separate SerDes register reset after the chip reset
is removed, switch GPIOs 42-45 are not supported, and the debugfs EEE
dump no longer shows the LPI and status fields.

--- a/drivers/net/dsa/realtek/Kconfig
+++ b/drivers/net/dsa/realtek/Kconfig
@@ -50,3 +50,23 @@ config NET_DSA_REALTEK_RTL8366RB_LEDS
 	default NET_DSA_REALTEK_RTL8366RB
 
 endif
+
+config NET_DSA_REALTEK_RTL8372N
+	tristate "Realtek RTL8372N Ethernet switch support"
+	depends on NET_DSA && OF
+	select NET_DSA_TAG_RTL8_4
+	select REGMAP
+	help
+	  Select to enable support for the Realtek RTL8372N 2.5G Ethernet
+	  switch, managed over MDIO.
+
+	  This driver can also be built as a module. If so, the module
+	  will be called rtl8372n_dsa.
+
+config NET_DSA_REALTEK_RTL8372N_DEBUGFS
+	bool "RTL8372N debugfs interface"
+	depends on NET_DSA_REALTEK_RTL8372N && DEBUG_FS
+	help
+	  Add a debugfs directory with raw read and write access to the
+	  switch registers, its PHYs and SerDes, and its VLAN and L2 tables.
+	  Only useful for bring-up; say N unless you know you need it.
--- a/drivers/net/dsa/realtek/Makefile
+++ b/drivers/net/dsa/realtek/Makefile
@@ -10,6 +10,7 @@ ifdef CONFIG_NET_DSA_REALTEK_SMI
 realtek_dsa-objs += realtek-smi.o
 endif
 
+obj-$(CONFIG_NET_DSA_REALTEK_RTL8372N)	+= rtl837x/
 obj-$(CONFIG_NET_DSA_REALTEK_RTL8366RB) += rtl8366.o
 rtl8366-objs 				:= rtl8366-core.o rtl8366rb.o
 ifdef CONFIG_NET_DSA_REALTEK_RTL8366RB_LEDS
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl837x/Makefile
@@ -0,0 +1,16 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2025 StarField Xu <air_jinkela@163.com>
+
+ccflags-y += -DRTL837X_PHY_PATCH
+
+obj-$(CONFIG_NET_DSA_REALTEK_RTL8372N) += rtl8372n_dsa.o
+
+rtl8372n_dsa-objs := rtl8372n.o \
+		     rtl837x_common.o \
+		     rtl837x_common_l2.o \
+		     rtl837x_intphy_patch.o \
+		     rtl837x_mdio.o
+rtl8372n_dsa-$(CONFIG_GPIOLIB) += rtl837x_gpio.o
+rtl8372n_dsa-$(CONFIG_NET_DSA_REALTEK_RTL8372N_DEBUGFS) += rtl837x_dbg.o
+
+ccflags-$(CONFIG_NET_DSA_REALTEK_RTL8372N_DEBUGFS) += -DRTL837X_DEBUGFS
