+					  SDS_CTRL02_XSG_AN_1G_Pause_MASK | SDS_CTRL02_XSG_AN_1G_AsymmetricPause_MASK,
+					  0x3
+					);
+		else
+			ret = rtl837x_sds_reg_bits_write(priv, sds_idx, SDS_PAGE_CTRL02, SDS_REG_CTRL02_XSG_AN,
+					  SDS_CTRL02_XSG_AN_1G_Pause_MASK | SDS_CTRL02_XSG_AN_1G_AsymmetricPause_MASK,
+					  0x0
+					);
+		if (ret)
+			return ret;
