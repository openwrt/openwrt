+static int patch_phy_v009_rls_lockmain(struct rtl837x_priv *priv, int phy)
+{
+	int ret = 0, ret1 = 0;
+	u16 tmp16;
+	u16 fw_ver_want = 0x009;
+
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xa4a0, 1<<10, 0);
+	if (ret)
+		return ret;
+
+	// WARNING: This may be wrone
+	// Wait pcs status == 1
+	ret = read_poll_timeout(rtl837x_phy_bits_read_c45, ret1,
+			  (tmp16 == 1) || (ret1),
+			  100, 1000*1000, true,
+			  priv, phy, 31, 0xa600, 0xff, &tmp16);
+	if (ret)
+		return ret;
+	if (ret1)
+		return ret1;
+
+	ret = uc1_sram_write_16b(priv, phy, 0x801e, fw_ver_want);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+int patch_phys_v009(struct rtl837x_priv *priv, u16 phy_mask)
+{
+	int ret;
+
+	for (int p = 0; p < 8; p++) {
+		if (!(phy_mask&BIT(p)))
+			continue;
+
+		ret = patch_phy_v009(priv, p);
+		if (ret)
+			dev_err(priv->dev, "Failed to apply patch_phy_v008 port(%d)\n", p);
+	}
+	dev_info(priv->dev, "Apply patch_phy_v008 Finish\n");
+	return 0;
+}
+
+int patch_phys_v009_rls_lockmain(struct rtl837x_priv *priv, u16 phy_mask)
+{
+	int ret;
+
+	for (int p = 0; p < 8; p++) {
+		if (!(phy_mask&BIT(p)))
+			continue;
+
+		ret = patch_phy_v009_rls_lockmain(priv, p);
+		if (ret)
+			dev_err(priv->dev, "Failed to apply %s port(%d) %d\n", __func__, p, ret);
+	}
+	dev_info(priv->dev, "Apply %s Finish\n", __func__);
+	return 0;
+}
