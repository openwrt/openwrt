+	dev_dbg(priv->dev, "[%s]: fw_ver read: 0x%04X want: 0x%04x\n", __func__, fw_ver, fw_ver_want);
+	if (fw_ver == fw_ver_want)
+		return 0;
+
+	/* ------------------ Do Patch ------------------ */
+	// Patch request
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xb820, 1<<4, 1);
+	if (ret)
+		return ret;
+
+	// wait patch ready
+	ret = read_poll_timeout(rtl837x_phy_bits_read_c45, ret1,
+			  (tmp16 == 1) || (ret1),
+			  50, 250*1000, true,
+			  priv, phy, 31, 0xb800, 1<<6, &tmp16);
+	if (ret)
+		return ret;
+	if (ret1)
+		return ret1;
+
+	// Set Patch key
+	ret = uc1_sram_write_16b(priv, phy, 0x8023, 0x1801);
+	if (ret)
+		return ret;
+	// Patch lock
+	ret = uc1_sram_write_16b(priv, phy, 0xb82e, 1);
+	if (ret)
+		return ret;
+
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xb820, 1<<7, 1);
+	if (ret)
+		return ret;
+
+	// n0_patch_RL6818B_230724 start
+	for (int i = 0; i < sizeof(n0_patch_6818B_230724_patch)/(sizeof(u16)*2); i++) {
+		ret = rtl837x_phy_write_c45(priv, phy, 31,
+			  n0_patch_6818B_230724_patch[i][0],
+			  n0_patch_6818B_230724_patch[i][1]
+			);
+		if (ret)
+			return ret;
+	}
+	// n0_patch_RL6818B_230724 stop
+
+	// n2_patch_6818B_230724 start
+	for (int i = 0; i < sizeof(n2_tp3_patch_6818B_230724_patch)/(sizeof(u16)*2); i++) {
+		ret = rtl837x_phy_write_c45(priv, phy, 31,
+			  n2_tp3_patch_6818B_230724_patch[i][0],
+			  n2_tp3_patch_6818B_230724_patch[i][1]
+			);
+		if (ret)
+			return ret;
+	}
+	// n2_patch_6818B_230724 stop
+
+	// uc2_patch_6818B_230815 start
+	for (int i = 0; i < sizeof(uc2_patch_6818B_230815_patch)/(sizeof(u16)*2); i++) {
+		ret = rtl837x_phy_write_c45(priv, phy, 31,
+			  uc2_patch_6818B_230815_patch[i][0],
+			  uc2_patch_6818B_230815_patch[i][1]
+			);
+		if (ret)
+			return ret;
+	}
+	// uc2_patch_6818B_230815 stop
+
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xb820, 1<<7, 0);
+	if (ret)
+		return ret;
+
+
+	// uc_patch_6818B_20221211 start
+	for (int i = 0; i < sizeof(uc_patch_6818B_20221211_patch)/(sizeof(u16)*2); i++) {
+		ret = rtl837x_phy_write_c45(priv, phy, 31,
+			  uc_patch_6818B_20221211_patch[i][0],
+			  uc_patch_6818B_20221211_patch[i][1]
+			);
+		if (ret)
+			return ret;
+	}
+	// uc_patch_6818B_20221211 stop
+
+
+	/* ------------------ Data RAM Patch ------------------ */
+	// data_ram_patch_6818B_220714 start
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xb896, 0x01, 0); // disable data_mem_auto_inc
+	if (ret)
+		return ret;
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xb892, 0xff00, 0); // set uc2 data ram page
+	if (ret)
+		return ret;
+	for (int i = 0; i < sizeof(data_ram_patch_6818B_220714_patch)/(sizeof(u16)*2); i++) {
+		ret = data_ram_write_8b(priv, phy,
+			  data_ram_patch_6818B_220714_patch[i][0],
+			  data_ram_patch_6818B_220714_patch[i][1]
+			);
+		if (ret)
+			return ret;
+	}
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xb896, 0x01, 1); // enable data_mem_auto_inc
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8217, 0x1e);
+	if (ret)
+		return ret;
+	// data_ram_patch_6818B_220714 stop
+
+	// Looks so weird, Is realtek write wrone?
+	// I'm not sure
+	// just trust realtek( :D
+#if 0
+	// Patch unlock
+	ret = uc1_sram_write_16b(priv, phy, 0xb82e, 0);
+	if (ret)
+		return ret;
+	// Clean Patch key
+	ret = uc1_sram_write_16b(priv, phy, 0x8023, 0);
+	if (ret)
+		return ret;
+#else
+    // Clear patch_key & patch_lock
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xa436, 0xffff, 0);
+	if (ret)
+		return ret;
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xa438, 0xffff, 0);
+	if (ret)
+		return ret;
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xb82e, 1, 0);
+	if (ret)
+		return ret;
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xa436, 0xffff, 0x8023);
+	if (ret)
+		return ret;
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xa438, 0xffff, 0);
+	if (ret)
+		return ret;
+#endif
+
+	// Patch request release
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xb820, 1<<4, 0);
+	if (ret)
+		return ret;
+
+	// Wait patch ready==0
+	ret = read_poll_timeout(rtl837x_phy_bits_read_c45, ret1,
+			  (tmp16 == 0) || (ret1),
+			  50, 250*1000, true,
+			  priv, phy, 31, 0xb800, 1<<6, &tmp16);
+	if (ret)
+		return ret;
+	if (ret1)
+		return ret1;
+
+    // Lock Main
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xa4a0, 1<<10, 1);
+	if (ret)
+		return ret;
+
+	// Wait pcs status == 1
+	ret = read_poll_timeout(rtl837x_phy_bits_read_c45, ret1,
+			  (tmp16 == 1) || (ret1),
+			  50, 250*1000, true,
+			  priv, phy, 31, 0xa600, 0xff, &tmp16);
+	if (ret)
+		return ret;
+	if (ret1)
+		return ret1;
+
+	// alg_tune_2p5G_6818B_220701 start
+	ret = uc1_sram_write_8b(priv, phy, 0x8017, 0x7);
+	if (ret)
+		return ret;
+	for (int i = 0; i < sizeof(alg_tune_2p5G_6818B_220701_patch)/(sizeof(u16)*2); i++) {
+		ret = uc2_sram_write_8b(priv, phy,
+			  alg_tune_2p5G_6818B_220701_patch[i][0],
+			  alg_tune_2p5G_6818B_220701_patch[i][1]
+			);
+		if (ret)
+			return ret;
+	}
+	// alg_tune_2p5G_6818B_220701 stop
+
+	// alg_tune_giga_6818B_220617 start
+	for (int i = 0; i < sizeof(alg_tune_giga_6818B_220617_patch)/(sizeof(u16)*2); i++) {
+		ret = uc1_sram_write_8b(priv, phy,
+			  alg_tune_giga_6818B_220617_patch[i][0],
+			  alg_tune_giga_6818B_220617_patch[i][1]
+			);
+		if (ret)
+			return ret;
+	}
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xa87e, 0x1f<<8, 0x6);
+	if (ret)
+		return ret;
+	// alg_tune_giga_6818B_220617 stop
+
+	// alg_tune_fnet_6818_220628 start
+	for (int i = 0; i < sizeof(alg_tune_fnet_6818_220628_patch)/(sizeof(u16)*2); i++) {
+		ret = uc1_sram_write_8b(priv, phy,
+			  alg_tune_fnet_6818_220628_patch[i][0],
+			  alg_tune_fnet_6818_220628_patch[i][1]
+			);
+		if (ret)
+			return ret;
+	}
+	// alg_tune_fnet_6818_220628 stop
+
+	// RTCT patch
+	// rtct_para_6818B_221211 start
+	for (int i = 0; i < sizeof(rtct_para_6818B_221211_patch)/(sizeof(u16)*4); i++) {
+		ret = rtl837x_phy_bits_write_c45(priv, phy, 31,
+				  rtct_para_6818B_221211_patch[i][0],
+				  __GENMASK(rtct_para_6818B_221211_patch[i][1], rtct_para_6818B_221211_patch[i][2]),
+				  rtct_para_6818B_221211_patch[i][3]);
+		if (ret)
+			return ret;
+	}
+	// rtct_para_6818B_221211 end
+
+
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xa86a, 1, 0);
+	if (ret)
+		return ret;
+	ret = uc1_sram_write_8b(priv, phy, 0x8ffb, 0x1);
+	if (ret)
+		return ret;
+	ret = uc1_sram_write_8b(priv, phy, 0x80dc, 0xa);
+	if (ret)
+		return ret;
+	ret = uc1_sram_write_8b(priv, phy, 0x8378, 0x22);
+	if (ret)
+		return ret;
+
+	ret = uc2_sram_write_8b(priv, phy, 0x8384, 0x04);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fd4, 0x00);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fd5, 0x00);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fd6, 0x0c);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fd7, 0x80);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fd8, 0x0a);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fd9, 0x19);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fda, 0x19);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fdb, 0x00);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fdc, 0x00);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fdd, 0x00);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fde, 0x00);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fdf, 0x20);
+	if (ret)
+		return ret;
+	ret = uc2_sram_write_8b(priv, phy, 0x8fe0, 0x0c);
+	if (ret)
+		return ret;
+
+	// afe_patch_6818B_220607 start
+	//   #cen port 在baseaddr+1 port: e.x. p1/p5
+	//   #adjust LDO to improve TM2 jitter
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xbf84, 0x7<<0, 0x4);
+	if (ret)
+		return ret;
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xbf8c, 0x1f<<6, 0x0);
+	if (ret)
+		return ret;
+	// afe_patch_6818B_220607 stop
+
+	ret = rtl837x_phy_write_c45(priv, phy, 31, 0xa5d0, 0);
+	if (ret)
+		return ret;
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xa428, 1<<9, 0);
+	if (ret)
+		return ret;
+	ret = rtl837x_phy_bits_write_c45(priv, phy, 31, 0xa47e, 3<<6, 1);
+	if (ret)
+		return ret;
+
+	return 0;
+}
