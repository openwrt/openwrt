+
+#define RTL837X_L2_UC_D1_SPORT_LO_MSK	GENMASK(31, 30)
+#define  RTL837X_L2_UC_D2_SPORT_HI_MSK	GENMASK(1, 0)
+#define  RTL837X_L2_UC_SPORT_GET(_D1, _D2) \
+			((FIELD_GET(RTL837X_L2_UC_D1_SPORT_LO_MSK, _D1))| \
