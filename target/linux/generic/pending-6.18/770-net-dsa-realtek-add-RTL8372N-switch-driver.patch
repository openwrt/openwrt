+static int rtl8372n_mdio_phy_write_c22(struct mii_bus *bus, int addr, int regnum, u16 val)
+{
+	struct rtl837x_priv *priv = bus->priv;
+
+	return priv->ops->phy_write_c22(priv, addr, regnum, val);
+}
