+int __deprecated rtl837x_serdes_set_mode(struct rtl837x_priv *priv, u8 sds_idx, enum rtk_sds_mode mode)
+{
+	int ret;
+
+	switch (mode) {
+	case SERDES_8221B:
+		// TODO (I think this can be managered by linux phy driver)
+		return -EOPNOTSUPP;
+	case SERDES_OFF:
+		ret = _rtl837x_serdes_off(priv, false, sds_idx);
