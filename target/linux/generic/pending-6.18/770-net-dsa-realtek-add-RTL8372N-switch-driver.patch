+int patch_phys_v008(struct rtl837x_priv *priv, u16 phy_mask)
+{
+	int ret;
+
+	for (int p = 0; p < 8; p++) {
+		if (!(phy_mask&BIT(p)))
+			continue;
+
+		ret = patch_phy_v008(priv, p);
+		if (ret)
+			dev_err(priv->dev, "Failed to apply patch_phy_v008 port(%d)\n", p);
+	}
+	dev_info(priv->dev, "Apply patch_phy_v008 Finish\n");
+	return 0;
+}
