From 037f9ee5df932bafdab8d69d1601d838922a78df Mon Sep 17 00:00:00 2001
From: Devon Openheim <devopenm@proton.me>
Date: Mon, 17 Aug 2026 10:38:57 +0100
Subject: [PATCH] net: ethernet: add ASR1802S EMAC driver

The ASR1802S/ASR1826s LTE gateway SoC integrates an Ethernet MAC
(asr,asr-eth-v2). The register map, MDIO block and 16-byte descriptor
format were recovered by reverse engineering the vendor 3.10.33 kernel
shipped on Ooredoo R291 v2 gateways; no public hardware manual exists.

The MAC drives a full MDIO bus (used by the on-board 5-port switch)
while the network interface itself typically runs a fixed link
(1000/full RGMII), as configured in device tree.

Signed-off-by: Devon Openheim <devopenm@proton.me>
---
 .../bindings/net/asr,asr-eth-v2.yaml          |  109 ++
 drivers/net/ethernet/Kconfig                  |    1 +
 drivers/net/ethernet/Makefile                 |    1 +
 drivers/net/ethernet/asr/Kconfig              |   33 +
 drivers/net/ethernet/asr/Makefile             |    6 +
 drivers/net/ethernet/asr/asr-emac.c           | 1045 +++++++++++++++++
 6 files changed, 1195 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/net/asr,asr-eth-v2.yaml
 create mode 100644 drivers/net/ethernet/asr/Kconfig
 create mode 100644 drivers/net/ethernet/asr/Makefile
 create mode 100644 drivers/net/ethernet/asr/asr-emac.c

--- /dev/null
+++ b/Documentation/devicetree/bindings/net/asr,asr-eth-v2.yaml
@@ -0,0 +1,109 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/asr,asr-eth-v2.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: ASR1802S Ethernet MAC
+
+maintainers:
+  - Devon Openheim <devopenm@proton.me>
+
+description: |
+  Ethernet MAC found in ASR1802S/ASR1826s LTE gateway SoCs. The MAC
+  exposes an internal MDIO bus which is typically used to attach an
+  on-board switch; the network interface itself usually runs a fixed
+  link (1000/full RGMII).
+
+  The register map and descriptor format were recovered by reverse
+  engineering the vendor 3.10.33 kernel shipped on Ooredoo R291 v2
+  gateways; no public hardware manual exists.
+
+allOf:
+  - $ref: ethernet-controller.yaml#
+
+properties:
+  compatible:
+    const: asr,asr-eth-v2
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    minItems: 1
+    maxItems: 2
+    description: |
+      First interrupt is the MAC RX/TX interrupt; the optional second
+      interrupt is the PHY/switch wakeup interrupt.
+
+  asr,mdio-clk-div:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: MDIO clock divider value.
+    default: 0xfe
+
+  asr,reset-delays-us:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    items:
+      - description: delay before asserting the MAC soft reset
+      - description: delay while the MAC soft reset is asserted
+      - description: delay after deasserting the MAC soft reset
+    maxItems: 3
+    description: Delays in microseconds used during the MAC soft reset sequence.
+
+  asr,3v-enable:
+    type: boolean
+    description: |
+      Set the EMAC IO block to 3.3V (via the SoC AIB register). When
+      absent the IO block is left in its boot default state.
+
+  asr,clk-tuning-enable:
+    type: boolean
+    description: |
+      Enable RGMII clock tuning. The tx/rx clock delay values must be
+      supplied via asr,tx-clk-config and asr,rx-clk-config. (Parsed by
+      the driver; the APMU clock-phase programming is not yet
+      implemented.)
+
+  asr,tx-clk-config:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: TX clock tuning value (vendor default 0x203).
+
+  asr,rx-clk-config:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: RX clock tuning value (vendor default 0x803).
+
+  reset-gpios:
+    maxItems: 1
+    description: GPIO used to reset the MDIO bus devices (if any).
+
+  mdio:
+    $ref: mdio.yaml#
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    eth0: ethernet@1850000 {
+      compatible = "asr,asr-eth-v2";
+      reg = <0x1850000 0x200>;
+      interrupts = <10 11>;
+      asr,mdio-clk-div = <0xfe>;
+      asr,reset-delays-us = <0 100000 500000>;
+      fixed-link {
+        speed = <1000>;
+        full-duplex;
+      };
+      mdio {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        phy0: ethernet-phy@0 {
+          reg = <0>;
+        };
+      };
+    };
\ No newline at end of file
