@@ -11,6 +11,7 @@ obj-$(CONFIG_GRETH) += aeroflex/
 obj-$(CONFIG_NET_VENDOR_ADI) += adi/
 obj-$(CONFIG_NET_VENDOR_AGERE) += agere/
 obj-$(CONFIG_NET_VENDOR_AIROHA) += airoha/
+obj-$(CONFIG_NET_VENDOR_ASR) += asr/
 obj-$(CONFIG_NET_VENDOR_ALACRITECH) += alacritech/
 obj-$(CONFIG_NET_VENDOR_ALLWINNER) += allwinner/
 obj-$(CONFIG_NET_VENDOR_ALTEON) += alteon/
--- /dev/null
+++ b/drivers/net/ethernet/asr/Kconfig
@@ -0,0 +1,33 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# ASR Microelectronics ethernet device configuration
+#
+
+config NET_VENDOR_ASR
+	bool "ASR Microelectronics devices"
+	depends on ARCH_ASR || COMPILE_TEST
+	help
+	  If you have a network (Ethernet) card belonging to this class, say Y.
+
+	  If unsure, say N.
+
+if NET_VENDOR_ASR
+
+config ASR_EMAC
+	tristate "ASR1802S Ethernet MAC support"
+	depends on HAS_IOMEM
+	select PHYLIB
+	select FIXED_PHY
+	select OF_MDIO
+	help
+	  This driver supports the Ethernet MAC (asr,asr-eth-v2) found in
+	  ASR1802S/ASR1826S LTE gateway SoCs.
+
+	  The MAC exposes an internal MDIO bus which is typically used to
+	  attach an on-board switch; the network interface itself usually
+	  runs a fixed link (1000/full RGMII).
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called asr-emac.
+
+endif # NET_VENDOR_ASR
--- /dev/null
+++ b/drivers/net/ethernet/asr/Makefile
@@ -0,0 +1,6 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Makefile for the ASR Microelectronics ethernet device drivers.
+#
+
+obj-$(CONFIG_ASR_EMAC) += asr-emac.o
--- /dev/null
+++ b/drivers/net/ethernet/asr/asr-emac.c
@@ -0,0 +1,1045 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ASR1802S Ethernet MAC driver ("asr,asr-eth-v2")
+ *
+ * The register map, MDIO block and descriptor format of this MAC were
+ * recovered by reverse engineering the vendor 3.10.33 kernel shipped on
+ * Ooredoo R291 v2 (ASR 1826s) gateways; no public hardware manual exists.
+ *
+ * The MAC exposes a full MDIO bus (used by the on-board 5-port switch)
+ * while the network interface itself typically runs a fixed-link, e.g.
+ * 1000/full RGMII, as configured in device tree.
+ */
+
+#include <linux/clk.h>
+#include <linux/dma-mapping.h>
+#include <linux/etherdevice.h>
+#include <linux/gpio/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mii.h>
+#include <linux/netdevice.h>
+#include <linux/of_mdio.h>
+#include <linux/of_net.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/platform_device.h>
+#include <linux/skbuff.h>
+#include <linux/spinlock.h>
+
+#define DRV_NAME		"asr-emac"
+#define DRV_VERSION		"0.1"
+
+#define EMAC_CTRL		0x00
+#define EMAC_CTRL2		0x04
+#define EMAC_IRQ_STATUS		0x08
+#define EMAC_TXRX_ENABLE	0x0c
+#define EMAC_RX_CFG		0x10
+#define EMAC_TX_KICK		0x14
+#define EMAC_DMA_CFG		0x20
+#define EMAC_MAC_CFG		0x100
+#define EMAC_MAC_CFG2		0x104
+#define EMAC_MAC_CFG3		0x108
+#define EMAC_MAC_CFG4		0x118
+#define EMAC_MDIO_CLK_DIV	0x11c
+#define EMAC_MAC_ADDR_LOW	0x120
+#define EMAC_MAC_ADDR_MID	0x124
+#define EMAC_MAC_ADDR_HIGH	0x128
+#define EMAC_MDIO_CMD		0x1a0
+#define EMAC_MDIO_DATA		0x1a4
+#define EMAC_DLINE_TX		0x1c0
+#define EMAC_SPEED_CFG		0x1c4
+#define EMAC_DLINE_RX		0x1c8
+#define EMAC_MISC		0x1e4
+
+#define EMAC_CTRL_RESET		0x70020
+#define EMAC_IRQ_ALL		0xff
+#define EMAC_ENABLE_TXRX		0xd5
+#define EMAC_ENABLE_BITS		0x11
+
+#define EMAC_MAC_CFG_SPEED_100M		BIT(0)
+#define EMAC_MAC_CFG_SPEED_1000M	BIT(1)
+#define EMAC_MAC_CFG_FULL_DUPLEX	BIT(2)
+
+#define EMAC_MDIO_CMD_START		BIT(15)
+#define EMAC_MDIO_CMD_READ		BIT(10)
+#define EMAC_MDIO_CMD_PHY(phy)		((phy) << 5)
+#define EMAC_MDIO_CMD_REG(reg)		((reg) & 0x1f)
+
+#define EMAC_SPEED_1000M		0x400
+#define EMAC_SPEED_100M			0x100
+#define EMAC_SPEED_DEFAULT		0x5ee
+
+#define EMAC_DLINE_DEFAULT		0x3f8
+#define EMAC_DLINE_RX_DEFAULT		0xc
+
+#define ASR_EMAC_DESC_SIZE		16
+#define ASR_EMAC_DESC_OWN		BIT(31)
+#define ASR_EMAC_DESC_LEN_MASK		0x3fff
+#define ASR_EMAC_DESC_RX_STATUS_MASK	GENMASK(28, 14)
+#define ASR_EMAC_DESC_RX_ERR_ODD	BIT(15)
+#define ASR_EMAC_DESC_RX_ERR_MASK	0xc00000
+#define ASR_EMAC_DESC_RX_CSUM_MASK	0x3000000
+#define ASR_EMAC_DESC_FLAG_WRAP		BIT(2)
+#define ASR_EMAC_DESC_FLAG_FIRST	BIT(5)
+#define ASR_EMAC_DESC_FLAG_LAST		BIT(6)
+
+#define ASR_EMAC_TX_DESC		64
+#define ASR_EMAC_RX_DESC		64
+#define ASR_EMAC_RX_BUF_SIZE		0x800
+#define ASR_EMAC_RX_HEADROOM		0x42
+#define ASR_EMAC_MAX_TX_LEN		0xfff
+
+/* APMU unlock + EMAC IO level (AIB) registers, only touched when
+ * "asr,3v-enable" is present in device tree.
+ */
+#define ASR_APMU_UNLOCK_BASE		0xd4015050
+#define ASR_EMAC_IO_CTRL_BASE		0xd401e804
+#define ASR_APMU_UNLOCK_MAGIC		0xeb10
+#define ASR_APMU_LOCK_MAGIC		0xbaba
+#define ASR_EMAC_IO_3V3			BIT(2)
+
+struct asr_emac_desc {
+	u32 status;	/* bit31 OWN; RX: bits0-13 len, bits14-28 status */
+	u16 len;	/* bits 0-11 */
+	u16 flags;	/* bit2 wrap, bit5 first, bit6 last */
+	u32 dma_lo;
+	u32 dma_hi;
+};
+
+struct asr_emac_priv {
+	struct net_device *ndev;
+	struct device *dev;
+	void __iomem *base;
+	struct clk *clk;
+	struct napi_struct napi;
+	struct mii_bus *bus;
+	struct phy_device *phy;
+	struct pinctrl *pinctrl;
+	struct pinctrl_state *rgmii_pins;
+	spinlock_t tx_lock;
+	unsigned int msg_enable;
+
+	u32 mdio_clk_div;
+	phy_interface_t phy_iface;
+	u32 reset_delays[3];
+	int irq;
+	int wakeup_irq;
+	struct gpio_desc *mdio_reset_gpio;
+	bool link;
+
+	struct asr_emac_desc *tx_ring;
+	dma_addr_t tx_ring_dma;
+	struct sk_buff **tx_skb;
+	unsigned int tx_head;
+	unsigned int tx_tail;
+
+	struct asr_emac_desc *rx_ring;
+	dma_addr_t rx_ring_dma;
+	struct sk_buff **rx_skb;
+	unsigned int rx_idx;
+};
+
+static inline void asr_emac_io_sync(void __iomem *addr)
+{
+	dsb(sy);
+}
+
+static void asr_emac_writel(struct asr_emac_priv *priv, u32 val, u32 off)
+{
+	writel(val, priv->base + off);
+	asr_emac_io_sync(priv->base + off);
+}
+
+static u32 asr_emac_readl(struct asr_emac_priv *priv, u32 off)
+{
+	u32 val;
+
+	val = readl(priv->base + off);
+	asr_emac_io_sync(priv->base + off);
+	return val;
+}
+
+static void asr_emac_set_bits(struct asr_emac_priv *priv, u32 off, u32 mask)
+{
+	asr_emac_writel(priv, asr_emac_readl(priv, off) | mask, off);
+}
+
+static void asr_emac_clear_bits(struct asr_emac_priv *priv, u32 off, u32 mask)
+{
+	asr_emac_writel(priv, asr_emac_readl(priv, off) & ~mask, off);
+}
+
+static inline dma_addr_t asr_emac_desc_dma(const struct asr_emac_desc *desc)
+{
+	return (dma_addr_t)(desc->dma_lo | ((u64)desc->dma_hi << 32));
+}
+
+static int asr_emac_mdio_read(struct mii_bus *bus, int phy_id, int regnum)
+{
+	struct asr_emac_priv *priv = bus->priv;
+	u32 cmd;
+	u32 val;
+	int ret;
+
+	asr_emac_writel(priv, 0, EMAC_MDIO_DATA);
+	cmd = EMAC_MDIO_CMD_START | EMAC_MDIO_CMD_READ |
+	      EMAC_MDIO_CMD_PHY(phy_id) | EMAC_MDIO_CMD_REG(regnum);
+	asr_emac_writel(priv, cmd, EMAC_MDIO_CMD);
+
+	ret = readl_poll_timeout(priv->base + EMAC_MDIO_CMD, val,
+				 !(val & EMAC_MDIO_CMD_START), 10, 10000);
+	if (ret)
+		return ret;
+
+	return asr_emac_readl(priv, EMAC_MDIO_DATA) & 0xffff;
+}
+
+static int asr_emac_mdio_write(struct mii_bus *bus, int phy_id, int regnum,
+			       u16 value)
+{
+	struct asr_emac_priv *priv = bus->priv;
+	u32 cmd;
+	u32 val;
+	int ret;
+
+	asr_emac_writel(priv, value, EMAC_MDIO_DATA);
+	cmd = EMAC_MDIO_CMD_START | EMAC_MDIO_CMD_PHY(phy_id) |
+	      EMAC_MDIO_CMD_REG(regnum);
+	asr_emac_writel(priv, cmd, EMAC_MDIO_CMD);
+
+	ret = readl_poll_timeout(priv->base + EMAC_MDIO_CMD, val,
+				 !(val & EMAC_MDIO_CMD_START), 10, 10000);
+	return ret;
+}
+
+static void asr_emac_reset(struct asr_emac_priv *priv)
+{
+	asr_emac_writel(priv, 1, EMAC_CTRL);
+	usleep_range(priv->reset_delays[1], priv->reset_delays[1] + 1000);
+	asr_emac_writel(priv, 0, EMAC_CTRL);
+	usleep_range(priv->reset_delays[2], priv->reset_delays[2] + 1000);
+	asr_emac_writel(priv, EMAC_CTRL_RESET, EMAC_CTRL);
+}
+
+static int asr_emac_mdio_reset(struct mii_bus *bus)
+{
+	struct asr_emac_priv *priv = bus->priv;
+
+	if (!priv->mdio_reset_gpio)
+		return 0;
+
+	gpiod_set_value_cansleep(priv->mdio_reset_gpio, 1);
+	fsleep(10);
+	gpiod_set_value_cansleep(priv->mdio_reset_gpio, 0);
+	return 0;
+}
+
+static int asr_emac_mdio_init(struct asr_emac_priv *priv)
+{
+	struct device *dev = priv->dev;
+	struct device_node *np = dev->of_node;
+	struct device_node *child;
+	struct gpio_desc *reset_gpio;
+	int ret;
+
+	priv->bus = mdiobus_alloc_size(0);
+	if (!priv->bus)
+		return -ENOMEM;
+
+	priv->bus->name = "asr-emac mii";
+	priv->bus->priv = priv;
+	priv->bus->read = asr_emac_mdio_read;
+	priv->bus->write = asr_emac_mdio_write;
+	priv->bus->parent = dev;
+	strscpy(priv->bus->id, "asr-emac", MII_BUS_ID_SIZE);
+
+	reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(reset_gpio)) {
+		ret = PTR_ERR(reset_gpio);
+		goto err_free;
+	}
+	if (reset_gpio) {
+		priv->bus->reset = asr_emac_mdio_reset;
+		priv->mdio_reset_gpio = reset_gpio;
+		gpiod_set_consumer_name(reset_gpio, DRV_NAME);
+	}
+
+	child = of_get_child_by_name(np, "mdio");
+	if (!child) {
+		dev_err(dev, "no mdio node\n");
+		ret = -ENODEV;
+		goto err_free;
+	}
+
+	ret = of_mdiobus_register(priv->bus, child);
+	of_node_put(child);
+	if (ret)
+		goto err_free;
+
+	return 0;
+
+err_free:
+	mdiobus_free(priv->bus);
+	priv->bus = NULL;
+	return ret;
+}
+
+static void asr_emac_mdio_exit(struct asr_emac_priv *priv)
+{
+	if (!priv->bus)
+		return;
+
+	mdiobus_unregister(priv->bus);
+	mdiobus_free(priv->bus);
+	priv->bus = NULL;
+}
+
+static void asr_emac_set_mac_addr_regs(struct asr_emac_priv *priv,
+				       const u8 *addr)
+{
+	asr_emac_writel(priv, addr[0] | (addr[1] << 8), EMAC_MAC_ADDR_LOW);
+	asr_emac_writel(priv, addr[2] | (addr[3] << 8), EMAC_MAC_ADDR_MID);
+	asr_emac_writel(priv, addr[4] | (addr[5] << 8), EMAC_MAC_ADDR_HIGH);
+}
+
+static void asr_emac_set_interface(struct asr_emac_priv *priv,
+				   phy_interface_t iface)
+{
+	if (priv->rgmii_pins && (iface == PHY_INTERFACE_MODE_RGMII ||
+				 iface == PHY_INTERFACE_MODE_RGMII_ID ||
+				 iface == PHY_INTERFACE_MODE_RGMII_RXID ||
+				 iface == PHY_INTERFACE_MODE_RGMII_TXID))
+		pinctrl_select_state(priv->pinctrl, priv->rgmii_pins);
+}
+
+static void asr_emac_adjust_link(struct net_device *ndev)
+{
+	struct asr_emac_priv *priv = netdev_priv(ndev);
+	struct phy_device *phy = ndev->phydev;
+	u32 ctrl;
+
+	if (!phy)
+		return;
+
+	ctrl = asr_emac_readl(priv, EMAC_MAC_CFG);
+	ctrl &= ~(EMAC_MAC_CFG_SPEED_100M | EMAC_MAC_CFG_SPEED_1000M |
+		  EMAC_MAC_CFG_FULL_DUPLEX);
+
+	if (phy->speed == SPEED_1000)
+		ctrl |= EMAC_MAC_CFG_SPEED_1000M;
+	else if (phy->speed == SPEED_100)
+		ctrl |= EMAC_MAC_CFG_SPEED_100M;
+
+	if (phy->duplex == DUPLEX_FULL)
+		ctrl |= EMAC_MAC_CFG_FULL_DUPLEX;
+
+	asr_emac_writel(priv, ctrl, EMAC_MAC_CFG);
+
+	switch (phy->speed) {
+	case SPEED_1000:
+		asr_emac_writel(priv, EMAC_SPEED_1000M, EMAC_SPEED_CFG);
+		break;
+	case SPEED_100:
+		asr_emac_writel(priv, EMAC_SPEED_100M, EMAC_SPEED_CFG);
+		break;
+	default:
+		asr_emac_writel(priv, EMAC_SPEED_DEFAULT, EMAC_SPEED_CFG);
+		break;
+	}
+
+	if (phy->link && !priv->link)
+		netif_carrier_on(ndev);
+	else if (!phy->link && priv->link)
+		netif_carrier_off(ndev);
+
+	priv->link = phy->link;
+
+	phy_print_status(phy);
+}
+
+static void asr_emac_tx_kick(struct asr_emac_priv *priv)
+{
+	asr_emac_writel(priv, 0xff, EMAC_TX_KICK);
+}
+
+static netdev_tx_t asr_emac_start_xmit(struct sk_buff *skb,
+				       struct net_device *ndev)
+{
+	struct asr_emac_priv *priv = netdev_priv(ndev);
+	struct asr_emac_desc *desc;
+	dma_addr_t dma;
+	unsigned long flags;
+	unsigned int idx;
+
+	if (skb->len > ASR_EMAC_MAX_TX_LEN) {
+		ndev->stats.tx_dropped++;
+		dev_kfree_skb_any(skb);
+		return NETDEV_TX_OK;
+	}
+
+	spin_lock_irqsave(&priv->tx_lock, flags);
+
+	if (priv->tx_skb[priv->tx_head]) {
+		netif_stop_queue(ndev);
+		spin_unlock_irqrestore(&priv->tx_lock, flags);
+		return NETDEV_TX_BUSY;
+	}
+
+	dma = dma_map_single(priv->dev, skb->data, skb->len, DMA_TO_DEVICE);
+	if (dma_mapping_error(priv->dev, dma)) {
+		ndev->stats.tx_dropped++;
+		spin_unlock_irqrestore(&priv->tx_lock, flags);
+		dev_kfree_skb_any(skb);
+		return NETDEV_TX_OK;
+	}
+
+	idx = priv->tx_head;
+	desc = &priv->tx_ring[idx];
+	priv->tx_skb[idx] = skb;
+	desc->dma_lo = lower_32_bits(dma);
+	desc->dma_hi = upper_32_bits(dma);
+	desc->len = skb->len & 0xfff;
+	desc->flags = ASR_EMAC_DESC_FLAG_FIRST | ASR_EMAC_DESC_FLAG_LAST;
+
+	if (++idx == ASR_EMAC_TX_DESC) {
+		desc->flags |= ASR_EMAC_DESC_FLAG_WRAP;
+		idx = 0;
+	}
+	priv->tx_head = idx;
+
+	dma_wmb();
+	desc->status = ASR_EMAC_DESC_OWN;
+	asr_emac_tx_kick(priv);
+
+	ndev->stats.tx_bytes += skb->len;
+	ndev->stats.tx_packets++;
+
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+
+	return NETDEV_TX_OK;
+}
+
+static void asr_emac_tx_complete(struct asr_emac_priv *priv)
+{
+	struct asr_emac_desc *desc;
+	struct sk_buff *skb;
+	unsigned long flags;
+
+	spin_lock_irqsave(&priv->tx_lock, flags);
+
+	while (priv->tx_skb[priv->tx_tail]) {
+		desc = &priv->tx_ring[priv->tx_tail];
+		if (desc->status & ASR_EMAC_DESC_OWN)
+			break;
+
+		skb = priv->tx_skb[priv->tx_tail];
+		dma_unmap_single(priv->dev,
+				 asr_emac_desc_dma(desc),
+				 skb->len, DMA_TO_DEVICE);
+		priv->tx_skb[priv->tx_tail] = NULL;
+		dev_kfree_skb_any(skb);
+
+		if (++priv->tx_tail == ASR_EMAC_TX_DESC)
+			priv->tx_tail = 0;
+	}
+
+	if (netif_queue_stopped(priv->ndev) &&
+	    !priv->tx_skb[priv->tx_head])
+		netif_wake_queue(priv->ndev);
+
+	spin_unlock_irqrestore(&priv->tx_lock, flags);
+}
+
+static int asr_emac_rx_refill(struct asr_emac_priv *priv, unsigned int idx)
+{
+	struct asr_emac_desc *desc = &priv->rx_ring[idx];
+	struct sk_buff *skb;
+	dma_addr_t dma;
+
+	skb = netdev_alloc_skb(priv->ndev,
+			       ASR_EMAC_RX_BUF_SIZE + ASR_EMAC_RX_HEADROOM);
+	if (!skb)
+		return -ENOMEM;
+
+	skb_reserve(skb, ASR_EMAC_RX_HEADROOM);
+
+	dma = dma_map_single(priv->dev, skb->data, ASR_EMAC_RX_BUF_SIZE,
+			     DMA_FROM_DEVICE);
+	if (dma_mapping_error(priv->dev, dma)) {
+		dev_kfree_skb_any(skb);
+		return -ENOMEM;
+	}
+
+	priv->rx_skb[idx] = skb;
+	desc->dma_lo = lower_32_bits(dma);
+	desc->dma_hi = upper_32_bits(dma);
+	desc->flags = (idx == ASR_EMAC_RX_DESC - 1) ? ASR_EMAC_DESC_FLAG_WRAP : 0;
+
+	dma_wmb();
+	desc->status = ASR_EMAC_DESC_OWN;
+
+	return 0;
+}
+
+static int asr_emac_rx(struct asr_emac_priv *priv, int budget)
+{
+	struct net_device *ndev = priv->ndev;
+	struct asr_emac_desc *desc;
+	struct sk_buff *skb;
+	u32 status;
+	u16 len;
+	int received = 0;
+
+	while (received < budget) {
+		desc = &priv->rx_ring[priv->rx_idx];
+		if (desc->status & ASR_EMAC_DESC_OWN)
+			break;
+
+		skb = priv->rx_skb[priv->rx_idx];
+		if (!skb) {
+			if (asr_emac_rx_refill(priv, priv->rx_idx))
+				break;
+			if (++priv->rx_idx == ASR_EMAC_RX_DESC)
+				priv->rx_idx = 0;
+			continue;
+		}
+
+		len = desc->status & ASR_EMAC_DESC_LEN_MASK;
+		status = (desc->status >> 14) & 0x7fff;
+
+		if (status & (ASR_EMAC_DESC_RX_ERR_ODD |
+			      ASR_EMAC_DESC_RX_ERR_MASK |
+			      ASR_EMAC_DESC_RX_CSUM_MASK)) {
+			ndev->stats.rx_errors++;
+			priv->rx_skb[priv->rx_idx] = NULL;
+			dma_unmap_single(priv->dev,
+					 asr_emac_desc_dma(desc),
+					 ASR_EMAC_RX_BUF_SIZE, DMA_FROM_DEVICE);
+			dev_kfree_skb_any(skb);
+			if (asr_emac_rx_refill(priv, priv->rx_idx))
+				break;
+			if (++priv->rx_idx == ASR_EMAC_RX_DESC)
+				priv->rx_idx = 0;
+			continue;
+		}
+
+		if (len > ASR_EMAC_RX_BUF_SIZE - 5) {
+			ndev->stats.rx_errors++;
+			ndev->stats.rx_dropped++;
+			priv->rx_skb[priv->rx_idx] = NULL;
+			dma_unmap_single(priv->dev,
+					 asr_emac_desc_dma(desc),
+					 ASR_EMAC_RX_BUF_SIZE, DMA_FROM_DEVICE);
+			dev_kfree_skb_any(skb);
+			if (asr_emac_rx_refill(priv, priv->rx_idx))
+				break;
+			if (++priv->rx_idx == ASR_EMAC_RX_DESC)
+				priv->rx_idx = 0;
+			continue;
+		}
+
+		dma_unmap_single(priv->dev,
+				 asr_emac_desc_dma(desc),
+				 ASR_EMAC_RX_BUF_SIZE, DMA_FROM_DEVICE);
+		priv->rx_skb[priv->rx_idx] = NULL;
+		skb_put(skb, len - 4);
+		skb->protocol = eth_type_trans(skb, ndev);
+		skb->ip_summed = CHECKSUM_NONE;
+
+		netif_receive_skb(skb);
+		ndev->stats.rx_packets++;
+		ndev->stats.rx_bytes += len - 4;
+
+		if (asr_emac_rx_refill(priv, priv->rx_idx))
+			break;
+		if (++priv->rx_idx == ASR_EMAC_RX_DESC)
+			priv->rx_idx = 0;
+		received++;
+	}
+
+	return received;
+}
+
+static int asr_emac_poll(struct napi_struct *napi, int budget)
+{
+	struct asr_emac_priv *priv =
+		container_of(napi, struct asr_emac_priv, napi);
+	int received;
+
+	asr_emac_tx_complete(priv);
+
+	received = asr_emac_rx(priv, budget);
+
+	if (received < budget) {
+		napi_complete_done(napi, received);
+		asr_emac_set_bits(priv, EMAC_TXRX_ENABLE, EMAC_ENABLE_BITS);
+	}
+
+	return received;
+}
+
+static irqreturn_t asr_emac_irq(int irq, void *data)
+{
+	struct net_device *ndev = data;
+	struct asr_emac_priv *priv = netdev_priv(ndev);
+	u32 status;
+
+	status = asr_emac_readl(priv, EMAC_IRQ_STATUS);
+	if (!status)
+		return IRQ_NONE;
+
+	asr_emac_writel(priv, status, EMAC_IRQ_STATUS);
+
+	if (napi_schedule_prep(&priv->napi))
+		__napi_schedule(&priv->napi);
+
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t asr_emac_wakeup_irq(int irq, void *data)
+{
+	struct net_device *ndev = data;
+	struct asr_emac_priv *priv = netdev_priv(ndev);
+
+	if (napi_schedule_prep(&priv->napi))
+		__napi_schedule(&priv->napi);
+
+	return IRQ_HANDLED;
+}
+
+static int asr_emac_open(struct net_device *ndev)
+{
+	struct asr_emac_priv *priv = netdev_priv(ndev);
+	int ret;
+	int i;
+
+	asr_emac_reset(priv);
+
+	asr_emac_writel(priv, 0, EMAC_CTRL2);
+	asr_emac_writel(priv, 0x18, EMAC_MAC_CFG);
+	asr_emac_writel(priv, 0, EMAC_MAC_CFG2);
+	asr_emac_writel(priv, 0, EMAC_MAC_CFG3);
+	asr_emac_writel(priv, 0x100, EMAC_MAC_CFG4);
+	asr_emac_writel(priv, priv->mdio_clk_div, EMAC_MDIO_CLK_DIV);
+	asr_emac_writel(priv, EMAC_DLINE_DEFAULT, EMAC_DLINE_TX);
+	asr_emac_writel(priv, EMAC_SPEED_DEFAULT, EMAC_SPEED_CFG);
+	asr_emac_writel(priv, EMAC_DLINE_RX_DEFAULT, EMAC_DLINE_RX);
+	asr_emac_writel(priv, 0, EMAC_MISC);
+	asr_emac_set_mac_addr_regs(priv, ndev->dev_addr);
+
+	priv->tx_ring = dma_alloc_coherent(priv->dev,
+					   ASR_EMAC_TX_DESC * ASR_EMAC_DESC_SIZE,
+					   &priv->tx_ring_dma, GFP_KERNEL);
+	if (!priv->tx_ring) {
+		ret = -ENOMEM;
+		goto err;
+	}
+	priv->tx_skb = kcalloc(ASR_EMAC_TX_DESC, sizeof(*priv->tx_skb),
+			       GFP_KERNEL);
+	if (!priv->tx_skb) {
+		ret = -ENOMEM;
+		goto err_tx_ring;
+	}
+	priv->tx_head = 0;
+	priv->tx_tail = 0;
+
+	priv->rx_ring = dma_alloc_coherent(priv->dev,
+					   ASR_EMAC_RX_DESC * ASR_EMAC_DESC_SIZE,
+					   &priv->rx_ring_dma, GFP_KERNEL);
+	if (!priv->rx_ring) {
+		ret = -ENOMEM;
+		goto err_tx_skb;
+	}
+	priv->rx_skb = kcalloc(ASR_EMAC_RX_DESC, sizeof(*priv->rx_skb),
+			       GFP_KERNEL);
+	if (!priv->rx_skb) {
+		ret = -ENOMEM;
+		goto err_rx_ring;
+	}
+	priv->rx_idx = 0;
+
+	for (i = 0; i < ASR_EMAC_RX_DESC; i++) {
+		ret = asr_emac_rx_refill(priv, i);
+		if (ret)
+			goto err_rx_skb;
+	}
+
+	asr_emac_set_bits(priv, EMAC_CTRL2, 3);
+	asr_emac_writel(priv, 0, EMAC_RX_CFG);
+	asr_emac_writel(priv, ASR_EMAC_RX_BUF_SIZE, EMAC_DMA_CFG);
+	asr_emac_set_bits(priv, EMAC_MAC_CFG2, 0x9);
+	asr_emac_clear_bits(priv, EMAC_MAC_CFG2, 0x70);
+	asr_emac_set_bits(priv, EMAC_MAC_CFG3, 0x49);
+	asr_emac_writel(priv, 0, EMAC_MISC);
+
+	asr_emac_set_interface(priv, priv->phy_iface);
+
+	if (priv->phy)
+		phy_start(priv->phy);
+
+	ret = request_irq(priv->irq, asr_emac_irq, 0, DRV_NAME, ndev);
+	if (ret) {
+		netdev_err(ndev, "request_irq failed: %d\n", ret);
+		goto err_rx_skb;
+	}
+
+	if (priv->wakeup_irq >= 0) {
+		ret = request_irq(priv->wakeup_irq, asr_emac_wakeup_irq, 0,
+				  DRV_NAME, ndev);
+		if (ret) {
+			netdev_err(ndev, "request wakeup_irq failed: %d\n", ret);
+			free_irq(priv->irq, ndev);
+			goto err_rx_skb;
+		}
+	}
+
+	napi_enable(&priv->napi);
+
+	asr_emac_writel(priv, EMAC_ENABLE_TXRX, EMAC_TXRX_ENABLE);
+
+	netif_start_queue(ndev);
+
+	return 0;
+
+err_rx_skb:
+	if (priv->phy)
+		phy_stop(priv->phy);
+	for (i = 0; i < ASR_EMAC_RX_DESC; i++) {
+		if (priv->rx_skb[i]) {
+			dma_unmap_single(priv->dev,
+					 asr_emac_desc_dma(&priv->rx_ring[i]),
+					 ASR_EMAC_RX_BUF_SIZE, DMA_FROM_DEVICE);
+			dev_kfree_skb_any(priv->rx_skb[i]);
+			priv->rx_skb[i] = NULL;
+		}
+	}
+	kfree(priv->rx_skb);
+	priv->rx_skb = NULL;
+err_rx_ring:
+	dma_free_coherent(priv->dev,
+			  ASR_EMAC_RX_DESC * ASR_EMAC_DESC_SIZE,
+			  priv->rx_ring, priv->rx_ring_dma);
+	priv->rx_ring = NULL;
+err_tx_skb:
+	kfree(priv->tx_skb);
+	priv->tx_skb = NULL;
+err_tx_ring:
+	dma_free_coherent(priv->dev,
+			  ASR_EMAC_TX_DESC * ASR_EMAC_DESC_SIZE,
+			  priv->tx_ring, priv->tx_ring_dma);
+	priv->tx_ring = NULL;
+err:
+	return ret;
+}
+
+static int asr_emac_stop(struct net_device *ndev)
+{
+	struct asr_emac_priv *priv = netdev_priv(ndev);
+	int i;
+
+	netif_stop_queue(ndev);
+	napi_disable(&priv->napi);
+
+	asr_emac_clear_bits(priv, EMAC_TXRX_ENABLE, EMAC_ENABLE_BITS);
+
+	free_irq(priv->irq, ndev);
+	if (priv->wakeup_irq >= 0)
+		free_irq(priv->wakeup_irq, ndev);
+
+	if (priv->phy)
+		phy_stop(priv->phy);
+	netif_carrier_off(ndev);
+
+	for (i = 0; i < ASR_EMAC_TX_DESC; i++) {
+		if (priv->tx_skb[i]) {
+			dma_unmap_single(priv->dev,
+					 asr_emac_desc_dma(&priv->tx_ring[i]),
+					 priv->tx_skb[i]->len, DMA_TO_DEVICE);
+			dev_kfree_skb_any(priv->tx_skb[i]);
+			priv->tx_skb[i] = NULL;
+		}
+	}
+
+	for (i = 0; i < ASR_EMAC_RX_DESC; i++) {
+		if (priv->rx_skb[i]) {
+			dma_unmap_single(priv->dev,
+					 asr_emac_desc_dma(&priv->rx_ring[i]),
+					 ASR_EMAC_RX_BUF_SIZE, DMA_FROM_DEVICE);
+			dev_kfree_skb_any(priv->rx_skb[i]);
+			priv->rx_skb[i] = NULL;
+		}
+	}
+
+	kfree(priv->tx_skb);
+	kfree(priv->rx_skb);
+	priv->tx_skb = NULL;
+	priv->rx_skb = NULL;
+
+	dma_free_coherent(priv->dev,
+			  ASR_EMAC_TX_DESC * ASR_EMAC_DESC_SIZE,
+			  priv->tx_ring, priv->tx_ring_dma);
+	dma_free_coherent(priv->dev,
+			  ASR_EMAC_RX_DESC * ASR_EMAC_DESC_SIZE,
+			  priv->rx_ring, priv->rx_ring_dma);
+	priv->tx_ring = NULL;
+	priv->rx_ring = NULL;
+
+	return 0;
+}
+
+static int asr_emac_set_mac_address(struct net_device *ndev, void *p)
+{
+	struct sockaddr *addr = p;
+	struct asr_emac_priv *priv = netdev_priv(ndev);
+
+	if (!is_valid_ether_addr(addr->sa_data))
+		return -EADDRNOTAVAIL;
+
+	eth_hw_addr_set(ndev, addr->sa_data);
+	asr_emac_set_mac_addr_regs(priv, ndev->dev_addr);
+
+	return 0;
+}
+
+static void asr_emac_tx_timeout(struct net_device *ndev, unsigned int txqueue)
+{
+	struct asr_emac_priv *priv = netdev_priv(ndev);
+
+	netdev_err(ndev, "TX timeout\n");
+	asr_emac_clear_bits(priv, EMAC_TXRX_ENABLE, EMAC_ENABLE_BITS);
+	asr_emac_reset(priv);
+	asr_emac_writel(priv, EMAC_ENABLE_TXRX, EMAC_TXRX_ENABLE);
+	netif_wake_queue(ndev);
+}
+
+static const struct net_device_ops asr_emac_netdev_ops = {
+	.ndo_open = asr_emac_open,
+	.ndo_stop = asr_emac_stop,
+	.ndo_start_xmit = asr_emac_start_xmit,
+	.ndo_set_mac_address = asr_emac_set_mac_address,
+	.ndo_tx_timeout = asr_emac_tx_timeout,
+};
+
+static void asr_emac_get_drvinfo(struct net_device *ndev,
+				 struct ethtool_drvinfo *info)
+{
+	strscpy(info->driver, DRV_NAME, sizeof(info->driver));
+	strscpy(info->version, DRV_VERSION, sizeof(info->version));
+	strscpy(info->bus_info, dev_name(ndev->dev.parent),
+		sizeof(info->bus_info));
+}
+
+static const struct ethtool_ops asr_emac_ethtool_ops = {
+	.get_drvinfo = asr_emac_get_drvinfo,
+	.get_link = ethtool_op_get_link,
+};
+
+static void asr_emac_set_io_voltage(struct device *dev)
+{
+	void __iomem *unlock;
+	void __iomem *io_ctrl;
+
+	unlock = ioremap(ASR_APMU_UNLOCK_BASE, 8);
+	io_ctrl = ioremap(ASR_EMAC_IO_CTRL_BASE, 4);
+	if (!unlock || !io_ctrl)
+		goto out;
+
+	writel(ASR_APMU_UNLOCK_MAGIC, unlock);
+	writel(ASR_APMU_LOCK_MAGIC, unlock + 4);
+	asr_emac_io_sync(unlock);
+
+	writel(readl(io_ctrl) & ~ASR_EMAC_IO_3V3, io_ctrl);
+	asr_emac_io_sync(io_ctrl);
+
+	writel(ASR_APMU_UNLOCK_MAGIC, unlock);
+	writel(ASR_APMU_LOCK_MAGIC, unlock + 4);
+	asr_emac_io_sync(unlock);
+
+	dev_info(dev, "EMAC IO set to 3.3V\n");
+
+out:
+	iounmap(io_ctrl);
+	iounmap(unlock);
+}
+
+static int asr_emac_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct net_device *ndev;
+	struct asr_emac_priv *priv;
+	phy_interface_t iface;
+	int ret;
+
+	ndev = alloc_etherdev(sizeof(*priv));
+	if (!ndev)
+		return -ENOMEM;
+
+	priv = netdev_priv(ndev);
+	priv->ndev = ndev;
+	priv->dev = dev;
+	spin_lock_init(&priv->tx_lock);
+
+	SET_NETDEV_DEV(ndev, dev);
+	ndev->netdev_ops = &asr_emac_netdev_ops;
+	ndev->ethtool_ops = &asr_emac_ethtool_ops;
+	ndev->watchdog_timeo = 5 * HZ;
+	netif_napi_add_weight(ndev, &priv->napi, asr_emac_poll, 32);
+
+	priv->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(priv->base)) {
+		ret = PTR_ERR(priv->base);
+		goto err_free;
+	}
+
+	priv->irq = platform_get_irq(pdev, 0);
+	if (priv->irq < 0) {
+		ret = priv->irq;
+		goto err_free;
+	}
+	priv->wakeup_irq = platform_get_irq_optional(pdev, 1);
+
+	priv->clk = devm_clk_get_optional(dev, "emac");
+	if (IS_ERR(priv->clk)) {
+		ret = PTR_ERR(priv->clk);
+		goto err_free;
+	}
+	if (priv->clk) {
+		ret = clk_prepare_enable(priv->clk);
+		if (ret)
+			goto err_free;
+	}
+
+	priv->mdio_clk_div = 0xfe;
+	of_property_read_u32(np, "asr,mdio-clk-div", &priv->mdio_clk_div);
+
+	priv->reset_delays[1] = 100000;
+	priv->reset_delays[2] = 500000;
+	of_property_read_u32_array(np, "asr,reset-delays-us",
+				   priv->reset_delays, 3);
+
+	priv->pinctrl = devm_pinctrl_get(dev);
+	if (!IS_ERR(priv->pinctrl)) {
+		priv->rgmii_pins = pinctrl_lookup_state(priv->pinctrl,
+							"rgmii-pins");
+		if (IS_ERR(priv->rgmii_pins))
+			priv->rgmii_pins = NULL;
+	} else {
+		priv->pinctrl = NULL;
+	}
+
+	if (of_property_read_bool(np, "asr,3v-enable"))
+		asr_emac_set_io_voltage(dev);
+
+	u8 mac[ETH_ALEN];
+
+	ret = of_get_mac_address(np, mac);
+	if (ret)
+		eth_hw_addr_random(ndev);
+	else
+		eth_hw_addr_set(ndev, mac);
+	asr_emac_set_mac_addr_regs(priv, ndev->dev_addr);
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		goto err_clk;
+
+	ret = asr_emac_mdio_init(priv);
+	if (ret)
+		goto err_clk;
+
+	ret = of_get_phy_mode(np, &iface);
+	if (ret)
+		iface = PHY_INTERFACE_MODE_RGMII;
+	priv->phy_iface = iface;
+
+	if (of_phy_is_fixed_link(np)) {
+		ret = of_phy_register_fixed_link(np);
+		if (ret)
+			goto err_mdio;
+
+		priv->phy = of_phy_find_device(np);
+		if (!priv->phy) {
+			ret = -EPROBE_DEFER;
+			goto err_mdio;
+		}
+
+		ret = phy_connect_direct(ndev, priv->phy,
+					 asr_emac_adjust_link, iface);
+	} else {
+		priv->phy = of_phy_connect(ndev, np, asr_emac_adjust_link, 0,
+					   iface);
+		if (IS_ERR(priv->phy)) {
+			ret = PTR_ERR(priv->phy);
+			goto err_mdio;
+		}
+	}
+	if (ret)
+		goto err_mdio;
+
+	asr_emac_set_interface(priv, iface);
+
+	platform_set_drvdata(pdev, ndev);
+
+	ret = register_netdev(ndev);
+	if (ret)
+		goto err_phy;
+
+	netdev_info(ndev, "ASR1802S EMAC, MDIO bus '%s', IRQ %d%s\n",
+		    priv->bus->id, priv->irq,
+		    priv->wakeup_irq >= 0 ? "/wakeup" : "");
+
+	return 0;
+
+err_phy:
+	if (priv->phy) {
+		phy_disconnect(priv->phy);
+		priv->phy = NULL;
+	}
+err_mdio:
+	asr_emac_mdio_exit(priv);
+err_clk:
+	if (priv->clk)
+		clk_disable_unprepare(priv->clk);
+err_free:
+	free_netdev(ndev);
+	return ret;
+}
+
+static void asr_emac_remove(struct platform_device *pdev)
+{
+	struct net_device *ndev = platform_get_drvdata(pdev);
