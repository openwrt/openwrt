+int rtl8xxxu_set_rts_threshold(struct ieee80211_hw *hw, u32 rts);
+int rtl8xxxu_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
+		      struct ieee80211_vif *vif, struct ieee80211_sta *sta,
