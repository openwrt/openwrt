+++ b/drivers/net/wireless/realtek/rtl8xxxu/rtl8xxxu_pcie.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * RTL8XXXU PCIe transport definitions
+ * Provides DMA ring management and MMIO register access for PCIe variants
+ * of the RTL8XXX family (e.g. RTL8192FR, RTL8812FR).
+ *
+ * TX ring descriptors are separate from the txdesc40 in the skb headroom.
+ * The DMA ring descriptor tells the hardware where to find the skb.
+ * The txdesc40 (built in skb headroom by rtl8xxxu_pcie_tx) tells the
+ * hardware how to transmit the frame (rate, AMPDU, etc.).
+ *
+ * RX ring descriptors: hardware writes rxdesc24 + payload into our
+ * pre-allocated DMA buffers. parse_rxdesc24() handles the rest.
+ */
+
+#ifndef __RTL8XXXU_PCIE_H
+#define __RTL8XXXU_PCIE_H
+
+/* PCIe register offsets (BAR2 MMIO — verified from live R291 devmem probe)
+ * RTL8192FR (0xe0100000) and RTL8812FR (0xd8200000):
+ *   0x0000: MAC ID / HW ID (0xFDC3B286 on both)
+ *   0x0004: Version register (0x14030012 = RTL8192FR, 0x00030002 = RTL8812FR)
+ *   0x0008: MAC/BB config (0x00207C23 / 0x00207C21)
+ *   0x0080: FIFO pointer (0x006705C6 / 0x0060C078)
+ *   0x0100: DMA config (0x000304FF / 0x00030CFF)
+ *   0x0200-0x0FFF: TX/RX descriptor rings (DMA)
+ *   0x0800-0x0FFF: MAC/BB registers
+ */
+
+/* Ring sizes */
+#define RTL8XXXU_PCIE_TX_RING_ENTRIES	256
+#define RTL8XXXU_PCIE_RX_RING_ENTRIES	256
+
+/* MMIO register offsets (need hardware verification from devmem probe) */
+#define RTL8XXXU_PCIE_TX_DMA_idx	0x0200
+#define RTL8XXXU_PCIE_INT_STATUS	0x0300
+#define RTL8XXXU_PCIE_INT_MASK		0x0304
+
+/* RX buffer size: must hold rxdesc24 + drvinfo + max 802.11 frame */
+#define RTL8XXXU_PCIE_RX_BUF_SIZE	2048
+
+/* DMA ring descriptor — tells hardware where to find/put data */
+struct rtl8xxxu_pcie_tx_desc {
+	__le32 addr;
+	__le32 addr_hi;
+	__le16 pkt_size;
+	__le16 flags;
+#define RTL8XXXU_PCIE_TX_DESC_FLAG_OWN	BIT(15)
+#define RTL8XXXU_PCIE_TX_DESC_FLAG_FIRST	BIT(14)
+#define RTL8XXXU_PCIE_TX_DESC_FLAG_LAST	BIT(13)
+};
+
+struct rtl8xxxu_pcie_rx_desc {
+	__le32 addr;
+	__le32 addr_hi;
+	__le16 pkt_size;
+	__le16 flags;
+#define RTL8XXXU_PCIE_RX_DESC_FLAG_OWN	BIT(15)
+};
+
+/* Per-queue TX ring */
+struct rtl8xxxu_pcie_tx_ring {
+	struct rtl8xxxu_pcie_tx_desc *desc;
+	dma_addr_t desc_dma;
+	struct sk_buff **skbs;
+	unsigned int idx;
+	unsigned int cnt;	/* total frames submitted (for debugging) */
+	unsigned int queue;
+};
+
+/* RX ring */
+struct rtl8xxxu_pcie_rx_ring {
+	struct rtl8xxxu_pcie_rx_desc *desc;
+	dma_addr_t desc_dma;
+	struct sk_buff **skbs;
+	unsigned int idx;
+};
+
+/* PCIe-specific private data */
+struct rtl8xxxu_pcie_priv {
+	struct rtl8xxxu_priv *priv;
+	void __iomem *mmio;
+	struct pci_dev *pdev;
+
+	struct rtl8xxxu_pcie_tx_ring tx_ring[TXDESC_QUEUE_MAX];
+	struct rtl8xxxu_pcie_rx_ring rx_ring;
+
+	int tx_ring_size;
+	int rx_ring_size;
+	int num_tx_queues;
+
+	/* NAPI */
+	struct napi_struct napi;
+	bool napi_enabled;
+};
+
+#endif /* __RTL8XXXU_PCIE_H */

--- /dev/null	2026-08-27 10:13:16.895771030 +0100
+++ b/drivers/net/wireless/realtek/rtl8xxxu/rtl8xxxu_pcie.c
@@ -0,0 +1,904 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * RTL8XXXU PCIe transport
+ * Provides MMIO register access, DMA TX/RX rings, and NAPI for PCIe
+ * variants of the RTL8XXX family (e.g. RTL8192FR, RTL8812FR).
+ *
+ * TX: builds RTL8192F-native txdesc40 in skb headroom, DMA-maps the skb,
+ *     and submits via the PCIe DMA ring. Rate/AMPDU fill uses the shared
+ *     fill_txdesc_v2 helper from core.c.
+ *
+ * RX: hardware writes rxdesc24 + payload into our pre-allocated DMA buffers.
+ *     The NAPI poll calls parse_rxdesc24() which handles descriptor parsing
+ *     and ieee80211_rx delivery.
+ */
+
+#include <linux/module.h>
+#include <linux/pci.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include "rtl8xxxu.h"
+#include "rtl8xxxu_pcie.h"
+
+/* ------------------------------------------------------------------ */
+/*  MMIO register access (bus_ops implementations)                     */
+/* ------------------------------------------------------------------ */
+
+static u8 rtl8xxxu_pcie_read8(struct rtl8xxxu_priv *priv, u16 addr)
+{
+	struct rtl8xxxu_pcie_priv *pcie = priv->bus_priv;
+
+	return readb(pcie->mmio + addr);
+}
+
+static u16 rtl8xxxu_pcie_read16(struct rtl8xxxu_priv *priv, u16 addr)
+{
+	struct rtl8xxxu_pcie_priv *pcie = priv->bus_priv;
+
+	return readw(pcie->mmio + addr);
+}
+
+static u32 rtl8xxxu_pcie_read32(struct rtl8xxxu_priv *priv, u16 addr)
+{
+	struct rtl8xxxu_pcie_priv *pcie = priv->bus_priv;
+
+	return readl(pcie->mmio + addr);
+}
+
+static int rtl8xxxu_pcie_write8(struct rtl8xxxu_priv *priv, u16 addr, u8 val)
+{
+	struct rtl8xxxu_pcie_priv *pcie = priv->bus_priv;
+
+	writeb(val, pcie->mmio + addr);
+	return 0;
+}
+
+static int rtl8xxxu_pcie_write16(struct rtl8xxxu_priv *priv, u16 addr, u16 val)
+{
+	struct rtl8xxxu_pcie_priv *pcie = priv->bus_priv;
+
+	writew(val, pcie->mmio + addr);
+	return 0;
+}
+
+static int rtl8xxxu_pcie_write32(struct rtl8xxxu_priv *priv, u16 addr, u32 val)
+{
+	struct rtl8xxxu_pcie_priv *pcie = priv->bus_priv;
+
+	writel(val, pcie->mmio + addr);
+	return 0;
+}
+
+static int rtl8xxxu_pcie_writeN(struct rtl8xxxu_priv *priv, u16 addr,
+				u8 *buf, u16 len)
+{
+	struct rtl8xxxu_pcie_priv *pcie = priv->bus_priv;
+
+	memcpy_toio(pcie->mmio + addr, buf, len);
+	return 0;
+}
+
+static const struct rtl8xxxu_bus_ops rtl8xxxu_pcie_bus_ops = {
+	.read8 = rtl8xxxu_pcie_read8,
+	.read16 = rtl8xxxu_pcie_read16,
+	.read32 = rtl8xxxu_pcie_read32,
+	.write8 = rtl8xxxu_pcie_write8,
+	.write16 = rtl8xxxu_pcie_write16,
+	.write32 = rtl8xxxu_pcie_write32,
+	.writeN = rtl8xxxu_pcie_writeN,
+};
+
+/* ------------------------------------------------------------------ */
+/*  DMA ring management                                                */
+/* ------------------------------------------------------------------ */
+
+static int rtl8xxxu_pcie_alloc_tx_ring(struct rtl8xxxu_pcie_priv *pcie,
+				       int queue)
+{
+	struct rtl8xxxu_pcie_tx_ring *ring = &pcie->tx_ring[queue];
+	struct device *dev = &pcie->pdev->dev;
+	int size;
+
+	ring->queue = queue;
+	ring->idx = 0;
+	ring->cnt = 0;
+
+	size = RTL8XXXU_PCIE_TX_RING_ENTRIES * sizeof(struct rtl8xxxu_pcie_tx_desc);
+	ring->desc = dma_alloc_coherent(dev, size, &ring->desc_dma, GFP_KERNEL);
+	if (!ring->desc)
+		return -ENOMEM;
+
+	ring->skbs = kcalloc(RTL8XXXU_PCIE_TX_RING_ENTRIES, sizeof(struct sk_buff *),
+			     GFP_KERNEL);
+	if (!ring->skbs) {
+		dma_free_coherent(dev, size, ring->desc, ring->desc_dma);
+		return -ENOMEM;
+	}
+
+	memset(ring->desc, 0, size);
+	return 0;
+}
+
+static void rtl8xxxu_pcie_free_tx_ring(struct rtl8xxxu_pcie_priv *pcie,
+				       int queue)
+{
+	struct rtl8xxxu_pcie_tx_ring *ring = &pcie->tx_ring[queue];
+	struct device *dev = &pcie->pdev->dev;
+	int size, i;
+
+	if (!ring->desc)
+		return;
+
+	for (i = 0; i < RTL8XXXU_PCIE_TX_RING_ENTRIES; i++) {
+		if (ring->skbs[i]) {
+			dma_unmap_single(dev, ring->skbs[i]->dma,
+					 ring->skbs[i]->len, DMA_TO_DEVICE);
+			dev_kfree_skb_any(ring->skbs[i]);
+			ring->skbs[i] = NULL;
+		}
+	}
+
+	size = RTL8XXXU_PCIE_TX_RING_ENTRIES * sizeof(struct rtl8xxxu_pcie_tx_desc);
+	dma_free_coherent(dev, size, ring->desc, ring->desc_dma);
+	kfree(ring->skbs);
+	memset(ring, 0, sizeof(*ring));
+}
+
+static int rtl8xxxu_pcie_alloc_rx_ring(struct rtl8xxxu_pcie_priv *pcie)
+{
+	struct rtl8xxxu_pcie_rx_ring *ring = &pcie->rx_ring;
+	struct device *dev = &pcie->pdev->dev;
+	int size, i;
+
+	ring->idx = 0;
+
+	size = RTL8XXXU_PCIE_RX_RING_ENTRIES * sizeof(struct rtl8xxxu_pcie_rx_desc);
+	ring->desc = dma_alloc_coherent(dev, size, &ring->desc_dma, GFP_KERNEL);
+	if (!ring->desc)
+		return -ENOMEM;
+
+	ring->skbs = kcalloc(RTL8XXXU_PCIE_RX_RING_ENTRIES, sizeof(struct sk_buff *),
+			     GFP_KERNEL);
+	if (!ring->skbs) {
+		dma_free_coherent(dev, size, ring->desc, ring->desc_dma);
+		return -ENOMEM;
+	}
+
+	memset(ring->desc, 0, size);
+
+	/*
+	 * Pre-fill RX ring with skbs.
+	 * Each DMA buffer must be large enough to hold:
+	 *   rxdesc24 (24 bytes) + drvinfo +802.11 payload
+	 * Hardware writes into this buffer, then sets OWN bit.
+	 */
+	for (i = 0; i < RTL8XXXU_PCIE_RX_RING_ENTRIES; i++) {
+		struct sk_buff *skb;
+		dma_addr_t dma;
+
+		skb = __netdev_alloc_skb(NULL, RTL8XXXU_PCIE_RX_BUF_SIZE,
+					 GFP_KERNEL);
+		if (!skb)
+			break;
+
+		dma = dma_map_single(dev, skb->data, RTL8XXXU_PCIE_RX_BUF_SIZE,
+				     DMA_FROM_DEVICE);
+		if (dma_mapping_error(dev, dma)) {
+			dev_kfree_skb_any(skb);
+			break;
+		}
+
+		skb->dma = dma;
+		ring->skbs[i] = skb;
+		ring->desc[i].addr = cpu_to_le32(dma & 0xFFFFFFFF);
+		ring->desc[i].addr_hi = cpu_to_le32(dma >> 32);
+		ring->desc[i].pkt_size = cpu_to_le16(0);
+		ring->desc[i].flags = cpu_to_le16(RTL8XXXU_PCIE_RX_DESC_FLAG_OWN);
+	}
+
+	return 0;
+}
+
+static void rtl8xxxu_pcie_free_rx_ring(struct rtl8xxxu_pcie_priv *pcie)
+{
+	struct rtl8xxxu_pcie_rx_ring *ring = &pcie->rx_ring;
+	struct device *dev = &pcie->pdev->dev;
+	int size, i;
+
+	if (!ring->desc)
+		return;
+
+	for (i = 0; i < RTL8XXXU_PCIE_RX_RING_ENTRIES; i++) {
+		if (ring->skbs[i]) {
+			dma_unmap_single(dev, ring->skbs[i]->dma,
+					 RTL8XXXU_PCIE_RX_BUF_SIZE, DMA_FROM_DEVICE);
+			dev_kfree_skb_any(ring->skbs[i]);
+			ring->skbs[i] = NULL;
+		}
+	}
+
+	size = RTL8XXXU_PCIE_RX_RING_ENTRIES * sizeof(struct rtl8xxxu_pcie_rx_desc);
+	dma_free_coherent(dev, size, ring->desc, ring->desc_dma);
+	kfree(ring->skbs);
+	memset(ring, 0, sizeof(*ring));
+}
+
+static int rtl8xxxu_pcie_init_rings(struct rtl8xxxu_pcie_priv *pcie)
+{
+	int ret, i;
+
+	for (i = 0; i < pcie->num_tx_queues; i++) {
+		ret = rtl8xxxu_pcie_alloc_tx_ring(pcie, i);
+		if (ret)
+			goto err_free;
+	}
+
+	ret = rtl8xxxu_pcie_alloc_rx_ring(pcie);
+	if (ret)
+		goto err_free;
+
+	return 0;
+
+err_free:
+	while (--i >= 0)
+		rtl8xxxu_pcie_free_tx_ring(pcie, i);
+	return ret;
+}
+
+static void rtl8xxxu_pcie_free_rings(struct rtl8xxxu_pcie_priv *pcie)
+{
+	int i;
+
+	for (i = 0; i < pcie->num_tx_queues; i++)
+		rtl8xxxu_pcie_free_tx_ring(pcie, i);
+	rtl8xxxu_pcie_free_rx_ring(pcie);
+}
+
+/* ------------------------------------------------------------------ */
+/*  TX path — builds txdesc40 and submits to DMA ring                  */
+/* ------------------------------------------------------------------ */
+
+static void rtl8xxxu_pcie_tx(struct ieee80211_hw *hw,
+			     struct ieee80211_tx_control *control,
+			     struct sk_buff *skb)
+{
+	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+	struct ieee80211_tx_info *tx_info = IEEE80211_SKB_CB(skb);
+	struct rtl8xxxu_priv *priv = hw->priv;
+	struct rtl8xxxu_pcie_priv *pcie = priv->bus_priv;
+	struct rtl8xxxu_txdesc40 *tx_desc;
+	struct ieee80211_sta *sta = NULL;
+	struct ieee80211_vif *vif = tx_info->control.vif;
+	struct rtl8xxxu_vif *rtlvif = vif ? (struct rtl8xxxu_vif *)vif->drv_priv : NULL;
+	struct rtl8xxxu_pcie_tx_ring *ring;
+	struct rtl8xxxu_pcie_tx_desc *dma_desc;
+	unsigned int queue, idx, rts_rate;
+	u16 pktlen = skb->len;
+	int tx_desc_size = priv->fops->tx_desc_size;
+	u8 macid;
+	dma_addr_t dma;
+	bool ampdu_enable, sgi = false, short_preamble = false, bmc = false;
+
+	if (skb_headroom(skb) < tx_desc_size) {
+		dev_warn(priv->dev, "%s: Not enough headroom (%i) for tx descriptor\n",
+			 __func__, skb_headroom(skb));
+		goto error;
+	}
+
+	if (control && control->sta)
+		sta = control->sta;
+
+	queue = rtl8xxxu_queue_select(hdr, skb);
+	if (queue >= pcie->num_tx_queues)
+		queue = 0;
+	ring = &pcie->tx_ring[queue];
+
+	/*
+	 * Build the txdesc40 in skb headroom — same as rtl8xxxu_tx() in core.c.
+	 * This is the descriptor format the RTL8192F hardware expects.
+	 */
+	tx_desc = skb_push(skb, tx_desc_size);
+	memset(tx_desc, 0, tx_desc_size);
+	tx_desc->pkt_size = cpu_to_le16(pktlen);
+	tx_desc->pkt_offset = tx_desc_size;
+
+	/* RTL8192F: OWN/FIRST/LAST bits set by hardware or in txdw0 differently */
+	if (priv->rtl_chip != RTL8192F)
+		tx_desc->txdw0 =
+			TXDESC_OWN | TXDESC_FIRST_SEGMENT | TXDESC_LAST_SEGMENT;
+
+	if (is_multicast_ether_addr(ieee80211_get_DA(hdr)) ||
+	    is_broadcast_ether_addr(ieee80211_get_DA(hdr))) {
+		tx_desc->txdw0 |= TXDESC_BROADMULTICAST;
+		bmc = true;
+	}
+
+	tx_desc->txdw1 = cpu_to_le32(queue << TXDESC_QUEUE_SHIFT);
+	macid = rtl8xxxu_get_macid(priv, sta);
+
+	if (tx_info->control.hw_key) {
+		switch (tx_info->control.hw_key->cipher) {
+		case WLAN_CIPHER_SUITE_WEP40:
+		case WLAN_CIPHER_SUITE_WEP104:
+		case WLAN_CIPHER_SUITE_TKIP:
+			tx_desc->txdw1 |= cpu_to_le32(TXDESC_SEC_RC4);
+			break;
+		case WLAN_CIPHER_SUITE_CCMP:
+			tx_desc->txdw1 |= cpu_to_le32(TXDESC_SEC_AES);
+			break;
+		default:
+			break;
+		}
+		if (bmc && rtlvif && rtlvif->hw_key_idx != 0xff) {
+			tx_desc->txdw1 |= cpu_to_le32(TXDESC_EN_DESC_ID);
+			macid = rtlvif->hw_key_idx;
+		}
+	}
+
+	ampdu_enable = false;
+	if (ieee80211_is_data_qos(hdr->frame_control) && sta) {
+		if (sta->deflink.ht_cap.ht_supported) {
+			u32 ampdu, val32;
+			u8 *qc = ieee80211_get_qos_ctl(hdr);
+			u8 tid = qc[0] & IEEE80211_QOS_CTL_TID_MASK;
+
+			ampdu = (u32)sta->deflink.ht_cap.ampdu_density;
+			val32 = ampdu << TXDESC_AMPDU_DENSITY_SHIFT;
+			tx_desc->txdw2 |= cpu_to_le32(val32);
+
+			ampdu_enable = true;
+
+			if (!test_bit(tid, priv->tx_aggr_started) &&
+			    !(skb->protocol == cpu_to_be16(ETH_P_PAE)))
+				if (!ieee80211_start_tx_ba_session(sta, tid, 0))
+					set_bit(tid, priv->tx_aggr_started);
+		}
+	}
+
+	if (ieee80211_is_data_qos(hdr->frame_control) &&
+	    sta && sta->deflink.ht_cap.cap &
+	    (IEEE80211_HT_CAP_SGI_40 | IEEE80211_HT_CAP_SGI_20))
+		sgi = true;
+
+	if (sta && vif && vif->bss_conf.use_short_preamble)
+		short_preamble = true;
+
+	if (skb->len > hw->wiphy->rts_threshold)
+		tx_info->control.use_rts = true;
+
+	if (sta && vif && vif->bss_conf.use_cts_prot)
+		tx_info->control.use_cts_prot = true;
+
+	if (ampdu_enable || tx_info->control.use_rts ||
+	    tx_info->control.use_cts_prot)
+		rts_rate = DESC_RATE_24M;
+	else
+		rts_rate = 0;
+
+	priv->fops->fill_txdesc(hw, hdr, tx_info, tx_desc, sgi, short_preamble,
+				ampdu_enable, rts_rate, macid);
+
+	rtl8xxxu_calc_tx_desc_csum(tx_desc);
+
+	/* avoid zero checksum make tx hang */
+	if (priv->rtl_chip == RTL8710B || priv->rtl_chip == RTL8192F)
+		tx_desc->csum = ~tx_desc->csum;
+
+	/*
+	 * Now submit to the PCIe DMA ring — this replaces the USB URB path.
+	 * Map the entire skb (txdesc40 + 802.11 payload) for DMA.
+	 */
+	dma = dma_map_single(&pcie->pdev->dev, skb->data, skb->len,
+			     DMA_TO_DEVICE);
+	if (dma_mapping_error(&pcie->pdev->dev, dma)) {
+		skb_pull(skb, tx_desc_size);
+		goto error;
+	}
+
+	skb->dma = dma;
+
+	idx = ring->idx % RTL8XXXU_PCIE_TX_RING_ENTRIES;
+	dma_desc = &ring->desc[idx];
+
+	/* If slot occupied, try next slot (wrap-around) */
+	if (le16_to_cpu(dma_desc->flags) & RTL8XXXU_PCIE_TX_DESC_FLAG_OWN) {
+		/* Ring is full — drop for now */
+		dma_unmap_single(&pcie->pdev->dev, dma, skb->len, DMA_TO_DEVICE);
+		skb_pull(skb, tx_desc_size);
+		goto error;
+	}
+
+	/* Free previous skb in this slot */
+	if (ring->skbs[idx]) {
+		dma_unmap_single(&pcie->pdev->dev, ring->skbs[idx]->dma,
+				 ring->skbs[idx]->len, DMA_TO_DEVICE);
+		dev_kfree_skb_any(ring->skbs[idx]);
+		ring->skbs[idx] = NULL;
+	}
+
+	ring->skbs[idx] = skb;
+
+	/* Fill DMA ring descriptor */
+	dma_desc->addr = cpu_to_le32(dma & 0xFFFFFFFF);
+	dma_desc->addr_hi = cpu_to_le32(dma >> 32);
+	dma_desc->pkt_size = cpu_to_le16(skb->len);
+	dma_desc->flags = cpu_to_le16(RTL8XXXU_PCIE_TX_DESC_FLAG_OWN |
+				      RTL8XXXU_PCIE_TX_DESC_FLAG_FIRST |
+				      RTL8XXXU_PCIE_TX_DESC_FLAG_LAST);
+
+	/* Ring doorbell — advance TX DMA index */
+	rtl8xxxu_write32(priv, RTL8XXXU_PCIE_TX_DMA_idx, idx);
+	ring->idx++;
+	ring->cnt++;
+	return;
+
+error:
+	dev_kfree_skb_any(skb);
+}
+
+/* ------------------------------------------------------------------ */
+/*  RX path (NAPI poll)                                                */
+/* ------------------------------------------------------------------ */
+
+static int rtl8xxxu_pcie_napi_poll(struct napi_struct *napi, int budget)
+{
+	struct rtl8xxxu_pcie_priv *pcie = container_of(napi,
+						       struct rtl8xxxu_pcie_priv,
+						       napi);
+	struct rtl8xxxu_priv *priv = pcie->priv;
+	struct rtl8xxxu_pcie_rx_ring *ring = &pcie->rx_ring;
+	struct device *dev = &pcie->pdev->dev;
+	int work_done = 0;
+	unsigned int idx;
+
+	idx = ring->idx % RTL8XXXU_PCIE_RX_RING_ENTRIES;
+
+	while (work_done < budget) {
+		struct rtl8xxxu_pcie_rx_desc *dma_desc = &ring->desc[idx];
+		struct sk_buff *skb, *new_skb;
+		u16 flags;
+		dma_addr_t dma;
+		int pkt_len;
+
+		flags = le16_to_cpu(dma_desc->flags);
+		if (!(flags & RTL8XXXU_PCIE_RX_DESC_FLAG_OWN))
+			break; /* HW still owns this descriptor */
+
+		skb = ring->skbs[idx];
+		if (!skb)
+			break;
+
+		pkt_len = le16_to_cpu(dma_desc->pkt_size);
+		if (pkt_len == 0 || pkt_len > RTL8XXXU_PCIE_RX_BUF_SIZE) {
+			dev_kfree_skb_any(skb);
+			goto refill;
+		}
+
+		dma_unmap_single(dev, skb->dma, RTL8XXXU_PCIE_RX_BUF_SIZE,
+				 DMA_FROM_DEVICE);
+
+		/*
+		 * Set skb->len to what the hardware wrote. The buffer contains:
+		 *   rxdesc24 (24 bytes) + drvinfo +802.11 payload
+		 * parse_rxdesc24() handles the rest.
+		 */
+		skb_put(skb, pkt_len);
+
+		/*
+		 * Hand to the shared rx descriptor parser from core.c.
+		 * This calls ieee80211_rx_irqsafe() internally.
+		 */
+		priv->fops->parse_rx_desc(priv, skb);
+		work_done++;
+
+		/* Allocate new skb and refill ring entry */
+refill:
+		new_skb = __netdev_alloc_skb(NULL, RTL8XXXU_PCIE_RX_BUF_SIZE,
+					     GFP_KERNEL);
+		if (new_skb) {
+			dma = dma_map_single(dev, new_skb->data,
+					     RTL8XXXU_PCIE_RX_BUF_SIZE,
+					     DMA_FROM_DEVICE);
+			if (!dma_mapping_error(dev, dma)) {
+				new_skb->dma = dma;
+				ring->skbs[idx] = new_skb;
+				dma_desc->addr = cpu_to_le32(dma & 0xFFFFFFFF);
+				dma_desc->addr_hi = cpu_to_le32(dma >> 32);
+				dma_desc->pkt_size = cpu_to_le16(0);
+				dma_desc->flags = cpu_to_le16(RTL8XXXU_PCIE_RX_DESC_FLAG_OWN);
+			} else {
+				dev_kfree_skb_any(new_skb);
+				ring->skbs[idx] = NULL;
+			}
+		} else {
+			ring->skbs[idx] = NULL;
+		}
+
+		idx = (idx + 1) % RTL8XXXU_PCIE_RX_RING_ENTRIES;
+	}
+
+	ring->idx = idx;
+
+	if (work_done < budget)
+		napi_complete_done(napi, work_done);
+
+	return work_done;
+}
+
+/* ------------------------------------------------------------------ */
+/*  Interrupt handler                                                  */
+/* ------------------------------------------------------------------ */
+
+static irqreturn_t rtl8xxxu_pcie_irq_handler(int irq, void *dev_id)
+{
+	struct ieee80211_hw *hw = dev_id;
+	struct rtl8xxxu_priv *priv = hw->priv;
+	struct rtl8xxxu_pcie_priv *pcie = priv->bus_priv;
+	u32 int_status;
+
+	int_status = rtl8xxxu_read32(priv, RTL8XXXU_PCIE_INT_STATUS);
+
+	if (!int_status)
+		return IRQ_NONE;
+
+	rtl8xxxu_write32(priv, RTL8XXXU_PCIE_INT_STATUS, int_status);
+
+	if (int_status & BIT(0)) {
+		if (!napi_schedule_prep(&pcie->napi))
+			return IRQ_HANDLED;
+		__napi_schedule(&pcie->napi);
+	}
+
+	if (int_status & BIT(1)) {
+		int i;
+		for (i = 0; i < pcie->num_tx_queues; i++)
+			ieee80211_wake_queue(hw, i);
+	}
+
+	return IRQ_HANDLED;
+}
+
+/* ------------------------------------------------------------------ */
+/*  mac80211 callbacks for PCIe — start/stop/channel config            */
+/* ------------------------------------------------------------------ */
+
+static int rtl8xxxu_pcie_start(struct ieee80211_hw *hw)
+{
+	struct rtl8xxxu_priv *priv = hw->priv;
+	struct rtl8xxxu_pcie_priv *pcie = priv->bus_priv;
+	int ret;
+
+	ret = priv->fops->enable_rf(priv);
+	if (ret)
+		return ret;
+
+	/* Accept all data and mgmt frames */
+	rtl8xxxu_write16(priv, REG_RXFLTMAP2, 0xffff);
+	rtl8xxxu_write16(priv, REG_RXFLTMAP0, 0xffff);
+
+	/* Schedule rate control watchdog */
+	schedule_delayed_work(&priv->ra_watchdog, 2 * HZ);
+
+	/* Enable NAPI */
+	napi_enable(&pcie->napi);
+
+	return 0;
+}
+
+static void rtl8xxxu_pcie_stop(struct ieee80211_hw *hw)
+{
+	struct rtl8xxxu_priv *priv = hw->priv;
+	struct rtl8xxxu_pcie_priv *pcie = priv->bus_priv;
+
+	cancel_delayed_work_sync(&priv->ra_watchdog);
+
+	napi_disable(&pcie->napi);
+
+	if (priv->fops->disable_rf)
+		priv->fops->disable_rf(priv);
+}
+
+static const struct ieee80211_ops rtl8xxxu_pcie_ops = {
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.switch_vif_chanctx = ieee80211_emulate_switch_vif_chanctx,
+	.tx = rtl8xxxu_pcie_tx,
+	.wake_tx_queue = ieee80211_handle_wake_tx_queue,
+	.add_interface = rtl8xxxu_add_interface,
+	.remove_interface = rtl8xxxu_remove_interface,
+	.config = rtl8xxxu_config,
+	.conf_tx = rtl8xxxu_conf_tx,
+	.bss_info_changed = rtl8xxxu_bss_info_changed,
+	.start_ap = rtl8xxxu_start_ap,
+	.configure_filter = rtl8xxxu_configure_filter,
+	.set_rts_threshold = rtl8xxxu_set_rts_threshold,
+	.start = rtl8xxxu_pcie_start,
+	.stop = rtl8xxxu_pcie_stop,
+	.sw_scan_start = rtl8xxxu_sw_scan_start,
+	.sw_scan_complete = rtl8xxxu_sw_scan_complete,
+	.set_key = rtl8xxxu_set_key,
+	.ampdu_action = rtl8xxxu_ampdu_action,
+	.sta_statistics = rtl8xxxu_sta_statistics,
+	.get_antenna = rtl8xxxu_get_antenna,
+	.set_tim = rtl8xxxu_set_tim,
+	.sta_add = rtl8xxxu_sta_add,
+	.sta_remove = rtl8xxxu_sta_remove,
+};
+
+/* ------------------------------------------------------------------ */
+/*  Probe / Remove                                                     */
+/* ------------------------------------------------------------------ */
+
+static int rtl8xxxu_pcie_probe(struct pci_dev *pdev,
+				const struct pci_device_id *id)
+{
+	struct rtl8xxxu_priv *priv;
+	struct ieee80211_hw *hw;
+	struct rtl8xxxu_pcie_priv *pcie;
+	struct ieee80211_supported_band *sband;
+	int ret;
+
+	ret = pci_enable_device(pdev);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to enable PCI device\n");
+		return ret;
+	}
+
+	ret = pci_set_dma_mask(pdev, DMA_BIT_MASK(32));
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to set DMA mask\n");
+		goto err_disable;
+	}
+
+	/* Allocate ieee80211_hw + rtl8xxxu_priv + rtl8xxxu_pcie_priv */
+	hw = ieee80211_alloc_hw(sizeof(*priv) + sizeof(*pcie),
+				&rtl8xxxu_pcie_ops);
+	if (!hw) {
+		ret = -ENOMEM;
+		goto err_disable;
+	}
+
+	priv = hw->priv;
+	memset(priv, 0, sizeof(*priv));
+	pcie = (struct rtl8xxxu_pcie_priv *)(priv + 1);
+	memset(pcie, 0, sizeof(*pcie));
+
+	priv->hw = hw;
+	priv->dev = &pdev->dev;
+	
+	priv->bus_priv = pcie;
+	pcie->priv = priv;
+	pcie->pdev = pdev;
+
+	/* Map BAR2 (MMIO registers — verified from live R291 probe) */
+	pcie->mmio = pci_iomap(pdev, 2, 0);
+	if (!pcie->mmio) {
+		dev_err(&pdev->dev, "Failed to map BAR2\n");
+		ret = -ENOMEM;
+		goto err_free_hw;
+	}
+
+	/* Set bus ops for MMIO register access */
+	priv->bus_ops = &rtl8xxxu_pcie_bus_ops;
+
+	/* Initialize mutexes and work items */
+	mutex_init(&priv->h2c_mutex);
+	mutex_init(&priv->sta_mutex);
+	INIT_LIST_HEAD(&priv->tx_urb_free_list);
+	spin_lock_init(&priv->tx_urb_lock);
+	INIT_LIST_HEAD(&priv->rx_urb_pending_list);
+	spin_lock_init(&priv->rx_urb_lock);
+	INIT_WORK(&priv->rx_urb_wq, rtl8xxxu_rx_urb_work);
+	INIT_DELAYED_WORK(&priv->ra_watchdog, rtl8xxxu_watchdog_callback);
+	INIT_DELAYED_WORK(&priv->update_beacon_work,
+			  rtl8xxxu_update_beacon_work_callback);
+	INIT_WORK(&priv->c2hcmd_work, rtl8xxxu_c2hcmd_callback);
+	skb_queue_head_init(&priv->c2hcmd_queue);
+
+	/* Identify chip via MMIO register reads */
+	ret = priv->fops->identify_chip(priv);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to identify chip\n");
+		goto err_iounmap;
+	}
+
+	hw->wiphy->available_antennas_tx = BIT(priv->tx_paths) - 1;
+	hw->wiphy->available_antennas_rx = BIT(priv->rx_paths) - 1;
+
+	/* Read EFUSE and parse */
+	ret = priv->fops->read_efuse(priv);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to read EFUSE\n");
+		goto err_iounmap;
+	}
+
+	ret = priv->fops->parse_efuse(priv);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to parse EFUSE\n");
+		goto err_iounmap;
+	}
+
+	ret = priv->fops->load_firmware(priv);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to load firmware\n");
+		goto err_iounmap;
+	}
+
+	/* Setup TX queues */
+	pcie->num_tx_queues = 4;
+	pcie->tx_ring_size = RTL8XXXU_PCIE_TX_RING_ENTRIES;
+
+	/* Initialize DMA rings */
+	ret = rtl8xxxu_pcie_init_rings(pcie);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to init rings\n");
+		goto err_iounmap;
+	}
+
+	/* Setup mac80211 bands and capabilities */
+	hw->vif_data_size = sizeof(struct rtl8xxxu_vif);
+	hw->sta_data_size = sizeof(struct rtl8xxxu_sta_info);
+
+	hw->wiphy->max_scan_ssids = 1;
+	hw->wiphy->max_scan_ie_len = IEEE80211_MAX_DATA_LEN;
+	if (priv->fops->max_macid_num)
+		hw->wiphy->max_ap_assoc_sta = priv->fops->max_macid_num - 1;
+	hw->wiphy->interface_modes = BIT(NL80211_IFTYPE_STATION);
+	if (priv->fops->supports_ap)
+		hw->wiphy->interface_modes |= BIT(NL80211_IFTYPE_AP);
+	hw->queues = 4;
+
+	hw->wiphy->flags |= WIPHY_FLAG_HAS_CHANNEL_SWITCH;
+
+	/* 2.4GHz band */
+	sband = &rtl8xxxu_supported_band;
+	sband->ht_cap.ht_supported = true;
+	sband->ht_cap.ampdu_factor = IEEE80211_HT_MAX_AMPDU_64K;
+	sband->ht_cap.ampdu_density = IEEE80211_HT_MPDU_DENSITY_16;
+	sband->ht_cap.cap = IEEE80211_HT_CAP_SGI_20 | IEEE80211_HT_CAP_SGI_40;
+	memset(&sband->ht_cap.mcs, 0, sizeof(sband->ht_cap.mcs));
+	sband->ht_cap.mcs.rx_mask[0] = 0xff;
+	sband->ht_cap.mcs.rx_mask[4] = 0x01;
+	if (priv->rf_paths > 1) {
+		sband->ht_cap.mcs.rx_mask[1] = 0xff;
+		sband->ht_cap.cap |= IEEE80211_HT_CAP_SGI_40;
+	}
+	sband->ht_cap.mcs.tx_params = IEEE80211_HT_MCS_TX_DEFINED;
+	hw->wiphy->bands[NL80211_BAND_2GHZ] = sband;
+
+	hw->wiphy->rts_threshold = 2347;
+
+	SET_IEEE80211_DEV(hw, &pdev->dev);
+	SET_IEEE80211_PERM_ADDR(hw, priv->mac_addr);
+
+	hw->extra_tx_headroom = priv->fops->tx_desc_size;
+	ieee80211_hw_set(hw, SIGNAL_DBM);
+	ieee80211_hw_set(hw, HAS_RATE_CONTROL);
+	ieee80211_hw_set(hw, SUPPORT_FAST_XMIT);
+	ieee80211_hw_set(hw, AMPDU_AGGREGATION);
+	ieee80211_hw_set(hw, MFP_CAPABLE);
+
+	wiphy_ext_feature_set(hw->wiphy, NL80211_EXT_FEATURE_CQM_RSSI_LIST);
+
+	/* Setup NAPI — must be after ieee80211_alloc_hw */
+	netif_napi_add(&pdev->dev, &pcie->napi, rtl8xxxu_pcie_napi_poll);
+
+	/* Register MSI interrupt */
+	ret = pci_alloc_irq_vectors(pdev, 1, 1, PCI_IRQ_MSI | PCI_IRQ_LEGACY);
+	if (ret < 0) {
+		dev_err(&pdev->dev, "Failed to allocate IRQ vectors\n");
+		goto err_napi;
+	}
+
+	ret = request_irq(pci_irq_vector(pdev, 0), rtl8xxxu_pcie_irq_handler,
+			  IRQF_SHARED, "rtl8xxxu_pcie", hw);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to request IRQ\n");
+		goto err_free_irq_vectors;
+	}
+
+	pci_set_master(pdev);
+
+	ret = ieee80211_register_hw(hw);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to register hw: %d\n", ret);
+		goto err_free_irq;
+	}
+
+	pci_set_drvdata(pdev, priv);
+
+	dev_info(&pdev->dev, "RTL8XXXU PCIe: registered %04x:%04x as phy%d\n",
+		 pdev->vendor, pdev->device,
+		 hw->wiphy->iphy);
+
+	return 0;
+
+err_free_irq:
+	free_irq(pci_irq_vector(pdev, 0), hw);
+err_free_irq_vectors:
+	pci_free_irq_vectors(pdev);
+err_napi:
+	netif_napi_del(&pcie->napi);
+err_iounmap:
+	rtl8xxxu_pcie_free_rings(pcie);
+	pci_iounmap(pdev, pcie->mmio);
+err_free_hw:
+	ieee80211_free_hw(hw);
+err_disable:
+	pci_disable_device(pdev);
+	return ret;
+}
+
+static void rtl8xxxu_pcie_remove(struct pci_dev *pdev)
+{
+	struct rtl8xxxu_priv *priv = pci_get_drvdata(pdev);
+	struct rtl8xxxu_pcie_priv *pcie;
+
+	if (!priv)
+		return;
+
+	pcie = priv->bus_priv;
+
+	ieee80211_unregister_hw(priv->hw);
+
+	rtl8xxxu_write32(priv, RTL8XXXU_PCIE_INT_MASK, 0);
+
+	free_irq(pci_irq_vector(pdev, 0), priv->hw);
+	pci_free_irq_vectors(pdev);
+
+	napi_disable(&pcie->napi);
+	netif_napi_del(&pcie->napi);
+
+	cancel_delayed_work_sync(&priv->ra_watchdog);
+	cancel_delayed_work_sync(&priv->update_beacon_work);
+	cancel_work_sync(&priv->c2hcmd_work);
+	cancel_work_sync(&priv->rx_urb_wq);
+
+	rtl8xxxu_pcie_free_rings(pcie);
+	pci_iounmap(pdev, pcie->mmio);
+
+	kfree(priv->fw_data);
+
+	pci_clear_master(pdev);
+	pci_disable_device(pdev);
+	ieee80211_free_hw(priv->hw);
+}
+
+/* ------------------------------------------------------------------ */
+/*  PCI device table                                                   */
