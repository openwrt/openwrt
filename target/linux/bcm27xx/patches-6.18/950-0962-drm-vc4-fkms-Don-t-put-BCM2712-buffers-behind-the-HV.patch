From cb439717989f8a07d6db97cd47c2a956775081a2 Mon Sep 17 00:00:00 2001
From: Dom Cobley <popcornmix@gmail.com>
Date: Tue, 17 Nov 2026 17:19:38 +0000
Subject: [PATCH] drm/vc4: fkms: Don't put BCM2712 buffers behind the HVS IOMMU

vc4_drm_bind() copies the DMA configuration of the HVS node to the
vc4 device and gives BCM2712 a 36-bit DMA mask. With firmware KMS this
puts the buffers behind the HVS IOMMU at 36-bit IOVAs, but the
firmware's set-plane call only takes a 32-bit address and scans out
without the IOMMU, so the display shows random memory.

Skip the HVS DMA configuration and keep a 32-bit mask when firmware
KMS is used on BCM2712, and recognise the 2712 firmware KMS node in
firmware_kms() so the firmware display driver isn't told to stop.

Signed-off-by: Dom Cobley <popcornmix@gmail.com>
---
 drivers/gpu/drm/vc4/vc4_drv.c | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

--- a/drivers/gpu/drm/vc4/vc4_drv.c
+++ b/drivers/gpu/drm/vc4/vc4_drv.c
@@ -309,7 +309,9 @@ static bool firmware_kms(void)
 	return of_device_is_available(of_find_compatible_node(NULL, NULL,
 	       "raspberrypi,rpi-firmware-kms")) ||
 	       of_device_is_available(of_find_compatible_node(NULL, NULL,
-	       "raspberrypi,rpi-firmware-kms-2711"));
+	       "raspberrypi,rpi-firmware-kms-2711")) ||
+	       of_device_is_available(of_find_compatible_node(NULL, NULL,
+	       "raspberrypi,rpi-firmware-kms-2712"));
 }
 
 static int vc4_drm_bind(struct device *dev)
@@ -322,6 +324,7 @@ static int vc4_drm_bind(struct device *d
 	struct device_node *node;
 	struct drm_crtc *crtc;
 	enum vc4_gen gen;
+	bool fkms;
 	int ret = 0;
 
 	gen = (enum vc4_gen)of_device_get_match_data(dev);
@@ -335,13 +338,19 @@ static int vc4_drm_bind(struct device *d
 	 * Without HVS/V3D components to provide the DMA device, fkms keeps
 	 * borrowing their DT DMA configuration.
 	 */
-	if (firmware_kms()) {
-		dma_set_mask_and_coherent(dev, DMA_BIT_MASK(gen >= VC4_GEN_6_C ? 36 : 32));
+	fkms = firmware_kms();
+	if (fkms) {
+		dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
 
 		node = of_find_matching_node_and_match(NULL, vc4_dma_range_matches,
 						       NULL);
 		if (node) {
-			ret = of_dma_configure(dev, node, true);
+			/*
+			 * The firmware scans out without the BCM2712 HVS IOMMU, so
+			 * don't inherit the HVS DMA setup there.
+			 */
+			if (gen < VC4_GEN_6_C)
+				ret = of_dma_configure(dev, node, true);
 			of_node_put(node);
 
 			if (ret)
@@ -396,7 +405,7 @@ static int vc4_drm_bind(struct device *d
 		goto err;
 	}
 
-	if (firmware && !firmware_kms()) {
+	if (firmware && !fkms) {
 		ret = rpi_firmware_property(firmware,
 					    RPI_FIRMWARE_NOTIFY_DISPLAY_DONE,
 					    NULL, 0);
