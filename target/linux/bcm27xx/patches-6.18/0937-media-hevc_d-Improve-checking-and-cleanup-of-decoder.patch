+		if (sh->slice_type == HEVC_SLICE_B) {
+			if (!ref_idx_valid(sh->ref_idx_l1, sh->num_ref_idx_l1_active_minus1))
+				return -EINVAL;
+		}
+	}
+
+	return 0;
+}
