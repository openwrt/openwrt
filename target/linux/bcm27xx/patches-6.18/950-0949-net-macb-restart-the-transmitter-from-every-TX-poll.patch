From c95b534d1260522ec24d2575b4c036dcaf4a56db Mon Sep 17 00:00:00 2001
From: Nicolai Buchwitz <nb@tipi-net.de>
Date: Sat, 7 Nov 2026 14:44:42 +0100
Subject: [PATCH] net: macb: restart the transmitter from every TX poll

Raspberry Pi 5 users (BCM2712 with the GEM on the RP1 south bridge)
reported TX queue stalls of five seconds:

  macb 1f00100000.ethernet eth0: NETDEV WATCHDOG: CPU: 0: transmit queue 0 timed out 5508 ms

Further inspection of the registers showed TBQP on the first
descriptor of a valid TSO frame with TGO and the used bit clear. So
the DMA never fetched the frame.

The GEM reads the descriptor behind the frame it fetches. If the next
frame lands there a few microseconds later, the DMA has already seen
the used bit and halts after the current frame. The TSTART of that
xmit is ignored while the transmitter is busy and no TXUBR follows.
The TXUBR and tx_pending flags do not help either, the interrupt
that clears them often comes before the halt.

Restart the transmitter from every TX poll. The completion of the
previous frame always comes after the halt.

Fixes: 4298388574da ("net: macb: restart tx after tx used bit read")
Link: https://github.com/raspberrypi/linux/issues/7661
Signed-off-by: Nicolai Buchwitz <nb@tipi-net.de>
---
 drivers/net/ethernet/cadence/macb.h      |  2 --
 drivers/net/ethernet/cadence/macb_main.c | 25 ++++++------------------
 2 files changed, 6 insertions(+), 21 deletions(-)

--- a/drivers/net/ethernet/cadence/macb.h
+++ b/drivers/net/ethernet/cadence/macb.h
@@ -1296,8 +1296,6 @@ struct macb_queue {
 	struct macb_tx_skb	*tx_skb;
 	dma_addr_t		tx_ring_dma;
 	struct work_struct	tx_error_task;
-	bool			txubr_pending;
-	bool			tx_pending;
 	struct napi_struct	napi_tx;
 
 	dma_addr_t		rx_ring_dma;
--- a/drivers/net/ethernet/cadence/macb_main.c
+++ b/drivers/net/ethernet/cadence/macb_main.c
@@ -2027,12 +2027,10 @@ static int macb_tx_poll(struct napi_stru
 
 	work_done = macb_tx_complete(queue, budget);
 
-	rmb(); // ensure txubr_pending is up to date
-	if (queue->txubr_pending) {
-		queue->txubr_pending = false;
-		netdev_vdbg(bp->dev, "poll: tx restart\n");
-		macb_tx_restart(queue);
-	}
+	/* The DMA can park in front of a queued frame without raising
+	 * TXUBR, so check the ring position on every poll.
+	 */
+	macb_tx_restart(queue);
 
 	netdev_vdbg(bp->dev, "TX poll: queue = %u, work_done = %d, budget = %d\n",
 		    (unsigned int)(queue - bp->queues), work_done, budget);
@@ -2211,12 +2209,6 @@ static irqreturn_t macb_interrupt(int ir
 				queue_writel(queue, ISR, MACB_BIT(TCOMP) |
 							 MACB_BIT(TXUBR));
 
-			if (status & MACB_BIT(TXUBR) || queue->tx_pending) {
-				queue->txubr_pending = true;
-				queue->tx_pending = 0;
-				wmb(); // ensure softirq can see update
-			}
-
 			napi_schedule(&queue->napi_tx);
 		}
 
@@ -2670,14 +2662,9 @@ static netdev_tx_t macb_start_xmit(struc
 	spin_lock(&bp->lock);
 	macb_tx_lpi_wake(bp);
 
-	/* TSTART write might get dropped, so make the IRQ retrigger a buffer read */
-	if (macb_readl(bp, TSR) & MACB_BIT(TGO))
-		queue->tx_pending = 1;
-
 	macb_writel(bp, NCR, macb_readl(bp, NCR) | MACB_BIT(TSTART));
-	/* Flush PCIe posted-write queue; see comment in macb_tx_restart().
-	 * Also flushes the preceding macb_tx_lpi_wake() NCR write and the
-	 * TSR-read tx_pending breadcrumb above.
+	/* Flush the PCIe posted-write queue, see macb_tx_restart(). Also
+	 * flushes the preceding macb_tx_lpi_wake() NCR write.
 	 */
 	if (bp->caps & MACB_CAPS_PCIE_POSTED_WRITES)
 		(void)macb_readl(bp, NCR);
