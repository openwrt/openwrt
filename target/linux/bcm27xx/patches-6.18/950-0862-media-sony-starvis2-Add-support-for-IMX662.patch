 struct starvis2_model_info {
 	enum starvis2_type type;
 	const u32 *codes;
@@ -691,7 +823,28 @@ static const struct starvis2_model_info
 	.auto_detect_mono = &imx678_aamr_info,
 };
 
+static const struct starvis2_model_info imx662_aaqr_info = {
