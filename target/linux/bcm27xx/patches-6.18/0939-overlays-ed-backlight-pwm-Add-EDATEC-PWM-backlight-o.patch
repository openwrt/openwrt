+	fragment@0 {
+		target = <&pwm1>;
+		__overlay__ {
+			pinctrl-names = "default";
+			pinctrl-0 = <&rp1_pwm1_gpio45>;
+			status = "okay";
+		};
+	};
+
+	fragment@1 {
+		target-path = "/";
