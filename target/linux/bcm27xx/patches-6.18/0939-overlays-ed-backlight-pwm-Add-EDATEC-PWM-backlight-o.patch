+
+			pca: pca@20 {
+				compatible = "nxp,pca9535";
+				reg = <0x20>;
+				gpio-controller;
+				#gpio-cells = <2>;
+				status = "okay";
+			};
+		};
+	};
+
+	fragment@3 {
+		target = <&backlight_pwm>;
+		__dormant__ {
+			brightness-levels = <255 240 220 210 190 170
+				150 128 96 64 48 32 24 12 6 0>;
