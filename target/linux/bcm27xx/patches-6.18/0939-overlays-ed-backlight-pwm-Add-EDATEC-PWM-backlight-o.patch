+				brightness-levels = <0 6 12 24 32 48 64 96
+					128 150 170 190 210 220 240 255>;
+				default-brightness-level = <15>;
+				pwms = <&pwm1 3 2000000 0>;
+				enable-gpios = <&pca 0 1>;
+				status = "okay";
+			};
+		};
+	};
+
+	fragment@2 {
