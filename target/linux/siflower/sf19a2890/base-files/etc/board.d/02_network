
. /lib/functions.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

siflower_setup_interfaces()
{
	local board="$1"

	case $board in
	siflower,sf19a2890-evb)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
		;;
	esac
}

board_config_update
board=$(board_name)
siflower_setup_interfaces $board
board_config_flush

exit 0
