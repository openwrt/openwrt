CONFIG_ARM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_ZX279128=y
# CONFIG_SMP is not set
CONFIG_CPU_32v7=y
CONFIG_CPU_V7=y
CONFIG_CPU_LITTLE_ENDIAN=y
# CONFIG_CPU_BIG_ENDIAN is not set
# CONFIG_VFP is not set
# CONFIG_ARM_THUMB is not set
CONFIG_SWP_EMULATE=y
CONFIG_ARM_VIRT_EXT=y
# CONFIG_HARDEN_BRANCH_PREDICTOR is not set
CONFIG_PHYS_OFFSET=0x40000000
# CONFIG_ARM_PATCH_PHYS_VIRT is not set
CONFIG_MMU=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GLOBAL_TIMER=y
CONFIG_ARM_GT_INITIAL_PRESCALER_VAL=1
CONFIG_CLKSRC_ARM_GLOBAL_TIMER_SCHED_CLOCK=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_ARM_PATCH_IDIV=y
CONFIG_CACHE_L2X0=y
CONFIG_ARM_ERRATA_754322=y
CONFIG_ARM_ERRATA_764369=y
CONFIG_COMMON_CLK=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_DEBUG_KERNEL=y
# CONFIG_DEBUG_LL is not set
# CONFIG_EARLY_PRINTK is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNWINDER_ARM=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y
CONFIG_AUTO_ZRELADDR=y
CONFIG_ZBOOT_ROM_TEXT=0
CONFIG_ZBOOT_ROM_BSS=0
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_MTD=y
CONFIG_MTD_PARTITIONS=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_BLKDEVS=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_NAND_ZTE_SPIFC=y
# UBI (squashfs + overlay) on the ow-ubi partition
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_WL_THRESHOLD=4096
CONFIG_MTD_UBI_BEB_LIMIT=20
CONFIG_MTD_UBI_BLOCK=y
CONFIG_UBIFS_FS=y
# factory MAC from the tag partition (DT nvmem-cells)
CONFIG_NVMEM=y
# mksquashfs applies the ARM BCJ filter (-Xbcj arm)
CONFIG_XZ_DEC_BCJ=y
CONFIG_XZ_DEC_ARM=y
CONFIG_XZ_DEC_ARMTHUMB=y
# Warm reset: register-write reboot via topcrm@94000000 +0x44 (from U-Boot reset cmd)
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_MFD_SYSCON=y
# Stage C (plan 7.2): MDIO bus for the integrated GEPHYs, built-in so
# the bus probes on first boot. PHYLIB/FIXED_PHY default to m in
# OpenWrt generic config — pinned y here to override (target config
# has higher precedence than generic).
CONFIG_MDIO_DEVICE=y
CONFIG_MDIO_BUS=y
CONFIG_PHYLIB=y
CONFIG_OF_MDIO=y
CONFIG_FIXED_PHY=y
CONFIG_ZX279128_MDIO=y
# Stage D (plan 7.2): integrated 4-port Ethernet MAC/switch driver.
# Built-in so eth0 exists before first userspace; depends on PHYLIB
# which is already pinned y above.
CONFIG_ZX279128_ETH=y
