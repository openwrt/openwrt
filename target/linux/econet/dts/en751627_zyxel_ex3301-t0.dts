/dts-v1/;

#include "en751627.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Zyxel EX3301-T0";
	compatible = "zyxel,ex3301-t0", "econet,en751627";

	aliases {
		led-boot = &led_power_green;
		led-failsafe = &led_power_red;
		led-running = &led_power_green;
		led-upgrade = &led_power_red;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;
	};

	chosen {
		stdout-path = "/serial@1fbf0000:115200";
	};

	leds {
		compatible = "gpio-leds";

		led_power_green: led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led_power_red: led-1 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_internet_green: led-2 {
			color = <LED_COLOR_ID_GREEN>;
			function = "internet";
			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_internet_red: led-3 {
			color = <LED_COLOR_ID_RED>;
			function = "internet";
			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_wlan24: led-4 {
			color = <LED_COLOR_ID_GREEN>;
			function = "wlan2g";
			gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
			default-state = "off";
		};

		led_wlan5: led-5 {
			color = <LED_COLOR_ID_GREEN>;
			function = "wlan5g";
			gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy1tpt";
			default-state = "off";
		};

		led_wps: led-6 {
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_WPS;
			gpios = <&gpio0 23 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_lan_agg: led-7 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_wan_eth: led-8 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		key-reset {
			label = "reset";
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		key-wps {
			label = "wps";
			gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};

		key-wifi {
			label = "wifi";
			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RFKILL>;
		};
	};
};

&nand {
	status = "okay";
	econet,bmt;
	econet,bbt-table-size = <250>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0all {
			label = "all_of_flash";
			reg = <0x0 0x8000000>;
			read-only;
		};

		partition@0 {
			label = "bootloader";
			reg = <0x0 0x40000>;
			read-only;
		};

		partition@40000 {
			label = "romfile";
			reg = <0x40000 0x40000>;
			read-only;
		};

		partition@80000 {
			label = "tclinux";
			reg = <0x80000 0x2800000>;
		};

		/* Nested inside of tclinux */
		partition@480000 {
			label = "rootfs";
			reg = <0x480000 0x2400000>;
			linux,rootfs;
		};

		partition@2880000 {
			label = "tclinux_alt";
			reg = <0x2880000 0x2620000>;
			read-only;
		};

		partition@4ea0000 {
			label = "wwan";
			reg = <0x4ea0000 0x100000>;
		};

		partition@4fa0000 {
			label = "factory_data";
			reg = <0x4fa0000 0x400000>;
		};

		partition@53a0000 {
			label = "rom-d";
			reg = <0x53a0000 0x100000>;
		};

		partition@54a0000 {
			label = "misc";
			reg = <0x54a0000 0x2000000>;
		};

		factory: partition@74a0000 {
			label = "factory";
			reg = <0x74a0000 0x80000>;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				eeprom_factory_0: eeprom@0 {
					reg = <0x0 0x1000>;
				};

				macaddr_factory_0: macaddr@0 {
					reg = <0x0 0x6>;
				};
			};
		};

		partition@7520000 {
			label = "reservearea";
			reg = <0x7520000 0xc0000>;
		};
	};
};

&pcie0 {
	status = "okay";
};
&slot0 {
	status = "okay";

	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_factory_0>;
		nvmem-cell-names = "eeprom";
		big-endian;
	};
};

&pcie1 {
	status = "okay";

	/* Slot 1 is a second link to the same wifi chip */
};

/*
 * Port map empirically confirmed by live-testing a real EX3301-T0: cable
 * moved one physical port at a time, /proc/tc3162/gsw_link_st read after
 * each move. Switch port 6 (CPU) needs no override -- it has no "status"
 * property in en751627.dtsi so it defaults to enabled, matching that it
 * was always up in testing regardless of what was plugged in.
 */
&ethernet {
	status = "okay";
};

&gmac0 {
	nvmem-cells = <&macaddr_factory_0>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&switch {
	status = "okay";
};

&gsw_port3 {
	status = "okay";
	label = "lan1";
};

&gsw_port2 {
	status = "okay";
	label = "lan2";
};

&gsw_port1 {
	status = "okay";
	label = "lan3";
};

&gsw_port0 {
	status = "okay";
	label = "lan4";
};

&gsw_port4 {
	status = "okay";
	label = "wan";
};

&gsw_phy3_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <1>;
	status = "okay";
};

&gsw_phy2_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <2>;
	status = "okay";
};

&gsw_phy1_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <3>;
	status = "okay";
};

&gsw_phy0_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <4>;
	status = "okay";
};

&gsw_phy4_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_WAN;
	status = "okay";
};

