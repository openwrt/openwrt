/dts-v1/;

#include "rt63368.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "ZyXEL Keenetic LTE";
	compatible = "zyxel,keenetic-lte", "econet,rt63368", "econet,en751221";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x8000000>;
	};

	chosen {
		/* U-Boot passes no command line. */
		bootargs = "console=ttyS0,57600";
		stdout-path = "/serial@1fbf0000:57600";
		linux,usable-memory-range = <0x00020000 0x7fe0000>;
	};

	/*
	 * Shift-register LEDs, named after the case labels (the PCB silkscreen
	 * differs: case POWER is PCB "USB", INTERNET is "LTE", USB is
	 * "PHONE2", LTE is "PHONE1", PHONE2 is "POWER", signal low/mid/strong
	 * are "SIGNAL 3/2/1"). Lines 0, 1, 3, 8 and 10 are not connected.
	 */
	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&led_sr 4 GPIO_ACTIVE_LOW>;
		};

		led-internet {
			color = <LED_COLOR_ID_GREEN>;
			label = "green:internet";
			gpios = <&led_sr 5 GPIO_ACTIVE_LOW>;
		};

		led-usb-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_USB;
			gpios = <&led_sr 2 GPIO_ACTIVE_LOW>;
		};

		led-usb-orange {
			color = <LED_COLOR_ID_ORANGE>;
			function = LED_FUNCTION_USB;
			gpios = <&led_sr 9 GPIO_ACTIVE_LOW>;
		};

		led-lte-green {
			color = <LED_COLOR_ID_GREEN>;
			label = "green:lte";
			gpios = <&led_sr 12 GPIO_ACTIVE_LOW>;
		};

		led-lte-orange {
			color = <LED_COLOR_ID_ORANGE>;
			label = "orange:lte";
			gpios = <&led_sr 11 GPIO_ACTIVE_LOW>;
		};

		led-signal-low {
			color = <LED_COLOR_ID_GREEN>;
			label = "green:signal-low";
			gpios = <&led_sr 13 GPIO_ACTIVE_LOW>;
		};

		led-signal-mid {
			color = <LED_COLOR_ID_GREEN>;
			label = "green:signal-mid";
			gpios = <&led_sr 14 GPIO_ACTIVE_LOW>;
		};

		led-signal-strong {
			color = <LED_COLOR_ID_GREEN>;
			label = "green:signal-strong";
			gpios = <&led_sr 15 GPIO_ACTIVE_LOW>;
		};

		led-phone-2-green {
			color = <LED_COLOR_ID_GREEN>;
			label = "green:phone-2";
			gpios = <&led_sr 7 GPIO_ACTIVE_LOW>;
		};

		led-phone-2-orange {
			color = <LED_COLOR_ID_ORANGE>;
			label = "orange:phone-2";
			gpios = <&led_sr 6 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * LEDs on RT5392 GPIOs: case Wi-Fi (PCB "WIFI 2.4G") and the bicolour
	 * case PHONE1 (PCB "INTERNET"). A separate node, so that the
	 * shift-register LEDs (boot/failsafe LED) do not wait for the WLAN
	 * driver.
	 */
	leds-wlan {
		compatible = "gpio-leds";

		led-wifi {
			color = <LED_COLOR_ID_ORANGE>;
			label = "orange:wifi";
			gpios = <&wifi 13 GPIO_ACTIVE_LOW>;
		};

		led-phone-1-green {
			color = <LED_COLOR_ID_GREEN>;
			label = "green:phone-1";
			gpios = <&wifi 6 GPIO_ACTIVE_LOW>;
		};

		led-phone-1-red {
			color = <LED_COLOR_ID_RED>;
			label = "red:phone-1";
			gpios = <&wifi 7 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * RESET is on SoC gpio0 (U-Boot leaves its output enable set; it reads
	 * the button once switched to input), WLAN ("wifi" on the case) and FN
	 * on RT5392 GPIO12/GPIO14. No interrupts, hence polled.
	 */
	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		button-reset {
			label = "reset";
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		button-wifi {
			label = "wifi";
			gpios = <&wifi 12 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RFKILL>;
		};

		button-fn {
			label = "fn";
			gpios = <&wifi 14 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_0>;
		};
	};
};

&ehci {
	status = "okay";
};

&ohci {
	status = "okay";
};

&ethernet {
	nvmem-cells = <&macaddr_lan>;
	nvmem-cell-names = "mac-address";
};

&led_sr {
	status = "okay";
};

&pcie_rt {
	status = "okay";

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;
		device_type = "pci";
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi: wifi@0,0 {
			compatible = "pci1814,3091";
			reg = <0x0000 0 0 0 0>;
			nvmem-cells = <&eeprom_wifi>;
			nvmem-cell-names = "eeprom";
			ralink,eeprom-big-endian;
			/* GPIO_CTRL pins 0-15, used for the WLAN/FN buttons and LEDs. */
			gpio-controller;
			#gpio-cells = <2>;
		};
	};
};

/*
 * Spansion S34ML01G1 (128 MiB, 2K pages). U-Boot uses the vendor BMT (last
 * 81 good blocks), the en75_bmt format; partition offsets are logical.
 * U-Boot boots the kernel partition (option 3: bootm 0xB0060000).
 */
&rt_nand {
	status = "okay";

	econet,bmt;
	econet,assert-reserve-size = <81>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "u-boot";
			reg = <0x0000000 0x0020000>;
			read-only;
		};

		partition@20000 {
			label = "u-config";
			reg = <0x0020000 0x0020000>;
			read-only;
		};

		partition@40000 {
			label = "rf-eeprom";
			reg = <0x0040000 0x0020000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				eeprom_wifi: eeprom@0 {
					reg = <0x0 0x200>;
				};

				macaddr_lan: macaddr@28 {
					reg = <0x28 0x6>;
				};
			};
		};

		partition@60000 {
			label = "kernel";
			reg = <0x0060000 0x0400000>;
		};

		partition@460000 {
			label = "ubi";
			reg = <0x0460000 0x1940000>;
		};

		partition@1da0000 {
			label = "config";
			reg = <0x1da0000 0x0020000>;
			read-only;
		};

		partition@1dc0000 {
			label = "storage";
			reg = <0x1dc0000 0x0200000>;
			read-only;
		};

		partition@1fc0000 {
			label = "dump";
			reg = <0x1fc0000 0x0040000>;
			read-only;
		};
	};
};

/*
 * eth0 (PDMA) -> internal switch port 6 -> internal port 5 (RGMII) ->
 * external MT7530 port 6 -> MT7530 ports 0-4 = the five jacks. The MT7530
 * sits at MDIO address 31 on the internal switch MDIO master registered by
 * the Ethernet driver.
 */
&switch0 {
	/delete-property/ mediatek,mcm;
	/delete-property/ reset-names;

	ports {
		port@0 {
			status = "okay";
			label = "lan4";
		};

		port@1 {
			status = "okay";
			label = "lan3";
		};

		port@2 {
			status = "okay";
			label = "lan2";
		};

		port@3 {
			status = "okay";
			label = "lan1";
		};

		port@4 {
			reg = <4>;
			label = "wan";
		};

		port@6 {
			ethernet = <&ethernet>;
			phy-mode = "rgmii";
		};
	};
};
