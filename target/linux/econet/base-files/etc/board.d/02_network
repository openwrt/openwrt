. /lib/functions/system.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/econet.sh

econet_setup_interfaces()
{
	local board="$1"

	case "$board" in
	dasan,h660gm-a-airtel|\
	dasan,h660gm-a-generic|\
	econet,en7528-generic|\
	jiofiber,jcow407|\
	jiofiber,jcow414)
		ucidef_set_interface_lan "lan1 lan2 lan3 lan4"
		;;
	zte,zxhn-h267a)
		# lan = MCM port 5, TRGMII uplink to the external MT7530BU that
		# floods all four LAN jacks. wan = MCM port 4, its own GE PHY
		# at MDIO 12, bypassing the external switch. eth0 is the DSA
		# conduit, never listed itself.
		ucidef_set_interfaces_lan_wan "lan" "wan"
		;;
	*)
		# The remaining boards have no DSA switch driver yet.
		ucidef_set_interface_lan "eth0"
		;;
	esac
}

econet_setup_macs()
{
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local label_mac=""

	case "$board" in
	chinamobile,gs3101)
		wan_mac="$(get_mac_gs3101)"
		[ -n "$wan_mac" ] && lan_mac="$(macaddr_add $wan_mac 1)"
		;;
	huawei,hg2821t-u)
		local conffile="/tmp/configuration_a/factory.conf"
		lan_mac=$(get_mac_ascii "$conffile" brmac)
		wan_mac=$(get_mac_ascii "$conffile" internetmac)
		label_mac=$wan_mac
		;;
	zte,zxhn-h267a)
		# WAN shares LAN/gmac0's MAC (base+0), confirmed against stock.
		# Read the base from the tag partition itself, not
		# /sys/class/net/eth0/address: econet-eth is a kmod that loads
		# after board_detect runs, so eth0 doesn't exist yet here.
		wan_mac=$(mtd_get_mac_binary tag 0x14)
		;;
	esac

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" "$lan_mac"
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" "$wan_mac"
	[ -n "$label_mac" ] && ucidef_set_label_macaddr "$label_mac"
}

board_config_update
board=$(board_name)
econet_setup_interfaces $board
econet_setup_macs $board
board_config_flush

exit 0
