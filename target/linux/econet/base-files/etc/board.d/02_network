. /lib/functions/system.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/econet.sh

econet_setup_interfaces()
{
	local board="$1"

	case "$board" in
	dasan,h660gm-a-airtel|\
	dasan,h660gm-a-generic|\
	econet,en7528-generic|\
	jiofiber,jcow407|\
	jiofiber,jcow414)
		ucidef_set_interface_lan "lan1 lan2 lan3 lan4"
		;;
	tplink,archer-c5v)
		# No DSA driver for this switch yet; the econet,mt7530-vlan-split
		# device tree properties split the external MT7530 into a LAN
		# VLAN (untagged, eth0.1) and a WAN VLAN (untagged, eth0.2) at
		# the driver level instead. eth0.35 (tagged VLAN 35, also set up
		# by the same split) is left unconfigured here for ISPs that
		# need PPPoE/DHCP on a tagged VLAN instead of the plain eth0.2.
		ucidef_set_interface_lan "eth0.1"
		ucidef_set_interface_wan "eth0.2"
		;;
	tplink,ex20v)
		# No external switch at all on this board (see
		# econet,int-gsw-vlan-split in the DTS): the SoC-internal GSW is
		# split the same way, untagged LAN VLAN (eth0.1) and untagged WAN
		# VLAN (eth0.2) as sane defaults; the WAN port's extra tagged
		# VLAN 35 (eth0.35) is left unconfigured here, for ISPs that need it.
		ucidef_set_interface_lan "eth0.1"
		ucidef_set_interface_wan "eth0.2"
		;;
	*)
		# The remaining boards have no DSA switch driver yet.
		ucidef_set_interface_lan "eth0"
		;;
	esac
}

econet_setup_macs()
{
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local label_mac=""

	case "$board" in
	chinamobile,gs3101)
		wan_mac="$(get_mac_gs3101)"
		[ -n "$wan_mac" ] && lan_mac="$(macaddr_add $wan_mac 1)"
		;;
	huawei,hg2821t-u)
		local conffile="/tmp/configuration_a/factory.conf"
		lan_mac=$(get_mac_ascii "$conffile" brmac)
		wan_mac=$(get_mac_ascii "$conffile" internetmac)
		label_mac=$wan_mac
		;;
	esac

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" "$lan_mac"
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" "$wan_mac"
	[ -n "$label_mac" ] && ucidef_set_label_macaddr "$label_mac"
}

board_config_update
board=$(board_name)
econet_setup_interfaces $board
econet_setup_macs $board
board_config_flush

exit 0
