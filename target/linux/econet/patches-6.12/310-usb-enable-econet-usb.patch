From c43925313e7179aec7a93aa24a03532f0c1fbaea Mon Sep 17 00:00:00 2001
From: Caleb James DeLisle <cjd@cjdns.fr>
Date: Sun, 14 Sep 2025 17:23:47 +0000
Subject: [PATCH] MIPS: econet: enable USB support

Allow the MediaTek xHCI driver to be built for EcoNet SoCs and select
DMA_NONCOHERENT for them, as needed for USB support.
---
--- a/arch/mips/Kconfig
+++ b/arch/mips/Kconfig
@@ -392,6 +392,7 @@ config ECONET
 	bool "EcoNet MIPS family"
 	select BOOT_RAW
 	select CPU_BIG_ENDIAN
+	select DMA_NONCOHERENT
 	select DEBUG_ZBOOT if DEBUG_KERNEL
 	select EARLY_PRINTK_8250
 	select ECONET_EN751221_TIMER
--- a/drivers/usb/host/Kconfig
+++ b/drivers/usb/host/Kconfig
@@ -71,7 +71,7 @@ config USB_XHCI_HISTB
 config USB_XHCI_MTK
 	tristate "xHCI support for MediaTek SoCs"
 	select MFD_SYSCON
-	depends on (MIPS && SOC_MT7621) || ARCH_MEDIATEK || ARCH_AIROHA || COMPILE_TEST
+	depends on (MIPS && SOC_MT7621) || ECONET || ARCH_MEDIATEK || ARCH_AIROHA || COMPILE_TEST
 	help
 	  Say 'Y' to enable the support for the xHCI host controller
 	  found in MediaTek SoCs.
