From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sergey Lebedev <sergey@lebedev.mobi>
Date: Sat, 15 Aug 2026 15:38:30 +0300
Subject: [PATCH] irqchip: econet-en751221: implement irq_set_affinity via IVSR

econet_irq_chip has never implemented .irq_set_affinity, so every device IRQ
(both radios, ethernet) is structurally pinned to whatever CPU happens to
handle it out of boot-time state; any write to /proc/irq/N/smp_affinity fails
with EPERM. The hardware has a real per-IRQ VPE-steering register that the
vendor's own SMP kernel uses (CR_INTC_IVSR0-7, 0x30-0x4c) and that this driver
has never touched.

The register/bit computation is the vendor's own, from plat_set_irq_affinity()
(cjdelisle/EcoNet-IOPSYS-GPL-5.4.55, arch/mips/econet/malta-smp.c), and was
cross-checked against the EcoNet Linux wiki's worked examples and against live
register reads on an EN751221 board.

Signed-off-by: Sergey Lebedev <sergey@lebedev.mobi>
---
--- a/drivers/irqchip/irq-econet-en751221.c
+++ b/drivers/irqchip/irq-econet-en751221.c
@@ -22,7 +22,9 @@
  */
 
 #include <linux/cleanup.h>
+#include <linux/cpumask.h>
 #include <linux/io.h>
+#include <linux/irq.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
 #include <linux/of_irq.h>
@@ -41,6 +43,7 @@
 #define REG_MASK1		0x50
 #define REG_PENDING0		0x08
 #define REG_PENDING1		0x54
+#define REG_IVSR0		0x30
 
 /**
  * @membase:		Base address of the interrupt controller registers
@@ -206,6 +209,44 @@ static void (* const econet_cpu_dispatch
 	econet_cpu_dispatch1,
 };
 
+/*
+ * IVSR0-7 (REG_IVSR0 + 0x00..0x1c) steer a *non-percpu* hwirq to VPE0 or VPE1
+ * in hardware. econet_chmask()'s mask/shadow machinery is symmetric across
+ * both VPEs for any hwirq without a shadow (the common case -- every device
+ * IRQ except the timer), so today those interrupts are stuck wherever IVSR
+ * happens to leave them (in practice always VPE0, since nothing in Linux
+ * ever touches this register). This is the missing lever.
+ *
+ * The vendor's own IRQ numbering for this register runs one higher than this
+ * driver's hwirq numbers. That is empirical -- confirmed against live
+ * hardware and against the EcoNet Linux wiki's worked examples -- not an
+ * architectural given. The register/bit computation itself is the vendor's
+ * own, from plat_set_irq_affinity() (cjdelisle/EcoNet-IOPSYS-GPL-5.4.55,
+ * arch/mips/econet/malta-smp.c) -- bit clear routes to VPE0, bit set to VPE1.
+ */
+static int econet_intc_set_affinity(struct irq_data *d, const struct cpumask *mask, bool force)
+{
+	unsigned int vendor_irq = d->hwirq + 1;
+	unsigned int reg, bit;
+	int cpu;
+
+	if (vendor_irq < 1 || vendor_irq > 31)
+		return -EINVAL;
+
+	cpu = cpumask_any_and(mask, cpu_online_mask);
+	if (cpu >= nr_cpu_ids)
+		return -EINVAL;
+
+	reg = REG_IVSR0 + (((32 - vendor_irq) >> 2) << 2);
+	bit = ((vendor_irq - 1) % 4) * 8 + 4;
+
+	econet_wreg(reg, cpu == 1 ? BIT(bit) : 0, BIT(bit));
+
+	irq_data_update_effective_affinity(d, cpumask_of(cpu));
+
+	return IRQ_SET_MASK_OK;
+}
+
 static const struct irq_chip econet_irq_chip;
 
 static int econet_intc_map(struct irq_domain *d, u32 irq, irq_hw_number_t hwirq)
@@ -242,6 +283,7 @@ static const struct irq_chip econet_irq_
 	.irq_unmask	= econet_intc_unmask,
 	.irq_mask	= econet_intc_mask,
 	.irq_mask_ack	= econet_intc_mask,
+	.irq_set_affinity = econet_intc_set_affinity,
 };
 
 static const struct irq_domain_ops econet_domain_ops = {
