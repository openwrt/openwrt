From: John Rowe <opensource@rowe.lol>
Date: Fri, 20 Nov 2026 09:53:17 +0000
Subject: [PATCH] net: dsa: mt7530: add EN751627 support

EN751627 (EN7516/EN7527 family, e.g. Zyxel VMG8825-T50 and
WX3100-T0) integrates the same MT7530-derivative switch as
EN7528, memory-mapped at the same offset scheme. The switch
CREV register at switch-base + 0x7ffc reads 0x7530 in its top
16 bits (confirmed live on VMG8825-T50 and WX3100-T0 hardware).

Unlike EN7528 it wires five user ports, 0-4, to integrated
Gigabit PHYs at MDIO addresses 8-12 (port + 8) on the switch
internal MDIO bus, with CPU port 6 connected to the SoC
Ethernet MAC at a fixed 1000 Mbps full-duplex link. Borrowing
the EN7528 capability table (ports 1-4) leaves port 0 with an
empty supported_interfaces and phylink refuses it, so give
EN751627 its own mac_port_get_caps covering ports 0-4 and 6
instead of widening the EN7528 one. Setup and PHY access
reuse mt7988_setup() and the MT7531 indirect PHY accessors,
as on EN7528.

Leave LPI capabilities empty for EN751627 too (same GPHY IP
as EN7528, same EEE-instability rationale as the EN7528
support, precautionary pending a live EEE test).

Based on the Zyxel VMG8825-T50 port by koenieee:
https://github.com/koenieee/VMG8825-T50-Openwrt-support

Signed-off-by: John Rowe <opensource@rowe.lol>
Index: linux-6.18.64/drivers/net/dsa/mt7530-mmio.c
===================================================================
--- linux-6.18.64.orig/drivers/net/dsa/mt7530-mmio.c
+++ linux-6.18.64/drivers/net/dsa/mt7530-mmio.c
@@ -14,6 +14,7 @@ static const struct of_device_id mt7988_
 	{ .compatible = "airoha,an7583-switch", .data = &mt753x_table[ID_AN7583], },
 	{ .compatible = "airoha,en7581-switch", .data = &mt753x_table[ID_EN7581], },
 	{ .compatible = "econet,en7528-switch", .data = &mt753x_table[ID_EN7528], },
+	{ .compatible = "econet,en751627-switch", .data = &mt753x_table[ID_EN751627], },
 	{ .compatible = "mediatek,mt7988-switch", .data = &mt753x_table[ID_MT7988], },
 	{ /* sentinel */ },
 };
Index: linux-6.18.64/drivers/net/dsa/mt7530.c
===================================================================
--- linux-6.18.64.orig/drivers/net/dsa/mt7530.c
+++ linux-6.18.64/drivers/net/dsa/mt7530.c
@@ -2940,6 +2940,32 @@ static void en7528_mac_port_get_caps(str
 	}
 }
 
+static void en751627_mac_port_get_caps(struct dsa_switch *ds, int port,
+				       struct phylink_config *config)
+{
+	switch (port) {
+	/* Five user ports, 0-4, each on an integrated Gigabit PHY at MDIO
+	 * address port + 8. There is no MII pinout.
+	 */
+	case 0 ... 4:
+		__set_bit(PHY_INTERFACE_MODE_INTERNAL,
+			  config->supported_interfaces);
+
+		config->mac_capabilities |= MAC_10 | MAC_100 | MAC_1000FD;
+		break;
+
+	/* Port 6 is connected to SoC's GMAC at 1000 Mbps full duplex. There
+	 * is no MII pinout.
+	 */
+	case 6:
+		__set_bit(PHY_INTERFACE_MODE_INTERNAL,
+			  config->supported_interfaces);
+
+		config->mac_capabilities |= MAC_1000FD;
+		break;
+	}
+}
+
 static void
 mt7530_mac_config(struct dsa_switch *ds, int port, unsigned int mode,
 		  phy_interface_t interface)
@@ -3140,7 +3166,7 @@ static void mt753x_phylink_get_caps(stru
 	 * phylink disables EEE on these PHYs and refuses to enable it from
 	 * userspace.
 	 */
-	if (priv->id != ID_EN7528 &&
+	if (priv->id != ID_EN7528 && priv->id != ID_EN751627 &&
 	    config->mac_capabilities & (MAC_100FD | MAC_1000FD)) {
 		u32 eeecr = mt7530_read(priv, MT753X_PMEEECR_P(port));
 
@@ -3298,7 +3324,7 @@ mt753x_conduit_state_change(struct dsa_s
 	 * interface is up.
 	 */
 	if (priv->id != ID_MT7530 && priv->id != ID_MT7621 &&
-	    priv->id != ID_EN7528)
+	    priv->id != ID_EN7528 && priv->id != ID_EN751627)
 		return;
 
 	mask = BIT(cpu_dp->index);
@@ -3512,6 +3538,16 @@ const struct mt753x_info mt753x_table[]
 		.phy_write_c45 = mt7531_ind_c45_phy_write,
 		.mac_port_get_caps = en7528_mac_port_get_caps,
 	},
+	[ID_EN751627] = {
+		.id = ID_EN751627,
+		.pcs_ops = &mt7530_pcs_ops,
+		.sw_setup = mt7988_setup,
+		.phy_read_c22 = mt7531_ind_c22_phy_read,
+		.phy_write_c22 = mt7531_ind_c22_phy_write,
+		.phy_read_c45 = mt7531_ind_c45_phy_read,
+		.phy_write_c45 = mt7531_ind_c45_phy_write,
+		.mac_port_get_caps = en751627_mac_port_get_caps,
+	},
 };
 EXPORT_SYMBOL_GPL(mt753x_table);
 
Index: linux-6.18.64/drivers/net/dsa/mt7530.h
===================================================================
--- linux-6.18.64.orig/drivers/net/dsa/mt7530.h
+++ linux-6.18.64/drivers/net/dsa/mt7530.h
@@ -22,6 +22,7 @@ enum mt753x_id {
 	ID_EN7581 = 4,
 	ID_AN7583 = 5,
 	ID_EN7528 = 6,
+	ID_EN751627 = 7,
 };
 
 #define	NUM_TRGMII_CTRL			5
