From 3ec468ff4fa3106d459ae58ec4bc4833715118c6 Mon Sep 17 00:00:00 2001
From: Mesih Kilinc <mesihkilinc@gmail.com>
Date: Fri, 30 May 2025 21:30:38 +0000
Subject: [PATCH] watchdog: sunxi: add F1C100s compatible

Allwinner ARMv5 F1C100s has similar watchdog timer to sun6i A31.
Add compatible string for it.

Signed-off-by: Mesih Kilinc <mesihkilinc@gmail.com>
---
 drivers/watchdog/sunxi_wdt.c | 1 +
 1 file changed, 1 insertion(+)

--- a/drivers/watchdog/sunxi_wdt.c
+++ b/drivers/watchdog/sunxi_wdt.c
@@ -283,6 +283,7 @@ static const struct of_device_id sunxi_w
 	{ .compatible = "allwinner,sun6i-a31-wdt", .data = &sun6i_wdt_reg },
 	{ .compatible = "allwinner,sun20i-d1-wdt", .data = &sun20i_wdt_reg },
 	{ .compatible = "allwinner,sun55i-a523-wdt", .data = &sun55i_wdt_reg },
+	{ .compatible = "allwinner,suniv-f1c100s-wdt", .data = &sun6i_wdt_reg },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, sunxi_wdt_dt_ids);
