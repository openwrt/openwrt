From 716661d562443ce71fc8b302b98832d6923b4373 Mon Sep 17 00:00:00 2001
From: Zoltan HERPAI <wigyori@uid0.hu>
Date: Mon, 9 Feb 2026 09:34:37 +0000
Subject: [PATCH] ARM: dts: sun8i-t113s-olinuxino: add LED aliases

Add the LED aliases used by OpenWrt to indicate the boot, failsafe,
running and upgrade states to the device tree of the Olimex
T113-OLinuXino.
---
--- a/arch/arm/boot/dts/allwinner/sun8i-t113s-olinuxino.dts
+++ b/arch/arm/boot/dts/allwinner/sun8i-t113s-olinuxino.dts
@@ -18,6 +18,11 @@
 		serial1 = &uart1;
 		mmc0 = &mmc0;
 		mmc1 = &mmc1;
+
+		led-boot = &led_green;
+		led-failsafe = &led_green;
+		led-running = &led_green;
+		led-upgrade = &led_green;
 	};
 
 	chosen {
