From 716661d562443ce71fc8b302b98832d6923b4373 Mon Sep 17 00:00:00 2001
From: Zoltan HERPAI <wigyori@uid0.hu>
Date: Mon, 9 Feb 2026 09:34:37 +0000
Subject: [PATCH] riscv: dts: allwinner: d1s-t113: add UART4 pins on PD7/PD8

Add a pinctrl group for UART4 on the pins PD7 and PD8.
---
--- a/arch/riscv/boot/dts/allwinner/sunxi-d1s-t113.dtsi
+++ b/arch/riscv/boot/dts/allwinner/sunxi-d1s-t113.dtsi
@@ -197,6 +197,12 @@
 				pins = "PE2", "PE3";
 				function = "uart0";
 			};
+
+			/omit-if-no-ref/
+			uart4_pd_pins: uart4-pd-pins {
+				pins = "PD7", "PD8";
+				function = "uart4";
+			};
 		};
 
 		ccu: clock-controller@2001000 {
