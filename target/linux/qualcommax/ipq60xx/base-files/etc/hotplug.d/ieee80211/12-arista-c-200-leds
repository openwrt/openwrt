#!/bin/sh
# Arista C-200: each radio LED follows its radio, found by device path.
# Phy numbers follow the order the radios were first found in. Both radios
# are the IPQ6010's, so the band tells them apart. "phyNradio" lights the
# LED while the radio is enabled.

[ "$ACTION" = add ] || exit 0

. /lib/functions.sh

[ "$(board_name)" = arista,c-200 ] || exit 0

case "$(readlink "/sys/class/ieee80211/$DEVICENAME/device")" in
*/c000000.wifi)
	if iw phy "$DEVICENAME" info | grep -q "Band 1:"; then
		led=green:wlan-2ghz
	else
		led=green:wlan-5ghz
	fi
	;;
*)
	exit 0
	;;
esac

echo "${DEVICENAME}radio" > "/sys/class/leds/$led/trigger"
