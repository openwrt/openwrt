/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "FPT AX3000CV2";
	compatible ="fpt,ax3000cv2", "qcom,ipq5018";
	
	aliases {
		serial0 = &blsp1_uart1;
		
		ethernet0 = &dp1;
		ethernet1 = &dp2;
		
		led-boot = &led_red;
		led-failsafe = &led_red;
		led-running = &led_white;
		led-upgrade = &led_red;
		mdio-gpio1 = &mdio_bitbang;
	};
	
	chosen {
		bootargs-append = " root=/dev/ubiblock0_1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};
	
	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";
		
		reset {
			label = "reset";
			gpios = <&tlmm 27 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			linux,input-type = <EV_KEY>;
			debounce-interval = <60>;
		};
		
		wps {
			label = "wps";
			gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			linux,input-type = <EV_KEY>;
			debounce-interval = <60>;
		};
	};
	
	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";
		
		led_red: led-red {
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 0 GPIO_ACTIVE_HIGH>;
			function = LED_FUNCTION_POWER;
		};
		
		led_white: led-white {
			color = <LED_COLOR_ID_WHITE>;
			gpios = <&tlmm 1 GPIO_ACTIVE_HIGH>;
			function = LED_FUNCTION_WAN_ONLINE;
		};
	};
	
	// yt9215s cannot recognize from mdio1 so i used bitbang method instead
	mdio_bitbang: mdio-gpio {
		compatible = "virtual,mdio-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		
		gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>,
		<&tlmm 37 GPIO_ACTIVE_HIGH>;
		
		yt9215: switch@1d {
			pinctrl-names = "default";
			pinctrl-0 = <&switch_reset_pin>;
			compatible = "motorcomm,yt9215";
			reg = <29>;
			/* The driver pulses this line like the stock firmware
			 * (25 ms asserted, 100 ms after release); the generic
			 * reset-delay-us properties are not used.
			 */
			reset-gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
			
			mdio {
				#address-cells = <1>;
				#size-cells = <0>;
				
				sw_phy0: phy@0 {
					reg = <0>;
					motorcomm,auto-sleep-disabled;
				};
				
				sw_phy1: phy@1 {
					reg = <1>;
					motorcomm,auto-sleep-disabled;
				};
				
				sw_phy2: phy@2 {
					reg = <2>;
					motorcomm,auto-sleep-disabled;
				};
			};
			
			ethernet-ports {
				#address-cells = <1>;
				#size-cells = <0>;
				
				ethernet-port@0 {
					reg = <0>;
					label = "lan1";
					phy-mode = "internal";
					phy-handle = <&sw_phy0>;
				};
				
				ethernet-port@1 {
					reg = <1>;
					label = "lan2";
					phy-mode = "internal";
					phy-handle = <&sw_phy1>;
				};
				
				ethernet-port@2 {
					reg = <2>;
					label = "lan3";
					phy-mode = "internal";
					phy-handle = <&sw_phy2>;
				};
				
				ethernet-port@8 {
					reg = <8>;
					/* IPQ5018 UNIPHY runs SGMII at 1G (125 MHz,
					 * MAC_MODE_SGMII_CHANNEL0); the yt921x driver
					 * maps "sgmii" to REVSGMII for EXT0. 2500BASE-X
					 * with SGMII_PLUS does not establish link here.
					 */
					phy-mode = "sgmii";
					ethernet = <&dp2>;
					
					fixed-link {
						speed = <1000>;
						full-duplex;
					};
				};
			};
		};
	};
};

&xo_clk {
	clock-frequency = <0x16e3600>;
};

&sleep_clk {
	clock-frequency = <0x7d00>;
};

&switch {
	status = "okay";
	/* SGMII 1G on the CPU lane, matching the stock firmware. */
	switch_mac_mode = <MAC_MODE_SGMII_CHANNEL0>;

	/*
	 * Keep GCC_UNIPHY_AHB_ARES: SSDK resets the UNIPHY through this line
	 * before programming SGMII 1G on the forced CPU port. Without it the
	 * PCS keeps its reset defaults and never gets link.
	 */
	resets = <&gcc GCC_GMAC0_BCR>,
		 <&gcc GCC_GMAC1_BCR>,
		 <&gcc GCC_UNIPHY_BCR>,
		 <&gcc GCC_UNIPHY_AHB_ARES>,
		 <&gcc GCC_UNIPHY_SOFT_RESET>;
	reset-names = "gmac0_bcr_rst",
		      "gmac1_bcr_rst",
		      "uniphy_bcr_rst",
		      "uniphy1_ahb_rst",
		      "uniphy1_soft_rst";

	qcom,port_phyinfo {
		port@0 {
			port_id = <1>;
			mdiobus = <&mdio0>;
			phy_address = <7>;
		};
		
		port@1 {
			port_id = <2>;
			mdiobus = <&mdio_bitbang>;
			forced-speed = <1000>;
			forced-duplex = <1>;
		};
	};
	
	led_source@0 {
		source = <0x00>;
		mode = "normal";
		speed = "all";
		blink_en = "enable";
		active = "high";
	};
};

&mdio0 {
	status = "okay";
};

&dp1 {
	status = "okay";
	label = "wan";
	nvmem-cells = <&macaddr_appsblenv_ethaddr 0>;
	nvmem-cell-names = "mac-address";
};

&dp2 {
	status = "okay";
	label = "lan";
	phy-mode = "sgmii";
	nvmem-cells = <&macaddr_appsblenv_ethaddr 1>;
	nvmem-cell-names = "mac-address";
	
	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&blsp1_uart1 {
	status = "okay";
	pinctrl-0 = <&uart_pins>;
	pinctrl-names = "default";
};

&pwm {
	pinctrl-0 = <&pwm_pins>;
	pinctrl-names = "default";
	#pwm-cells = <2>;
	status = "okay";
};

&crypto {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	
	nandcs@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-strength = <8>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;
		
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			
			partition@0 {
				label = "0:SBL1";
				reg = <0x0 0x80000>;
				read-only;
			};
			
			partition@80000 {
				label = "0:MIBIB";
				reg = <0x80000 0x80000>;
				read-only;
			};
			
			partition@100000 {
				label = "0:BOOTCONFIG";
				reg = <0x100000 0x40000>;
				read-only;
			};
			
			partition@140000 {
				label = "0:BOOTCONFIG1";
				reg = <0x140000 0x40000>;
				read-only;
			};
			
			partition@180000 {
				label = "0:QSEE";
				reg = <0x180000 0x100000>;
				read-only;
			};
			
			partition@280000 {
				label = "0:QSEE_1";
				reg = <0x280000 0x100000>;
				read-only;
			};
			
			partition@380000 {
				label = "0:DEVCFG";
				reg = <0x380000 0x40000>;
				read-only;
			};
			
			partition@3c0000 {
				label = "0:DEVCFG_1";
				reg = <0x3c0000 0x40000>;
				read-only;
			};
			
			partition@400000 {
				label = "0:CDT";
				reg = <0x400000 0x40000>;
				read-only;
			};
			
			partition@440000 {
				label = "0:CDT_1";
				reg = <0x440000 0x40000>;
				read-only;
			};
			
			partition@480000 {
				label = "0:APPSBLENV";
				reg = <0x480000 0x80000>;
				
				nvmem-layout {
					compatible = "u-boot,env";
					
					macaddr_appsblenv_ethaddr: ethaddr {
						#nvmem-cell-cells = <1>;
					};
				};
			};
			
			partition@500000 {
				label = "0:APPSBL";
				reg = <0x500000 0x140000>;
				read-only;
			};
			
			partition@640000 {
				label = "0:APPSBL_1";
				reg = <0x640000 0x140000>;
				read-only;
			};
			
			partition@780000 {
				label = "0:ART";
				reg = <0x780000 0x100000>;
				read-only;
			};
			
			partition@880000 {
				label = "0:TRAINING";
				reg = <0x880000 0x80000>;
				read-only;
			};
			
			partition@900000 {
				label = "APPSBLENV_1";
				reg = <0x900000 0x80000>;
				read-only;
			};
			
			partition@980000 {
				label = "ART_1";
				reg = <0x980000 0x100000>;
				read-only;
			};
			
			partition@a80000 {
				label = "TRAINING_1";
				reg = <0xa80000 0x80000>;
				read-only;
			};
			
			partition@b00000 {
				label = "cert";
				reg = <0xb00000 0x100000>;
				read-only;
			};
			
			partition@c00000 {
				label = "cert_1";
				reg = <0xc00000 0x100000>;
				read-only;
			};
			
			partition@d00000 {
				label = "rootfs";
				reg = <0xd00000 0x5000000>;
			};
		};
	};
};

&tlmm {
	switch_reset_pin: switch-reset-pin {
		pins = "gpio35";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};
	
	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};
		
		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
	
	leds_pins: leds-pins {
		pins = "gpio0", "gpio1";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};
	
	button_pins: button-pins {
		pins = "gpio27", "gpio26";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};
	
	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};
		
		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};
		
		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};
	
	uart_pins: uart0-state {
		pins = "gpio20","gpio21";
		function = "blsp0_uart0";
		bias-disable;
	};
	
	pwm_pins: pwm_pinmux {
		// mux_1 {
		// 	pins = "gpio0";
		// 	function = "pwm10";
		// 	drive-strength = <8>;
		// };
		
		// mux_2 {
		// 	pins = "gpio1";
		// 	function = "pwm20";
		// 	drive-strength = <8>;
		// };
		
		mux_3 {
			pins = "gpio45";
			function = "pwm3";
			drive-strength = <8>;
		};
	};
};

&q6v5_wcss {
	boot-args = <0x01 0x04 0x03 0x0f 0x00 0x00 0x02 0x04 0x02 0x12 0x00 0x00>;
};

&wifi {
	status = "okay";
	
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";
	qcom,ath11k-calibration-variant = "FPT-AX3000CV2";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	status = "okay";
	
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,ath11k-calibration-variant = "FPT-AX3000CV2";
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};
