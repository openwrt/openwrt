From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Date: Sun, 11 Oct 2026 20:11:28 +0200
From: Julius Bairaktaris <julius@bairaktaris.de>
Subject: [PATCH] net: dsa: install the VLANs of another tree's port as foreign VLANs

A bridge port of one switch tree is a foreign interface to the other
trees, but switchdev hands a VLAN object on a DSA user port to that port
alone. On the RT-AX89X the QCA8337 CPU port then never joins a VLAN
that only a PPE port of the bridge carries, so the QCA8337 drops that
VLAN's traffic from its own ports instead of sending it to the CPU.

Pass the VLAN objects of a user port also to the user ports of the
other trees in the bridge, which install them as host VLANs, as for any
foreign interface. The bridge replays the VLANs of all ports on join
and leave, so the join order does not matter.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>

--- a/net/dsa/user.c
+++ b/net/dsa/user.c
@@ -3990,6 +3990,47 @@ static int dsa_user_switchdev_event(stru
 	return NOTIFY_OK;
 }
 
+/* switchdev hands a VLAN on a user port to that port alone, so the other
+ * trees in its bridge, to which the port is foreign, never see it.
+ */
+static int
+dsa_user_foreign_tree_vlan(struct net_device *dev,
+			   struct switchdev_notifier_port_obj_info *info,
+			   bool add)
+{
+	struct net_device *br, *lower;
+	struct netlink_ext_ack *extack;
+	struct list_head *iter;
+	int err;
+
+	if (info->obj->id != SWITCHDEV_OBJ_ID_PORT_VLAN ||
+	    !dsa_user_dev_check(dev))
+		return 0;
+
+	br = netdev_master_upper_dev_get(dev);
+	if (!br || !netif_is_bridge_master(br))
+		return 0;
+
+	extack = switchdev_notifier_info_to_extack(&info->info);
+
+	netdev_for_each_lower_dev(br, lower, iter) {
+		if (!dsa_user_dev_check(lower) ||
+		    !dsa_foreign_dev_check(lower, dev))
+			continue;
+
+		if (add)
+			err = dsa_user_port_obj_add(lower, info->info.ctx,
+						    info->obj, extack);
+		else
+			err = dsa_user_port_obj_del(lower, info->info.ctx,
+						    info->obj);
+		if (err && err != -EOPNOTSUPP)
+			return err;
+	}
+
+	return 0;
+}
+
 static int dsa_user_switchdev_blocking_event(struct notifier_block *unused,
 					     unsigned long event, void *ptr)
 {
@@ -4002,12 +4043,16 @@ static int dsa_user_switchdev_blocking_e
 							    dsa_user_dev_check,
 							    dsa_foreign_dev_check,
 							    dsa_user_port_obj_add);
+		if (!err)
+			err = dsa_user_foreign_tree_vlan(dev, ptr, true);
 		return notifier_from_errno(err);
 	case SWITCHDEV_PORT_OBJ_DEL:
 		err = switchdev_handle_port_obj_del_foreign(dev, ptr,
 							    dsa_user_dev_check,
 							    dsa_foreign_dev_check,
 							    dsa_user_port_obj_del);
+		if (!err)
+			err = dsa_user_foreign_tree_vlan(dev, ptr, false);
 		return notifier_from_errno(err);
 	case SWITCHDEV_PORT_ATTR_SET:
 		err = switchdev_handle_port_attr_set(dev, ptr,
