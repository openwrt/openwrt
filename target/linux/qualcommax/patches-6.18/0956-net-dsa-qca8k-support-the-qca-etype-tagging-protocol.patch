From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julius Bairaktaris <julius@bairaktaris.de>
Date: Sat, 10 Oct 2026 10:24:05 +0200
Subject: [PATCH] net: dsa: qca8k: support the qca-etype tagging protocol

Add change_tag_protocol so a CPU port can select "qca-etype", and set
the header type in HEADER_CTRL to match. Register access and MIB
autocast frames carry the type as well: build them with it, and let the
tagger drop it on receive so the handlers keep their layout.

[Stanislaw Pal: on top of the qca-8021q tagger (generic 761), which
 brings qca8k_change_tag_protocol already. qca-etype becomes a case of
 that function, the HEADER_CTRL write is kept as qca8k_set_hdr_etype(),
 and Ethernet management runs in both header modes, not in qca alone]
Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
--- a/drivers/net/dsa/qca/qca8k-8xxx.c
+++ b/drivers/net/dsa/qca/qca8k-8xxx.c
@@ -217,7 +217,8 @@ static void qca8k_rw_reg_ack_handler(str
 }
 
 static struct sk_buff *qca8k_alloc_mdio_header(enum mdio_cmd cmd, u32 reg, u32 *val,
-					       int priority, unsigned int len)
+					       int priority, unsigned int len,
+					       bool etype)
 {
 	struct qca_mgmt_ethhdr *mgmt_ethhdr;
 	unsigned int real_len;
@@ -262,7 +263,8 @@ static struct sk_buff *qca8k_alloc_mdio_
 	skb_reset_mac_header(skb);
 	skb_set_network_header(skb, skb->len);
 
-	mgmt_ethhdr = skb_push(skb, QCA_HDR_MGMT_HEADER_LEN + QCA_HDR_LEN);
+	mgmt_ethhdr = skb_push(skb, QCA_HDR_MGMT_HEADER_LEN + QCA_HDR_LEN +
+			       (etype ? QCA_ETYPE_HDR_LEN - QCA_HDR_LEN : 0));
 
 	hdr = FIELD_PREP(QCA_HDR_XMIT_VERSION, QCA_HDR_VERSION);
 	hdr |= FIELD_PREP(QCA_HDR_XMIT_PRIORITY, priority);
@@ -281,7 +283,12 @@ static struct sk_buff *qca8k_alloc_mdio_
 	if (cmd == MDIO_WRITE)
 		put_unaligned_le32(*val, &mgmt_ethhdr->mdio_data);
 
-	mgmt_ethhdr->hdr = htons(hdr);
+	if (etype) {
+		mgmt_ethhdr->hdr = htons(QCA_HDR_ETYPE);
+		put_unaligned_be16(hdr, mgmt_ethhdr + 1);
+	} else {
+		mgmt_ethhdr->hdr = htons(hdr);
+	}
 
 	data2 = skb_put_zero(skb, QCA_HDR_MGMT_DATA2_LEN + QCA_HDR_MGMT_PADDING_LEN);
 	if (cmd == MDIO_WRITE && len > QCA_HDR_MGMT_DATA1_LEN) {
@@ -318,7 +325,8 @@ static int qca8k_read_eth(struct qca8k_p
 	int ret;
 
 	skb = qca8k_alloc_mdio_header(MDIO_READ, reg, NULL,
-				      QCA8K_ETHERNET_MDIO_PRIORITY, len);
+				      QCA8K_ETHERNET_MDIO_PRIORITY, len,
+				      priv->etype_hdr);
 	if (!skb)
 		return -ENOMEM;
 
@@ -370,7 +378,8 @@ static int qca8k_write_eth(struct qca8k_
 	int ret;
 
 	skb = qca8k_alloc_mdio_header(MDIO_WRITE, reg, val,
-				      QCA8K_ETHERNET_MDIO_PRIORITY, len);
+				      QCA8K_ETHERNET_MDIO_PRIORITY, len,
+				      priv->etype_hdr);
 	if (!skb)
 		return -ENOMEM;
 
@@ -648,19 +657,22 @@ qca8k_phy_eth_command(struct qca8k_priv
 
 	/* Prealloc all the needed skb before the lock */
 	write_skb = qca8k_alloc_mdio_header(MDIO_WRITE, QCA8K_MDIO_MASTER_CTRL, &write_val,
-					    QCA8K_ETHERNET_PHY_PRIORITY, sizeof(write_val));
+					    QCA8K_ETHERNET_PHY_PRIORITY, sizeof(write_val),
+					    priv->etype_hdr);
 	if (!write_skb)
 		return -ENOMEM;
 
 	clear_skb = qca8k_alloc_mdio_header(MDIO_WRITE, QCA8K_MDIO_MASTER_CTRL, &clear_val,
-					    QCA8K_ETHERNET_PHY_PRIORITY, sizeof(clear_val));
+					    QCA8K_ETHERNET_PHY_PRIORITY, sizeof(clear_val),
+					    priv->etype_hdr);
 	if (!clear_skb) {
 		ret = -ENOMEM;
 		goto err_clear_skb;
 	}
 
 	read_skb = qca8k_alloc_mdio_header(MDIO_READ, QCA8K_MDIO_MASTER_CTRL, &clear_val,
-					   QCA8K_ETHERNET_PHY_PRIORITY, sizeof(clear_val));
+					   QCA8K_ETHERNET_PHY_PRIORITY, sizeof(clear_val),
+					   priv->etype_hdr);
 	if (!read_skb) {
 		ret = -ENOMEM;
 		goto err_read_skb;
@@ -1786,6 +1798,29 @@ qca8k_get_tag_protocol(struct dsa_switch
 	return DSA_TAG_PROTO_QCA;
 }
 
+/* Where the switch puts the Atheros header: right after the MAC addresses
+ * (qca), or behind an ethertype (qca-etype). The qca-8021q mode sends no
+ * header at all and leaves this register alone.
+ */
+static int qca8k_set_hdr_etype(struct qca8k_priv *priv, bool etype)
+{
+	u32 val = 0;
+	int ret;
+
+	if (etype)
+		val = QCA8K_HEADER_CTRL_TYPE_LEN |
+		      FIELD_PREP(QCA8K_HEADER_CTRL_TYPE_VAL, QCA_HDR_ETYPE);
+
+	/* Written in the format the switch still expects */
+	ret = qca8k_write(priv, QCA8K_REG_HEADER_CTRL, val);
+	if (ret)
+		return ret;
+
+	priv->etype_hdr = etype;
+
+	return 0;
+}
+
 static struct dsa_port *
 qca8k_preferred_default_local_cpu_port(struct dsa_switch *ds)
 {
@@ -1929,7 +1964,8 @@ qca8k_conduit_change(struct dsa_switch *
 	/* Management over Ethernet rides on the Atheros header, which
 	 * tag_8021q has turned off in the switch; MDIO does the job then.
 	 */
-	priv->mgmt_conduit = operational && priv->tag_proto == DSA_TAG_PROTO_QCA ?
+	priv->mgmt_conduit = operational &&
+			     priv->tag_proto != DSA_TAG_PROTO_QCA_8021Q ?
 			     (struct net_device *)conduit : NULL;
 
 	mutex_unlock(&priv->mgmt_eth_data.mutex);
@@ -1946,6 +1982,7 @@ static int qca8k_connect_tag_protocol(st
 		/* Nothing to connect: the tagger carries no management. */
 		break;
 	case DSA_TAG_PROTO_QCA:
+	case DSA_TAG_PROTO_QCA_ETYPE:
 		tagger_data = ds->tagger_data;
 
 		tagger_data->rw_reg_ack_handler = qca8k_rw_reg_ack_handler;
@@ -2038,12 +2075,28 @@ static int qca8k_change_tag_protocol(str
 				     enum dsa_tag_protocol proto)
 {
 	struct qca8k_priv *priv = ds->priv;
+	enum dsa_tag_protocol old = priv->tag_proto;
 	struct dsa_port *dp;
 	int ret;
 
-	if (proto == priv->tag_proto)
+	if (proto == old)
 		return 0;
 
+	/* Between qca and qca-etype only the place of the header changes */
+	if (proto != DSA_TAG_PROTO_QCA_8021Q && old != DSA_TAG_PROTO_QCA_8021Q) {
+		if (proto != DSA_TAG_PROTO_QCA &&
+		    proto != DSA_TAG_PROTO_QCA_ETYPE)
+			return -EPROTONOSUPPORT;
+
+		ret = qca8k_set_hdr_etype(priv,
+					  proto == DSA_TAG_PROTO_QCA_ETYPE);
+		if (ret)
+			return ret;
+
+		priv->tag_proto = proto;
+		return 0;
+	}
+
 	/* A port in a bridge cannot change over. tag_8021q keeps a VLAN for
 	 * each bridge and a PVID for each port, and neither its teardown nor
 	 * its setup brings back what the other mode had: the PVID and the
@@ -2066,6 +2119,7 @@ static int qca8k_change_tag_protocol(str
 
 	switch (proto) {
 	case DSA_TAG_PROTO_QCA:
+	case DSA_TAG_PROTO_QCA_ETYPE:
 		dsa_tag_8021q_unregister(ds);
 		qca8k_user_vlan_filter_feature(ds, false);
 		ds->vlan_upper_filtering_always = false;
@@ -2083,6 +2137,11 @@ static int qca8k_change_tag_protocol(str
 				return ret;
 		}
 
+		ret = qca8k_set_hdr_etype(priv,
+					  proto == DSA_TAG_PROTO_QCA_ETYPE);
+		if (ret)
+			return ret;
+
 		return qca8k_set_hdr_mode(priv, QCA8K_PORT_HDR_CTRL_ALL);
 	case DSA_TAG_PROTO_QCA_8021Q:
 		/* Management frames need the Atheros header; from here on
@@ -2119,7 +2178,7 @@ static int qca8k_change_tag_protocol(str
 	}
 
 restore_vlan:
-	priv->tag_proto = DSA_TAG_PROTO_QCA;
+	priv->tag_proto = old;
 	qca8k_set_tag_8021q_vlan_mode(priv, false);
 restore_hdr:
 	qca8k_set_hdr_mode(priv, QCA8K_PORT_HDR_CTRL_ALL);
--- a/drivers/net/dsa/qca/qca8k.h
+++ b/drivers/net/dsa/qca/qca8k.h
@@ -153,6 +153,9 @@
 #define   QCA8K_PORT_STATUS_LINK_AUTO			BIT(9)
 #define   QCA8K_PORT_STATUS_LINK_PAUSE			BIT(10)
 #define   QCA8K_PORT_STATUS_FLOW_AUTO			BIT(12)
+#define QCA8K_REG_HEADER_CTRL				0x98
+#define   QCA8K_HEADER_CTRL_TYPE_LEN			BIT(16)
+#define   QCA8K_HEADER_CTRL_TYPE_VAL			GENMASK(15, 0)
 #define QCA8K_REG_PORT_HDR_CTRL(_i)			(0x9c + (_i * 4))
 #define   QCA8K_PORT_HDR_CTRL_RX_MASK			GENMASK(3, 2)
 #define   QCA8K_PORT_HDR_CTRL_TX_MASK			GENMASK(1, 0)
@@ -542,6 +545,7 @@ struct qca8k_priv {
 	struct device *dev;
 	struct gpio_desc *reset_gpio;
 	struct net_device *mgmt_conduit; /* Track if mdio/mib Ethernet is available */
+	bool etype_hdr; /* The header is behind QCA_HDR_ETYPE */
 	struct qca8k_mgmt_eth_data mgmt_eth_data;
 	struct qca8k_mib_eth_data mib_eth_data;
 	struct qca8k_mdio_cache mdio_cache;
