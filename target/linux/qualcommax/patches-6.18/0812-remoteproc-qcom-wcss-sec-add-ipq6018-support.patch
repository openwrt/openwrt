From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Robert Marko <robimarko@gmail.com>
Date: Wed, 16 Sep 2026 18:16:00 +0200
Subject: [PATCH] remoteproc: qcom: wcss-sec: add IPQ6018 support

IPQ6018 uses the secure WCSS PIL remoteproc driver, but its SSR subsystem
name is "wcnss" rather than the "q6wcss" name used by IPQ9574. Add a
dedicated descriptor for IPQ6018 and match its WCSS compatible to it.

Signed-off-by: Robert Marko <robimarko@gmail.com>
---
 drivers/remoteproc/qcom_q6v5_wcss_sec.c | 6 ++++++
 1 file changed, 6 insertions(+)

--- a/drivers/remoteproc/qcom_q6v5_wcss_sec.c
+++ b/drivers/remoteproc/qcom_q6v5_wcss_sec.c
@@ -420,6 +420,11 @@ static const struct wcss_data wcss_sec_i
 	.use_tmelcom = true,
 };
 
+static const struct wcss_data wcss_sec_ipq6018_res_init = {
+	.pasid = WCSS_PAS_ID,
+	.ss_name = "wcnss",
+};
+
 static const struct wcss_data wcss_sec_ipq9574_res_init = {
 	.pasid = WCSS_PAS_ID,
 	.ss_name = "q6wcss",
@@ -429,6 +434,7 @@ static const struct of_device_id wcss_se
 	{ .compatible = "qcom,ipq5018-wcss-sec-pil", .data = &wcss_sec_ipq5332_res_init },
 	{ .compatible = "qcom,ipq5332-wcss-sec-pil", .data = &wcss_sec_ipq5332_res_init },
 	{ .compatible = "qcom,ipq5424-wcss-sec-pil", .data = &wcss_sec_ipq5424_res_init },
+	{ .compatible = "qcom,ipq6018-wcss-sec-pil", .data = &wcss_sec_ipq6018_res_init },
 	{ .compatible = "qcom,ipq8074-wcss-sec-pil", .data = &wcss_sec_ipq9574_res_init },
 	{ .compatible = "qcom,ipq9574-wcss-sec-pil", .data = &wcss_sec_ipq9574_res_init },
 	{ },
