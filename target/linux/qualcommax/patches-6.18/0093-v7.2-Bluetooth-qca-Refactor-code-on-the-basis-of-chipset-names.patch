 	.vregs = (struct qca_vreg []) {
@@ -2154,17 +2166,6 @@ static const struct qca_device_data qca_
 	.num_vregs = 4,
 };
 
-static const struct qca_device_data qca_soc_data_qca2066 __maybe_unused = {
