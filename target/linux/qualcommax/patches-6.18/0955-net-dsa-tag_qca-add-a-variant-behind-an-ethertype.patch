From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julius Bairaktaris <julius@bairaktaris.de>
Date: Sat, 10 Oct 2026 10:24:05 +0200
Subject: [PATCH] net: dsa: tag_qca: add a variant behind an ethertype

The QCA8K header sits in place of the ethertype, so a conduit that finds
the IP header by parsing past the Ethernet header and VLAN tags cannot
offload the checksum or TSO of a tagged frame. The IPQ807x EDMA is such
a conduit for the QCA8337 behind PPE port 1 on the Asus RT-AX89X.

The switch can also send and take the header behind a 2 byte ethertype.
Add a "qca-etype" tagging protocol for that form, with the 802.1ad
ethertype in front of the header, which the EDMA parses as a VLAN tag.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
--- a/include/linux/dsa/tag_qca.h
+++ b/include/linux/dsa/tag_qca.h
@@ -9,6 +9,12 @@ struct dsa_switch;
 struct sk_buff;
 
 #define QCA_HDR_LEN	2
+/* The header behind an ethertype, as the switch sends and takes it with
+ * QCA8K_HEADER_CTRL_TYPE_LEN set. A VLAN ethertype lets an Ethernet
+ * controller that parses past VLAN tags find the IP header behind it.
+ */
+#define QCA_HDR_ETYPE		ETH_P_8021AD
+#define QCA_ETYPE_HDR_LEN	4
 #define QCA_HDR_VERSION	0x2
 
 #define QCA_HDR_RECV_VERSION		GENMASK(15, 14)
--- a/include/net/dsa.h
+++ b/include/net/dsa.h
@@ -58,6 +58,7 @@ struct tc_action;
 #define DSA_TAG_PROTO_MXL862_VALUE		30
 #define DSA_TAG_PROTO_MXL862_8021Q_VALUE	31
 #define DSA_TAG_PROTO_OOB_VALUE			32
+#define DSA_TAG_PROTO_QCA_ETYPE_VALUE		33
 
 enum dsa_tag_protocol {
 	DSA_TAG_PROTO_NONE		= DSA_TAG_PROTO_NONE_VALUE,
@@ -93,6 +94,7 @@ enum dsa_tag_protocol {
 	DSA_TAG_PROTO_MXL862		= DSA_TAG_PROTO_MXL862_VALUE,
 	DSA_TAG_PROTO_MXL862_8021Q	= DSA_TAG_PROTO_MXL862_8021Q_VALUE,
 	DSA_TAG_PROTO_OOB		= DSA_TAG_PROTO_OOB_VALUE,
+	DSA_TAG_PROTO_QCA_ETYPE		= DSA_TAG_PROTO_QCA_ETYPE_VALUE,
 };
 
 struct dsa_switch;
--- a/net/dsa/tag_qca.c
+++ b/net/dsa/tag_qca.c
@@ -11,17 +11,21 @@
 #include "tag.h"
 
 #define QCA_NAME "qca"
+#define QCA_ETYPE_NAME "qca-etype"
 
-static struct sk_buff *qca_tag_xmit(struct sk_buff *skb, struct net_device *dev)
+static struct sk_buff *__qca_tag_xmit(struct sk_buff *skb,
+				      struct net_device *dev, unsigned int len)
 {
 	struct dsa_port *dp = dsa_user_to_port(dev);
 	__be16 *phdr;
 	u16 hdr;
 
-	skb_push(skb, QCA_HDR_LEN);
+	skb_push(skb, len);
 
-	dsa_alloc_etype_header(skb, QCA_HDR_LEN);
+	dsa_alloc_etype_header(skb, len);
 	phdr = dsa_etype_header_pos_tx(skb);
+	if (len == QCA_ETYPE_HDR_LEN)
+		*phdr++ = htons(QCA_HDR_ETYPE);
 
 	/* Set the version field, and set destination port information */
 	hdr = FIELD_PREP(QCA_HDR_XMIT_VERSION, QCA_HDR_VERSION);
@@ -33,7 +37,19 @@ static struct sk_buff *qca_tag_xmit(stru
 	return skb;
 }
 
-static struct sk_buff *qca_tag_rcv(struct sk_buff *skb, struct net_device *dev)
+static struct sk_buff *qca_tag_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	return __qca_tag_xmit(skb, dev, QCA_HDR_LEN);
+}
+
+static struct sk_buff *qca_etype_tag_xmit(struct sk_buff *skb,
+					  struct net_device *dev)
+{
+	return __qca_tag_xmit(skb, dev, QCA_ETYPE_HDR_LEN);
+}
+
+static struct sk_buff *__qca_tag_rcv(struct sk_buff *skb,
+				     struct net_device *dev, unsigned int len)
 {
 	struct qca_tagger_data *tagger_data;
 	struct dsa_port *dp = dev->dsa_ptr;
@@ -47,10 +63,15 @@ static struct sk_buff *qca_tag_rcv(struc
 
 	tagger_data = ds->tagger_data;
 
-	if (unlikely(!pskb_may_pull(skb, QCA_HDR_LEN)))
+	if (unlikely(!pskb_may_pull(skb, len)))
 		return NULL;
 
 	phdr = dsa_etype_header_pos_rx(skb);
+	if (len == QCA_ETYPE_HDR_LEN) {
+		if (ntohs(*phdr) != QCA_HDR_ETYPE)
+			return NULL;
+		phdr++;
+	}
 	hdr = ntohs(*phdr);
 
 	/* Make sure the version is correct */
@@ -61,6 +82,17 @@ static struct sk_buff *qca_tag_rcv(struc
 	/* Get pk type */
 	pk_type = FIELD_GET(QCA_HDR_RECV_TYPE, hdr);
 
+	/* Register and MIB frames carry the type as well. Drop it, so that
+	 * their handlers see the layout of the plain header.
+	 */
+	if (len == QCA_ETYPE_HDR_LEN &&
+	    (pk_type == QCA_HDR_RECV_TYPE_RW_REG_ACK ||
+	     pk_type == QCA_HDR_RECV_TYPE_MIB)) {
+		skb_pull(skb, QCA_ETYPE_HDR_LEN - QCA_HDR_LEN);
+		dsa_strip_etype_header(skb, QCA_ETYPE_HDR_LEN - QCA_HDR_LEN);
+		skb_set_mac_header(skb, -ETH_HLEN);
+	}
+
 	/* Ethernet mgmt read/write packet */
 	if (pk_type == QCA_HDR_RECV_TYPE_RW_REG_ACK) {
 		if (likely(tagger_data->rw_reg_ack_handler))
@@ -83,12 +115,23 @@ static struct sk_buff *qca_tag_rcv(struc
 		return NULL;
 
 	/* Remove QCA tag and recalculate checksum */
-	skb_pull_rcsum(skb, QCA_HDR_LEN);
-	dsa_strip_etype_header(skb, QCA_HDR_LEN);
+	skb_pull_rcsum(skb, len);
+	dsa_strip_etype_header(skb, len);
 
 	return skb;
 }
 
+static struct sk_buff *qca_tag_rcv(struct sk_buff *skb, struct net_device *dev)
+{
+	return __qca_tag_rcv(skb, dev, QCA_HDR_LEN);
+}
+
+static struct sk_buff *qca_etype_tag_rcv(struct sk_buff *skb,
+					 struct net_device *dev)
+{
+	return __qca_tag_rcv(skb, dev, QCA_ETYPE_HDR_LEN);
+}
+
 static int qca_tag_connect(struct dsa_switch *ds)
 {
 	struct qca_tagger_data *tagger_data;
@@ -119,8 +162,29 @@ static const struct dsa_device_ops qca_n
 	.promisc_on_conduit = true,
 };
 
+DSA_TAG_DRIVER(qca_netdev_ops);
+
+static const struct dsa_device_ops qca_etype_netdev_ops = {
+	.name	= QCA_ETYPE_NAME,
+	.proto	= DSA_TAG_PROTO_QCA_ETYPE,
+	.connect = qca_tag_connect,
+	.disconnect = qca_tag_disconnect,
+	.xmit	= qca_etype_tag_xmit,
+	.rcv	= qca_etype_tag_rcv,
+	.needed_headroom = QCA_ETYPE_HDR_LEN,
+	.promisc_on_conduit = true,
+};
+
+DSA_TAG_DRIVER(qca_etype_netdev_ops);
+
+static struct dsa_tag_driver *dsa_tag_driver_array[] = {
+	&DSA_TAG_DRIVER_NAME(qca_netdev_ops),
+	&DSA_TAG_DRIVER_NAME(qca_etype_netdev_ops),
+};
+
 MODULE_DESCRIPTION("DSA tag driver for Qualcomm Atheros QCA8K switches");
 MODULE_LICENSE("GPL");
 MODULE_ALIAS_DSA_TAG_DRIVER(DSA_TAG_PROTO_QCA, QCA_NAME);
+MODULE_ALIAS_DSA_TAG_DRIVER(DSA_TAG_PROTO_QCA_ETYPE, QCA_ETYPE_NAME);
 
-module_dsa_tag_driver(qca_netdev_ops);
+module_dsa_tag_drivers(dsa_tag_driver_array);
