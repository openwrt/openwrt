From 0624e6ee1e3d6397774ecf1bd9942c3f8542c129 Mon Sep 17 00:00:00 2001
From: Alexey Immoreev <github@luixo.me>
Date: Thu, 19 Nov 2026 12:44:45 +0000
Subject: [PATCH] remoteproc: qcom_q6v5_mpd: index user PD slots from zero

User PD ASIDs are one-based, but the host slot array is zero-based.
An unadjusted index leaves the first slot empty and can put a child outside
the array that boot-info construction and resource release iterate over.

Reject ASIDs outside the supported range before requesting inbound
interrupts, and subtract one only when storing the child in the host
array. Keep the PD IDs used by interrupts and firmware unchanged.

Signed-off-by: Alexey Immoreev <github@luixo.me>
---
--- a/drivers/remoteproc/qcom_q6v5_mpd.c
+++ b/drivers/remoteproc/qcom_q6v5_mpd.c
@@ -659,6 +659,9 @@ static int init_irq(struct qcom_q6v5 *q6
 
 	/* Get pd_asid to prepare interrupt names */
 	upd->pd_asid = qcom_get_pd_asid(rproc);
+	if (!upd->pd_asid || upd->pd_asid > MAX_UPD)
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "invalid userpd ASID %u\n", upd->pd_asid);
 
 	ret = q6_get_inbound_irq(q6, pdev, "fatal", 0, &q6->fatal_irq,
 				 q6v5_fatal_interrupt);
@@ -753,7 +756,8 @@ static int q6_register_userpd(struct q6_
 	if (ret)
 		goto free_rproc;
 
-	wcss->upd[upd->pd_asid] = upd;
+	/* User PD IDs are one-based; the three storage slots are not. */
+	wcss->upd[upd->pd_asid - 1] = upd;
 	platform_set_drvdata(userpd_pdev, rproc);
 	qcom_add_ssr_subdev(rproc, &upd->ssr_subdev, userpd_pdev->name);
 	return 0;
