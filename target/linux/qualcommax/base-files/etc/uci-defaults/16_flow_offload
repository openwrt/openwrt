#!/bin/sh

# The PPE offloads routed and NAT flows through the flowtable.
[ -d /sys/bus/platform/drivers/qca-ppe ] || exit 0
uci -q get firewall.@defaults[0].flow_offloading >/dev/null && exit 0

uci -q batch << EOT
  set firewall.@defaults[0].flow_offloading='1'
  set firewall.@defaults[0].flow_offloading_hw='1'
  commit firewall
EOT
