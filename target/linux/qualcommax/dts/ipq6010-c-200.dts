/dts-v1/;

#include "ipq6018.dtsi"
#include "ipq6018-ess.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Arista C-200";
	compatible = "arista,c-200", "qcom,ipq6018";

	aliases {
		serial0 = &blsp1_uart3;
		label-mac-device = &port_lan1;
		led-boot = &led_power_red;
		led-failsafe = &led_power_red;
		led-running = &led_power_green;
		led-upgrade = &led_power_red;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " ubi.mtd=rootfs root=/dev/ubiblock0_1";
	};

	keys {
		compatible = "gpio-keys";

		reset-button {
			label = "reset";
			gpios = <&tlmm 19 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power_green: led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
		};

		led_power_red: led-1 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
		};

		led-2 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN_2GHZ;
			gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
		};

		led-3 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WLAN_2GHZ;
			gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
		};

		led-4 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN_5GHZ;
			gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>;
		};

		led-5 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WLAN_5GHZ;
			gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
		};

		led-6 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>;
		};

		led-7 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_LAN;
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
		};
	};
};

&blsp1_uart3 {
	pinctrl-0 = <&serial_3_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&rpm {
	status = "disabled";
};

&tlmm {
	/* TZ has exclusive control over GPIO20 */
	gpio-reserved-ranges = <20 1>;

	mdio_pins: mdio-pins {
		mdc {
			pins = "gpio64";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio65";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	/* the TPM's SPI (QUP 2), chip select on GPIO 70 */
	tpm_spi_pins: tpm-spi-state {
		spi {
			pins = "gpio69", "gpio71", "gpio72";
			function = "blsp1_spi";
			drive-strength = <8>;
			bias-pull-down;
		};

		cs {
			pins = "gpio70";
			function = "blsp1_spi";
			drive-strength = <8>;
			bias-disable;
		};
	};

	/* the TPM is held in reset until GPIO 79 is driven high */
	tpm-reset-hog {
		gpio-hog;
		gpios = <79 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "tpm-reset";
	};

	spi_0_pins: spi-0-state {
		pins = "gpio38", "gpio39", "gpio40", "gpio41";
		function = "blsp0_spi";
		drive-strength = <8>;
		bias-pull-down;
	};
};

&edma {
	status = "okay";
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
	reset-delay-us = <10000>;
	reset-post-delay-us = <50000>;

	ar8033: ethernet-phy@6 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <6>;
	};
};

&switch {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			ethernet = <&edma>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		/* the one port, PoE in */
		port_lan1: port@1 {
			reg = <1>;
			label = "lan1";
			phy-handle = <&ar8033>;
			nvmem-cells = <&macaddr_art_18>;
			nvmem-cell-names = "mac-address";
			phy-mode = "sgmii";
			pcs-handle = <&uniphy0 0>;
		};
	};
};

&uniphy0 {
	status = "okay";
};

/* the stock firmware's NOR layout; its kernels are in HL_backup0 and 1 */
&blsp1_spi1 {
	pinctrl-0 = <&spi_0_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x0 0xc0000>;
				read-only;
			};

			partition@c0000 {
				label = "0:MIBIB";
				reg = <0xc0000 0x10000>;
				read-only;
			};

			partition@d0000 {
				label = "0:BOOTCONFIG";
				reg = <0xd0000 0x20000>;
				read-only;
			};

			partition@f0000 {
				label = "0:BOOTCONFIG1";
				reg = <0xf0000 0x20000>;
				read-only;
			};

			partition@110000 {
				label = "0:QSEE";
				reg = <0x110000 0x1a0000>;
				read-only;
			};

			partition@2b0000 {
				label = "0:QSEE_1";
				reg = <0x2b0000 0x1a0000>;
				read-only;
			};

			partition@450000 {
				label = "0:DEVCFG";
				reg = <0x450000 0x10000>;
				read-only;
			};

			partition@460000 {
				label = "0:DEVCFG_1";
				reg = <0x460000 0x10000>;
				read-only;
			};

			partition@470000 {
				label = "0:RPM";
				reg = <0x470000 0x40000>;
				read-only;
			};

			partition@4b0000 {
				label = "0:RPM_1";
				reg = <0x4b0000 0x40000>;
				read-only;
			};

			partition@4f0000 {
				label = "0:CDT";
				reg = <0x4f0000 0x10000>;
				read-only;
			};

			partition@500000 {
				label = "0:CDT_1";
				reg = <0x500000 0x10000>;
				read-only;
			};

			partition@510000 {
				label = "0:APPSBLENV";
				reg = <0x510000 0x10000>;
			};

			partition@520000 {
				label = "0:APPSBL";
				reg = <0x520000 0x100000>;
				read-only;
			};

			partition@620000 {
				label = "0:APPSBL_1";
				reg = <0x620000 0x100000>;
				read-only;
			};

			partition@720000 {
				label = "0:ART";
				reg = <0x720000 0x40000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_art_18: macaddr@18 {
						reg = <0x18 0x6>;
					};

					caldata_ipq6018: calibration@1000 {
						reg = <0x1000 0x10000>;
					};
				};
			};

			partition@760000 {
				label = "HL_backup0";
				reg = <0x760000 0x800000>;
				read-only;
			};

			partition@f60000 {
				label = "HL_backup1";
				reg = <0xf60000 0x800000>;
				read-only;
			};

			partition@1760000 {
				label = "CONFIG";
				reg = <0x1760000 0x400000>;
				read-only;
			};

			partition@1b60000 {
				label = "LOGGING";
				reg = <0x1b60000 0x100000>;
				read-only;
			};

			partition@1c60000 {
				label = "DEVCERT";
				reg = <0x1c60000 0x20000>;
				read-only;
			};

			partition@1c80000 {
				label = "RESERVED";
				reg = <0x1c80000 0x380000>;
				read-only;
			};
		};
	};
};

&blsp1_spi2 {
	pinctrl-0 = <&tpm_spi_pins>;
	pinctrl-names = "default";
	status = "okay";

	tpm@1 {
		compatible = "tcg,tpm_tis-spi";
		reg = <1>;
		spi-max-frequency = <500000>;
	};
};

&wifi {
	status = "okay";
	qcom,calibration-variant = "Arista-C200";
	nvmem-cells = <&caldata_ipq6018>;
	nvmem-cell-names = "calibration";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	/* absorbs the partitions the bootloader adds at boot */
	partitions {
		status = "disabled";
	};

	nand@0 {
		reg = <0>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* the stock firmware's first slot */
			partition@0 {
				label = "rootfs";
				reg = <0x0 0x10000000>;
				linux,rootfs;
			};

			/* the stock firmware's second slot, kept as a fallback */
			partition@10000000 {
				label = "rootfs_1";
				reg = <0x10000000 0x10000000>;
				read-only;
			};
		};
	};
};
