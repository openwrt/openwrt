/dts-v1/;

#include "ipq8074.dtsi"
#include "ipq8074-hk-cpu.dtsi"
#include "ipq8074-ess.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Spectrum SAX1V1K";
	compatible = "spectrum,sax1v1k", "qcom,ipq8074";

	aliases {
		led-boot = &led_system_red;
		led-failsafe = &led_system_red;
		led-running = &led_system_blue;
		led-upgrade = &led_system_red;
		serial0 = &blsp1_uart5;
		/* Aliases as required by u-boot to patch MAC addresses */
		ethernet0 = &swport6;
		ethernet1 = &swport4;
		ethernet2 = &swport3;
		ethernet3 = &swport2;
		label-mac-device = &swport6;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		wps {
			label = "wps";
			gpios = <&tlmm 63 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_system_blue: system-blue {
			gpios = <&tlmm 26 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
		};

		led_system_red: system-red {
			gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
		};

		system-green {
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
		};
	};

	/*
	 * The fan's speed input is on GPIO 27 (high = full speed). The SoC's
	 * PWM block can drive that pin, but it is not supported on IPQ807x
	 * yet, so use software PWM on the GPIO.
	 */
	fan_pwm: pwm-gpio {
		compatible = "pwm-gpio";
		gpios = <&tlmm 27 GPIO_ACTIVE_HIGH>;
		#pwm-cells = <3>;
	};

	fan: pwm-fan {
		compatible = "pwm-fan";
		pwms = <&fan_pwm 0 1000000 0>;
		#cooling-cells = <2>;
		cooling-levels = <0 77 153 255>;
		/* tachometer on GPIO 29, two pulses per revolution */
		pinctrl-0 = <&fan_tach_pins>;
		pinctrl-names = "default";
		interrupts-extended = <&tlmm 29 IRQ_TYPE_EDGE_FALLING>;
		pulses-per-revolution = <2>;
	};
};

&cluster_thermal {
	polling-delay = <2000>;

	trips {
		cluster_fan_low: cluster-fan-low {
			temperature = <50000>;
			hysteresis = <3000>;
			type = "active";
		};

		cluster_fan_mid: cluster-fan-mid {
			temperature = <65000>;
			hysteresis = <3000>;
			type = "active";
		};

		cluster_fan_high: cluster-fan-high {
			temperature = <80000>;
			hysteresis = <3000>;
			type = "active";
		};
	};

	cooling-maps {
		map0 {
			trip = <&cluster_fan_low>;
			cooling-device = <&fan 1 1>;
		};

		map1 {
			trip = <&cluster_fan_mid>;
			cooling-device = <&fan 2 2>;
		};

		map2 {
			trip = <&cluster_fan_high>;
			cooling-device = <&fan 3 3>;
		};
	};
};

&tlmm {
	button_pins: button-pins {
		reset-pins {
			pins = "gpio34";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};

		wps-pins {
			pins = "gpio63";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	fan_tach_pins: fan-tach-pins {
		pins = "gpio29";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	mdio_pins: mdio-pins {
		mdc {
			pins = "gpio68";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio69";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&blsp1_uart5 {
	status = "okay";
};

&prng {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&mdio {
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;
	status = "okay";

	ethernet-phy-package@0 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "qcom,qca8075-package";
		reg = <0>;

		qcom,package-mode = "qsgmii";

		qca8075_1: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
		};

		qca8075_2: ethernet-phy@2 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <2>;
		};

		qca8075_3: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;
		};
	};

	qca8081: ethernet-phy@28 {
		compatible = "ethernet-phy-id004d.d101";
		reg = <28>;
		reset-gpios = <&tlmm 44 GPIO_ACTIVE_LOW>;
		reset-deassert-us = <10000>;

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_YELLOW>;
				function = LED_FUNCTION_WAN;
				default-state = "keep";
				active-low;
			};

			led@2 {
				reg = <2>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_WAN;
				default-state = "keep";
				active-low;
			};
		};
	};
};

&sdhc_1 {
	/* Following same rule as QNAP 301W
	 * the emmc has a problem with the hs400 > hs200 speed switch.
	 * Therefore remove the mmc-hs400-1_8v property
	*/
	/delete-property/ mmc-hs400-1_8v;
	mmc-hs200-1_8v;
	mmc-ddr-1_8v;
	vqmmc-supply = <&l11>;
	status = "okay";
};

&uniphy0 {
	status = "okay";
};

&uniphy2 {
	status = "okay";
};

&switch {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			ethernet = <&edma>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		swport2: port@2 {
			reg = <2>;
			label = "lan3";
			phy-handle = <&qca8075_1>;
			phy-mode = "qsgmii";
			pcs-handle = <&uniphy0 1>;
		};

		swport3: port@3 {
			reg = <3>;
			label = "lan2";
			phy-handle = <&qca8075_2>;
			phy-mode = "qsgmii";
			pcs-handle = <&uniphy0 2>;
		};

		swport4: port@4 {
			reg = <4>;
			label = "lan1";
			phy-handle = <&qca8075_3>;
			phy-mode = "qsgmii";
			pcs-handle = <&uniphy0 3>;
		};

		swport6: port@6 {
			reg = <6>;
			label = "wan";
			phy-handle = <&qca8081>;
			phy-mode = "2500base-x";
			pcs-handle = <&uniphy2 0>;
		};
	};
};

&edma {
	status = "okay";
};

&wifi {
	qcom,calibration-variant = "Spectrum-SAX1V1K";
	status = "okay";
};
