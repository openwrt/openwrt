/dts-v1/;

#include "ipq5018-xiaomi-base.dtsi"
#include "ipq5018-qcn6122.dtsi"

/ {
	model = "Xiaomi CR8818";
	compatible = "xiaomi,cr8818", "qcom,ipq5018";

	aliases {
		label-mac-device = &gmac0;
		led-boot = &led_system_blue;
		led-failsafe = &led_system_red;
		led-running = &led_system_blue;
		led-upgrade = &led_system_red;
	};

	keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		mesh-button {
			label = "mesh";
			gpios = <&tlmm 28 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_0>;
		};
	};

	leds {
		compatible = "gpio-leds";

		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_system_blue: system-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
			gpio = <&tlmm 24 GPIO_ACTIVE_HIGH>;
		};

		led_system_red: system-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
			gpio = <&tlmm 25 GPIO_ACTIVE_HIGH>;
		};

		led_internet_blue: internet-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN;
			gpio = <&tlmm 26 GPIO_ACTIVE_HIGH>;
		};

		led_internet_red: internet-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpio = <&tlmm 27 GPIO_ACTIVE_HIGH>;
		};
	};
};

&art {
	nvmem-layout {
		compatible = "fixed-layout";
		#address-cells = <1>;
		#size-cells = <1>;

		mac_addr_gmac0: macaddr@0 {
			reg = <0x0 0x6>;
		};

		mac_addr_gmac1: macaddr@6 {
			reg = <0x6 0x6>;
		};
	};
};

/*
* ===============================================================
*     _______________________             _____________________
*    |        IPQ5018        |           |        YT9215       |
*    | +------+   +--------+ |           | +------+   +------+ |
*    | | MAC0 |---| GE Phy |-+--- MDI ---+ | Phy4 |---| Phy0 | |
*    | +------+   +--------+ |           | +------+   | Phy1 | |
*    | +------+   +--------+ |           | +------+   | Phy2 | |
*    | | MAC1 |---| Uniphy |-+-- SGMII+--+ | Phy8 |---| Phy3 | |
*    | +------+   +--------+ |           | +------+   +------+ |
*    |_______________________|           |_____________________|
*
* ===============================================================
*/

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_50MHZ>;
};

// MAC0 -> GE Phy
&gmac0 {
	status = "okay";

	label = "wan";

	nvmem-cells = <&mac_addr_gmac0 0>;
	nvmem-cell-names = "mac-address";
};

// MAC1 --- SGMII+ ---> YT9215 Phy8
&gmac1 {
	status = "okay";

	phy-mode = "2500base-x";

	nvmem-cells = <&mac_addr_gmac1 0>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <2500>;
		full-duplex;
		pause;
		asym-pause;
	};
};

&mdio0 {
	status = "okay";
};

// IPQ5018 GE Phy -> YT9215 Phy4
&ge_phy {
	qcom,dac-preset-short-cable;
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;

	// YT9215 switch
	ethernet-switch@1d {
		compatible = "motorcomm,yt9215";
		reg = <0x1d>;

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			sw_phy0: phy@0 {
				reg = <0x0>;
			};

			sw_phy1: phy@1 {
				reg = <0x1>;
			};

			sw_phy2: phy@2 {
				reg = <0x2>;
			};

			sw_phy3: phy@3 {
				reg = <0x3>;
			};

			sw_phy4: phy@4 {
				reg = <0x4>;
			};
		};

		ethernet-ports {
			ethernet-port@0 {
				reg = <0>;
				label = "lan1";
				phy-mode = "internal";
				phy-handle = <&sw_phy0>;
			};

			ethernet-port@1 {
				reg = <1>;
				label = "lan2";
				phy-mode = "internal";
				phy-handle = <&sw_phy1>;
			};

			ethernet-port@2 {
				reg = <2>;
				label = "lan3";
				phy-mode = "internal";
				phy-handle = <&sw_phy2>;
			};

			ethernet-port@3 {
				reg = <3>;
				label = "sw-wan";
				phy-mode = "internal";
				phy-handle = <&sw_phy3>;
			};

			ethernet-port@4 {
				reg = <4>;
				label = "sw-cpu";
				phy-mode = "internal";
				phy-handle = <&sw_phy4>;
			};

			ethernet-port@8 {
				reg = <8>;
				phy-mode = "2500base-x";
				ethernet = <&gmac1>;

				fixed-link {
					speed = <2500>;
					full-duplex;
					pause;
					asym-pause;
				};
			};
		};
	};
};

&tlmm {
	button_pins: button-state {
		pins = "gpio38", "gpio28";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	leds_pins: leds-state {
		pins = "gpio24", "gpio25", "gpio26", "gpio27";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};
};

/*
 * ath11k Wi-Fi consumes too large memory spaces and too few spaces are
 * available for users. To prevent OOM when using LuCI or other softwares,
 * disable Wi-Fi related peripherals at the moment.
 */
&wifi {
	status = "disabled";

	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-calibration-variant = "Xiaomi-CR8818";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	status = "disabled";

	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-calibration-variant = "Xiaomi-CR8818";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};
