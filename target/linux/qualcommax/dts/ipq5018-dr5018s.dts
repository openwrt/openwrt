/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Wallys DR5018S";
	compatible = "wallys,dr5018s", "qcom,ipq5018";

	aliases {
		/* Required by U-Boot to patch the Ethernet MAC addresses. */
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		label-mac-device = &gmac0;
		led-boot = &led_status_0;
		led-failsafe = &led_status_0;
		led-running = &led_status_0;
		led-upgrade = &led_status_0;
		serial0 = &blsp1_uart1;
	};

	chosen {
		bootargs-append = " ubi.mtd=rootfs root=/dev/ubiblock0_1 rootwait swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_status_0: led-0 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <0>;
			gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-1 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <1>;
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-2 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <2>;
			gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-3 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <3>;
			gpios = <&tlmm 26 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&blsp1_spi1 {
	status = "okay";
	pinctrl-0 = <&spi_pins>;
	pinctrl-names = "default";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "0:MIBIB";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				label = "0:BOOTCONFIG";
				reg = <0x40000 0x10000>;
				read-only;
			};

			partition@50000 {
				label = "0:BOOTCONFIG1";
				reg = <0x50000 0x10000>;
				read-only;
			};

			partition@60000 {
				label = "0:QSEE";
				reg = <0x60000 0xa0000>;
				read-only;
			};

			partition@100000 {
				label = "0:QSEE_1";
				reg = <0x100000 0xa0000>;
				read-only;
			};

			partition@1a0000 {
				label = "0:DEVCFG";
				reg = <0x1a0000 0x10000>;
				read-only;
			};

			partition@1b0000 {
				label = "0:DEVCFG_1";
				reg = <0x1b0000 0x10000>;
				read-only;
			};

			partition@1c0000 {
				label = "0:CDT";
				reg = <0x1c0000 0x10000>;
				read-only;
			};

			partition@1d0000 {
				label = "0:CDT_1";
				reg = <0x1d0000 0x10000>;
				read-only;
			};

			partition@1e0000 {
				label = "0:APPSBLENV";
				reg = <0x1e0000 0x10000>;
			};

			partition@1f0000 {
				label = "0:APPSBL";
				reg = <0x1f0000 0xa0000>;
				read-only;
			};

			partition@290000 {
				label = "0:APPSBL_1";
				reg = <0x290000 0xa0000>;
				read-only;
			};

			partition@330000 {
				label = "0:ART";
				reg = <0x330000 0x70000>;
				read-only;
			};
		};
	};
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-step-size = <512>;
		nand-ecc-strength = <8>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:TRAINING";
				reg = <0x0 0x80000>;
				read-only;
			};

			partition@80000 {
				label = "rootfs";
				reg = <0x80000 0x3e00000>;
				linux,rootfs;
			};

			partition@3e80000 {
				label = "rootfs_1";
				reg = <0x3e80000 0x3e00000>;
			};
		};
	};
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_50MHZ>;
};

&gmac0 {
	status = "okay";

	label = "lan";
};

&gmac1 {
	status = "okay";

	phy-handle = <&qca8081>;
	phy-mode = "2500base-x";
	label = "wan";
};

&mdio0 {
	status = "okay";
};

&ge_phy {
	qcom,dac-preset-short-cable;
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	qca8081: ethernet-phy@28 {
		compatible = "ethernet-phy-id004d.d101";
		reg = <28>;
		reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
		reset-deassert-us = <10000>;
	};
};

&tlmm {
	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		bias-disable;
	};

	button_pins: button-state {
		pins = "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	led_pins: led-state {
		pins = "gpio23", "gpio24", "gpio25", "gpio26";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	spi_pins: spi-state {
		pins = "gpio10", "gpio11", "gpio12", "gpio13";
		function = "blsp0_spi";
		drive-strength = <8>;
		bias-disable;
	};
};

&q6_region {
	reg = <0x0 0x4b000000 0x0 0x4d00000>;
};

&wifi {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd1>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";
	qcom,ath11k-calibration-variant = "Wallys-DR5018S-2G";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-calibration-variant = "Wallys-DR5018S-5G";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};

&wifi2 {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd3>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd3";
	qcom,ath11k-calibration-variant = "Wallys-DR5018S-6G";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4e500000>;
	qcom,m3-dump-addr = <0x4f200000>;
};

&usb {
	dr_mode = "host";
	maximum-speed = "high-speed";
	phys = <&usbphy0>;
	phy-names = "usb2-phy";
	qcom,select-utmi-as-pipe-clk;

	status = "okay";
};

&usbphy0 {
	status = "okay";
};
