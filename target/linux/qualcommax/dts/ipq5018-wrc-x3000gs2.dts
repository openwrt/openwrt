#include "ipq5018-wrc-x3000.dtsi"

/ {
	model = "ELECOM WRC-X3000GS2";
	compatible = "elecom,wrc-x3000gs2", "qcom,ipq5018";

	reserved-memory {
		q6_region_qcn6122_1: q6-region-qcn6122-1@4d200000 {
			reg = <0x0 0x4d200000 0x0 0xd00000>;
			no-map;

			status = "disabled";
		};

		m3_dump_qcn6122_1: m3-dump-qcn6122-1@4df00000 {
			reg = <0x0 0x4df00000 0x0 0x100000>;
			no-map;

			status = "disabled";
		};
	};
};

/*
 * ath11k Wi-Fi consumes too large memory spaces and too few spaces are
 * available for users. To prevent OOM when using LuCI or other softwares,
 * disable Wi-Fi related peripherals at the moment.
 */
&q6_region {
	status = "disabled";
};

&q6_region_ipq5018 {
	status = "disabled";
};

&m3_dump_ipq5018 {
	status = "disabled";
};

&q6v5_wcss {
	status = "disabled";
};

&wifi {
	status = "disabled";

	qcom,ath11k-fw-memory-mode = <2>;
};

&wifi1 {
	status = "disabled";

	qcom,ath11k-fw-memory-mode = <2>;
};
