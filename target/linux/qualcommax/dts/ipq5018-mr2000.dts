/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-mx-base.dtsi"
#include "ipq5018-qcn6122.dtsi"

/ {
	model = "Linksys MR2000";
	compatible = "linksys,mr2000", "qcom,ipq5018";

	chosen {
		bootargs-append = " root=/dev/ubiblock0_0 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	gpio-leds {
		compatible = "gpio-leds";

		usb {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_USB;
			gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
			trigger-sources = <&usb_port1>;
			linux,default-trigger = "usbport";
		};
	};

	regulator_fixed_5p0: regulator-s0500 {
		compatible = "regulator-fixed";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-name = "fixed_5p0";
		gpios = <&tlmm 28 GPIO_ACTIVE_LOW>;
	};
};

/*
 * ===============================================================
 *     _______________________         _______________________
 *    |        IPQ5018        |       |        QCA8337        |
 *    | +------+   +--------+ |       | +--------+   +------+ |
 *    | | MAC0 |---| GE Phy | |       | |  Phy0  |---| MAC1 | |
 *    | +------+   +--------+ |       | +--------+   +------+ |
 *    | +------+   +--------+ |       | +--------+   +------+ |
 *    | | MAC1 |---| Uniphy |-+-SGMII-+-| SerDes |---| MAC6 | |
 *    | +------+   +--------+ |       | +--------+   +------+ |
 *    |_______________________|       |_______________________|
 *
 * ===============================================================
 */

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;
};

/* WAN: IPQ5018 MAC0 -> internal GE PHY7 */
&gmac0 {
	status = "okay";
	label = "wan";

	nvmem-cells = <&hw_mac_addr 0>;
	nvmem-cell-names = "mac-address";
};

&mdio0 {
	status = "okay";
};

/* LAN: IPQ5018 MAC1 -> SGMII -> QCA8337 port 6 */
&gmac1 {
	status = "okay";
	phy-mode = "sgmii";

	nvmem-cells = <&hw_mac_addr 0>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;

	qca8337_0: ethernet-phy@0 {
		reg = <0>;
	};

	qca8337_1: ethernet-phy@1 {
		reg = <1>;
	};

	qca8337_2: ethernet-phy@2 {
		reg = <2>;
	};

	qca8337_3: ethernet-phy@3 {
		reg = <3>;
	};

	switch1: ethernet-switch@17 {
		compatible = "qca,qca8337";
		reg = <17>;
		#address-cells = <1>;
		#size-cells = <0>;

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-port@1 {
				reg = <1>;
				label = "lan1";
				phy-handle = <&qca8337_0>;
			};

			ethernet-port@2 {
				reg = <2>;
				label = "lan2";
				phy-handle = <&qca8337_1>;
			};

			ethernet-port@3 {
				reg = <3>;
				label = "lan3";
				phy-handle = <&qca8337_2>;
			};

			ethernet-port@4 {
				reg = <4>;
				label = "lan4";
				phy-handle = <&qca8337_3>;
			};

			ethernet-port@6 {
				reg = <6>;
				label = "cpu";
				phy-mode = "sgmii";
				ethernet = <&gmac1>;
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

&q6v5_wcss {
	/* The QCN6102 radio should map to UPD ID 2. Without       */
	/* bootargs, the firmware will expect it to be on UPD ID 3 */
	boot-args = <
			/*       type:	*/	0x1	/* PCIE0	*/
			/*     length:	*/	4
			/*     UPD ID:	*/	2
			/* reset GPIO:	*/	15
			/*   reserved:	*/	0 0>;
};

&wifi {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-calibration-variant = "Linksys-MX2000";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-calibration-variant = "Linksys-MX2000";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};

&{/keys/wps-button} {
	gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
};

&{/keys/reset-button} {
	gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
};

&{/leds/green} {
	color = <LED_COLOR_ID_BLUE>;
};

&{/leds/blue} {
	color = <LED_COLOR_ID_GREEN>;
};

&tlmm {
	button_pins: button-state {
		pins = "gpio26", "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};
};

&usbphy0 {
	status = "okay";
	vdd-supply = <&regulator_fixed_5p0>;
};

&usbphy1 {
	status = "okay";
	vdd-supply = <&regulator_fixed_5p0>;
};

&usb {
	#address-cells = <1>;
	#size-cells = <0>;

	vbus-supply = <&regulator_fixed_5p0>;
	dr_mode = "host";

	status = "okay";

	usb_port1: port@1 {
		reg = <1>;
		#trigger-source-cells = <0>;
	};
};
