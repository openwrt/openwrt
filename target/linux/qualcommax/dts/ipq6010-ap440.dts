/dts-v1/;

#include "ipq6018.dtsi"
#include "ipq6018-cp-cpu.dtsi"
#include "ipq6018-ess.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Datto AP440";
	compatible = "datto,ap440", "qcom,ipq6018";

	aliases {
		serial0 = &blsp1_uart3;
		label-mac-device = &swport3;
		led-boot = &led_status_green;
		led-failsafe = &led_status_red;
		led-running = &led_status_green;
		led-upgrade = &led_status_blue;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " root=/dev/ubiblock0_1";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 57 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_status_green: status-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
		};

		led_status_blue: status-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
		};

		led_status_red: status-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
		};
	};

	watchdog {
		compatible = "linux,wdt-gpio";
		gpios = <&tlmm 68 GPIO_ACTIVE_LOW>;
		hw_algo = "toggle";
		/* hw_margin_ms is actually 300s but driver limits it to 60s */
		hw_margin_ms = <60000>;
		always-running;
	};

	regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};
};

&tlmm {
	button_pins: button-pins {
		pins = "gpio57";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	led_pins: led-pins {
		pins = "gpio22", "gpio23", "gpio24";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	mdio_pins: mdio-pins {
		mdc {
			pins = "gpio64";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio65";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	spi_0_pins: spi-0-pins {
		pins = "gpio38", "gpio39", "gpio40", "gpio41";
		function = "blsp0_spi";
		drive-strength = <8>;
		bias-pull-down;
	};
};

&blsp1_uart3 {
	pinctrl-0 = <&serial_3_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&blsp1_spi1 {
	pinctrl-0 = <&spi_0_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x00000000 0x000c0000>;
				read-only;
			};

			partition@c0000 {
				label = "0:MIBIB";
				reg = <0x000c0000 0x00010000>;
				read-only;
			};

			partition@d0000 {
				label = "0:QSEE";
				reg = <0x000d0000 0x001a0000>;
				read-only;
			};

			partition@270000 {
				label = "0:DEVCFG";
				reg = <0x00270000 0x00010000>;
				read-only;
			};

			partition@280000 {
				label = "0:RPM";
				reg = <0x00280000 0x00020000>;
				read-only;
			};

			partition@2a0000 {
				label = "0:CDT";
				reg = <0x002a0000 0x00010000>;
				read-only;
			};

			partition@2b0000 {
				label = "0:APPSBLENV";
				reg = <0x002b0000 0x00010000>;
			};

			partition@2c0000 {
				label = "0:APPSBL";
				reg = <0x002c0000 0x000a0000>;
				read-only;
			};

			partition@360000 {
				label = "0:ART";
				reg = <0x00360000 0x00040000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_art_0: macaddr@0 {
						reg = <0x0 0x6>;
					};

					macaddr_art_6: macaddr@6 {
						reg = <0x6 0x6>;
					};
				};
			};

			partition@3a0000 {
				label = "datto";
				reg = <0x003a0000 0x00030000>;
				read-only;
			};

			partition@3d0000 {
				label = "serial";
				reg = <0x003d0000 0x00030000>;
				read-only;
			};
		};
	};
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;

		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		/*
		 * The bootloader boots from firmware1 or firmware2 (see the
		 * "bootseq" U-Boot variable) and verifies the size and checksum
		 * of the kernel and rootfs UBI volumes before booting.
		 */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "firmware1";
				reg = <0x00000000 0x08000000>;
			};

			partition@8000000 {
				label = "firmware2";
				reg = <0x08000000 0x08000000>;
			};

			partition@10000000 {
				label = "shared";
				reg = <0x10000000 0x10000000>;
			};
		};
	};
};

&mdio {
	status = "okay";

	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
	reset-delay-us = <10000>;
	reset-post-delay-us = <50000>;

	ethernet-phy-package@0 {
		compatible = "qcom,qca8075-package";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;

		qcom,package-mode = "psgmii";

		qca8072_3: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;
		};

		qca8072_4: ethernet-phy@4 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <4>;
		};
	};
};

&uniphy0 {
	status = "okay";
};

&switch {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			ethernet = <&edma>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		swport3: port@3 {
			reg = <3>;
			label = "wan";
			phy-handle = <&qca8072_4>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 4>;
			nvmem-cells = <&macaddr_art_0>;
			nvmem-cell-names = "mac-address";
		};

		swport4: port@4 {
			reg = <4>;
			label = "lan";
			phy-handle = <&qca8072_3>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 3>;
			nvmem-cells = <&macaddr_art_6>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&edma {
	status = "okay";
};

&qusb_phy_0 {
	status = "okay";
};

&qusb_phy_1 {
	status = "okay";
};

&ssphy_0 {
	status = "okay";
};

&usb2 {
	dr_mode = "host";
	status = "okay";
};

&usb3 {
	dr_mode = "host";
	status = "okay";
};

&wifi {
	status = "okay";

	qcom,calibration-variant = "Datto-AP440";
};

/*
 * The QCA9889 on PCIe is used by the stock firmware for passive scanning
 * only ("qcom,ath10k-all-channels-no-ir"). As the upstream ath10k driver
 * can not enforce this restriction, PCIe is left disabled.
 */
