/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Ubiquiti UniFi 6 Pro";
	compatible = "ubnt,unifi-6-pro", "qcom,ipq5018";

	aliases {
		label-mac-device = &gmac0;
		serial0 = &blsp1_uart1;
		led-boot = &led_white;
		led-failsafe = &led_white;
		led-running = &led_blue;
		led-upgrade = &led_blue;
	};

	chosen {
		/* kernel in slot 1 (0:HLOS_1), rootfs in the "log"
		 * partition; U-Boot passes no root=
		 */
		bootargs-append = " root=/dev/mmcblk0p5 rootwait coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_white: led-0 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_WHITE>;
			gpios = <&tlmm 2 GPIO_ACTIVE_HIGH>;
		};

		led_blue: led-1 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 3 GPIO_ACTIVE_HIGH>;
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&blsp1_spi1 {
	status = "okay";

	pinctrl-0 = <&spi_pins>;
	pinctrl-names = "default";

	/* Macronix MX25U6435F, 8 MiB */
	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "SBL1";
				reg = <0x000000 0x030000>;
				read-only;
			};

			partition@30000 {
				label = "MIBIB";
				reg = <0x030000 0x010000>;
				read-only;
			};

			partition@40000 {
				label = "BOOTCONFIG";
				reg = <0x040000 0x010000>;
				read-only;
			};

			partition@50000 {
				label = "QSEE";
				reg = <0x050000 0x0a0000>;
				read-only;
			};

			partition@f0000 {
				label = "DEVCFG";
				reg = <0x0f0000 0x010000>;
				read-only;
			};

			partition@100000 {
				label = "CDT";
				reg = <0x100000 0x010000>;
				read-only;
			};

			partition@110000 {
				label = "u-boot-env";
				reg = <0x110000 0x010000>;
			};

			partition@120000 {
				label = "u-boot";
				reg = <0x120000 0x0a0000>;
				read-only;
			};

			partition@1c0000 {
				label = "ART";
				reg = <0x1c0000 0x070000>;
				read-only;
			};

			partition@230000 {
				label = "EEPROM";
				reg = <0x230000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_eeprom_0: macaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};
		};
	};
};

&sdhc_1 {
	status = "okay";

	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	max-frequency = <192000000>;
	bus-width = <4>;
};

&mdio0 {
	status = "okay";
};

/* no PHYs on MDIO1, but the GE PHY on MDIO0 only links while the MDIO1
 * AHB clock runs
 */
&mdio1 {
	status = "okay";
};

/* single RJ45 port with PoE input, IPQ5018 MAC0 -> internal GE PHY */
&gmac0 {
	status = "okay";

	label = "lan";

	nvmem-cells = <&macaddr_eeprom_0 0>;
	nvmem-cell-names = "mac-address";
};

&tlmm {
	button_pins: button-state {
		pins = "gpio24";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio9";
			function = "sdc1_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio8";
			function = "sdc1_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "sdc1_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	led_pins: led-state {
		pins = "gpio2", "gpio3";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		bias-disable;
	};

	spi_pins: spi-state {
		pins = "gpio10", "gpio11", "gpio12", "gpio13";
		function = "blsp0_spi";
		drive-strength = <8>;
		bias-disable;
	};
};

/* QCN9074, 5 GHz 4x4 */
&pcie0_phy {
	status = "okay";
};

&pcie0 {
	status = "okay";

	perst-gpios = <&tlmm 15 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";

			/* QCN9074: ath11k lacks DT compatible for PCI cards */
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;

			qcom,calibration-variant = "Ubiquiti-UniFi-6-Pro";
		};
	};
};

/* IPQ5018 internal radio, 2.4 GHz 2x2 */
&q6v5_wcss {
	firmware-name = "ath11k/IPQ5018/hw1.0/q6_fw.mdt",
			"ath11k/IPQ5018/hw1.0/m3_fw.mdt";
};

&wifi {
	status = "okay";

	qcom,rproc = <&q6v5_wcss>;
	qcom,calibration-variant = "Ubiquiti-UniFi-6-Pro";
	qcom,ath11k-fw-memory-mode = <1>;
};
