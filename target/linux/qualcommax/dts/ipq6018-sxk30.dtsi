#include "ipq6018.dtsi"
#include "ipq6018-cp-cpu.dtsi"
#include "ipq6018-512m.dtsi"
#include "ipq6018-ess.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	aliases {
		serial0 = &blsp1_uart3;
		led-boot = &led_status_white;
		led-failsafe = &led_status_red;
		led-running = &led_status_green;
		led-upgrade = &led_status_blue;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " ubi.mtd=ubi root=/dev/ubiblock0_1";
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&tlmm 19 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		wps {
			label = "wps";
			gpios = <&tlmm 57 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		power_green {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		power_red {
			function = LED_FUNCTION_FAULT;
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
			panic-indicator;
		};

		led_status_white: status_white {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_WHITE>;
			gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;
		};

		led_status_green: status_green {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 76 GPIO_ACTIVE_LOW>;
		};

		led_status_red: status_red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 77 GPIO_ACTIVE_LOW>;
		};

		led_status_blue: status_blue {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 78 GPIO_ACTIVE_LOW>;
		};
	};
};

&edma {
	status = "okay";
};

&uniphy0 {
	status = "okay";
};

&switch {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			ethernet = <&edma>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		swport2: port@2 {
			reg = <2>;
			phy-handle = <&phy1>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 1>;
		};

		swport3: port@3 {
			reg = <3>;
			phy-handle = <&phy2>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 2>;
			nvmem-cells = <&macaddr_lan>;
			nvmem-cell-names = "mac-address";
		};

		swport4: port@4 {
			reg = <4>;
			phy-handle = <&phy3>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 3>;
			nvmem-cells = <&macaddr_lan>;
			nvmem-cell-names = "mac-address";
		};

		swport5: port@5 {
			reg = <5>;
			phy-handle = <&phy4>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 4>;
			nvmem-cells = <&macaddr_lan>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&tlmm {
	mdio_pins: mdio-pins {
		mdc {
			pins = "gpio64";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio65";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&mdio {
	status = "okay";

	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
	reset-delay-us = <10000>;
	reset-post-delay-us = <50000>;

	ethernet-phy-package {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "qcom,qca8075-package";
		reg = <0>;

		qcom,package-mode = "psgmii";

		phy0: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0>;
		};

		phy1: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
		};

		phy2: ethernet-phy@2 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <2>;
		};

		phy3: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;
		};

		phy4: ethernet-phy@4 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <4>;
		};
	};
};

&blsp1_uart3 {
	pinctrl-0 = <&serial_3_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&prng {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		/*
		 * The SMEM partition table only covers the partitions up to
		 * 0:art. The vendor kernel hardcodes the remaining layout,
		 * which differs between SXR30 (512 MiB) and SXS30 (256 MiB)
		 * from 0x1b00000 on, see the board DTS.
		 */
		partitions: partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:sbl1";
				reg = <0x0000000 0x0180000>;
				read-only;
			};

			partition@180000 {
				label = "0:mibib";
				reg = <0x0180000 0x0100000>;
				read-only;
			};

			partition@280000 {
				label = "0:bootconfig";
				reg = <0x0280000 0x0080000>;
				read-only;
			};

			partition@300000 {
				label = "0:bootconfig1";
				reg = <0x0300000 0x0080000>;
				read-only;
			};

			partition@380000 {
				label = "0:qsee";
				reg = <0x0380000 0x0380000>;
				read-only;
			};

			partition@700000 {
				label = "0:qsee_1";
				reg = <0x0700000 0x0380000>;
				read-only;
			};

			partition@a80000 {
				label = "0:devcfg";
				reg = <0x0a80000 0x0080000>;
				read-only;
			};

			partition@b00000 {
				label = "0:devcfg_1";
				reg = <0x0b00000 0x0080000>;
				read-only;
			};

			partition@b80000 {
				label = "0:rpm";
				reg = <0x0b80000 0x0080000>;
				read-only;
			};

			partition@c00000 {
				label = "0:rpm_1";
				reg = <0x0c00000 0x0080000>;
				read-only;
			};

			partition@c80000 {
				label = "0:cdt";
				reg = <0x0c80000 0x0080000>;
				read-only;
			};

			partition@d00000 {
				label = "0:cdt_1";
				reg = <0x0d00000 0x0080000>;
				read-only;
			};

			partition@d80000 {
				label = "0:appsblenv";
				reg = <0x0d80000 0x0080000>;

				nvmem-layout {
					compatible = "u-boot,env";
					env-size = <0x40000>;
				};
			};

			partition@e00000 {
				label = "0:appsbl";
				reg = <0x0e00000 0x0180000>;
				read-only;
			};

			partition@f80000 {
				label = "0:appsbl_1";
				reg = <0x0f80000 0x0180000>;
				read-only;
			};

			partition@1100000 {
				label = "0:art";
				reg = <0x1100000 0x0080000>;
				read-only;
			};

			partition@1180000 {
				label = "0:art.bak";
				reg = <0x1180000 0x0080000>;
				read-only;
			};

			partition@1200000 {
				label = "config";
				reg = <0x1200000 0x0100000>;
				read-only;
			};

			partition@1300000 {
				label = "boarddata1";
				reg = <0x1300000 0x0100000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_lan: macaddr@0 {
						reg = <0x0 0x6>;
					};

					macaddr_wan: macaddr@6 {
						reg = <0x6 0x6>;
					};
				};
			};

			partition@1400000 {
				label = "boarddata2";
				reg = <0x1400000 0x0100000>;
				read-only;
			};

			partition@1500000 {
				label = "pot";
				reg = <0x1500000 0x0100000>;
				read-only;
			};

			partition@1600000 {
				label = "dnidata";
				reg = <0x1600000 0x0500000>;
				read-only;
			};

			/* stock "firmware", remaining partitions in board DTS */
		};
	};
};

&wifi {
	status = "okay";
	qcom,calibration-variant = "Netgear-SXK30";
	qcom,ath11k-fw-memory-mode = <1>;
};
