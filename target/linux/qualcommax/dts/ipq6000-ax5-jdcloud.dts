/dts-v1/;

#include "ipq6018-512m.dtsi"
#include "ipq6018-ess.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Redmi AX5 JDCloud";
	compatible = "redmi,ax5-jdcloud", "qcom,ipq6018";

	aliases {
		serial0 = &blsp1_uart3;

		led-boot = &led_system_yellow;
		led-failsafe = &led_system_blue;
		led-running = &led_system_blue;
		led-upgrade = &led_system_yellow;

		ethernet1 = &swport2;
		ethernet2 = &swport3;
		ethernet3 = &swport4;
		ethernet4 = &swport5;

		label-mac-device = &swport2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 19 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_system_blue: system-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
		};

		led_system_yellow: system-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
		};

		led_network_blue: network-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = "network";
			gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
		};

		led_network_yellow: network-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = "network";
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
		};
	};
};

&tlmm {
	mdio_pins: mdio-pins {
		mdc {
			pins = "gpio64";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio65";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&blsp1_uart3 {
	status = "okay";
	pinctrl-0 = <&serial_3_pins>;
	pinctrl-names = "default";
};

&sdhc {
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <8>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	status = "okay";

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

		partitions {
			compatible = "gpt-partitions";

			block-partition-art {
				partname = "0:ART";

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					lanaddr: macaddr@6 {
						reg = <0x6 0x6>;
					};

					wanaddr: macaddr@18 {
						reg = <0x18 0x6>;
					};

					caldata: caldata@1000 {
						reg = <0x1000 0x10000>;
					};
				};
			};
		};
	};
};

&wifi {
	status = "okay";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,ath11k-calibration-variant = "Redmi-AX5-JDCloud";
	nvmem-cells = <&caldata>;
	nvmem-cell-names = "calibration";
};

&mdio {
	status = "okay";

	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;

	ethernet-phy-package@0 {
		compatible = "qcom,qca8075-package";
		qcom,package-mode = "psgmii";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;

		qca8075_1: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
		};

		qca8075_2: ethernet-phy@2 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <2>;
		};

		qca8075_3: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;
		};

		qca8075_4: ethernet-phy@4 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <4>;
		};
	};
};

&uniphy0 {
	status = "okay";
};

&switch {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			ethernet = <&edma>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		swport2: port@2 {
			reg = <2>;
			label = "lan1";
			phy-handle = <&qca8075_1>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 1>;
			nvmem-cells = <&lanaddr>;
			nvmem-cell-names = "mac-address";
		};

		swport3: port@3 {
			reg = <3>;
			label = "lan2";
			phy-handle = <&qca8075_2>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 2>;
			nvmem-cells = <&lanaddr>;
			nvmem-cell-names = "mac-address";
		};

		swport4: port@4 {
			reg = <4>;
			label = "lan3";
			phy-handle = <&qca8075_3>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 3>;
			nvmem-cells = <&lanaddr>;
			nvmem-cell-names = "mac-address";
		};

		swport5: port@5 {
			reg = <5>;
			label = "wan";
			phy-handle = <&qca8075_4>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 4>;
			nvmem-cells = <&wanaddr>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&edma {
	status = "okay";
};
