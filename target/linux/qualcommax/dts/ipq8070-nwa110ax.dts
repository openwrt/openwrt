/dts-v1/;

#include "ipq8070-nwa110ax-wax510d.dtsi"

/ {
	model = "Zyxel NWA110AX";
	compatible = "zyxel,nwa110ax", "qcom,ipq8074";
};

&wifi {
	qcom,ath11k-calibration-variant = "Zyxel-NWA110AX";
};
