From 1588069612f5db0720cbb942a6f8787878c223c3 Mon Sep 17 00:00:00 2001
From: David Bauer <mail@david-bauer.net>
Date: Fri, 9 Sep 2022 23:35:49 +0200
Subject: [PATCH] arm64: dts: rockchip: nanopi-r4s: add LED aliases

Add the LED aliases used by OpenWrt to indicate the boot, failsafe,
running and upgrade states to the device tree of the FriendlyElec NanoPi
R4S.
---
--- a/arch/arm64/boot/dts/rockchip/rk3399-nanopi-r4s.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3399-nanopi-r4s.dts
@@ -19,6 +19,13 @@
 	model = "FriendlyElec NanoPi R4S";
 	compatible = "friendlyarm,nanopi-r4s", "rockchip,rk3399";
 
+	aliases {
+		led-boot = &sys_led;
+		led-failsafe = &sys_led;
+		led-running = &sys_led;
+		led-upgrade = &sys_led;
+	};
+
 	/delete-node/ display-subsystem;
 
 	gpio-leds {
