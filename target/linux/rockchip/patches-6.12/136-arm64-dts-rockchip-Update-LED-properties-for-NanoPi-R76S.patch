From c19ad8db1b23381ff9a4826fab25ee605bf1035d Mon Sep 17 00:00:00 2001
From: Tianling Shen <cnsztl@immortalwrt.org>
Date: Thu, 4 Sep 2025 02:46:38 +0800
Subject: [PATCH] arm64: dts: rockchip: nanopi-r76s: update LED properties

Add the LED aliases used by OpenWrt to indicate the boot, failsafe,
running and upgrade states and replace the default heartbeat trigger of
the FriendlyElec NanoPi R76S, so that the LED reflects these states.
---
--- a/arch/arm64/boot/dts/rockchip/rk3576-nanopi-r76s.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3576-nanopi-r76s.dts
@@ -23,6 +23,11 @@
 		mmc0 = &sdhci;
 		mmc1 = &sdmmc;
 		mmc2 = &sdio;
+
+		led-boot = &power_led;
+		led-failsafe = &power_led;
+		led-running = &power_led;
+		led-upgrade = &power_led;
 	};
 
 	chosen {
@@ -54,11 +59,10 @@
 			gpios = <&gpio2 RK_PB0 GPIO_ACTIVE_HIGH>;
 		};
 
-		led-1 {
+		power_led: led-1 {
 			color = <LED_COLOR_ID_RED>;
 			function = LED_FUNCTION_POWER;
 			gpios = <&gpio2 RK_PB3 GPIO_ACTIVE_HIGH>;
-			linux,default-trigger = "heartbeat";
 		};
 
 		led-2 {
