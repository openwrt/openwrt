From 649bc715b2e8cce32e3cfad5057ccc70ee944937 Mon Sep 17 00:00:00 2001
From: FUKAUMI Naoki <naoki@radxa.com>
Date: Mon, 29 Jul 2024 08:38:25 +0900
Subject: [PATCH] arm64: dts: rockchip: rock-pi-e: add LED aliases and stop heartbeat

Add the LED aliases used by OpenWrt to indicate the boot, failsafe,
running and upgrade states and replace the default heartbeat trigger of
the Radxa ROCK Pi E, so that the LED reflects these states.
---
--- a/arch/arm64/boot/dts/rockchip/rk3328-rock-pi-e.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3328-rock-pi-e.dts
@@ -25,6 +25,10 @@
 		ethernet1 = &gmac2phy;
 		mmc0 = &sdmmc;
 		mmc1 = &emmc;
+		led-boot = &led_blue;
+		led-failsafe = &led_blue;
+		led-running = &led_blue;
+		led-upgrade = &led_blue;
 	};
 
 	chosen {
@@ -57,10 +61,11 @@
 		pinctrl-0 = <&led_pin>;
 		pinctrl-names = "default";
 
-		led-0 {
+		led_blue: led-0 {
 			color = <LED_COLOR_ID_BLUE>;
+			default-state = "on";
+			function = LED_FUNCTION_HEARTBEAT;
 			gpios = <&gpio3 RK_PA5 GPIO_ACTIVE_LOW>;
-			linux,default-trigger = "heartbeat";
 		};
 	};
 
