#include "rockchip/rv1126.dtsi"

/ {
	aliases {
		ethernet0 = &gmac;
		gpio0 = &gpio0;
		gpio1 = &gpio1;
		gpio2 = &gpio2;
		gpio3 = &gpio3;
		gpio4 = &gpio4;
		mmc0 = &emmc;
		mmc1 = &sdmmc;
	};

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xff570000 console=ttyS2,1500000 root=PARTUUID=614e0000-0000 rootwait";
		stdout-path = "serial2:1500000n8";
	};

	vcc_1v8: regulator-vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	vcc3v3_sys: regulator-vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vcc_sd: regulator-vcc-sd {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&sdmmc_pwr>;
		regulator-name = "vcc_sd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <100000>;
		vin-supply = <&vcc3v3_sys>;
	};
};

&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_clk &emmc_cmd &emmc_bus8>;
	rockchip,default-sample-phase = <90>;
	status = "okay";
};

&gmac {
	assigned-clocks = <&cru CLK_GMAC_SRC_M0>, <&cru CLK_GMAC_SRC>,
			  <&cru CLK_GMAC_TX_RX>;
	assigned-clock-parents = <&cru CLK_GMAC_RGMII_M0>,
				 <&cru CLK_GMAC_SRC_M0>,
				 <&cru RMII_MODE_CLK>;
	assigned-clock-rates = <0>, <50000000>;
	clock_in_out = "output";
	phy-handle = <&phy>;
	phy-mode = "rmii";
	pinctrl-names = "default";
	pinctrl-0 = <&rmiim0_miim &rmiim0_rxer &rmiim0_bus2
		     &rmiim0_clkinout>;
	status = "okay";
};

&mdio {
	phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		reset-assert-us = <50000>;
		reset-deassert-us = <10000>;
		reset-gpios = <&gpio3 RK_PC5 GPIO_ACTIVE_LOW>;
	};
};

&npu_tsadc {
	status = "okay";
};

&pinctrl {
	ethernet {
		rmiim0_miim: rmiim0-miim {
			rockchip,pins =
				<3 RK_PC4 2 &pcfg_pull_none_drv_level_0>,
				<3 RK_PC3 2 &pcfg_pull_none>;
		};

		rmiim0_rxer: rmiim0-rxer {
			rockchip,pins =
				<3 RK_PC2 2 &pcfg_pull_none>;
		};

		rmiim0_bus2: rmiim0-bus2 {
			rockchip,pins =
				<3 RK_PB6 2 &pcfg_pull_none>,
				<3 RK_PB7 2 &pcfg_pull_none>,
				<3 RK_PC1 2 &pcfg_pull_none>,
				<3 RK_PB3 2 &pcfg_pull_none_drv_level_0>,
				<3 RK_PB4 2 &pcfg_pull_none_drv_level_0>,
				<3 RK_PB5 2 &pcfg_pull_none_drv_level_0>;
		};

		rmiim0_clkinout: rmiim0-clkinout {
			rockchip,pins =
				<3 RK_PC0 2 &pcfg_pull_none>;
		};
	};

	sdmmc-pwr {
		sdmmc_pwr: sdmmc-pwr {
			rockchip,pins = <0 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pmu_io_domains {
	pmuio0-supply = <&vcc3v3_sys>;
	pmuio1-supply = <&vcc3v3_sys>;
	vccio2-supply = <&vcc3v3_sys>;
	vccio3-supply = <&vcc3v3_sys>;
	vccio4-supply = <&vcc_1v8>;
	vccio5-supply = <&vcc3v3_sys>;
	vccio6-supply = <&vcc3v3_sys>;
	vccio7-supply = <&vcc3v3_sys>;
	status = "okay";
};

&saradc {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

&sdmmc {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	card-detect-delay = <200>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	rockchip,default-sample-phase = <90>;
	vmmc-supply = <&vcc_sd>;
	status = "okay";
};

&sdmmc0_bus4 {
	rockchip,pins =
		<1 RK_PA4 1 &pcfg_pull_up_drv_level_0>,
		<1 RK_PA5 1 &pcfg_pull_up_drv_level_0>,
		<1 RK_PA6 1 &pcfg_pull_up_drv_level_0>,
		<1 RK_PA7 1 &pcfg_pull_up_drv_level_0>;
};

&sdmmc0_clk {
	rockchip,pins =
		<1 RK_PB0 1 &pcfg_pull_up_drv_level_3>;
};

&sdmmc0_cmd {
	rockchip,pins =
		<1 RK_PB1 1 &pcfg_pull_up_drv_level_0>;
};

&tsadc {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&wdt {
	status = "okay";
};
