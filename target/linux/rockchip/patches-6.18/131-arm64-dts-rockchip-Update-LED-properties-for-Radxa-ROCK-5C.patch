From 73d50b420e545d3beebcf00430600a1fbb3ac8b4 Mon Sep 17 00:00:00 2001
From: FUKAUMI Naoki <naoki@radxa.com>
Date: Tue, 2 Sep 2025 02:42:51 +0000
Subject: [PATCH] arm64: dts: rockchip: rock-5c: update LED properties

Add the LED aliases used by OpenWrt to indicate the boot, failsafe,
running and upgrade states and replace the default heartbeat trigger of
the Radxa ROCK 5C, so that the LED reflects these states.
---
--- a/arch/arm64/boot/dts/rockchip/rk3588s-rock-5c.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-rock-5c.dts
@@ -19,6 +19,10 @@
 		ethernet0 = &gmac1;
 		mmc0 = &sdhci;
 		mmc1 = &sdmmc;
+		led-boot = &led_green;
+		led-failsafe = &led_green;
+		led-running = &led_green;
+		led-upgrade = &led_green;
 	};
 
 	chosen {
@@ -52,7 +56,7 @@
 		pinctrl-names = "default";
 		pinctrl-0 = <&led_pins>;
 
-		led-0 {
+		led_green: led-0 {
 			color = <LED_COLOR_ID_GREEN>;
 			default-state = "on";
 			function = LED_FUNCTION_POWER;
@@ -61,10 +65,8 @@
 
 		led-1 {
 			color = <LED_COLOR_ID_BLUE>;
-			default-state = "on";
 			function = LED_FUNCTION_HEARTBEAT;
 			gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_HIGH>;
-			linux,default-trigger = "heartbeat";
 		};
 	};
 
