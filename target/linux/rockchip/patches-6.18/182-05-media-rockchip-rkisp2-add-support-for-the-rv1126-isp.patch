+static void rkisp2_reset(struct rkisp2_device *rkisp2)
+{
+	unsigned long rate = clk_get_rate(rkisp2->clk_core);
+
+	clk_set_rate(rkisp2->clk_core, RKISP2_RESET_CLK_RATE);
+	udelay(RKISP2_RESET_CLK_SETTLE_US);
+	reset_control_assert(rkisp2->rsts);
+	udelay(RKISP2_RESET_PULSE_US);
+	reset_control_deassert(rkisp2->rsts);
+	udelay(RKISP2_RESET_PULSE_US);
+	clk_set_rate(rkisp2->clk_core, rate);
+}
