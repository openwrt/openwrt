@@ -845,6 +880,7 @@ irqreturn_t rkisp2_isp_isr(int irq, void
 
 	if (status & RKISP2_CIF_ISP_FRAME) {
 		rkisp2->debug.complete_frames++;
+		rkisp2_dmarx_isr(rkisp2);
 		rkisp2_params_isr(&rkisp2->params);
 		rkisp2_stats_isr_eof(&rkisp2->stats);
 	}
@@ -853,3 +889,25 @@ irqreturn_t rkisp2_isp_isr(int irq, void
 
 	return IRQ_HANDLED;
 }
+
+irqreturn_t rkisp2_mipi_isr(int irq, void *ctx)
+{
+	struct device *dev = ctx;
+	struct rkisp2_device *rkisp2 = dev_get_drvdata(dev);
+	u32 err;
+
+	if (!rkisp2->irqs_enabled)
+		return IRQ_NONE;
+
+	/* The error status registers are cleared by reading them */
+	err = rkisp2_read(rkisp2, CSI2RX_ERR_STAT) |
+	      rkisp2_read(rkisp2, CSI2RX_ERR_OVERFLOW) |
+	      rkisp2_read(rkisp2, CSI2RX_ERR_PACKET) |
+	      rkisp2_read(rkisp2, CSI2RX_ERR_PHY);
+	if (!err)
+		return IRQ_NONE;
+
+	rkisp2->debug.mipi_error++;
+
+	return IRQ_HANDLED;
+}
