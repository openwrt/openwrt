+	RKISP2_FEATURE_NOC_HURRY = BIT(3),
+	RKISP2_FEATURE_RAWRD_SWAP = BIT(4),
+	RKISP2_FEATURE_RAWRD_CLK = BIT(5),
+	RKISP2_FEATURE_RAWRD_RESET = BIT(6),
 };
 
