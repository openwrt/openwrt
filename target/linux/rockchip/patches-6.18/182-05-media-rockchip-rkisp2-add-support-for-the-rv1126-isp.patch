From b68c5635c7fea89dc9663fce5e1188a7f224f80a Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Fri, 16 Oct 2026 23:54:05 +0100
Subject: [PATCH] media: rockchip: rkisp2: Add support for the RV1126 ISP

The RV1126 ISP is version 2.0 of the hardware that this driver supports
on the RK3588. The register layout is the same for the blocks that the
driver configures. It has three clocks, a third interrupt line for the
CSI-2 receiver and memory read status, and 4416x3312 as maximum input
size.

Add the RV1126 model description and a handler for the third interrupt,
which counts the receiver errors. The ISP 2.0 differs from the RK3588
variant in a few places that the model description carries:

 - the image stabiliser is gone, so its output crop is not programmed;
 - the bus priorities and hurry modes come from the upper bits of the
   ISP control register;
 - the memory interface read and raw read clocks are gated by bits 21
   and 22 of VI_ISP_CLK_CTRL, which have to be set;
 - the raw readback samples are not word swapped;
 - the readback buffer is returned at the ISP frame complete interrupt,
   when the whole frame has been read;
 - the soft reset pulse of the ISP does not clear the readback front
   end, so the stop path asserts the "isp" and "isp-rx-p" resets.

Assisted-by: LLM
Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../platform/rockchip/rkisp2/rkisp2-capture.c |  2 -
 .../platform/rockchip/rkisp2/rkisp2-common.h  | 16 +++++-
 .../platform/rockchip/rkisp2/rkisp2-dev.c     | 39 ++++++++++++-
 .../platform/rockchip/rkisp2/rkisp2-dmarx.c   | 17 ++----
 .../platform/rockchip/rkisp2/rkisp2-isp.c     | 56 ++++++++++++++++++-
 .../uapi/linux/media/rockchip/rkisp2-config.h |  2 +
 6 files changed, 115 insertions(+), 17 deletions(-)

--- a/drivers/media/platform/rockchip/rkisp2/rkisp2-capture.c
+++ b/drivers/media/platform/rockchip/rkisp2/rkisp2-capture.c
@@ -757,8 +757,6 @@ irqreturn_t rkisp2_capture_isr(int irq,
 		wake_up(&cap->done);
 	}
 
-	rkisp2_dmarx_isr(rkisp2, status);
-
 	rkisp2_write(rkisp2, RKISP2_CIF_MI_ICR, status);
 
 	return IRQ_HANDLED;
--- a/drivers/media/platform/rockchip/rkisp2/rkisp2-common.h
+++ b/drivers/media/platform/rockchip/rkisp2/rkisp2-common.h
@@ -28,6 +28,7 @@
 #include "rkisp2-regs.h"
 
 struct dentry;
+struct reset_control;
 struct regmap;
 
 /*
@@ -114,6 +115,11 @@ enum rkisp2_isp_pad {
  *
  * @RKISP2_FEATURE_DUAL_CROP: The ISP has the dual crop block at the resizer input
  * @RKISP2_FEATURE_ACK_FRM_PRO: SWS_CFG has the frame process acknowledge disable bit
+ * @RKISP2_FEATURE_IS_CROP: The ISP has the output crop of the image stabiliser
+ * @RKISP2_FEATURE_NOC_HURRY: The ISP control register sets the bus priorities
+ * @RKISP2_FEATURE_RAWRD_SWAP: The raw readback swaps the words of unpacked samples
+ * @RKISP2_FEATURE_RAWRD_CLK: The clock control register gates the raw readback
+ * @RKISP2_FEATURE_RAWRD_RESET: The raw readback state is only cleared by the SoC reset
  *
  * The ISP features are stored in a bitmask in &rkisp2_info.features and allow
  * the driver to implement support for features present in some ISP versions
@@ -122,6 +128,11 @@ enum rkisp2_isp_pad {
 enum rkisp2_feature {
 	RKISP2_FEATURE_DUAL_CROP = BIT(0),
 	RKISP2_FEATURE_ACK_FRM_PRO = BIT(1),
+	RKISP2_FEATURE_IS_CROP = BIT(2),
+	RKISP2_FEATURE_NOC_HURRY = BIT(3),
+	RKISP2_FEATURE_RAWRD_SWAP = BIT(4),
+	RKISP2_FEATURE_RAWRD_CLK = BIT(5),
+	RKISP2_FEATURE_RAWRD_RESET = BIT(6),
 };
 
 #define rkisp2_has_feature(rkisp2, feature) \
@@ -244,7 +255,6 @@ struct rkisp2_dmarx_fmt {
 
 struct rkisp2_rawrd_cfg {
 	const char *name;
-	u32 ready_mask;
 	u32 base_reg;
 	u32 length_reg;
 	u32 enable_mask;
@@ -474,6 +484,8 @@ struct rkisp2_device {
 	struct device *dev;
 	unsigned int clk_size;
 	struct clk_bulk_data clks[RKISP2_MAX_BUS_CLK];
+	struct clk *clk_core;
+	struct reset_control *rsts;
 	struct regmap *gasket;
 	unsigned int gasket_id;
 	struct v4l2_device v4l2_dev;
@@ -589,7 +601,7 @@ const struct rkisp2_mbus_info *rkisp2_mb
 irqreturn_t rkisp2_isp_isr(int irq, void *ctx);
 irqreturn_t rkisp2_capture_isr(int irq, void *ctx);
 irqreturn_t rkisp2_mipi_isr(int irq, void *ctx);
-void rkisp2_dmarx_isr(struct rkisp2_device *rkisp2, u32 status);
+void rkisp2_dmarx_isr(struct rkisp2_device *rkisp2);
 bool rkisp2_dmarx_input_idle(struct rkisp2_device *rkisp2);
 void rkisp2_params_isr(struct rkisp2_params *params);
 irqreturn_t rkisp2_stats_isr_eof(struct rkisp2_stats *stats);
--- a/drivers/media/platform/rockchip/rkisp2/rkisp2-dev.c
+++ b/drivers/media/platform/rockchip/rkisp2/rkisp2-dev.c
@@ -20,6 +20,7 @@
 #include <linux/platform_device.h>
 #include <linux/pinctrl/consumer.h>
 #include <linux/pm_runtime.h>
+#include <linux/reset.h>
 #include <media/v4l2-fwnode.h>
 #include <media/v4l2-mc.h>
 #include <media/videobuf2-dma-contig.h>
@@ -199,18 +200,43 @@ static const char * const rk3588_isp_clk
 	"clk_core_vicap",
 };
 
+static const char * const rv1126_isp_clks[] = {
+	"aclk",
+	"hclk",
+	"clk_core",
+};
+
+static const struct rkisp2_isr_data rv1126_isp_isrs[] = {
+	{ "isp_irq", rkisp2_isp_isr, BIT(RKISP2_IRQ_ISP) },
+	{ "mi_irq", rkisp2_capture_isr, BIT(RKISP2_IRQ_MI) },
+	{ "mipi_irq", rkisp2_mipi_isr, BIT(RKISP2_IRQ_MIPI) },
+};
+
 static const struct rkisp2_isr_data rk3588_isp_isrs[] = {
 	{ "isp_irq", rkisp2_isp_isr, BIT(RKISP2_IRQ_ISP) },
 	{ "mi_irq", rkisp2_capture_isr, BIT(RKISP2_IRQ_MI) },
 };
 
+static const struct rkisp2_info rv1126_isp_info = {
+	.clks = rv1126_isp_clks,
+	.clk_size = ARRAY_SIZE(rv1126_isp_clks),
+	.isrs = rv1126_isp_isrs,
+	.isr_size = ARRAY_SIZE(rv1126_isp_isrs),
+	.isp_ver = RKISP2_V0,
+	.features = RKISP2_FEATURE_DUAL_CROP | RKISP2_FEATURE_NOC_HURRY |
+		    RKISP2_FEATURE_RAWRD_CLK | RKISP2_FEATURE_RAWRD_RESET,
+	.max_width = 4416,
+	.max_height = 3312,
+};
+
 static const struct rkisp2_info rk3588_isp_info = {
 	.clks = rk3588_isp_clks,
 	.clk_size = ARRAY_SIZE(rk3588_isp_clks),
 	.isrs = rk3588_isp_isrs,
 	.isr_size = ARRAY_SIZE(rk3588_isp_isrs),
 	.isp_ver = RKISP3_V0,
-	.features = RKISP2_FEATURE_DUAL_CROP | RKISP2_FEATURE_ACK_FRM_PRO,
+	.features = RKISP2_FEATURE_DUAL_CROP | RKISP2_FEATURE_ACK_FRM_PRO |
+		    RKISP2_FEATURE_IS_CROP | RKISP2_FEATURE_RAWRD_SWAP,
 	.max_width = 4672,
 	.max_height = 3504,
 };
@@ -220,6 +246,10 @@ static const struct of_device_id rkisp2_
 		.compatible = "rockchip,rk3588-isp",
 		.data = &rk3588_isp_info,
 	},
+	{
+		.compatible = "rockchip,rv1126-isp",
+		.data = &rv1126_isp_info,
+	},
 	{},
 };
 MODULE_DEVICE_TABLE(of, rkisp2_of_match);
@@ -287,6 +317,13 @@ static int rkisp2_probe(struct platform_
 	if (ret)
 		return ret;
 	rkisp2->clk_size = info->clk_size;
+	for (i = 0; i < info->clk_size; i++)
+		if (!strcmp(rkisp2->clks[i].id, "clk_core"))
+			rkisp2->clk_core = rkisp2->clks[i].clk;
+
+	rkisp2->rsts = devm_reset_control_array_get_optional_exclusive(dev);
+	if (IS_ERR(rkisp2->rsts))
+		return PTR_ERR(rkisp2->rsts);
 
 	pm_runtime_enable(&pdev->dev);
 
--- a/drivers/media/platform/rockchip/rkisp2/rkisp2-dmarx.c
+++ b/drivers/media/platform/rockchip/rkisp2/rkisp2-dmarx.c
@@ -81,7 +81,6 @@ static const struct rkisp2_dmarx_fmt rki
 static const struct rkisp2_rawrd_cfg rkisp2_rawrd_cfgs[RKISP2_RAWRD_MAX] = {
 	[RKISP2_RAWRD0] = {
 		.name = RKISP2_RAWRD0_NAME,
-		.ready_mask = RKISP2_CIF_MI_MP_FE | RKISP2_CIF_MI_SP_FE,
 		.base_reg = MI_RAW2_RD_BASE,
 		.length_reg = MI_RAW2_RD_LENGTH,
 		.enable_mask = SW_CSI_RAW2_RD_EN_ORG,
@@ -89,7 +88,6 @@ static const struct rkisp2_rawrd_cfg rki
 	},
 	[RKISP2_RAWRD1] = {
 		.name = RKISP2_RAWRD1_NAME,
-		.ready_mask = RKISP2_CIF_MI_MP_FE | RKISP2_CIF_MI_SP_FE,
 		.base_reg = MI_RAW0_RD_BASE,
 		.length_reg = MI_RAW0_RD_LENGTH,
 		.enable_mask = SW_CSI_RAW0_RD_EN_ORG,
@@ -97,7 +95,6 @@ static const struct rkisp2_rawrd_cfg rki
 	},
 	[RKISP2_RAWRD2] = {
 		.name = RKISP2_RAWRD2_NAME,
-		.ready_mask = RKISP2_CIF_MI_MP_FE | RKISP2_CIF_MI_SP_FE,
 		.base_reg = MI_RAW1_RD_BASE,
 		.length_reg = MI_RAW1_RD_LENGTH,
 		.enable_mask = SW_CSI_RAW1_RD_EN_ORG,
@@ -202,7 +199,8 @@ static int rkisp2_rawrd_try_fmt(struct r
 				chan->rkisp2->info->max_height);
 
 	pix->plane_fmt[0].bytesperline = DIV_ROUND_UP(pix->width * fmt->bpp, 8);
-	pix->plane_fmt[0].sizeimage = pix->plane_fmt[0].bytesperline * pix->height;
+	pix->plane_fmt[0].sizeimage =
+		pix->plane_fmt[0].bytesperline * pix->height;
 
 	return 0;
 }
@@ -224,8 +222,9 @@ static void rkisp2_rawrd_select(struct r
 
 	val |= SW_CSI_RAW_RD_CH_SEL(chan->cfg->channel_sel);
 	if (use_uncompress)
-		val |= RKISP2_CIF_ISP_CSI_RAW_RD_UNCOMPRESS |
-		       RKISP2_CIF_ISP_CSI_RAW_RD_LE_ALIGN;
+		val |= RKISP2_CIF_ISP_CSI_RAW_RD_UNCOMPRESS;
+	if (use_uncompress && rkisp2_has_feature(rkisp2, RAWRD_SWAP))
+		val |= RKISP2_CIF_ISP_CSI_RAW_RD_LE_ALIGN;
 	rkisp2_write(rkisp2, CSI2RX_RAW_RD_CTRL, val);
 }
 
@@ -318,19 +317,15 @@ bool rkisp2_dmarx_input_idle(struct rkis
 	return streaming && idle;
 }
 
-void rkisp2_dmarx_isr(struct rkisp2_device *rkisp2, u32 status)
+void rkisp2_dmarx_isr(struct rkisp2_device *rkisp2)
 {
 	struct rkisp2_dmarx *dmarx = &rkisp2->dmarx;
 	unsigned int i;
 
-	dev_dbg(rkisp2->dev, "dmarx isr: status=0x%x\n", status);
-
 	for (i = 0; i < dmarx->num_chans; i++) {
 		struct rkisp2_dmarx_chan *chan = &dmarx->chan[i];
 		struct rkisp2_buffer *done = NULL;
 
-		if (!(status & chan->cfg->ready_mask))
-			continue;
 		if (!chan->streaming)
 			continue;
 
--- a/drivers/media/platform/rockchip/rkisp2/rkisp2-isp.c
+++ b/drivers/media/platform/rockchip/rkisp2/rkisp2-isp.c
@@ -9,9 +9,11 @@
  * Copyright (C) 2017 Rockchip Electronics Co., Ltd.
  */
 
+#include <linux/delay.h>
 #include <linux/iopoll.h>
 #include <linux/pm_runtime.h>
 #include <linux/regmap.h>
+#include <linux/reset.h>
 #include <linux/videodev2.h>
 #include <linux/vmalloc.h>
 
@@ -24,6 +26,11 @@
 
 #define RKISP2_ISP_DEV_NAME	RKISP2_DRIVER_NAME "_isp"
 
+/* Vendor stop path: the ISP clock runs at the safe rate for a reset. */
+#define RKISP2_RESET_CLK_RATE		20000000
+#define RKISP2_RESET_CLK_SETTLE_US	100
+#define RKISP2_RESET_PULSE_US		10
+
 static u16 rkisp2_isp_get_active_sink_pad(struct rkisp2_isp *isp)
 {
 	struct media_entity *entity = &isp->sd.entity;
@@ -186,12 +193,26 @@ static int rkisp2_config_cif(struct rkis
 	if (ret)
 		return ret;
 
-	rkisp2_config_ism(isp, sd_state);
+	if (rkisp2_has_feature(isp->rkisp2, IS_CROP))
+		rkisp2_config_ism(isp, sd_state);
 	rkisp2_config_path(isp);
 
 	return 0;
 }
 
+static void rkisp2_reset(struct rkisp2_device *rkisp2)
+{
+	unsigned long rate = clk_get_rate(rkisp2->clk_core);
+
+	clk_set_rate(rkisp2->clk_core, RKISP2_RESET_CLK_RATE);
+	udelay(RKISP2_RESET_CLK_SETTLE_US);
+	reset_control_assert(rkisp2->rsts);
+	udelay(RKISP2_RESET_PULSE_US);
+	reset_control_deassert(rkisp2->rsts);
+	udelay(RKISP2_RESET_PULSE_US);
+	clk_set_rate(rkisp2->clk_core, rate);
+}
+
 static void rkisp2_isp_stop(struct rkisp2_isp *isp)
 {
 	struct rkisp2_device *rkisp2 = isp->rkisp2;
@@ -248,6 +269,11 @@ static void rkisp2_isp_stop(struct rkisp
 	readx_poll_timeout(readl, rkisp2->base_addr + RKISP2_CIF_ISP_RIS,
 			   val, val & RKISP2_CIF_ISP_OFF, 20, 100);
 	/* No need to reset stats3a, as the ISP soft reset covers it */
+	if (rkisp2_has_feature(rkisp2, RAWRD_RESET)) {
+		rkisp2_reset(rkisp2);
+		return;
+	}
+
 	rkisp2_write(rkisp2, RKISP2_CIF_VI_IRCL,
 		     RKISP2_CIF_VI_IRCL_MIPI_SW_RST |
 		     RKISP2_CIF_VI_IRCL_ISP_SW_RST);
@@ -267,6 +293,8 @@ static void rkisp2_config_clk(struct rki
 	rkisp2_write(rkisp2, RKISP2_CIF_VI_ICCL, val);
 
 	val = RKISP2_CIF_CLK_CTRL_ISP_3A | RKISP2_CIF_CLK_CTRL_ISP_RAW;
+	if (rkisp2_has_feature(rkisp2, RAWRD_CLK))
+		val |= CLK_CTRL_MI_READ | CLK_CTRL_MI_RAWRD;
 	rkisp2_write(rkisp2, RKISP2_CIF_VI_ISP_CLK_CTRL_V12, val);
 
 	rkisp2_sws_config(rkisp2);
@@ -286,6 +314,9 @@ static int rkisp2_isp_start(struct rkisp
 	val |= RKISP2_CIF_ISP_CTRL_ISP_CFG_UPD |
 	       RKISP2_CIF_ISP_CTRL_ISP_ENABLE |
 	       RKISP2_CIF_ISP_CTRL_ISP_INFORM_ENABLE | RKISP2_CIF_ISP_CTRL_ISP_CFG_UPD_PERMANENT;
+	if (rkisp2_has_feature(rkisp2, NOC_HURRY))
+		val |= NOC_HURRY_PRIORITY(2) | NOC_HURRY_W_MODE(2) |
+		       NOC_HURRY_R_MODE(1);
 	rkisp2_write(rkisp2, RKISP2_CIF_ISP_CTRL, val);
 
 	rkisp2_params_post_configure(&rkisp2->params);
@@ -845,6 +876,7 @@ irqreturn_t rkisp2_isp_isr(int irq, void
 
 	if (status & RKISP2_CIF_ISP_FRAME) {
 		rkisp2->debug.complete_frames++;
+		rkisp2_dmarx_isr(rkisp2);
 		/* a CFG_UPD before the 3A done bits are cleared corrupts the stats */
 		rkisp2_stats_isr_eof(&rkisp2->stats);
 		rkisp2_params_isr(&rkisp2->params);
@@ -854,3 +886,25 @@ irqreturn_t rkisp2_isp_isr(int irq, void
 
 	return IRQ_HANDLED;
 }
+
+irqreturn_t rkisp2_mipi_isr(int irq, void *ctx)
+{
+	struct device *dev = ctx;
+	struct rkisp2_device *rkisp2 = dev_get_drvdata(dev);
+	u32 err;
+
+	if (!rkisp2->irqs_enabled)
+		return IRQ_NONE;
+
+	/* The error status registers are cleared by reading them */
+	err = rkisp2_read(rkisp2, CSI2RX_ERR_STAT) |
+	      rkisp2_read(rkisp2, CSI2RX_ERR_OVERFLOW) |
+	      rkisp2_read(rkisp2, CSI2RX_ERR_PACKET) |
+	      rkisp2_read(rkisp2, CSI2RX_ERR_PHY);
+	if (!err)
+		return IRQ_NONE;
+
+	rkisp2->debug.mipi_error++;
+
+	return IRQ_HANDLED;
+}
--- a/include/uapi/linux/media/rockchip/rkisp2-config.h
+++ b/include/uapi/linux/media/rockchip/rkisp2-config.h
@@ -34,9 +34,11 @@
 /**
  * enum rkisp2_isp_version - ISP variants
  *
+ * @RKISP2_V0: Used at least in RV1126
  * @RKISP3_V0: Used at least in RK3588
  */
 enum rkisp2_isp_version {
+	RKISP2_V0 = 20,
 	RKISP3_V0 = 30,
 };
 
