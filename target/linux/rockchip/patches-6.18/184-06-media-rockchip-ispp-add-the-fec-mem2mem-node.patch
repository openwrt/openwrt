From 68759f490a35ca515f67770abcd0c33aba75392b Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Wed, 28 Oct 2026 13:18:43 +0000
Subject: [PATCH] media: rockchip: ispp: Add the FEC mem2mem node

The frame estimation core of the ISPP measures the motion mesh between
a pair of frames. Make it available outside the live pipeline as a
stand-alone mem2mem video node that takes its requests through the
rkispp_fec_in_out ioctl, behind its own Kconfig option.

The core is shared with the pipeline: while the node waits for a
result the FEC frame end interrupt belongs to it, otherwise the
pipeline handler consumes it.

Assisted-by: LLM
Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 drivers/media/platform/rockchip/ispp/Kconfig  |  11 +
 drivers/media/platform/rockchip/ispp/Makefile |   1 +
 drivers/media/platform/rockchip/ispp/fec.c    | 484 ++++++++++++++++++
 drivers/media/platform/rockchip/ispp/fec.h    |  47 ++
 drivers/media/platform/rockchip/ispp/hw.c     |  11 +
 drivers/media/platform/rockchip/ispp/hw.h     |   2 +
 6 files changed, 556 insertions(+)
 create mode 100644 drivers/media/platform/rockchip/ispp/fec.c
 create mode 100644 drivers/media/platform/rockchip/ispp/fec.h

--- a/drivers/media/platform/rockchip/ispp/Kconfig
+++ b/drivers/media/platform/rockchip/ispp/Kconfig
@@ -21,3 +21,14 @@ config VIDEO_ROCKCHIP_ISPP
 
 	  To compile this driver as a module, choose M here: the module
 	  will be called video-rkispp.
+
+config VIDEO_ROCKCHIP_ISPP_FEC
+	bool "ISPP frame estimation (FEC) mem2mem node"
+	depends on VIDEO_ROCKCHIP_ISPP
+	select V4L2_MEM2MEM_DEV
+	default n
+	help
+	  Enable the stand-alone FEC (frame estimation) memory-to-memory
+	  node of the ISPP. The FEC core estimates a motion mesh between
+	  a pair of input frames and can be used for motion compensated
+	  processing outside the live pipeline.
--- a/drivers/media/platform/rockchip/ispp/Makefile
+++ b/drivers/media/platform/rockchip/ispp/Makefile
@@ -9,5 +9,6 @@ video-rkispp-y := common.o \
 		  stream.o
 
 video-rkispp-$(CONFIG_DEBUG_FS) += debug.o
+video-rkispp-$(CONFIG_VIDEO_ROCKCHIP_ISPP_FEC) += fec.o
 
 obj-$(CONFIG_VIDEO_ROCKCHIP_ISPP) += video-rkispp.o
--- /dev/null
+++ b/drivers/media/platform/rockchip/ispp/fec.c
@@ -0,0 +1,484 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Rockchip ISPP stand-alone FEC (frame estimation) mem2mem node
+ *
+ * Copyright (c) 2019 Fuzhou Rockchip Electronics Co., Ltd.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-buf.h>
+#include <linux/dma-mapping.h>
+#include <linux/pm_runtime.h>
+#include <linux/media/rockchip/rkisp2-config.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fh.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/v4l2-ioctl.h>
+#include <media/videobuf2-v4l2.h>
+
+#include "common.h"
+#include "dev.h"
+#include "hw.h"
+#include "ispp.h"
+#include "regs.h"
+
+static int fec_running(struct rkispp_fec_dev *fec,
+		       struct rkispp_fec_in_out *buf)
+{
+	struct rkispp_device *dev = fec->dev;
+	struct rkispp_hw_dev *hw = &dev->hw_dev;
+	u32 in_fmt, out_fmt, in_mult = 1, out_mult = 1;
+	u32 in_size, in_offs, out_size, out_offs, val;
+	u32 w = buf->width, h = buf->height, density, mesh_size;
+	struct dma_buf *in_dbuf, *out_dbuf;
+	struct dma_buf *xint_dbuf, *xfra_dbuf, *yint_dbuf, *yfra_dbuf;
+	struct dma_buf_attachment *in_attach, *out_attach;
+	struct dma_buf_attachment *xint_attach, *xfra_attach;
+	struct dma_buf_attachment *yint_attach, *yfra_attach;
+	struct sg_table *in_map, *out_map;
+	struct sg_table *xint_map, *xfra_map, *yint_map, *yfra_map;
+	void __iomem *base = hw->base_addr;
+	int ret = -EINVAL;
+
+	v4l2_dbg(3, rkispp_debug, &dev->v4l2_dev,
+		 "%s enter %dx%d format(in:%c%c%c%c out:%c%c%c%c)\n", __func__,
+		 w, h, buf->in_fourcc, buf->in_fourcc >> 8,
+		 buf->in_fourcc >> 16, buf->in_fourcc >> 24, buf->out_fourcc,
+		 buf->out_fourcc >> 8, buf->out_fourcc >> 16,
+		 buf->out_fourcc >> 24);
+
+	if (clk_get_rate(hw->clks[0]) <= hw->core_clk_min)
+		clk_set_rate(hw->clks[0], hw->core_clk_max);
+
+	init_completion(&fec->cmpl);
+	density = w > 1920 ? SW_MESH_DENSITY : 0;
+	mesh_size = cal_fec_mesh(w, h, !!density);
+
+	switch (buf->in_fourcc) {
+	case V4L2_PIX_FMT_YUYV:
+		in_fmt = FMT_YC_SWAP | FMT_YUYV | FMT_YUV422;
+		in_mult = 2;
+		break;
+	case V4L2_PIX_FMT_UYVY:
+		in_fmt = FMT_YUYV | FMT_YUV422;
+		in_mult = 2;
+		break;
+	case V4L2_PIX_FMT_NV16:
+		in_fmt = FMT_YUV422;
+		break;
+	case V4L2_PIX_FMT_NV12:
+		in_fmt = FMT_YUV420;
+		break;
+	default:
+		v4l2_err(&dev->v4l2_dev, "no support in format:%c%c%c%c\n",
+			 buf->in_fourcc, buf->in_fourcc >> 8,
+			 buf->in_fourcc >> 16, buf->in_fourcc >> 24);
+		goto end;
+	}
+	in_offs = w * h;
+	in_size = (in_fmt & FMT_YUV422) ? w * h * 2 : w * h * 3 / 2;
+
+	switch (buf->out_fourcc) {
+	case V4L2_PIX_FMT_YUYV:
+		out_fmt = FMT_YC_SWAP | FMT_YUYV | FMT_YUV422;
+		out_mult = 2;
+		break;
+	case V4L2_PIX_FMT_UYVY:
+		out_fmt = FMT_YUYV | FMT_YUV422;
+		out_mult = 2;
+		break;
+	case V4L2_PIX_FMT_NV16:
+		out_fmt = FMT_YUV422;
+		break;
+	case V4L2_PIX_FMT_NV12:
+		out_fmt = FMT_YUV420;
+		break;
+	default:
+		v4l2_err(&dev->v4l2_dev, "no support out format:%c%c%c%c\n",
+			 buf->out_fourcc, buf->out_fourcc >> 8,
+			 buf->out_fourcc >> 16, buf->out_fourcc >> 24);
+		goto end;
+	}
+	out_size = (out_fmt & FMT_YUV422) ? w * h * 2 : w * h * 3 / 2;
+	out_offs = w * h;
+
+	in_dbuf = dma_buf_get(buf->in_pic_fd);
+	if (IS_ERR_OR_NULL(in_dbuf)) {
+		v4l2_err(&dev->v4l2_dev, "invalid dmabuf fd:%d for in picture",
+			 buf->in_pic_fd);
+		goto end;
+	}
+	if (in_dbuf->size < in_size) {
+		v4l2_err(&dev->v4l2_dev, "in picture size error:%zu < %u\n",
+			 in_dbuf->size, in_size);
+		goto put_in_dbuf;
+	}
+	in_attach = dma_buf_attach(in_dbuf, hw->dev);
+	if (IS_ERR(in_attach)) {
+		v4l2_err(&dev->v4l2_dev, "failed to attach in dmabuf\n");
+		goto put_in_dbuf;
+	}
+	in_map = dma_buf_map_attachment(in_attach, DMA_BIDIRECTIONAL);
+	if (IS_ERR(in_map))
+		goto detach_in_dbuf;
+	val = sg_dma_address(in_map->sgl);
+	writel(val, base + RKISPP_FEC_RD_Y_BASE);
+	val += in_offs;
+	writel(val, base + RKISPP_FEC_RD_UV_BASE);
+
+	out_dbuf = dma_buf_get(buf->out_pic_fd);
+	if (IS_ERR_OR_NULL(out_dbuf)) {
+		v4l2_err(&dev->v4l2_dev, "invalid dmabuf fd:%d for out picture",
+			 buf->out_pic_fd);
+		goto unmap_in_dbuf;
+	}
+	if (out_dbuf->size < out_size) {
+		v4l2_err(&dev->v4l2_dev, "out picture size error:%zu < %u\n",
+			 out_dbuf->size, out_size);
+		goto put_out_dbuf;
+	}
+	out_attach = dma_buf_attach(out_dbuf, hw->dev);
+	if (IS_ERR(out_attach)) {
+		v4l2_err(&dev->v4l2_dev, "failed to attach out dmabuf\n");
+		goto put_out_dbuf;
+	}
+	out_map = dma_buf_map_attachment(out_attach, DMA_BIDIRECTIONAL);
+	if (IS_ERR(out_map))
+		goto detach_out_dbuf;
+	val = sg_dma_address(out_map->sgl);
+	writel(val, base + RKISPP_FEC_WR_Y_BASE);
+	val += out_offs;
+	writel(val, base + RKISPP_FEC_WR_UV_BASE);
+
+	xint_dbuf = dma_buf_get(buf->mesh_xint_fd);
+	if (IS_ERR_OR_NULL(xint_dbuf)) {
+		v4l2_err(&dev->v4l2_dev, "invalid dmabuf fd for xint picture");
+		goto unmap_out_dbuf;
+	}
+	if (xint_dbuf->size < mesh_size * 2) {
+		v4l2_err(&dev->v4l2_dev, "mesh xint size error:%zu < %u\n",
+			 xint_dbuf->size, mesh_size * 2);
+		goto put_xint_dbuf;
+	}
+	xint_attach = dma_buf_attach(xint_dbuf, hw->dev);
+	if (IS_ERR(xint_attach)) {
+		v4l2_err(&dev->v4l2_dev, "failed to attach xint dmabuf\n");
+		goto put_xint_dbuf;
+	}
+	xint_map = dma_buf_map_attachment(xint_attach, DMA_BIDIRECTIONAL);
+	if (IS_ERR(xint_map))
+		goto detach_xint_dbuf;
+	val = sg_dma_address(xint_map->sgl);
+	writel(val, base + RKISPP_FEC_MESH_XINT_BASE);
+
+	xfra_dbuf = dma_buf_get(buf->mesh_xfra_fd);
+	if (IS_ERR_OR_NULL(xfra_dbuf)) {
+		v4l2_err(&dev->v4l2_dev, "invalid dmabuf fd for xfra picture");
+		goto unmap_xint_dbuf;
+	}
+	if (xfra_dbuf->size < mesh_size) {
+		v4l2_err(&dev->v4l2_dev, "mesh xfra size error:%zu < %u\n",
+			 xfra_dbuf->size, mesh_size);
+		goto put_xfra_dbuf;
+	}
+	xfra_attach = dma_buf_attach(xfra_dbuf, hw->dev);
+	if (IS_ERR(xfra_attach)) {
+		v4l2_err(&dev->v4l2_dev, "failed to attach xfra dmabuf\n");
+		goto put_xfra_dbuf;
+	}
+	xfra_map = dma_buf_map_attachment(xfra_attach, DMA_BIDIRECTIONAL);
+	if (IS_ERR(xfra_map))
+		goto detach_xfra_dbuf;
+	val = sg_dma_address(xfra_map->sgl);
+	writel(val, base + RKISPP_FEC_MESH_XFRA_BASE);
+
+	yint_dbuf = dma_buf_get(buf->mesh_yint_fd);
+	if (IS_ERR_OR_NULL(yint_dbuf)) {
+		v4l2_err(&dev->v4l2_dev, "invalid dmabuf fd for yint picture");
+		goto unmap_xfra_dbuf;
+	}
+	if (yint_dbuf->size < mesh_size * 2) {
+		v4l2_err(&dev->v4l2_dev, "mesh yint size error:%zu < %u\n",
+			 yint_dbuf->size, mesh_size * 2);
+		goto put_yint_dbuf;
+	}
+	yint_attach = dma_buf_attach(yint_dbuf, hw->dev);
+	if (IS_ERR(yint_attach)) {
+		v4l2_err(&dev->v4l2_dev, "failed to attach yint dmabuf\n");
+		goto put_yint_dbuf;
+	}
+	yint_map = dma_buf_map_attachment(yint_attach, DMA_BIDIRECTIONAL);
+	if (IS_ERR(yint_map))
+		goto detach_yint_dbuf;
+	val = sg_dma_address(yint_map->sgl);
+	writel(val, base + RKISPP_FEC_MESH_YINT_BASE);
+
+	yfra_dbuf = dma_buf_get(buf->mesh_yfra_fd);
+	if (IS_ERR_OR_NULL(yfra_dbuf)) {
+		v4l2_err(&dev->v4l2_dev, "invalid dmabuf fd for yfra picture");
+		goto unmap_yint_dbuf;
+	}
+	if (yfra_dbuf->size < mesh_size) {
+		v4l2_err(&dev->v4l2_dev, "mesh yfra size error:%zu < %u\n",
+			 yfra_dbuf->size, mesh_size);
+		goto put_yfra_dbuf;
+	}
+	yfra_attach = dma_buf_attach(yfra_dbuf, hw->dev);
+	if (IS_ERR(yfra_attach)) {
+		v4l2_err(&dev->v4l2_dev, "failed to attach yfra dmabuf\n");
+		goto put_yfra_dbuf;
+	}
+	yfra_map = dma_buf_map_attachment(yfra_attach, DMA_BIDIRECTIONAL);
+	if (IS_ERR(yfra_map))
+		goto detach_yfra_dbuf;
+	val = sg_dma_address(yfra_map->sgl);
+	writel(val, base + RKISPP_FEC_MESH_YFRA_BASE);
+
+	val = out_fmt << 4 | in_fmt;
+	writel(val, base + RKISPP_FEC_CTRL);
+	val = ALIGN(w * in_mult, 16) >> 2;
+	writel(val, base + RKISPP_FEC_RD_VIR_STRIDE);
+	val = ALIGN(w * out_mult, 16) >> 2;
+	writel(val, base + RKISPP_FEC_WR_VIR_STRIDE);
+	val = h << 16 | w;
+	writel(val, base + RKISPP_FEC_PIC_SIZE);
+	writel(mesh_size, base + RKISPP_FEC_MESH_SIZE);
+	val = SW_FEC_EN | density;
+	writel(val, base + RKISPP_FEC_CORE_CTRL);
+
+	writel(FEC_FORCE_UPD, base + RKISPP_CTRL_UPDATE);
+	v4l2_dbg(3, rkispp_debug, &dev->v4l2_dev,
+		 "0x%x:0x%x 0x%x:0x%x 0x%x:0x%x 0x%x:0x%x\n"
+		 "0x%x:0x%x 0x%x:0x%x 0x%x:0x%x 0x%x:0x%x\n"
+		 "0x%x:0x%x 0x%x:0x%x 0x%x:0x%x 0x%x:0x%x\n"
+		 "0x%x:0x%x 0x%x:0x%x\n",
+		 RKISPP_CTRL_SYS_STATUS, readl(base + RKISPP_CTRL_SYS_STATUS),
+		 RKISPP_FEC_CTRL, readl(base + RKISPP_FEC_CTRL),
+		 RKISPP_FEC_RD_VIR_STRIDE,
+		 readl(base + RKISPP_FEC_RD_VIR_STRIDE),
+		 RKISPP_FEC_WR_VIR_STRIDE,
+		 readl(base + RKISPP_FEC_WR_VIR_STRIDE), RKISPP_FEC_RD_Y_BASE,
+		 readl(base + RKISPP_FEC_RD_Y_BASE), RKISPP_FEC_RD_UV_BASE,
+		 readl(base + RKISPP_FEC_RD_UV_BASE), RKISPP_FEC_MESH_XINT_BASE,
+		 readl(base + RKISPP_FEC_MESH_XINT_BASE),
+		 RKISPP_FEC_MESH_XFRA_BASE,
+		 readl(base + RKISPP_FEC_MESH_XFRA_BASE),
+		 RKISPP_FEC_MESH_YINT_BASE,
+		 readl(base + RKISPP_FEC_MESH_YINT_BASE),
+		 RKISPP_FEC_MESH_YFRA_BASE,
+		 readl(base + RKISPP_FEC_MESH_YFRA_BASE), RKISPP_FEC_WR_Y_BASE,
+		 readl(base + RKISPP_FEC_WR_Y_BASE), RKISPP_FEC_WR_UV_BASE,
+		 readl(base + RKISPP_FEC_WR_UV_BASE), RKISPP_FEC_PIC_SIZE,
+		 readl(base + RKISPP_FEC_PIC_SIZE), RKISPP_FEC_MESH_SIZE,
+		 readl(base + RKISPP_FEC_MESH_SIZE));
+
+	/* claimed before the kick so the frame end reaches this node */
+	atomic_set(&fec->running, 1);
+	if (!hw->is_shutdown)
+		writel(FEC_ST, base + RKISPP_CTRL_STRT);
+
+	ret = wait_for_completion_timeout(&fec->cmpl, msecs_to_jiffies(300));
+	atomic_set(&fec->running, 0);
+	if (!ret) {
+		v4l2_err(&dev->v4l2_dev, "fec working timeout\n");
+		ret = -EAGAIN;
+	} else {
+		ret = 0;
+	}
+	writel(SW_FEC2DDR_DIS, base + RKISPP_FEC_CORE_CTRL);
+
+	dma_buf_unmap_attachment(yfra_attach, yfra_map, DMA_BIDIRECTIONAL);
+detach_yfra_dbuf:
+	dma_buf_detach(yfra_dbuf, yfra_attach);
+put_yfra_dbuf:
+	dma_buf_put(yfra_dbuf);
+unmap_yint_dbuf:
+	dma_buf_unmap_attachment(yint_attach, yint_map, DMA_BIDIRECTIONAL);
+detach_yint_dbuf:
+	dma_buf_detach(yint_dbuf, yint_attach);
+put_yint_dbuf:
+	dma_buf_put(yint_dbuf);
+unmap_xfra_dbuf:
+	dma_buf_unmap_attachment(xfra_attach, xfra_map, DMA_BIDIRECTIONAL);
+detach_xfra_dbuf:
+	dma_buf_detach(xfra_dbuf, xfra_attach);
+put_xfra_dbuf:
+	dma_buf_put(xfra_dbuf);
+unmap_xint_dbuf:
+	dma_buf_unmap_attachment(xint_attach, xint_map, DMA_BIDIRECTIONAL);
+detach_xint_dbuf:
+	dma_buf_detach(xint_dbuf, xint_attach);
+put_xint_dbuf:
+	dma_buf_put(xint_dbuf);
+unmap_out_dbuf:
+	dma_buf_unmap_attachment(out_attach, out_map, DMA_BIDIRECTIONAL);
+detach_out_dbuf:
+	dma_buf_detach(out_dbuf, out_attach);
+put_out_dbuf:
+	dma_buf_put(out_dbuf);
+unmap_in_dbuf:
+	dma_buf_unmap_attachment(in_attach, in_map, DMA_BIDIRECTIONAL);
+detach_in_dbuf:
+	dma_buf_detach(in_dbuf, in_attach);
+put_in_dbuf:
+	dma_buf_put(in_dbuf);
+end:
+	v4l2_dbg(3, rkispp_debug, &dev->v4l2_dev, "%s exit ret:%d\n", __func__,
+		 ret);
+	return ret;
+}
+
+static long fec_ioctl_default(struct file *file, void *fh, bool valid_prio,
+			      unsigned int cmd, void *arg)
+{
+	struct rkispp_fec_dev *fec = video_drvdata(file);
+	long ret = 0;
+
+	if (!arg)
+		return -EINVAL;
+
+	switch (cmd) {
+	case RKISPP_CMD_FEC_IN_OUT:
+		ret = fec_running(fec, arg);
+		break;
+	default:
+		ret = -EFAULT;
+	}
+
+	return ret;
+}
+
+static int fec_querycap(struct file *file, void *priv,
+			struct v4l2_capability *cap)
+{
+	struct video_device *vdev = video_devdata(file);
+
+	strscpy(cap->driver, DRIVER_NAME, sizeof(cap->driver));
+	strscpy(cap->card, vdev->name, sizeof(cap->card));
+	return 0;
+}
+
+static const struct v4l2_ioctl_ops fec_ioctl_ops = {
+	.vidioc_querycap = fec_querycap,
+	.vidioc_default = fec_ioctl_default,
+};
+
+static int fec_open(struct file *file)
+{
+	struct rkispp_fec_dev *fec = video_drvdata(file);
+	int ret;
+
+	ret = v4l2_fh_open(file);
+	if (ret)
+		return ret;
+
+	mutex_lock(&fec->dev->apilock);
+	ret = pm_runtime_get_sync(fec->dev->dev);
+	mutex_unlock(&fec->dev->apilock);
+	if (ret < 0) {
+		v4l2_err(&fec->dev->v4l2_dev, "power on failed %d\n", ret);
+		v4l2_fh_release(file);
+	}
+
+	return (ret > 0) ? 0 : ret;
+}
+
+static int fec_release(struct file *file)
+{
+	struct rkispp_fec_dev *fec = video_drvdata(file);
+
+	v4l2_fh_release(file);
+
+	mutex_lock(&fec->dev->apilock);
+	pm_runtime_put_sync(fec->dev->dev);
+	mutex_unlock(&fec->dev->apilock);
+
+	return 0;
+}
+
+static const struct v4l2_file_operations fec_fops = {
+	.owner = THIS_MODULE,
+	.open = fec_open,
+	.release = fec_release,
+	.poll = v4l2_m2m_fop_poll,
+	.unlocked_ioctl = video_ioctl2,
+	.mmap = v4l2_m2m_fop_mmap,
+};
+
+void rkispp_fec_irq(struct rkispp_device *dev)
+{
+	struct rkispp_fec_dev *fec = &dev->hw_dev.fec_dev;
+
+	if (!completion_done(&fec->cmpl))
+		complete(&fec->cmpl);
+}
+
+int rkispp_register_fec(struct rkispp_device *dev)
+{
+	struct rkispp_fec_dev *fec = &dev->hw_dev.fec_dev;
+	struct video_device *vfd;
+	int ret;
+
+	if (!IS_ENABLED(CONFIG_VIDEO_ROCKCHIP_ISPP_FEC))
+		return 0;
+
+	mutex_init(&fec->apilock);
+	init_completion(&fec->cmpl);
+	fec->dev = dev;
+
+	vfd = &fec->vfd;
+	strscpy(vfd->name, "rkispp_fec", sizeof(vfd->name));
+	vfd->vfl_dir = VFL_DIR_M2M;
+	vfd->device_caps = V4L2_CAP_VIDEO_M2M_MPLANE;
+	vfd->fops = &fec_fops;
+	vfd->ioctl_ops = &fec_ioctl_ops;
+	vfd->lock = &fec->apilock;
+	vfd->release = video_device_release_empty;
+	vfd->v4l2_dev = &dev->v4l2_dev;
+
+	ret = video_register_device(vfd, VFL_TYPE_VIDEO, -1);
+	if (ret) {
+		v4l2_err(&dev->v4l2_dev,
+			 "failed to register video device, ret=%d\n", ret);
+		return ret;
+	}
+
+	/* a mem2mem video device gets no entity from the media core */
+	vfd->entity.obj_type = MEDIA_ENTITY_TYPE_VIDEO_DEVICE;
+	vfd->entity.function = MEDIA_ENT_F_IO_V4L;
+	vfd->entity.name = vfd->name;
+	vfd->entity.info.dev.major = VIDEO_MAJOR;
+	vfd->entity.info.dev.minor = vfd->minor;
+	ret = media_entity_pads_init(&vfd->entity, 0, NULL);
+	if (ret) {
+		v4l2_err(&dev->v4l2_dev,
+			 "failed to init the fec entity, ret=%d\n", ret);
+		goto err_unreg_vdev;
+	}
+	ret = media_device_register_entity(dev->v4l2_dev.mdev, &vfd->entity);
+	if (ret) {
+		v4l2_err(&dev->v4l2_dev,
+			 "failed to register the fec entity, ret=%d\n", ret);
+		media_entity_cleanup(&vfd->entity);
+		goto err_unreg_vdev;
+	}
+
+	video_set_drvdata(vfd, fec);
+
+	return 0;
+
+err_unreg_vdev:
+	video_unregister_device(vfd);
+	return ret;
+}
+
+void rkispp_unregister_fec(struct rkispp_device *dev)
+{
+	if (!IS_ENABLED(CONFIG_VIDEO_ROCKCHIP_ISPP_FEC))
+		return;
+
+	media_device_unregister_entity(&dev->hw_dev.fec_dev.vfd.entity);
+	video_unregister_device(&dev->hw_dev.fec_dev.vfd);
+	media_entity_cleanup(&dev->hw_dev.fec_dev.vfd.entity);
+}
