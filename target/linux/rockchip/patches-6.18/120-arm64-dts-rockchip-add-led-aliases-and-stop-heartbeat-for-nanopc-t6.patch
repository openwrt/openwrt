From 9482341a475245cc38244cf5fbe06ca30432315f Mon Sep 17 00:00:00 2001
From: xiaobo tian <peterwillcn@gmail.com>
Date: Wed, 21 Aug 2024 14:40:27 +0800
Subject: [PATCH] arm64: dts: rockchip: nanopc-t6: add LED aliases and stop heartbeat

Add the LED aliases used by OpenWrt to indicate the boot, failsafe,
running and upgrade states and replace the default heartbeat trigger of
the FriendlyElec NanoPC-T6, so that the LED reflects these states.
---
--- a/arch/arm64/boot/dts/rockchip/rk3588-nanopc-t6.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3588-nanopc-t6.dtsi
@@ -21,6 +21,10 @@
 	aliases {
 		mmc0 = &sdhci;
 		mmc1 = &sdmmc;
+		led-boot = &sys_led;
+		led-failsafe = &sys_led;
+		led-running = &sys_led;
+		led-upgrade = &sys_led;
 	};
 
 	adc-keys-0 {
@@ -76,7 +80,7 @@
 		sys_led: led-0 {
 			gpios = <&gpio2 RK_PB7 GPIO_ACTIVE_HIGH>;
 			label = "system-led";
-			linux,default-trigger = "heartbeat";
+			default-state = "on";
 			pinctrl-names = "default";
 			pinctrl-0 = <&sys_led_pin>;
 		};
