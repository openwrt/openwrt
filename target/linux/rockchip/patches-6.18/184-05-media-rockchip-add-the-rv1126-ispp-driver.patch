@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Rockchip ISPP common helpers
+ *
+ * Copyright (c) 2019 Fuzhou Rockchip Electronics Co., Ltd.
+ */
+
+#include <linux/delay.h>
+#include <linux/mm.h>
+#include <linux/slab.h>
+#include "dev.h"
+#include "regs.h"
+
+void rkispp_write(struct rkispp_device *dev, u32 reg, u32 val)
+{
+	if (reg / 4 < RKISPP_SW_REG_NUM)
+		dev->hw_dev.sw_regs[reg / 4] = val;
+	writel(val, dev->hw_dev.base_addr + reg);
+}
+
+u32 rkispp_read(struct rkispp_device *dev, u32 reg)
+{
+	return readl(dev->hw_dev.base_addr + reg);
+}
+
+static u32 rkispp_sw_read(struct rkispp_device *dev, u32 reg)
+{
+	if (reg / 4 < RKISPP_SW_REG_NUM)
+		return dev->hw_dev.sw_regs[reg / 4];
+	return rkispp_read(dev, reg);
+}
+
+void rkispp_set_bits(struct rkispp_device *dev, u32 reg, u32 mask, u32 val)
+{
+	u32 tmp = rkispp_sw_read(dev, reg) & ~mask;
+
+	rkispp_write(dev, reg, val | tmp);
+}
+
+void rkispp_clear_bits(struct rkispp_device *dev, u32 reg, u32 mask)
+{
+	u32 tmp = rkispp_sw_read(dev, reg);
+
+	rkispp_write(dev, reg, tmp & ~mask);
+}
+
+int rkispp_dummy_buffer_alloc(struct rkispp_device *dev,
+			      struct rkispp_dummy_buffer *buf, size_t size,
+			      unsigned long attrs)
+{
+	struct sg_table sgt;
+	int ret;
+
+	attrs |= DMA_ATTR_FORCE_CONTIGUOUS;
+	buf->vaddr = dma_alloc_attrs(dev->dev, size, &buf->dma_addr, GFP_KERNEL,
+				     attrs);
+	if (!buf->vaddr)
+		return -ENOMEM;
+
+	ret = dma_get_sgtable_attrs(dev->dev, &sgt, buf->vaddr, buf->dma_addr,
+				    size, attrs);
+	if (ret) {
+		dma_free_attrs(dev->dev, size, buf->vaddr, buf->dma_addr,
+			       attrs);
+		buf->vaddr = NULL;
+		return ret;
+	}
+	buf->phys = sg_phys(sgt.sgl);
+	sg_free_table(&sgt);
+	buf->attrs = attrs;
+	buf->size = size;
+	return 0;
+}
+
+void rkispp_dummy_buffer_free(struct rkispp_device *dev,
+			      struct rkispp_dummy_buffer *buf)
+{
+	if (!buf->size)
+		return;
+
+	dma_free_attrs(dev->dev, buf->size, buf->vaddr, buf->dma_addr,
+		       buf->attrs);
+	buf->vaddr = NULL;
+	buf->phys = 0;
+	buf->dma_addr = 0;
+	buf->size = 0;
+}
+
+int rkispp_alloc_common_dummy_buf(struct rkispp_device *dev)
+{
+	struct rkispp_subdev *sdev = &dev->ispp_sdev;
+	struct rkispp_dummy_buffer *dummy_buf = &dev->hw_dev.dummy_buf;
+	u32 w = sdev->out_fmt.width;
+	u32 h = sdev->out_fmt.height;
+	/* the sharp write engine steps by the aligned stride */
+	u32 size = ALIGN(w, 16) * h * 2;
+
+	if (dummy_buf->size)
+		return 0;
+
+	return rkispp_dummy_buffer_alloc(dev, dummy_buf, PAGE_ALIGN(size),
+					 DMA_ATTR_NO_KERNEL_MAPPING);
+}
+
+void rkispp_free_common_dummy_buf(struct rkispp_device *dev)
+{
+	rkispp_dummy_buffer_free(dev, &dev->hw_dev.dummy_buf);
+}
