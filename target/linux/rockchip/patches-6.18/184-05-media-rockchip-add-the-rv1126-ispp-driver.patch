+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Rockchip ISPP streams
+ *
+ * Copyright (c) 2019 Fuzhou Rockchip Electronics Co., Ltd.
+ */
+
+#ifndef _RKISPP_STREAM_H
+#define _RKISPP_STREAM_H
+
+#include <linux/atomic.h>
+#include <linux/completion.h>
+#include <linux/kthread.h>
+#include <linux/wait.h>
+
+#include "common.h"
+
+/*
+ * STREAM_II: input image data
+ * STREAM_MB: module bypass output, no scale
+ * STREAM_S0: scale0 output
+ * STREAM_S1: scale1 output
+ * STREAM_S2: scale2 output
+ */
+enum rkispp_stream_id {
+	STREAM_II = 0,
+	STREAM_MB,
+	STREAM_S0,
+	STREAM_S1,
+	STREAM_S2,
+	STREAM_MAX
+};
+
+/* function module, positions of the vendor rkispp-config.h */
+#define ISPP_MODULE_TNR BIT(0) /* 2TO1 */
+#define ISPP_MODULE_NR BIT(1)
+#define ISPP_MODULE_SHP BIT(2)
+#define ISPP_MODULE_FEC BIT(3) /* calibration */
+#define ISPP_MODULE_ORB BIT(4)
+#define ISPP_MODULE_TNR_3TO1 (BIT(16) | ISPP_MODULE_TNR)
+#define ISPP_MODULE_FEC_ST (BIT(17) | ISPP_MODULE_FEC)
+
+struct capture_fmt {
+	u32 fourcc;
+	u8 cplanes;
+	u8 mplanes;
+	u8 wr_fmt;
+	u8 bpp[VIDEO_MAX_PLANES];
+};
+
+struct stream_config {
+	const struct capture_fmt *fmts;
+	unsigned int fmt_size;
+	u32 frame_end_id;
+	struct {
+		u32 ctrl;
+		u32 factor;
+		u32 cur_y_base;
+		u32 cur_uv_base;
+		u32 cur_vir_stride;
+	} reg;
+};
+
+struct rkispp_stream;
+
+struct streams_ops {
+	int (*config)(struct rkispp_stream *stream);
+	void (*update)(struct rkispp_stream *stream);
+	void (*stop)(struct rkispp_stream *stream);
+	int (*start)(struct rkispp_stream *stream);
+	int (*is_stopped)(struct rkispp_stream *stream);
+	int (*limit_check)(struct rkispp_stream *stream,
+			   struct v4l2_pix_format_mplane *try_fmt);
+};
+
+enum stream_type {
+	STREAM_INPUT,
+	STREAM_OUTPUT,
+};
+
+struct frame_debug_info {
+	u64 timestamp;
+	u32 interval;
+	u32 delay;
+	u32 id;
+};
+
+/* ISP input pool group, allocated here and handed to the ISP once */
+#define RKISPP_BUF_POOL_MAX 3
+
+struct rkispp_isp_buf_pool {
+	struct rkispp_dummy_buffer pic;
+	struct rkispp_dummy_buffer gain;
+};
+
+/* Input image buffer handed to the pipeline from the II queue */
+struct rkispp_ii_input {
+	struct list_head list;
+	struct rkispp_buffer *buf;
+	/* timestamp in ns */
+	u64 frame_timestamp;
+	u32 frame_id;
+	/* an isp pool buffer handed over by the isp, not an II buffer */
+	bool from_pool;
+	unsigned int pool_idx;
+};
+
+#define RKISPP_BUF_MAX 2
+enum rkispp_buf_group {
+	GROUP_BUF_PIC = 0,
+	GROUP_BUF_GAIN,
+	GROUP_BUF_MAX,
+};
+
+struct tnr_module {
+	struct {
+		struct rkispp_dummy_buffer wr[GROUP_BUF_MAX];
+		struct rkispp_dummy_buffer iir;
+		struct rkispp_dummy_buffer gain_kg;
+	} buf;
+	struct frame_debug_info dbg;
+	u32 uv_offset;
+	bool is_end;
+	bool is_3to1;
+	bool is_but_init;
+};
+
+struct nr_module {
+	struct {
+		struct rkispp_dummy_buffer tmp_yuv;
+		struct rkispp_dummy_buffer wr[RKISPP_BUF_MAX];
+	} buf;
+	struct list_head list_rd;
+	struct list_head list_wr;
+	/* protects list_rd, list_wr, cur_rd and cur_wr */
+	spinlock_t buf_lock;
+	struct rkispp_ii_input *cur_rd;
+	struct rkispp_dummy_buffer *cur_wr;
+	struct frame_debug_info dbg;
+	u32 uv_offset;
+	bool is_end;
+};
+
+struct fec_module {
+	struct list_head list_rd;
+	/* protects list_rd and cur_rd */
+	spinlock_t buf_lock;
+	struct rkispp_dummy_buffer *cur_rd;
+	struct frame_debug_info dbg;
+	u32 uv_offset;
+	bool is_end;
+};
+
+struct rkispp_stream {
+	enum rkispp_stream_id id;
+	struct rkispp_device *isppdev;
+	struct rkispp_vdev_node vnode;
+
+	struct list_head buf_queue;
+	struct rkispp_buffer *curr_buf;
+	wait_queue_head_t done;
+	/* protects buf_queue and curr_buf */
+	spinlock_t vbq_lock;
+
+	enum stream_type type;
+	struct streams_ops *ops;
+	struct stream_config *config;
+	struct capture_fmt out_cap_fmt;
+	struct v4l2_pix_format_mplane out_fmt;
+	struct frame_debug_info dbg;
+
+	u8 last_module;
+	bool streaming;
+	bool stopping;
+	bool linked;
+	bool is_upd;
+	bool is_cfg;
+	bool scl_bypass;
+};
+
+enum {
+	MONITOR_OFF = 0,
+	MONITOR_TNR = BIT(0),
+	MONITOR_NR = BIT(1),
+	MONITOR_FEC = BIT(2),
+};
+
+struct module_monitor {
+	struct rkispp_device *dev;
+	struct work_struct work;
+	struct completion cmpl;
+	u16 time;
+	u8 module;
+	bool is_err;
+};
+
+struct rkispp_monitor {
+	struct module_monitor tnr;
+	struct module_monitor nr;
+	struct module_monitor fec;
+	struct completion cmpl;
+	/* protects the monitoring and restart state */
+	spinlock_t lock;
+	u8 monitoring_module;
+	u8 restart_module;
+	u8 retry;
+	bool is_restart;
+	bool is_en;
+};
+
+struct rkispp_stream_vdev {
+	struct rkispp_stream stream[STREAM_MAX];
+	struct rkispp_isp_buf_pool pool[RKISPP_BUF_POOL_MAX];
+	struct tnr_module tnr;
+	struct nr_module nr;
+	struct fec_module fec;
+	struct rkispp_monitor monitor;
+	struct rkispp_ii_input input[VIDEO_MAX_FRAME];
+	struct rkispp_ii_input pool_input[RKISPP_BUF_POOL_MAX];
+	/* II frames waiting for the pipeline, kicked one at a time */
+	struct list_head ii_queue;
+	/* protects ii_queue */
+	spinlock_t ii_lock;
+	/* per-frame resets of the engine, read by a stopping scaler */
+	unsigned int frame_resets;
+	bool is_idle;
+	atomic_t refcnt;
+	u32 module_ens;
+	u32 irq_ends;
+};
+
+void rkispp_module_work_event(struct rkispp_device *dev, void *buf_rd,
+			      void *buf_wr, u32 module, bool is_isr);
+void rkispp_isr(u32 mis_val, struct rkispp_device *dev);
+void rkispp_unregister_stream_vdevs(struct rkispp_device *dev);
+int rkispp_register_stream_vdevs(struct rkispp_device *dev);
+void rkispp_streams_unbind(struct rkispp_device *dev);
+#endif
