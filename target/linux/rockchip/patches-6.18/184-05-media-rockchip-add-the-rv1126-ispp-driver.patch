+	rkispp_write(dev, RKISPP_NR_UVNR_T2GEN_WTQ, val);
+	rkispp_write(dev, RKISPP_NR_UVNR_T2FLT_MSIGMA, arg->uvnr_t2flt_msigma);
+	val = ISPP_PACK_4BYTE(arg->uvnr_t2flt_wtp, arg->uvnr_t2flt_wt[0],
+			      arg->uvnr_t2flt_wt[1], arg->uvnr_t2flt_wt[2]);
+	rkispp_write(dev, RKISPP_NR_UVNR_T2FLT_WT, val);
+
+	val = ISPP_PACK_4BIT(arg->ynr_sgm_dx[0], arg->ynr_sgm_dx[1],
+			     arg->ynr_sgm_dx[2], arg->ynr_sgm_dx[3],
