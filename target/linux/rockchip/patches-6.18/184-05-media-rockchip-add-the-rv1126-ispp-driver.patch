+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Rockchip ISPP hardware device
+ *
+ * Copyright (C) 2020 Rockchip Electronics Co., Ltd
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iommu.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/pm_runtime.h>
+
+#include "common.h"
+#include "dev.h"
+#include "hw.h"
+#include "regs.h"
+
+void rkispp_soft_reset(struct rkispp_hw_dev *hw)
+{
+	struct iommu_domain *domain = iommu_get_domain_for_dev(hw->dev);
+	struct device *dev = hw->dev;
+	void __iomem *base = hw->base_addr;
+	int ret;
+
+	/* the reset wipes the SMMU inside the ISPP window: re-attach after it */
+	if (domain)
+		iommu_detach_device(domain, hw->dev);
+	writel(GLB_SOFT_RST_ALL, base + RKISPP_CTRL_RESET);
+	usleep_range(10, 20);
+	if (domain) {
+		ret = iommu_attach_device(domain, hw->dev);
+		if (ret)
+			dev_err(dev, "iommu attach after reset failed: %d\n",
+				ret);
+	}
+	writel(SW_SCL_BYPASS, base + RKISPP_SCL0_CTRL);
+	writel(SW_SCL_BYPASS, base + RKISPP_SCL1_CTRL);
+	writel(SW_SCL_BYPASS, base + RKISPP_SCL2_CTRL);
+	writel(OTHER_FORCE_UPD, base + RKISPP_CTRL_UPDATE);
+	writel(GATE_DIS_ALL, base + RKISPP_CTRL_CLKGATE);
+	writel(SW_FEC2DDR_DIS, base + RKISPP_FEC_CORE_CTRL);
+	/* the soft reset clears the module interrupt enables */
+	writel(NR_LOST_ERR | TNR_LOST_ERR | FBCH_EMPTY_NR | FBCH_EMPTY_TNR |
+		       FBCD_DEC_ERR_NR | FBCD_DEC_ERR_TNR | BUS_ERR_NR |
+		       BUS_ERR_TNR | SCL2_INT | SCL1_INT | SCL0_INT | FEC_INT |
+		       ORB_INT | SHP_INT | NR_INT | TNR_INT,
+	       base + RKISPP_CTRL_INT_MSK);
+	writel(GATE_DIS_NR, base + RKISPP_CTRL_CLKGATE);
+}
+
+void rkispp_disable_sys_clk(struct rkispp_hw_dev *hw)
+{
+	int i;
+
+	for (i = 0; i < hw->clks_num; i++)
+		clk_disable_unprepare(hw->clks[i]);
+}
+
+/*
+ * Pick the lowest core clock rate that can sustain the current input
+ * width. The first entry of the table is the idle rate.
+ */
+int rkispp_enable_sys_clk(struct rkispp_hw_dev *hw)
+{
+	struct rkispp_device *dev =
+		container_of(hw, struct rkispp_device, hw_dev);
+	u32 w = dev->ispp_sdev.in_fmt.width;
+	int i, ret = 0;
+
+	for (i = 0; i < hw->clks_num; i++) {
+		ret = clk_prepare_enable(hw->clks[i]);
+		if (ret < 0)
+			break;
+	}
+	if (ret < 0)
+		goto err;
+
+	for (i = 0; i < hw->clk_rate_tbl_num; i++)
+		if (w <= hw->clk_rate_tbl[i].refer_data)
+			break;
+	if (i > hw->clk_rate_tbl_num - 1)
+		i = hw->clk_rate_tbl_num - 1;
+	hw->core_clk_max = hw->clk_rate_tbl[i].clk_rate * 1000000;
+	hw->core_clk_min = hw->clk_rate_tbl[0].clk_rate * 1000000;
+	clk_set_rate(hw->clks[0], hw->core_clk_max);
+	dev_dbg(hw->dev, "core clock %lu Hz\n", clk_get_rate(hw->clks[0]));
+
+	return 0;
+err:
+	for (--i; i >= 0; --i)
+		clk_disable_unprepare(hw->clks[i]);
+	return ret;
+}
+
+static irqreturn_t rkispp_irq_hdl(int irq, void *ctx)
+{
+	struct device *dev = ctx;
+	struct rkispp_device *ispp = dev_get_drvdata(dev);
+	struct rkispp_hw_dev *hw = &ispp->hw_dev;
+	void __iomem *base = hw->base_addr;
+	unsigned int mis_val;
+	unsigned long flags;
+
+	spin_lock_irqsave(&hw->irq_lock, flags);
+	mis_val = readl(base + RKISPP_CTRL_INT_STA);
+	writel(mis_val, base + RKISPP_CTRL_INT_CLR);
+	spin_unlock_irqrestore(&hw->irq_lock, flags);
+
+	if (mis_val)
+		ispp->irq_hdl(mis_val, ispp);
+
+	return IRQ_HANDLED;
+}
+
+static const char *const ispp_clks[] = {
+	"clk_ispp",
+	"aclk_ispp",
+	"hclk_ispp",
+};
+
+static const struct ispp_clk_info ispp_clk_rate[] = {
+	{
+		.clk_rate = 150,
+		.refer_data = 0,
+	},
+	{
+		.clk_rate = 250,
+		.refer_data = 1920, /* width */
+	},
+	{
+		.clk_rate = 350,
+		.refer_data = 2688,
+	},
+	{
+		.clk_rate = 400,
+		.refer_data = 3072,
+	},
+	{
+		.clk_rate = 500,
+		.refer_data = 3840,
+	}
+};
+
+static const char *const rkispp_irq_names[] = { "ispp_irq", "fec_irq" };
+
+static int rkispp_request_irqs(struct rkispp_device *dev)
+{
+	struct device *device = dev->dev;
+	int i, irq, ret;
+
+	for (i = 0; i < ARRAY_SIZE(rkispp_irq_names); i++) {
+		irq = platform_get_irq_byname(to_platform_device(device),
+					      rkispp_irq_names[i]);
+		if (irq < 0)
+			irq = platform_get_irq(to_platform_device(device), i);
+		if (irq < 0) {
+			dev_err(device, "no irq %s in dts\n",
+				rkispp_irq_names[i]);
+			return irq;
+		}
+		/*
+		 * The per-frame reset re-attaches the iommu domain, which
+		 * sleeps: handle the interrupts in a thread.
+		 */
+		ret = devm_request_threaded_irq(device, irq, NULL,
+						rkispp_irq_hdl, IRQF_ONESHOT,
+						dev_driver_string(device),
+						device);
+		if (ret < 0) {
+			dev_err(device, "request %s failed: %d\n",
+				rkispp_irq_names[i], ret);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+int rkispp_hw_init(struct rkispp_device *dev)
+{
+	struct rkispp_hw_dev *hw = &dev->hw_dev;
+	struct device *device = dev->dev;
+	struct resource *res;
+	int i, ret;
+
+	res = platform_get_resource(to_platform_device(device), IORESOURCE_MEM,
+				    0);
+	if (!res) {
+		dev_err(device, "get resource failed\n");
+		return -EINVAL;
+	}
+	hw->dev = device;
+	hw->base_addr = devm_ioremap_resource(device, res);
+	if (IS_ERR(hw->base_addr)) {
+		dev_err(device, "ioremap failed\n");
+		return PTR_ERR(hw->base_addr);
+	}
+
+	ret = rkispp_request_irqs(dev);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(ispp_clks); i++) {
+		struct clk *clk = devm_clk_get(device, ispp_clks[i]);
+
+		if (IS_ERR(clk)) {
+			dev_err(device, "failed to get %s\n", ispp_clks[i]);
+			return PTR_ERR(clk);
+		}
+		hw->clks[i] = clk;
+	}
+	hw->clks_num = ARRAY_SIZE(ispp_clks);
+	hw->clk_rate_tbl = ispp_clk_rate;
+	hw->clk_rate_tbl_num = ARRAY_SIZE(ispp_clk_rate);
+
+	spin_lock_init(&hw->irq_lock);
+	hw->is_first = true;
+	hw->is_shutdown = false;
+
+	ret = of_reserved_mem_device_init(device);
+	if (ret)
+		dev_dbg(device, "no reserved memory region\n");
+
+	pm_runtime_enable(device);
+
+	return 0;
+}
+
+void rkispp_hw_exit(struct rkispp_device *dev)
+{
+	struct device *device = dev->dev;
+
+	pm_runtime_disable(device);
+}
