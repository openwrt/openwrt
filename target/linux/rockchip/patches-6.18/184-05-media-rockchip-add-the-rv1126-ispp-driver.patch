+# SPDX-License-Identifier: GPL-2.0-only
+
+config VIDEO_ROCKCHIP_ISPP
+	tristate "Rockchip Image Post-Processing Unit driver"
+	depends on V4L_PLATFORM_DRIVERS
+	depends on VIDEO_DEV && OF
+	depends on ARCH_ROCKCHIP || COMPILE_TEST
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select VIDEOBUF2_DMA_CONTIG
+	select VIDEOBUF2_VMALLOC
+	select V4L2_FWNODE
+	select V4L2_ISP
+	default n
+	help
+	  Enable this to support the Image Post-Processing (ISPP) unit
+	  present in the RV1126 SoC. The ISPP follows the ISP2 in the
+	  camera pipeline and applies temporal noise reduction, noise
+	  reduction, sharpening and scaling to its YUV422 input, while
+	  measuring a FEC motion mesh and ORB feature points per frame.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called video-rkispp.
