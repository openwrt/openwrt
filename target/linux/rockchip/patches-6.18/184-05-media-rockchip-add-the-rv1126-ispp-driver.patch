+	struct rkispp_vdev_node vnode;
+	struct rkispp_device *dev;
+
+	/* protects params and cur_params */
+	spinlock_t config_lock;
+	struct list_head params;
+	struct rkispp_params_state cur_params;
+	bool first_params;
+	bool streamon;
+};
+
+/* apply the head queued buffer, if any */
+void rkispp_params_isr(struct rkispp_device *dev);
+/* re-write all module registers from the last applied params */
+void rkispp_params_reapply(struct rkispp_device *dev);
+int rkispp_register_params_vdev(struct rkispp_device *dev);
+void rkispp_unregister_params_vdev(struct rkispp_device *dev);
+
+#endif
