+#define RKISPP_STATS_REQ_BUFS_MIN 2
+#define RKISPP_STATS_REQ_BUFS_MAX 8
+
+#define RKISPP_STATS_BLOCK_INFO(block, data)                \
+	[RKISPP_STATS_BLOCK_##block] = {                    \
+		.size = sizeof(struct rkispp_stats_##data), \
+	}
+
+static const struct v4l2_isp_stats_block_type_info rkispp_stats_blocks_info[] = {
+	RKISPP_STATS_BLOCK_INFO(ORB, orb),
+	RKISPP_STATS_BLOCK_INFO(FEC_MESH, fec_mesh),
+};
+
+static void *rkispp_stats_block(struct rkispp_device *dev,
+				struct v4l2_isp_buffer *stat_buf, u32 type)
+{
+	return v4l2_isp_stats_init_block(dev->dev, stat_buf,
+					 rkispp_stats_blocks_info,
+					 ARRAY_SIZE(rkispp_stats_blocks_info),
+					 type, RKISPP_STATS_MAX_SIZE);
+}
+
+static void rkispp_stats_fill_orb(struct rkispp_stats_vdev *stats_vdev,
+				  struct v4l2_isp_buffer *stat_buf, u32 frame)
+{
+	struct rkispp_device *dev = stats_vdev->dev;
+	struct rkispp_dummy_buffer *bank =
+		&stats_vdev->orb_buf[stats_vdev->orb_buf_idx];
+	struct rkispp_stats_orb *orb;
+	const struct rkispp_orb_hw_point *hw;
+	u32 total;
+	u32 i;
+
+	orb = rkispp_stats_block(dev, stat_buf, RKISPP_STATS_BLOCK_ORB);
+	if (IS_ERR(orb))
+		return;
+
+	total = rkispp_read(dev, RKISPP_ORB_TOTAL_NUM);
+	if (total > RKISPP_ORB_DATA_NUM) {
+		dev_err(dev->dev, "orb total %u exceeds %u, clamping\n", total,
+			RKISPP_ORB_DATA_NUM);
+		total = RKISPP_ORB_DATA_NUM;
+	}
+	orb->total_num = total;
+
+	hw = bank->vaddr;
+	for (i = 0; i < total; i++) {
+		struct rkispp_stats_orb_point *pt = &orb->points[i];
+
+		pt->x = hw[i].x;
+		pt->y = hw[i].y;
+		memcpy(pt->brief, hw[i].brief, RKISPP_ORB_BRIEF_NUM);
+	}
+}
+
+static void rkispp_stats_fill_fec_mesh(struct rkispp_stats_vdev *stats_vdev,
+				       struct v4l2_isp_buffer *stat_buf,
+				       u32 frame)
+{
+	struct rkispp_device *dev = stats_vdev->dev;
+	struct rkispp_subdev *sdev = &dev->ispp_sdev;
+	struct rkispp_dummy_buffer *bank =
+		&stats_vdev->mesh_buf[stats_vdev->mesh_buf_idx];
+	struct rkispp_stats_fec_mesh *mesh;
+	u32 w = sdev->out_fmt.width;
+	bool density = w > 1920;
+	u32 n = stats_vdev->mesh_size;
+	u32 i;
+
+	mesh = rkispp_stats_block(dev, stat_buf, RKISPP_STATS_BLOCK_FEC_MESH);
+	if (IS_ERR(mesh))
+		return;
+
+	mesh->mesh_width = density ? w / 32 + 1 : w / 16 + 1;
+	mesh->mesh_height = density ? 9 : 17;
+	mesh->points = n;
+
+	for (i = 0; i < n; i++) {
+		mesh->xfra[i] =
+			((__u8 *)bank->vaddr)[rkispp_mesh_xfra_oft(n) + i];
+		mesh->yfra[i] =
+			((__u8 *)bank->vaddr)[rkispp_mesh_yfra_oft(n) + i];
+		mesh->xint[i] =
+			((__u16 *)bank->vaddr)[rkispp_mesh_xint_oft(n) / 2 + i];
+		mesh->yint[i] =
+			((__u16 *)bank->vaddr)[rkispp_mesh_yint_oft(n) / 2 + i];
+	}
+}
+
+/* runs after the pipeline interrupt has advanced the frame sequence */
+static void rkispp_stats_frame_end(struct rkispp_device *dev)
+{
+	struct rkispp_stats_vdev *stats_vdev = &dev->stats_vdev;
+	struct rkispp_buffer *curr_buf, *next_buf;
+	unsigned long flags;
+	u32 frame = dev->ispp_sdev.frm_sync_seq;
+
+	spin_lock_irqsave(&stats_vdev->irq_lock, flags);
+	if (!stats_vdev->streamon || frame == stats_vdev->done_frame)
+		goto unlock;
+	stats_vdev->done_frame = frame;
+
+	curr_buf = stats_vdev->curr_buf;
+	if (curr_buf) {
+		struct v4l2_isp_buffer *stat_buf =
+			vb2_plane_vaddr(&curr_buf->vb.vb2_buf, 0);
+
+		v4l2_isp_stats_init_buffer(stat_buf, V4L2_ISP_VERSION_V1);
+		if (dev->stream_vdev.module_ens & ISPP_MODULE_ORB)
+			rkispp_stats_fill_orb(stats_vdev, stat_buf, frame);
+		if (dev->stream_vdev.module_ens & ISPP_MODULE_FEC)
+			rkispp_stats_fill_fec_mesh(stats_vdev, stat_buf, frame);
+
+		curr_buf->vb.sequence = frame;
+		curr_buf->vb.vb2_buf.timestamp = ktime_get_ns();
+		vb2_set_plane_payload(&curr_buf->vb.vb2_buf, 0,
+				      sizeof(struct v4l2_isp_buffer) +
+					      stat_buf->data_size);
+		vb2_buffer_done(&curr_buf->vb.vb2_buf, VB2_BUF_STATE_DONE);
+		stats_vdev->curr_buf = NULL;
+	}
+
+	next_buf = stats_vdev->next_buf;
+	stats_vdev->next_buf = NULL;
+	if (!list_empty(&stats_vdev->stat)) {
+		next_buf = list_first_entry(&stats_vdev->stat,
+					    struct rkispp_buffer, queue);
+		list_del(&next_buf->queue);
+	}
+	stats_vdev->curr_buf = next_buf;
+
+	/* the scratch banks exist only while the pipeline runs */
+	if (!stats_vdev->orb_buf[0].vaddr)
+		goto unlock;
+	stats_vdev->orb_buf_idx ^= 1;
+	rkispp_write(dev, RKISPP_ORB_WR_BASE,
+		     stats_vdev->orb_buf[stats_vdev->orb_buf_idx].dma_addr);
+	stats_vdev->mesh_buf_idx ^= 1;
+	{
+		struct rkispp_dummy_buffer *bank =
+			&stats_vdev->mesh_buf[stats_vdev->mesh_buf_idx];
+		u32 n = stats_vdev->mesh_size;
+
+		rkispp_write(dev, RKISPP_FEC_MESH_XFRA_BASE,
+			     bank->dma_addr + rkispp_mesh_xfra_oft(n));
+		rkispp_write(dev, RKISPP_FEC_MESH_YFRA_BASE,
+			     bank->dma_addr + rkispp_mesh_yfra_oft(n));
+		rkispp_write(dev, RKISPP_FEC_MESH_XINT_BASE,
+			     bank->dma_addr + rkispp_mesh_xint_oft(n));
+		rkispp_write(dev, RKISPP_FEC_MESH_YINT_BASE,
+			     bank->dma_addr + rkispp_mesh_yint_oft(n));
+	}
+unlock:
+	spin_unlock_irqrestore(&stats_vdev->irq_lock, flags);
+}
+
+void rkispp_stats_isr(struct rkispp_device *dev, u32 mis)
+{
+	if (!(mis & (ORB_INT | FEC_INT)))
+		return;
+
+	rkispp_stats_frame_end(dev);
+}
+
+int rkispp_stats_init_scratch(struct rkispp_device *dev)
+{
+	struct rkispp_stats_vdev *stats_vdev = &dev->stats_vdev;
+	struct rkispp_subdev *sdev = &dev->ispp_sdev;
+	u32 w = sdev->out_fmt.width;
+	u32 h = sdev->out_fmt.height;
+	struct rkispp_dummy_buffer *buf;
+	size_t orb_size, mesh_size;
+	u32 i, ret;
+
+	if (stats_vdev->orb_buf[0].vaddr)
+		return 0;
+
+	stats_vdev->mesh_size = cal_fec_mesh(w, h, w > 1920);
+	if (stats_vdev->mesh_size > RKISPP_FEC_MESH_POINTS_MAX) {
+		dev_err(dev->dev,
+			"mesh size %u exceeds the stats buffer limit\n",
+			stats_vdev->mesh_size);
+		return -EINVAL;
+	}
+
+	orb_size = RKISPP_ORB_DATA_NUM * sizeof(struct rkispp_orb_hw_point);
+	mesh_size = PAGE_ALIGN(rkispp_mesh_bank_size(stats_vdev->mesh_size));
+	for (i = 0; i < RKISPP_ORB_BUF_NUM; i++) {
+		buf = &stats_vdev->orb_buf[i];
+		ret = rkispp_dummy_buffer_alloc(dev, buf, orb_size, 0);
+		if (ret)
+			goto err;
+	}
+	for (i = 0; i < RKISPP_FEC_MESH_BUF_NUM; i++) {
+		buf = &stats_vdev->mesh_buf[i];
+		ret = rkispp_dummy_buffer_alloc(dev, buf, mesh_size, 0);
+		if (ret)
+			goto err;
+	}
+
+	stats_vdev->orb_buf_idx = 0;
+	stats_vdev->mesh_buf_idx = 0;
+	rkispp_write(dev, RKISPP_ORB_WR_BASE, stats_vdev->orb_buf[0].dma_addr);
+	{
+		struct rkispp_dummy_buffer *bank = &stats_vdev->mesh_buf[0];
+		u32 n = stats_vdev->mesh_size;
+
+		rkispp_write(dev, RKISPP_FEC_MESH_XFRA_BASE,
+			     bank->dma_addr + rkispp_mesh_xfra_oft(n));
+		rkispp_write(dev, RKISPP_FEC_MESH_YFRA_BASE,
+			     bank->dma_addr + rkispp_mesh_yfra_oft(n));
+		rkispp_write(dev, RKISPP_FEC_MESH_XINT_BASE,
+			     bank->dma_addr + rkispp_mesh_xint_oft(n));
+		rkispp_write(dev, RKISPP_FEC_MESH_YINT_BASE,
+			     bank->dma_addr + rkispp_mesh_yint_oft(n));
+	}
+
+	return 0;
+err:
+	rkispp_stats_uninit_scratch(dev);
+	return ret;
+}
+
+void rkispp_stats_uninit_scratch(struct rkispp_device *dev)
+{
+	struct rkispp_stats_vdev *stats_vdev = &dev->stats_vdev;
+	u32 i;
+
+	for (i = 0; i < RKISPP_ORB_BUF_NUM; i++)
+		rkispp_dummy_buffer_free(dev, &stats_vdev->orb_buf[i]);
+	for (i = 0; i < RKISPP_FEC_MESH_BUF_NUM; i++)
+		rkispp_dummy_buffer_free(dev, &stats_vdev->mesh_buf[i]);
+}
+
+static int rkispp_stats_enum_fmt_meta_cap(struct file *file, void *priv,
+					  struct v4l2_fmtdesc *f)
+{
+	struct video_device *video = video_devdata(file);
+	struct rkispp_stats_vdev *stats_vdev = video_get_drvdata(video);
+
+	if (f->index > 0 || f->type != video->queue->type)
+		return -EINVAL;
+
+	f->pixelformat = stats_vdev->vdev_fmt.fmt.meta.dataformat;
+	return 0;
+}
+
+static int rkispp_stats_g_fmt_meta_cap(struct file *file, void *priv,
+				       struct v4l2_format *f)
+{
+	struct video_device *video = video_devdata(file);
+	struct rkispp_stats_vdev *stats_vdev = video_get_drvdata(video);
+	struct v4l2_meta_format *meta = &f->fmt.meta;
+
+	if (f->type != video->queue->type)
+		return -EINVAL;
+
+	memset(meta, 0, sizeof(*meta));
+	meta->dataformat = stats_vdev->vdev_fmt.fmt.meta.dataformat;
+	meta->buffersize = stats_vdev->vdev_fmt.fmt.meta.buffersize;
+
+	return 0;
+}
+
+static int rkispp_stats_querycap(struct file *file, void *priv,
+				 struct v4l2_capability *cap)
+{
+	struct video_device *vdev = video_devdata(file);
+
+	strscpy(cap->driver, DRIVER_NAME, sizeof(cap->driver));
+	strscpy(cap->card, vdev->name, sizeof(cap->card));
+	strscpy(cap->bus_info, "platform: " DRIVER_NAME, sizeof(cap->bus_info));
+
+	return 0;
+}
+
+static const struct v4l2_ioctl_ops rkispp_stats_ioctl = {
+	.vidioc_reqbufs = vb2_ioctl_reqbufs,
+	.vidioc_querybuf = vb2_ioctl_querybuf,
+	.vidioc_create_bufs = vb2_ioctl_create_bufs,
+	.vidioc_qbuf = vb2_ioctl_qbuf,
+	.vidioc_dqbuf = vb2_ioctl_dqbuf,
+	.vidioc_prepare_buf = vb2_ioctl_prepare_buf,
+	.vidioc_expbuf = vb2_ioctl_expbuf,
+	.vidioc_streamon = vb2_ioctl_streamon,
+	.vidioc_streamoff = vb2_ioctl_streamoff,
+	.vidioc_enum_fmt_meta_cap = rkispp_stats_enum_fmt_meta_cap,
+	.vidioc_g_fmt_meta_cap = rkispp_stats_g_fmt_meta_cap,
+	.vidioc_s_fmt_meta_cap = rkispp_stats_g_fmt_meta_cap,
+	.vidioc_try_fmt_meta_cap = rkispp_stats_g_fmt_meta_cap,
+	.vidioc_querycap = rkispp_stats_querycap,
+};
+
+static const struct v4l2_file_operations rkispp_stats_fops = {
+	.mmap = vb2_fop_mmap,
+	.unlocked_ioctl = video_ioctl2,
+	.poll = vb2_fop_poll,
+	.open = v4l2_fh_open,
+	.release = vb2_fop_release,
+};
+
+static int rkispp_stats_vb2_queue_setup(struct vb2_queue *vq,
+					unsigned int *num_buffers,
+					unsigned int *num_planes,
+					unsigned int sizes[],
+					struct device *alloc_ctxs[])
+{
+	struct rkispp_stats_vdev *stats_vdev = vq->drv_priv;
+
+	*num_planes = 1;
+
+	*num_buffers = clamp_t(u32, *num_buffers, RKISPP_STATS_REQ_BUFS_MIN,
+			       RKISPP_STATS_REQ_BUFS_MAX);
+
+	sizes[0] = v4l2_isp_buffer_size(RKISPP_STATS_MAX_SIZE);
+
+	INIT_LIST_HEAD(&stats_vdev->stat);
+
+	return 0;
+}
+
+static int rkispp_stats_vb2_buf_prepare(struct vb2_buffer *vb)
+{
+	if (vb2_plane_size(vb, 0) < v4l2_isp_buffer_size(RKISPP_STATS_MAX_SIZE))
+		return -EINVAL;
+
+	vb2_set_plane_payload(vb, 0,
+			      v4l2_isp_buffer_size(RKISPP_STATS_MAX_SIZE));
+
+	return 0;
+}
+
+static void rkispp_stats_vb2_buf_queue(struct vb2_buffer *vb)
+{
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct rkispp_buffer *buf = to_rkispp_buffer(vbuf);
+	struct vb2_queue *vq = vb->vb2_queue;
+	struct rkispp_stats_vdev *stats_dev = vq->drv_priv;
+	unsigned long flags;
+
+	spin_lock_irqsave(&stats_dev->irq_lock, flags);
+	if (stats_dev->streamon && !stats_dev->next_buf)
+		stats_dev->next_buf = buf;
+	else
+		list_add_tail(&buf->queue, &stats_dev->stat);
+	spin_unlock_irqrestore(&stats_dev->irq_lock, flags);
+}
+
+static void rkispp_stats_destroy_buf_queue(struct rkispp_stats_vdev *stats_vdev,
+					   enum vb2_buffer_state state)
+{
+	struct rkispp_buffer *buf;
+
+	if (stats_vdev->curr_buf) {
+		list_add_tail(&stats_vdev->curr_buf->queue, &stats_vdev->stat);
+		stats_vdev->curr_buf = NULL;
+	}
+	if (stats_vdev->next_buf) {
+		list_add_tail(&stats_vdev->next_buf->queue, &stats_vdev->stat);
+		stats_vdev->next_buf = NULL;
+	}
+	while (!list_empty(&stats_vdev->stat)) {
+		buf = list_first_entry(&stats_vdev->stat, struct rkispp_buffer,
+				       queue);
+		list_del(&buf->queue);
+		vb2_buffer_done(&buf->vb.vb2_buf, state);
+	}
+}
+
+static void rkispp_stats_vb2_stop_streaming(struct vb2_queue *vq)
+{
+	struct rkispp_stats_vdev *stats_vdev = vq->drv_priv;
+	unsigned long flags;
+
+	spin_lock_irqsave(&stats_vdev->irq_lock, flags);
+	stats_vdev->streamon = false;
+	rkispp_stats_destroy_buf_queue(stats_vdev, VB2_BUF_STATE_ERROR);
+	spin_unlock_irqrestore(&stats_vdev->irq_lock, flags);
+}
+
+static int rkispp_stats_vb2_start_streaming(struct vb2_queue *vq,
+					    unsigned int count)
+{
+	struct rkispp_stats_vdev *stats_vdev = vq->drv_priv;
+	unsigned long flags;
+
+	if (stats_vdev->streamon)
+		return -EBUSY;
+
+	spin_lock_irqsave(&stats_vdev->irq_lock, flags);
+	stats_vdev->streamon = true;
+	stats_vdev->done_frame = 0xffffffffU;
+	spin_unlock_irqrestore(&stats_vdev->irq_lock, flags);
+
+	return 0;
+}
+
+static const struct vb2_ops rkispp_stats_vb2_ops = {
+	.queue_setup = rkispp_stats_vb2_queue_setup,
+	.buf_prepare = rkispp_stats_vb2_buf_prepare,
+	.buf_queue = rkispp_stats_vb2_buf_queue,
+	.start_streaming = rkispp_stats_vb2_start_streaming,
+	.stop_streaming = rkispp_stats_vb2_stop_streaming,
+};
+
+static int rkispp_stats_init_vb2_queue(struct vb2_queue *q,
+				       struct rkispp_stats_vdev *stats_vdev)
+{
+	q->type = V4L2_BUF_TYPE_META_CAPTURE;
+	q->io_modes = VB2_MMAP | VB2_DMABUF;
+	q->drv_priv = stats_vdev;
+	q->ops = &rkispp_stats_vb2_ops;
+	q->mem_ops = &vb2_dma_contig_memops;
+	q->buf_struct_size = sizeof(struct rkispp_buffer);
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	q->lock = &stats_vdev->dev->iqlock;
+	q->dev = stats_vdev->dev->dev;
+
+	return vb2_queue_init(q);
+}
+
+static void rkispp_stats_init_vdev_fmt(struct rkispp_stats_vdev *stats_vdev)
+{
+	stats_vdev->vdev_fmt.fmt.meta.dataformat = V4L2_META_FMT_RKISP2_STATS;
+	stats_vdev->vdev_fmt.fmt.meta.buffersize =
+		v4l2_isp_buffer_size(RKISPP_STATS_MAX_SIZE);
+}
+
+int rkispp_register_stats_vdev(struct rkispp_device *dev)
+{
+	struct rkispp_stats_vdev *stats_vdev = &dev->stats_vdev;
+	struct rkispp_vdev_node *node = &stats_vdev->vnode;
+	struct video_device *vdev = &node->vdev;
+	int ret;
+
+	stats_vdev->dev = dev;
+	INIT_LIST_HEAD(&stats_vdev->stat);
+	spin_lock_init(&stats_vdev->irq_lock);
+
+	strscpy(vdev->name, "rkispp-stats", sizeof(vdev->name));
+
+	vdev->ioctl_ops = &rkispp_stats_ioctl;
+	vdev->fops = &rkispp_stats_fops;
+	vdev->release = video_device_release_empty;
+	vdev->lock = &dev->iqlock;
+	vdev->v4l2_dev = &dev->v4l2_dev;
+	vdev->queue = &node->buf_queue;
+	vdev->device_caps = V4L2_CAP_META_CAPTURE | V4L2_CAP_STREAMING;
+	vdev->vfl_dir = VFL_DIR_RX;
+	rkispp_stats_init_vb2_queue(vdev->queue, stats_vdev);
+	rkispp_stats_init_vdev_fmt(stats_vdev);
+	video_set_drvdata(vdev, stats_vdev);
+
+	node->pad.flags = MEDIA_PAD_FL_SINK;
+	ret = media_entity_pads_init(&vdev->entity, 1, &node->pad);
+	if (ret)
+		goto err_release_queue;
+
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret) {
+		dev_err(&vdev->dev,
+			"failed to register Video for Linux device\n");
+		goto err_cleanup_media_entity;
+	}
+
+	return 0;
+
+err_cleanup_media_entity:
+	media_entity_cleanup(&vdev->entity);
+err_release_queue:
+	vb2_queue_release(vdev->queue);
+	return ret;
+}
+
+void rkispp_unregister_stats_vdev(struct rkispp_device *dev)
+{
+	struct rkispp_stats_vdev *stats_vdev = &dev->stats_vdev;
+	struct rkispp_vdev_node *node = &stats_vdev->vnode;
+	struct video_device *vdev = &node->vdev;
+
+	video_unregister_device(vdev);
+	media_entity_cleanup(&vdev->entity);
+	vb2_queue_release(vdev->queue);
+}
