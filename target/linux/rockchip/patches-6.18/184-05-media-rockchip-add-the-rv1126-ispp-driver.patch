+		val = ISPP_PACK_2SHORT(arg->ynr_hstv_y[i],
+				       arg->ynr_hstv_y[i + 1]);
+		rkispp_write(dev, RKISPP_NR_YNR_HSTV_Y_0_1 + i * 2, val);
+	}
+	rkispp_write(dev, RKISPP_NR_YNR_HSTV_Y_16, arg->ynr_hstv_y[16]);
+
+	val = ISPP_PACK_2SHORT(arg->ynr_st_scale[0], arg->ynr_st_scale[1]);
+	rkispp_write(dev, RKISPP_NR_YNR_ST_SCALE_LV1_LV2, val);
+	rkispp_write(dev, RKISPP_NR_YNR_ST_SCALE_LV3, arg->ynr_st_scale[2]);
+
+	big_en = arg->uvnr_big_en & 0x01;
+	nobig_en = arg->uvnr_nobig_en & 0x01;
+	if (get_input_size(dev) > ISPP_NOBIG_OVERFLOW_SIZE) {
+		big_en = 1;
+		nobig_en = 0;
+	}
+
+	sd32_self_en = arg->uvnr_sd32_self_en;
+	val = arg->uvnr_step1_en << 1 | arg->uvnr_step2_en << 2 |
+	      arg->nr_gain_en << 3 | sd32_self_en << 4 | nobig_en << 5 |
+	      big_en << 6;
+	rkispp_set_bits(dev, RKISPP_NR_UVNR_CTRL_PARA,
+			SW_UVNR_STEP1_ON | SW_UVNR_STEP2_ON |
+				SW_NR_GAIN_BYPASS | SW_UVNR_NOBIG_EN |
+				SW_UVNR_BIG_EN,
+			val);
+}
+
+static void rkispp_params_nr_enable(struct rkispp_device *dev, bool en,
+				    union rkispp_params_block block)
+{
+	const struct rkispp_params_nr *arg = block.nr;
+	u8 big_en, nobig_en;
+	u32 val;
+
+	big_en = arg->uvnr_big_en & 0x01;
+	nobig_en = arg->uvnr_nobig_en & 0x01;
+	if (get_input_size(dev) > ISPP_NOBIG_OVERFLOW_SIZE) {
+		big_en = 1;
+		nobig_en = 0;
+	}
+
+	val = arg->uvnr_step1_en << 1 | arg->uvnr_step2_en << 2 |
+	      arg->nr_gain_en << 3 | nobig_en << 5 | big_en << 6;
+
+	if (en)
+		val |= SW_NR_EN;
+
+	rkispp_set_bits(dev, RKISPP_NR_UVNR_CTRL_PARA,
+			SW_UVNR_STEP1_ON | SW_UVNR_STEP2_ON |
+				SW_NR_GAIN_BYPASS | SW_UVNR_NOBIG_EN |
+				SW_UVNR_BIG_EN | SW_NR_EN,
+			val);
+}
+
+static void rkispp_params_shp(struct rkispp_device *dev,
+			      union rkispp_params_block block)
+{
+	struct rkispp_params_vdev *params_vdev = &dev->params_vdev;
+	const struct rkispp_params_shp *arg = block.shp;
+	u32 i, val;
+
+	memcpy(&params_vdev->cur_params.shp, arg, sizeof(*arg));
+
+	rkispp_set_bits(dev, RKISPP_SHARP_CTRL, SW_SHP_WR_ROT_MODE(3),
+			SW_SHP_WR_ROT_MODE(arg->rotation));
+
+	rkispp_write(dev, RKISPP_SHARP_SC_DOWN,
+		     (arg->scl_down_v & 0x1) << 1 | (arg->scl_down_h & 0x1));
+
+	rkispp_write(dev, RKISPP_SHARP_TILE_IDX,
+		     (arg->tile_ycnt & 0x1F) << 8 | (arg->tile_xcnt & 0xFF));
+
+	rkispp_write(dev, RKISPP_SHARP_HBF_FACTOR,
+		     arg->hbf_ratio | arg->ehf_th << 16 | arg->pbf_ratio << 24);
+	rkispp_write(dev, RKISPP_SHARP_EDGE_TH,
+		     arg->edge_thed | arg->dir_min << 8 | arg->smoth_th4 << 16);
+	val = ISPP_PACK_2SHORT(arg->l_alpha, arg->g_alpha);
+	rkispp_write(dev, RKISPP_SHARP_EDGE_ALPHA, val);
+	val = ISPP_PACK_4BYTE(arg->pbf_k[0], arg->pbf_k[1], arg->pbf_k[2], 0);
+	rkispp_write(dev, RKISPP_SHARP_PBF_KERNEL, val);
+	val = ISPP_PACK_4BYTE(arg->mrf_k[0], arg->mrf_k[1], arg->mrf_k[2],
+			      arg->mrf_k[3]);
+	rkispp_write(dev, RKISPP_SHARP_MRF_KERNEL0, val);
+	val = ISPP_PACK_4BYTE(arg->mrf_k[4], arg->mrf_k[5], 0, 0);
+	rkispp_write(dev, RKISPP_SHARP_MRF_KERNEL1, val);
+
+	for (i = 0; i < RKISPP_SHP_MBF_KERNEL_SIZE; i += 4) {
+		val = ISPP_PACK_4BYTE(arg->mbf_k[i], arg->mbf_k[i + 1],
+				      arg->mbf_k[i + 2], arg->mbf_k[i + 3]);
+		rkispp_write(dev, RKISPP_SHARP_MBF_KERNEL0 + i, val);
+	}
+
+	val = ISPP_PACK_4BYTE(arg->hrf_k[0], arg->hrf_k[1], arg->hrf_k[2],
+			      arg->hrf_k[3]);
+	rkispp_write(dev, RKISPP_SHARP_HRF_KERNEL0, val);
+	val = ISPP_PACK_4BYTE(arg->hrf_k[4], arg->hrf_k[5], 0, 0);
+	rkispp_write(dev, RKISPP_SHARP_HRF_KERNEL1, val);
+	val = ISPP_PACK_4BYTE(arg->hbf_k[0], arg->hbf_k[1], arg->hbf_k[2], 0);
+	rkispp_write(dev, RKISPP_SHARP_HBF_KERNEL, val);
+
+	val = ISPP_PACK_4BYTE(arg->eg_coef[0], arg->eg_coef[1], arg->eg_coef[2],
+			      0);
+	rkispp_write(dev, RKISPP_SHARP_EDGE_COEF, val);
+	val = ISPP_PACK_4BYTE(arg->eg_smoth[0], arg->eg_smoth[1],
+			      arg->eg_smoth[2], 0);
+	rkispp_write(dev, RKISPP_SHARP_EDGE_SMOTH, val);
+	val = ISPP_PACK_4BYTE(arg->eg_gaus[0], arg->eg_gaus[1], arg->eg_gaus[2],
+			      arg->eg_gaus[3]);
+	rkispp_write(dev, RKISPP_SHARP_EDGE_GAUS0, val);
+	val = ISPP_PACK_4BYTE(arg->eg_gaus[4], arg->eg_gaus[5], 0, 0);
+	rkispp_write(dev, RKISPP_SHARP_EDGE_GAUS1, val);
+
+	val = ISPP_PACK_4BYTE(arg->dog_k[0], arg->dog_k[1], arg->dog_k[2],
+			      arg->dog_k[3]);
+	rkispp_write(dev, RKISPP_SHARP_DOG_KERNEL0, val);
+	val = ISPP_PACK_4BYTE(arg->dog_k[4], arg->dog_k[5], 0, 0);
+	rkispp_write(dev, RKISPP_SHARP_DOG_KERNEL1, val);
+	val = ISPP_PACK_4BYTE(arg->lum_point[0], arg->lum_point[1],
+			      arg->lum_point[2], arg->lum_point[3]);
+	rkispp_write(dev, RKISPP_SHARP_LUM_POINT0, val);
+	val = ISPP_PACK_4BYTE(arg->lum_point[4], arg->lum_point[5], 0, 0);
+	rkispp_write(dev, RKISPP_SHARP_LUM_POINT1, val);
+
+	val = ISPP_PACK_4BYTE(arg->pbf_shf_bits, arg->mbf_shf_bits,
+			      arg->hbf_shf_bits, 0);
+	rkispp_write(dev, RKISPP_SHARP_SHF_BITS, val);
+
+	for (i = 0; i < RKISPP_SHP_SIGMA_SIZE; i += 4) {
+		val = ISPP_PACK_4BYTE(arg->pbf_sigma[i], arg->pbf_sigma[i + 1],
+				      arg->pbf_sigma[i + 2],
+				      arg->pbf_sigma[i + 3]);
+		rkispp_write(dev, RKISPP_SHARP_PBF_SIGMA_INV0 + i, val);
+		val = ISPP_PACK_4BYTE(arg->mbf_sigma[i], arg->mbf_sigma[i + 1],
+				      arg->mbf_sigma[i + 2],
+				      arg->mbf_sigma[i + 3]);
+		rkispp_write(dev, RKISPP_SHARP_MBF_SIGMA_INV0 + i, val);
+		val = ISPP_PACK_4BYTE(arg->hbf_sigma[i], arg->hbf_sigma[i + 1],
+				      arg->hbf_sigma[i + 2],
+				      arg->hbf_sigma[i + 3]);
+		rkispp_write(dev, RKISPP_SHARP_HBF_SIGMA_INV0 + i, val);
+	}
+
+	for (i = 0; i < RKISPP_SHP_LUM_CLP_SIZE; i += 4) {
+		val = ISPP_PACK_4BYTE(arg->lum_clp_m[i], arg->lum_clp_m[i + 1],
+				      arg->lum_clp_m[i + 2],
+				      arg->lum_clp_m[i + 3]);
+		rkispp_write(dev, RKISPP_SHARP_LUM_CLP_M0 + i, val);
+		val = ISPP_PACK_4BYTE(arg->lum_clp_h[i], arg->lum_clp_h[i + 1],
+				      arg->lum_clp_h[i + 2],
+				      arg->lum_clp_h[i + 3]);
+		rkispp_write(dev, RKISPP_SHARP_LUM_CLP_H0 + i, val);
+	}
+
+	for (i = 0; i < RKISPP_SHP_LUM_MIN_SIZE; i += 4) {
+		val = ISPP_PACK_4BYTE(arg->lum_min_m[i], arg->lum_min_m[i + 1],
+				      arg->lum_min_m[i + 2],
+				      arg->lum_min_m[i + 3]);
+		rkispp_write(dev, RKISPP_SHARP_LUM_MIN_M0 + i, val);
+	}
+
+	for (i = 0; i < RKISPP_SHP_EDGE_LUM_THED_SIZE; i += 4) {
+		val = ISPP_PACK_4BYTE(arg->edge_lum_thed[i],
+				      arg->edge_lum_thed[i + 1],
+				      arg->edge_lum_thed[i + 2],
+				      arg->edge_lum_thed[i + 3]);
+		rkispp_write(dev, RKISPP_SHARP_EDGE_LUM_THED0 + i, val);
+	}
+
+	for (i = 0; i < RKISPP_SHP_CLAMP_SIZE; i += 4) {
+		val = ISPP_PACK_4BYTE(arg->clamp_pos[i], arg->clamp_pos[i + 1],
+				      arg->clamp_pos[i + 2],
+				      arg->clamp_pos[i + 3]);
+		rkispp_write(dev, RKISPP_SHARP_CLAMP_POS_DOG0 + i, val);
+		val = ISPP_PACK_4BYTE(arg->clamp_neg[i], arg->clamp_neg[i + 1],
+				      arg->clamp_neg[i + 2],
+				      arg->clamp_neg[i + 3]);
+		rkispp_write(dev, RKISPP_SHARP_CLAMP_NEG_DOG0 + i, val);
+	}
+
+	for (i = 0; i < RKISPP_SHP_DETAIL_ALPHA_SIZE; i += 4) {
+		val = ISPP_PACK_4BYTE(arg->detail_alpha[i],
+				      arg->detail_alpha[i + 1],
+				      arg->detail_alpha[i + 2],
+				      arg->detail_alpha[i + 3]);
+		rkispp_write(dev, RKISPP_SHARP_DETAIL_ALPHA_DOG0 + i, val);
+	}
+
+	val = ISPP_PACK_2SHORT(arg->rfl_ratio, arg->rfh_ratio);
+	rkispp_write(dev, RKISPP_SHARP_RF_RATIO, val);
+
+	val = ISPP_PACK_4BYTE(arg->m_ratio, arg->h_ratio, 0, 0);
+	rkispp_write(dev, RKISPP_SHARP_GRAD_RATIO, val);
+
+	val = arg->alpha_adp_en << 1 | arg->yin_flt_en << 3 |
+	      arg->edge_avg_en << 4;
+	rkispp_set_bits(dev, RKISPP_SHARP_CORE_CTRL,
+			SW_SHP_ALPHA_ADP_EN | SW_SHP_YIN_FLT_EN |
+				SW_SHP_EDGE_AVG_EN,
+			val);
+}
+
+static void rkispp_params_shp_enable(struct rkispp_device *dev, bool en,
+				     union rkispp_params_block block)
+{
+	const struct rkispp_params_shp *arg = block.shp;
+	u32 ens = dev->stream_vdev.module_ens;
+	u32 val;
+
+	if (en && !(ens & ISPP_MODULE_FEC)) {
+		rkispp_set_bits(dev, RKISPP_SCL0_CTRL, SW_SCL_FIRST_MODE,
+				SW_SCL_FIRST_MODE);
+		rkispp_set_bits(dev, RKISPP_SCL1_CTRL, SW_SCL_FIRST_MODE,
+				SW_SCL_FIRST_MODE);
+		rkispp_set_bits(dev, RKISPP_SCL2_CTRL, SW_SCL_FIRST_MODE,
+				SW_SCL_FIRST_MODE);
+	} else {
+		rkispp_clear_bits(dev, RKISPP_SCL0_CTRL, SW_SCL_FIRST_MODE);
+		rkispp_clear_bits(dev, RKISPP_SCL1_CTRL, SW_SCL_FIRST_MODE);
+		rkispp_clear_bits(dev, RKISPP_SCL2_CTRL, SW_SCL_FIRST_MODE);
+	}
+
+	val = arg->alpha_adp_en << 1 | arg->yin_flt_en << 3 |
+	      arg->edge_avg_en << 4;
+	if (en)
+		val |= SW_SHP_EN;
+	rkispp_set_bits(dev, RKISPP_SHARP_CORE_CTRL,
+			SW_SHP_ALPHA_ADP_EN | SW_SHP_YIN_FLT_EN |
+				SW_SHP_EDGE_AVG_EN | SW_SHP_EN,
+			val);
+}
+
+static void rkispp_params_fec(struct rkispp_device *dev,
+			      union rkispp_params_block block)
+{
+	struct rkispp_params_vdev *params_vdev = &dev->params_vdev;
+	const struct rkispp_params_fec *arg = block.fec;
+	u32 width, height, mesh_size;
+	u32 val;
+
+	memcpy(&params_vdev->cur_params.fec, arg, sizeof(*arg));
+
+	width = dev->ispp_sdev.out_fmt.width;
+	height = dev->ispp_sdev.out_fmt.height;
+	mesh_size = cal_fec_mesh(width, height, 0);
+	if (arg->mesh_size > mesh_size) {
+		v4l2_err(&dev->v4l2_dev,
+			 "fec mesh size %u exceeds the max %u\n",
+			 arg->mesh_size, mesh_size);
+		return;
+	}
+
+	/* the mesh buffers are the stats scratch banks, fixed per stream */
+
+	val = arg->mesh_density ? SW_MESH_DENSITY : 0;
+	rkispp_set_bits(dev, RKISPP_FEC_CORE_CTRL, SW_MESH_DENSITY, val);
+
+	rkispp_write(dev, RKISPP_FEC_MESH_SIZE, arg->mesh_size);
+
+	val = (arg->crop_height & 0x1FFFF) << 14 |
+	      (arg->crop_width & 0x1FFFF) << 1 | (arg->crop_en & 0x01);
+	rkispp_write(dev, RKISPP_FEC_CROP, val);
+}
+
+static void rkispp_params_fec_enable(struct rkispp_device *dev, bool en,
+				     union rkispp_params_block block)
+{
+	if (en) {
+		rkispp_clear_bits(dev, RKISPP_SCL0_CTRL, SW_SCL_FIRST_MODE);
+		rkispp_clear_bits(dev, RKISPP_SCL1_CTRL, SW_SCL_FIRST_MODE);
+		rkispp_clear_bits(dev, RKISPP_SCL2_CTRL, SW_SCL_FIRST_MODE);
+	}
+	rkispp_set_bits(dev, RKISPP_FEC_CORE_CTRL, SW_FEC_EN, en);
+}
+
+static void rkispp_params_orb(struct rkispp_device *dev,
+			      union rkispp_params_block block)
+{
+	struct rkispp_params_vdev *params_vdev = &dev->params_vdev;
+	const struct rkispp_params_orb *arg = block.orb;
+
+	memcpy(&params_vdev->cur_params.orb, arg, sizeof(*arg));
+
+	rkispp_write(dev, RKISPP_ORB_LIMIT_VALUE, arg->limit_value & 0xFF);
+	rkispp_write(dev, RKISPP_ORB_MAX_FEATURE, arg->max_feature & 0x1FFFFF);
+}
+
+static void rkispp_params_orb_enable(struct rkispp_device *dev, bool en,
+				     union rkispp_params_block block)
+{
+	rkispp_set_bits(dev, RKISPP_ORB_CORE_CTRL, SW_ORB_EN, en);
+}
+
+static const struct rkispp_params_block_handler_info
+rkispp_params_handlers[] = {
+	[0] = {
+		.module = ISPP_MODULE_TNR,
+		.config = rkispp_params_tnr,
+		.enable = rkispp_params_tnr_enable,
+	},
+	[1] = {
+		.module = ISPP_MODULE_NR,
+		.config = rkispp_params_nr,
+		.enable = rkispp_params_nr_enable,
+	},
+	[2] = {
+		.module = ISPP_MODULE_SHP,
+		.config = rkispp_params_shp,
+		.enable = rkispp_params_shp_enable,
+	},
+	[3] = {
+		.module = ISPP_MODULE_FEC,
+		.config = rkispp_params_fec,
+		.enable = rkispp_params_fec_enable,
+	},
+	[4] = {
+		.module = ISPP_MODULE_ORB,
+		.config = rkispp_params_orb,
+		.enable = rkispp_params_orb_enable,
+	},
+};
+
+static_assert(ARRAY_SIZE(rkispp_params_handlers) ==
+	      RKISPP_PARAMS_BLOCK_ORB + 1);
+
+static const struct v4l2_isp_params_block_type_info
+	rkispp_params_block_types_info[] = {
+		[0] = { .size = sizeof(struct rkispp_params_tnr) },
+		[1] = { .size = sizeof(struct rkispp_params_nr) },
+		[2] = { .size = sizeof(struct rkispp_params_shp) },
+		[3] = { .size = sizeof(struct rkispp_params_fec) },
+		[4] = { .size = sizeof(struct rkispp_params_orb) },
+	};
+
+static u32 rkispp_params_block_ens(struct rkispp_device *dev, u32 ens, u32 type,
+				   bool en,
+				   const union rkispp_params_block *block)
+{
+	switch (type) {
+	case RKISPP_PARAMS_BLOCK_TNR:
+		ens &= ~ISPP_MODULE_TNR_3TO1;
+		if (en) {
+			ens |= ISPP_MODULE_TNR;
+			if (block->tnr->mode == RKISPP_TNR_MODE_3_TO_1)
+				ens |= ISPP_MODULE_TNR_3TO1;
+		}
+		break;
+	case RKISPP_PARAMS_BLOCK_NR:
+		ens = (ens & ~ISPP_MODULE_NR) | (en ? ISPP_MODULE_NR : 0);
+		break;
+	case RKISPP_PARAMS_BLOCK_SHP:
+		ens = (ens & ~ISPP_MODULE_SHP) | (en ? ISPP_MODULE_SHP : 0);
+		break;
+	case RKISPP_PARAMS_BLOCK_FEC:
+		ens = (ens & ~ISPP_MODULE_FEC) | (en ? ISPP_MODULE_FEC : 0);
+		break;
+	case RKISPP_PARAMS_BLOCK_ORB:
+		ens = (ens & ~ISPP_MODULE_ORB) | (en ? ISPP_MODULE_ORB : 0);
+		break;
+	}
+	return ens;
+}
+
+static bool rkispp_params_block_en(struct rkispp_device *dev, u32 type,
+				   u32 flags)
+{
+	if (type == RKISPP_PARAMS_BLOCK_TNR && dev->inp != INP_ISP)
+		return false;
+	return !(flags & V4L2_ISP_PARAMS_FL_BLOCK_DISABLE);
+}
+
+/* the module enable mask after the blocks of @cfg, starting from @ens */
+static u32 rkispp_params_buf_ens(struct rkispp_device *dev,
+				 const struct v4l2_isp_params_buffer *cfg,
+				 u32 ens)
+{
+	size_t block_offset = 0, max_offset = cfg->data_size;
+
+	while (max_offset && block_offset < max_offset) {
+		union rkispp_params_block block;
+		u32 type;
+		bool en;
+
+		block.data = &cfg->data[block_offset];
+		block_offset += block.header->size;
+		type = block.header->type;
+		if (type >= ARRAY_SIZE(rkispp_params_handlers))
+			continue;
+		en = rkispp_params_block_en(dev, type, block.header->flags);
+		ens = rkispp_params_block_ens(dev, ens, type, en, &block);
+	}
+
+	return ens;
+}
+
+/* the enable mask is settled before any block writes a register */
+static void rkispp_params_apply(struct rkispp_device *dev,
+				struct rkispp_params_buffer *buf)
+{
+	struct rkispp_stream_vdev *stream_vdev = &dev->stream_vdev;
+	const struct rkispp_params_block_handler_info *info;
+	struct v4l2_isp_params_buffer *cfg = buf->cfg;
+	size_t block_offset = 0, max_offset = cfg->data_size;
+
+	stream_vdev->module_ens =
+		rkispp_params_buf_ens(dev, cfg, stream_vdev->module_ens);
+
+	while (max_offset && block_offset < max_offset) {
+		union rkispp_params_block block;
+		u32 type;
+
+		block.data = &cfg->data[block_offset];
+		block_offset += block.header->size;
+		type = block.header->type;
+		if (type >= ARRAY_SIZE(rkispp_params_handlers))
+			continue;
+		info = &rkispp_params_handlers[type];
+		if (rkispp_params_block_en(dev, type, block.header->flags)) {
+			info->config(dev, block);
+			info->enable(dev, true, block);
+		} else {
+			info->enable(dev, false, block);
+		}
+	}
+
+	v4l2_dbg(2, rkispp_debug, &dev->v4l2_dev,
+		 "params applied, module ens:0x%x\n", stream_vdev->module_ens);
+	vb2_buffer_done(&buf->vb.vb2_buf, VB2_BUF_STATE_DONE);
+}
+
+void rkispp_params_isr(struct rkispp_device *dev)
+{
+	struct rkispp_params_vdev *params_vdev = &dev->params_vdev;
+	struct rkispp_params_buffer *buf;
+	unsigned long flags;
+
+	/* called from the stream interrupt */
+	spin_lock_irqsave(&params_vdev->config_lock, flags);
+	if (!params_vdev->streamon) {
+		spin_unlock_irqrestore(&params_vdev->config_lock, flags);
+		return;
+	}
+	buf = list_first_entry_or_null(&params_vdev->params,
+				       struct rkispp_params_buffer, queue);
+	if (buf)
+		list_del(&buf->queue);
+	spin_unlock_irqrestore(&params_vdev->config_lock, flags);
+
+	if (buf)
+		rkispp_params_apply(dev, buf);
+}
+
+/* re-write the module registers and enables after a soft reset */
+void rkispp_params_reapply(struct rkispp_device *dev)
+{
+	struct rkispp_params_vdev *params_vdev = &dev->params_vdev;
+	struct rkispp_params_state local;
+	const void *blocks[] = {
+		[RKISPP_PARAMS_BLOCK_TNR] = &local.tnr,
+		[RKISPP_PARAMS_BLOCK_NR] = &local.nr,
+		[RKISPP_PARAMS_BLOCK_SHP] = &local.shp,
+		[RKISPP_PARAMS_BLOCK_FEC] = &local.fec,
+		[RKISPP_PARAMS_BLOCK_ORB] = &local.orb,
+	};
+	u32 ens = dev->stream_vdev.module_ens;
+	unsigned long flags;
+	unsigned int i;
+
+	spin_lock_irqsave(&params_vdev->config_lock, flags);
+	memcpy(&local, &params_vdev->cur_params, sizeof(local));
+	spin_unlock_irqrestore(&params_vdev->config_lock, flags);
+
+	for (i = 0; i < ARRAY_SIZE(rkispp_params_handlers); i++) {
+		const struct rkispp_params_block_handler_info *info =
+			&rkispp_params_handlers[i];
+		union rkispp_params_block block = { .data = blocks[i] };
+
+		if (!(ens & info->module))
+			continue;
+		info->config(dev, block);
+		info->enable(dev, true, block);
+	}
+}
+
+static int rkispp_params_enum_fmt_meta_out(struct file *file, void *fh,
+					   struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+
+	if (f->mbus_code && f->mbus_code != MEDIA_BUS_FMT_METADATA_FIXED)
+		return -EINVAL;
+
+	f->pixelformat = V4L2_META_FMT_RKISP2_PARAMS;
+
+	return 0;
+}
+
+static int rkispp_params_g_fmt_meta_out(struct file *file, void *fh,
+					struct v4l2_format *f)
+{
+	static const struct v4l2_meta_format mfmt = {
+		.dataformat = V4L2_META_FMT_RKISP2_PARAMS,
+		.buffersize = v4l2_isp_buffer_size(RKISPP_PARAMS_MAX_SIZE),
+	};
+
+	f->fmt.meta = mfmt;
+
+	return 0;
+}
+
+static int rkispp_params_querycap(struct file *file, void *priv,
+				  struct v4l2_capability *cap)
+{
+	struct video_device *vdev = video_devdata(file);
+
+	strscpy(cap->driver, DRIVER_NAME, sizeof(cap->driver));
+	strscpy(cap->card, vdev->name, sizeof(cap->card));
+	strscpy(cap->bus_info, "platform: " DRIVER_NAME, sizeof(cap->bus_info));
+
+	return 0;
+}
+
+static const struct v4l2_ioctl_ops rkispp_params_ioctl = {
+	.vidioc_reqbufs = vb2_ioctl_reqbufs,
+	.vidioc_querybuf = vb2_ioctl_querybuf,
+	.vidioc_create_bufs = vb2_ioctl_create_bufs,
+	.vidioc_qbuf = vb2_ioctl_qbuf,
+	.vidioc_dqbuf = vb2_ioctl_dqbuf,
+	.vidioc_prepare_buf = vb2_ioctl_prepare_buf,
+	.vidioc_expbuf = vb2_ioctl_expbuf,
+	.vidioc_streamon = vb2_ioctl_streamon,
+	.vidioc_streamoff = vb2_ioctl_streamoff,
+	.vidioc_enum_fmt_meta_out = rkispp_params_enum_fmt_meta_out,
+	.vidioc_g_fmt_meta_out = rkispp_params_g_fmt_meta_out,
+	.vidioc_s_fmt_meta_out = rkispp_params_g_fmt_meta_out,
+	.vidioc_try_fmt_meta_out = rkispp_params_g_fmt_meta_out,
+	.vidioc_querycap = rkispp_params_querycap,
+};
+
+static int rkispp_params_vb2_queue_setup(struct vb2_queue *vq,
+					 unsigned int *num_buffers,
+					 unsigned int *num_planes,
+					 unsigned int sizes[],
+					 struct device *alloc_devs[])
+{
+	struct rkispp_params_vdev *params_vdev = vq->drv_priv;
+
+	*num_buffers = clamp_t(u32, *num_buffers,
+			       RKISPP_ISP_PARAMS_REQ_BUFS_MIN,
+			       RKISPP_ISP_PARAMS_REQ_BUFS_MAX);
+
+	*num_planes = 1;
+	sizes[0] = v4l2_isp_buffer_size(RKISPP_PARAMS_MAX_SIZE);
+
+	INIT_LIST_HEAD(&params_vdev->params);
+	params_vdev->first_params = true;
+
+	return 0;
+}
+
+static int rkispp_params_vb2_buf_init(struct vb2_buffer *vb)
+{
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct rkispp_params_buffer *params_buf;
+
+	params_buf = container_of(vbuf, struct rkispp_params_buffer, vb);
+
+	params_buf->cfg = kvmalloc(v4l2_isp_buffer_size(RKISPP_PARAMS_MAX_SIZE),
+				   GFP_KERNEL);
+	if (!params_buf->cfg)
+		return -ENOMEM;
+
+	return 0;
+}
+
+static void rkispp_params_vb2_buf_cleanup(struct vb2_buffer *vb)
+{
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct rkispp_params_buffer *params_buf;
+
+	params_buf = container_of(vbuf, struct rkispp_params_buffer, vb);
+
+	kvfree(params_buf->cfg);
+	params_buf->cfg = NULL;
+}
+
+static void rkispp_params_vb2_buf_queue(struct vb2_buffer *vb)
+{
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct rkispp_params_buffer *params_buf;
+	struct rkispp_params_vdev *params_vdev = vb->vb2_queue->drv_priv;
+	struct rkispp_device *dev = params_vdev->dev;
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	unsigned long flags;
+
+	params_buf = container_of(vbuf, struct rkispp_params_buffer, vb);
+
+	spin_lock_irqsave(&params_vdev->config_lock, flags);
+	if (params_vdev->first_params) {
+		params_vdev->first_params = false;
+		/* the engine starts from this buffer: its blocks set the mask */
+		vdev->module_ens = rkispp_params_buf_ens(dev, params_buf->cfg,
+							 vdev->module_ens);
+		wake_up(&dev->sync_onoff);
+	}
+	list_add_tail(&params_buf->queue, &params_vdev->params);
+	spin_unlock_irqrestore(&params_vdev->config_lock, flags);
+}
+
+static int rkispp_params_vb2_buf_prepare(struct vb2_buffer *vb)
+{
+	struct rkispp_params_vdev *params_vdev = vb->vb2_queue->drv_priv;
+	struct rkispp_device *dev = params_vdev->dev;
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct rkispp_params_buffer *params_buf;
+	struct v4l2_isp_params_buffer *cfg;
+	size_t payload_size = vb2_get_plane_payload(vb, 0);
+	size_t max_size = v4l2_isp_buffer_size(RKISPP_PARAMS_MAX_SIZE);
+	size_t ntypes = ARRAY_SIZE(rkispp_params_block_types_info);
+	int ret;
+
+	params_buf = container_of(vbuf, struct rkispp_params_buffer, vb);
+
+	ret = v4l2_isp_params_validate_buffer_size(dev->dev, vb, max_size);
+	if (ret)
+		return ret;
+
+	/*
+	 * Copy the parameters buffer to the internal scratch buffer to
+	 * avoid userspace modifying the buffer content while the
+	 * driver processes it.
+	 */
+	cfg = (struct v4l2_isp_params_buffer *)vb2_plane_vaddr(vb, 0);
+	memcpy(params_buf->cfg, cfg, payload_size);
+
+	return v4l2_isp_params_validate_buffer(dev->dev, vb, params_buf->cfg,
+					       rkispp_params_block_types_info,
+					       ntypes);
+}
+
+static int rkispp_params_vb2_start_streaming(struct vb2_queue *queue,
+					     unsigned int count)
+{
+	struct rkispp_params_vdev *params_vdev = queue->drv_priv;
+	unsigned long flags;
+
+	spin_lock_irqsave(&params_vdev->config_lock, flags);
+	params_vdev->streamon = true;
+	spin_unlock_irqrestore(&params_vdev->config_lock, flags);
+
+	wake_up(&params_vdev->dev->sync_onoff);
+
+	return 0;
+}
+
+static void rkispp_params_vb2_stop_streaming(struct vb2_queue *vq)
+{
+	struct rkispp_params_vdev *params_vdev = vq->drv_priv;
+	struct rkispp_params_buffer *buf;
+	LIST_HEAD(tmp_list);
+	unsigned long flags;
+
+	spin_lock_irqsave(&params_vdev->config_lock, flags);
+	params_vdev->streamon = false;
+	list_splice_init(&params_vdev->params, &tmp_list);
+	spin_unlock_irqrestore(&params_vdev->config_lock, flags);
+
+	wake_up(&params_vdev->dev->sync_onoff);
+
+	list_for_each_entry(buf, &tmp_list, queue)
+		vb2_buffer_done(&buf->vb.vb2_buf, VB2_BUF_STATE_ERROR);
+}
+
+static const struct vb2_ops rkispp_params_vb2_ops = {
+	.queue_setup = rkispp_params_vb2_queue_setup,
+	.buf_init = rkispp_params_vb2_buf_init,
+	.buf_cleanup = rkispp_params_vb2_buf_cleanup,
+	.buf_queue = rkispp_params_vb2_buf_queue,
+	.buf_prepare = rkispp_params_vb2_buf_prepare,
+	.start_streaming = rkispp_params_vb2_start_streaming,
+	.stop_streaming = rkispp_params_vb2_stop_streaming,
+};
+
+static const struct v4l2_file_operations rkispp_params_fops = {
+	.mmap = vb2_fop_mmap,
+	.unlocked_ioctl = video_ioctl2,
+	.poll = vb2_fop_poll,
+	.open = v4l2_fh_open,
+	.release = vb2_fop_release
+};
+
+static int rkispp_params_link_validate(struct media_link *link)
+{
+	return 0;
+}
+
+static const struct media_entity_operations rkispp_params_media_ops = {
+	.link_validate = rkispp_params_link_validate,
+};
+
+static int rkispp_params_init_vb2_queue(struct vb2_queue *q,
+					struct rkispp_params_vdev *params_vdev)
+{
+	q->type = V4L2_BUF_TYPE_META_OUTPUT;
+	q->io_modes = VB2_MMAP | VB2_DMABUF;
+	q->drv_priv = params_vdev;
+	q->ops = &rkispp_params_vb2_ops;
+	q->mem_ops = &vb2_vmalloc_memops;
+	q->buf_struct_size = sizeof(struct rkispp_params_buffer);
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	q->lock = &params_vdev->dev->iqlock;
+	q->dev = params_vdev->dev->dev;
+
+	return vb2_queue_init(q);
+}
+
+int rkispp_register_params_vdev(struct rkispp_device *dev)
+{
+	struct rkispp_params_vdev *params_vdev = &dev->params_vdev;
+	struct rkispp_vdev_node *node = &params_vdev->vnode;
+	struct video_device *vdev = &node->vdev;
+	int ret;
+
+	params_vdev->dev = dev;
+	params_vdev->first_params = true;
+	INIT_LIST_HEAD(&params_vdev->params);
+	spin_lock_init(&params_vdev->config_lock);
+
+	strscpy(vdev->name, "rkispp_params", sizeof(vdev->name));
+
+	video_set_drvdata(vdev, params_vdev);
+	vdev->ioctl_ops = &rkispp_params_ioctl;
+	vdev->fops = &rkispp_params_fops;
+	vdev->release = video_device_release_empty;
+	vdev->lock = &dev->iqlock;
+	vdev->v4l2_dev = &dev->v4l2_dev;
+	vdev->queue = &node->buf_queue;
+	vdev->device_caps = V4L2_CAP_STREAMING | V4L2_CAP_META_OUTPUT;
+	vdev->entity.ops = &rkispp_params_media_ops;
+	vdev->vfl_dir = VFL_DIR_TX;
+	ret = rkispp_params_init_vb2_queue(vdev->queue, params_vdev);
+	if (ret)
+		return ret;
+
+	node->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&vdev->entity, 1, &node->pad);
+	if (ret < 0) {
+		vb2_queue_release(vdev->queue);
+		return ret;
+	}
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret < 0) {
+		dev_err(dev->dev,
+			"could not register Video for Linux device\n");
+		media_entity_cleanup(&vdev->entity);
+		vb2_queue_release(vdev->queue);
+	}
+	return ret;
+}
+
+void rkispp_unregister_params_vdev(struct rkispp_device *dev)
+{
+	struct rkispp_params_vdev *params_vdev = &dev->params_vdev;
+	struct rkispp_vdev_node *node = &params_vdev->vnode;
+	struct video_device *vdev = &node->vdev;
+
+	video_unregister_device(vdev);
+	media_entity_cleanup(&vdev->entity);
+	vb2_queue_release(vdev->queue);
+}
