+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Rockchip ISPP statistics (ORB feature points, FEC mesh)
+ *
+ * Copyright (c) 2019 Fuzhou Rockchip Electronics Co., Ltd.
+ */
+
+#ifndef _RKISPP_STATS_H
+#define _RKISPP_STATS_H
+
+#include <linux/interrupt.h>
+#include <linux/types.h>
+#include "common.h"
+
+/* number of HW scratch banks ping-ponged per measurement */
+#define RKISPP_ORB_BUF_NUM 2
+#define RKISPP_FEC_MESH_BUF_NUM 2
+
+/* ORB point as the core writes it, repacked before it is handed out */
+struct rkispp_orb_hw_point {
+	u8 brief[15];
+	u32 y : 13;
+	u32 x : 13;
+	u32 dmy1 : 6;
+	u8 dmy2[13];
+} __packed;
+
+/*
+ * Layout of one FEC mesh scratch bank, as written by the FEC core:
+ * the fractional x/y arrays (1 byte per point) first, then the
+ * integer x/y arrays (2 bytes per point).
+ */
+static inline u32 rkispp_mesh_xfra_oft(u32 points)
+{
+	return 0;
+}
+
+static inline u32 rkispp_mesh_yfra_oft(u32 points)
+{
+	return ALIGN(points, 16);
+}
+
+static inline u32 rkispp_mesh_xint_oft(u32 points)
+{
+	return 2 * ALIGN(points, 16);
+}
+
+static inline u32 rkispp_mesh_yint_oft(u32 points)
+{
+	return rkispp_mesh_xint_oft(points) + ALIGN(2 * points, 16);
+}
+
+static inline u32 rkispp_mesh_bank_size(u32 points)
+{
+	return rkispp_mesh_xint_oft(points) + 2 * ALIGN(2 * points, 16);
+}
+
+struct rkispp_stats_vdev {
+	struct rkispp_vdev_node vnode;
+	struct rkispp_device *dev;
+
+	/* protects stat, curr_buf, streamon and done_frame */
+	spinlock_t irq_lock;
+	struct list_head stat;
+	struct rkispp_buffer *curr_buf;
+	struct rkispp_buffer *next_buf;
+	struct v4l2_format vdev_fmt;
+
+	/* HW scratch: the ORB core writes the frame points here */
+	struct rkispp_dummy_buffer orb_buf[RKISPP_ORB_BUF_NUM];
+	u32 orb_buf_idx;
+	/* HW scratch: the FEC core writes the frame mesh here */
+	struct rkispp_dummy_buffer mesh_buf[RKISPP_FEC_MESH_BUF_NUM];
+	u32 mesh_buf_idx;
+	u32 mesh_size;
+	/* last frame whose measurement was delivered */
+	u32 done_frame;
+
+	bool streamon;
+};
+
+void rkispp_stats_isr(struct rkispp_device *dev, u32 mis);
+int rkispp_stats_init_scratch(struct rkispp_device *dev);
+void rkispp_stats_uninit_scratch(struct rkispp_device *dev);
+int rkispp_register_stats_vdev(struct rkispp_device *dev);
+void rkispp_unregister_stats_vdev(struct rkispp_device *dev);
+
+#endif
