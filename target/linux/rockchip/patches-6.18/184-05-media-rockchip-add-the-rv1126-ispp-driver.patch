+
+static void rkispp_params_tnr(struct rkispp_device *dev,
+			      union rkispp_params_block block)
+{
+	struct rkispp_params_vdev *params_vdev = &dev->params_vdev;
+	const struct rkispp_params_tnr *arg = block.tnr;
+	bool three_to_one;
+	u32 i, val;
+
+	/* the TNR engine reads the ISP input pool, so it needs the ISP input */
+	if (dev->inp != INP_ISP)
+		return;
+
+	memcpy(&params_vdev->cur_params.tnr, arg, sizeof(*arg));
+	three_to_one = arg->mode == RKISPP_TNR_MODE_3_TO_1;
+	dev->stream_vdev.tnr.is_3to1 = three_to_one;
+
+	val = arg->opty_en << 2 | arg->optc_en << 3 | arg->gain_en << 4;
+	rkispp_set_bits(dev, RKISPP_TNR_CORE_CTRL,
+			SW_TNR_OPTY_EN | SW_TNR_OPTC_EN | SW_TNR_GLB_GAIN_EN,
+			val);
+
+	val = ISPP_PACK_4BYTE(arg->pk0_y, arg->pk1_y, arg->pk0_c, arg->pk1_c);
+	rkispp_write(dev, RKISPP_TNR_CORE_PK0, val);
+
+	val = ISPP_PACK_2SHORT(arg->glb_gain_cur, arg->glb_gain_nxt);
+	rkispp_write(dev, RKISPP_TNR_CORE_GLB_GAIN, val);
+	val = ISPP_PACK_2SHORT(arg->glb_gain_cur_div, arg->glb_gain_cur_sqrt);
+	rkispp_write(dev, RKISPP_TNR_CORE_GLB_GAIN_DIV, val);
+
+	for (i = 0; i < RKISPP_TNR_SIGMA_CURVE_SIZE - 1; i += 2)
+		rkispp_write(dev, RKISPP_TNR_CORE_SIG_Y01 + i * 2,
+			     ISPP_PACK_2SHORT(arg->sigma_y[i],
+					      arg->sigma_y[i + 1]));
+	rkispp_write(dev, RKISPP_TNR_CORE_SIG_Y10, arg->sigma_y[16]);
+	rkispp_write(dev, RKISPP_TNR_CORE_SIG_X18,
+		     ISPP_PACK_4BIT(arg->sigma_x[0], arg->sigma_x[1],
+				    arg->sigma_x[2], arg->sigma_x[3],
+				    arg->sigma_x[4], arg->sigma_x[5],
+				    arg->sigma_x[6], arg->sigma_x[7]));
+	rkispp_write(dev, RKISPP_TNR_CORE_SIG_X910,
+		     ISPP_PACK_4BIT(arg->sigma_x[8], arg->sigma_x[9],
+				    arg->sigma_x[10], arg->sigma_x[11],
+				    arg->sigma_x[12], arg->sigma_x[13],
+				    arg->sigma_x[14], arg->sigma_x[15]));
+
+	for (i = 0; i < RKISPP_TNR_LUMA_CURVE_SIZE; i += 2) {
+		val = ISPP_PACK_2SHORT(arg->luma_curve[i],
+				       arg->luma_curve[i + 1]);
+		rkispp_write(dev, RKISPP_TNR_CORE_LUMACURVE_Y01 + i * 2, val);
+	}
+
+	val = ISPP_PACK_2SHORT(arg->txt_th0_y, arg->txt_th1_y);
+	rkispp_write(dev, RKISPP_TNR_CORE_TH_Y, val);
+	val = ISPP_PACK_2SHORT(arg->txt_th0_c, arg->txt_th1_c);
+	rkispp_write(dev, RKISPP_TNR_CORE_TH_C, val);
+	val = ISPP_PACK_2SHORT(arg->txt_thy_dlt, arg->txt_thc_dlt);
+	rkispp_write(dev, RKISPP_TNR_CORE_TH_DLT, val);
+
+	val = ISPP_PACK_4BYTE(arg->gfcoef_y0[0], arg->gfcoef_y0[1],
+			      arg->gfcoef_y0[2], arg->gfcoef_y0[3]);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_Y0_0, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_y0[4], arg->gfcoef_y0[5], 0, 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_Y0_1, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_y1[0], arg->gfcoef_y1[1],
+			      arg->gfcoef_y1[2], 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_Y1, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_y2[0], arg->gfcoef_y2[1],
+			      arg->gfcoef_y2[2], 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_Y2, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_y3[0], arg->gfcoef_y3[1],
+			      arg->gfcoef_y3[2], 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_Y3, val);
+
+	val = ISPP_PACK_4BYTE(arg->gfcoef_yg0[0], arg->gfcoef_yg0[1],
+			      arg->gfcoef_yg0[2], arg->gfcoef_yg0[3]);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_YG0_0, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_yg0[4], arg->gfcoef_yg0[5], 0, 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_YG0_1, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_yg1[0], arg->gfcoef_yg1[1],
+			      arg->gfcoef_yg1[2], 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_YG1, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_yg2[0], arg->gfcoef_yg2[1],
+			      arg->gfcoef_yg2[2], 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_YG2, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_yg3[0], arg->gfcoef_yg3[1],
+			      arg->gfcoef_yg3[2], 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_YG3, val);
+
+	val = ISPP_PACK_4BYTE(arg->gfcoef_yl0[0], arg->gfcoef_yl0[1],
+			      arg->gfcoef_yl0[2], arg->gfcoef_yl0[3]);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_YL0_0, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_yl0[4], arg->gfcoef_yl0[5], 0, 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_YL0_1, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_yl1[0], arg->gfcoef_yl1[1],
+			      arg->gfcoef_yl1[2], 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_YL1, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_yl2[0], arg->gfcoef_yl2[1],
+			      arg->gfcoef_yl2[2], 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_YL2, val);
+
+	val = ISPP_PACK_4BYTE(arg->gfcoef_cg0[0], arg->gfcoef_cg0[1],
+			      arg->gfcoef_cg0[2], arg->gfcoef_cg0[3]);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_CG0_0, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_cg0[4], arg->gfcoef_cg0[5], 0, 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_CG0_1, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_cg1[0], arg->gfcoef_cg1[1],
+			      arg->gfcoef_cg1[2], 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_CG1, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_cg2[0], arg->gfcoef_cg2[1],
+			      arg->gfcoef_cg2[2], 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_CG2, val);
+
+	val = ISPP_PACK_4BYTE(arg->gfcoef_cl0[0], arg->gfcoef_cl0[1],
+			      arg->gfcoef_cl0[2], arg->gfcoef_cl0[3]);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_CL0_0, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_cl0[4], arg->gfcoef_cl0[5], 0, 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_CL0_1, val);
+	val = ISPP_PACK_4BYTE(arg->gfcoef_cl1[0], arg->gfcoef_cl1[1],
+			      arg->gfcoef_cl1[2], 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_GFCOEF_CL1, val);
+
+	val = ISPP_PACK_2SHORT(arg->scale_yg[0], arg->scale_yg[1]);
+	rkispp_write(dev, RKISPP_TNR_CORE_SCALE_YG01, val);
+	val = ISPP_PACK_2SHORT(arg->scale_yg[2], arg->scale_yg[3]);
+	rkispp_write(dev, RKISPP_TNR_CORE_SCALE_YG23, val);
+	val = ISPP_PACK_2SHORT(arg->scale_yl[0], arg->scale_yl[1]);
+	rkispp_write(dev, RKISPP_TNR_CORE_SCALE_YL01, val);
+	rkispp_write(dev, RKISPP_TNR_CORE_SCALE_YL2, arg->scale_yl[2]);
+	val = ISPP_PACK_2SHORT(arg->scale_cg[0], arg->scale_y2cg[0]);
+	rkispp_write(dev, RKISPP_TNR_CORE_SCALE_CG0, val);
+	val = ISPP_PACK_2SHORT(arg->scale_cg[1], arg->scale_y2cg[1]);
+	rkispp_write(dev, RKISPP_TNR_CORE_SCALE_CG1, val);
+	val = ISPP_PACK_2SHORT(arg->scale_cg[2], arg->scale_y2cg[2]);
+	rkispp_write(dev, RKISPP_TNR_CORE_SCALE_CG2, val);
+	val = ISPP_PACK_2SHORT(arg->scale_cl[0], arg->scale_y2cl[0]);
+	rkispp_write(dev, RKISPP_TNR_CORE_SCALE_CL0, val);
+	val = ISPP_PACK_2SHORT(arg->scale_cl[1], arg->scale_y2cl[1]);
+	rkispp_write(dev, RKISPP_TNR_CORE_SCALE_CL1, val);
+	val = arg->scale_y2cl[2] << 16;
+	rkispp_write(dev, RKISPP_TNR_CORE_SCALE_CL2, val);
+	val = ISPP_PACK_4BYTE(arg->weight_y[0], arg->weight_y[1],
+			      arg->weight_y[2], 0);
+	rkispp_write(dev, RKISPP_TNR_CORE_WEIGHT, val);
+
+	rkispp_set_bits(dev, RKISPP_TNR_CORE_CTRL, SW_TNR_MODE,
+			three_to_one ? SW_TNR_MODE : 0);
+}
+
+static bool is_tnr_enable(struct rkispp_device *dev)
+{
+	u32 cur_en;
+
+	cur_en = rkispp_read(dev, RKISPP_TNR_CORE_CTRL);
+	cur_en &= SW_TNR_EN;
+
+	return (!!cur_en);
+}
+
+static void rkispp_params_tnr_enable(struct rkispp_device *dev, bool en,
+				     union rkispp_params_block block)
+{
+	if (dev->inp != INP_ISP)
+		return;
+
+	if (en && !is_tnr_enable(dev))
+		rkispp_set_bits(dev, RKISPP_TNR_CTRL, 0, SW_TNR_1ST_FRM);
+	rkispp_set_bits(dev, RKISPP_TNR_CORE_CTRL, SW_TNR_EN, en);
+}
+
+static void rkispp_params_nr(struct rkispp_device *dev,
+			     union rkispp_params_block block)
+{
+	struct rkispp_params_vdev *params_vdev = &dev->params_vdev;
+	const struct rkispp_params_nr *arg = block.nr;
+	u32 i, val;
+	u8 big_en, nobig_en, sd32_self_en = 0;
+
+	memcpy(&params_vdev->cur_params.nr, arg, sizeof(*arg));
+
+	rkispp_write(dev, RKISPP_NR_UVNR_GAIN_1SIGMA, arg->uvnr_gain_1sigma);
+	rkispp_write(dev, RKISPP_NR_UVNR_GAIN_OFFSET, arg->uvnr_gain_offset);
+	val = ISPP_PACK_4BYTE(arg->uvnr_gain_uvgain[0],
+			      arg->uvnr_gain_uvgain[1], arg->uvnr_gain_t2gen,
+			      arg->uvnr_gain_iso);
+	rkispp_write(dev, RKISPP_NR_UVNR_GAIN_GBLGAIN, val);
+	rkispp_write(dev, RKISPP_NR_UVNR_T1GEN_M3ALPHA,
+		     arg->uvnr_t1gen_m3alpha);
+	rkispp_write(dev, RKISPP_NR_UVNR_T1FLT_MODE, arg->uvnr_t1flt_mode);
+	rkispp_write(dev, RKISPP_NR_UVNR_T1FLT_MSIGMA, arg->uvnr_t1flt_msigma);
+	rkispp_write(dev, RKISPP_NR_UVNR_T1FLT_WTP, arg->uvnr_t1flt_wtp);
+	for (i = 0; i < RKISPP_NR_UVNR_T1FLT_WTQ_SIZE; i += 4) {
+		val = ISPP_PACK_4BYTE(arg->uvnr_t1flt_wtq[i],
+				      arg->uvnr_t1flt_wtq[i + 1],
+				      arg->uvnr_t1flt_wtq[i + 2],
+				      arg->uvnr_t1flt_wtq[i + 3]);
