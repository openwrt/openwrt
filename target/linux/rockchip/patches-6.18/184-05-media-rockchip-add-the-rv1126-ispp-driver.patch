+static void set_y_addr(struct rkispp_stream *stream, u32 val)
+{
+	rkispp_write(stream->isppdev, stream->config->reg.cur_y_base, val);
+}
+
+static void set_uv_addr(struct rkispp_stream *stream, u32 val)
+{
+	rkispp_write(stream->isppdev, stream->config->reg.cur_uv_base, val);
+}
+
+static u32 fmt_stride(u32 wr_fmt, u32 width)
+{
+	return ALIGN(width * ((wr_fmt & FMT_YUYV) ? 2 : 1), 16);
+}
+
+static void set_vir_stride(struct rkispp_stream *stream)
+{
+	u32 stride =
+		fmt_stride(stream->out_cap_fmt.wr_fmt, stream->out_fmt.width);
+
+	rkispp_write(stream->isppdev, stream->config->reg.cur_vir_stride,
+		     stride >> 2);
+}
+
+static void set_scl_factor(struct rkispp_stream *stream, u32 val)
+{
+	rkispp_write(stream->isppdev, stream->config->reg.factor, val);
+}
+
+static u32 wr_limit(struct rkispp_stream *stream, u32 bit)
+{
+	if (stream->out_fmt.quantization == V4L2_QUANTIZATION_LIM_RANGE)
+		return bit;
+	return 0;
+}
+
+/* scl0 writes up to 3264 pixels wide, 2080 when it scales nv12 vertically */
+static u32 scl_max_width(struct rkispp_stream *stream, u32 fourcc,
+			 bool full_height)
+{
+	if (stream->id != STREAM_S0)
+		return 1280;
+	if (full_height || fourcc != V4L2_PIX_FMT_NV12)
+		return 3264;
+	return 2080;
+}
+
+static int fcc_xysubs(u32 fcc, u32 *xsubs, u32 *ysubs)
+{
+	switch (fcc) {
+	case V4L2_PIX_FMT_GREY:
+		*xsubs = 1;
+		*ysubs = 1;
+		break;
+	case V4L2_PIX_FMT_NV16:
+	case V4L2_PIX_FMT_NV61:
+		*xsubs = 2;
+		*ysubs = 1;
+		break;
+	case V4L2_PIX_FMT_NV12:
+	case V4L2_PIX_FMT_NV12M:
+	case V4L2_PIX_FMT_NV21:
+		*xsubs = 2;
+		*ysubs = 2;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static const struct capture_fmt *find_fmt(struct rkispp_stream *stream,
+					  const u32 pixelfmt)
+{
+	const struct capture_fmt *fmt;
+	unsigned int i;
+
+	for (i = 0; i < stream->config->fmt_size; i++) {
+		fmt = &stream->config->fmts[i];
+		if (fmt->fourcc == pixelfmt)
+			return fmt;
+	}
+	return NULL;
+}
+
+static struct rkispp_dummy_buffer *dummy_list_pop(struct list_head *list)
+{
+	struct rkispp_dummy_buffer *buf;
+
+	buf = list_first_entry_or_null(list, struct rkispp_dummy_buffer, list);
+	if (buf)
+		list_del(&buf->list);
+	return buf;
+}
+
+static struct list_head *stage_next_rd(struct list_head *list,
+				       struct list_head *buf_rd, bool is_end)
+{
+	struct list_head *rd = NULL;
+
+	if (is_end && !list_empty(list)) {
+		rd = list->next;
+		list_del(rd);
+	} else if (is_end && buf_rd) {
+		return buf_rd;
+	}
+	if (buf_rd)
+		list_add_tail(buf_rd, list);
+	return rd;
+}
+
+static void check_to_force_update(struct rkispp_device *dev, u32 mis_val)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkispp_stream *stream;
+	u32 i, mask = NR_INT | SHP_INT;
+	bool is_fec_en = (vdev->module_ens & ISPP_MODULE_FEC);
+
+	if (mis_val & FEC_INT)
+		rkispp_module_work_event(dev, NULL, NULL, ISPP_MODULE_FEC,
+					 true);
+
+	/* wait nr_shp/fec/scl idle */
+	for (i = STREAM_S0; i <= STREAM_S2; i++) {
+		stream = &vdev->stream[i];
+		/* a bypassed scl raises no frame end */
+		if (stream->is_upd && !stream->stopping && !is_fec_en &&
+		    !stream->scl_bypass)
+			mask |= stream->config->frame_end_id;
+	}
+
+	vdev->irq_ends |= (mis_val & mask);
+	v4l2_dbg(3, rkispp_debug, &dev->v4l2_dev, "irq_ends:0x%x mask:0x%x\n",
+		 vdev->irq_ends, mask);
+	if (vdev->irq_ends != mask)
+		return;
+	vdev->irq_ends = 0;
+	rkispp_module_work_event(dev, NULL, NULL, ISPP_MODULE_NR, true);
+
+	for (i = STREAM_MB; i <= STREAM_S2; i++) {
+		stream = &vdev->stream[i];
+		if (stream->streaming)
+			stream->is_upd = true;
+	}
+}
+
+static void irq_work(struct work_struct *work)
+{
+	struct rkispp_device *dev =
+		container_of(work, struct rkispp_device, irq_work);
+
+	clk_set_rate(dev->hw_dev.clks[0], dev->hw_dev.core_clk_max);
+	check_to_force_update(dev, dev->mis_val);
+	dev->hw_dev.is_first = false;
+}
+
+static void update_mi(struct rkispp_stream *stream)
+{
+	struct rkispp_device *dev = stream->isppdev;
+	struct rkispp_dummy_buffer *dummy_buf;
+	u32 val;
+
+	if (stream->curr_buf) {
+		val = stream->curr_buf->buff_addr[RKISPP_PLANE_Y];
+		set_y_addr(stream, val);
+		val = stream->curr_buf->buff_addr[RKISPP_PLANE_UV];
+		set_uv_addr(stream, val);
+	}
+
+	if (stream->type == STREAM_OUTPUT && !stream->curr_buf) {
+		dummy_buf = &dev->hw_dev.dummy_buf;
+		set_y_addr(stream, dummy_buf->dma_addr);
+		set_uv_addr(stream, dummy_buf->dma_addr);
+	}
+
+	v4l2_dbg(2, rkispp_debug, &dev->v4l2_dev,
+		 "%s stream:%d Y:0x%x UV:0x%x\n", __func__, stream->id,
+		 rkispp_read(dev, stream->config->reg.cur_y_base),
+		 rkispp_read(dev, stream->config->reg.cur_uv_base));
+}
+
+static void rkispp_frame_end(struct rkispp_stream *stream)
+{
+	struct rkispp_device *dev = stream->isppdev;
+	struct capture_fmt *fmt = &stream->out_cap_fmt;
+	unsigned long lock_flags = 0;
+	struct rkispp_buffer *buf;
+	int i;
+
+	if (stream->curr_buf) {
+		u64 ns = dev->ispp_sdev.frame_timestamp;
+
+		if (!ns)
+			ns = ktime_get_ns();
+
+		for (i = 0; i < fmt->mplanes; i++) {
+			u32 payload_size =
+				stream->out_fmt.plane_fmt[i].sizeimage;
+
+			vb2_set_plane_payload(&stream->curr_buf->vb.vb2_buf, i,
+					      payload_size);
+		}
+		stream->curr_buf->vb.sequence = dev->ispp_sdev.frm_sync_seq;
+		stream->curr_buf->vb.vb2_buf.timestamp = ns;
+
+		vb2_buffer_done(&stream->curr_buf->vb.vb2_buf,
+				VB2_BUF_STATE_DONE);
+
+		ns = ktime_get_ns();
+		stream->dbg.interval = ns - stream->dbg.timestamp;
+		stream->dbg.timestamp = ns;
+		stream->dbg.delay = ns - stream->curr_buf->vb.vb2_buf.timestamp;
+		stream->dbg.id = stream->curr_buf->vb.sequence;
+
+		stream->curr_buf = NULL;
+	}
+
+	spin_lock_irqsave(&stream->vbq_lock, lock_flags);
+	if (!list_empty(&stream->buf_queue) && !stream->curr_buf) {
+		buf = list_first_entry(&stream->buf_queue, struct rkispp_buffer,
+				       queue);
+		list_del(&buf->queue);
+		stream->curr_buf = buf;
+	}
+	spin_unlock_irqrestore(&stream->vbq_lock, lock_flags);
+
+	update_mi(stream);
+}
+
+struct rkispp_geometry {
+	u32 width;
+	u32 height;
+	u32 fmt;
+	u32 stride;
+	u32 uv_offset;
+};
+
+static void rkispp_geometry_get(struct rkispp_device *dev,
+				struct rkispp_geometry *g)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+
+	if (dev->inp == INP_DDR)
+		g->fmt = vdev->stream[STREAM_II].out_cap_fmt.wr_fmt;
+	else
+		g->fmt = dev->isp_mode & FMT_YUV422;
+	g->width = dev->ispp_sdev.out_fmt.width;
+	g->height = dev->ispp_sdev.out_fmt.height;
+	g->stride = fmt_stride(g->fmt, g->width);
+	g->uv_offset = ALIGN(g->width, 16) * g->height;
+}
+
+static int init_pool(struct rkispp_device *dev, u32 *w, u32 *h)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	u32 fmt, pic_size, gain_size;
+	int i, ret;
+
+	fmt = dev->isp_mode & FMT_YUV422;
+	*w = dev->ispp_sdev.out_fmt.width;
+	*h = dev->ispp_sdev.out_fmt.height;
+	/* the isp mainpath writes the lines at the 16 byte aligned stride */
+	pic_size = (fmt & FMT_YUV422) ? ALIGN(*w, 16) * *h * 2 :
+					ALIGN(*w, 16) * *h * 3 / 2;
+	/* the TNR fetch over-reads the frame tail; keep it inside the mapping */
+	pic_size += (fmt & FMT_YUV422) ? *w * 4 : *w * 2;
+	gain_size = PAGE_ALIGN(ALIGN(*w, 64) * ALIGN(*h, 128) >> 4);
+
+	for (i = 0; i < RKISPP_BUF_POOL_MAX; i++) {
+		ret = rkispp_dummy_buffer_alloc(dev, &vdev->pool[i].pic,
+						PAGE_ALIGN(pic_size),
+						DMA_ATTR_NO_KERNEL_MAPPING);
+		if (ret < 0)
+			goto err;
+		ret = rkispp_dummy_buffer_alloc(dev, &vdev->pool[i].gain,
+						gain_size,
+						DMA_ATTR_NO_KERNEL_MAPPING);
+		if (ret < 0)
+			goto err;
+	}
+	v4l2_dbg(1, rkispp_debug, &dev->v4l2_dev,
+		 "isp input pool:%dx%d pic:0x%x/0x%x gain:0x%x/0x%x\n", *w, *h,
+		 (u32)vdev->pool[0].pic.dma_addr,
+		 (u32)vdev->pool[1].pic.dma_addr,
+		 (u32)vdev->pool[0].gain.dma_addr,
+		 (u32)vdev->pool[1].gain.dma_addr);
+	return 0;
+err:
+	for (--i; i >= 0; i--) {
+		rkispp_dummy_buffer_free(dev, &vdev->pool[i].pic);
+		rkispp_dummy_buffer_free(dev, &vdev->pool[i].gain);
+	}
+	return ret;
+}
+
+static void free_pool(struct rkispp_device *dev)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	int i;
+
+	for (i = 0; i < RKISPP_BUF_POOL_MAX; i++) {
+		rkispp_dummy_buffer_free(dev, &vdev->pool[i].pic);
+		rkispp_dummy_buffer_free(dev, &vdev->pool[i].gain);
+	}
+	vdev->is_idle = true;
+}
+
+static void tnr_free_buf(struct rkispp_device *dev)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	int i;
+
+	for (i = 0;
+	     i < sizeof(vdev->tnr.buf) / sizeof(struct rkispp_dummy_buffer);
+	     i++)
+		rkispp_dummy_buffer_free(dev,
+					 &vdev->tnr.buf.wr[GROUP_BUF_PIC] + i);
+
+	vdev->tnr.is_but_init = false;
+}
+
+static int tnr_init_buf(struct rkispp_device *dev, u32 pic_size, u32 gain_size)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkispp_dummy_buffer *buf;
+	int ret;
+
+	buf = &vdev->tnr.buf.wr[GROUP_BUF_PIC];
+	ret = rkispp_dummy_buffer_alloc(dev, buf, PAGE_ALIGN(pic_size),
+					DMA_ATTR_NO_KERNEL_MAPPING);
+	if (ret)
+		goto err;
+	buf = &vdev->tnr.buf.wr[GROUP_BUF_GAIN];
+	ret = rkispp_dummy_buffer_alloc(dev, buf, PAGE_ALIGN(gain_size),
+					DMA_ATTR_NO_KERNEL_MAPPING);
+	if (ret)
+		goto err;
+
+	buf = &vdev->tnr.buf.iir;
+	ret = rkispp_dummy_buffer_alloc(dev, buf, PAGE_ALIGN(pic_size),
+					DMA_ATTR_NO_KERNEL_MAPPING);
+	if (ret)
+		goto err;
+
+	buf = &vdev->tnr.buf.gain_kg;
+	ret = rkispp_dummy_buffer_alloc(dev, buf, PAGE_ALIGN(gain_size * 4),
+					DMA_ATTR_NO_KERNEL_MAPPING);
+	if (ret)
+		goto err;
+
+	vdev->tnr.is_but_init = true;
+	return 0;
+err:
+	tnr_free_buf(dev);
+	v4l2_err(&dev->v4l2_dev, "%s failed\n", __func__);
+	return ret;
+}
+
+static void tnr_regs_config(struct rkispp_device *dev)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkispp_geometry g;
+	u32 gain_stride, val;
+
+	rkispp_geometry_get(dev, &g);
+	vdev->tnr.uv_offset = g.uv_offset;
+	gain_stride = ALIGN(g.width, 64) >> 4;
+
+	if (dev->isp_mode & ISP_ISPP_QUICK) {
+		rkispp_set_bits(dev, RKISPP_CTRL_QUICK, GLB_QUICK_MODE_MASK,
+				GLB_QUICK_MODE(0));
+
+		val = vdev->pool[0].pic.dma_addr;
+		rkispp_write(dev, RKISPP_TNR_CUR_Y_BASE, val);
+		rkispp_write(dev, RKISPP_TNR_CUR_UV_BASE, val + g.uv_offset);
+
+		val = vdev->pool[0].gain.dma_addr;
+		rkispp_write(dev, RKISPP_TNR_GAIN_CUR_Y_BASE, val);
+
+		if (vdev->tnr.is_3to1) {
+			val = vdev->pool[1].pic.dma_addr;
+			rkispp_write(dev, RKISPP_TNR_NXT_Y_BASE, val);
+			rkispp_write(dev, RKISPP_TNR_NXT_UV_BASE,
+				     val + g.uv_offset);
+			val = vdev->pool[1].gain.dma_addr;
+			rkispp_write(dev, RKISPP_TNR_GAIN_NXT_Y_BASE, val);
+		}
+	}
+
+	val = vdev->tnr.buf.gain_kg.dma_addr;
+	rkispp_write(dev, RKISPP_TNR_GAIN_KG_Y_BASE, val);
+
+	val = vdev->tnr.buf.wr[GROUP_BUF_PIC].dma_addr;
+	rkispp_write(dev, RKISPP_TNR_WR_Y_BASE, val);
+	rkispp_write(dev, RKISPP_TNR_WR_UV_BASE, val + g.uv_offset);
+	if (vdev->tnr.buf.iir.size)
+		val = vdev->tnr.buf.iir.dma_addr;
+	rkispp_write(dev, RKISPP_TNR_IIR_Y_BASE, val);
+	rkispp_write(dev, RKISPP_TNR_IIR_UV_BASE, val + g.uv_offset);
+
+	val = vdev->tnr.buf.wr[GROUP_BUF_GAIN].dma_addr;
+	rkispp_write(dev, RKISPP_TNR_GAIN_WR_Y_BASE, val);
+
+	rkispp_write(dev, RKISPP_TNR_WR_VIR_STRIDE, g.stride >> 2);
+	rkispp_set_bits(dev, RKISPP_TNR_CTRL, FMT_WR_MASK,
+			g.fmt << 4 | SW_TNR_1ST_FRM);
+
+	rkispp_set_bits(dev, RKISPP_TNR_CTRL, FMT_RD_MASK, g.fmt);
+	rkispp_write(dev, RKISPP_TNR_CUR_VIR_STRIDE, g.stride >> 2);
+	rkispp_write(dev, RKISPP_TNR_IIR_VIR_STRIDE, g.stride >> 2);
+	rkispp_write(dev, RKISPP_TNR_NXT_VIR_STRIDE, g.stride >> 2);
+	rkispp_set_bits(dev, RKISPP_TNR_CORE_CTRL, SW_TNR_MODE,
+			vdev->tnr.is_3to1 ? SW_TNR_MODE : 0);
+	rkispp_write(dev, RKISPP_TNR_GAIN_CUR_VIR_STRIDE, gain_stride);
+	rkispp_write(dev, RKISPP_TNR_GAIN_NXT_VIR_STRIDE, gain_stride);
+	rkispp_write(dev, RKISPP_TNR_GAIN_KG_VIR_STRIDE,
+		     ALIGN(g.width, 16) * 6);
+	rkispp_write(dev, RKISPP_TNR_GAIN_WR_VIR_STRIDE, gain_stride);
+	rkispp_write(dev, RKISPP_CTRL_TNR_SIZE, g.height << 16 | g.width);
+}
+
+static int config_tnr(struct rkispp_device *dev)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkispp_geometry g;
+	u32 pic_size, gain_size;
+	int ret;
+
+	vdev->tnr.is_end = true;
+	vdev->tnr.is_3to1 = ((vdev->module_ens & ISPP_MODULE_TNR_3TO1) ==
+			     ISPP_MODULE_TNR_3TO1);
+	if (!(vdev->module_ens & ISPP_MODULE_TNR))
+		return 0;
+
+	/* the TNR engine needs the ISP input pool to work */
+	if (dev->inp == INP_DDR)
+		return 0;
+
+	rkispp_geometry_get(dev, &g);
+	pic_size = (g.fmt & FMT_YUV422) ? g.width * g.height * 2 :
+					  g.width * g.height * 3 / 2;
+	/* the same tail room as the input pool */
+	pic_size += (g.fmt & FMT_YUV422) ? g.width * 4 : g.width * 2;
+	gain_size = ALIGN(g.width, 64) * ALIGN(g.height, 128) >> 4;
+
+	if (vdev->module_ens & (ISPP_MODULE_NR | ISPP_MODULE_SHP)) {
+		ret = tnr_init_buf(dev, pic_size, gain_size);
+		if (ret)
+			return ret;
+	}
+
+	tnr_regs_config(dev);
+
+	if (vdev->monitor.is_en) {
+		init_completion(&vdev->monitor.tnr.cmpl);
+		schedule_work(&vdev->monitor.tnr.work);
+	}
+	v4l2_dbg(1, rkispp_debug, &dev->v4l2_dev,
+		 "%s size:%dx%d ctrl:0x%x core_ctrl:0x%x\n", __func__, g.width,
+		 g.height, rkispp_read(dev, RKISPP_TNR_CTRL),
+		 rkispp_read(dev, RKISPP_TNR_CORE_CTRL));
+	return 0;
+}
+
+static void nr_free_buf(struct rkispp_device *dev)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkispp_ii_input *input, *tmp;
+	struct list_head *list;
+	struct rkispp_buffer *inbuf;
+	int i;
+
+	list = &vdev->nr.list_rd;
+	if (vdev->nr.cur_rd) {
+		list_add_tail(&vdev->nr.cur_rd->list, list);
+		vdev->nr.cur_rd = NULL;
+	}
+	list_for_each_entry_safe(input, tmp, list, list) {
+		list_del(&input->list);
+		inbuf = input->buf;
+		if (inbuf)
+			vb2_buffer_done(&inbuf->vb.vb2_buf,
+					VB2_BUF_STATE_ERROR);
+	}
+
+	vdev->nr.cur_wr = NULL;
+	while (dummy_list_pop(&vdev->nr.list_wr))
+		;
+
+	for (i = 0;
+	     i < sizeof(vdev->nr.buf) / sizeof(struct rkispp_dummy_buffer); i++)
+		rkispp_dummy_buffer_free(dev, &vdev->nr.buf.tmp_yuv + i);
+}
+
+static int nr_init_buf(struct rkispp_device *dev, u32 size)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkispp_dummy_buffer *buf;
+	int i, ret, cnt = 0;
+
+	if (vdev->module_ens & ISPP_MODULE_FEC)
+		cnt = RKISPP_BUF_MAX;
+
+	for (i = 0; i < cnt; i++) {
+		buf = &vdev->nr.buf.wr[i];
+		ret = rkispp_dummy_buffer_alloc(dev, buf, size,
+						DMA_ATTR_NO_KERNEL_MAPPING);
+		if (ret)
+			goto err;
+		list_add_tail(&buf->list, &vdev->nr.list_wr);
+	}
+
+	buf = &vdev->nr.buf.tmp_yuv;
+	size = DIV_ROUND_UP(dev->ispp_sdev.out_fmt.width, 32) * 42 * 32;
+	ret = rkispp_dummy_buffer_alloc(dev, buf, PAGE_ALIGN(size),
+					DMA_ATTR_NO_KERNEL_MAPPING);
+	if (ret)
+		goto err;
+	return 0;
+err:
+	nr_free_buf(dev);
+	v4l2_err(&dev->v4l2_dev, "%s failed\n", __func__);
+	return ret;
+}
+
+static void nr_shp_regs_config(struct rkispp_device *dev)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkispp_stream *stream = NULL;
+	struct rkispp_geometry g;
+	u32 addr_offs, val;
+
+	if (!(vdev->module_ens & (ISPP_MODULE_NR | ISPP_MODULE_SHP)))
+		return;
+
+	rkispp_geometry_get(dev, &g);
+	vdev->nr.uv_offset = g.uv_offset;
+
+	if (vdev->module_ens & ISPP_MODULE_TNR) {
+		rkispp_write(dev, RKISPP_NR_ADDR_BASE_Y,
+			     rkispp_read(dev, RKISPP_TNR_WR_Y_BASE));
+		rkispp_write(dev, RKISPP_NR_ADDR_BASE_UV,
+			     rkispp_read(dev, RKISPP_TNR_WR_UV_BASE));
+		rkispp_write(dev, RKISPP_NR_ADDR_BASE_GAIN,
+			     rkispp_read(dev, RKISPP_TNR_GAIN_WR_Y_BASE));
+		rkispp_set_bits(dev, RKISPP_CTRL_QUICK, 0, GLB_NR_SD32_TNR);
+	} else {
+		/* tnr needs the same format as nr in the fbc mode */
+		rkispp_set_bits(dev, RKISPP_TNR_CTRL, FMT_RD_MASK, g.fmt);
+		rkispp_write(dev, RKISPP_CTRL_TNR_SIZE,
+			     g.height << 16 | g.width);
+		if (dev->inp == INP_ISP) {
+			if (dev->isp_mode & ISP_ISPP_QUICK)
+				rkispp_set_bits(dev, RKISPP_CTRL_QUICK,
+						GLB_QUICK_MODE_MASK,
+						GLB_QUICK_MODE(2));
+			else
+				rkispp_set_bits(dev, RKISPP_NR_UVNR_CTRL_PARA,
+						0, SW_UVNR_SD32_SELF_EN);
+
+			val = vdev->pool[0].pic.dma_addr;
+			rkispp_write(dev, RKISPP_NR_ADDR_BASE_Y, val);
+			rkispp_write(dev, RKISPP_NR_ADDR_BASE_UV,
+				     val + g.uv_offset);
+			val = vdev->pool[0].gain.dma_addr;
+			rkispp_write(dev, RKISPP_NR_ADDR_BASE_GAIN, val);
+			rkispp_clear_bits(dev, RKISPP_CTRL_QUICK,
+					  GLB_NR_SD32_TNR);
+		} else if (vdev->nr.cur_rd && vdev->nr.cur_rd->buf) {
+			/* a monitor restart keeps the II frame in progress */
+			val = vdev->nr.cur_rd->buf->buff_addr[RKISPP_PLANE_Y];
+			rkispp_write(dev, RKISPP_NR_ADDR_BASE_Y, val);
+			val = vdev->nr.cur_rd->buf->buff_addr[RKISPP_PLANE_UV];
+			rkispp_write(dev, RKISPP_NR_ADDR_BASE_UV, val);
+		}
+	}
+
+	rkispp_clear_bits(dev, RKISPP_CTRL_QUICK, GLB_FEC2SCL_EN);
+	if (vdev->module_ens & ISPP_MODULE_FEC) {
+		addr_offs = g.stride * g.height;
+		vdev->fec.uv_offset = addr_offs;
+		val = vdev->nr.buf.wr[0].dma_addr;
+		rkispp_write(dev, RKISPP_SHARP_WR_Y_BASE, val);
+		rkispp_write(dev, RKISPP_SHARP_WR_UV_BASE, val + addr_offs);
+		rkispp_write(dev, RKISPP_SHARP_WR_VIR_STRIDE, g.stride >> 2);
+		rkispp_set_bits(dev, RKISPP_SHARP_CTRL, SW_SHP_WR_FORMAT_MASK,
+				g.fmt);
+
+		rkispp_write(dev, RKISPP_FEC_RD_Y_BASE, val);
+		rkispp_write(dev, RKISPP_FEC_RD_UV_BASE, val + addr_offs);
+	} else {
+		stream = &vdev->stream[STREAM_MB];
+		if (!stream->streaming || stream->stopping) {
+			val = dev->hw_dev.dummy_buf.dma_addr;
+			rkispp_write(dev, RKISPP_SHARP_WR_Y_BASE, val);
+			rkispp_write(dev, RKISPP_SHARP_WR_UV_BASE, val);
+			rkispp_write(dev, RKISPP_SHARP_WR_VIR_STRIDE,
+				     g.stride >> 2);
+		}
+	}
+
+	val = vdev->nr.buf.tmp_yuv.dma_addr;
+	rkispp_write(dev, RKISPP_SHARP_TMP_YUV_BASE, val);
+
+	rkispp_set_bits(dev, RKISPP_NR_CTRL, NR_NEW_ALGO, NR_NEW_ALGO);
+	rkispp_set_bits(dev, RKISPP_NR_CTRL, FMT_RD_MASK, g.fmt);
+	rkispp_write(dev, RKISPP_NR_VIR_STRIDE, g.stride >> 2);
+	rkispp_write(dev, RKISPP_NR_VIR_STRIDE_GAIN, ALIGN(g.width, 64) >> 4);
+	rkispp_write(dev, RKISPP_CTRL_SIZE, g.height << 16 | g.width);
+}
+
+static int config_nr_shp(struct rkispp_device *dev)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkispp_stream *stream = &vdev->stream[STREAM_II];
+	struct rkispp_geometry g;
+	u32 pic_size;
+	int ret;
+
+	vdev->nr.is_end = true;
+	if (!(vdev->module_ens & (ISPP_MODULE_NR | ISPP_MODULE_SHP)))
+		return 0;
+
+	rkispp_geometry_get(dev, &g);
+
+	/* the sharp write engine steps by the aligned stride per plane */
+	pic_size = (g.fmt & FMT_YUV422) ? g.stride * g.height * 2 :
+					  g.stride * g.height * 3 / 2;
+
+	ret = nr_init_buf(dev, pic_size);
+	if (ret)
+		return ret;
+
+	/* the II buffer is the nr input, frame synced with the nr */
+	if (dev->inp == INP_DDR) {
+		stream->config->frame_end_id = NR_INT;
+		stream->config->reg.cur_y_base = RKISPP_NR_ADDR_BASE_Y;
+		stream->config->reg.cur_uv_base = RKISPP_NR_ADDR_BASE_UV;
+	}
+
+	nr_shp_regs_config(dev);
+
+	if (vdev->monitor.is_en) {
+		init_completion(&vdev->monitor.nr.cmpl);
+		schedule_work(&vdev->monitor.nr.work);
+	}
+	v4l2_dbg(1, rkispp_debug, &dev->v4l2_dev,
+		 "%s size:%dx%d\n"
+		 "nr ctrl:0x%x ctrl_para:0x%x\n"
+		 "shp ctrl:0x%x core_ctrl:0x%x\n",
+		 __func__, g.width, g.height, rkispp_read(dev, RKISPP_NR_CTRL),
+		 rkispp_read(dev, RKISPP_NR_UVNR_CTRL_PARA),
+		 rkispp_read(dev, RKISPP_SHARP_CTRL),
+		 rkispp_read(dev, RKISPP_SHARP_CORE_CTRL));
+	return 0;
+}
+
+static void fec_free_buf(struct rkispp_device *dev)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+
+	vdev->fec.cur_rd = NULL;
+	while (dummy_list_pop(&vdev->fec.list_rd))
+		;
+}
+
+static void fec_regs_config(struct rkispp_device *dev)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkispp_stream *stream = &vdev->stream[STREAM_II];
+	struct rkispp_geometry g;
+	u32 gate;
+
+	if (!(vdev->module_ens & ISPP_MODULE_FEC))
+		return;
+
+	rkispp_geometry_get(dev, &g);
+
+	if (vdev->module_ens & (ISPP_MODULE_NR | ISPP_MODULE_SHP)) {
+		rkispp_write(dev, RKISPP_FEC_RD_Y_BASE,
+			     rkispp_read(dev, RKISPP_SHARP_WR_Y_BASE));
+		rkispp_write(dev, RKISPP_FEC_RD_UV_BASE,
+			     rkispp_read(dev, RKISPP_SHARP_WR_UV_BASE));
+	} else if (dev->inp == INP_DDR) {
+		stream->config->frame_end_id = FEC_INT;
+		stream->config->reg.cur_y_base = RKISPP_FEC_RD_Y_BASE;
+		stream->config->reg.cur_uv_base = RKISPP_FEC_RD_UV_BASE;
+	}
+
+	rkispp_set_bits(dev, RKISPP_FEC_CTRL, FMT_RD_MASK, g.fmt);
+	rkispp_write(dev, RKISPP_FEC_RD_VIR_STRIDE, g.stride >> 2);
+	rkispp_write(dev, RKISPP_FEC_PIC_SIZE, g.height << 16 | g.width);
+	rkispp_set_bits(dev, RKISPP_CTRL_QUICK, 0, GLB_FEC2SCL_EN);
+
+	/* the soft reset gates the fec clock and disables its ddr write */
+	gate = rkispp_read(dev, RKISPP_CTRL_CLKGATE);
+	if (!(gate & GATE_DIS_FEC))
+		rkispp_write(dev, RKISPP_CTRL_CLKGATE, gate | GATE_DIS_FEC);
+	rkispp_set_bits(dev, RKISPP_FEC_CORE_CTRL, SW_FEC_EN, SW_FEC_EN);
+	rkispp_clear_bits(dev, RKISPP_FEC_CORE_CTRL, SW_FEC2DDR_DIS);
+}
+
+static int config_fec(struct rkispp_device *dev)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+
+	vdev->fec.is_end = true;
+	if (!(vdev->module_ens & ISPP_MODULE_FEC))
+		return 0;
+
+	fec_regs_config(dev);
+
+	if (vdev->monitor.is_en) {
+		init_completion(&vdev->monitor.fec.cmpl);
+		schedule_work(&vdev->monitor.fec.work);
+	}
+	v4l2_dbg(1, rkispp_debug, &dev->v4l2_dev,
+		 "%s size:%dx%d ctrl:0x%x core_ctrl:0x%x\n", __func__,
+		 dev->ispp_sdev.out_fmt.width, dev->ispp_sdev.out_fmt.height,
+		 rkispp_read(dev, RKISPP_FEC_CTRL),
+		 rkispp_read(dev, RKISPP_FEC_CORE_CTRL));
+	return 0;
+}
+
+static int config_modules(struct rkispp_device *dev)
+{
+	int ret;
+
+	v4l2_dbg(1, rkispp_debug, &dev->v4l2_dev, "stream module ens:0x%x\n",
+		 dev->stream_vdev.module_ens);
+	dev->stream_vdev.monitor.monitoring_module = 0;
+	dev->stream_vdev.monitor.restart_module = 0;
+	dev->stream_vdev.monitor.is_restart = false;
+	dev->stream_vdev.monitor.retry = 0;
+	init_completion(&dev->stream_vdev.monitor.cmpl);
+
+	ret = config_tnr(dev);
+	if (ret < 0)
+		return ret;
+
+	ret = config_nr_shp(dev);
+	if (ret < 0)
+		goto free_tnr;
+
+	ret = config_fec(dev);
+	if (ret < 0)
+		goto free_nr;
+
+	rkispp_params_isr(dev);
+	return 0;
+free_nr:
+	nr_free_buf(dev);
+free_tnr:
+	tnr_free_buf(dev);
+	return ret;
+}
+
+/* the pipeline takes one II frame at a time */
+static void rkispp_queue_dmabuf(struct rkispp_device *dev,
+				struct rkispp_ii_input *input)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkispp_ii_input *kick = NULL;
+	unsigned long lock_flags = 0;
+
+	spin_lock_irqsave(&vdev->ii_lock, lock_flags);
+	if (!input)
+		vdev->is_idle = true;
+	if (input && list_empty(&vdev->ii_queue) && vdev->is_idle) {
+		kick = input;
+	} else if (vdev->is_idle && !list_empty(&vdev->ii_queue)) {
+		kick = list_first_entry(&vdev->ii_queue, struct rkispp_ii_input,
+					list);
+		list_del(&kick->list);
+		if (input)
+			list_add_tail(&input->list, &vdev->ii_queue);
+	} else if (input) {
+		list_add_tail(&input->list, &vdev->ii_queue);
+	}
+
+	if (kick) {
+		vdev->is_idle = false;
+		rkispp_params_isr(dev);
+		rkispp_module_work_event(dev, kick, NULL, ISPP_MODULE_NR,
+					 false);
+	}
+	spin_unlock_irqrestore(&vdev->ii_lock, lock_flags);
+}
+
+static int start_ii(struct rkispp_stream *stream)
+{
+	struct rkispp_device *dev = stream->isppdev;
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	unsigned long lock_flags = 0;
+	struct rkispp_buffer *buf;
+	int i;
+
+	v4l2_subdev_call(&dev->ispp_sdev.sd, video, s_stream, true);
+	spin_lock_irqsave(&stream->vbq_lock, lock_flags);
+	while (!list_empty(&stream->buf_queue)) {
+		buf = list_first_entry(&stream->buf_queue, struct rkispp_buffer,
+				       queue);
+		list_del(&buf->queue);
+		i = buf->vb.vb2_buf.index;
+		vdev->input[i].buf = buf;
+		vdev->input[i].frame_timestamp = buf->vb.vb2_buf.timestamp;
+		vdev->input[i].frame_id = ++dev->ispp_sdev.frm_sync_seq;
+		rkispp_queue_dmabuf(dev, &vdev->input[i]);
+	}
+	stream->streaming = true;
+	spin_unlock_irqrestore(&stream->vbq_lock, lock_flags);
+	return 0;
+}
+
+static int config_ii(struct rkispp_stream *stream)
+{
+	stream->is_cfg = true;
+	return config_modules(stream->isppdev);
+}
+
+static int is_stopped_ii(struct rkispp_stream *stream)
+{
+	stream->streaming = false;
+	return true;
+}
+
+static void program_mb(struct rkispp_stream *stream)
+{
+	struct rkispp_device *dev = stream->isppdev;
+
+	switch (stream->last_module) {
+	case ISPP_MODULE_TNR:
+		rkispp_set_bits(dev, RKISPP_TNR_CTRL, FMT_WR_MASK,
+				SW_TNR_1ST_FRM | stream->out_cap_fmt.wr_fmt
+							 << 4);
+		break;
+	case ISPP_MODULE_NR:
+	case ISPP_MODULE_SHP:
+		rkispp_set_bits(dev, RKISPP_SHARP_CTRL,
+				SW_SHP_WR_YUV_LIMIT | SW_SHP_WR_FORMAT_MASK,
+				wr_limit(stream, SW_SHP_WR_YUV_LIMIT) |
+					stream->out_cap_fmt.wr_fmt);
+		rkispp_clear_bits(dev, RKISPP_SHARP_CORE_CTRL, SW_SHP_DMA_DIS);
+		break;
+	case ISPP_MODULE_FEC:
+		rkispp_set_bits(dev, RKISPP_FEC_CTRL,
+				SW_FEC_WR_YUV_LIMIT | FMT_WR_MASK,
+				wr_limit(stream, SW_FEC_WR_YUV_LIMIT) |
+					stream->out_cap_fmt.wr_fmt << 4);
+		rkispp_write(dev, RKISPP_FEC_PIC_SIZE,
+			     stream->out_fmt.height << 16 |
+				     stream->out_fmt.width);
+		rkispp_clear_bits(dev, RKISPP_FEC_CORE_CTRL, SW_FEC2DDR_DIS);
+		break;
+	default:
+		break;
+	}
+
+	set_vir_stride(stream);
+}
+
+static void secure_config_mb(struct rkispp_stream *stream)
+{
+	program_mb(stream);
+
+	rkispp_frame_end(stream);
+
+	stream->is_cfg = true;
+}
+
+static int config_mb(struct rkispp_stream *stream)
+{
+	struct rkispp_device *dev = stream->isppdev;
+	u32 i;
+
+	/* the fec frame end belongs to the mem2mem node, never to mb */
+	for (i = ISPP_MODULE_SHP; i > 0; i = i >> 1) {
+		if (dev->stream_vdev.module_ens & i)
+			break;
+	}
+	if (!i)
+		return -EINVAL;
+
+	stream->last_module = i;
+	switch (i) {
+	case ISPP_MODULE_TNR:
+		stream->config->frame_end_id = TNR_INT;
+		stream->config->reg.cur_y_base = RKISPP_TNR_WR_Y_BASE;
+		stream->config->reg.cur_uv_base = RKISPP_TNR_WR_UV_BASE;
+		stream->config->reg.cur_vir_stride = RKISPP_TNR_WR_VIR_STRIDE;
+		break;
+	case ISPP_MODULE_NR:
+	case ISPP_MODULE_SHP:
+		stream->config->frame_end_id = SHP_INT;
+		stream->config->reg.cur_y_base = RKISPP_SHARP_WR_Y_BASE;
+		stream->config->reg.cur_uv_base = RKISPP_SHARP_WR_UV_BASE;
+		stream->config->reg.cur_vir_stride = RKISPP_SHARP_WR_VIR_STRIDE;
+		break;
+	default:
+		stream->config->frame_end_id = FEC_INT;
+		stream->config->reg.cur_y_base = RKISPP_FEC_WR_Y_BASE;
+		stream->config->reg.cur_uv_base = RKISPP_FEC_WR_UV_BASE;
+		stream->config->reg.cur_vir_stride = RKISPP_FEC_WR_VIR_STRIDE;
+	}
+
+	if (dev->ispp_sdev.state == ISPP_STOP)
+		secure_config_mb(stream);
+	v4l2_dbg(1, rkispp_debug, &dev->v4l2_dev, "%s last module:%d\n",
+		 __func__, i);
+	return 0;
+}
+
+static int is_stopped_mb(struct rkispp_stream *stream)
+{
+	struct rkispp_device *dev = stream->isppdev;
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	bool is_stopped = true;
+	u32 val;
+
+	if (vdev->module_ens & ISPP_MODULE_FEC) {
+		rkispp_set_bits(dev, RKISPP_FEC_CORE_CTRL, 0, SW_FEC2DDR_DIS);
+	} else if (vdev->module_ens & (ISPP_MODULE_NR | ISPP_MODULE_SHP)) {
+		val = dev->hw_dev.dummy_buf.dma_addr;
+		rkispp_write(dev, RKISPP_SHARP_WR_Y_BASE, val);
+		rkispp_write(dev, RKISPP_SHARP_WR_UV_BASE, val);
+	}
+
+	if (atomic_read(&dev->stream_vdev.refcnt) == 1) {
+		val = readl(dev->hw_dev.base_addr + RKISPP_CTRL_SYS_STATUS);
+		is_stopped = (val & 0x8f) ? false : true;
+	}
+
+	return is_stopped;
+}
+
+static int limit_check_mb(struct rkispp_stream *stream,
+			  struct v4l2_pix_format_mplane *try_fmt)
+{
+	struct rkispp_device *dev = stream->isppdev;
+	struct rkispp_subdev *sdev = &dev->ispp_sdev;
+	u32 *w = try_fmt ? &try_fmt->width : &stream->out_fmt.width;
+	u32 *h = try_fmt ? &try_fmt->height : &stream->out_fmt.height;
+
+	/* the input is only known once the ISP is configured: no TRY check */
+	if (try_fmt)
+		return 0;
+
+	if (*w != sdev->out_fmt.width || *h != sdev->out_fmt.height) {
+		v4l2_err(&dev->v4l2_dev,
+			 "output:%dx%d should equal to input:%dx%d\n", *w, *h,
+			 sdev->out_fmt.width, sdev->out_fmt.height);
+		*w = 0;
+		*h = 0;
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static void program_scl(struct rkispp_stream *stream)
+{
+	struct rkispp_device *dev = stream->isppdev;
+	const struct capture_fmt *fmt = &stream->out_cap_fmt;
+	u32 in_width = dev->ispp_sdev.out_fmt.width;
+	u32 in_height = dev->ispp_sdev.out_fmt.height;
+	u32 hy_fac = (stream->out_fmt.width - 1) * 8192 / (in_width - 1) + 1;
+	u32 vy_fac = (stream->out_fmt.height - 1) * 8192 / (in_height - 1) + 1;
+	/* only shp params set SW_SCL_FIRST_MODE, an empty stream never does */
+	u32 val = SW_SCL_ENABLE | SW_SCL_FIRST_MODE;
+	u32 mask = SW_SCL_WR_YUV_LIMIT | SW_SCL_WR_YUYV_YCSWAP |
+		   SW_SCL_WR_YUYV_FORMAT | SW_SCL_WR_YUV_FORMAT |
+		   SW_SCL_WR_UV_DIS | SW_SCL_BYPASS | SW_SCL_FIRST_MODE;
+
+	if (hy_fac == 8193 && vy_fac == 8193)
+		val |= SW_SCL_BYPASS;
+	set_vir_stride(stream);
+	set_scl_factor(stream, vy_fac << 16 | hy_fac);
+	val |= fmt->wr_fmt << 3 |
+	       ((fmt->fourcc != V4L2_PIX_FMT_GREY) ? 0 : SW_SCL_WR_UV_DIS) |
+	       wr_limit(stream, SW_SCL_WR_YUV_LIMIT);
+
+	/* the scaler reads the fec output when the fec runs, else the shp's */
+	if (dev->stream_vdev.module_ens & ISPP_MODULE_FEC)
+		rkispp_set_bits(dev, RKISPP_CTRL_QUICK, 0, GLB_FEC2SCL_EN);
+	else
+		rkispp_clear_bits(dev, RKISPP_CTRL_QUICK, GLB_FEC2SCL_EN);
+	rkispp_set_bits(dev, stream->config->reg.ctrl, mask, val);
+	stream->scl_bypass = !!(val & SW_SCL_BYPASS);
+	stream->is_cfg = true;
+}
+
+static int config_scl(struct rkispp_stream *stream)
+{
+	struct rkispp_device *dev = stream->isppdev;
+
+	rkispp_frame_end(stream);
+	program_scl(stream);
+
+	v4l2_dbg(1, rkispp_debug, &dev->v4l2_dev,
+		 "scl%d ctrl:0x%x stride:0x%x factor:0x%x\n",
+		 stream->id - STREAM_S0,
+		 rkispp_read(dev, stream->config->reg.ctrl),
+		 rkispp_read(dev, stream->config->reg.cur_vir_stride),
+		 rkispp_read(dev, stream->config->reg.factor));
+	return 0;
+}
+
+static void stop_scl(struct rkispp_stream *stream)
+{
+	struct rkispp_device *dev = stream->isppdev;
+
+	rkispp_clear_bits(dev, stream->config->reg.ctrl, SW_SCL_ENABLE);
+}
+
+static int is_stopped_scl(struct rkispp_stream *stream)
+{
+	struct rkispp_device *dev = stream->isppdev;
+	u32 other_en = 0, val = SW_SCL_ENABLE;
+	u32 scl_en;
+	bool is_stopped;
+
+	scl_en = rkispp_read(dev, stream->config->reg.ctrl) & val;
+	if (atomic_read(&dev->stream_vdev.refcnt) == 1) {
+		val = readl(dev->hw_dev.base_addr + RKISPP_CTRL_SYS_STATUS);
+		other_en = val & 0x8f;
+	}
+	is_stopped = (scl_en | other_en) ? false : true;
+	return is_stopped;
+}
+
+/* rebuild every module register the soft reset wiped */
+static void rkispp_regs_restore(struct rkispp_device *dev)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkispp_stream *stream;
+	int i;
+
+	if (vdev->module_ens & ISPP_MODULE_TNR)
+		tnr_regs_config(dev);
+	if (vdev->module_ens & (ISPP_MODULE_NR | ISPP_MODULE_SHP))
+		nr_shp_regs_config(dev);
+	if (vdev->module_ens & ISPP_MODULE_FEC)
+		fec_regs_config(dev);
+	rkispp_params_reapply(dev);
+
+	for (i = STREAM_MB; i <= STREAM_S2; i++) {
+		stream = &vdev->stream[i];
+		if (!stream->streaming || !stream->is_cfg || stream->stopping)
+			continue;
+		if (i == STREAM_MB)
+			program_mb(stream);
+		else
+			program_scl(stream);
+		update_mi(stream);
+	}
+}
+
+static int limit_check_scl(struct rkispp_stream *stream,
+			   struct v4l2_pix_format_mplane *try_fmt)
+{
+	struct rkispp_device *dev = stream->isppdev;
+	struct rkispp_subdev *sdev = &dev->ispp_sdev;
+	u32 max_width, max_ratio = 8, min_ratio = 2;
+	u32 *w = try_fmt ? &try_fmt->width : &stream->out_fmt.width;
+	u32 *h = try_fmt ? &try_fmt->height : &stream->out_fmt.height;
+	u32 forcc = try_fmt ? try_fmt->pixelformat :
+			      stream->out_fmt.pixelformat;
+	int ret = 0;
+
+	if (*w == sdev->out_fmt.width && *h == sdev->out_fmt.height)
+		return ret;
+
+	if (stream->id == STREAM_S0)
+		min_ratio = 1;
+	max_width = scl_max_width(stream, forcc, *h == sdev->out_fmt.height);
+
+	/* the ratio limits need the input, known once the ISP is configured */
+	if (try_fmt) {
+		if (*w > max_width)
+			*w = max_width;
+		return 0;
+	}
+
+	if (*w > max_width || *w * max_ratio < sdev->out_fmt.width ||
+	    *h * max_ratio < sdev->out_fmt.height ||
+	    *w * min_ratio > sdev->out_fmt.width ||
+	    *h * min_ratio > sdev->out_fmt.height) {
+		v4l2_err(&dev->v4l2_dev,
+			 "scale%d:%dx%d out of range:\n"
+			 "\t[width max:%d ratio max:%d min:%d]\n",
+			 stream->id - STREAM_S0, *w, *h, max_width, max_ratio,
+			 min_ratio);
+		*w = 0;
+		*h = 0;
+		ret = -EINVAL;
+	}
+
+	return ret;
+}
+
+static struct streams_ops input_stream_ops = {
+	.config = config_ii,
+	.start = start_ii,
+	.is_stopped = is_stopped_ii,
+};
+
+static struct streams_ops mb_stream_ops = {
+	.config = config_mb,
+	.is_stopped = is_stopped_mb,
+	.limit_check = limit_check_mb,
+};
+
+static struct streams_ops scal_stream_ops = {
+	.config = config_scl,
+	.stop = stop_scl,
+	.is_stopped = is_stopped_scl,
+	.limit_check = limit_check_scl,
+};
+
+static int rkispp_queue_setup(struct vb2_queue *queue,
+			      unsigned int *num_buffers,
+			      unsigned int *num_planes, unsigned int sizes[],
+			      struct device *alloc_ctxs[])
+{
+	struct rkispp_stream *stream = queue->drv_priv;
+	struct rkispp_device *dev = stream->isppdev;
+	const struct v4l2_pix_format_mplane *pixm = NULL;
+	const struct capture_fmt *cap_fmt = NULL;
+	u32 i;
+
+	pixm = &stream->out_fmt;
+	if (!pixm->width || !pixm->height)
+		return -EINVAL;
+	cap_fmt = &stream->out_cap_fmt;
+	*num_planes = cap_fmt->mplanes;
+
+	for (i = 0; i < cap_fmt->mplanes; i++) {
+		const struct v4l2_plane_pix_format *plane_fmt;
+
+		plane_fmt = &pixm->plane_fmt[i];
+		/* the encoder imports the output with a 16-line aligned height */
+		sizes[i] = (stream->type == STREAM_OUTPUT) ?
+				   plane_fmt->sizeimage +
+					   (ALIGN(pixm->height, 16) -
+					    pixm->height) *
+						   (plane_fmt->sizeimage /
+						    pixm->height) :
+				   plane_fmt->sizeimage;
+	}
+
+	v4l2_dbg(1, rkispp_debug, &dev->v4l2_dev,
+		 "%s stream:%d count %d, size %d\n",
+		 v4l2_type_names[queue->type], stream->id, *num_buffers,
+		 sizes[0]);
+
+	return 0;
+}
+
+static void rkispp_buf_queue(struct vb2_buffer *vb)
+{
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct rkispp_buffer *isppbuf = to_rkispp_buffer(vbuf);
+	struct vb2_queue *queue = vb->vb2_queue;
+	struct rkispp_stream *stream = queue->drv_priv;
+	struct rkispp_device *dev = stream->isppdev;
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct v4l2_pix_format_mplane *pixm = &stream->out_fmt;
+	struct capture_fmt *cap_fmt = &stream->out_cap_fmt;
+	unsigned long lock_flags = 0;
+	u32 height, size, offset;
+	int i;
+
+	memset(isppbuf->buff_addr, 0, sizeof(isppbuf->buff_addr));
+	for (i = 0; i < cap_fmt->mplanes; i++)
+		isppbuf->buff_addr[i] = vb2_dma_contig_plane_dma_addr(vb, i);
+	/* sizeimage covers all planes of a single memory plane format */
+	if (cap_fmt->mplanes == 1) {
+		for (i = 0; i < cap_fmt->cplanes - 1; i++) {
+			height = pixm->height;
+			size = (i == 0) ? pixm->plane_fmt[i].bytesperline *
+						  height :
+					  pixm->plane_fmt[i].sizeimage;
+			offset = size;
+			isppbuf->buff_addr[i + 1] =
+				isppbuf->buff_addr[i] + offset;
+		}
+	}
+
+	v4l2_dbg(2, rkispp_debug, &dev->v4l2_dev, "%s stream:%d buf:0x%pad\n",
+		 __func__, stream->id, &isppbuf->buff_addr[0]);
+
+	spin_lock_irqsave(&stream->vbq_lock, lock_flags);
+	if (stream->type == STREAM_OUTPUT ||
+	    (stream->id == STREAM_II && !stream->streaming)) {
+		list_add_tail(&isppbuf->queue, &stream->buf_queue);
+	} else {
+		i = vb->index;
+		vdev->input[i].buf = isppbuf;
+		vdev->input[i].frame_timestamp = vb->timestamp;
+		vdev->input[i].frame_id = ++dev->ispp_sdev.frm_sync_seq;
+		rkispp_queue_dmabuf(dev, &vdev->input[i]);
+	}
+	spin_unlock_irqrestore(&stream->vbq_lock, lock_flags);
+}
+
+static void rkispp_works_cancel(struct rkispp_device *dev)
+{
+	struct rkispp_monitor *monitor = &dev->stream_vdev.monitor;
+
+	cancel_work_sync(&dev->irq_work);
+	cancel_work_sync(&monitor->tnr.work);
+	cancel_work_sync(&monitor->nr.work);
+	cancel_work_sync(&monitor->fec.work);
+}
+
+static void rkispp_destroy_buf(struct rkispp_stream *stream)
+{
+	struct rkispp_device *dev = stream->isppdev;
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+
+	if (atomic_read(&vdev->refcnt) == 1) {
+		/* the works reach the buffers freed below */
+		rkispp_works_cancel(dev);
+		vdev->irq_ends = 0;
+		tnr_free_buf(dev);
+		nr_free_buf(dev);
+		fec_free_buf(dev);
+		free_pool(dev);
+		rkispp_stats_uninit_scratch(dev);
+	}
+}
+
+static void rkispp_stream_stop(struct rkispp_stream *stream)
+{
+	struct rkispp_device *dev = stream->isppdev;
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	unsigned int resets;
+
+	stream->stopping = true;
+	if (atomic_read(&vdev->refcnt) == 1)
+		v4l2_subdev_call(&dev->ispp_sdev.sd, video, s_stream, false);
+
+	if (stream->ops && stream->ops->stop) {
+		unsigned long deadline;
+
+		resets = READ_ONCE(vdev->frame_resets);
+
+		/* a scl stalled in quick mode never raises its frame end */
+		stream->ops->stop(stream);
+		/* the writer runs until the reset that follows the frame end */
+		if (atomic_read(&vdev->refcnt) > 1 &&
+		    !wait_event_timeout(stream->done,
+					READ_ONCE(vdev->frame_resets) != resets,
+					msecs_to_jiffies(500)))
+			v4l2_warn(&dev->v4l2_dev, "stream:%d: no frame reset\n",
+				  stream->id);
+		if (stream->ops->is_stopped) {
+			deadline = jiffies + msecs_to_jiffies(500);
+			while (!stream->ops->is_stopped(stream) &&
+			       time_before(jiffies, deadline))
+				usleep_range(100, 200);
+			if (!stream->ops->is_stopped(stream))
+				v4l2_warn(&dev->v4l2_dev,
+					  "stream:%d stop timeout\n",
+					  stream->id);
+		}
+	} else {
+		/* the frame end after the dma close reports the stream stopped */
+		if (stream->ops && stream->ops->is_stopped)
+			stream->ops->is_stopped(stream);
+		if (!wait_event_timeout(stream->done, !stream->streaming,
+					msecs_to_jiffies(500)))
+			v4l2_warn(&dev->v4l2_dev, "stream:%d stop timeout\n",
+				  stream->id);
+	}
+	stream->is_upd = false;
+	stream->streaming = false;
+	stream->stopping = false;
+}
+
+static void destroy_buf_queue(struct rkispp_stream *stream,
+			      enum vb2_buffer_state state)
+{
+	struct vb2_queue *queue = &stream->vnode.buf_queue;
+	unsigned long lock_flags = 0;
+	struct rkispp_buffer *buf;
+	u32 i;
+
+	spin_lock_irqsave(&stream->vbq_lock, lock_flags);
+	if (stream->curr_buf) {
+		list_add_tail(&stream->curr_buf->queue, &stream->buf_queue);
+		stream->curr_buf = NULL;
+	}
+	while (!list_empty(&stream->buf_queue)) {
+		buf = list_first_entry(&stream->buf_queue, struct rkispp_buffer,
+				       queue);
+		list_del(&buf->queue);
+		vb2_buffer_done(&buf->vb.vb2_buf, state);
+	}
+	spin_unlock_irqrestore(&stream->vbq_lock, lock_flags);
+
+	for (i = 0; i < queue->max_num_buffers; ++i) {
+		if (!queue->bufs[i])
+			continue;
+		if (queue->bufs[i]->state == VB2_BUF_STATE_ACTIVE)
+			vb2_buffer_done(queue->bufs[i], VB2_BUF_STATE_ERROR);
+	}
+}
+
+static void rkispp_stop_streaming(struct vb2_queue *queue)
+{
+	struct rkispp_stream *stream = queue->drv_priv;
+	struct rkispp_device *dev = stream->isppdev;
+	struct rkispp_hw_dev *hw = &dev->hw_dev;
+
+	v4l2_dbg(1, rkispp_debug, &dev->v4l2_dev, "%s id:%d enter\n", __func__,
+		 stream->id);
+
+	if (!stream->streaming)
+		return;
+
+	/* the ioctl path arrives with the queue lock held */
+	rkispp_stream_stop(stream);
+	/* a writer still mid-frame after the stop would hit the freed buffers */
+	if (atomic_read(&dev->stream_vdev.refcnt) == 1)
+		rkispp_soft_reset(hw);
+	destroy_buf_queue(stream, VB2_BUF_STATE_ERROR);
+	rkispp_destroy_buf(stream);
+	atomic_dec(&dev->stream_vdev.refcnt);
+
+	if (!atomic_read(&dev->stream_vdev.refcnt)) {
+		clk_set_rate(hw->clks[0], hw->core_clk_min);
+		dev->stream_vdev.is_idle = true;
+		hw->is_first = true;
+		/* every output stream discards into the common dummy */
+		rkispp_free_common_dummy_buf(dev);
+	}
+	pm_runtime_put_sync(dev->dev);
+	v4l2_dbg(1, rkispp_debug, &dev->v4l2_dev, "%s id:%d exit\n", __func__,
+		 stream->id);
+}
+
+void rkispp_streams_unbind(struct rkispp_device *dev)
+{
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	int i;
+
+	for (i = STREAM_MB; i <= STREAM_S2; i++) {
+		struct rkispp_stream *stream = &vdev->stream[i];
+
+		if (!stream->streaming)
+			continue;
+
+		v4l2_warn(&dev->v4l2_dev,
+			  "stream:%d stopped by the isp unbind\n", stream->id);
+		/* the unbind context does not hold the queue lock */
+		mutex_lock(&dev->apilock);
+		rkispp_stop_streaming(&stream->vnode.buf_queue);
+		mutex_unlock(&dev->apilock);
+	}
+}
+
+/* runs from the isp mainpath frame end interrupt */
+static void rkispp_pool_frame(void *priv, unsigned int idx, u32 sequence,
+			      u64 timestamp)
+{
+	struct rkispp_device *dev = priv;
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkispp_ii_input *input;
+
+	if (idx >= RKISPP_BUF_POOL_MAX)
+		return;
+	input = &vdev->pool_input[idx];
+	input->buf = NULL;
+	input->from_pool = true;
+	input->pool_idx = idx;
+	input->frame_timestamp = timestamp;
+	/* the output frames carry the ISP sequence, like the ISP statistics */
+	input->frame_id = sequence;
+	dev->ispp_sdev.frm_sync_seq = sequence;
+	rkispp_queue_dmabuf(dev, input);
+}
+
+static const struct rkisp2_ispp_ops rkispp_pool_ops = {
+	.frame = rkispp_pool_frame,
+};
+
+static void rkispp_pool_put(struct rkispp_device *dev, unsigned int idx)
+{
+	struct v4l2_subdev *sd = dev->ispp_sdev.remote_sd;
+
+	if (sd)
+		v4l2_subdev_call(sd, core, ioctl, RKISP2_ISPP_CMD_PUT, &idx);
+}
+
+static void nr_rd_release(struct rkispp_device *dev, struct rkispp_ii_input *rd)
+{
+	struct rkispp_stream *stream = &dev->stream_vdev.stream[STREAM_II];
+
+	if (rd->from_pool)
+		rkispp_pool_put(dev, rd->pool_idx);
+	else if (stream->streaming && rd->buf)
+		vb2_buffer_done(&rd->buf->vb.vb2_buf, VB2_BUF_STATE_DONE);
+}
+
+static int start_isp(struct rkispp_device *dev)
+{
+	struct rkispp_subdev *ispp_sdev = &dev->ispp_sdev;
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkisp2_ispp_cfg cfg;
+	struct rkispp_stream *stream;
+	u32 w, h;
+	int ret, i;
+
+	if (dev->inp != INP_ISP || ispp_sdev->state)
+		return 0;
+
+	if (dev->stream_sync) {
+		for (i = STREAM_MB; i <= STREAM_S2; i++) {
+			stream = &vdev->stream[i];
+			if (stream->linked && !stream->streaming)
+				return 0;
+		}
+	} else if (atomic_read(&vdev->refcnt) > 1) {
+		return 0;
+	}
+
+	/* wait for the 3A to stream on and queue the first buffer */
+	if (wait_event_timeout(dev->sync_onoff,
+			       dev->params_vdev.streamon &&
+				       !dev->params_vdev.first_params,
+			       msecs_to_jiffies(1000)) == 0)
+		v4l2_warn(&dev->v4l2_dev,
+			  "waiting on params stream on event timeout\n");
+
+	ret = init_pool(dev, &w, &h);
+	if (ret < 0)
+		goto err;
+
+	ret = config_modules(dev);
+	if (ret < 0) {
+		free_pool(dev);
+		goto err;
+	}
+
+	if (!ispp_sdev->remote_sd) {
+		v4l2_err(&dev->v4l2_dev, "no isp input link\n");
+		ret = -ENODEV;
+		free_pool(dev);
+		goto err;
+	}
+	cfg.work_mode = dev->isp_mode;
+	cfg.buf_num = RKISPP_BUF_POOL_MAX;
+	cfg.width = w;
+	cfg.height = h;
+	for (i = 0; i < RKISPP_BUF_POOL_MAX; i++) {
+		cfg.buf[i].pic = vdev->pool[i].pic.dma_addr;
+		cfg.buf[i].gain = vdev->pool[i].gain.dma_addr;
+		cfg.buf[i].pic_phys = vdev->pool[i].pic.phys;
+		cfg.buf[i].gain_phys = vdev->pool[i].gain.phys;
+	}
+	cfg.ops = &rkispp_pool_ops;
+	cfg.priv = dev;
+	vdev->is_idle = true;
+	ret = v4l2_subdev_call(ispp_sdev->remote_sd, core, ioctl,
+			       RKISP2_ISPP_CMD_SET, &cfg);
+	if (ret) {
+		v4l2_err(&dev->v4l2_dev,
+			 "passing the isp input pool over failed: %d\n", ret);
+		free_pool(dev);
+		goto err;
+	}
+
+	writel(ALL_FORCE_UPD, dev->hw_dev.base_addr + RKISPP_CTRL_UPDATE);
+	for (i = STREAM_MB; i <= STREAM_S2; i++) {
+		stream = &vdev->stream[i];
+		if (stream->streaming)
+			stream->is_upd = true;
+	}
+	if (dev->isp_mode & ISP_ISPP_QUICK)
+		rkispp_set_bits(dev, RKISPP_CTRL_QUICK, 0, GLB_QUICK_EN);
+
+	dev->isr_cnt = 0;
+	dev->isr_err_cnt = 0;
+	ret = v4l2_subdev_call(&ispp_sdev->sd, video, s_stream, true);
+	if (ret < 0)
+		free_pool(dev);
+err:
+	return ret;
+}
+
+static int rkispp_start_streaming(struct vb2_queue *queue, unsigned int count)
+{
+	struct rkispp_stream *stream = queue->drv_priv;
+	struct rkispp_device *dev = stream->isppdev;
+	struct rkispp_hw_dev *hw = &dev->hw_dev;
+	int ret = -1;
+
+	v4l2_dbg(1, rkispp_debug, &dev->v4l2_dev, "%s id:%d enter\n", __func__,
+		 stream->id);
+
+	if (stream->streaming)
+		return -EBUSY;
+
+	if (dev->inp == INP_DDR && !atomic_read(&dev->stream_vdev.refcnt) &&
+	    clk_get_rate(hw->clks[0]) <= hw->core_clk_min) {
+		dev->hw_dev.is_first = false;
+		clk_set_rate(hw->clks[0], hw->core_clk_max);
+	}
+
+	stream->is_upd = false;
+	stream->is_cfg = false;
+	atomic_inc(&dev->stream_vdev.refcnt);
+	if (!dev->inp || !stream->linked) {
+		v4l2_err(&dev->v4l2_dev, "no link or invalid input source\n");
+		goto free_buf_queue;
+	}
+
+	ret = pm_runtime_resume_and_get(dev->dev);
+	if (ret < 0) {
+		v4l2_err(&dev->v4l2_dev, "stream:%d runtime resume failed:%d\n",
+			 stream->id, ret);
+		goto free_buf_queue;
+	}
+
+	ret = rkispp_alloc_common_dummy_buf(dev);
+	if (ret < 0)
+		goto pm_put;
+
+	ret = rkispp_stats_init_scratch(dev);
+	if (ret < 0)
+		goto free_dummy_buf;
+
+	if (dev->inp == INP_ISP)
+		dev->stream_vdev.module_ens |= ISPP_MODULE_NR;
+
+	if (stream->ops && stream->ops->config) {
+		ret = stream->ops->config(stream);
+		if (ret < 0)
+			goto free_dummy_buf;
+	}
+
+	if (stream->ops && stream->ops->start)
+		stream->ops->start(stream);
+
+	stream->streaming = true;
+
+	ret = start_isp(dev);
+	if (ret)
+		goto free_dummy_buf;
+
+	v4l2_dbg(1, rkispp_debug, &dev->v4l2_dev, "%s id:%d exit\n", __func__,
+		 stream->id);
+	return 0;
+free_dummy_buf:
+	rkispp_free_common_dummy_buf(dev);
+pm_put:
+	pm_runtime_put_sync(dev->dev);
+free_buf_queue:
+	destroy_buf_queue(stream, VB2_BUF_STATE_QUEUED);
+	rkispp_destroy_buf(stream);
+	atomic_dec(&dev->stream_vdev.refcnt);
+	stream->streaming = false;
+	stream->is_upd = false;
+	v4l2_err(&dev->v4l2_dev, "%s id:%d failed ret:%d\n", __func__,
+		 stream->id, ret);
+	return ret;
+}
+
+static const struct vb2_ops stream_vb2_ops = {
+	.queue_setup = rkispp_queue_setup,
+	.buf_queue = rkispp_buf_queue,
+	.stop_streaming = rkispp_stop_streaming,
+	.start_streaming = rkispp_start_streaming,
+};
+
+static int rkispp_init_vb2_queue(struct vb2_queue *q,
+				 struct rkispp_stream *stream,
+				 enum v4l2_buf_type buf_type)
+{
+	q->type = buf_type;
+	q->io_modes = VB2_MMAP | VB2_DMABUF | VB2_USERPTR;
+	q->drv_priv = stream;
+	q->ops = &stream_vb2_ops;
+	q->mem_ops = &vb2_dma_contig_memops;
+	q->buf_struct_size = sizeof(struct rkispp_buffer);
+	if (q->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE)
+		q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	else
+		q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	q->lock = &stream->isppdev->apilock;
+	q->dev = stream->isppdev->hw_dev.dev;
+	q->allow_cache_hints = 1;
+	/* the CPU never touches the frames: keep them out of vmalloc space */
+	q->dma_attrs = DMA_ATTR_FORCE_CONTIGUOUS | DMA_ATTR_NO_KERNEL_MAPPING;
+	return vb2_queue_init(q);
+}
+
+static int rkispp_set_fmt(struct rkispp_stream *stream,
+			  struct v4l2_pix_format_mplane *pixm, bool try)
+{
+	struct rkispp_device *dev = stream->isppdev;
+	struct rkispp_subdev *sdev = &dev->ispp_sdev;
+	const struct capture_fmt *fmt;
+	unsigned int imagsize = 0;
+	unsigned int planes;
+	u32 xsubs = 1, ysubs = 1;
+	unsigned int i;
+	int ret = 0;
+
+	fmt = find_fmt(stream, pixm->pixelformat);
+	if (!fmt) {
+		v4l2_err(&dev->v4l2_dev, "nonsupport pixelformat:%c%c%c%c\n",
+			 pixm->pixelformat, pixm->pixelformat >> 8,
+			 pixm->pixelformat >> 16, pixm->pixelformat >> 24);
+		return -EINVAL;
+	}
+
+	pixm->num_planes = fmt->mplanes;
+	pixm->field = V4L2_FIELD_NONE;
+	if (!pixm->quantization)
+		pixm->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+
+	fcc_xysubs(fmt->fourcc, &xsubs, &ysubs);
+	planes = fmt->cplanes ? fmt->cplanes : fmt->mplanes;
+	for (i = 0; i < planes; i++) {
+		struct v4l2_plane_pix_format *plane_fmt;
+		unsigned int width, height, w, h;
+
+		plane_fmt = pixm->plane_fmt + i;
+
+		w = pixm->width;
+		h = pixm->height;
+		width = i ? w / xsubs : w;
+		height = i ? h / ysubs : h;
+
+		/* the write engines step the lines by 16 bytes */
+		plane_fmt->bytesperline =
+			ALIGN(width * DIV_ROUND_UP(fmt->bpp[i], 8), 16);
+		plane_fmt->sizeimage = plane_fmt->bytesperline * height;
+		imagsize += plane_fmt->sizeimage;
+	}
+
+	/* the write engine over-shoots the frame tail by a few lines */
+	imagsize += pixm->plane_fmt[planes - 1].bytesperline * 4;
+
+	if (fmt->mplanes == 1)
+		pixm->plane_fmt[0].sizeimage = imagsize;
+	else
+		pixm->plane_fmt[planes - 1].sizeimage +=
+			pixm->plane_fmt[planes - 1].bytesperline * 4;
+
+	if (!try) {
+		stream->out_cap_fmt = *fmt;
+		stream->out_fmt = *pixm;
+
+		if (stream->id == STREAM_II && stream->linked) {
+			sdev->in_fmt.width = pixm->width;
+			sdev->in_fmt.height = pixm->height;
+			sdev->out_fmt.width = pixm->width;
+			sdev->out_fmt.height = pixm->height;
+		}
+		if (stream->id != STREAM_II && dev->inp == INP_ISP) {
+			ret = rkispp_sd_sync_input(sdev);
+			if (ret) {
+				v4l2_err(&dev->v4l2_dev, "isp input sync: %d\n",
+					 ret);
+				return ret;
+			}
+		}
+		v4l2_dbg(1, rkispp_debug, &dev->v4l2_dev,
+			 "%s: stream: %d req(%d, %d) out(%d, %d)\n", __func__,
+			 stream->id, pixm->width, pixm->height,
+			 stream->out_fmt.width, stream->out_fmt.height);
+
+		if (sdev->out_fmt.width > RKISPP_MAX_WIDTH ||
+		    sdev->out_fmt.height > RKISPP_MAX_HEIGHT ||
+		    sdev->out_fmt.width < RKISPP_MIN_WIDTH ||
+		    sdev->out_fmt.height < RKISPP_MIN_HEIGHT) {
+			v4l2_err(&dev->v4l2_dev,
+				 "ispp input min:%dx%d max:%dx%d\n",
+				 RKISPP_MIN_WIDTH, RKISPP_MIN_HEIGHT,
+				 RKISPP_MAX_WIDTH, RKISPP_MAX_HEIGHT);
+			stream->out_fmt.width = 0;
+			stream->out_fmt.height = 0;
+			return -EINVAL;
+		}
+	}
+
+	if (stream->ops && stream->ops->limit_check)
+		return stream->ops->limit_check(stream, try ? pixm : NULL);
+
+	return 0;
+}
