+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Rockchip ISPP debugfs
+ *
+ * Copyright (c) 2019 Fuzhou Rockchip Electronics Co., Ltd.
+ */
+
+#include <linux/debugfs.h>
+#include <linux/clk.h>
+#include <linux/pm_runtime.h>
+#include <linux/seq_file.h>
+#include <linux/string.h>
+
+#include "dev.h"
+#include "regs.h"
+
+struct rkispp_debug_register {
+	u32 reg;
+	const char *const name;
+};
+
+#define RKISPP_DEBUG_REG(name) { RKISPP_##name, #name }
+
+static int rkispp_debug_dump_regs(struct rkispp_device *dev, struct seq_file *m,
+				  const struct rkispp_debug_register *regs)
+{
+	const int width = 26;
+	int ret;
+
+	ret = pm_runtime_get_if_in_use(dev->dev);
+	if (ret <= 0)
+		return ret ?: -ENODATA;
+
+	for (; regs->name; ++regs)
+		seq_printf(m, "%*s: 0x%08x\n", width, regs->name,
+			   rkispp_read(dev, regs->reg));
+
+	pm_runtime_put(dev->dev);
+
+	return 0;
+}
+
+static int rkispp_debug_dump_ctrl_regs_show(struct seq_file *m, void *p)
+{
+	static const struct rkispp_debug_register registers[] = {
+		RKISPP_DEBUG_REG(CTRL_STRT),
+		RKISPP_DEBUG_REG(CTRL_UPDATE),
+		RKISPP_DEBUG_REG(CTRL_RESET),
+		RKISPP_DEBUG_REG(CTRL_CLKGATE),
+		RKISPP_DEBUG_REG(CTRL_QUICK),
+		RKISPP_DEBUG_REG(CTRL_INT_RAW_STA),
+		RKISPP_DEBUG_REG(CTRL_INT_STA),
+		RKISPP_DEBUG_REG(CTRL_INT_MSK),
+		RKISPP_DEBUG_REG(CTRL_SYS_STATUS),
+		RKISPP_DEBUG_REG(CTRL_TNR_SIZE),
+		{ /* Sentinel */ },
+	};
+	struct rkispp_device *dev = m->private;
+
+	return rkispp_debug_dump_regs(dev, m, registers);
+}
+DEFINE_SHOW_ATTRIBUTE(rkispp_debug_dump_ctrl_regs);
+
+static int rkispp_debug_dump_module_regs_show(struct seq_file *m, void *p)
+{
+	static const struct rkispp_debug_register registers[] = {
+		RKISPP_DEBUG_REG(TNR_CTRL),
+		RKISPP_DEBUG_REG(TNR_CORE_CTRL),
+		RKISPP_DEBUG_REG(NR_UVNR_CTRL_PARA),
+		RKISPP_DEBUG_REG(SHARP_CTRL),
+		RKISPP_DEBUG_REG(SHARP_CORE_CTRL),
+		RKISPP_DEBUG_REG(FEC_CORE_CTRL),
+		RKISPP_DEBUG_REG(ORB_CORE_CTRL),
+		RKISPP_DEBUG_REG(SCL0_CTRL),
+		RKISPP_DEBUG_REG(SCL1_CTRL),
+		RKISPP_DEBUG_REG(SCL2_CTRL),
+		{ /* Sentinel */ },
+	};
+	struct rkispp_device *dev = m->private;
+
+	return rkispp_debug_dump_regs(dev, m, registers);
+}
+DEFINE_SHOW_ATTRIBUTE(rkispp_debug_dump_module_regs);
+
+static int rkispp_debug_show(struct seq_file *m, void *p)
+{
+	struct rkispp_device *dev = m->private;
+	struct rkispp_stream_vdev *vdev = &dev->stream_vdev;
+	struct rkispp_stream *stream;
+	u32 val, i;
+
+	for (i = 0; i < dev->hw_dev.clks_num; i++)
+		seq_printf(m, "%-10s %ld Hz\n", "Clock",
+			   clk_get_rate(dev->hw_dev.clks[i]));
+	seq_printf(m, "%-10s Input:%d\n", "Mode", dev->inp);
+	seq_printf(m, "%-10s Mode:0x%x\n", "Ispp", dev->isp_mode);
+	seq_printf(m, "%-10s Module:0x%x\n", "Enable", vdev->module_ens);
+	seq_printf(m, "%-10s Cnt:%d ErrCnt:%d\n", "Interrupt", dev->isr_cnt,
+		   dev->isr_err_cnt);
+	seq_printf(m, "%-10s Fmt:%s Size:%ux%u frame:%u rate:%dms delay:%dms\n",
+		   "Input", (dev->isp_mode & ISP_ISPP_422) ? "422" : "420",
+		   dev->ispp_sdev.out_fmt.width, dev->ispp_sdev.out_fmt.height,
+		   vdev->stream[STREAM_MB].dbg.id,
+		   vdev->stream[STREAM_MB].dbg.interval / 1000000,
+		   vdev->stream[STREAM_MB].dbg.delay / 1000000);
+	for (val = STREAM_MB; val <= STREAM_S2; val++) {
+		stream = &vdev->stream[val];
+		if (!stream->streaming)
+			continue;
+		seq_printf(m, "%-10s %s Fmt:%.4s Size:%ux%u", "Output",
+			   stream->vnode.vdev.name,
+			   (char *)&stream->out_fmt.pixelformat,
+			   stream->out_fmt.width, stream->out_fmt.height);
+		seq_printf(m, " frame:%u rate:%dms delay:%dms\n",
+			   stream->dbg.id, stream->dbg.interval / 1000000,
+			   stream->dbg.delay / 1000000);
+	}
+	seq_printf(m, "%-10s En:%d Monitoring:0x%x Retry:%u\n", "Monitor",
+		   vdev->monitor.is_en, vdev->monitor.monitoring_module,
+		   vdev->monitor.retry);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(rkispp_debug);
+
+void rkispp_debug_init(struct rkispp_device *dev)
+{
+	struct dentry *regs_dir;
+
+	dev->debugfs_dir = debugfs_create_dir("rkispp", NULL);
+
+	debugfs_create_file("ispp", 0444, dev->debugfs_dir, dev,
+			    &rkispp_debug_fops);
+
+	regs_dir = debugfs_create_dir("regs", dev->debugfs_dir);
+
+	debugfs_create_file("ctrl", 0444, regs_dir, dev,
+			    &rkispp_debug_dump_ctrl_regs_fops);
+	debugfs_create_file("module", 0444, regs_dir, dev,
+			    &rkispp_debug_dump_module_regs_fops);
+}
+
+void rkispp_debug_cleanup(struct rkispp_device *dev)
+{
+	debugfs_remove_recursive(dev->debugfs_dir);
+}
