+union rkispp_params_block {
+	const struct v4l2_isp_block_header *header;
+	const struct rkispp_params_tnr *tnr;
+	const struct rkispp_params_nr *nr;
+	const struct rkispp_params_shp *shp;
+	const struct rkispp_params_fec *fec;
+	const struct rkispp_params_orb *orb;
+	const __u8 *data;
+};
+
+struct rkispp_params_block_handler_info {
+	u32 module;
+	void (*config)(struct rkispp_device *dev,
+		       union rkispp_params_block block);
+	void (*enable)(struct rkispp_device *dev, bool en,
+		       union rkispp_params_block block);
+};
