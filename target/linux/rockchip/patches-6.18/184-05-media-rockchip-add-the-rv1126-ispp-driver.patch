+	}
+	rkispp_write(dev, RKISPP_NR_UVNR_T2GEN_M3ALPHA,
+		     arg->uvnr_t2gen_m3alpha);
+	rkispp_write(dev, RKISPP_NR_UVNR_T2GEN_MSIGMA, arg->uvnr_t2gen_msigma);
+	rkispp_write(dev, RKISPP_NR_UVNR_T2GEN_WTP, arg->uvnr_t2gen_wtp);
