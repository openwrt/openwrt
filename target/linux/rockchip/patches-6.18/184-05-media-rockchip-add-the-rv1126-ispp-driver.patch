+#define RKISPP_ISP_PARAMS_REQ_BUFS_MIN 2
+#define RKISPP_ISP_PARAMS_REQ_BUFS_MAX 8
+
+#define ISPP_PACK_4BIT(a, b, c, d, e, f, g, h)                       \
+	(((a) & 0xf) << 0 | ((b) & 0xf) << 4 | ((c) & 0xf) << 8 |    \
+	 ((d) & 0xf) << 12 | ((e) & 0xf) << 16 | ((f) & 0xf) << 20 | \
+	 ((g) & 0xf) << 24 | ((h) & 0xf) << 28)
+
+#define ISPP_PACK_4BYTE(a, b, c, d)                                   \
+	(((a) & 0xFF) << 0 | ((b) & 0xFF) << 8 | ((c) & 0xFF) << 16 | \
+	 ((d) & 0xFF) << 24)
+
+#define ISPP_PACK_2SHORT(a, b) (((a) & 0xFFFF) << 0 | ((b) & 0xFFFF) << 16)
+
+#define ISPP_NOBIG_OVERFLOW_SIZE (2560 * 1440)
