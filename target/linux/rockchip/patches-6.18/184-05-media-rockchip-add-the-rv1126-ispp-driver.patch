+static int rkispp_try_fmt_vid_mplane(struct file *file, void *fh,
+				     struct v4l2_format *f)
+{
+	struct rkispp_stream *stream = video_drvdata(file);
+
+	return rkispp_set_fmt(stream, &f->fmt.pix_mp, true);
+}
+
+static int rkispp_enum_fmt_vid_mplane(struct file *file, void *priv,
+				      struct v4l2_fmtdesc *f)
+{
+	struct rkispp_stream *stream = video_drvdata(file);
+	const struct capture_fmt *fmt = NULL;
+
+	if (f->index >= stream->config->fmt_size)
+		return -EINVAL;
+
+	fmt = &stream->config->fmts[f->index];
+	f->pixelformat = fmt->fourcc;
+
+	return 0;
+}
+
+/* the sizes limit_check_mb() and limit_check_scl() accept for the input */
+static int rkispp_enum_framesizes(struct file *file, void *fh,
+				  struct v4l2_frmsizeenum *fsize)
+{
+	struct rkispp_stream *stream = video_drvdata(file);
+	struct rkispp_subdev *sdev = &stream->isppdev->ispp_sdev;
+	struct v4l2_frmsize_stepwise *sw = &fsize->stepwise;
+	u32 in_w = sdev->out_fmt.width, in_h = sdev->out_fmt.height;
+	u32 max_width, max_ratio = 8, min_ratio = 2;
+
+	if (fsize->index || !find_fmt(stream, fsize->pixel_format))
+		return -EINVAL;
+
+	if (stream->id == STREAM_MB && in_w && in_h) {
+		fsize->type = V4L2_FRMSIZE_TYPE_DISCRETE;
+		fsize->discrete.width = in_w;
+		fsize->discrete.height = in_h;
+		return 0;
+	}
+
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	sw->step_width = 2;
+	sw->step_height = 2;
+	if (stream->id <= STREAM_MB || !in_w || !in_h) {
+		sw->min_width = RKISPP_MIN_WIDTH;
+		sw->min_height = RKISPP_MIN_HEIGHT;
+		sw->max_width = RKISPP_MAX_WIDTH;
+		sw->max_height = RKISPP_MAX_HEIGHT;
+		return 0;
+	}
+
+	if (stream->id == STREAM_S0)
+		min_ratio = 1;
+	max_width = scl_max_width(stream, fsize->pixel_format, false);
+	sw->min_width = DIV_ROUND_UP(in_w, max_ratio);
+	sw->min_height = DIV_ROUND_UP(in_h, max_ratio);
+	sw->max_width = min(in_w / min_ratio, max_width);
+	sw->max_height = in_h / min_ratio;
+
+	return 0;
+}
+
+static int rkispp_s_fmt_vid_mplane(struct file *file, void *priv,
+				   struct v4l2_format *f)
+{
+	struct rkispp_stream *stream = video_drvdata(file);
+	struct video_device *vdev = &stream->vnode.vdev;
+	struct rkispp_vdev_node *node = vdev_to_node(vdev);
+	struct rkispp_device *dev = stream->isppdev;
+
+	if (vb2_is_streaming(&node->buf_queue)) {
+		v4l2_err(&dev->v4l2_dev, "%s queue busy\n", __func__);
+		return -EBUSY;
+	}
+
+	return rkispp_set_fmt(stream, &f->fmt.pix_mp, false);
+}
+
+static int rkispp_g_fmt_vid_mplane(struct file *file, void *fh,
+				   struct v4l2_format *f)
+{
+	struct rkispp_stream *stream = video_drvdata(file);
+
+	f->fmt.pix_mp = stream->out_fmt;
+
+	return 0;
+}
