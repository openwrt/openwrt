@@ -0,0 +1,402 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Rockchip ISPP platform driver
+ *
+ * Copyright (c) 2019 Fuzhou Rockchip Electronics Co., Ltd.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/pm_runtime.h>
+#include <linux/property.h>
+#include <media/v4l2-async.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "dev.h"
+#include "regs.h"
+
+int rkispp_debug;
+module_param_named(debug, rkispp_debug, int, 0644);
+MODULE_PARM_DESC(debug, "Debug level (0-3)");
+
+bool rkispp_monitor;
+module_param_named(monitor, rkispp_monitor, bool, 0644);
+MODULE_PARM_DESC(monitor, "rkispp abnormal restart monitor");
+
+static int rkisp_ispp_mode = ISP_ISPP_422;
+module_param_named(mode, rkisp_ispp_mode, int, 0644);
+MODULE_PARM_DESC(mode, "isp->ispp mode: bit0 fbc, bit1 yuv422, bit2 quick");
+
+static int rkispp_modules;
+module_param_named(modules, rkispp_modules, int, 0644);
+MODULE_PARM_DESC(modules, "mask: bit0 tnr, 1 nr, 2 shp, 3 fec, 16 tnr 3to1");
+
+static bool rkispp_stream_sync;
+module_param_named(stream_sync, rkispp_stream_sync, bool, 0644);
+MODULE_PARM_DESC(stream_sync, "rkispp stream sync output");
+
+static int rkispp_async_bound(struct v4l2_async_notifier *nf,
+			      struct v4l2_subdev *sd,
+			      struct v4l2_async_connection *asd)
+{
+	struct rkispp_device *dev = container_of(nf, struct rkispp_device, nf);
+	u32 flags = MEDIA_LNK_FL_ENABLED | MEDIA_LNK_FL_IMMUTABLE;
+	struct media_entity *sink = &dev->ispp_sdev.sd.entity;
+	int ret;
+
+	dev->ispp_sdev.remote_sd = sd;
+	dev->inp = INP_ISP;
+
+	/* the input format queries reach the ISP through the graph */
+	ret = media_create_pad_link(&sd->entity, 0, sink, RKISPP_PAD_SINK,
+				    flags);
+	if (ret)
+		v4l2_warn(&dev->v4l2_dev, "failed to link the isp input: %d\n",
+			  ret);
+
+	return 0;
+}
+
+static void rkispp_async_unbind(struct v4l2_async_notifier *nf,
+				struct v4l2_subdev *sd,
+				struct v4l2_async_connection *asd)
+{
+	struct rkispp_device *dev = container_of(nf, struct rkispp_device, nf);
+
+	rkispp_streams_unbind(dev);
+	dev->ispp_sdev.remote_sd = NULL;
+}
+
+static const struct v4l2_async_notifier_operations rkispp_async_ops = {
+	.bound = rkispp_async_bound,
+	.unbind = rkispp_async_unbind,
+};
+
+static struct fwnode_handle *rkispp_input_remote(struct rkispp_device *dev)
+{
+	struct fwnode_handle *ep, *remote;
+
+	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev->dev), 0, 0, 0);
+	if (!ep)
+		return NULL;
+
+	remote = fwnode_graph_get_remote_port_parent(ep);
+	fwnode_handle_put(ep);
+
+	return remote;
+}
+
+/* the ISP publishes its pipe subdev at its own device fwnode */
+static int rkispp_async_register(struct rkispp_device *dev)
+{
+	struct v4l2_async_connection *asd;
+	struct fwnode_handle *remote;
+	int ret;
+
+	remote = rkispp_input_remote(dev);
+	if (!remote)
+		return 0;
+
+	v4l2_async_nf_init(&dev->nf, &dev->v4l2_dev);
+	dev->nf.ops = &rkispp_async_ops;
+
+	asd = v4l2_async_nf_add_fwnode(&dev->nf, remote,
+				       struct v4l2_async_connection);
+	fwnode_handle_put(remote);
+	if (IS_ERR(asd)) {
+		ret = PTR_ERR(asd);
+		goto err_cleanup;
+	}
+
+	ret = v4l2_async_nf_register(&dev->nf);
+	if (ret)
+		goto err_cleanup;
+
+	return 0;
+
+err_cleanup:
+	v4l2_async_nf_cleanup(&dev->nf);
+	dev->nf.ops = NULL;
+	return ret;
+}
+
+static void rkispp_async_unregister(struct rkispp_device *dev)
+{
+	if (!dev->nf.ops)
+		return;
+
+	v4l2_async_nf_unregister(&dev->nf);
+	v4l2_async_nf_cleanup(&dev->nf);
+	dev->nf.ops = NULL;
+}
+
+static int rkispp_create_links(struct rkispp_device *ispp_dev)
+{
+	struct rkispp_stream_vdev *stream_vdev;
+	struct rkispp_stream *stream;
+	struct media_entity *source, *sink;
+	struct fwnode_handle *remote;
+	unsigned int flags = 0;
+	int ret;
+
+	stream_vdev = &ispp_dev->stream_vdev;
+	stream = &stream_vdev->stream[STREAM_II];
+	sink = &ispp_dev->ispp_sdev.sd.entity;
+	remote = rkispp_input_remote(ispp_dev);
+	if (remote) {
+		ispp_dev->inp = INP_ISP;
+		fwnode_handle_put(remote);
+	} else {
+		flags = MEDIA_LNK_FL_ENABLED;
+		ispp_dev->inp = INP_DDR;
+		stream->linked = true;
+	}
+
+	source = &stream->vnode.vdev.entity;
+	ret = media_create_pad_link(source, 0, sink, RKISPP_PAD_SINK, flags);
+	if (ret < 0)
+		return ret;
+
+	flags = MEDIA_LNK_FL_ENABLED;
+	source = &ispp_dev->params_vdev.vnode.vdev.entity;
+	ret = media_create_pad_link(source, 0, sink, RKISPP_PAD_SINK_PARAMS,
+				    flags);
+	if (ret < 0)
+		return ret;
+
+	flags = MEDIA_LNK_FL_ENABLED;
+	source = &ispp_dev->ispp_sdev.sd.entity;
+	sink = &ispp_dev->stats_vdev.vnode.vdev.entity;
+	ret = media_create_pad_link(source, RKISPP_PAD_SOURCE_STATS, sink, 0,
+				    flags);
+	if (ret < 0)
+		return ret;
+
+	flags = ispp_dev->stream_sync ? 0 : MEDIA_LNK_FL_ENABLED;
+	stream = &stream_vdev->stream[STREAM_MB];
+	stream->linked = !!flags;
+	source = &ispp_dev->ispp_sdev.sd.entity;
+	sink = &stream->vnode.vdev.entity;
+	ret = media_create_pad_link(source, RKISPP_PAD_SOURCE, sink, 0, flags);
+	if (ret < 0)
+		return ret;
+
+	stream = &stream_vdev->stream[STREAM_S0];
+	stream->linked = !!flags;
+	sink = &stream->vnode.vdev.entity;
+	ret = media_create_pad_link(source, RKISPP_PAD_SOURCE, sink, 0, flags);
+	if (ret < 0)
+		return ret;
+
+	stream = &stream_vdev->stream[STREAM_S1];
+	stream->linked = !!flags;
+	sink = &stream->vnode.vdev.entity;
+	ret = media_create_pad_link(source, RKISPP_PAD_SOURCE, sink, 0, flags);
+	if (ret < 0)
+		return ret;
+
+	stream = &stream_vdev->stream[STREAM_S2];
+	stream->linked = !!flags;
+	sink = &stream->vnode.vdev.entity;
+	ret = media_create_pad_link(source, RKISPP_PAD_SOURCE, sink, 0, flags);
+	if (ret < 0)
+		return ret;
+
+	/* the modules parameter overrides the mask for non-standard pipelines */
+	if (rkispp_modules)
+		ispp_dev->stream_vdev.module_ens =
+			rkispp_modules &
+			(ISPP_MODULE_TNR_3TO1 | ISPP_MODULE_NR |
+			 ISPP_MODULE_SHP | ISPP_MODULE_FEC);
+	else
+		ispp_dev->stream_vdev.module_ens = ISPP_MODULE_NR |
+						   ISPP_MODULE_SHP;
+	return 0;
+}
+
+static int rkispp_register_platform_subdevs(struct rkispp_device *ispp_dev)
+{
+	int ret;
+
+	ret = rkispp_register_stream_vdevs(ispp_dev);
+	if (ret < 0)
+		return ret;
+
+	ret = rkispp_register_params_vdev(ispp_dev);
+	if (ret < 0)
+		goto err_unreg_stream_vdevs;
+
+	ret = rkispp_register_stats_vdev(ispp_dev);
+	if (ret < 0)
+		goto err_unreg_params_vdev;
+
+	ret = rkispp_register_subdev(ispp_dev, &ispp_dev->v4l2_dev);
+	if (ret < 0)
+		goto err_unreg_stats_vdev;
+
+	ret = rkispp_create_links(ispp_dev);
+	if (ret < 0)
+		goto err_unreg_ispp_subdev;
+	return ret;
+err_unreg_ispp_subdev:
+	rkispp_unregister_subdev(ispp_dev);
+err_unreg_stats_vdev:
+	rkispp_unregister_stats_vdev(ispp_dev);
+err_unreg_params_vdev:
+	rkispp_unregister_params_vdev(ispp_dev);
+err_unreg_stream_vdevs:
+	rkispp_unregister_stream_vdevs(ispp_dev);
+	return ret;
+}
+
+static const struct of_device_id rkispp_plat_of_match[] = {
+	{
+		.compatible = "rockchip,rv1126-ispp",
+	},
+	{},
+};
+
+static int rkispp_plat_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct rkispp_device *ispp_dev;
+	int ret;
+
+	ispp_dev = devm_kzalloc(dev, sizeof(*ispp_dev), GFP_KERNEL);
+	if (!ispp_dev)
+		return -ENOMEM;
+
+	dev_set_drvdata(dev, ispp_dev);
+	ispp_dev->dev = dev;
+	ispp_dev->isp_mode = rkisp_ispp_mode;
+	ispp_dev->stream_sync = rkispp_stream_sync;
+	ispp_dev->stream_vdev.monitor.is_en = rkispp_monitor;
+	ispp_dev->stream_vdev.is_idle = true;
+
+	strscpy(ispp_dev->name, DRIVER_NAME, sizeof(ispp_dev->name));
+	ispp_dev->irq_hdl = rkispp_isr;
+	mutex_init(&ispp_dev->apilock);
+	mutex_init(&ispp_dev->iqlock);
+	init_waitqueue_head(&ispp_dev->sync_onoff);
+
+	strscpy(ispp_dev->media_dev.model, ispp_dev->name,
+		sizeof(ispp_dev->media_dev.model));
+	ispp_dev->media_dev.dev = dev;
+	ispp_dev->v4l2_dev.mdev = &ispp_dev->media_dev;
+	strscpy(ispp_dev->v4l2_dev.name, ispp_dev->name,
+		sizeof(ispp_dev->v4l2_dev.name));
+
+	ret = v4l2_device_register(dev, &ispp_dev->v4l2_dev);
+	if (ret < 0) {
+		dev_err(dev, "register v4l2 device failed:%d\n", ret);
+		return ret;
+	}
+
+	media_device_init(&ispp_dev->media_dev);
+	ret = media_device_register(&ispp_dev->media_dev);
+	if (ret < 0) {
+		dev_err(dev, "register media device failed:%d\n", ret);
+		goto err_unreg_v4l2_dev;
+	}
+
+	ret = rkispp_hw_init(ispp_dev);
+	if (ret < 0)
+		goto err_unreg_media_dev;
+
+	ret = rkispp_register_platform_subdevs(ispp_dev);
+	if (ret < 0)
+		goto err_hw_exit;
+
+	rkispp_debug_init(ispp_dev);
+
+	ret = rkispp_async_register(ispp_dev);
+	if (ret < 0)
+		goto err_unreg_platform_subdevs;
+
+	return 0;
+
+err_unreg_platform_subdevs:
+	rkispp_unregister_subdev(ispp_dev);
+	rkispp_unregister_stats_vdev(ispp_dev);
+	rkispp_unregister_params_vdev(ispp_dev);
+	rkispp_unregister_stream_vdevs(ispp_dev);
+err_hw_exit:
+	rkispp_hw_exit(ispp_dev);
+err_unreg_media_dev:
+	media_device_unregister(&ispp_dev->media_dev);
+err_unreg_v4l2_dev:
+	v4l2_device_unregister(&ispp_dev->v4l2_dev);
+	return ret;
+}
+
+static void rkispp_plat_remove(struct platform_device *pdev)
+{
+	struct rkispp_device *ispp_dev = platform_get_drvdata(pdev);
+
+	rkispp_async_unregister(ispp_dev);
+	rkispp_debug_cleanup(ispp_dev);
+	rkispp_unregister_subdev(ispp_dev);
+	rkispp_unregister_stats_vdev(ispp_dev);
+	rkispp_unregister_params_vdev(ispp_dev);
+	rkispp_unregister_stream_vdevs(ispp_dev);
+	rkispp_hw_exit(ispp_dev);
+
+	media_device_unregister(&ispp_dev->media_dev);
+	v4l2_device_unregister(&ispp_dev->v4l2_dev);
+}
+
+static int __maybe_unused rkispp_runtime_suspend(struct device *dev)
+{
+	struct rkispp_device *ispp_dev = dev_get_drvdata(dev);
+
+	writel(0, ispp_dev->hw_dev.base_addr + RKISPP_CTRL_INT_MSK);
+	rkispp_disable_sys_clk(&ispp_dev->hw_dev);
+	return 0;
+}
+
+static int __maybe_unused rkispp_runtime_resume(struct device *dev)
+{
+	struct rkispp_device *ispp_dev = dev_get_drvdata(dev);
+	int ret;
+
+	ispp_dev->isp_mode = rkisp_ispp_mode;
+	ispp_dev->stream_sync = rkispp_stream_sync;
+	ispp_dev->stream_vdev.monitor.is_en = rkispp_monitor;
+
+	ret = rkispp_enable_sys_clk(&ispp_dev->hw_dev);
+	if (ret < 0)
+		return ret;
+
+	rkispp_soft_reset(&ispp_dev->hw_dev);
+	ispp_dev->stream_vdev.is_idle = true;
+	return 0;
+}
+
+static const struct dev_pm_ops rkispp_plat_pm_ops = {
+	SET_SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend,
+				pm_runtime_force_resume)
+		SET_RUNTIME_PM_OPS(rkispp_runtime_suspend,
+				   rkispp_runtime_resume, NULL)
+};
+
+static struct platform_driver rkispp_plat_drv = {
+	.driver = {
+		.name = DRIVER_NAME,
+		.of_match_table = of_match_ptr(rkispp_plat_of_match),
+		.pm = &rkispp_plat_pm_ops,
+	},
+	.probe = rkispp_plat_probe,
+	.remove = rkispp_plat_remove,
+};
+module_platform_driver(rkispp_plat_drv);
+
+MODULE_AUTHOR("Rockchip Camera/ISP team");
+MODULE_DESCRIPTION("Rockchip ISPP platform driver");
+MODULE_LICENSE("GPL");
+MODULE_IMPORT_NS("DMA_BUF");
