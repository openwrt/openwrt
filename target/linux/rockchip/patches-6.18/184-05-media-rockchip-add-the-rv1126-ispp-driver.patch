+#ifndef _RKISPP_PARAMS_H
+#define _RKISPP_PARAMS_H
+
+#include <linux/media/rockchip/rkisp2-config.h>
+#include "common.h"
+
+struct rkispp_params_buffer {
+	struct vb2_v4l2_buffer vb;
