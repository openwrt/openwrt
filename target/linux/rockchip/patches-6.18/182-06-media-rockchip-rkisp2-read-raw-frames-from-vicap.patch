+static void rkisp2_rawrd_stop_streaming(struct vb2_queue *queue)
+{
+	struct rkisp2_dmarx_chan *chan = queue->drv_priv;
+	struct rkisp2_device *rkisp2 = chan->rkisp2;
+	struct media_entity *entity = &chan->vnode.vdev.entity;
+
+	mutex_lock(&rkisp2->stream_lock);
+	chan->streaming = false;
+	rkisp2_rawrd_return_all_buffers(chan, VB2_BUF_STATE_ERROR);
+
+	rkisp2_rawrd_hw_stop(rkisp2);
 
 	v4l2_pipeline_pm_put(entity);
 	pm_runtime_put(rkisp2->dev);
@@ -438,18 +477,41 @@ static void rkisp2_rawrd_stop_streaming(
 	mutex_unlock(&rkisp2->stream_lock);
 }
 
+static void rkisp2_rawrd_hw_start(struct rkisp2_dmarx_chan *chan)
+{
+	struct rkisp2_buffer *buf = NULL;
+
+	rkisp2_rawrd_config_mi(chan);
+	chan->streaming = true;
+
+	spin_lock_irq(&chan->buf_lock);
+	if (!list_empty(&chan->buf_queue)) {
+		buf = list_first_entry(&chan->buf_queue,
+				       struct rkisp2_buffer, queue);
+		list_del(&buf->queue);
+	}
+	chan->curr_buf = buf;
+	chan->busy = buf;
+	spin_unlock_irq(&chan->buf_lock);
+
+	rkisp2_rawrd_update_mi(chan, buf);
+}
+
 static int rkisp2_rawrd_start_streaming(struct vb2_queue *queue,
 					unsigned int count)
 {
 	struct rkisp2_dmarx_chan *chan = queue->drv_priv;
 	struct rkisp2_device *rkisp2 = chan->rkisp2;
 	struct media_entity *entity = &chan->vnode.vdev.entity;
-	struct rkisp2_buffer *buf = NULL;
 	int ret;
-	u32 val;
 
 	mutex_lock(&rkisp2->stream_lock);
 
+	if (chan->ext) {
+		ret = -EBUSY;
+		goto err_unlock;
+	}
+
 	ret = video_device_pipeline_start(&chan->vnode.vdev, &rkisp2->pipe);
 	if (ret)
 		goto err_unlock;
@@ -462,25 +524,7 @@ static int rkisp2_rawrd_start_streaming(
 	if (ret)
 		goto err_pm_put;
 
-	rkisp2_rawrd_config_mi(chan);
-	chan->streaming = true;
-
-	spin_lock_irq(&chan->buf_lock);
-	if (!list_empty(&chan->buf_queue)) {
-		buf = list_first_entry(&chan->buf_queue,
-				       struct rkisp2_buffer, queue);
-		list_del(&buf->queue);
-	}
-	chan->curr_buf = buf;
-	spin_unlock_irq(&chan->buf_lock);
-
-	rkisp2_rawrd_update_mi(chan, buf);
-
-	// Enable CSI2 Receiver
-	val = rkisp2_read(rkisp2,  CSI2RX_CTRL0);
-	val &= ~SW_IBUF_OP_MODE(0xf);
-	val |= SW_IBUF_OP_MODE(4) | SW_CSI2RX_EN | SW_DMA_2FRM_MODE(0);
-	rkisp2_write(rkisp2, CSI2RX_CTRL0, val);
+	rkisp2_rawrd_hw_start(chan);
 
 	mutex_unlock(&rkisp2->stream_lock);
 	return 0;
@@ -495,6 +539,72 @@ err_unlock:
 	return ret;
 }
 
+int rkisp2_dmarx_ext_start(struct rkisp2_device *rkisp2, u32 fourcc,
+			   u32 width, u32 height)
+{
+	struct rkisp2_dmarx_chan *chan = &rkisp2->dmarx.chan[RKISP2_RAWRD0];
+	struct v4l2_pix_format_mplane pix = {
+		.pixelformat = fourcc,
+		.width = width,
+		.height = height,
+	};
+
+	if (chan->streaming || vb2_is_busy(&chan->vnode.buf_queue))
+		return -EBUSY;
+
+	rkisp2_rawrd_try_fmt(chan, &pix);
+	if (pix.pixelformat != fourcc || pix.width != width ||
+	    pix.height != height)
+		return -EINVAL;
+
+	chan->pix = pix;
+	chan->fmt = rkisp2_rawrd_find_fmt(chan, fourcc);
+
+	spin_lock_irq(&chan->buf_lock);
+	chan->ext = true;
+	chan->stopping = false;
+	spin_unlock_irq(&chan->buf_lock);
+
+	rkisp2_rawrd_hw_start(chan);
+
+	return 0;
+}
+
+bool rkisp2_dmarx_ext_queue(struct rkisp2_device *rkisp2,
+			    struct rkisp2_buffer *buf)
+{
+	return rkisp2_rawrd_buf_add(&rkisp2->dmarx.chan[RKISP2_RAWRD0], buf);
+}
+
+void rkisp2_dmarx_ext_drain(struct rkisp2_device *rkisp2)
+{
+	struct rkisp2_dmarx_chan *chan = &rkisp2->dmarx.chan[RKISP2_RAWRD0];
+
+	spin_lock_irq(&chan->buf_lock);
+	chan->stopping = true;
+	spin_unlock_irq(&chan->buf_lock);
+
+	if (!wait_event_timeout(chan->idle_wq, !READ_ONCE(chan->busy),
+				msecs_to_jiffies(RKISP2_RAWRD_DRAIN_TIMEOUT_MS)))
+		dev_warn(rkisp2->dev, "readback frame did not complete\n");
+}
+
+void rkisp2_dmarx_ext_stop(struct rkisp2_device *rkisp2)
+{
