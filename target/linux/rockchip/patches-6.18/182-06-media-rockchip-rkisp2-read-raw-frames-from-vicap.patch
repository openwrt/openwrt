+++ b/drivers/media/platform/rockchip/rkisp2/rkisp2-vicap.c
@@ -0,0 +1,322 @@
+// SPDX-License-Identifier: (GPL-2.0-or-later OR MIT)
+/*
+ * Rockchip ISP2 Driver - raw frames from the VICAP driver
+ */
+
+#include <linux/iommu.h>
+#include <linux/of.h>
+#include <linux/platform_data/media/rkcif-toisp.h>
+#include <linux/slab.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-subdev.h>
+
+#include "rkisp2-common.h"
+
+struct rkisp2_vicap_buf {
+	struct list_head entry;
+	struct rkisp2_buffer rbuf;
+	/* the iommu domain the buffer is mapped into, if any */
+	struct iommu_domain *iommu;
+	size_t iommu_size;
+};
+
+static const struct {
+	u32 mbus_code;
+	u32 fourcc;
+} rkisp2_vicap_fmts[] = {
+	{ MEDIA_BUS_FMT_SRGGB8_1X8, V4L2_PIX_FMT_SRGGB8 },
+	{ MEDIA_BUS_FMT_SBGGR8_1X8, V4L2_PIX_FMT_SBGGR8 },
+	{ MEDIA_BUS_FMT_SGRBG8_1X8, V4L2_PIX_FMT_SGRBG8 },
+	{ MEDIA_BUS_FMT_SGBRG8_1X8, V4L2_PIX_FMT_SGBRG8 },
+	{ MEDIA_BUS_FMT_SRGGB10_1X10, V4L2_PIX_FMT_SRGGB10 },
+	{ MEDIA_BUS_FMT_SBGGR10_1X10, V4L2_PIX_FMT_SBGGR10 },
+	{ MEDIA_BUS_FMT_SGRBG10_1X10, V4L2_PIX_FMT_SGRBG10 },
+	{ MEDIA_BUS_FMT_SGBRG10_1X10, V4L2_PIX_FMT_SGBRG10 },
+	{ MEDIA_BUS_FMT_SRGGB12_1X12, V4L2_PIX_FMT_SRGGB12 },
+	{ MEDIA_BUS_FMT_SBGGR12_1X12, V4L2_PIX_FMT_SBGGR12 },
+	{ MEDIA_BUS_FMT_SGRBG12_1X12, V4L2_PIX_FMT_SGRBG12 },
+	{ MEDIA_BUS_FMT_SGBRG12_1X12, V4L2_PIX_FMT_SGBRG12 },
+};
+
+static int rkisp2_vicap_call(struct rkisp2_vicap *vicap, unsigned int cmd,
+			     void *arg)
+{
+	if (!vicap->sd)
+		return -ENODEV;
+
+	return v4l2_subdev_call(vicap->sd, core, ioctl, cmd, arg);
+}
+
+void rkisp2_vicap_frame_put(struct rkisp2_device *rkisp2,
+			    struct rkisp2_buffer *buf)
+{
+	rkisp2_vicap_call(&rkisp2->vicap, RKCIF_TOISP_CMD_PUT_FRAME,
+			  buf->ext_cookie);
+}
+
+static int rkisp2_vicap_buffer(void *priv,
+			       const struct rkcif_toisp_frame *frame)
+{
+	struct rkisp2_vicap *vicap = priv;
+	struct rkisp2_vicap_buf *buf;
+	struct iommu_domain *dom;
+
+	buf = kzalloc(sizeof(*buf), GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	/*
+	 * The readback engine programs the physical buffer base (the
+	 * address the CIF DMA writes the frame to), the same scheme
+	 * the capture path uses. While the ISP's IOMMU is in the
+	 * default identity (passthrough) domain, the base translates
+	 * 1:1. If a translated domain has been attached to the ISP
+	 * instead, the physical address is not mapped and the
+	 * readback faults. Map the buffer into the current domain at
+	 * its own physical address so the base is valid in both
+	 * cases. The domain must not be detached or re-attached here:
+	 * that reprograms the SMMU while the ISP is streaming.
+	 */
+	dom = iommu_get_domain_for_dev(vicap->rkisp2->dev);
+	if (dom && (dom->type & __IOMMU_DOMAIN_PAGING) &&
+	    dom->ops && dom->ops->map_pages) {
+		buf->iommu = dom;
+		buf->iommu_size = frame->sgt->sgl[0].length;
+		if (iommu_map(dom, frame->addr, frame->addr,
+			      buf->iommu_size, IOMMU_READ | IOMMU_WRITE,
+			      GFP_KERNEL)) {
+			dev_warn(vicap->rkisp2->dev,
+				 "VICAP: could not map readback buf 0x%llx\n",
+				 (unsigned long long)frame->addr);
+			buf->iommu = NULL;
+		}
+	}
+
+	buf->rbuf.ext_cookie = frame->cookie;
+	buf->rbuf.buff_addr[0] = frame->addr;
+	INIT_LIST_HEAD(&buf->rbuf.queue);
+	list_add_tail(&buf->entry, &vicap->bufs);
+
+	return 0;
+}
+
+static void rkisp2_vicap_release(void *priv)
+{
+	struct rkisp2_vicap *vicap = priv;
+	struct rkisp2_vicap_buf *buf, *tmp;
+
+	list_for_each_entry_safe(buf, tmp, &vicap->bufs, entry) {
+		/*
+		 * Only unmap if the domain is still the one the buffer
+		 * was mapped into; the group may have been switched to
+		 * a different domain (or back to the default) in the
+		 * meantime, in which case the mapping is gone with it.
+		 */
+		if (buf->iommu &&
+		    buf->iommu == iommu_get_domain_for_dev(vicap->rkisp2->dev))
+			iommu_unmap(buf->iommu, buf->rbuf.buff_addr[0],
+				    buf->iommu_size);
+		list_del(&buf->entry);
+		kfree(buf);
+	}
+}
+
+static void rkisp2_vicap_frame(void *priv,
+			       const struct rkcif_toisp_frame *frame)
+{
+	struct rkisp2_vicap *vicap = priv;
+	struct rkisp2_vicap_buf *buf;
+
+	list_for_each_entry(buf, &vicap->bufs, entry) {
+		if (buf->rbuf.ext_cookie != frame->cookie)
+			continue;
+		if (rkisp2_dmarx_ext_queue(vicap->rkisp2, &buf->rbuf))
+			return;
+		break;
+	}
+
+	rkisp2_vicap_call(vicap, RKCIF_TOISP_CMD_PUT_FRAME, frame->cookie);
+}
+
+static const struct rkcif_toisp_ops rkisp2_vicap_ops = {
+	.buffer = rkisp2_vicap_buffer,
+	.release = rkisp2_vicap_release,
+	.frame = rkisp2_vicap_frame,
+};
+
+static u32 rkisp2_vicap_fourcc(u32 mbus_code)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(rkisp2_vicap_fmts); i++)
+		if (rkisp2_vicap_fmts[i].mbus_code == mbus_code)
+			return rkisp2_vicap_fmts[i].fourcc;
+
+	return 0;
+}
+
+bool rkisp2_vicap_available(struct rkisp2_device *rkisp2)
+{
+	struct rkisp2_dmarx_chan *chan = &rkisp2->dmarx.chan[RKISP2_RAWRD0];
+
+	return rkisp2->vicap.sd && !rkisp2_isp_dma_linked(&rkisp2->isp) &&
+	       !chan->streaming && !vb2_is_busy(&chan->vnode.buf_queue);
+}
+
+int rkisp2_vicap_start(struct rkisp2_device *rkisp2,
+		       const struct v4l2_mbus_framefmt *fmt)
+{
+	struct rkisp2_dmarx_chan *chan = &rkisp2->dmarx.chan[RKISP2_RAWRD0];
+	struct rkisp2_vicap *vicap = &rkisp2->vicap;
+	struct rkcif_toisp_start start = {
+		.ops = &rkisp2_vicap_ops,
+		.priv = vicap,
+	};
+	struct rkcif_toisp_format format;
+	u32 fourcc;
+	u32 reg;
+	int ret;
+
+	ret = rkisp2_vicap_call(vicap, RKCIF_TOISP_CMD_FORMAT_GET, &format);
+	if (ret)
+		return ret;
+
+	fourcc = rkisp2_vicap_fourcc(format.mbus_code);
+	if (!fourcc || format.mbus_code != fmt->code ||
+	    format.width != fmt->width || format.height != fmt->height) {
+		dev_err(rkisp2->dev,
+			"VICAP provides %ux%u code 0x%04x, ISP sink is %ux%u code 0x%04x\n",
+			format.width, format.height, format.mbus_code,
+			fmt->width, fmt->height, fmt->code);
+		return -EPIPE;
+	}
+
+	ret = rkisp2_dmarx_ext_start(rkisp2, fourcc, format.width,
+				     format.height);
+	if (ret)
+		return ret;
+
+	/*
+	 * The feed can run without a capture output, which is where the
+	 * readback input is normally selected; the soft update latches
+	 * the selection like the capture path does.
+	 */
+	rkisp2_dmarx_select_input(rkisp2);
+	reg = rkisp2_read(rkisp2, RKISP2_CIF_MI_INIT) &
+	      RKISP2_CIF_MI_INIT_MP_OUTPUT_MASK;
+	reg |= RKISP2_CIF_MI_INIT_SOFT_UPD;
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_INIT, reg);
+
+	start.cfg.pixelformat = fourcc;
+	start.cfg.width = format.width;
+	start.cfg.height = format.height;
+	start.cfg.extra_lines = rkisp2->info->rdbk_extra_lines;
+	ret = rkisp2_vicap_call(vicap, RKCIF_TOISP_CMD_START, &start);
+	if (!ret && start.cfg.bytesperline != chan->pix.plane_fmt[0].bytesperline) {
+		rkisp2_vicap_call(vicap, RKCIF_TOISP_CMD_STOP, NULL);
+		ret = -EINVAL;
+	}
+	if (ret) {
+		rkisp2_dmarx_ext_stop(rkisp2);
+		return ret;
+	}
+
+	vicap->active = true;
+
+	return 0;
+}
+
+void rkisp2_vicap_drain(struct rkisp2_device *rkisp2)
+{
+	if (rkisp2->vicap.active)
+		rkisp2_dmarx_ext_drain(rkisp2);
+}
+
+void rkisp2_vicap_stop(struct rkisp2_device *rkisp2)
+{
+	struct rkisp2_vicap *vicap = &rkisp2->vicap;
+
+	if (!vicap->active)
+		return;
+
+	rkisp2_dmarx_ext_stop(rkisp2);
+	rkisp2_vicap_call(vicap, RKCIF_TOISP_CMD_STOP, NULL);
+	vicap->active = false;
+}
+
+static int rkisp2_vicap_bound(struct v4l2_async_notifier *nf,
+			      struct v4l2_subdev *sd,
+			      struct v4l2_async_connection *asd)
+{
+	struct rkisp2_vicap *vicap = container_of(nf, struct rkisp2_vicap, nf);
+
+	vicap->sd = sd;
+
+	return 0;
+}
+
+static void rkisp2_vicap_unbind(struct v4l2_async_notifier *nf,
+				struct v4l2_subdev *sd,
+				struct v4l2_async_connection *asd)
+{
+	struct rkisp2_vicap *vicap = container_of(nf, struct rkisp2_vicap, nf);
+
+	vicap->sd = NULL;
+}
+
+static const struct v4l2_async_notifier_operations rkisp2_vicap_nf_ops = {
+	.bound = rkisp2_vicap_bound,
+	.unbind = rkisp2_vicap_unbind,
+};
+
+int rkisp2_vicap_register(struct rkisp2_device *rkisp2)
+{
+	struct rkisp2_vicap *vicap = &rkisp2->vicap;
+	struct v4l2_async_connection *asd;
+	struct device_node *np;
+	int ret;
+
+	if (!rkisp2->info->vicap_compatible)
+		return 0;
+
+	np = of_find_compatible_node(NULL, NULL,
+				     rkisp2->info->vicap_compatible);
+	if (!np)
+		return 0;
+
+	vicap->rkisp2 = rkisp2;
+	INIT_LIST_HEAD(&vicap->bufs);
+	v4l2_async_nf_init(&vicap->nf, &rkisp2->v4l2_dev);
+	vicap->nf.ops = &rkisp2_vicap_nf_ops;
+
+	asd = v4l2_async_nf_add_fwnode(&vicap->nf, of_fwnode_handle(np),
+				       struct v4l2_async_connection);
+	of_node_put(np);
+	if (IS_ERR(asd)) {
+		ret = PTR_ERR(asd);
+		goto err_cleanup;
+	}
+
+	ret = v4l2_async_nf_register(&vicap->nf);
+	if (ret)
+		goto err_cleanup;
+
+	return 0;
+
+err_cleanup:
+	v4l2_async_nf_cleanup(&vicap->nf);
+	vicap->nf.ops = NULL;
+	return ret;
+}
+
+void rkisp2_vicap_unregister(struct rkisp2_device *rkisp2)
+{
+	struct rkisp2_vicap *vicap = &rkisp2->vicap;
+
+	if (!vicap->nf.ops)
+		return;
+
+	v4l2_async_nf_unregister(&vicap->nf);
+	v4l2_async_nf_cleanup(&vicap->nf);
+	vicap->nf.ops = NULL;
+}
