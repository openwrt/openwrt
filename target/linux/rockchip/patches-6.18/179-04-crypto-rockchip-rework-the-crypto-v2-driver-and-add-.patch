--- a/drivers/crypto/Kconfig
+++ b/drivers/crypto/Kconfig
@@ -736,33 +736,29 @@ config CRYPTO_DEV_XILINX_TRNG
 	  will be called xilinx-trng.
 
 config CRYPTO_DEV_ROCKCHIP2
-	tristate "Rockchip's cryptographic offloader V2"
+	tristate "Rockchip Crypto V2 cryptographic offloader"
 	depends on OF && ARCH_ROCKCHIP
 	depends on PM
 	select CRYPTO_ECB
 	select CRYPTO_CBC
+	select CRYPTO_CTR
+	select CRYPTO_XTS
 	select CRYPTO_AES
 	select CRYPTO_MD5
 	select CRYPTO_SHA1
 	select CRYPTO_SHA256
 	select CRYPTO_SHA512
-	select CRYPTO_SM3_GENERIC
 	select CRYPTO_HASH
 	select CRYPTO_SKCIPHER
 	select CRYPTO_ENGINE
-
 	help
-	  This driver interfaces with the hardware crypto offloader present
-	  on RK3566, RK3568 and RK3588.
+	  This driver interfaces with the Crypto V2 hardware offloader of
+	  the Rockchip RK3568, RK3588 and RV1126. It provides AES in ECB,
+	  CBC, CTR and XTS modes and the MD5, SHA-1, SHA-256 and SHA-512
+	  digests.
 
