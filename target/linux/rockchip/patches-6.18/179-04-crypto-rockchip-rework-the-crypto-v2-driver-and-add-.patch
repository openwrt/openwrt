-static struct rockchip_ip rocklist = {
-	.dev_list = LIST_HEAD_INIT(rocklist.dev_list),
-	.lock = __SPIN_LOCK_UNLOCKED(rocklist.lock),
-};
+#include "rk2_crypto.h"
 
-struct rk2_crypto_dev *get_rk2_crypto(void)
-{
-	struct rk2_crypto_dev *first;
+/* Upper bound for one descriptor list; a 4 KiB page of data takes microseconds */
+#define RK2_CRYPTO_TIMEOUT_MS		2000
+#define RK2_CRYPTO_AUTOSUSPEND_MS	100
 
-	spin_lock(&rocklist.lock);
-	first = list_first_entry_or_null(&rocklist.dev_list,
-					 struct rk2_crypto_dev, list);
-	list_rotate_left(&rocklist.dev_list);
-	spin_unlock(&rocklist.lock);
-	return first;
+static void rk2_crypto_core_reset(struct rk2_crypto_dev *rkc)
+{
+	writel(RK2_WMASK(RK2_CRYPTO_RST_CC, RK2_CRYPTO_RST_CC),
+	       rkc->reg + RK2_CRYPTO_RST_CTL);
+	readl(rkc->reg + RK2_CRYPTO_RST_CTL);
+	writel(RK2_WMASK(0, RK2_CRYPTO_RST_CC), rkc->reg + RK2_CRYPTO_RST_CTL);
 }
 
-static const struct rk2_variant rk3568_variant = {
-	.num_clks = 3,
-};
-
-static const struct rk2_variant rk3588_variant = {
-	.num_clks = 3,
-};
-
-static int rk2_crypto_get_clks(struct rk2_crypto_dev *dev)
+int rk2_crypto_run(struct rk2_crypto_dev *rkc, unsigned int nlli, u32 done_irq)
 {
-	int i, j, err;
-	unsigned long cr;
+	u32 status;
 
-	dev->num_clks = devm_clk_bulk_get_all(dev->dev, &dev->clks);
-	if (dev->num_clks < dev->variant->num_clks) {
-		dev_err(dev->dev, "Missing clocks, got %d instead of %d\n",
-			dev->num_clks, dev->variant->num_clks);
-		return -EINVAL;
+	reinit_completion(&rkc->done);
+	writel(done_irq | RK2_INT_ERRORS, rkc->reg + RK2_CRYPTO_DMA_INT_EN);
+	writel(lower_32_bits(rkc->lli_dma), rkc->reg + RK2_CRYPTO_DMA_LLI_ADDR);
+	dma_wmb();
+	writel(RK2_WMASK(RK2_DMA_START, RK2_DMA_START),
+	       rkc->reg + RK2_CRYPTO_DMA_CTL);
+
+	if (!wait_for_completion_timeout(&rkc->done,
+					 msecs_to_jiffies(RK2_CRYPTO_TIMEOUT_MS))) {
+		dev_err(rkc->dev, "timeout on %u descriptors\n", nlli);
+		rk2_crypto_core_reset(rkc);
+		return -ETIMEDOUT;
 	}
 
-	for (i = 0; i < dev->num_clks; i++) {
-		cr = clk_get_rate(dev->clks[i].clk);
-		for (j = 0; j < ARRAY_SIZE(dev->variant->rkclks); j++) {
-			if (dev->variant->rkclks[j].max == 0)
-				continue;
-			if (strcmp(dev->variant->rkclks[j].name, dev->clks[i].id))
-				continue;
-			if (cr > dev->variant->rkclks[j].max) {
-				err = clk_set_rate(dev->clks[i].clk,
-						   dev->variant->rkclks[j].max);
-				if (err)
-					dev_err(dev->dev, "Fail downclocking %s from %lu to %lu\n",
-						dev->variant->rkclks[j].name, cr,
-						dev->variant->rkclks[j].max);
-				else
-					dev_info(dev->dev, "Downclocking %s from %lu to %lu\n",
-						 dev->variant->rkclks[j].name, cr,
-						 dev->variant->rkclks[j].max);
-			}
-		}
+	status = READ_ONCE(rkc->irq_status);
+	if (status & RK2_INT_ERRORS) {
+		dev_err(rkc->dev, "DMA error, status 0x%x\n", status);
+		rk2_crypto_core_reset(rkc);
+		return -EIO;
 	}
+
 	return 0;
 }
 
-static int rk2_crypto_enable_clk(struct rk2_crypto_dev *dev)
+static irqreturn_t rk2_crypto_irq(int irq, void *data)
 {
-	int err;
+	struct rk2_crypto_dev *rkc = data;
+	u32 status;
 
-	err = clk_bulk_prepare_enable(dev->num_clks, dev->clks);
-	if (err)
-		dev_err(dev->dev, "Could not enable clock clks\n");
+	status = readl(rkc->reg + RK2_CRYPTO_DMA_INT_ST);
+	if (!status)
+		return IRQ_NONE;
+
+	writel(status, rkc->reg + RK2_CRYPTO_DMA_INT_ST);
+	WRITE_ONCE(rkc->irq_status, status);
+	complete(&rkc->done);
 
-	return err;
-}
-
-static void rk2_crypto_disable_clk(struct rk2_crypto_dev *dev)
-{
-	clk_bulk_disable_unprepare(dev->num_clks, dev->clks);
+	return IRQ_HANDLED;
 }
 
-/*
- * Power management strategy: The device is suspended until a request
- * is handled. For avoiding suspend/resume yoyo, the autosuspend is set to 2s.
- */
-static int rk2_crypto_pm_suspend(struct device *dev)
+static int rk2_crypto_runtime_suspend(struct device *dev)
 {
-	struct rk2_crypto_dev *rkdev = dev_get_drvdata(dev);
+	struct rk2_crypto_dev *rkc = dev_get_drvdata(dev);
 
-	rk2_crypto_disable_clk(rkdev);
-	reset_control_assert(rkdev->rst);
+	clk_bulk_disable_unprepare(rkc->num_clks, rkc->clks);
 
 	return 0;
 }
 
-static int rk2_crypto_pm_resume(struct device *dev)
+static int rk2_crypto_runtime_resume(struct device *dev)
 {
-	struct rk2_crypto_dev *rkdev = dev_get_drvdata(dev);
-	int ret;
+	struct rk2_crypto_dev *rkc = dev_get_drvdata(dev);
 
-	ret = rk2_crypto_enable_clk(rkdev);
-	if (ret)
-		return ret;
-
-	reset_control_deassert(rkdev->rst);
-	return 0;
+	return clk_bulk_prepare_enable(rkc->num_clks, rkc->clks);
 }
 
 static const struct dev_pm_ops rk2_crypto_pm_ops = {
-	SET_RUNTIME_PM_OPS(rk2_crypto_pm_suspend, rk2_crypto_pm_resume, NULL)
+	SET_RUNTIME_PM_OPS(rk2_crypto_runtime_suspend,
+			   rk2_crypto_runtime_resume, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend,
+				pm_runtime_force_resume)
 };
 
-static int rk2_crypto_pm_init(struct rk2_crypto_dev *rkdev)
-{
-	int err;
-
-	pm_runtime_use_autosuspend(rkdev->dev);
-	pm_runtime_set_autosuspend_delay(rkdev->dev, 2000);
-
-	err = pm_runtime_set_suspended(rkdev->dev);
-	if (err)
-		return err;
-	pm_runtime_enable(rkdev->dev);
-	return err;
-}
-
-static void rk2_crypto_pm_exit(struct rk2_crypto_dev *rkdev)
-{
-	pm_runtime_disable(rkdev->dev);
-}
-
-static irqreturn_t rk2_crypto_irq_handle(int irq, void *dev_id)
-{
-	struct rk2_crypto_dev *rkc  = platform_get_drvdata(dev_id);
-	u32 v;
-
-	v = readl(rkc->reg + RK2_CRYPTO_DMA_INT_ST);
-	writel(v, rkc->reg + RK2_CRYPTO_DMA_INT_ST);
-
-	rkc->status = 1;
-	if (v & 0xF8) {
-		dev_warn(rkc->dev, "DMA Error\n");
-		rkc->status = 0;
-	}
-	complete(&rkc->complete);
-
-	return IRQ_HANDLED;
-}
