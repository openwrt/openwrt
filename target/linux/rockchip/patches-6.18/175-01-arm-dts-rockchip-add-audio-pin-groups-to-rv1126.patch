From 059620f8dfd376325acdf9cca3e50840f31f23f8 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Fri, 9 Oct 2026 14:27:41 +0100
Subject: [PATCH] ARM: dts: rockchip: add audio pin groups to rv1126

Add the pin groups of the two-channel I2S controllers and the PDM
microphone interface. The PDM clock and the I2S master clocks need the
iomux routes that the pinctrl driver already carries.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../arm/boot/dts/rockchip/rv1126-pinctrl.dtsi | 228 ++++++++++++++++++
 1 file changed, 228 insertions(+)

--- a/arch/arm/boot/dts/rockchip/rv1126-pinctrl.dtsi
+++ b/arch/arm/boot/dts/rockchip/rv1126-pinctrl.dtsi
@@ -279,6 +279,234 @@
 			<3 RK_PB5 3 &pcfg_pull_none>;
 		};
 	};
