--- /dev/null
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-gop.c
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * GOP / frame-type state machine for the RKVENC v1 encoder.
+ *
+ * One short-term reference, low-delay IDR+P, POC type 0, no B frames.
+ * The slot ping-pong (cur writes, last is the reference; after a good
+ * frame last = cur; cur ^= 1) mirrors the validated lab harness exactly
+ * so the driver produces the same coding structure the hardware was
+ * measured against. A failed frame never commits, so rollback is free.
+ */
+
+#include "rkvenc.h"
+
+void rkvenc_gop_init(struct rkvenc_ctx *ctx)
+{
+	ctx->gop.frames_since_idr = 0;
+	ctx->gop.idr_pic_id = 0;
+	ctx->cur = 0;
+	ctx->last = 0;
+	ctx->last_good_valid = false;
+	ctx->consecutive_errors = 0;
+}
+
+/* Pictures too small for the hardware to code P frames correctly. */
+static bool rkvenc_gop_intra_only(struct rkvenc_ctx *ctx)
+{
+	u32 w16 = ALIGN(ctx->width, 16) / 16;
+	u32 h16 = ALIGN(ctx->height, 16) / 16;
+
+	if (ctx->codec == RKVENC_CODEC_HEVC)
+		return ctx->height <= 64;
+
+	return !((w16 >= 3 && h16 >= 2) || (w16 == 1 && h16 == 1));
+}
+
+/* Decide whether the next frame is an IDR. Called from device_run(). */
+bool rkvenc_gop_is_idr(struct rkvenc_ctx *ctx)
+{
+	struct rkvenc_gop *g = &ctx->gop;
+
+	if (g->frames_since_idr == 0 || rkvenc_gop_intra_only(ctx))
+		return true;
+	if (ctx->c.gop_size && g->frames_since_idr >= ctx->c.gop_size)
+		return true;
+	if (ctx->c.force_keyframe)
+		return true;
+	/* After a recovery with no usable reference, resync with an IDR. */
+	if (!ctx->last_good_valid)
+		return true;
+	return false;
+}
+
+void rkvenc_gop_commit(struct rkvenc_ctx *ctx)
+{
+	struct rkvenc_gop *g = &ctx->gop;
+
+	if (ctx->cur_intra) {
+		g->idr_pic_id++;
+		ctx->last_good = ctx->cur;
+		ctx->last_good_valid = true;
+		/* A new GOP starts; the next (P) frame is #1 of it. */
+		g->frames_since_idr = 1;
+	} else {
+		g->frames_since_idr++;
+	}
+	ctx->last = ctx->cur;
+	ctx->cur ^= 1;
+	ctx->c.force_keyframe = false;
+}
+
+void rkvenc_gop_rollback(struct rkvenc_ctx *ctx)
+{
+	/* The failed frame did not touch the reference slot, so there is
+	 * nothing to undo except to drop the consumed force-key-frame flag.
+	 */
+	ctx->c.force_keyframe = false;
+}
+
+void rkvenc_gop_force_keyframe(struct rkvenc_ctx *ctx)
+{
+	ctx->c.force_keyframe = true;
+}
--- /dev/null
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-h264.c
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * H.264 syntax state and parameter-set generation for the RKVENC v1
+ * encoder. The same struct rkvenc_h264_seq feeds both the hardware
+ * SYNT_* registers (through the engine) and the software SPS/PPS writer,
+ * so the slice header the hardware emits and the SPS/PPS cannot disagree.
+ *
+ * POC type 0, one short-term reference, max_num_ref_frames 1, every intra
+ * picture is an IDR (spec/05 2, 8.2). The parameter sets are cached at
+ * stream configuration and copied (not regenerated) per IDR.
+ */
+
+#include <linux/string.h>
+
+#include "rkvenc.h"
+#include "rkvenc-nal.h"
+
+static const u8 rkvenc_h264_level_idc[] = {
+	10, 11, 11, 12, 13, 20, 21, 22, 30, 31, 32, 40,
+	41, 42, 50, 51, 52, 60, 61, 62,
+};
+
+static u8 rkvenc_h264_level(u32 ctrl)
+{
+	if (ctrl >= ARRAY_SIZE(rkvenc_h264_level_idc))
+		return 62;
+	return rkvenc_h264_level_idc[ctrl];
+}
+
+static u8 rkvenc_h264_profile_idc(u32 ctrl)
+{
+	switch (ctrl) {
+	case V4L2_MPEG_VIDEO_H264_PROFILE_BASELINE:
+	case V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE:
+		return 66;
+	case V4L2_MPEG_VIDEO_H264_PROFILE_MAIN:
+		return 77;
+	case V4L2_MPEG_VIDEO_H264_PROFILE_HIGH:
+	default:
+		return 100;
+	}
+}
+
+/* Build the per-stream SPS/PPS values from the control snapshot. */
+int rkvenc_h264_setup(struct rkvenc_ctx *ctx)
+{
+	struct rkvenc_h264_seq *seq = &ctx->h264_seq;
+
+	memset(seq, 0, sizeof(*seq));
+	seq->width = ctx->width;
+	seq->height = ctx->height;
+	seq->profile_idc = rkvenc_h264_profile_idc(ctx->c.profile);
+	seq->level_idc = rkvenc_h264_level(ctx->c.level);
+	/* Smallest frame-num / POC ranges that exceed any reachable GOP. */
+	seq->log2_max_frame_num_m4 = 4;	/* 2^8 = 256 */
+	seq->log2_max_poc_lsb_m4 = 5;		/* 2^9 = 512 */
+	seq->pic_init_qp = ctx->c.p_frame_qp;
+	seq->chroma_qp_offset = ctx->c.chroma_qp_offset;
+	seq->cabac = ctx->c.cabac && seq->profile_idc != 66;
+	if (ctx->c.profile == V4L2_MPEG_VIDEO_H264_PROFILE_HIGH)
+		seq->transform_8x8 = ctx->c.transform_8x8;
+	seq->dblk_idc = ctx->c.lf_mode;
+	seq->alpha_offset = ctx->c.lf_alpha;
+	seq->beta_offset = ctx->c.lf_beta;
+	seq->timing = true;
+	seq->fps = ctx->fps ?: 30;
+
+	return rkvenc_h264_headers_write(seq, ctx->hdr, RKVENC_HDR_MAX);
+}
+
+/* Copy the cached parameter sets into a capture buffer. */
+int rkvenc_h264_write_headers(struct rkvenc_ctx *ctx, u8 *buf, u32 size)
+{
+	if (ctx->hdr_len > size)
+		return -ENOSPC;
+	memcpy(buf, ctx->hdr, ctx->hdr_len);
+	return ctx->hdr_len;
+}
+
+void rkvenc_h264_build_pic(struct rkvenc_ctx *ctx,
+			   struct rkvenc_h264_pic *pic, bool idr)
+{
+	struct rkvenc_gop *g = &ctx->gop;
+
+	pic->seq = &ctx->h264_seq;
+	pic->nal_ref_idc = idr ? 3 : 2;
+	pic->frame_num = g->frames_since_idr & 0xff;
+	pic->poc_lsb = (2 * g->frames_since_idr) & 0x1ff;
+	pic->idr_pic_id = g->idr_pic_id & 0xffff;
+}
--- /dev/null
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-hevc.c
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * HEVC syntax state and parameter-set generation for the RKVENC v1
+ * encoder. Same discipline as rkvenc-h264.c: one struct rkvenc_hevc_seq
+ * feeds both the engine and the VPS/SPS/PPS writer. Fixed coding
+ * structure of spec/06 1.2: Main profile, one short-term reference, POC
+ * type 0, nal_unit_type 19 for IDR and 1 for P (the reference value;
+ * question Q12 on type 20 is open).
+ */
+
+#include <linux/string.h>
+
+#include "rkvenc.h"
+#include "rkvenc-nal.h"
+
+static const u16 rkvenc_hevc_level_idc[] = {
+	30, 60, 63, 90, 93, 120, 123, 150, 153, 156, 180, 183, 186,
+};
+
+static u16 rkvenc_hevc_level(u32 ctrl)
+{
+	if (ctrl >= ARRAY_SIZE(rkvenc_hevc_level_idc))
+		return 186;
+	return rkvenc_hevc_level_idc[ctrl];
+}
+
+int rkvenc_hevc_setup(struct rkvenc_ctx *ctx)
+{
+	struct rkvenc_hevc_seq *seq = &ctx->hevc_seq;
+
+	memset(seq, 0, sizeof(*seq));
+	seq->width = ctx->width;
+	seq->height = ctx->height;
+	seq->level_idc = rkvenc_hevc_level(ctx->c.level);
+	seq->log2_max_poc_lsb_m4 = 4;	/* 2^8 = 256 */
+	seq->pic_init_qp = ctx->c.p_frame_qp;
+	seq->max_merge_cand = ctx->c.hevc_max_merge ?: 2;
+	seq->sao = ctx->c.hevc_sao;
+	seq->deblock_disabled = ctx->c.lf_mode ==
+				V4L2_MPEG_VIDEO_HEVC_LOOP_FILTER_MODE_DISABLED;
+	seq->beta_offset = ctx->c.hevc_beta_offset;
+	seq->tc_offset = ctx->c.hevc_tc_offset;
+	seq->strong_intra_smoothing = ctx->c.hevc_strong_intra;
+	seq->cabac_init_present = ctx->c.hevc_cabac_init;
+
+	return rkvenc_hevc_headers_write(seq, ctx->hdr, RKVENC_HDR_MAX);
+}
+
+int rkvenc_hevc_write_headers(struct rkvenc_ctx *ctx, u8 *buf, u32 size)
+{
+	if (ctx->hdr_len > size)
+		return -ENOSPC;
+	memcpy(buf, ctx->hdr, ctx->hdr_len);
+	return ctx->hdr_len;
+}
+
+void rkvenc_hevc_build_pic(struct rkvenc_ctx *ctx,
+			   struct rkvenc_hevc_pic *pic, bool idr)
+{
+	pic->seq = &ctx->hevc_seq;
+	pic->nal_unit_type = idr ? 19 : 1;
+	pic->poc_lsb = ctx->gop.frames_since_idr & 0xff;
+}
--- /dev/null
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-nal.c
@@ -0,0 +1,353 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Parameter-set writer for the vepu541 lab harness: H.264 SPS/PPS
+ * (ITU-T H.264 7.3.2) and HEVC VPS/SPS/PPS (ITU-T H.265 7.3.2), with
+ * the fixed coding structure the hardware assumes (spec/05 2, spec/06
+ * 1.2, 2.2, 2.3).
+ */
+
+#include "rkvenc-nal.h"
+
+#define NAL_RBSP_MAX		256
+
+#define H264_NAL_SPS		7
+#define H264_NAL_PPS		8
+#define H264_PROFILE_HIGH	100
+#define HEVC_NAL_VPS		32
+#define HEVC_NAL_SPS		33
+#define HEVC_NAL_PPS		34
+
+struct nal_bw {
+	u8 buf[NAL_RBSP_MAX];
+	u32 bits;
+	bool overflow;
+};
+
+static void bw_put(struct nal_bw *bw, u32 val, u32 bits)
+{
+	u32 i, bit;
+
+	for (i = bits; i > 0; i--) {
+		if (bw->bits >= 8 * NAL_RBSP_MAX) {
+			bw->overflow = true;
+			return;
+		}
+		bit = (val >> (i - 1)) & 1;
+		if (bit)
+			bw->buf[bw->bits / 8] |= 0x80 >> (bw->bits % 8);
+		bw->bits++;
+	}
+}
+
+static void bw_ue(struct nal_bw *bw, u32 val)
+{
+	u32 len = 32 - __builtin_clz(val + 1);
+
+	bw_put(bw, 0, len - 1);
+	bw_put(bw, val + 1, len);
+}
+
+static void bw_se(struct nal_bw *bw, s32 val)
+{
+	bw_ue(bw, val > 0 ? 2 * val - 1 : -2 * val);
+}
+
+static void bw_trailing(struct nal_bw *bw)
+{
+	bw_put(bw, 1, 1);
+	while (bw->bits % 8)
+		bw_put(bw, 0, 1);
+}
+
+/* Start code, NAL header, RBSP with emulation prevention (H.264 7.4.1). */
+static int nal_emit(const struct nal_bw *bw, const u8 *hdr, u32 hdr_len,
+		    u8 *out, u32 size)
+{
+	u32 len = bw->bits / 8, pos = 0, zeros = 0, i;
+
+	if (bw->overflow || size < 4 + hdr_len)
+		return -ENOSPC;
+
+	out[pos++] = 0;
+	out[pos++] = 0;
+	out[pos++] = 0;
+	out[pos++] = 1;
+	for (i = 0; i < hdr_len; i++)
+		out[pos++] = hdr[i];
+
+	for (i = 0; i < len; i++) {
+		if (pos + 2 > size)
+			return -ENOSPC;
+		if (zeros == 2 && bw->buf[i] <= 3) {
+			out[pos++] = 3;
+			zeros = 0;
+		}
+		out[pos++] = bw->buf[i];
+		zeros = bw->buf[i] ? 0 : zeros + 1;
+	}
+
+	return pos;
+}
+
+static void h264_vui_write(struct nal_bw *bw, const struct rkvenc_h264_seq *seq)
+{
+	bw_put(bw, 0, 4);	/* aspect, overscan, video signal, chroma loc */
+	bw_put(bw, seq->timing, 1);
+	if (seq->timing) {
+		bw_put(bw, 1, 32);
+		bw_put(bw, 2 * seq->fps, 32);
+		bw_put(bw, 1, 1);
+	}
+	bw_put(bw, 0, 3);	/* nal hrd, vcl hrd, pic_struct */
+	bw_put(bw, 1, 1);	/* bitstream_restriction_flag */
+	bw_put(bw, 1, 1);
+	bw_ue(bw, 0);
+	bw_ue(bw, 0);
+	bw_ue(bw, 16);
+	bw_ue(bw, 16);
+	bw_ue(bw, 0);		/* max_num_reorder_frames */
+	bw_ue(bw, 1);		/* max_dec_frame_buffering */
+}
+
+static void h264_sps_write(struct nal_bw *bw, const struct rkvenc_h264_seq *seq)
+{
+	u32 w16 = ALIGN(seq->width, 16), h16 = ALIGN(seq->height, 16);
+	bool crop = w16 != seq->width || h16 != seq->height;
+	u32 constraints;
+
+	if (seq->profile_idc == H264_PROFILE_HIGH)
+		constraints = 0;
+	else if (seq->profile_idc == 66)
+		constraints = 0xc0;
+	else
+		constraints = 0x40;
+
+	bw_put(bw, seq->profile_idc, 8);
+	bw_put(bw, constraints, 8);
+	bw_put(bw, seq->level_idc, 8);
+	bw_ue(bw, 0);
+	if (seq->profile_idc == H264_PROFILE_HIGH) {
+		bw_ue(bw, 1);
+		bw_ue(bw, 0);
+		bw_ue(bw, 0);
+		bw_put(bw, 0, 2);
+	}
+	bw_ue(bw, seq->log2_max_frame_num_m4);
+	bw_ue(bw, 0);
+	bw_ue(bw, seq->log2_max_poc_lsb_m4);
+	bw_ue(bw, 1);
+	bw_put(bw, 0, 1);
+	bw_ue(bw, w16 / 16 - 1);
+	bw_ue(bw, h16 / 16 - 1);
+	bw_put(bw, 1, 1);	/* frame_mbs_only_flag */
+	bw_put(bw, 1, 1);	/* direct_8x8_inference_flag */
+	bw_put(bw, crop, 1);
+	if (crop) {
+		bw_ue(bw, 0);
+		bw_ue(bw, (w16 - seq->width) / 2);
+		bw_ue(bw, 0);
+		bw_ue(bw, (h16 - seq->height) / 2);
+	}
+	bw_put(bw, 1, 1);
+	h264_vui_write(bw, seq);
+	bw_trailing(bw);
+}
+
+static void h264_pps_write(struct nal_bw *bw, const struct rkvenc_h264_seq *seq)
+{
+	bw_ue(bw, 0);
+	bw_ue(bw, 0);
+	bw_put(bw, seq->cabac, 1);
+	bw_put(bw, 0, 1);
+	bw_ue(bw, 0);
+	bw_ue(bw, 0);
+	bw_ue(bw, 0);
+	bw_put(bw, 0, 3);	/* weighted_pred_flag, weighted_bipred_idc */
+	bw_se(bw, seq->pic_init_qp - 26);
+	bw_se(bw, 0);
+	bw_se(bw, seq->chroma_qp_offset);
+	bw_put(bw, 1, 1);	/* deblocking_filter_control_present_flag */
+	bw_put(bw, 0, 2);
+	if (seq->transform_8x8) {
+		bw_put(bw, 1, 1); /* transform_8x8_mode_flag */
+		bw_put(bw, 0, 1); /* pic_scaling_matrix_present_flag */
+		bw_se(bw, seq->chroma_qp_offset);
+	}
+	bw_trailing(bw);
+}
+
+int rkvenc_h264_headers_write(const struct rkvenc_h264_seq *seq, u8 *buf,
+			      u32 size)
+{
+	u8 hdr;
+	struct nal_bw bw;
+	int len, pos;
+
+	memset(&bw, 0, sizeof(bw));
+	h264_sps_write(&bw, seq);
+	hdr = 3 << 5 | H264_NAL_SPS;
+	len = nal_emit(&bw, &hdr, 1, buf, size);
+	if (len < 0)
+		return len;
+	pos = len;
+
+	memset(&bw, 0, sizeof(bw));
+	h264_pps_write(&bw, seq);
+	hdr = 3 << 5 | H264_NAL_PPS;
+	len = nal_emit(&bw, &hdr, 1, buf + pos, size - pos);
+	if (len < 0)
+		return len;
+
+	return pos + len;
+}
+
+static void hevc_ptl_write(struct nal_bw *bw, const struct rkvenc_hevc_seq *seq)
+{
+	bw_put(bw, 0, 2);		/* general_profile_space */
+	bw_put(bw, 0, 1);		/* general_tier_flag: Main */
+	bw_put(bw, 1, 5);		/* general_profile_idc: Main */
+	bw_put(bw, 0x60000000, 32);	/* compatible with profiles 1, 2 */
+	bw_put(bw, 1, 1);		/* progressive_source */
+	bw_put(bw, 0, 1);		/* interlaced_source */
+	bw_put(bw, 0, 1);		/* non_packed_constraint */
+	bw_put(bw, 1, 1);		/* frame_only_constraint */
+	bw_put(bw, 0, 32);
+	bw_put(bw, 0, 12);
+	bw_put(bw, seq->level_idc, 8);
+}
+
+static void hevc_vps_write(struct nal_bw *bw, const struct rkvenc_hevc_seq *seq)
+{
+	bw_put(bw, 0, 4);
+	bw_put(bw, 1, 1);
+	bw_put(bw, 1, 1);
+	bw_put(bw, 0, 6);
+	bw_put(bw, 0, 3);
+	bw_put(bw, 1, 1);
+	bw_put(bw, 0xffff, 16);
+	hevc_ptl_write(bw, seq);
+	bw_put(bw, 1, 1);
+	bw_ue(bw, 1);
+	bw_ue(bw, 0);
+	bw_ue(bw, 0);
+	bw_put(bw, 0, 6);
+	bw_ue(bw, 0);
+	bw_put(bw, 0, 1);
+	bw_put(bw, 0, 1);
+	bw_trailing(bw);
+}
+
+static void hevc_sps_write(struct nal_bw *bw, const struct rkvenc_hevc_seq *seq)
+{
+	u32 w8 = ALIGN(seq->width, 8), h8 = ALIGN(seq->height, 8);
+	bool crop = w8 != seq->width || h8 != seq->height;
+
+	bw_put(bw, 0, 4);
+	bw_put(bw, 0, 3);
+	bw_put(bw, 1, 1);
+	hevc_ptl_write(bw, seq);
+	bw_ue(bw, 0);
+	bw_ue(bw, 1);			/* chroma_format_idc 4:2:0 */
+	bw_ue(bw, w8);
+	bw_ue(bw, h8);
+	bw_put(bw, crop, 1);
+	if (crop) {
+		bw_ue(bw, 0);
+		bw_ue(bw, (w8 - seq->width) / 2);
+		bw_ue(bw, 0);
+		bw_ue(bw, (h8 - seq->height) / 2);
+	}
+	bw_ue(bw, 0);
+	bw_ue(bw, 0);
+	bw_ue(bw, seq->log2_max_poc_lsb_m4);
+	bw_put(bw, 1, 1);
+	bw_ue(bw, 1);			/* sps_max_dec_pic_buffering_minus1 */
+	bw_ue(bw, 0);
+	bw_ue(bw, 0);
+	bw_ue(bw, 0);			/* min CU 8x8 */
+	bw_ue(bw, 3);			/* CTU 64x64 */
+	bw_ue(bw, 0);			/* min TU 4x4 */
+	bw_ue(bw, 3);			/* max TU 32x32 */
+	bw_ue(bw, 0);
+	bw_ue(bw, 0);
+	bw_put(bw, 0, 1);		/* scaling_list_enabled_flag */
+	bw_put(bw, 0, 1);		/* amp_enabled_flag */
+	bw_put(bw, seq->sao, 1);
+	bw_put(bw, 0, 1);		/* pcm_enabled_flag */
+	bw_ue(bw, 0);			/* num_short_term_ref_pic_sets */
+	bw_put(bw, 0, 1);		/* long_term_ref_pics_present_flag */
+	bw_put(bw, 0, 1);		/* sps_temporal_mvp_enabled_flag */
+	bw_put(bw, seq->strong_intra_smoothing, 1);
+	bw_put(bw, 0, 1);		/* vui_parameters_present_flag */
+	bw_put(bw, 0, 1);
+	bw_trailing(bw);
+}
+
+static void hevc_pps_write(struct nal_bw *bw, const struct rkvenc_hevc_seq *seq)
+{
+	bw_ue(bw, 0);
+	bw_ue(bw, 0);
+	bw_put(bw, 0, 1);		/* dependent_slice_segments_enabled */
+	bw_put(bw, 0, 1);		/* output_flag_present_flag */
+	bw_put(bw, 0, 3);		/* num_extra_slice_header_bits */
+	bw_put(bw, 0, 1);		/* sign_data_hiding_enabled_flag */
+	bw_put(bw, seq->cabac_init_present, 1);
+	bw_ue(bw, 0);
+	bw_ue(bw, 0);
+	bw_se(bw, seq->pic_init_qp - 26);
+	bw_put(bw, 0, 1);		/* constrained_intra_pred_flag */
+	bw_put(bw, 0, 1);		/* transform_skip_enabled_flag */
+	bw_put(bw, 1, 1);		/* cu_qp_delta_enabled_flag */
+	bw_ue(bw, 0);
+	bw_se(bw, 0);
+	bw_se(bw, 0);
+	bw_put(bw, 0, 1);		/* slice chroma qp offsets */
+	bw_put(bw, 0, 1);		/* weighted_pred_flag */
+	bw_put(bw, 0, 1);		/* weighted_bipred_flag */
+	bw_put(bw, 0, 1);		/* transquant_bypass_enabled_flag */
+	bw_put(bw, 0, 1);		/* tiles_enabled_flag */
+	bw_put(bw, 0, 1);		/* entropy_coding_sync_enabled_flag */
+	bw_put(bw, 0, 1);		/* loop filter across slices */
+	bw_put(bw, 1, 1); /* deblocking_filter_control_present_flag */
+	bw_put(bw, 0, 1); /* deblocking_filter_override_enabled_flag */
+	bw_put(bw, seq->deblock_disabled, 1);
+	if (!seq->deblock_disabled) {
+		bw_se(bw, seq->beta_offset);
+		bw_se(bw, seq->tc_offset);
+	}
+	bw_put(bw, 0, 1);		/* pps_scaling_list_data_present_flag */
+	bw_put(bw, 0, 1);		/* lists_modification_present_flag */
+	bw_ue(bw, 0);
+	bw_put(bw, 0, 1);		/* slice header extension */
+	bw_put(bw, 0, 1);		/* pps_extension_present_flag */
+	bw_trailing(bw);
+}
+
+int rkvenc_hevc_headers_write(const struct rkvenc_hevc_seq *seq, u8 *buf,
+			      u32 size)
+{
+	static const u8 types[] = { HEVC_NAL_VPS, HEVC_NAL_SPS, HEVC_NAL_PPS };
+	struct nal_bw bw;
+	int len, pos;
+	u8 hdr[2];
+	u32 i;
+
+	pos = 0;
+	for (i = 0; i < ARRAY_SIZE(types); i++) {
+		memset(&bw, 0, sizeof(bw));
+		if (types[i] == HEVC_NAL_VPS)
+			hevc_vps_write(&bw, seq);
+		else if (types[i] == HEVC_NAL_SPS)
+			hevc_sps_write(&bw, seq);
+		else
+			hevc_pps_write(&bw, seq);
+		hdr[0] = types[i] << 1;
+		hdr[1] = 1;
+		len = nal_emit(&bw, hdr, 2, buf + pos, size - pos);
+		if (len < 0)
+			return len;
+		pos += len;
+	}
+
+	return pos;
+}
