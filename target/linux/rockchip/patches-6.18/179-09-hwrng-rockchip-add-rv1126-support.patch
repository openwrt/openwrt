From 9cda4c95fe478a9326ba39771ddccf46dfed2c36 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Sat, 10 Oct 2026 12:00:09 +0100
Subject: [PATCH] hwrng: rockchip: add rv1126 support

The TRNG in the RV1126 crypto block uses the RK3568 register layout:
the control, sample counter and data registers behave as they do on
the RK3568, and START clears itself when 32 bytes are ready. Its
register window starts at the control register, so the offset of the
registers within the window becomes part of the SoC data, and the
RK3568 operations are reused for the new compatible.

The block is shared with the secure world, so the driver must not
pulse a reset line it cannot coordinate with it; the reset is
optional for this compatible.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 drivers/char/hw_random/rockchip-rng.c | 32 ++++++++++++++++++++-------
 1 file changed, 24 insertions(+), 8 deletions(-)

--- a/drivers/char/hw_random/rockchip-rng.c
+++ b/drivers/char/hw_random/rockchip-rng.c
@@ -37,9 +37,9 @@
 /* after how many bytes of output TRNGv1 implementations should be reseeded */
 #define RK_TRNG_V1_AUTO_RESEED_CNT	16000
 
-/* TRNG registers from RK3568 TRM-Part2, section 5.4.1 */
+/* TRNG registers from RK3568 TRM-Part2, section 5.4.1, from trng_offset */
 #define TRNG_RST_CTL			0x0004
-#define TRNG_RNG_CTL			0x0400
+#define TRNG_RNG_CTL			0x0000
 #define TRNG_RNG_CTL_LEN_64_BIT		(0x00 << 4)
 #define TRNG_RNG_CTL_LEN_128_BIT	(0x01 << 4)
 #define TRNG_RNG_CTL_LEN_192_BIT	(0x02 << 4)
@@ -51,8 +51,8 @@
 #define TRNG_RNG_CTL_MASK		GENMASK(15, 0)
 #define TRNG_RNG_CTL_ENABLE		BIT(1)
 #define TRNG_RNG_CTL_START		BIT(0)
-#define TRNG_RNG_SAMPLE_CNT		0x0404
-#define TRNG_RNG_DOUT			0x0410
+#define TRNG_RNG_SAMPLE_CNT		0x0004
+#define TRNG_RNG_DOUT			0x0010
 
 /*
  * TRNG V1 register definitions
@@ -136,12 +136,18 @@ struct rk_rng_soc_data {
 	void (*rk_rng_cleanup)(struct hwrng *rng);
 	unsigned short quality;
 	bool reset_optional;
+	u32 trng_offset;
 };
 
+static inline void __iomem *rk_rng_trng(struct rk_rng *rng, u32 offset)
+{
+	return rng->base + rng->soc_data->trng_offset + offset;
+}
+
 /* The mask in the upper 16 bits determines the bits that are updated */
 static void rk_rng_write_ctl(struct rk_rng *rng, u32 val, u32 mask)
 {
-	writel((mask << 16) | val, rng->base + TRNG_RNG_CTL);
+	writel((mask << 16) | val, rk_rng_trng(rng, TRNG_RNG_CTL));
 }
 
 static inline void rk_rng_writel(struct rk_rng *rng, u32 val, u32 offset)
@@ -177,7 +183,7 @@ static int rk3568_rng_init(struct hwrng
 		return ret;
 
 	/* set the sample period */
-	writel(RK_RNG_SAMPLE_CNT, rk_rng->base + TRNG_RNG_SAMPLE_CNT);
+	writel(RK_RNG_SAMPLE_CNT, rk_rng_trng(rk_rng, TRNG_RNG_SAMPLE_CNT));
 
 	/* set osc ring speed and enable it */
 	rk_rng_write_ctl(rk_rng, TRNG_RNG_CTL_LEN_256_BIT |
@@ -213,7 +219,7 @@ static int rk3568_rng_read(struct hwrng
 	/* Start collecting random data */
 	rk_rng_write_ctl(rk_rng, TRNG_RNG_CTL_START, TRNG_RNG_CTL_START);
 
-	ret = readl_poll_timeout(rk_rng->base + TRNG_RNG_CTL, reg,
+	ret = readl_poll_timeout(rk_rng_trng(rk_rng, TRNG_RNG_CTL), reg,
 				 !(reg & TRNG_RNG_CTL_START),
 				 RK_RNG_POLL_PERIOD_US,
 				 RK_RNG_POLL_TIMEOUT_US);
@@ -221,7 +227,7 @@ static int rk3568_rng_read(struct hwrng
 		goto out;
 
 	/* Read random data stored in the registers */
-	memcpy_fromio(buf, rk_rng->base + TRNG_RNG_DOUT, to_read);
+	memcpy_fromio(buf, rk_rng_trng(rk_rng, TRNG_RNG_DOUT), to_read);
 out:
 	pm_runtime_put_sync_autosuspend(rk_rng->dev);
 
@@ -364,6 +370,15 @@ static const struct rk_rng_soc_data rk35
 	.rk_rng_cleanup = rk3568_rng_cleanup,
 	.quality = 900,
 	.reset_optional = false,
+	.trng_offset = 0x400,
+};
+
+static const struct rk_rng_soc_data rv1126_soc_data = {
+	.rk_rng_init = rk3568_rng_init,
+	.rk_rng_read = rk3568_rng_read,
+	.rk_rng_cleanup = rk3568_rng_cleanup,
+	.quality = 900,
+	.reset_optional = true,
 };
 
 static const struct rk_rng_soc_data rk3576_soc_data = {
@@ -468,6 +483,7 @@ static const struct of_device_id rk_rng_
 	{ .compatible = "rockchip,rk3568-rng", .data = (void *)&rk3568_soc_data },
 	{ .compatible = "rockchip,rk3576-rng", .data = (void *)&rk3576_soc_data },
 	{ .compatible = "rockchip,rk3588-rng", .data = (void *)&rk3588_soc_data },
+	{ .compatible = "rockchip,rv1126-rng", .data = (void *)&rv1126_soc_data },
 	{ /* sentinel */ },
 };
 
