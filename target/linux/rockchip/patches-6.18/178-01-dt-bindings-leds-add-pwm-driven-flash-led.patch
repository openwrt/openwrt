From 57b2f706ae5c94b511b308aca6ef7e077db78aee Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Sat, 10 Oct 2026 10:57:43 +0100
Subject: [PATCH] dt-bindings: leds: add PWM driven flash LED

Describe a flash LED whose brightness is set by the duty cycle of one
PWM channel, as found on camera modules that drive their illumination
straight from an SoC PWM output. The LED child node carries the
torch and flash current limits and the flash timeout; the duty cycle
scales linearly with the requested intensity up to those limits.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../bindings/leds/leds-pwm-flash.yaml         | 58 +++++++++++++++++++
 1 file changed, 58 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/leds/leds-pwm-flash.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/leds-pwm-flash.yaml
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/leds-pwm-flash.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Flash LED driven by a PWM channel
+
+maintainers:
+  - Daniel Golle <daniel@makrotopia.org>
+
+description:
+  A flash LED, or a group of LEDs sharing one driver stage, whose brightness
+  is set by the duty cycle of a single PWM channel. The LED supports torch
+  and strobe operation. The driver scales the brightness linearly with the
+  duty cycle, so the current properties of the LED node give the intensity
+  that corresponds to a duty cycle of 100 percent.
+
+properties:
+  compatible:
+    const: pwm-flash-led
+
+  pwms:
+    maxItems: 1
+
+  led:
+    type: object
+    $ref: common.yaml#
+    unevaluatedProperties: false
+
+    required:
+      - led-max-microamp
+      - flash-max-microamp
+      - flash-max-timeout-us
+
+required:
+  - compatible
+  - pwms
+  - led
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/leds/common.h>
+
+    led-controller {
+        compatible = "pwm-flash-led";
+        pwms = <&pwm3 0 25000 0>;
+
+        led {
+            function = LED_FUNCTION_FLASH;
+            color = <LED_COLOR_ID_WHITE>;
+            led-max-microamp = <20000>;
+            flash-max-microamp = <20000>;
+            flash-max-timeout-us = <1000000>;
+        };
+    };
