From e1d5d05dd04edb095920d27074dcedba4cd65ec4 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Fri, 9 Oct 2026 14:06:36 +0100
Subject: [PATCH] dt-bindings: thermal: rockchip: add rv1126

The RV1126 has two TSADC instances for the CPU and the NPU. Each one
needs the general register files and takes a third clock that feeds
its analog front end, named phy_clk.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../bindings/thermal/rockchip-thermal.yaml    | 23 ++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

--- a/Documentation/devicetree/bindings/thermal/rockchip-thermal.yaml
+++ b/Documentation/devicetree/bindings/thermal/rockchip-thermal.yaml
@@ -24,6 +24,7 @@ properties:
       - rockchip,rk3576-tsadc
       - rockchip,rk3588-tsadc
       - rockchip,rv1108-tsadc
+      - rockchip,rv1126-tsadc
 
   reg:
     maxItems: 1
@@ -33,12 +34,14 @@ properties:
 
   clocks:
     minItems: 2
-    maxItems: 2
+    maxItems: 3
 
   clock-names:
+    minItems: 2
     items:
       - const: tsadc
       - const: apb_pclk
+      - const: phy_clk
 
   nvmem-cells:
     items:
@@ -128,6 +131,7 @@ allOf:
               - rockchip,rk3366-tsadc
               - rockchip,rk3399-tsadc
               - rockchip,rk3568-tsadc
+              - rockchip,rv1126-tsadc
     then:
       required:
         - rockchip,grf
@@ -135,6 +139,23 @@ allOf:
       properties:
         rockchip,grf: false
   - if:
+      properties:
+        compatible:
+          contains:
+            const: rockchip,rv1126-tsadc
+    then:
+      properties:
+        clocks:
+          minItems: 3
+        clock-names:
+          minItems: 3
+    else:
+      properties:
+        clocks:
+          maxItems: 2
+        clock-names:
+          maxItems: 2
+  - if:
       not:
         properties:
           compatible:
