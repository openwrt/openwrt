From 843edeaaa74c096400be2f0985922e1608859ef7 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Fri, 9 Oct 2026 14:18:03 +0100
Subject: [PATCH] media: rockchip: rkcif: add rv1126 vicap and lite support

The MIPI CSI-2 capture block of the RV1126 VICAP and VICAP Lite uses
the same register layout, interrupt bits and control word as the one
of the RK3568 VICAP, so both reuse its match data. They differ from
the RK3568 in their clock set, which lacks the interface clock.

Only the MIPI CSI-2 path is described. The DVP of the VICAP is not
handled by the driver.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../media/platform/rockchip/rkcif/rkcif-dev.c | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

--- a/drivers/media/platform/rockchip/rkcif/rkcif-dev.c
+++ b/drivers/media/platform/rockchip/rkcif/rkcif-dev.c
@@ -53,6 +53,18 @@ static const struct rkcif_match_data rk3
 	.mipi = &rkcif_rk3568_vicap_mipi_match_data,
 };
 
+static const char *const rv1126_vicap_clks[] = {
+	"aclk",
+	"hclk",
+	"dclk",
+};
+
+static const struct rkcif_match_data rv1126_vicap_match_data = {
+	.clks = rv1126_vicap_clks,
+	.clks_num = ARRAY_SIZE(rv1126_vicap_clks),
+	.mipi = &rkcif_rk3568_vicap_mipi_match_data,
+};
+
 static const char *const rk3588_vicap_clks[] = {
 	"aclk",
 	"hclk",
@@ -80,6 +92,14 @@ static const struct of_device_id rkcif_p
 		.compatible = "rockchip,rk3588-vicap",
 		.data = &rk3588_vicap_match_data,
 	},
+	{
+		.compatible = "rockchip,rv1126-vicap",
+		.data = &rv1126_vicap_match_data,
+	},
+	{
+		.compatible = "rockchip,rv1126-vicap-lite",
+		.data = &rv1126_vicap_match_data,
+	},
 	{}
 };
 MODULE_DEVICE_TABLE(of, rkcif_plat_of_match);
