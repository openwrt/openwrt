From ae949f60fcd90d49b445a69d1ee184c5d6c5f249 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sun, 30 Aug 2026 10:10:52 +0200
Subject: [PATCH 2/6] ARM: dts: rockchip: rv1106: Add default pinctrl to
 emmc/sdmmc/sfc

Suggested by Jonas Karlman. The SARADC inputs are dedicated pins, so
there's no pin group to reference there.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 arch/arm/boot/dts/rockchip/rv1106.dtsi | 6 ++++++
 1 file changed, 6 insertions(+)

--- a/arch/arm/boot/dts/rockchip/rv1106.dtsi
+++ b/arch/arm/boot/dts/rockchip/rv1106.dtsi
@@ -696,6 +696,8 @@
 			clock-names = "biu", "ciu", "ciu-drive", "ciu-sample";
 			fifo-depth = <0x100>;
 			max-frequency = <200000000>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&emmc_clk &emmc_cmd &emmc_bus8>;
 			status = "disabled";
 		};
 
@@ -708,6 +710,8 @@
 			clock-names = "biu", "ciu", "ciu-drive", "ciu-sample";
 			fifo-depth = <0x100>;
 			max-frequency = <200000000>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
 			status = "disabled";
 		};
 
@@ -717,6 +721,8 @@
 			interrupts = <GIC_SPI 53 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&cru SCLK_SFC>, <&cru HCLK_SFC>;
 			clock-names = "clk_sfc", "hclk_sfc";
+			pinctrl-names = "default";
+			pinctrl-0 = <&fspi_pins &fspi_cs0>;
 			#address-cells = <1>;
 			#size-cells = <0>;
 			status = "disabled";
