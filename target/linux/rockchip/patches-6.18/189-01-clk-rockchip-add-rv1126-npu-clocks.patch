From d1c07ea077dd248d8d561e12f04dfb1a16eec9e5 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Mon, 19 Oct 2026 23:19:37 +0100
Subject: [PATCH 1/3] clk: rockchip: Add RV1126 NPU clocks

Register the NPU bus, core and PVTM clocks using the RV1126 register
layout. Model each shared parent mux once so its integer and
half-integer divider paths keep a consistent parent.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 drivers/clk/rockchip/clk-rv1126.c | 52 +++++++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)

--- a/drivers/clk/rockchip/clk-rv1126.c
+++ b/drivers/clk/rockchip/clk-rv1126.c
@@ -192,6 +192,9 @@ PNAME(mux_rgmii_clk_p)			= { "clk_gmac_t
 PNAME(mux_rmii_clk_p)			= { "clk_gmac_rx_div20", "clk_gmac_rx_div2" };
 PNAME(mux_gmac_tx_rx_p)			= { "rgmii_mode_clk", "rmii_mode_clk" };
 PNAME(mux_dpll_gpll_p)			= { "dpll", "gpll" };
+PNAME(mux_gpll_cpll_apll_hpll_p)	= { "gpll", "cpll", "apll", "hpll" };
+PNAME(mux_aclk_pdnpu_p)			= { "aclk_pdnpu_div", "aclk_pdnpu_np5" };
+PNAME(mux_clk_npu_p)			= { "clk_npu_div", "clk_npu_np5" };
 
 static u32 rgmii_mux_idx[]		= { 2, 3, 0, 1 };
 
@@ -1055,6 +1058,55 @@ static struct rockchip_clk_branch rv1126
 			RV1126_CLKSEL_CON(61), 15, 1, MFLAGS, 8, 5, DFLAGS,
 			RV1126_CLKGATE_CON(20), 11, GFLAGS),
 
+	MUX(0, "aclk_pdnpu_src", mux_gpll_cpll_apll_hpll_p, 0,
+	    RV1126_CLKSEL_CON(65), 8, 2, MFLAGS),
+	COMPOSITE_NOMUX(ACLK_PDNPU_DIV, "aclk_pdnpu_div", "aclk_pdnpu_src",
+		       CLK_SET_RATE_PARENT,
+		       RV1126_CLKSEL_CON(65), 0, 4, DFLAGS,
+		       RV1126_CLKGATE_CON(22), 0, GFLAGS),
+	COMPOSITE_NOMUX_HALFDIV(ACLK_PDNPU_NP5, "aclk_pdnpu_np5",
+			      "aclk_pdnpu_src", CLK_SET_RATE_PARENT,
+			      RV1126_CLKSEL_CON(65), 4, 4, DFLAGS,
+			      RV1126_CLKGATE_CON(22), 1, GFLAGS),
+	MUX(ACLK_PDNPU, "aclk_pdnpu", mux_aclk_pdnpu_p,
+	    CLK_SET_RATE_PARENT | CLK_OPS_PARENT_ENABLE,
+	    RV1126_CLKSEL_CON(65), 12, 1, MFLAGS),
+	COMPOSITE_NOMUX(HCLK_PDNPU, "hclk_pdnpu", "gpll", 0,
+		       RV1126_CLKSEL_CON(66), 8, 4, DFLAGS,
+		       RV1126_CLKGATE_CON(22), 2, GFLAGS),
+	COMPOSITE_NOMUX(PCLK_PDNPU, "pclk_pdnpu", "hclk_pdnpu", 0,
+		       RV1126_CLKSEL_CON(66), 0, 5, DFLAGS,
+		       RV1126_CLKGATE_CON(22), 3, GFLAGS),
+	GATE(0, "aclk_pdnpu_niu", "aclk_pdnpu", CLK_IGNORE_UNUSED,
+	     RV1126_CLKGATE_CON(22), 4, GFLAGS),
+	GATE(0, "hclk_pdnpu_niu", "hclk_pdnpu", CLK_IGNORE_UNUSED,
+	     RV1126_CLKGATE_CON(22), 5, GFLAGS),
+	GATE(0, "pclk_pdnpu_niu", "pclk_pdnpu", CLK_IGNORE_UNUSED,
+	     RV1126_CLKGATE_CON(22), 6, GFLAGS),
+	GATE(ACLK_NPU, "aclk_npu", "aclk_pdnpu", 0,
+	     RV1126_CLKGATE_CON(22), 7, GFLAGS),
+	GATE(HCLK_NPU, "hclk_npu", "hclk_pdnpu", 0,
+	     RV1126_CLKGATE_CON(22), 8, GFLAGS),
+	MUX(0, "clk_npu_src", mux_gpll_cpll_apll_hpll_p, 0,
+	    RV1126_CLKSEL_CON(67), 8, 2, MFLAGS),
+	COMPOSITE_NOMUX(CLK_NPU_DIV, "clk_npu_div", "clk_npu_src",
+		       CLK_SET_RATE_PARENT,
+		       RV1126_CLKSEL_CON(67), 0, 4, DFLAGS,
+		       RV1126_CLKGATE_CON(22), 9, GFLAGS),
+	COMPOSITE_NOMUX_HALFDIV(CLK_NPU_NP5, "clk_npu_np5", "clk_npu_src",
+			      CLK_SET_RATE_PARENT,
+			      RV1126_CLKSEL_CON(67), 4, 4, DFLAGS,
+			      RV1126_CLKGATE_CON(22), 10, GFLAGS),
+	MUX(CLK_CORE_NPU, "clk_core_npu", mux_clk_npu_p,
+	    CLK_SET_RATE_PARENT | CLK_OPS_PARENT_ENABLE,
+	    RV1126_CLKSEL_CON(67), 12, 1, MFLAGS),
+	GATE(PCLK_NPUPVTM, "pclk_npupvtm", "pclk_pdnpu", CLK_IGNORE_UNUSED,
+	     RV1126_CLKGATE_CON(22), 12, GFLAGS),
+	GATE(CLK_NPUPVTM, "clk_npupvtm", "xin24m", 0,
+	     RV1126_CLKGATE_CON(22), 13, GFLAGS),
+	GATE(CLK_CORE_NPUPVTM, "clk_core_npupvtm", "clk_core_npu",
+	     CLK_IGNORE_UNUSED, RV1126_CLKGATE_CON(22), 14, GFLAGS),
+
 	/*
 	 * Clock-Architecture Diagram 15
 	 */
