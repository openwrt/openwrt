@@ -23,6 +23,7 @@
 #define CIF_MIN_HEIGHT	 64
 #define CIF_MAX_WIDTH	 8192
 #define CIF_MAX_HEIGHT	 8192
+#define RKCIF_TOISP_BUFS 4
 
 static inline struct rkcif_buffer *to_rkcif_buffer(struct vb2_v4l2_buffer *vb)
 {
@@ -71,6 +72,19 @@ static void rkcif_stream_complete_buffer
 {
 	struct vb2_v4l2_buffer *vb = &buffer->vb;
 
+	if (stream->toisp.ops) {
+		struct rkcif_toisp_frame frame = {
+			.addr = buffer->buff_addr[RKCIF_PLANE_Y],
+			.sgt = &stream->toisp.sgts[buffer - stream->toisp.bufs],
+			.timestamp = ktime_get_ns(),
+			.sequence = stream->frame_idx++,
+			.cookie = buffer,
+		};
+
+		stream->toisp.ops->frame(stream->toisp.priv, &frame);
+		return;
+	}
+
 	vb->vb2_buf.timestamp = ktime_get_ns();
 	vb->sequence = stream->frame_idx;
 	vb2_buffer_done(&vb->vb2_buf, VB2_BUF_STATE_DONE);
@@ -150,6 +164,14 @@ static void rkcif_stream_return_all_buff
 {
 	struct rkcif_buffer *buffer;
 
