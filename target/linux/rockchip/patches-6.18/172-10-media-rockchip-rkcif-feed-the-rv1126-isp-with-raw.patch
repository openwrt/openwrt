+/* one 16-bit format serves both sample depths, so the bus code picks */
+static const struct rkcif_output_fmt *
+rkcif_mipi_find_output_fmt(struct rkcif_stream *stream)
+{
+	const struct rkcif_output_fmt *fmt;
+	struct v4l2_subdev_state *state;
+	struct v4l2_mbus_framefmt *mf;
+	unsigned int i;
+	u32 code = 0;
+
+	state = v4l2_subdev_lock_and_get_active_state(&stream->interface->sd);
+	mf = v4l2_subdev_state_get_format(state, RKCIF_IF_PAD_SRC, stream->id);
+	if (mf)
+		code = mf->code;
+	v4l2_subdev_unlock_state(state);
+
+	for (i = 0; i < stream->out_fmts_num; i++) {
+		fmt = &stream->out_fmts[i];
+		if (fmt->fourcc == stream->pix.pixelformat &&
+		    fmt->mbus_code == code)
+			return fmt;
+	}
+
+	return NULL;
+}
+
 static int rkcif_mipi_start_streaming(struct rkcif_stream *stream)
 {
 	struct rkcif_interface *interface = stream->interface;
@@ -728,8 +846,7 @@ static int rkcif_mipi_start_streaming(st
 
 	state = v4l2_subdev_lock_and_get_active_state(&interface->sd);
 
-	active_out_fmt = rkcif_stream_find_output_fmt(stream, false,
-						      stream->pix.pixelformat);
+	active_out_fmt = rkcif_mipi_find_output_fmt(stream);
 	if (!active_out_fmt)
 		goto out;
 
