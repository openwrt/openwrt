From 8ca4caacd039bba6d53d3c578fbcf21b6a2fbff2 Mon Sep 17 00:00:00 2001
From: Liangbin Lian <jjm2473@gmail.com>
Date: Wed, 24 Sep 2025 20:08:13 +0800
Subject: [PATCH] arm64: dts: rockchip: easepi-r1: add LED aliases

Add the LED aliases used by OpenWrt to indicate the boot, failsafe,
running and upgrade states to the device tree of the LinkEase EasePi R1.
---
--- a/arch/arm64/boot/dts/rockchip/rk3568-easepi-r1.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3568-easepi-r1.dts
@@ -17,6 +17,11 @@
 		ethernet0 = &gmac0;
 		ethernet1 = &gmac1;
 		mmc0 = &sdhci;
+
+		led-boot     = &status_led;
+		led-failsafe = &status_led;
+		led-running  = &status_led;
+		led-upgrade  = &status_led;
 	};
 
 	chosen: chosen {
