From 570a682950ac44154fcce078d381033f919b8483 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Thu, 5 Nov 2026 00:42:34 +0000
Subject: [PATCH] media: rockchip: rkisp2: Add the gain map params block

Along with each frame the ISP writes the ISPP a map of the gain applied
to every 4x8 pixel block, which the ISPP TNR and NR scale their noise
model with. Its gain module is never programmed, so with the control
register at its reset value of zero every map entry is zero.

Add a params block carrying the exposure gains of the module. A map
entry is 16 times the square root of the block gain: the exposure gain
times the lens shading gain, which is unity with the LSC off, and the
WDR tone gain while the WDR block is enabled, so the driver selects the
LSC contribution always and the WDR one from the block state. The index
and noise tables of the module serve only the dehaze and TMO paths and
keep their reset values.

Assisted-by: LLM
Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../platform/rockchip/rkisp2/rkisp2-params.c  | 32 +++++++++++++++++++
 .../rockchip/rkisp2/rkisp2-regs-v2x.h         |  7 ++++
 .../uapi/linux/media/rockchip/rkisp2-config.h | 30 ++++++++++++++++-
 3 files changed, 68 insertions(+), 1 deletion(-)

--- a/drivers/media/platform/rockchip/rkisp2/rkisp2-params.c
+++ b/drivers/media/platform/rockchip/rkisp2/rkisp2-params.c
@@ -54,6 +54,7 @@ union rkisp2_params_block {
 	const struct rkisp2_params_dpcc *dpcc;
 	const struct rkisp2_params_cproc *cproc;
 	const struct rkisp2_params_wdr *wdr;
+	const struct rkisp2_params_gain *gain;
 	const __u8 *data;
 };
 
@@ -85,6 +86,8 @@ static void rkisp2_params_cproc(struct r
 				union rkisp2_params_block block);
 static void rkisp2_params_wdr(struct rkisp2_params *params,
 			      union rkisp2_params_block block);
+static void rkisp2_params_gain(struct rkisp2_params *params,
+			       union rkisp2_params_block block);
 
 typedef void (*rkisp2_params_handler)(struct rkisp2_params *params,
 				      const union rkisp2_params_block block);
@@ -118,6 +121,7 @@ rkisp2_params_handlers[] = {
 	RKISP2_PARAMS_BLOCK_HANDLER_INFO(DPCC, dpcc, PRE),
 	RKISP2_PARAMS_BLOCK_HANDLER_INFO(CPROC, cproc, PRE),
 	RKISP2_PARAMS_BLOCK_HANDLER_INFO(WDR, wdr, PRE),
+	RKISP2_PARAMS_BLOCK_HANDLER_INFO(GAIN, gain, PRE),
 };
 
 static const struct v4l2_isp_params_block_type_info
@@ -138,6 +142,7 @@ static const struct v4l2_isp_params_bloc
 		RKISP2_PARAMS_BLOCK_INFO(DPCC, dpcc),
 		RKISP2_PARAMS_BLOCK_INFO(CPROC, cproc),
 		RKISP2_PARAMS_BLOCK_INFO(WDR, wdr),
+		RKISP2_PARAMS_BLOCK_INFO(GAIN, gain),
 	};
 
 static_assert(ARRAY_SIZE(rkisp2_params_handlers) ==
@@ -989,6 +994,33 @@ static void rkisp2_params_wdr(struct rki
 	rkisp2_write(params->rkisp2, ISP_WDR_CTRL0, arg->ctrl0 | ISP_WDR_EN);
 }
 
+static void rkisp2_params_gain(struct rkisp2_params *params,
+			       union rkisp2_params_block block)
+{
+	const struct rkisp2_params_gain *arg = block.gain;
+	struct rkisp2_device *rkisp2 = params->rkisp2;
+	u32 ctrl;
+
+	if (block.header->flags & V4L2_ISP_PARAMS_FL_BLOCK_DISABLE) {
+		rkisp2_write(rkisp2, ISP_GAIN_CTRL, 0);
+		return;
+	}
+
+	if (!(block.header->flags & V4L2_ISP_PARAMS_FL_BLOCK_ENABLE))
+		return;
+
+	rkisp2_write(rkisp2, ISP_GAIN_G0, arg->gain[0] & ISP_GAIN_G0_MASK);
+	rkisp2_write(rkisp2, ISP_GAIN_G1_G2,
+		     (arg->gain[2] & ISP_GAIN_G12_MASK) << 16 |
+			     (arg->gain[1] & ISP_GAIN_G12_MASK));
+
+	/* the LSC gain is unity while the LSC is off */
+	ctrl = ISP_GAIN_LSC_EN;
+	if (rkisp2_read(rkisp2, ISP_WDR_CTRL0) & ISP_WDR_EN)
+		ctrl |= ISP_GAIN_WDR_EN;
+	rkisp2_write(rkisp2, ISP_GAIN_CTRL, ctrl);
+}
+
 static void rkisp2_params_configure(struct rkisp2_params *params,
 				    struct rkisp2_params_buffer *buf,
 				    enum rkisp2_params_configure_priority prio)
--- a/drivers/media/platform/rockchip/rkisp2/rkisp2-regs-v2x.h
+++ b/drivers/media/platform/rockchip/rkisp2/rkisp2-regs-v2x.h
@@ -2526,6 +2526,13 @@
 /* ISP_WDR_CTRL0 */
 #define ISP_WDR_EN BIT(0)
 
+/* GAIN */
+/* ISP_GAIN_CTRL */
+#define ISP_GAIN_LSC_EN BIT(4)
+#define ISP_GAIN_WDR_EN BIT(12)
+#define ISP_GAIN_G0_MASK GENMASK(17, 0)
+#define ISP_GAIN_G12_MASK GENMASK(13, 0)
+
 /* CCM */
 /* ISP_CCM_CTRL */
 #define ISP_CCM_EN			BIT(0)
--- a/include/uapi/linux/media/rockchip/rkisp2-config.h
+++ b/include/uapi/linux/media/rockchip/rkisp2-config.h
@@ -231,6 +231,7 @@ struct rkisp2_stats_awb_mean {
  * @RKISP2_PARAMS_BLOCK_DPCC: Defect pixel cluster correction config
  * @RKISP2_PARAMS_BLOCK_CPROC: Color processing config
  * @RKISP2_PARAMS_BLOCK_WDR: Wide dynamic range config
+ * @RKISP2_PARAMS_BLOCK_GAIN: Gain map config
  */
 enum rkisp2_params_block_type {
 	RKISP2_PARAMS_BLOCK_BLS,
@@ -249,6 +250,7 @@ enum rkisp2_params_block_type {
 	RKISP2_PARAMS_BLOCK_DPCC,
 	RKISP2_PARAMS_BLOCK_CPROC,
 	RKISP2_PARAMS_BLOCK_WDR,
+	RKISP2_PARAMS_BLOCK_GAIN,
 };
 
 /* DPCC: three method sets, each with a green and a red/blue variant */
@@ -879,6 +881,32 @@ struct rkisp2_params_wdr {
 	__u32 coe_off;
 } __attribute__((aligned(8)));
 
+/* gain map: three exposure gains, as in the HDR merge */
+#define RKISP2_ISP_GAIN_NUM 3
+
+/**
+ * struct rkisp2_params_gain - RkISP2 params gain map config
+ *
+ * RkISP2 parameters gain map configuration block. With each frame the ISP
+ * hands to the ISPP it writes a map of the gain applied to every 4x8 pixel
+ * block, which the ISPP temporal and spatial noise reduction scale their noise
+ * model with. A map entry is 16 times the square root of the block gain: the
+ * exposure gain below, times the lens shading gain and, with the WDR block
+ * enabled, its local tone gain. Identified by
+ * :c:type:`RKISP2_PARAMS_BLOCK_GAIN`.
+ *
+ * Without the block enabled the ISP writes a map of zeros.
+ *
+ * @header: The RkISP2 parameters block header
+ * @gain: Exposure gain in 12.6 fixed point, for the long, middle and short
+ *	  exposures of an HDR merge; a linear exposure sets all three. The
+ *	  first holds 18 bits, the other two 14 bits.
+ */
+struct rkisp2_params_gain {
+	struct v4l2_isp_params_block_header header;
+	__u32 gain[RKISP2_ISP_GAIN_NUM];
+} __attribute__((aligned(8)));
+
 #define RKISP2_PARAMS_MAX_SIZE                                                 \
 	(sizeof(struct rkisp2_params_bls) +                                    \
 	 sizeof(struct rkisp2_params_awb_gains) +                              \
@@ -891,7 +919,7 @@ struct rkisp2_params_wdr {
 	 sizeof(struct rkisp2_params_awb_meas) +                               \
 	 sizeof(struct rkisp2_params_dpcc) +                                   \
 	 sizeof(struct rkisp2_params_cproc) +                                  \
-	 sizeof(struct rkisp2_params_wdr))
+	 sizeof(struct rkisp2_params_wdr) + sizeof(struct rkisp2_params_gain))
 
 /*---------- ISPP (image post-processing) ------------*/
 
