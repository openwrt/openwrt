From 9885264ddf12c6454c00e050d767b115e5a24700 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Sat, 10 Oct 2026 11:53:34 +0100
Subject: [PATCH] dt-bindings: crypto: rockchip: add the RV1126 Crypto V2

The RV1126 has the same Crypto V2 block as the RK3568 and RK3588. It
needs the core, AXI and AHB clocks and the power domain, and has no
reset line in the description, because the driver resets the cipher
core through the block's own reset register. The reset stays required
for the RK3568 and RK3588.

The clock names are core, aclk and hclk, which is what the existing
device trees use, and the register window ends before the TRNG, which
is described by its own node.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../crypto/rockchip,rk3588-crypto.yaml        | 64 +++++++++++++------
 1 file changed, 46 insertions(+), 18 deletions(-)

--- a/Documentation/devicetree/bindings/crypto/rockchip,rk3588-crypto.yaml
+++ b/Documentation/devicetree/bindings/crypto/rockchip,rk3588-crypto.yaml
@@ -4,16 +4,23 @@
 $id: http://devicetree.org/schemas/crypto/rockchip,rk3588-crypto.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Rockchip cryptographic offloader V2
+title: Rockchip Crypto V2 cryptographic offloader
 
 maintainers:
   - Corentin Labbe <clabbe@baylibre.com>
+  - Daniel Golle <daniel@makrotopia.org>
+
+description:
+  The Crypto V2 block of Rockchip SoCs offers AES, DES, SM4 and hash
+  operations through a DMA descriptor list. The TRNG of the same block is
+  described by its own node.
 
 properties:
   compatible:
     enum:
       - rockchip,rk3568-crypto
       - rockchip,rk3588-crypto
+      - rockchip,rv1126-crypto
 
   reg:
     maxItems: 1
@@ -22,16 +29,22 @@ properties:
     maxItems: 1
 
   clocks:
-    minItems: 3
+    items:
+      - description: Crypto core clock
+      - description: AXI clock
+      - description: AHB clock
 
   clock-names:
     items:
       - const: core
-      - const: a
-      - const: h
+      - const: aclk
+      - const: hclk
+
+  power-domains:
+    maxItems: 1
 
   resets:
-    minItems: 1
+    maxItems: 1
 
   reset-names:
     items:
@@ -43,23 +56,38 @@ required:
   - interrupts
   - clocks
   - clock-names
-  - resets
-  - reset-names
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - rockchip,rk3568-crypto
+              - rockchip,rk3588-crypto
+    then:
+      required:
+        - resets
+        - reset-names
+    else:
+      properties:
+        resets: false
+        reset-names: false
 
 additionalProperties: false
 
 examples:
   - |
+    #include <dt-bindings/clock/rockchip,rv1126-cru.h>
     #include <dt-bindings/interrupt-controller/arm-gic.h>
-    #include <dt-bindings/clock/rockchip,rk3588-cru.h>
-    #include <dt-bindings/reset/rockchip,rk3588-cru.h>
-    crypto@fe370000 {
-      compatible = "rockchip,rk3588-crypto";
-      reg = <0xfe370000 0x4000>;
-      interrupts = <GIC_SPI 209 IRQ_TYPE_LEVEL_HIGH 0>;
-      clocks = <&scmi_clk SCMI_CRYPTO_CORE>, <&scmi_clk SCMI_ACLK_SECURE_NS>,
-               <&scmi_clk SCMI_HCLK_SECURE_NS>;
-      clock-names = "core", "a", "h";
-      resets = <&scmi_reset SRST_CRYPTO_CORE>;
-      reset-names = "core";
+    #include <dt-bindings/power/rockchip,rv1126-power.h>
+
+    crypto@ff500000 {
+      compatible = "rockchip,rv1126-crypto";
+      reg = <0xff500000 0x400>;
+      interrupts = <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>;
+      clocks = <&cru CLK_CRYPTO_CORE>, <&cru ACLK_CRYPTO>,
+               <&cru HCLK_CRYPTO>;
+      clock-names = "core", "aclk", "hclk";
+      power-domains = <&power RV1126_PD_CRYPTO>;
     };
