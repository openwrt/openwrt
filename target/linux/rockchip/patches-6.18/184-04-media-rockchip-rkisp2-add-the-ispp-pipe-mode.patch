+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Rockchip ISP2: ISPP input pool interface.
+ *
+ * In the quick input mode the ISP output is piped straight into the ISPP.
+ * The mainpath DMA of the ISP keeps running and writes every frame, as a
+ * semi-planar YUV422 picture plus a gain map, into a ping-pong pool of
+ * buffers that the ISPP owns.
+ *
+ * The ISPP binds the ISP subdevice through a V4L2 async notifier and
+ * passes the pool with the subdevice core ioctl operation below before it
+ * starts the stream. The ISP stops writing the pool once the stream is
+ * stopped, so the ISPP may free the buffers after that.
+ */
+
+#ifndef _RKISP2_TOISPP_H
+#define _RKISP2_TOISPP_H
+
+#include <linux/types.h>
+
+#define RKISP2_ISPP_BUF_MAX 3
+
+/* struct rkisp2_ispp_cfg::work_mode */
+#define RKISP2_ISPP_WORK_422		BIT(1)
+#define RKISP2_ISPP_WORK_QUICK		BIT(2)
+
+struct rkisp2_ispp_pool_buf {
+	/* semi-planar YUV422 picture: the Y plane, then the UV plane */
+	dma_addr_t pic;
+	dma_addr_t gain;
+	/*
+	 * The real physical addresses of the pool buffers.  The ISP
+	 * mainpath is programmed with physical bases (the physical-base
+	 * scheme): while the ISP's IOMMU is in the identity domain the
+	 * bases pass through 1:1, and for a translated domain the
+	 * driver maps each base onto itself so it is valid in both
+	 * cases.
+	 */
+	phys_addr_t pic_phys;
+	phys_addr_t gain_phys;
+};
+
+/*
+ * Without the quick mode the ISP hands every completed pool buffer to
+ * the ISPP from its mainpath frame end interrupt, and the ISPP gives it
+ * back with RKISP2_ISPP_CMD_PUT once it has consumed it.
+ */
+struct rkisp2_ispp_ops {
+	/* a completed pool buffer, with the ISP frame sequence it holds */
+	void (*frame)(void *priv, unsigned int idx, u32 sequence,
+		      u64 timestamp);
+};
+
+struct rkisp2_ispp_cfg {
+	u8 work_mode;
+	u8 buf_num;
+	u32 width;
+	u32 height;
+	struct rkisp2_ispp_pool_buf buf[RKISP2_ISPP_BUF_MAX];
+	const struct rkisp2_ispp_ops *ops;
+	void *priv;
+};
+
+enum rkisp2_ispp_cmd {
+	/* arg: const struct rkisp2_ispp_cfg */
+	RKISP2_ISPP_CMD_SET = 1,
+	/* arg: const unsigned int *, the pool buffer index */
+	RKISP2_ISPP_CMD_PUT = 2,
+};
+
+#endif
