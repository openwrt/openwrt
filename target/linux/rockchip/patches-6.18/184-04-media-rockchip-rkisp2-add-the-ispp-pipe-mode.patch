+/*
+ * The ISPP pipe mode: the ISP output is piped straight into the ISPP and
+ * the mainpath DMA writes every frame, as a semi-planar YUV422 picture
+ * plus a gain map, into a ping-pong pool of buffers owned by the ISPP.
+ * In the quick mode the hardware alternates the two pool buffers at each
+ * frame end.  Otherwise the driver rotates them: the base of the next
+ * frame is written at the frame start and latched by the auto update at
+ * the frame end, the completed buffer is handed to the ISPP from the
+ * mainpath frame end and comes back through RKISP2_ISPP_CMD_PUT.
+ */
+
+static bool rkisp2_ispp_pipe_quick(struct rkisp2_isp *isp)
+{
+	return isp->ispp.cfg.work_mode & RKISP2_ISPP_WORK_QUICK;
+}
+
+static void rkisp2_ispp_pipe_base_set(struct rkisp2_isp *isp, unsigned int idx)
+{
+	struct rkisp2_device *rkisp2 = isp->rkisp2;
+	const struct rkisp2_ispp_cfg *cfg = &isp->ispp.cfg;
+	u32 plane = cfg->width * cfg->height;
+
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_MP_Y_BASE_AD_INIT,
+		     cfg->buf[idx].pic_phys);
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_MP_CB_BASE_AD_INIT,
+		     cfg->buf[idx].pic_phys + plane);
+	rkisp2_write(rkisp2, MI_GAIN_WR_BASE, cfg->buf[idx].gain_phys);
+}
+
+void rkisp2_ispp_pipe_vstart(struct rkisp2_isp *isp)
+{
+	unsigned long flags;
+	int idx;
+
+	if (!isp->ispp.active || rkisp2_ispp_pipe_quick(isp))
+		return;
+
+	spin_lock_irqsave(&isp->ispp.lock, flags);
+	if (isp->ispp.nxt < 0) {
+		idx = find_first_bit(&isp->ispp.free, isp->ispp.cfg.buf_num);
+		if (idx < isp->ispp.cfg.buf_num) {
+			clear_bit(idx, &isp->ispp.free);
+			isp->ispp.nxt = idx;
+		}
+	}
+	if (isp->ispp.nxt >= 0)
+		rkisp2_ispp_pipe_base_set(isp, isp->ispp.nxt);
+	spin_unlock_irqrestore(&isp->ispp.lock, flags);
+}
+
+void rkisp2_ispp_pipe_frame_end(struct rkisp2_isp *isp)
+{
+	const struct rkisp2_ispp_cfg *cfg = &isp->ispp.cfg;
+	unsigned long flags;
+	int done = -1;
+
+	if (!isp->ispp.active || rkisp2_ispp_pipe_quick(isp))
+		return;
+
+	spin_lock_irqsave(&isp->ispp.lock, flags);
+	if (isp->ispp.cur >= 0 && isp->ispp.nxt >= 0) {
+		done = isp->ispp.cur;
+		isp->ispp.cur = isp->ispp.nxt;
+		isp->ispp.nxt = -1;
+	}
+	spin_unlock_irqrestore(&isp->ispp.lock, flags);
+
+	if (done >= 0)
+		cfg->ops->frame(cfg->priv, done, isp->frame_sequence,
+				ktime_get_ns());
+}
+
+static void rkisp2_ispp_pipe_put(struct rkisp2_isp *isp, unsigned int idx)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&isp->ispp.lock, flags);
+	if (idx < isp->ispp.cfg.buf_num)
+		set_bit(idx, &isp->ispp.free);
+	spin_unlock_irqrestore(&isp->ispp.lock, flags);
+}
+
+static void rkisp2_ispp_pipe_mi_reload(struct rkisp2_isp *isp)
+{
+	struct rkisp2_device *rkisp2 = isp->rkisp2;
+	const struct rkisp2_ispp_cfg *cfg = &isp->ispp.cfg;
+	u32 plane, mi_ctrl, val;
+
+	/* semi-planar 4:2:2 into the pool, contiguous lines of a 16 px multiple */
+	plane = cfg->width * cfg->height;
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_MP_Y_SIZE_INIT, plane);
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_MP_CB_SIZE_INIT, plane);
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_MP_CR_SIZE_INIT, 0);
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_MP_Y_OFFS_CNT_INIT, 0);
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_MP_CB_OFFS_CNT_INIT, 0);
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_MP_CR_OFFS_CNT_INIT, 0);
+
+	rkisp2_ispp_pipe_base_set(isp, 0);
+
+	mi_ctrl = rkisp2_read(rkisp2, RKISP2_CIF_MI_CTRL);
+	mi_ctrl &= ~RKISP2_MI_CTRL_MP_FMT_MASK;
+	mi_ctrl &= ~GENMASK(17, 16);
+	mi_ctrl |= RKISP2_CIF_MI_CTRL_BURST_LEN_LUM_64;
+	mi_ctrl &= ~GENMASK(19, 18);
+	mi_ctrl |= RKISP2_CIF_MI_CTRL_BURST_LEN_CHROM_64;
+	mi_ctrl |= RKISP2_MI_CTRL_MP_WRITE_YUV_SPLA |
+		   RKISP2_CIF_MI_CTRL_MP_ENABLE |
+		   RKISP2_CIF_MI_MP_AUTOUPDATE_ENABLE;
+	if (cfg->buf_num > 1 && rkisp2_ispp_pipe_quick(isp)) {
+		rkisp2_write(rkisp2, RKISP2_CIF_MI_MP_Y_BASE_AD_INIT2,
+			     cfg->buf[1].pic_phys);
+		rkisp2_write(rkisp2, RKISP2_CIF_MI_MP_CB_BASE_AD_INIT2,
+			     cfg->buf[1].pic_phys + plane);
+		rkisp2_write(rkisp2, MI_GAIN_WR_BASE2, cfg->buf[1].gain_phys);
+		mi_ctrl |= RKISP2_CIF_MI_MP_PINGPONG_ENABLE;
+	}
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_CTRL, mi_ctrl);
+
+	/* gain map write path */
+	rkisp2_write(rkisp2, MI_GAIN_WR_SIZE,
+		     ALIGN(cfg->width, 64) * ALIGN(cfg->height, 128) >> 4);
+	rkisp2_write(rkisp2, MI_GAIN_WR_LENGTH,
+		     ALIGN((cfg->width + 3) >> 2, 16));
+	val = rkisp2_read(rkisp2, MI_WR_CTRL2) | SW_GAIN_WR_AUTOUPD;
+	if (cfg->buf_num > 1 && rkisp2_ispp_pipe_quick(isp))
+		val |= SW_GAIN_WR_PINGPONG;
+	rkisp2_write(rkisp2, MI_WR_CTRL2, val);
+
+	/* route the mainpath to the MI write engine */
+	rkisp2_write(rkisp2, RKISP2_CIF_VI_DPCL,
+		     rkisp2_read(rkisp2, RKISP2_CIF_VI_DPCL) |
+		     RKISP2_CIF_VI_DPCL_CHAN_MODE_MP |
+		     RKISP2_CIF_VI_DPCL_MP_MUX_MRSZ_MI);
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_CTRL,
+		     rkisp2_read(rkisp2, RKISP2_CIF_MI_CTRL) |
+		     RKISP2_CIF_MI_CTRL_INIT_BASE_EN |
+		     RKISP2_CIF_MI_CTRL_INIT_OFFSET_EN);
+
+	/* latched by the soft update the VICAP start does afterwards */
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_INIT,
+		     RKISP2_CIF_MI_INIT_MP_OUTPUT_YUV422);
+	rkisp2_write(rkisp2, ISP_MPFBC_CTRL, SW_MPFBC_YUV_MODE(1));
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_IMSC,
+		     rkisp2_read(rkisp2, RKISP2_CIF_MI_IMSC) |
+		     RKISP2_CIF_MI_MP_FE);
+}
+
+static int rkisp2_ispp_pipe_start(struct rkisp2_isp *isp)
+{
+	struct rkisp2_device *rkisp2 = isp->rkisp2;
+	const struct rkisp2_ispp_cfg *cfg = &isp->ispp.cfg;
+	u32 val;
+
+	if (!(cfg->work_mode & RKISP2_ISPP_WORK_422))
+		return -EOPNOTSUPP;
+	if (!cfg->buf_num || cfg->buf_num > RKISP2_ISPP_BUF_MAX)
+		return -EINVAL;
+
+	isp->ispp.cur = 0;
+	isp->ispp.nxt = -1;
+	isp->ispp.free = GENMASK(cfg->buf_num - 1, 0) & ~BIT(0);
+	isp->ispp.mi_frames = 0;
+
+	rkisp2_resizer_pipe_configure(rkisp2, cfg->width, cfg->height);
+	rkisp2_ispp_pipe_mi_reload(isp);
+
+	/* pipe the ISP output straight into the ISPP */
+	if (rkisp2_ispp_pipe_quick(isp)) {
+		val = rkisp2_read(rkisp2, ISP3X_SWS_CFG) | SW_ISP2PP_PIPE_EN;
+		rkisp2_write(rkisp2, ISP3X_SWS_CFG, val);
+	}
+
+	dev_dbg(rkisp2->dev, "ISPP pipe started: %ux%u\n", cfg->width,
+		cfg->height);
+
+	return 0;
+}
+
+static void rkisp2_ispp_pipe_iommu_unmap(struct rkisp2_isp *isp)
+{
+	const struct rkisp2_ispp_cfg *cfg = &isp->ispp.cfg;
+	int i;
+
+	/* a domain switched since the map took the mapping with it */
+	if (!isp->ispp.iommu ||
+	    isp->ispp.iommu != iommu_get_domain_for_dev(isp->rkisp2->dev))
+		return;
+
+	for (i = 0; i < cfg->buf_num; i++) {
+		iommu_unmap(isp->ispp.iommu, cfg->buf[i].pic_phys,
+			    isp->ispp.pic_size);
+		iommu_unmap(isp->ispp.iommu, cfg->buf[i].gain_phys,
+			    isp->ispp.gain_size);
+	}
+	isp->ispp.iommu = NULL;
+}
+
+static void rkisp2_ispp_pipe_stop(struct rkisp2_isp *isp)
+{
+	struct rkisp2_device *rkisp2 = isp->rkisp2;
+	u32 mi_ctrl, val;
+
+	/* the write engine finishes its frame after the ISP core has */
+	if (!wait_event_timeout(isp->ispp.done,
+				isp->ispp.mi_frames == isp->frame_sequence + 1,
+				msecs_to_jiffies(1000)))
+		dev_warn(rkisp2->dev,
+			 "ISPP pipe: mainpath write did not stop\n");
+
+	rkisp2_resizer_pipe_disable(rkisp2);
+
+	mi_ctrl = rkisp2_read(rkisp2, RKISP2_CIF_MI_CTRL);
+	mi_ctrl &= ~(RKISP2_CIF_MI_CTRL_MP_ENABLE |
+		     RKISP2_CIF_MI_MP_PINGPONG_ENABLE);
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_CTRL, mi_ctrl);
+
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_IMSC,
+		     rkisp2_read(rkisp2, RKISP2_CIF_MI_IMSC) &
+		     ~RKISP2_CIF_MI_MP_FE);
+
+	rkisp2_write(rkisp2, MI_WR_CTRL2,
+		     rkisp2_read(rkisp2, MI_WR_CTRL2) &
+		     ~(SW_GAIN_WR_AUTOUPD | SW_GAIN_WR_PINGPONG));
+	/* a non-zero size keeps the gain writer armed for the next mainpath run */
+	rkisp2_write(rkisp2, MI_GAIN_WR_SIZE, 0);
+	rkisp2_write(rkisp2, MI_GAIN_WR_LENGTH, 0);
+	rkisp2_write(rkisp2, ISP_MPFBC_CTRL, 0);
+	rkisp2_write(rkisp2, ISP3X_SWS_CFG,
+		     rkisp2_read(rkisp2, ISP3X_SWS_CFG) &
+		     ~SW_ISP2PP_PIPE_EN);
+
+	/* latch the disarmed write engines now, no frame end follows */
+	val = rkisp2_read(rkisp2, RKISP2_CIF_MI_INIT) &
+	      RKISP2_CIF_MI_INIT_MP_OUTPUT_MASK;
+	rkisp2_write(rkisp2, RKISP2_CIF_MI_INIT,
+		     val | RKISP2_CIF_MI_INIT_SOFT_UPD);
+}
+
+/*
+ * The mainpath writes the physical pool bases: map each onto itself so
+ * a translated domain resolves them like the identity domain does.
+ */
+void rkisp2_ispp_pipe_iommu_map(struct rkisp2_isp *isp)
+{
+	struct rkisp2_device *rkisp2 = isp->rkisp2;
+	const struct rkisp2_ispp_cfg *cfg = &isp->ispp.cfg;
+	struct iommu_domain *dom;
+	size_t wh, pic_size, gain_size;
+	int i, ret;
+
+	if (!isp->ispp.active || isp->ispp.iommu)
+		return;
+
+	dom = iommu_get_domain_for_dev(rkisp2->dev);
+	if (!dom || !(dom->type & __IOMMU_DOMAIN_PAGING) ||
+	    !dom->ops || !dom->ops->map_pages)
+		return;
+
+	wh = ALIGN(cfg->width, 16) * cfg->height;
+	pic_size = PAGE_ALIGN(2 * wh);
+	gain_size = PAGE_ALIGN(ALIGN(cfg->width, 64) *
+			       ALIGN(cfg->height, 128) >> 4);
+
+	for (i = 0; i < cfg->buf_num; i++) {
+		ret = iommu_map(dom, cfg->buf[i].pic_phys,
+				cfg->buf[i].pic_phys,
+				pic_size, IOMMU_READ | IOMMU_WRITE,
+				GFP_KERNEL);
+		if (ret)
+			goto err;
+		ret = iommu_map(dom, cfg->buf[i].gain_phys,
+				cfg->buf[i].gain_phys,
+				gain_size, IOMMU_READ | IOMMU_WRITE,
+				GFP_KERNEL);
+		if (ret)
+			goto err;
+	}
+
+	isp->ispp.iommu = dom;
+	isp->ispp.pic_size = pic_size;
+	isp->ispp.gain_size = gain_size;
+	return;
+
+err:
+	for (; i >= 0; i--) {
+		iommu_unmap(dom, cfg->buf[i].pic_phys, pic_size);
+		iommu_unmap(dom, cfg->buf[i].gain_phys, gain_size);
+	}
+	dev_warn(rkisp2->dev,
+		 "ISPP pipe: could not map the input pool (err %d)\n",
+		 ret);
+}
+
+static int rkisp2_ispp_set(struct rkisp2_isp *isp,
+			   const struct rkisp2_ispp_cfg *cfg)
+{
+	struct device *dev = isp->rkisp2->dev;
+	int i;
+
+	if (isp->ispp.active || isp->ispp.start) {
+		dev_err(dev, "ISPP pipe already running or pending\n");
+		return -EBUSY;
+	}
+
+	if (!(cfg->work_mode & RKISP2_ISPP_WORK_422) ||
+	    (!(cfg->work_mode & RKISP2_ISPP_WORK_QUICK) &&
+	     (!cfg->ops || !cfg->ops->frame)) ||
+	    !cfg->buf_num || cfg->buf_num > RKISP2_ISPP_BUF_MAX ||
+	    !cfg->width || !cfg->height)
+		return -EINVAL;
+	for (i = 0; i < cfg->buf_num; i++)
+		if (!cfg->buf[i].pic || !cfg->buf[i].gain)
+			return -EINVAL;
+
+	isp->ispp.cfg = *cfg;
+	isp->ispp.start = true;
+	dev_dbg(dev, "ISPP pipe armed: mode 0x%x bufs %d %ux%u\n",
+		cfg->work_mode, cfg->buf_num, cfg->width, cfg->height);
+
+	return 0;
+}
+
+static long rkisp2_toispp_ioctl(struct v4l2_subdev *sd, unsigned int cmd,
+				void *arg)
+{
+	struct rkisp2_isp *isp = container_of(sd, struct rkisp2_isp, toispp.sd);
+
+	if (!arg)
+		return -ENOTTY;
+
+	switch (cmd) {
+	case RKISP2_ISPP_CMD_SET:
+		return rkisp2_ispp_set(isp, arg);
+	case RKISP2_ISPP_CMD_PUT:
+		rkisp2_ispp_pipe_put(isp, *(const unsigned int *)arg);
+		return 0;
+	default:
+		return -ENOTTY;
+	}
+}
+
+static int rkisp2_toispp_get_fmt(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct rkisp2_isp *isp = container_of(sd, struct rkisp2_isp, toispp.sd);
+	struct v4l2_subdev_format ispp_fmt = {
+		.pad = RKISP2_ISP_PAD_SOURCE_ISPP,
+	};
+	int ret;
+
+	if (fmt->pad)
+		return -EINVAL;
+
+	ret = v4l2_subdev_call_state_active(&isp->sd, pad, get_fmt, &ispp_fmt);
+	if (ret)
+		return ret;
+
+	fmt->format = ispp_fmt.format;
+	fmt->which = state ? V4L2_SUBDEV_FORMAT_ACTIVE
+			   : V4L2_SUBDEV_FORMAT_TRY;
+
+	return 0;
+}
+
+static int rkisp2_toispp_s_stream(struct v4l2_subdev *sd, int on)
+{
+	struct rkisp2_isp *isp = container_of(sd, struct rkisp2_isp, toispp.sd);
+
+	return v4l2_subdev_call(&isp->sd, video, s_stream, on);
+}
+
+static const struct v4l2_subdev_core_ops rkisp2_toispp_core_ops = {
+	.ioctl = rkisp2_toispp_ioctl,
+};
+
+static const struct v4l2_subdev_video_ops rkisp2_toispp_video_ops = {
+	.s_stream = rkisp2_toispp_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops rkisp2_toispp_pad_ops = {
+	.get_fmt = rkisp2_toispp_get_fmt,
+};
+
+static const struct v4l2_subdev_ops rkisp2_toispp_ops = {
+	.core = &rkisp2_toispp_core_ops,
+	.video = &rkisp2_toispp_video_ops,
+	.pad = &rkisp2_toispp_pad_ops,
+};
+
+static int rkisp2_toispp_register(struct rkisp2_device *rkisp2)
+{
+	struct rkisp2_isp *isp = &rkisp2->isp;
+	struct v4l2_subdev *sd = &isp->toispp.sd;
+	int ret;
+
+	v4l2_subdev_init(sd, &rkisp2_toispp_ops);
+	sd->dev = rkisp2->dev;
+	sd->owner = THIS_MODULE;
+	strscpy(sd->name, "rkisp2-toispp", sizeof(sd->name));
+	sd->entity.function = MEDIA_ENT_F_VID_IF_BRIDGE;
+
+	isp->toispp.pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&sd->entity, 1, &isp->toispp.pad);
+	if (ret)
+		return ret;
+
+	ret = v4l2_async_register_subdev(sd);
+	if (ret)
+		media_entity_cleanup(&sd->entity);
+
+	return ret;
+}
+
+static void rkisp2_toispp_unregister(struct rkisp2_device *rkisp2)
+{
+	struct rkisp2_isp *isp = &rkisp2->isp;
+
+	if (!isp->toispp.sd.entity.pads)
+		return;
+
+	v4l2_async_unregister_subdev(&isp->toispp.sd);
+	media_entity_cleanup(&isp->toispp.sd.entity);
+}
