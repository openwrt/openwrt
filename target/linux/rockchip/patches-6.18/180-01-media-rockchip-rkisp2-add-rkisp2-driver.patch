+const struct rkisp2_mbus_info *rkisp2_mbus_info_get_by_code(u32 mbus_code)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(rkisp2_formats); i++) {
+		const struct rkisp2_mbus_info *fmt = &rkisp2_formats[i];
