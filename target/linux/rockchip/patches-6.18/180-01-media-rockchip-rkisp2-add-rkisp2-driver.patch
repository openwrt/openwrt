+		RKISP2_DEBUG_REG(ISP_CTRL),
+		RKISP2_DEBUG_REG(ISP_ACQ_PROP),
+		RKISP2_DEBUG_REG(ISP_FLAGS_SHD),
+		RKISP2_DEBUG_REG(ISP_RIS),
+		RKISP2_DEBUG_REG(ISP_ERR),
+		RKISP2_DEBUG_SHD_REG(ISP_IS_H_OFFS),
