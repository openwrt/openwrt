+/* Hardware configure Entry */
+static int rkisp2_config_cif(struct rkisp2_isp *isp,
+			     struct v4l2_subdev_state *sd_state)
+{
+	int ret;
+
+	ret = rkisp2_config_isp(isp, sd_state);
+	if (ret)
+		return ret;
+
+	rkisp2_config_ism(isp, sd_state);
+	rkisp2_config_path(isp);
+
+	return 0;
+}
