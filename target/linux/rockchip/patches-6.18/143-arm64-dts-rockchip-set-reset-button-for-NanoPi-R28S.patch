From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Abdalla Ashry <abdallah.ashry@hotmail.com>
Date: Wed, 07 Oct 2026 12:00:00 +0200
Subject: [PATCH] arm64: dts: rockchip: set reset button for NanoPi R28S

Use the user button (K2_USR) as reset button (KEY_RESTART) so it can be
used for OpenWrt failsafe and factory reset.

Signed-off-by: Abdalla Ashry <abdallah.ashry@hotmail.com>
---
--- a/arch/arm64/boot/dts/rockchip/rk3528-nanopi-r28s.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3528-nanopi-r28s.dts
@@ -26,8 +26,8 @@
 		button-user {
 			debounce-interval = <50>;
 			gpios = <&gpio4 RK_PB2 GPIO_ACTIVE_LOW>;
-			label = "USER";
-			linux,code = <BTN_1>;
+			label = "reset";
+			linux,code = <KEY_RESTART>;
 			wakeup-source;
 		};
 	};
