From b5c7c67b8f10203253138ec35bb6aef213faae30 Mon Sep 17 00:00:00 2001
From: Kevin Zhang <kevin@kevinzhang.me>
Date: Sun, 27 Oct 2024 01:13:47 -0400
Subject: [PATCH] arm64: dts: rockchip: nanopi-r3s: add LED aliases

Add the LED aliases used by OpenWrt to indicate the boot, failsafe,
running and upgrade states to the device tree of the FriendlyElec NanoPi
R3S.
---
--- a/arch/arm64/boot/dts/rockchip/rk3566-nanopi-r3s.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-nanopi-r3s.dts
@@ -24,6 +24,11 @@
 		ethernet0 = &gmac1;
 		mmc0 = &sdhci;
 		mmc1 = &sdmmc0;
+
+		led-boot = &power_led;
+		led-failsafe = &power_led;
+		led-running = &power_led;
+		led-upgrade = &power_led;
 	};
 
 	chosen: chosen {
