#!/bin/sh /etc/rc.common

START=20
USE_PROCD=1

start_service()
{
	# Preinit normally configures the recovery gadget before rcS. Avoid a
	# duplicate configfs setup while that one-shot worker is still active.
	[ -d /tmp/mf283v-openwrt-usb.lock ] && return 0

	procd_open_instance
	procd_set_param command /usr/sbin/mf283v-openwrt-usb
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
