From 4149d2b91c43784ada37efe928c5f6b610c74259 Mon Sep 17 00:00:00 2001
From: DENG Qingfang <dengqf6@mail2.sysu.edu.cn>
Date: Thu, 30 Apr 2020 19:41:39 +0800
Subject: [PATCH] ARM: dts: armada-385-linksys: use eth0 as DSA CPU port

Connect the CPU port of the switch via eth0 (port 6) instead of eth2
(port 5) on the Armada 385 based Linksys WRT devices and disable the
interface which is no longer used.
---
--- a/arch/arm/boot/dts/marvell/armada-385-linksys.dtsi
+++ b/arch/arm/boot/dts/marvell/armada-385-linksys.dtsi
@@ -116,7 +116,7 @@
 };
 
 &eth2 {
-	status = "okay";
+	status = "disabled";
 	phy-mode = "sgmii";
 	buffer-manager = <&bm>;
 	bm,pool-long = <2>;
@@ -198,10 +198,10 @@
 				label = "wan";
 			};
 
-			ethernet-port@5 {
-				reg = <5>;
+			ethernet-port@6 {
+				reg = <6>;
 				phy-mode = "sgmii";
-				ethernet = <&eth2>;
+				ethernet = <&eth0>;
 
 				fixed-link {
 					speed = <1000>;
