#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	[ -r /proc/device-tree/compatible ] &&
	tr '\0' '\n' < /proc/device-tree/compatible |
		grep -qx 'wd,cloud-ex2-ultra' || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/wt6703f-fancontrol
	procd_set_param respawn
	procd_close_instance
}
