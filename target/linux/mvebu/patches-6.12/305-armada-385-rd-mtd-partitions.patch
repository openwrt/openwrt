From 3019f7ecbde367ffc902533e3cd2cd36ccba5c53 Mon Sep 17 00:00:00 2001
From: Imre Kaloz <kaloz@openwrt.org>
Date: Thu, 5 Feb 2015 11:29:56 +0000
Subject: [PATCH] ARM: dts: armada-388-rd: add MTD partitions

Add the uboot and firmware partitions for the SPI flash of the Armada
388 reference design board.
---
--- a/arch/arm/boot/dts/marvell/armada-388-rd.dts
+++ b/arch/arm/boot/dts/marvell/armada-388-rd.dts
@@ -103,6 +103,16 @@
 		compatible = "st,m25p128", "jedec,spi-nor";
 		reg = <0>; /* Chip select 0 */
 		spi-max-frequency = <108000000>;
+
+		partition@0 {
+			label = "uboot";
+			reg = <0 0x400000>;
+		};
+
+		partition@1 {
+			label = "firmware";
+			reg = <0x400000 0xc00000>;
+		};
 	};
 };
 
