From d8655868ca04d12ad5ed36e26fc63d61b076e33d Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Tue, 27 Feb 2018 15:09:43 +0100
Subject: [PATCH] MIPS: ralink: mt7621: fix spurious IRQ7 with perf

The performance counter events are routed through the GIC. Prevent them
from firing on CPU IRQ7 as well, which caused spurious interrupts when
using perf.
---
--- a/arch/mips/ralink/irq-gic.c
+++ b/arch/mips/ralink/irq-gic.c
@@ -14,6 +14,12 @@
 
 int get_c0_perfcount_int(void)
 {
+	/*
+	 * Performance counter events are routed through GIC.
+	 * Prevent them from firing on CPU IRQ7 as well
+	 */
+	clear_c0_status(IE_SW0 << 7);
+
 	return gic_get_c0_perfcount_int();
 }
 EXPORT_SYMBOL_GPL(get_c0_perfcount_int);
