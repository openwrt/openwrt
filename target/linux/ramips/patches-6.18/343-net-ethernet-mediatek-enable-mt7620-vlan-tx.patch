+static int mtk_mt7620_vlan_rx_add_vid(struct net_device *dev, __be16 proto,
+				      u16 vid)
+{
+	struct mtk_mac *mac = netdev_priv(dev);
+	struct mtk_eth *eth = mac->hw;
+	u32 idx = vid & 0xf;
+	u32 reg = MT7620_CDMA_VLAN_BASE + (idx / 2) * sizeof(u32);
+	u32 val;
+
+	/* VLAN core installs VID 0 for 802.1p; it needs no table entry. */
+	if (!vid)
+		return 0;
+
+	if (!MTK_HAS_CAPS(eth->soc->caps, MTK_SOC_MT7620) ||
+	    !(dev->features & NETIF_F_HW_VLAN_CTAG_TX))
+		return 0;
+
+	if (test_bit(idx, &eth->mt7620_vlan_map) &&
+	    eth->mt7620_vlan_vid[idx] == vid)
+		return 0;
+
+	if (test_bit(idx, &eth->mt7620_vlan_map)) {
+		netdev_warn(dev,
+			    "VID %u aliases an active MT7620 VLAN table slot; disabling TX VLAN offload\n",
+			    vid);
+		dev->wanted_features &= ~NETIF_F_HW_VLAN_CTAG_TX;
+		netdev_update_features(dev);
+		return 0;
+	}
+
+	val = mtk_r32(eth, reg);
+	if (idx & 1)
+		val = (val & GENMASK(15, 0)) | (vid << 16);
+	else
+		val = (val & GENMASK(31, 16)) | vid;
+	mtk_w32(eth, val, reg);
+	eth->mt7620_vlan_vid[idx] = vid;
+	set_bit(idx, &eth->mt7620_vlan_map);
+
+	return 0;
+}
+
+static int mtk_mt7620_vlan_rx_kill_vid(struct net_device *dev, __be16 proto,
+				       u16 vid)
+{
+	struct mtk_mac *mac = netdev_priv(dev);
+	struct mtk_eth *eth = mac->hw;
+
+	if (!vid)
+		return 0;
+
+	if (MTK_HAS_CAPS(eth->soc->caps, MTK_SOC_MT7620) &&
+	    eth->mt7620_vlan_vid[vid & 0xf] == vid) {
+		clear_bit(vid & 0xf, &eth->mt7620_vlan_map);
+		eth->mt7620_vlan_vid[vid & 0xf] = 0;
+	}
+
+	return 0;
+}
