#include <dt-bindings/leds/common.h>
#include <dt-bindings/mtd/partitions/uimage.h>

#include "mt7628an_tplink_8m.dtsi"

/ {
	compatible = "tplink,tl-wr845n-v3", "mediatek,mt7628an-soc";
	model = "TP-Link TL-WR845N v3";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		rfkill {
			label = "rfkill";
			gpios = <&gpio 37 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RFKILL>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 36 GPIO_ACTIVE_LOW>;
		};

		wps {
			function = LED_FUNCTION_WPS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 46 GPIO_ACTIVE_LOW>;
		};

		lan1 {
			function = LED_FUNCTION_LAN;
			color = <LED_COLOR_ID_GREEN>;
			function-enumerator = <1>;
			gpios = <&gpio 42 GPIO_ACTIVE_LOW>;
		};

		lan2 {
			function = LED_FUNCTION_LAN;
			color = <LED_COLOR_ID_GREEN>;
			function-enumerator = <2>;
			gpios = <&gpio 41 GPIO_ACTIVE_LOW>;
		};

		lan3 {
			function = LED_FUNCTION_LAN;
			color = <LED_COLOR_ID_GREEN>;
			function-enumerator = <3>;
			gpios = <&gpio 40 GPIO_ACTIVE_LOW>;
		};

		lan4 {
			function = LED_FUNCTION_LAN;
			color = <LED_COLOR_ID_GREEN>;
			function-enumerator = <4>;
			gpios = <&gpio 39 GPIO_ACTIVE_LOW>;
		};

		wan {
			function = LED_FUNCTION_WAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 43 GPIO_ACTIVE_LOW>;
		};

		wlan {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 44 GPIO_ACTIVE_LOW>;
		};
	};
};

/* Keep the OEM header, OKLI loader and OEM-written tag out of sysupgrade. */
&spi0 {
	flash@0 {
		partitions {
			/delete-node/ partition@20000;

			partition@20000 {
				label = "okli";
				reg = <0x20000 0x30000>;
				read-only;
			};

			partition@50000 {
				compatible = "openwrt,uimage";
				openwrt,ih-magic = <IH_MAGIC_OKLI>;
				label = "firmware";
				reg = <0x50000 0x770000>;
			};
		};
	};
};

&ehci {
	status = "disabled";
};

&ohci {
	status = "disabled";
};

&state_default {
	gpio {
		groups = "gpio", "p0led_an", "p1led_an", "p2led_an", "p3led_an", "p4led_an", "perst", "refclk", "uart1", "wdt", "wled_an";
		function = "gpio";
	};
};

&wmac {
	status = "okay";

	nvmem-cells = <&eeprom_factory_20000>, <&macaddr_factory_f100 0>;
	nvmem-cell-names = "eeprom", "mac-address";
};

&ethernet {
	nvmem-cells = <&macaddr_factory_f100 0>;
	nvmem-cell-names = "mac-address";
};

&esw {
	mediatek,portmap = <0x3e>;
};
