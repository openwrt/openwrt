#include "mt7620a.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "edimax,cap300", "ralink,mt7620a-soc";
	model = "Edimax Pro CAP300";

	label-mac-device = &ethernet;

	aliases {
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_power;
		led-upgrade = &led_status;
	};

	chosen {
		bootargs = "console=ttyS0,57600";
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led_status: status {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_AMBER>;
			gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
		};
	};

	gpio-export {
		compatible = "gpio-export";

		buzzer {
			gpio-export,name = "buzzer";
			gpio-export,output = <0>;
			gpios = <&gpio2 12 GPIO_ACTIVE_HIGH>;
		};
	};
};

&gpio2 {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <40000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
			};

			partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x200>;
					};

					macaddr_factory_4: macaddr@4 {
						compatible = "mac-base";
						reg = <0x4 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@50000 {
				/*
				 * Extends to 0xfe0000 so mtdsplit hands the
				 * unused tail to rootfs_data; u-boot rejects
				 * images above 0xc80000, hence IMAGE_SIZE
				 * 12480k in mt7620.mk.
				 */
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0xf90000>;
			};
		};
	};
};

&state_default {
	gpio {
		groups = "i2c", "uartf", "nd_sd", "rgmii2";
		function = "gpio";
	};
};

&ethernet {
	pinctrl-names = "default";
	pinctrl-0 = <&rgmii1_pins &mdio_pins>;

	nvmem-cells = <&macaddr_factory_4 0>;
	nvmem-cell-names = "mac-address";

	mediatek,no-swconfig;

	port@5 {
		status = "okay";
		phy-handle = <&phy4>;
		phy-mode = "rgmii-id";
	};

	mdio-bus {
		status = "okay";

		phy4: ethernet-phy@4 {
			reg = <4>;
			phy-mode = "rgmii-rxid";
		};
	};
};

&gsw {
	mediatek,ephy-base = /bits/ 8 <8>;
};

&wmac {
	/* External PA/LNA on GPIO 18..21, driven by rt2x00 through the "pa" state. */
	pinctrl-names = "default", "pa_gpio";
	pinctrl-0 = <&pa_pins>;
	pinctrl-1 = <&pa_gpio_pins>;

	nvmem-cells = <&eeprom_factory_0>, <&macaddr_factory_4 1>;
	nvmem-cell-names = "eeprom", "mac-address";
};
