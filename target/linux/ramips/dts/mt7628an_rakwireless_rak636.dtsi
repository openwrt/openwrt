#include "mt7628an.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	aliases {
		led-boot = &led_lan;
		led-failsafe = &led_lan;
		led-upgrade = &led_lan;
		label-mac-device = &ethernet;
	};

	leds {
		compatible = "gpio-leds";

		led-lora-1 {
			color = <LED_COLOR_ID_GREEN>;
			function = "lora";
			function-enumerator = <1>;
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
		};

		led-lora-2 {
			color = <LED_COLOR_ID_GREEN>;
			function = "lora";
			function-enumerator = <2>;
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
		};

		led_lan: led-lan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&gpio 43 GPIO_ACTIVE_LOW>;
		};

		led-wlan {
			color = <LED_COLOR_ID_ORANGE>;
			function = LED_FUNCTION_WLAN;
			gpios = <&gpio 44 GPIO_ACTIVE_LOW>;
		};
	};

	keys: keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			gpios = <&gpio 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&gpio {
	/* Low powers the EG95. */
	modem-power-hog {
		gpio-hog;
		gpios = <41 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "modem-power";
	};
};

&state_default {
	gpio {
		groups = "gpio", "i2s", "spis", "wdt", "wled_an",
			 "p0led_an", "p1led_an", "p2led_an", "p3led_an", "p4led_an";
		function = "gpio";
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
			};

			partition@40000 {
				label = "factory";
				reg = <0x40000 0xe000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x400>;
					};

					macaddr_factory_28: macaddr@28 {
						reg = <0x28 0x6>;
					};

					macaddr_factory_2e: macaddr@2e {
						reg = <0x2e 0x6>;
					};
				};
			};

			/* The vendor's per-unit data, kept for a return to stock. */
			partition@4e000 {
				label = "pst-data";
				reg = <0x4e000 0x2000>;
				read-only;
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0x1fb0000>;
			};
		};
	};
};

&ethernet {
	nvmem-cells = <&macaddr_factory_28>;
	nvmem-cell-names = "mac-address";
};

&wmac {
	status = "okay";

	nvmem-cells = <&eeprom_factory_0>, <&macaddr_factory_2e>;
	nvmem-cell-names = "eeprom", "mac-address";
};

/*
 * The SD slot is wired to the ethernet PHY's P1-P4 pads, which is why the
 * board has one ethernet port.
 */
&pinctrl {
	ephy-digital;

	sdxc_iot_mode: sdxc_iot_mode {
		esd {
			groups = "esd";
			function = "iot";
		};

		sdxc {
			groups = "sdmode";
			function = "sdxc";
		};
	};
};

&sdhci {
	status = "okay";

	pinctrl-0 = <&sdxc_iot_mode>;
	pinctrl-1 = <&sdxc_iot_mode>;
};
