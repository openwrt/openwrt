/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "rt6855.dtsi"

/ {
	compatible = "zyxel,keenetic-giga-ii", "ralink,rt6855-soc";
	model = "Zyxel Keenetic Giga II";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	memory@20000 {
		device_type = "memory";
		reg = <0x00020000 0x0ffe0000>;
	};

	chosen {
		bootargs = "console=ttyS0,57600";
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
		};

		led-internet {
			function = LED_FUNCTION_WAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
		};

		led-usb {
			function = LED_FUNCTION_USB;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio0 25 GPIO_ACTIVE_LOW>;
			trigger-sources = <&ohci_port1>, <&ohci_port2>,
					  <&ehci_port1>, <&ehci_port2>;
			linux,default-trigger = "usbport";
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		button-wps {
			label = "wps";
			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};

		button-fn {
			label = "fn";
			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_0>;
		};
	};

	rtl8367rb {
		compatible = "realtek,rtl8367b";
		mii-bus = <&mdio0>;
		/* CPU port 6, RGMII, forced 1G/full/pause, TX delay 1, RX delay 2. */
		realtek,extif = <6 1 2 1 1 1 1 1 1 2>;
		realtek,init-regs = <0x1301 0x0778>,
				    <0x1302 0x7777>,
				    <0x1303 0x01fe>,
				    <0x1b03 0x0222>;
	};
};

&pcie {
	status = "okay";
};

&pcie0 {
	wifi@0,0 {
		compatible = "pci1814,3091";
		reg = <0x00000000 0 0 0 0>;
		nvmem-cells = <&eeprom_factory_0>;
		nvmem-cell-names = "eeprom";
		ralink,max-tx-streams = <1>;
		ralink,direct-led-control;
	};
};

&gpio0 {
	status = "okay";
};

&watchdog {
	status = "okay";
};

&ethernet {
	status = "okay";

	nvmem-cells = <&macaddr_factory_4>;
	nvmem-cell-names = "mac-address";

	mdio0: mdio-bus {
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x030000>;
				read-only;
			};

			partition@30000 {
				label = "u-config";
				reg = <0x030000 0x010000>;
				read-only;
			};

			factory: partition@40000 {
				label = "RF-EEPROM";
				reg = <0x040000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x200>;
					};

					macaddr_factory_4: macaddr@4 {
						reg = <0x4 0x6>;
					};
				};
			};

			firmware: partition@50000 {
				compatible = "openwrt,uimage", "denx,uimage";
				label = "firmware";
				reg = <0x050000 0xea0000>;
			};

			partition@ef0000 {
				label = "config";
				reg = <0xef0000 0x010000>;
				read-only;
			};

			partition@f00000 {
				label = "storage";
				reg = <0xf00000 0x0f0000>;
				read-only;
			};

			partition@ff0000 {
				label = "dump";
				reg = <0xff0000 0x010000>;
				read-only;
			};
		};
	};
};

&ohci {
	status = "okay";
};

&ehci {
	status = "okay";
};
