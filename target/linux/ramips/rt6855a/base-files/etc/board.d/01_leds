#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

. /lib/functions/leds.sh
. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
zyxel,keenetic-ultra)
	ucidef_set_led_switch "internet" "Internet" "green:wan" "switch0" \
		"0x10" "" "link"
	;;
esac

board_config_flush

exit 0
