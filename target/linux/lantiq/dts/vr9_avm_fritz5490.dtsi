#include <dt-bindings/leds/common.h>

#include "vr9_avm_fritzxx90.dtsi"

/ {
	compatible = "avm,fritz5490", "lantiq,xway", "lantiq,vr9";
	model = "AVM FRITZ!Box 5490/5491";
};

&aliases {
	led-wifi = &led_wifi;
};

&leds {
	fiber {
		function = "fiber";
		color = <LED_COLOR_ID_GREEN>;
		gpios = <&gpio 47 GPIO_ACTIVE_LOW>;
	};

	led_wifi: wifi {
		function = LED_FUNCTION_WLAN;
		color = <LED_COLOR_ID_GREEN>;
		gpios = <&gpio 36 GPIO_ACTIVE_LOW>;
	};

	fon {
		function = "fon";
		color = <LED_COLOR_ID_GREEN>;
		gpios = <&gpio 35 GPIO_ACTIVE_LOW>;
	};
};

&gswip_mdio {
	phy2: ethernet-phy@1 {
		reg = <0x01>;
	};

	phy3: ethernet-phy@2 {
		reg = <0x02>;
	};

	phy5: ethernet-phy@5 {
		reg = <0x05>;
	};

	phy6: ethernet-phy@6 {
		reg = <0x06>;
		reset-gpios = <&gpio 32 GPIO_ACTIVE_LOW>;
	};

	phy9: ethernet-phy@9 {
		reg = <0x09>;
	};

	ethernet-switch@10 {
		compatible = "qca,qca8334";
		reg = <0x10>;
		reset-gpios = <&gpio 44 GPIO_ACTIVE_LOW>;

		dsa,member = <1 0>;

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-port@0 {
				reg = <0>;
				ethernet = <&rgmii0>;
				phy-mode = "rgmii-txid";
				tx-internal-delay-ps = <3000>;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			ethernet-port@2 {
				reg = <2>;
				label = "lan3";
				phy-handle = <&phy2>;
			};

			ethernet-port@3 {
				reg = <3>;
				label = "lan4";
				phy-handle = <&phy3>;
			};
		};
	};
};

&gswip_ports {
	port@0 {
		reg = <0>;
		label = "wan";
		phy-mode = "rgmii-rxid";
		phy-handle = <&phy6>;
	};

	rgmii0: port@1 {
		reg = <1>;
		label = "sw0";
		phy-mode = "rgmii";

		fixed-link {
			speed = <1000>;
			full-duplex;
		};
	};

	port@2 {
		reg = <2>;
		label = "lan2";
		phy-mode = "internal";
		phy-handle = <&phy5>;
	};

	port@4 {
		reg = <4>;
		label = "lan1";
		phy-mode = "internal";
		phy-handle = <&phy9>;
	};
};
