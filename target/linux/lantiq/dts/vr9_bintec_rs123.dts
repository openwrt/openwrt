/*
 * Based on the Bintec RS353 device tree from the openwrt-RS353 project
 * by Sebastien Decourriere (https://github.com/armSeb/openwrt-RS353).
 */

#include "vr9.dtsi"

#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/mips/lantiq_rcu_gphy.h>

/ {
	compatible = "bintec,rs123", "lantiq,xway", "lantiq,vr9";
	model = "bintec elmeg RS123";

	chosen {
		bootargs = "console=ttyLTQ0,115200";
	};

	aliases {
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_status;
		led-upgrade = &led_status;
	};

	leds {
		compatible = "gpio-leds";

		led_status: led-status {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 12 GPIO_ACTIVE_LOW>;
			default-state = "keep";
		};

		led-usb {
			function = LED_FUNCTION_USB;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 11 GPIO_ACTIVE_LOW>;
			trigger-sources = <&ehci_port2>;
			linux,default-trigger = "usbport";
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x8000000>;	/* 128 MB, confirmed by bootmonitor selftest */
	};

	i2c: i2c {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio 20 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 19 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;	/* ~100 kHz */

		#address-cells = <1>;
		#size-cells = <0>;

		rtc@30 {
			compatible = "sii,s35390a";
			reg = <0x30>;
		};
	};

	/*
	 * The SFP cage shares GSWIP port 5 with the copper PHY behind ETH5,
	 * so only one of the two can be used at a time. The cage is a fixed
	 * 1000BASE-X port and needs an optical module. Only the i2c bus and
	 * the module-presence pin are known: LOS was measured as not wired
	 * to a SoC GPIO, and TX-fault/TX-disable could not be identified.
	 */
	sfp: sfp {
		compatible = "sff,sfp";
		i2c-bus = <&i2c>;
		mod-def0-gpios = <&gpio 37 GPIO_ACTIVE_LOW>;
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		reset {
			label = "reset";
			gpios = <&gpio 34 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		function {
			label = "function";
			gpios = <&gpio 35 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_0>;
		};
	};

	usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";

		regulator-name = "USB_VBUS";

		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;

		gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
	};
};

&eth0 {
	nvmem-cells = <&macaddr_boardconfig_428 0>;
	nvmem-cell-names = "mac-address";
};

&gphy0 {
	lantiq,gphy-mode = <GPHY_MODE_GE>;
};

&gphy1 {
	lantiq,gphy-mode = <GPHY_MODE_GE>;
};

&gpio {
	pinctrl-names = "default";
	pinctrl-0 = <&state_default>;

	state_default: pinmux {
		i2c {
			lantiq,pins = "io19", "io20";
			lantiq,open-drain;
			lantiq,pull = <2>;
		};
	};
};

&gswip {
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
};

&gswip_mdio {
	phy0: ethernet-phy@0 {
		reg = <0x0>;
	};
	phy1: ethernet-phy@1 {
		reg = <0x1>;
	};
	phy2: ethernet-phy@2 {
		reg = <0x2>;
	};
	phy11: ethernet-phy@11 {
		reg = <0x11>;
	};
	phy13: ethernet-phy@13 {
		reg = <0x13>;
	};
};

/* Slot 1 of the vendor firmware reports "GETH4+1", i.e. five GbE ports. */
&gswip_ports {
	port@0 {
		reg = <0>;
		label = "lan4";
		phy-mode = "rgmii-id";
		rx-internal-delay-ps = <2000>;
		tx-internal-delay-ps = <2000>;
		phy-handle = <&phy1>;
	};
	port@1 {
		reg = <1>;
		label = "lan3";
		phy-mode = "rgmii-id";
		rx-internal-delay-ps = <2000>;
		tx-internal-delay-ps = <2000>;
		phy-handle = <&phy0>;
	};
	port@2 {
		reg = <2>;
		label = "lan2";
		phy-mode = "internal";
		phy-handle = <&phy11>;
	};
	port@4 {
		reg = <4>;
		label = "lan1";
		phy-mode = "internal";
		phy-handle = <&phy13>;
	};
	port@5 {
		reg = <5>;
		label = "lan5";
		phy-mode = "rgmii-id";
		rx-internal-delay-ps = <2000>;
		tx-internal-delay-ps = <2000>;
		phy-handle = <&phy2>;
	};
};

&localbus {
	flash@0 {
		compatible = "lantiq,nor";
		bank-width = <2>;
		reg = <0 0x0 0x2000000>;	/* 32 MB, confirmed by bootmonitor */
		/* the bootmonitor leaves the EBU's own address swap enabled */
		lantiq,ebu-swap-check;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			boardconfig: partition@0 {
				label = "logic_config";
				reg = <0x0 0x20000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_boardconfig_428: macaddr@428 {
						compatible = "mac-base";
						reg = <0x428 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@20000 {
				label = "logic_addr";
				reg = <0x20000 0x20000>;
				read-only;
			};

			partition@40000 {
				label = "bootmonitor";
				reg = <0x40000 0x20000>;
				read-only;
			};

			partition@80000 {
				label = "flash_config";
				reg = <0x80000 0x40000>;
				read-only;
			};

			partition@c0000 {
				compatible = "bintec,boss-firmware";
				label = "firmware";
				reg = <0xc0000 0x1f40000>;
			};
		};
	};
};

/* The single USB socket is on the second controller. */
&usb_phy1 {
	status = "okay";
};

&usb1 {
	status = "okay";
	vbus-supply = <&usb_vbus>;
};
