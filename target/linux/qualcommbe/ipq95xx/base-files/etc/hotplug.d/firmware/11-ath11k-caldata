#!/bin/sh

[ -e /lib/firmware/$FIRMWARE ] && exit 0

. /lib/functions/caldata.sh
. /lib/functions/system.sh

board=$(board_name)

case "$FIRMWARE" in
"ath11k/IPQ9574/hw1.0/cal-ahb-c000000.wifi.bin")
	case "$board" in
	tplink,archer-be550-v1)
		caldata_extract "0:art" 0x1000 0x20000
		label_mac=$(get_mac_binary "/tmp/tp_data/default-mac" 0)
		[ -n "$label_mac" ] && ath11k_patch_mac "$(macaddr_add "$label_mac" 2)" 0
		ath11k_set_macflag
		ath11k_remove_regdomain
		;;
	esac
	;;
*)
	exit 1
	;;
esac
