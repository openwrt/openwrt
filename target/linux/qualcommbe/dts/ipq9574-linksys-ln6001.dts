/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "ipq9574.dtsi"

/ {
	model = "Linksys LN6001";
	compatible = "linksys,ln6001", "qcom,ipq9574";

	aliases {
		serial0 = &blsp1_uart2;
		led-boot = &led_blue;
		led-failsafe = &led_red;
		led-running = &led_blue;
		led-upgrade = &led_blue;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x40000000>;
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&keys_pins>;
		pinctrl-names = "default";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 40 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		button-wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "pwm-leds";

		led_red: led-0 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			pwms = <&pwm 0 1250000 0>;
			max-brightness = <255>;
		};

		led_green: led-1 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			pwms = <&pwm 1 1250000 0>;
			max-brightness = <255>;
		};

		led_blue: led-2 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			pwms = <&pwm 2 1250000 0>;
			max-brightness = <255>;
		};

		led_white: led-3 {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_STATUS;
			pwms = <&pwm 3 1250000 0>;
			max-brightness = <255>;
		};
	};
};

&blsp1_uart2 {
	pinctrl-0 = <&uart2_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&mdio {
	clock-frequency = <6250000>;
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 60 GPIO_ACTIVE_LOW>;
	status = "okay";

	ethernet-phy-package@10 {
		compatible = "qcom,qca8075-package";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x10>;

		qca8075_0: ethernet-phy@10 {
			reg = <0x10>;
		};

		qca8075_1: ethernet-phy@11 {
			reg = <0x11>;
		};

		qca8075_2: ethernet-phy@12 {
			reg = <0x12>;
		};

		qca8075_3: ethernet-phy@13 {
			reg = <0x13>;
		};
	};

	qca8081: ethernet-phy@1c {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0x1c>;
		reset-assert-us = <40>;
		reset-deassert-us = <150000>;
		reset-gpios = <&tlmm 36 GPIO_ACTIVE_LOW>;
	};
};

&pwm {
	pinctrl-0 = <&pwm_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&qcom_ppe {
	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		lan1: port@1 {
			reg = <1>;
			label = "lan1";
			phy-mode = "psgmii";
			managed = "in-band-status";
			phy-handle = <&qca8075_0>;
			pcs-handle = <&pcs0_ch0>;
			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT1_MAC_ARES>,
				 <&nsscc PORT1_RX_ARES>,
				 <&nsscc PORT1_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		lan2: port@2 {
			reg = <2>;
			label = "lan2";
			phy-mode = "psgmii";
			managed = "in-band-status";
			phy-handle = <&qca8075_1>;
			pcs-handle = <&pcs0_ch1>;
			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
				 <&nsscc NSS_CC_PORT2_RX_CLK>,
				 <&nsscc NSS_CC_PORT2_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT2_MAC_ARES>,
				 <&nsscc PORT2_RX_ARES>,
				 <&nsscc PORT2_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		lan3: port@3 {
			reg = <3>;
			label = "lan3";
			phy-mode = "psgmii";
			managed = "in-band-status";
			phy-handle = <&qca8075_2>;
			pcs-handle = <&pcs0_ch2>;
			clocks = <&nsscc NSS_CC_PORT3_MAC_CLK>,
				 <&nsscc NSS_CC_PORT3_RX_CLK>,
				 <&nsscc NSS_CC_PORT3_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT3_MAC_ARES>,
				 <&nsscc PORT3_RX_ARES>,
				 <&nsscc PORT3_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		lan4: port@4 {
			reg = <4>;
			label = "lan4";
			phy-mode = "psgmii";
			managed = "in-band-status";
			phy-handle = <&qca8075_3>;
			pcs-handle = <&pcs0_ch3>;
			clocks = <&nsscc NSS_CC_PORT4_MAC_CLK>,
				 <&nsscc NSS_CC_PORT4_RX_CLK>,
				 <&nsscc NSS_CC_PORT4_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT4_MAC_ARES>,
				 <&nsscc PORT4_RX_ARES>,
				 <&nsscc PORT4_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		wan: port@6 {
			reg = <6>;
			label = "wan";
			phy-mode = "sgmii";
			managed = "in-band-status";
			phy-handle = <&qca8081>;
			pcs-handle = <&pcs2_ch0>;
			clocks = <&nsscc NSS_CC_PORT6_MAC_CLK>,
				 <&nsscc NSS_CC_PORT6_RX_CLK>,
				 <&nsscc NSS_CC_PORT6_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT6_MAC_ARES>,
				 <&nsscc PORT6_RX_ARES>,
				 <&nsscc PORT6_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};
	};
};

&sdhc_1 {
	bus-width = <8>;
	max-frequency = <384000000>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	status = "okay";
};

&sleep_clk {
	clock-frequency = <32000>;
};

&tlmm {
	keys_pins: keys-state {
		pins = "gpio37", "gpio40";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	pwm_pins: pwm-state {
		blue-pins {
			pins = "gpio46";
			function = "pwm";
			drive-strength = <8>;
		};

		green-pins {
			pins = "gpio45";
			function = "pwm";
			drive-strength = <8>;
		};

		red-pins {
			pins = "gpio44";
			function = "pwm";
			drive-strength = <8>;
		};

		white-pins {
			pins = "gpio47";
			function = "pwm";
			drive-strength = <8>;
		};
	};

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio5";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio4";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio0", "gpio1", "gpio2", "gpio3",
			       "gpio6", "gpio7", "gpio8", "gpio9";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};

		rclk-pins {
			pins = "gpio10";
			function = "sdc_rclk";
			drive-strength = <8>;
			bias-pull-down;
		};
	};
};
