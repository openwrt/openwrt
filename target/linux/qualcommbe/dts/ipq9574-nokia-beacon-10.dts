/dts-v1/;

#include "ipq9574.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Nokia Beacon 10";
	compatible = "nokia,beacon-10", "qcom,ipq9574";

	aliases {
		led-boot = &led_power_green;
		led-failsafe = &led_power_red;
		led-running = &led_power_green;
		led-upgrade = &led_power_red;
		serial0 = &blsp1_uart2;
	};

	chosen {
		bootargs = "console=ttyMSM0,115200n8";
		stdout-path = "serial0:115200n8";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&keys_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 50 GPIO_ACTIVE_LOW>;
			debounce-interval = <30>;
		};

		wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;
			debounce-interval = <30>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led-internet-amber {
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
		};

		led-internet-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
		};

		led-internet-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
		};

		led-power-amber {
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 57 GPIO_ACTIVE_HIGH>;
		};

		led_power_green: led-power-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_power_red: led-power-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 55 GPIO_ACTIVE_HIGH>;
		};

		led-wlan-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
		};

		led-wps-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WPS;
			gpios = <&tlmm 28 GPIO_ACTIVE_HIGH>;
		};

		led-wps-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WPS;
			gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
		};
	};

	reserved-memory {
		tzapp@49b00000 {
			reg = <0x0 0x49b00000 0x0 0x00600000>;
			no-map;
		};
	};
};

&blsp1_uart2 {
	pinctrl-0 = <&uart2_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&mdio {
	status = "okay";

	ethernet-phy-package@0 {
		compatible = "qcom,qca8075-package";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;
		qcom,package-mode = "qsgmii";

		qca8075_0: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0>;
		};

		qca8075_1: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
		};

		qca8075_2: ethernet-phy@2 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <2>;
		};

		qca8075_3: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;
		};
	};

	rtl8221b: ethernet-phy@7 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <7>;
	};

	rtl8261n: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <8>;
	};
};

&pcie2 {
	perst-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie@0 {
		device_type = "pci";
		reg = <0 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0,0 {
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;
			qcom,calibration-variant = "Nokia-Beacon-10-5G";
			nvmem-cells = <&caldata_5g>, <&macaddr_ri 10>;
			nvmem-cell-names = "calibration", "mac-address";
		};
	};
};

&pcie2_phy {
	status = "okay";
};

&pcie3 {
	perst-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie@0 {
		device_type = "pci";
		reg = <0 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0,0 {
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;
			qcom,calibration-variant = "Nokia-Beacon-10-6G";
			nvmem-cells = <&caldata_6g>, <&macaddr_ri 12>;
			nvmem-cell-names = "calibration", "mac-address";
		};
	};
};

&pcie3_phy {
	status = "okay";
};

&pcs0 {
	status = "okay";
};

&pcs1 {
	status = "okay";
};

&pcs2 {
	status = "okay";
};

&q6v5_wcss {
	status = "okay";
};

&qcom_ppe {
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			phy-mode = "qsgmii";
			phy-handle = <&qca8075_0>;
			pcs-handle = <&pcs0_ch0>;
			managed = "in-band-status";
			label = "lan3";
			nvmem-cells = <&macaddr_ri 4>;
			nvmem-cell-names = "mac-address";
			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT1_MAC_ARES>,
				 <&nsscc PORT1_RX_ARES>,
				 <&nsscc PORT1_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		port@2 {
			reg = <2>;
			phy-mode = "qsgmii";
			phy-handle = <&qca8075_1>;
			pcs-handle = <&pcs0_ch1>;
			managed = "in-band-status";
			label = "lan2";
			nvmem-cells = <&macaddr_ri 3>;
			nvmem-cell-names = "mac-address";
			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
				 <&nsscc NSS_CC_PORT2_RX_CLK>,
				 <&nsscc NSS_CC_PORT2_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT2_MAC_ARES>,
				 <&nsscc PORT2_RX_ARES>,
				 <&nsscc PORT2_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		port@5 {
			reg = <5>;
			phy-mode = "2500base-x";
			phy-handle = <&rtl8221b>;
			pcs-handle = <&pcs1_ch0>;
			label = "lan1";
			nvmem-cells = <&macaddr_ri 2>;
			nvmem-cell-names = "mac-address";
			clocks = <&nsscc NSS_CC_PORT5_MAC_CLK>,
				 <&nsscc NSS_CC_PORT5_RX_CLK>,
				 <&nsscc NSS_CC_PORT5_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT5_MAC_ARES>,
				 <&nsscc PORT5_RX_ARES>,
				 <&nsscc PORT5_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		port@6 {
			reg = <6>;
			phy-mode = "usxgmii";
			phy-handle = <&rtl8261n>;
			pcs-handle = <&pcs2_ch0>;
			managed = "in-band-status";
			label = "wan";
			nvmem-cells = <&macaddr_ri 1>;
			nvmem-cell-names = "mac-address";
			clocks = <&nsscc NSS_CC_PORT6_MAC_CLK>,
				 <&nsscc NSS_CC_PORT6_RX_CLK>,
				 <&nsscc NSS_CC_PORT6_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT6_MAC_ARES>,
				 <&nsscc PORT6_RX_ARES>,
				 <&nsscc PORT6_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};
	};
};

&ref_48mhz_clk {
	clock-div = <1>;
	clock-mult = <1>;
};

&rpm_requests {
	regulators {
		compatible = "qcom,rpm-mp5496-regulators";

		ipq9574_s1: s1 {
			regulator-min-microvolt = <725000>;
			regulator-max-microvolt = <1075000>;
		};
	};
};

&sdhc_1 {
	#address-cells = <1>;
	#size-cells = <0>;	bus-width = <8>;
	max-frequency = <96000000>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	status = "okay";

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

		partitions {
			compatible = "gpt-partitions";

			partition-art {
				partname = "0:ART";

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					caldata_2g: calibration@1000 {
						reg = <0x1000 0x20000>;
					};

					caldata_5g: calibration@26800 {
						reg = <0x26800 0x20000>;
					};

					caldata_6g: calibration@4c000 {
						reg = <0x4c000 0x20000>;
					};
				};
			};

			partition-ri {
				partname = "RI";

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_ri: mac-address@440 {
						compatible = "mac-base";
						reg = <0x440 0x11>;
						#nvmem-cell-cells = <1>;
					};
				};
			};
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&tlmm {
	keys_pins: keys-state {
		pins = "gpio37", "gpio50";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	leds_pins: leds-state {
		pins = "gpio22", "gpio23", "gpio24", "gpio28",
		       "gpio30", "gpio31", "gpio55", "gpio56", "gpio57";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	/* Release the shared active-low package reset before MDIO enumeration. */
	qca8075-reset-hog {
		gpio-hog;
		gpios = <60 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "qca8075-reset-n";
	};

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio5";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio4";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio0", "gpio1", "gpio2", "gpio3",
			       "gpio6", "gpio7", "gpio8", "gpio9";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};

		rclk-pins {
			pins = "gpio10";
			function = "sdc_rclk";
			drive-strength = <8>;
			bias-pull-down;
		};
	};
};

&wifi0 {
	qcom,calibration-variant = "Nokia-Beacon-10";
	nvmem-cells = <&caldata_2g>, <&macaddr_ri 9>;
	nvmem-cell-names = "calibration", "mac-address";
	status = "okay";
};

&xo_board_clk {
	clock-div = <2>;
	clock-mult = <1>;
};

&xo_clk {
	clock-frequency = <48000000>;
};
