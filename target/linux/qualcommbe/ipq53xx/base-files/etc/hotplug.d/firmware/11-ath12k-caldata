#!/bin/sh

[ -e /lib/firmware/$FIRMWARE ] && exit 0

. /lib/functions/caldata.sh

board=$(board_name)

case "$FIRMWARE" in
"ath12k/QCN9274/hw2.0/cal-pci-0001:01:00.0.bin")
	case "$board" in
	ubnt,u7-pro-xgs)
		caldata_extract "0:ART" 0x58800 0x20000
		;;
	esac
	;;
"ath12k/QCN9274/hw2.0/cal-pci-0002:01:00.0.bin")
	case "$board" in
	ubnt,u7-pro-xgs)
		caldata_extract "0:ART" 0x8a800 0x20000
		;;
	esac
	;;
*)
	exit 1
	;;
esac
