+			flow->eport = tunnel->underlay_port;
+			ether_addr_copy(nh.mac, tunnel->remote_mac);
+		}
+	}
 
 	if (flow->entry.is_ipv6) {
 		/* The hardware routes IPv6 but has no NAT66. Mangles of
@@ -1495,7 +1866,7 @@ static int ppe_ft_flow_replace(struct pp
 	 * reverse direction ingresses on; the egress L3 interface
 	 * provides the rewrite.
 	 */
-	if (!is_zero_ether_addr(data.eth.src)) {
