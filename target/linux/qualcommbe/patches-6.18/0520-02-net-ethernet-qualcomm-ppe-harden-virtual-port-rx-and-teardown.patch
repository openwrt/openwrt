+++ b/drivers/net/ethernet/qualcomm/ppe/ppe.c
@@ -272,6 +272,11 @@ static void qcom_ppe_remove(struct platf
 	struct ppe_device *ppe_dev;
 
 	ppe_dev = platform_get_drvdata(pdev);
+
+	/* Stop wireless injection before its borrowed carrier netdevs and TX
+	 * rings can be unregistered. Full VP teardown follows flow flushing.
+	 */
+	ppe_vp_inject_disable(ppe_dev);
 	ppe_port_mac_deinit(ppe_dev);
 
 	/* Netdevice teardown unbinds the flow blocks and quiesces their
