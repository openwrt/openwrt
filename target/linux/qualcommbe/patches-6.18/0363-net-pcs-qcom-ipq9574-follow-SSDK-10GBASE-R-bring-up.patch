From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alex Rau <alex@retroduction.org>
Date: Sun, 18 Oct 2026 22:00:00 +0000
Subject: [PATCH] net: pcs: qcom-ipq9574: follow the SSDK 10GBASE-R bring-up

Bring the 10GBASE-R configuration sequence in line with the vendor SSDK
(adpt_hppe_uniphy_mode_set, 10GBASE-R case, as shipped on the Ubiquiti
UCG-Fiber):

- Keep the uniphy port clocks disabled across the reconfiguration and
  re-enable them after calibration, before releasing the XPCS reset, as
  already done for USXGMII.

- Do not pulse the analog software reset (PCS_PLL_RESET bit 6); the
  SSDK does no analog reset in this mode.

- Select in-band link detection instead of the SFP loss-of-signal
  input; the stock firmware leaves this field at 0 on its working
  10GBASE-R links (both the SFP+ port and the switch link).

The final register state already matched the vendor firmware; only the
sequence differed. Other interface modes keep the previous behaviour.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Alex Rau <alex@retroduction.org>

---
--- a/drivers/net/pcs/pcs-qcom-ipq9574.c
+++ b/drivers/net/pcs/pcs-qcom-ipq9574.c
@@ -305,13 +305,22 @@ static void ipq_pcs_get_state_10gbaser(s
 	state->pause |= MLO_PAUSE_TXRX_MASK;
 }
 
-/* Re-enable the port clocks held off across a USXGMII reconfiguration */
+/* The SSDK holds the uniphy port clocks off while it reconfigures the
+ * uniphy for USXGMII and for 10GBASE-R.
+ */
+static bool ipq_pcs_gates_port_clks(phy_interface_t interface)
+{
+	return interface == PHY_INTERFACE_MODE_USXGMII ||
+	       interface == PHY_INTERFACE_MODE_10GBASER;
+}
+
+/* Re-enable the port clocks held off across the reconfiguration */
 static int ipq_pcs_restore_port_clks(struct ipq_pcs *qpcs,
 				     phy_interface_t interface)
 {
 	int ret;
 
-	if (interface != PHY_INTERFACE_MODE_USXGMII || !qpcs->qpcs_mii[0])
+	if (!ipq_pcs_gates_port_clks(interface) || !qpcs->qpcs_mii[0])
 		return 0;
 
 	ret = clk_prepare_enable(qpcs->qpcs_mii[0]->rx_clk);
@@ -330,7 +339,7 @@ static int ipq_pcs_config_mode(struct ip
 	int ret;
 
 	/* The port clocks must be held off across the reconfiguration */
-	if (interface == PHY_INTERFACE_MODE_USXGMII && qpcs->qpcs_mii[0]) {
+	if (ipq_pcs_gates_port_clks(interface) && qpcs->qpcs_mii[0]) {
 		clk_disable_unprepare(qpcs->qpcs_mii[0]->rx_clk);
 		clk_disable_unprepare(qpcs->qpcs_mii[0]->tx_clk);
 	}
@@ -398,8 +407,11 @@ static int ipq_pcs_config_mode(struct ip
 			goto err_clk;
 	}
 
-	/* Link detection is in-band; there is no SFP LOS input here */
-	if (interface == PHY_INTERFACE_MODE_USXGMII) {
+	/* Link detection is in-band; do not select the SFP loss-of-signal
+	 * input (the SFP cage LOS is handled by the sfp driver over GPIO).
+	 */
+	if (interface == PHY_INTERFACE_MODE_USXGMII ||
+	    interface == PHY_INTERFACE_MODE_10GBASER) {
 		ret = regmap_update_bits(qpcs->regmap, PCS_LINK_DETECT,
 					 PCS_DETECT_LOS_FROM_SFP, 0);
 		if (ret)
@@ -435,7 +447,8 @@ static int ipq_pcs_config_mode(struct ip
 			goto err_clk;
 
 		msleep(100);
-	} else {
+	} else if (interface != PHY_INTERFACE_MODE_10GBASER) {
+		/* The SSDK does no analog reset in its 10GBASE-R path */
 		ret = regmap_clear_bits(qpcs->regmap, PCS_PLL_RESET,
 					PCS_ANA_SW_RESET);
 		if (ret)
