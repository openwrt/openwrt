 		default:
 			ret = -EOPNOTSUPP;
 			goto err_free;
@@ -1938,7 +2018,10 @@ static int ppe_ft_flow_replace(struct pp
 			ret = -EOPNOTSUPP;
 			goto err_free;
 		}
-		if (ppe_ft_ipip6_dev(odev)) {
