 			goto err_free;
 		}
-		if (tunnel_encap)
+		if (tunnel_encap && !lwt_tunnel)
 			dev_hold(tdev);
 	}
 
@@ -2006,7 +2089,7 @@ static int ppe_ft_flow_replace(struct pp
 		ether_addr_copy(nh.mac, data.eth.dst);
 	}
 
-	if (tunnel_flow) {
+	if (tunnel_flow && !lwt_tunnel) {
 		struct ip6_tnl_flow_offload_key key = {
 			.addr = tunnel_encap ? flow->entry.dip.ip4 :
 					       flow->entry.sip.ip4,
@@ -2020,7 +2103,7 @@ static int ppe_ft_flow_replace(struct pp
 		if (ret || ipv6_addr_any(&tnl_info.local) ||
 		    ipv6_addr_any(&tnl_info.remote)) {
 			ret = -EOPNOTSUPP;
-			goto err_tdev;
+			goto err_prelock_ivp;
 		}
 	}
 
@@ -2031,12 +2114,29 @@ static int ppe_ft_flow_replace(struct pp
 	 */
 	mutex_lock(&ft->lock);
 	if (tunnel_flow) {
-		flow->tunnel = ppe_ft_tunnel_get(ft, tdev,
-						 &tnl_info.local,
-						 &tnl_info.remote,
-						 tnl_info.link,
-						 tnl_info.hop_limit,
-						 tnl_info.mtu);
+		struct in6_addr local, remote;
