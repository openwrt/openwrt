+/**
+ * ppe_flowtable_debugfs_init - Expose the flowtable state in debugfs
+ * @ppe_dev: PPE device
+ *
+ * Called by the PPE debugfs setup once the root directory exists.
+ * ppe_flowtable_destroy() removes the file again before the flowtable
+ * is freed, ahead of the recursive root removal.
+ */
+void ppe_flowtable_debugfs_init(struct ppe_device *ppe_dev)
+{
+	struct ppe_flowtable *ft = ppe_dev->flowtable;
+
+	if (!ft)
+		return;
+
+	ft->debugfs = debugfs_create_file("flows", 0400,
+					  ppe_dev->debugfs_root, ft,
+					  &ppe_ft_flows_fops);
+	ft->debugfs_rows = debugfs_create_file("flow_rows", 0400,
+					       ppe_dev->debugfs_root, ft,
+					       &ppe_ft_flow_rows_fops);
+	ft->debugfs_pipeline = debugfs_create_file("pipeline_state", 0400,
+						   ppe_dev->debugfs_root, ft,
+						   &ppe_ft_pipeline_state_fops);
+	ft->debugfs_reasons = debugfs_create_file("reason_counters", 0400,
+						  ppe_dev->debugfs_root, ft,
+						  &ppe_ft_reason_counters_fops);
+}
