+static void ppe_ft_host_ip6_decode(struct in6_addr *addr, const u32 *host)
+{
+	u32 ip[4];
+	int i;
+
+	ip[0] = FIELD_GET(PPE_HOST_V6_W0_IP_ADDR_0, host[0]);
+	ip[0] |= (host[1] & GENMASK(21, 0)) << 10;
+	ip[1] = host[1] >> 22 | (host[2] & GENMASK(21, 0)) << 10;
+	ip[2] = host[2] >> 22 | (host[3] & GENMASK(21, 0)) << 10;
+	ip[3] = host[3] >> 22 |
+		FIELD_GET(PPE_HOST_V6_W4_IP_ADDR_4, host[4]) << 10;
+	for (i = 0; i < 4; i++)
+		addr->s6_addr32[3 - i] = cpu_to_be32(ip[i]);
+}
+
+static void ppe_ft_flow_ip6_decode(struct in6_addr *addr, const u32 *flow)
+{
+	u32 ip[4];
+	int i;
+
+	ip[0] = FIELD_GET(PPE_FLOW_V6_W4_IP_ADDR_0, flow[4]);
+	ip[0] |= (flow[5] & GENMASK(11, 0)) << 20;
+	ip[1] = flow[5] >> 12 | (flow[6] & GENMASK(11, 0)) << 20;
+	ip[2] = flow[6] >> 12 | (flow[7] & GENMASK(11, 0)) << 20;
+	ip[3] = flow[7] >> 12 |
+		FIELD_GET(PPE_FLOW_V6_W8_IP_ADDR_4, flow[8]) << 20;
+	for (i = 0; i < 4; i++)
+		addr->s6_addr32[3 - i] = cpu_to_be32(ip[i]);
+}
+
