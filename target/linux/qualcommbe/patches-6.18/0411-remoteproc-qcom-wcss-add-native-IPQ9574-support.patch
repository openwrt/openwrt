+static int q6v7_q6_powerdown(struct q6v5_wcss *wcss)
+{
+	u32 val;
+	int ret, wcss_ret;
+
+	q6v5_wcss_halt_axi_port(wcss, wcss->halt_map, wcss->halt_q6);
+
+	/* Disable Q6 Core clock */
+	val = readl(wcss->reg_base + Q6SS_GFMUX_CTL_REG);
+	val &= ~Q6SS_CLK_SRC_MUX;
+	writel(val, wcss->reg_base + Q6SS_GFMUX_CTL_REG);
+
+	clk_bulk_disable_unprepare(wcss->num_clks, wcss->clks);
+	clk_bulk_disable_unprepare(wcss->num_pre_boot_clks,
+				   wcss->pre_boot_clks);
+
+	ret = reset_control_assert(wcss->wcss_q6_reset);
+	usleep_range(1000, 2000);
+	wcss_ret = reset_control_assert(wcss->wcss_reset);
+	if (ret || wcss_ret) {
+		wcss->restart_blocked = true;
+		return ret ? ret : wcss_ret;
+	}
+
+	return 0;
+}
