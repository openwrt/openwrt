+			wcss->restart_blocked = true;
+			dev_err(wcss->dev, "stop request failed: %d\n", ret);
+			return ret;
+		}
 		if (ret == -ETIMEDOUT) {
 			dev_err(wcss->dev, "timed out on wait\n");
 			return ret;
 		}
 	}
 
