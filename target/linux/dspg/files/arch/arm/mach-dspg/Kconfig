config ARCH_DSPG
	bool "DSP Group DVF SoC support"
	depends on ARCH_MULTI_V5
	depends on CPU_LITTLE_ENDIAN
	select ARM_TIMER_SP804
	select COMMON_CLK_DVF99
	select DSPG_PLICU
	select PINCTRL
	select PINCTRL_DVF99
	select TIMER_OF
	help
	  Support for the DSP Group DVF99 SoC family, used in Snom desk
	  phones.
