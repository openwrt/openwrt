+	.pwd = AR724X_PLL_PCIE_CONFIG_PLL_RESET,
+	.bypass = AR724X_PLL_PCIE_CONFIG_PLL_BYPASS,
+	.updating = AR724X_PLL_PCIE_CONFIG_UPDATING,
+};
