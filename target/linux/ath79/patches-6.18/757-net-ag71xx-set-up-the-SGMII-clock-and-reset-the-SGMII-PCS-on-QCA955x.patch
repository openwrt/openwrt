From: Rosen Penev <rosenp@gmail.com>
Date: Thu, 12 Nov 2026 19:07:32 -0800
Subject: [PATCH] net: ag71xx: set up the SGMII clock and reset the SGMII PCS
 on QCA955x

The MAC on the SGMII side of the QCA955x is clocked by ETH_SGMII in the
PLL block rather than ETH_XMII_CONTROL. Its reset value selects the
125 MHz source and gigabit mode (QCA9558 datasheet, 10.6.18), so links
at 10 or 100 Mbit/s do not work unless the bootloader set the register
up for them. Program it like ETH_XMII_CONTROL, with its extra GIGE bit
at 1000 Mbit/s.

The SGMII PCS can also come out of a MAC reset in a state in which it
does not pass frames. The QCA reference code and the OpenWrt driver
reset it on every link up, then reset its PHY side until the transmit
state machine in the undocumented SGMII_DEBUG register is idle or
sending data. Do the same when the MAC has the GMAC block.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Rosen Penev <rosenp@gmail.com>
---
 drivers/net/ethernet/atheros/ag71xx.c | 101 ++++++++++++++++++++++++--
 1 file changed, 96 insertions(+), 5 deletions(-)

--- a/drivers/net/ethernet/atheros/ag71xx.c
+++ b/drivers/net/ethernet/atheros/ag71xx.c
@@ -86,6 +86,22 @@
 #define QCA956X_ETH_CFG_SW_PHY_SWAP	BIT(8)
 #define QCA956X_ETH_CFG_SW_PHY_ADDR_SWAP	BIT(9)
 
+/* SGMII PCS of QCA955x in the GMAC block */
+#define QCA955X_GMAC_REG_SGMII_RESET	0x14
+#define QCA955X_SGMII_RESET_RX_CLK_N	BIT(0)
+#define QCA955X_SGMII_RESET_TX_CLK_N	BIT(1)
+#define QCA955X_SGMII_RESET_RX_125M_N	BIT(2)
+#define QCA955X_SGMII_RESET_TX_125M_N	BIT(3)
+#define QCA955X_SGMII_RESET_HW_RX_125M_N	BIT(4)
+#define QCA955X_GMAC_REG_MR_AN_CONTROL	0x1c
+#define QCA955X_MR_AN_CONTROL_AN_ENABLE	BIT(12)
+#define QCA955X_MR_AN_CONTROL_PHY_RESET	BIT(15)
+#define QCA955X_GMAC_REG_MR_AN_STATUS	0x20
+#define QCA955X_MR_AN_STATUS_AN_ABILITY	BIT(3)
+#define QCA955X_GMAC_REG_SGMII_DEBUG	0x58
+#define QCA955X_SGMII_DEBUG_TX_STATE	GENMASK(7, 0)
+#define QCA955X_SGMII_RESET_TRIES	20
+
 /* ETH_XMII_CONTROL in the PLL block of AR934x and QCA955x */
 #define ETH_XMII_TX_INVERT		BIT(31)
 #define ETH_XMII_GIGE_QUAD		BIT(30)
@@ -95,6 +111,12 @@
 #define ETH_XMII_PHASE1_CNT		GENMASK(15, 8)
 #define ETH_XMII_PHASE0_CNT		GENMASK(7, 0)
 
+/*
+ * ETH_SGMII in the PLL block of QCA955x has the layout of ETH_XMII_CONTROL,
+ * where ETH_XMII_GIGE selects the 125 MHz source clock, and a GIGE bit.
+ */
+#define ETH_SGMII_GIGE			BIT(24)
+
 #define ETH_XMII_RX_DELAY_STEP_PS	900
 #define ETH_XMII_TX_DELAY_STEP_PS	800
 #define ETH_XMII_GIGE_QUAD_PS		2000
@@ -378,6 +400,8 @@ struct ag71xx_dcfg {
 	enum ag71xx_type type;
 	/* ETH_XMII_CONTROL in the PLL block, 0 if not supported */
 	unsigned int xmii_reg;
+	/* ETH_SGMII in the PLL block, 0 if not supported */
+	unsigned int sgmii_reg;
 	/* ETH_CFG bits of the switch PHY swap, 0 if not supported */
 	u32 phy_swap;
 	u32 phy_addr_swap;
@@ -421,6 +445,8 @@ struct ag71xx {
 
 	struct regmap *gmac;
 	struct regmap *pll;
+	/* ETH_XMII_CONTROL or ETH_SGMII, whichever clocks this MAC */
+	unsigned int xmii_reg;
 	u32 xmii_cfg;
 	bool xmii_gige_quad;
 };
@@ -1038,6 +1064,8 @@ static void ag71xx_xmii_set_speed(struct
 		val |= ETH_XMII_GIGE;
 		if (ag->xmii_gige_quad)
 			val |= ETH_XMII_GIGE_QUAD;
+		if (ag->phy_if_mode == PHY_INTERFACE_MODE_SGMII)
+			val |= ETH_SGMII_GIGE;
 		break;
 	case SPEED_100:
 		val |= FIELD_PREP(ETH_XMII_PHASE1_CNT, 0x01) |
@@ -1049,7 +1077,59 @@ static void ag71xx_xmii_set_speed(struct
 		break;
 	}
 
-	regmap_write(ag->pll, ag->dcfg->xmii_reg, val);
+	regmap_write(ag->pll, ag->xmii_reg, val);
+}
+
+static void ag71xx_gmac_set(struct ag71xx *ag, unsigned int reg, u32 bits)
+{
+	regmap_set_bits(ag->gmac, reg, bits);
+	udelay(10);
+}
+
+/*
+ * The SGMII PCS of QCA955x can come out of a MAC reset in a bad state, in
+ * which the transmit state machine is neither idle (0x0f) nor sending data
+ * (0x10). Reset it, then reset its PHY side until it gets out of that state.
+ * This follows the QCA reference code.
+ */
+static void ag71xx_sgmii_reset(struct ag71xx *ag)
+{
+	unsigned int tries = 0;
+	u32 val;
+
+	regmap_read(ag->gmac, QCA955X_GMAC_REG_MR_AN_STATUS, &val);
+	if (!(val & QCA955X_MR_AN_STATUS_AN_ABILITY))
+		return;
+
+	regmap_write(ag->gmac, QCA955X_GMAC_REG_SGMII_RESET, 0);
+	udelay(10);
+	ag71xx_gmac_set(ag, QCA955X_GMAC_REG_SGMII_RESET,
+			QCA955X_SGMII_RESET_HW_RX_125M_N);
+	ag71xx_gmac_set(ag, QCA955X_GMAC_REG_SGMII_RESET,
+			QCA955X_SGMII_RESET_RX_125M_N);
+	ag71xx_gmac_set(ag, QCA955X_GMAC_REG_SGMII_RESET,
+			QCA955X_SGMII_RESET_TX_125M_N);
+	ag71xx_gmac_set(ag, QCA955X_GMAC_REG_SGMII_RESET,
+			QCA955X_SGMII_RESET_RX_CLK_N);
+	ag71xx_gmac_set(ag, QCA955X_GMAC_REG_SGMII_RESET,
+			QCA955X_SGMII_RESET_TX_CLK_N);
+
+	do {
+		regmap_set_bits(ag->gmac, QCA955X_GMAC_REG_MR_AN_CONTROL,
+				QCA955X_MR_AN_CONTROL_PHY_RESET |
+				QCA955X_MR_AN_CONTROL_AN_ENABLE);
+		udelay(200);
+		regmap_clear_bits(ag->gmac, QCA955X_GMAC_REG_MR_AN_CONTROL,
+				  QCA955X_MR_AN_CONTROL_PHY_RESET);
+		msleep(300);
+
+		regmap_read(ag->gmac, QCA955X_GMAC_REG_SGMII_DEBUG, &val);
+		val = FIELD_GET(QCA955X_SGMII_DEBUG_TX_STATE, val);
+		if (val == 0x0f || val == 0x10)
+			return;
+	} while (++tries < QCA955X_SGMII_RESET_TRIES);
+
+	netdev_err(ag->ndev, "SGMII PCS stuck in state 0x%02x\n", val);
 }
 
 static void ag71xx_mac_config(struct phylink_config *config, unsigned int mode,
@@ -1119,6 +1199,10 @@ static void ag71xx_mac_link_up(struct ph
 	if (ag->pll)
 		ag71xx_xmii_set_speed(ag, speed);
 
+	if (ag->gmac && ag->dcfg->sgmii_reg &&
+	    ag->phy_if_mode == PHY_INTERFACE_MODE_SGMII)
+		ag71xx_sgmii_reset(ag);
+
 	ag71xx_wr(ag, AG71XX_REG_MAC_CFG2, cfg2);
 	ag71xx_wr(ag, AG71XX_REG_FIFO_CFG5, fifo5);
 	ag71xx_wr(ag, AG71XX_REG_MAC_IFCTL, ifctl);
@@ -1968,16 +2052,22 @@ static int ag71xx_gmac_init(struct ag71x
 	return regmap_update_bits(ag->gmac, AG71XX_GMAC_REG_ETH_CFG, mask, val);
 }
 
-/* The PLL block clocks the RGMII/MII side, but not the SGMII one */
+/*
+ * The PLL block clocks the RGMII/MII side with ETH_XMII_CONTROL and, on
+ * QCA955x, the SGMII side with ETH_SGMII.
+ */
 static int ag71xx_xmii_init(struct ag71xx *ag)
 {
 	struct device_node *np = ag->pdev->dev.of_node;
 	struct device *dev = &ag->pdev->dev;
 	u32 rx = 0, tx = 0, tx_ps;
 
-	if (!ag->dcfg->xmii_reg ||
-	    (ag71xx_is(ag, AR9340) && ag->mac_idx != 0) ||
-	    ag->phy_if_mode == PHY_INTERFACE_MODE_SGMII)
+	if (ag->phy_if_mode == PHY_INTERFACE_MODE_SGMII)
+		ag->xmii_reg = ag->dcfg->sgmii_reg;
+	else if (!ag71xx_is(ag, AR9340) || ag->mac_idx == 0)
+		ag->xmii_reg = ag->dcfg->xmii_reg;
+
+	if (!ag->xmii_reg)
 		return 0;
 
 	ag->pll = syscon_regmap_lookup_by_phandle_optional(np, "qca,pll");
@@ -2245,6 +2335,7 @@ static const struct ag71xx_dcfg ag71xx_d
 static const struct ag71xx_dcfg ag71xx_dcfg_qca9550 = {
 	.type = QCA9550,
 	.xmii_reg = 0x28,
+	.sgmii_reg = 0x48,
 	.fifodata = ar71xx_fifo_ar9330,
 	.max_frame_len = 1540,
 	.desc_pktlen_mask = SZ_16K - 1,
