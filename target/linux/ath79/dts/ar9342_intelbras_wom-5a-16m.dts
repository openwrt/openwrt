#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "ar9344.dtsi"

/ {
	model = "Intelbras WOM 5A (16M)";
	compatible = "intelbras,wom-5a-16m", "qca,ar9342";

	aliases {
		led-boot = &led_signal4;
		led-failsafe = &led_signal1;
		led-upgrade = &led_signal4;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_signal1: signal1 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <1>;
			gpios = <&gpio 0 GPIO_ACTIVE_LOW>;
		};

		signal2 {
			color = <LED_COLOR_ID_ORANGE>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <2>;
			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
		};

		signal3 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <3>;
			gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
		};

		led_signal4: signal4 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <4>;
			gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
		};

		wlan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			gpios = <&gpio 4 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};
	};
};

&ref {
	clock-frequency = <40000000>;
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x040000>;
				read-only;
			};

			partition@40000 {
				label = "u-boot-env";
				reg = <0x040000 0x010000>;
				read-only;
			};

			partition@50000 {
				compatible = "openwrt,uimage", "denx,uimage";
				label = "firmware";
				reg = <0x050000 0xfa0000>;
			};

			partition@ff0000 {
				label = "art";
				reg = <0xff0000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					cal_art_1000: calibration@1000 {
						reg = <0x1000 0x440>;
					};

					macaddr_art_1002: macaddr@1002 {
						compatible = "mac-base";
						reg = <0x1002 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};
		};
	};
};

&eth0 {
	status = "okay";

	phy-handle = <&phy0>;
	phy-mode = "mii";

	nvmem-cells = <&macaddr_art_1002 0>;
	nvmem-cell-names = "mac-address";
};

&mdio0 {
	status = "okay";

	phy0: ethernet-phy@0 {
		reg = <0>;
		phy-mode = "mii";
		reset-gpios = <&gpio 11 GPIO_ACTIVE_LOW>;
	};
};

&wmac {
	status = "okay";

	nvmem-cells = <&cal_art_1000>, <&macaddr_art_1002 1>;
	nvmem-cell-names = "calibration", "mac-address";
};
