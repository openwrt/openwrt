#include "qca9558_tplink_archer-c.dtsi"

/ {
	compatible = "tplink,tl-wdr4900-v2", "qca,qca9558";
	model = "TP-Link TL-WDR4900 v2";

	aliases {
		label-mac-device = &eth1;
	};
};

&leds {
	system {
		color = <LED_COLOR_ID_BLUE>;
	};

	qss {
		color = <LED_COLOR_ID_BLUE>;
	};
};

&mdio0 {
	ethernet-switch@10 {
		leds {
			led@0 {
				color = <LED_COLOR_ID_BLUE>;
			};

			led@3 {
				color = <LED_COLOR_ID_BLUE>;
			};

			led@6 {
				color = <LED_COLOR_ID_BLUE>;
			};

			led@9 {
				color = <LED_COLOR_ID_BLUE>;
			};

			led@12 {
				color = <LED_COLOR_ID_BLUE>;
			};
		};
	};
};

&mtdparts {
	uboot: partition@0 {
		label = "u-boot";
		reg = <0x000000 0x020000>;
		read-only;

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			macaddr_uboot_1fc00: macaddr@1fc00 {
				compatible = "mac-base";
				reg = <0x1fc00 0x6>;
				#nvmem-cell-cells = <1>;
			};
		};
	};

	partition@20000 {
		label = "firmware";
		compatible = "tplink,firmware";
		reg = <0x020000 0x7d0000>;
	};

	partition@7f0000 {
		label = "art";
		reg = <0x7f0000 0x010000>;
		read-only;

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			cal_ath9k_soc: cal_ath9k@1000 {
				reg = <0x1000 0x440>;
			};

			cal_ath9k_pci: cal_ath9k@5000 {
				reg = <0x5000 0x440>;
			};
		};
	};
};

&eth0 {
	nvmem-cells = <&macaddr_uboot_1fc00 1>;
	nvmem-cell-names = "mac-address";
};

&eth1 {
	nvmem-cells = <&macaddr_uboot_1fc00 0>;
	nvmem-cell-names = "mac-address";
};

&pcie1 {
	status = "okay";

	wifi@0,0 {
		compatible = "pci168c,0033";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&macaddr_uboot_1fc00 (-2)>, <&cal_ath9k_pci>;
		nvmem-cell-names = "mac-address", "calibration";

		led {
			led-sources = <0>;
			led-active-low;
		};
	};
};

&wmac {
	nvmem-cells = <&macaddr_uboot_1fc00 (-1)>, <&cal_ath9k_soc>;
	nvmem-cell-names = "mac-address", "calibration";
};
