#include "ar9344_mikrotik_routerboard-951x-2hnd.dtsi"

/ {
	compatible = "mikrotik,routerboard-951g-2hnd", "qca,ar9344";
	model = "Mikrotik RouterBOARD 951G-2HnD";

	/delete-node/ aliases;
	/delete-node/ leds;

	gpio-export {
		compatible = "gpio-export";

		gpio_usb_power {
			gpio-export,name = "rb951g-2hnd:power:usb";
			gpio-export,output = <1>;
			gpios = <&gpio 20 GPIO_ACTIVE_HIGH>;
		};

		buzzer {
			gpio-export,name = "buzzer";
			gpio-export,output = <1>;
			gpios = <&gpio 17 GPIO_ACTIVE_HIGH>;
		};
	};
};

&ref {
	clock-frequency = <25000000>;
};

&mdio0 {
	status = "okay";

	phy_port1: ethernet-phy@0 {
		reg = <0>;
	};

	phy_port2: ethernet-phy@1 {
		reg = <1>;
	};

	phy_port3: ethernet-phy@2 {
		reg = <2>;
	};

	phy_port4: ethernet-phy@3 {
		reg = <3>;
	};

	phy_port5: ethernet-phy@4 {
		reg = <4>;
	};

	ethernet-switch@10 {
		compatible = "qca,qca8327";
		#address-cells = <1>;
		#size-cells = <0>;

		reg = <16>;

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-port@0 {
				reg = <0>;
				ethernet = <&eth0>;
				phy-mode = "rgmii-id";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			ethernet-port@1 {
				reg = <1>;
				label = "wan";
				phy-handle = <&phy_port1>;
			};

			ethernet-port@2 {
				reg = <2>;
				label = "lan1";
				phy-handle = <&phy_port2>;
			};

			ethernet-port@3 {
				reg = <3>;
				label = "lan2";
				phy-handle = <&phy_port3>;
			};

			ethernet-port@4 {
				reg = <4>;
				label = "lan3";
				phy-handle = <&phy_port4>;
			};

			ethernet-port@5 {
				reg = <5>;
				label = "lan4";
				phy-handle = <&phy_port5>;
			};
		};
	};
};

&eth0 {
	status = "okay";

	pll-data = <0x6f000000 0x00000101 0x00001616>;

	phy-mode = "rgmii";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};

	gmac-config {
		device = <&gmac>;
		rgmii-gmac0 = <1>;
		rxd-delay = <1>;
		switch-only-mode = <1>;
	};
};

&eth1 {
	status = "disabled";
};
