#include "qca956x.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "tplink,archer-c58hp-v1", "qca,qca9560";
	model = "TP-Link Archer C58HP v1";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
		label-mac-device = &eth1;
	};

	led_spi {
		compatible = "spi-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		sck-gpios = <&gpio 2 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&gpio 19 GPIO_ACTIVE_HIGH>;
		num-chipselects = <0>;

		led_gpio: gpio@0 {
			compatible = "ti,sn74hc164";
			reg = <0>;
			gpio-controller;
			#gpio-cells = <2>;
			registers-number = <1>;
			spi-max-frequency = <500000>;
		};
	};

	/* Output roles and colors verified with the device controls fixture. */
	leds {
		compatible = "gpio-leds";
		led_power: power {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_POWER;
			gpios = <&led_gpio 0 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
		wlan2g {
			color = <LED_COLOR_ID_WHITE>;
			function = "wlan2g";
			gpios = <&led_gpio 1 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy1tpt";
			default-state = "off";
		};
		wlan5g {
			color = <LED_COLOR_ID_WHITE>;
			function = "wlan5g";
			gpios = <&led_gpio 2 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
			default-state = "off";
		};
		re {
			color = <LED_COLOR_ID_WHITE>;
			function = "re";
			gpios = <&led_gpio 3 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
		wps {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_WPS;
			gpios = <&led_gpio 4 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
		lan {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_LAN;
			gpios = <&led_gpio 5 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
		wan {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_WAN;
			gpios = <&led_gpio 6 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
		wan-orange {
			color = <LED_COLOR_ID_ORANGE>;
			function = LED_FUNCTION_WAN;
			gpios = <&led_gpio 7 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;
		re {
			label = "RE button";
			linux,code = <BTN_0>;
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
		wps {
			label = "WPS button";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
		wifi {
			label = "Wi-Fi button";
			linux,code = <KEY_RFKILL>;
			gpios = <&gpio 21 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
		reset {
			label = "Reset button";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 22 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

&gpio {
	pinctrl-names = "default";
	pinctrl-0 = <&jtag_disable_pins>;

	/* Deassert the SN74HC164's active-low asynchronous clear input. */
	shift-clear-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "sn74hc164-clear-n";
	};
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* Preserve the stock layout, all read-only during RAM tests. */
			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x010000>;
				read-only;
			};

			partition@10000 {
				label = "stock-rootfs";
				reg = <0x010000 0x6c0000>;
				read-only;
			};

			partition@6d0000 {
				label = "stock-kernel";
				reg = <0x6d0000 0x110000>;
				read-only;
			};

			partition@7e0000 {
				label = "info";
				reg = <0x7e0000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/* Six-byte payload after length/reserved words. */
					macaddr_info_8: macaddr@8 {
						compatible = "mac-base";
						reg = <0x8 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@7f0000 {
				label = "art";
				reg = <0x7f0000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					cal_art_1000: calibration@1000 {
						reg = <0x1000 0x440>;
					};

					precal_art_5000: pre-calibration@5000 {
						reg = <0x5000 0x2f20>;
					};
				};
			};
		};
	};
};

/* Vendor HP code attaches WAN to PHY 4, without C58 PHY swapping. */
&eth0 {
	status = "okay";
	phy-handle = <&swphy4>;
	nvmem-cells = <&macaddr_info_8 1>;
	nvmem-cell-names = "mac-address";
};

&eth1 {
	status = "okay";
	nvmem-cells = <&macaddr_info_8 0>;
	nvmem-cell-names = "mac-address";
};

&wmac {
	status = "okay";
	nvmem-cells = <&macaddr_info_8 0>, <&cal_art_1000>;
	nvmem-cell-names = "mac-address", "calibration";
};

&pcie {
	status = "okay";

	wifi@0,0 {
		compatible = "qcom,ath10k";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&precal_art_5000>, <&macaddr_info_8 (-1)>;
		nvmem-cell-names = "pre-calibration", "mac-address";
	};
};
