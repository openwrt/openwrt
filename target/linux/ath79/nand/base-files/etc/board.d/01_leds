
. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
dongwon,dw02-412h-64m|\
dongwon,dw02-412h-128m)
	ucidef_set_led_netdev "wan" "WAN" "green:wan" "wan" "link"
	;;
glinet,gl-ar300m-nand|\
glinet,gl-ar300m-nor)
	ucidef_set_led_netdev "lan" "LAN" "green:lan" "eth1"
	;;
glinet,gl-xe300)
	ucidef_set_led_netdev "wan" "WAN" "green:wan" "eth0"
	ucidef_set_led_netdev "lan" "LAN" "green:lan" "lan"
	ucidef_set_led_netdev "3gnet" "LTE" "green:lte" "wwan0"
	;;
netgear,pgzng1)
	ucidef_set_led_wlan "wlan" "WLAN" "green:wlan" "phy0tpt"
	ucidef_set_led_netdev "wan" "WAN" "green:wan-1" "wan" "link tx rx"
	ucidef_set_led_netdev "wan-green" "wan link" "green:wan-0" "wan" "link"
	ucidef_set_led_netdev "wan-amber" "wan act" "amber:wan" "wan" "tx rx"
	ucidef_set_led_netdev "lan-green" "lan link" "green:lan" "eth0" "link"
	ucidef_set_led_netdev "lan-amber" "lan act" "amber:lan" "eth0" "tx rx"
	;;
netgear,r6100)
	ucidef_set_led_netdev "wan-green" "WAN (green)" "green:wan" "eth0"
	;;
meraki,z1)
	ucidef_set_led_default "diag" "DIAG" "green:tricolor" "1"
	;;
netgear,wndr3700-v4|\
netgear,wndr4300|\
netgear,wndr4300-v2|\
netgear,wndr4300sw|\
netgear,wndr4500-v3)
	ucidef_set_led_netdev "wan-amber" "WAN (amber)" "amber:wan" "wan" "link"
	;;
esac

board_config_flush

exit 0
