. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
netgear,cg3100d)
	# TODO: Fix switch port mapping once the Ethernet driver is complete.
	ucidef_set_interface "lan" \
		device "eth0" \
		protocol "static" \
		ipaddr "192.168.1.1" \
		netmask "255.255.255.0"
	;;
esac

board_config_flush

exit 0
