From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rikka0w0 <929513338@qq.com>
Date: Sat, 11 Jul 2026 00:00:00 +1000
Subject: [PATCH] pci: add bcm3380-pcie support

Signed-off-by: Rikka0w0 <929513338@qq.com>
---
 drivers/pci/controller/Kconfig  | 6 ++++++
 drivers/pci/controller/Makefile | 1 +
 2 files changed, 7 insertions(+)

--- a/drivers/pci/controller/Kconfig
+++ b/drivers/pci/controller/Kconfig
@@ -173,6 +173,12 @@ config PCI_LOONGSON
 	  Say Y here if you want to enable PCI controller support on
 	  Loongson systems.
 
+config PCIE_BCM3380
+	bool "BCM3380 PCIe controller"
+	depends on BMIPS_GENERIC || COMPILE_TEST
+	depends on OF
+	select BCM3380_GPHY
+
 config PCI_BCM6348
 	bool "BCM6348 PCI controller"
 	depends on BMIPS_GENERIC || COMPILE_TEST
--- a/drivers/pci/controller/Makefile
+++ b/drivers/pci/controller/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_PCIE_BCM3380) += pcie-bcm3380.o
 obj-$(CONFIG_PCI_BCM6348) += pci-bcm6348.o
 obj-$(CONFIG_PCIE_BCM6318) += pcie-bcm6318.o
 obj-$(CONFIG_PCIE_BCM6328) += pcie-bcm6328.o
