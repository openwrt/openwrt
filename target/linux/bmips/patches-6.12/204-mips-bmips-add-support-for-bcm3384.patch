 }
 
+static phys_addr_t bcm3384_zephyr_memsize(void)
+{
+	u32 ddrconfig = __raw_readl(BCM3384_DDR_CONFIG);
+	u32 ctrlconfig = __raw_readl(BCM3384_DDR_CONTROLLER_CONFIG);
+	phys_addr_t memsize = BCM3384_DDR_BASE_SIZE <<
+			      ((ddrconfig & BCM3384_DDR_CONFIG_SIZE_MASK) +
+			       (ctrlconfig & BCM3384_DDR_CONTROLLER_SIZE_MASK));
+
+	if (memsize > BCM3384_DDR_DEFAULT_UBUS_LIMIT) {
+		u32 ubus_space = 0;
+
+		switch (memsize >> 28) {
+		case 0x2:
+			ubus_space = 0x9;
+			break;
+		case 0x4:
+			ubus_space = 0xa;
+			break;
+		case 0x8:
+			ubus_space = 0xb;
+			break;
+		case 0xc:
+			ubus_space = 0xc;
+			break;
+		default:
+			pr_err("unsupported BCM3384 SDRAM size 0x%08llx in UBUS space\n",
+			       (unsigned long long)memsize);
+			break;
+		}
+
+		if (ubus_space)
+			__raw_writel(ubus_space, BCM3384_GPIO_PER_SDRAM_SPACE);
+	}
+
+	return memsize;
+}
