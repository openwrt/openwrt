+static u32 bcm3384_zephyr_cpufreq(void)
+{
+	/*
+	 * Stock BCM3384 Zephyr Linux uses a BMIPS5000 Count clock at core / 8.
+	 * The existing BMIPS cpufreq path stores cpu_freq() / 2 into
+	 * mips_hpt_frequency, so return twice the desired 100 MHz HPT rate.
+	 */
+	return 200000000;
+}
