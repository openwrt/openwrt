+extern unsigned long bcm3384_zephyr_l1_init_uncached(void);
+
+static void bcm3384_zephyr_quirks(void)
+{
+	/*
+	 * Enter the BCM3384-specific L1 helper through uncached KSEG0 mode.
+	 * The helper switches to KSEG1, enables write-back KSEG0, initializes
+	 * L1/L2 state, and returns through cached KSEG0 like the stock path.
+	 */
+	change_c0_config(CONF_CM_CMASK, CONF_CM_UNCACHED);
+	instruction_hazard();
+	bcm3384_zephyr_l1_init_uncached();
+
+	/*
+	 * Stock BCM3384 arch_init_irq() clears BMIPS mode bits 27..29 and
+	 * sets bits 30..31 in SMP mode. It routes most hardware interrupts to
+	 * the primary Zephyr thread and leaves GFAP/DQM interrupt lines on the
+	 * secondary thread.
+	 */
+	clear_c0_brcm_mode(0x07 << 27);
+	set_c0_brcm_mode((0x1f & ~0x07) << 27);
+
+	/*
+	 * Do not call bcm63xx_fixup_cpu1(): Zephyr CPU1 is still reset and
+	 * must be started by the BMIPS5000 ACTION_BOOT_THREAD path.
+	 */
+	bmips_rac_flush_disable = true;
+}
