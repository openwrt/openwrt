--- a/drivers/net/ethernet/broadcom/Kconfig
+++ b/drivers/net/ethernet/broadcom/Kconfig
@@ -283,4 +283,14 @@ config BCMASP
 	  This configuration enables the Broadcom ASP 2.0 Ethernet controller
 	  driver which is present in Broadcom STB SoCs such as 72165.
 
+config BCM3380_UNIMAC
+	tristate "Broadcom BCM3380 Unimac support"
+	depends on BMIPS_GENERIC || COMPILE_TEST
+	select BCM3380_FPM
+	select BCM3380_MSP
+	default y
+	help
+	  This driver supports Ethernet controller integrated into Broadcom
+	  BCM3380 family SoCs.
+
 endif # NET_VENDOR_BROADCOM
--- a/drivers/net/ethernet/broadcom/Makefile
+++ b/drivers/net/ethernet/broadcom/Makefile
@@ -4,6 +4,7 @@
 #
 
 obj-$(CONFIG_B44) += b44.o
+obj-$(CONFIG_BCM3380_UNIMAC) += bcm3380-unimac.o
 obj-$(CONFIG_BCM4908_ENET) += bcm4908_enet.o
 obj-$(CONFIG_BCM63XX_ENET) += bcm63xx_enet.o
 obj-$(CONFIG_BCM6348_ENET) += bcm6348-enet.o
--- a/drivers/soc/bcm/Kconfig
+++ b/drivers/soc/bcm/Kconfig
@@ -1,6 +1,16 @@
 # SPDX-License-Identifier: GPL-2.0-only
 menu "Broadcom SoC drivers"
 
+config BCM3380_GPHY
+	tristate "Broadcom BCM3380 internal GPHY bring-up support"
+	depends on BMIPS_GENERIC || COMPILE_TEST
+	depends on HAS_IOMEM
+	default y if BCM3380_UNIMAC
+	help
+	  This driver initializes the BCM3380 internal GPHY clocks, reset,
+	  and DS tuner reference clock before UniMAC MDIO probes the standard
+	  Clause 22 PHY.
+
 config SOC_BRCMSTB
 	bool "Broadcom STB SoC drivers"
 	depends on ARCH_BRCMSTB || BMIPS_GENERIC || COMPILE_TEST
--- a/drivers/soc/bcm/Makefile
+++ b/drivers/soc/bcm/Makefile
@@ -1,2 +1,3 @@
 # SPDX-License-Identifier: GPL-2.0-only
 obj-$(CONFIG_SOC_BRCMSTB)	+= brcmstb/
+obj-$(CONFIG_BCM3380_GPHY)	+= bcm3380-gphy.o
