#include "bcm3380.dtsi"

/ {
	model = "Netgear CG3100D";
	compatible = "netgear,cg3100d", "brcm,bcm3380";

	bcm43225-sprom {
		compatible = "brcm,bcma-sprom";

		pci-bus = <1>;
		pci-dev = <0>;

		brcm,sprom = "brcm/bcm43225-sprom.bin";
	};
};

&uart0 {
	status = "okay";
};

&lsspi {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lsspi_cs3>;

	flash@0 {
		compatible = "jedec,spi-nor";
		spi-max-frequency = <1000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <1>;
		reg = <0>;

		#address-cells = <1>;
		#size-cells = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x000000 0x010000>;
				read-only;
			};

			partition@10000 {
				label = "permnonvol";
				reg = <0x010000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "brcm,ecos-nonvol-perm";
					brcm,slot-size = <0x4000>;
					brcm,section-offset = <0xca>;

					unimac1_ip_stack5_mac: mac-address {
						/*
						 * section + 0x0a -> CMAp
						 * CMAp + 0xb2 -> HAL IP Stack5 MAC
						 */
						brcm,record-path = <0x0a 0xb2>;
					};
				};
			};

			partition@20000 {
				compatible = "brcm,bcm3380-aeolus-firmware";
				label = "firmware";
				reg = <0x020000 0x7e0000>;
			};
		};
	};

	// The switch can only operate in unmanaged mode
	switch@3 {
		reg = <3>;
		spi-max-frequency = <1563000>;
	};
};

&fpm {
	status = "okay";
};

&msp {
	status = "okay";
};

&pcie {
	pcie-enable-gpios = <&gpio 27 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&leds {
	status = "okay";
	brcm,serial-dat-low;
	brcm,serial-shift-inv;

	gphy_mode@4 {
		reg = <4>;
		color = <LED_COLOR_ID_GREEN>;
		function = "gphy";
		default-state = "off";
	};

	gphy_activity@5 {
		reg = <5>;
		brcm,hardware-controlled;
		brcm,activity-signal-sources = <4>;
	};
};

&usb0 {
	status = "okay";
};

&unimac1_mbdma {
	status = "okay";
};

&unimac1 {
	nvmem-cells = <&unimac1_ip_stack5_mac>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};
