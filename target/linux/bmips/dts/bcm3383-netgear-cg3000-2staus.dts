#include "bcm3383.dtsi"

/ {
	model = "Netgear CG3000-2STAUS";
	compatible = "netgear,cg3000-2staus", "brcm,bcm3383";
};

&uart0 {
	status = "okay";
};

&fpm {
	status = "okay";
};

&msp {
	status = "okay";
};

&unimac0 {
	phy-mode = "rgmii-id";
	status = "okay";

	fixed-link {
		speed = <1000>;
		full-duplex;
		asym-pause;
		pause;
	};
};

&pcie0 {
	status = "okay";
};

&usb {
	status = "okay";
};

&leds {
	status = "okay";
	brcm,serial-dat-low;
	brcm,serial-shift-inv;

	gmac0_activity@5 {
		reg = <5>;
		brcm,hardware-controlled;
		brcm,activity-signal-sources = <4>;
	};
};

&hsspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x00000 0x10000>;
				read-only;
			};

			partition@10000 {
				label = "permnonvol";
				reg = <0x10000 0x10000>;
				read-only;
			};

			partition@20000 {
				label = "vendor-nonvol";
				reg = <0x20000 0x10000>;
				read-only;
			};

			partition@30000 {
				label = "vendor-nonvol-2";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@c0000 {
				label = "dynnonvol";
				reg = <0xc0000 0x40000>;
				read-only;
			};
		};
	};

	switch@2 {
		compatible = "brcm,bcm53125";
		reg = <2>;
		spi-max-frequency = <781000>;
		spi-cpha;
		spi-cpol;
		status = "okay";

		dsa,member = <0 0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;
				label = "lan1";
			};

			port@2 {
				reg = <2>;
				label = "lan2";
			};

			port@3 {
				reg = <3>;
				label = "lan3";
			};

			port@4 {
				reg = <4>;
				label = "lan4";
			};

			port@8 {
				reg = <8>;
				ethernet = <&unimac0>;
				phy-mode = "rgmii-id";

				fixed-link {
					speed = <1000>;
					full-duplex;
					asym-pause;
					pause;
				};
			};
		};
	};
};

&nand {
	status = "okay";

	nandcs@0 {
		compatible = "brcm,nandcs";
		reg = <0>;
		brcm,nand-ecc-use-strap;

		#address-cells = <1>;
		#size-cells = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "linuxapps";
				reg = <0x00000000 0x1f40000>;
				read-only;
			};

			partition@1f40000 {
				label = "image1";
				reg = <0x01f40000 0x0900000>;
				read-only;
			};

			partition@2840000 {
				label = "image2";
				reg = <0x02840000 0x0900000>;
				read-only;
			};

			partition@3140000 {
				label = "linux";
				reg = <0x03140000 0x0480000>;
				read-only;
			};

			partition@35c0000 {
				label = "linuxkfs";
				reg = <0x035c0000 0x4800000>;
				read-only;
			};

			partition@7dc0000 {
				label = "dhtml";
				reg = <0x07dc0000 0x0240000>;
				read-only;
			};
		};
	};
};
