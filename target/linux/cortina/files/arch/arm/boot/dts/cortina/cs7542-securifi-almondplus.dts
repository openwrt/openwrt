/dts-v1/;
#include "cs75xx.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Securifi Almond+";
	compatible = "securifi,almondplus", "cortina,cs7542", "cortina,cs75xx";

	aliases {
		label-mac-device = &gmac0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x20000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		network-engine@1c000000 {
			reg = <0x1c000000 0x04000000>;
			no-map;
		};

		ramoops@1bf00000 {
			compatible = "ramoops";
			reg = <0x1bf00000 0x00100000>;
			record-size = <0x20000>;
			console-size = <0x80000>;
			pmsg-size = <0>;
			ftrace-size = <0>;
			ecc-size = <16>;
			no-map;
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		reset {
			label = "reset";
			gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&soc_i2c {
	clock-frequency = <400000>;
	status = "okay";

	touchscreen@48 {
		compatible = "semtech,sx8650";
		reg = <0x48>;
		interrupt-parent = <&gpio4>;
		interrupts = <28 IRQ_TYPE_LEVEL_LOW>;
	};
};

&rtc0 {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&nandc {
	status = "okay";
	nand-ecc-mode = "hw";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@20000 {
			label = "uboot0";
			reg = <0x0020000 0x00e0000>;
			read-only;
		};

		partition@100000 {
			label = "uboot-env0";
			reg = <0x0100000 0x0020000>;

			nvmem-layout {
				compatible = "u-boot,env";

				ethaddr: ethaddr {
					#nvmem-cell-cells = <1>;
				};
			};
		};

		partition@200000 {
			label = "uboot1";
			reg = <0x0200000 0x0100000>;
			read-only;
		};

		partition@300000 {
			label = "uboot-env1";
			reg = <0x0300000 0x0100000>;
		};

		partition@400000 {
			label = "sb0";
			reg = <0x0400000 0x0100000>;
		};

		partition@500000 {
			label = "sb1";
			reg = <0x0500000 0x0100000>;
		};

		partition@600000 {
			label = "kernel_standby";
			reg = <0x0600000 0x0600000>;
		};

		partition@c00000 {
			label = "rootfs_standby";
			reg = <0x0c00000 0x2e00000>;
		};

		partition@3a00000 {
			label = "kernel";
			reg = <0x3a00000 0x0600000>;
		};

		partition@4000000 {
			label = "rootfs_stock";
			reg = <0x4000000 0x2e00000>;
		};

		partition@6e00000 {
			label = "stock_data";
			reg = <0x6e00000 0x1000000>;
		};

		partition@7e00000 {
			label = "log";
			reg = <0x7e00000 0x0100000>;
		};

		partition@7f00000 {
			label = "cal";
			reg = <0x7f00000 0x0100000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				cal_ath9k: cal@1000 {
					reg = <0x1000 0x440>;
				};

				cal_ath10k: cal@5000 {
					reg = <0x5000 0x844>;
				};
			};
		};

		partition@8000000 {
			label = "man";
			reg = <0x8000000 0x0100000>;
			read-only;
		};

		partition@8100000 {
			label = "almond_data";
			reg = <0x8100000 0x0500000>;
		};

		partition@8600000 {
			label = "ubi";
			reg = <0x8600000 0x17a00000>;
		};
	};
};

&pcie0 {
	status = "okay";
	reset-gpios = <&gpio2 28 GPIO_ACTIVE_LOW>;

	bridge@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0,0 {
			compatible = "qcom,ath10k";
			reg = <0x10000 0 0 0 0>;
			nvmem-cells = <&cal_ath10k>;
			nvmem-cell-names = "calibration";
		};
	};
};

&pcie1 {
	status = "okay";

	bridge@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0,0 {
			compatible = "pci168c,0033";
			reg = <0x10000 0 0 0 0>;
			nvmem-cells = <&cal_ath9k>;
			nvmem-cell-names = "calibration";
		};
	};
};

&pcie2 {
	status = "okay";
};

&mdio0 {
	status = "okay";

	switch@10 {
		compatible = "qca,qca8337";
		reg = <0x10>;
		#address-cells = <1>;
		#size-cells = <0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "cpu";
				ethernet = <&gmac1>;
				phy-mode = "rgmii-id";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			port@1 {
				reg = <1>;
				label = "wan";
				nvmem-cells = <&ethaddr 0>;
				nvmem-cell-names = "mac-address";
			};

			port@2 {
				reg = <2>;
				label = "lan4";
			};

			port@3 {
				reg = <3>;
				label = "lan3";
			};

			port@4 {
				reg = <4>;
				label = "lan2";
			};

			port@5 {
				reg = <5>;
				label = "lan1";
			};

			port@6 {
				reg = <6>;
				label = "cpu";
				ethernet = <&gmac0>;
				phy-mode = "rgmii-id";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

&ethernet {
	status = "okay";
};

&gmac0 {
	status = "okay";
	phy-mode = "rgmii";
	nvmem-cells = <&ethaddr 0>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&gmac1 {
	status = "okay";
	phy-mode = "rgmii";
	nvmem-cells = <&ethaddr (-1)>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&arm_wdt {
	clocks = <&mainclk CS75XX_CLK_APB>;
	status = "okay";
};
