From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fil Dunsky <filipp.dunsky@gmail.com>
Date: Sat, 05 Sep 2026 07:30:20 +0300
Subject: [PATCH] arm: cortina: add DEBUG_LL support for the CS75xx UART0

Add a DEBUG_GOLDENGATE_UART0 entry to the low-level debugging port choice
and select debug/goldengate.S as the DEBUG_LL include for it. The UART
registers are reached through the fixed virtual window that the CS75xx
machine code maps in map_io.

Signed-off-by: Fil Dunsky <filipp.dunsky@gmail.com>
---
--- a/arch/arm/Kconfig.debug
+++ b/arch/arm/Kconfig.debug
@@ -125,6 +125,12 @@ choice
 	prompt "Kernel low-level debugging port"
 	depends on DEBUG_LL
 
+	config DEBUG_GOLDENGATE_UART0
+		bool "Kernel low-level debugging on Cortina CS75xx using UART0"
+		depends on ARCH_CORTINA_CS75XX
+		help
+		  Direct low-level debug output to UART0 on Cortina CS75xx.
+
 	config DEBUG_ALPINE_UART0
 		bool "Kernel low-level debugging messages via Alpine UART0"
 		depends on ARCH_ALPINE
@@ -1480,6 +1486,7 @@ config DEBUG_UART_FLOW_CONTROL
 config DEBUG_LL_INCLUDE
 	string
 	default "debug/sa1100.S" if DEBUG_SA1100
+	default "debug/goldengate.S" if DEBUG_GOLDENGATE_UART0
 	default "debug/palmchip.S" if DEBUG_UART_8250_PALMCHIP
 	default "debug/8250.S" if DEBUG_LL_UART_8250 || DEBUG_UART_8250
 	default "debug/at91.S" if DEBUG_AT91_UART
