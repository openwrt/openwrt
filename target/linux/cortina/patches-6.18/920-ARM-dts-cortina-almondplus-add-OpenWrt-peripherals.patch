+			compatible = "cortina,cs7542-mdio";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <0xf00700a0 0x14>;
+			clocks = <&global CS7542_CLK_APB>;
+			status = "disabled";
+		};
+
