+				reg = <2>;
+				status = "disabled";
+			};
+		};
+
+		pcie0: pcie@80000000 {
+			compatible = "cortina,cs7542-pcie";
+			reg = <0x80000000 0x1000>, <0x80001000 0x1000>, <0xf00a0000 0x100>;
+			reg-names = "dbi", "config", "app";
+			status = "disabled";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			device_type = "pci";
+			linux,pci-domain = <0>;
+			bus-range = <0 0xff>;
+			num-lanes = <1>;
+			ranges = <0x82000000 0 0x80200000 0x80200000 0 0x1fe00000>;
+			interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "msi";
+			clocks = <&global CS7542_CLK_PCIE0>;
+			resets = <&global CS7542_RESET_PCIE0>;
+			phys = <&serdes 0>;
+			phy-names = "pcie";
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &pcie0_intc 1>,
