+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+			};
+
+			pcie0_intc: interrupt-controller {
+				#address-cells = <0>;
+				#interrupt-cells = <1>;
+				interrupt-controller;
+			};
+		};
+
+		pcie1: pcie@a0000000 {
+			compatible = "cortina,cs7542-pcie";
+			reg = <0xa0000000 0x1000>, <0xa0001000 0x1000>, <0xf00a0400 0x100>;
+			reg-names = "dbi", "config", "app";
+			status = "disabled";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			device_type = "pci";
