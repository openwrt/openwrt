+	if (!guard || !io || !io->limit_us || !guard->attempted)
+		return -EINVAL;
+	if (!guard->written || guard->disarmed)
+		return 0;
+	error = read_entry(guard, io, CS_ACL_CLASS, guard->class_id, &record);
+	if (error)
+		return fail(guard, error);
