+static void qca4_test_flow_dissect(struct kunit *test)
+{
+	static const u8 bytes[] = { 0xbe, 0x45, 0x08, 0x00 };
+	unsigned int length, linear;
+
+	/*
+	 * Every truncated length and every possible split across a page fragment.
+	 * A one-byte reserve also exercises unaligned linear EtherType access.
+	 */
+	for (length = 0; length <= sizeof(bytes); length++) {
+		for (linear = 0; linear <= length; linear++) {
+			struct sk_buff *skb, *full, *clone;
+			unsigned char *data;
+			unsigned int headlen;
+			__be16 proto = htons(0xffff);
+			int offset = -1;
+
+			full = alloc_skb(16, GFP_KERNEL);
+			KUNIT_ASSERT_NOT_NULL(test, full);
+			skb_reserve(full, 1);
+			skb_put_data(full, bytes, length);
+			skb = full;
+			if (linear < length) {
+				skb = qca4_test_fragment(full, linear);
+				kfree_skb(full);
+				KUNIT_ASSERT_NOT_NULL(test, skb);
+			}
+			clone = skb_clone(skb, GFP_KERNEL);
+			KUNIT_ASSERT_NOT_NULL(test, clone);
+			data = clone->data;
+			headlen = skb_headlen(clone);
+			qca4_private_ops.flow_dissect(clone, &proto, &offset);
+			KUNIT_EXPECT_EQ(test, offset,
+					headlen >= QCA4_PRIVATE_LEN ? QCA4_PRIVATE_LEN : 0);
+			KUNIT_EXPECT_EQ(
+				test, proto,
+				headlen >= QCA4_PRIVATE_LEN ? htons(ETH_P_IP) : 0);
+			KUNIT_EXPECT_PTR_EQ(test, clone->data, data);
+			KUNIT_EXPECT_EQ(test, clone->len, length);
+			KUNIT_EXPECT_EQ(test, skb_headlen(clone), headlen);
+			KUNIT_EXPECT_MEMEQ(test, skb->data, bytes, headlen);
+			kfree_skb(clone);
+			kfree_skb(skb);
+		}
+	}
+}
+
+/* A hardware-stripped QCA tag is metadata, not an inner customer VLAN. */
+static void qca4_test_rx_hwaccel(struct kunit *test)
+{
+	struct qca4_test_context *c = test->priv;
+	unsigned int vlans, reason, port;
+
+	for (vlans = 0; vlans <= 2; vlans++) {
+		for (reason = 0; reason < 32; reason++) {
+			for (port = 0; port < 8; port++) {
+				struct sk_buff *skb = qca4_test_frame(16, vlans), *clone, *result;
+				u16 hdr = FIELD_PREP(QCA_HDR_RECV_VERSION, QCA_HDR_VERSION) |
+					  FIELD_PREP(QCA_HDR_RECV_TYPE, reason) | port;
+				__be16 expected = htons(vlans == 2 ? ETH_P_8021AD :
+							vlans == 1 ? ETH_P_8021Q : ETH_P_IP);
+				__be16 proto = 0;
+				int offset = -1;
+				u8 bytes[128];
+				unsigned int len;
+				bool accept = port == 5 && reason != QCA_HDR_RECV_TYPE_MIB &&
+					      reason != QCA_HDR_RECV_TYPE_RW_REG_ACK;
+
+				KUNIT_ASSERT_NOT_NULL(test, skb);
+				len = skb->len;
+				memcpy(bytes, skb->data, len);
+				skb->protocol = eth_type_trans(skb, c->conduit);
+				__vlan_hwaccel_put_tag(skb, htons(ETH_P_8021Q), hdr);
+				skb->ip_summed = CHECKSUM_COMPLETE;
+				skb->csum = skb_checksum(skb, 0, skb->len, 0);
+				qca4_private_flow_dissect(skb, &proto, &offset);
+				KUNIT_EXPECT_EQ(test, proto, expected);
+				KUNIT_EXPECT_EQ(test, offset, 0);
+				clone = skb_clone(skb, GFP_KERNEL);
+				KUNIT_ASSERT_NOT_NULL(test, clone);
+				result = qca4_private_rcv(clone, c->conduit);
+				if (accept) {
+					KUNIT_ASSERT_NOT_NULL(test, result);
+					KUNIT_EXPECT_FALSE(test, skb_vlan_tag_present(result));
+					KUNIT_EXPECT_PTR_EQ(test, result->dev, c->netdev);
+					KUNIT_EXPECT_EQ(test, result->len, len - ETH_HLEN);
+					KUNIT_EXPECT_EQ(test, csum_fold(result->csum),
+							csum_fold(skb_checksum(result, 0,
+									       result->len, 0)));
+					skb_push(result, ETH_HLEN);
+					KUNIT_EXPECT_MEMEQ(test, result->data, bytes, len);
+					KUNIT_EXPECT_EQ(test,
+							eth_type_trans(result, c->netdev),
+							expected);
+					kfree_skb(result);
+				} else {
+					KUNIT_EXPECT_PTR_EQ(test, result, NULL);
+				}
+				KUNIT_EXPECT_MEMEQ(test, skb_mac_header(skb), bytes, len);
+				KUNIT_EXPECT_TRUE(test, skb_vlan_tag_present(skb));
+				kfree_skb(skb);
+			}
+		}
+	}
+}
