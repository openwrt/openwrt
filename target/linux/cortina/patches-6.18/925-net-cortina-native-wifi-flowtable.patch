+
+/* Owner lock + RTNL; wireless identity is attested by the native PCI driver. */
+static struct net_device *cs_wfo_path(struct cs7542_fe_live *owner,
+				      const struct cs7542_fe_native_request *request, u64 epoch)
+{
+	const struct cs_fe_rule *rule = &request->rule;
+	bool input = cs_fe_link_cpu_nat(&rule->ingress);
+	const struct cs_fe_link *cpu = input ? &rule->ingress : &rule->egress;
+	const struct cs_fe_link *wired = input ? &rule->egress : &rule->ingress;
+	struct net_device *wireless, *l3dev, *conduit = owner->ports[1];
+	const u8 *peer = input ? request->ingress_smac : rule->dmac;
+	unsigned int wireless_ifindex = input ? request->ingress_ifindex :
+					       request->egress_ifindex;
+	struct cs_wfo_endpoint *ep = NULL;
+	struct dsa_port *port;
+	unsigned int i;
+
+	ASSERT_RTNL();
+	lockdep_assert_held(&owner->lock);
+	if (cs_fe_live_ready(owner) || !epoch || !conduit ||
+	    input == cs_fe_link_cpu_nat(&rule->egress) ||
+	    !is_valid_ether_addr(request->ingress_smac) ||
+	    !is_valid_ether_addr(rule->dmac) ||
+	    !ether_addr_equal(rule->egress.base_mac, rule->smac) ||
+	    !rule->decrement_ttl || request->route_mtu < CS_FE_NATIVE_SMALL_HIGH ||
+	    (rule->ipv6 && !IS_REACHABLE(CONFIG_IPV6)) ||
+	    (input && wired->rx_qca_meta) ||
+	    request->ingress_ifindex == request->egress_ifindex ||
+	    !netif_running(conduit) || !netif_carrier_ok(conduit))
+		return ERR_PTR(-EOPNOTSUPP);
+	wireless = __dev_get_by_index(&init_net, wireless_ifindex);
+	if (!wireless || !netif_running(wireless) || !netif_carrier_ok(wireless) ||
+	    !cs_wfo_plain_device(wireless))
+		return ERR_PTR(-EOPNOTSUPP);
+	for (i = 0; i < CS_WFO_ENDPOINTS; i++) {
+		struct cs_wfo_endpoint *candidate = &owner->wfo[i];
+
+		if (rcu_dereference_protected(candidate->dev,
+					      lockdep_is_held(&owner->lock)) == wireless &&
+		    !READ_ONCE(candidate->paused) && candidate->epoch == epoch &&
+		    cpu->rx_qca_meta == (0x8000 | candidate->label)) {
+			ep = candidate;
+			break;
+		}
+	}
+	if (!ep)
+		return ERR_PTR(-ESTALE);
+	l3dev = netdev_master_upper_dev_get(wireless);
+	if (l3dev) {
+		if (!netif_is_bridge_master(l3dev) || !netif_running(l3dev) ||
+		    br_vlan_enabled(l3dev) ||
+		    br_port_get_stp_state(wireless) != BR_STATE_FORWARDING ||
+		    br_port_flag_is_set(wireless, BR_ISOLATED | BR_PORT_LOCKED |
+						 BR_PORT_MAB | BR_VLAN_TUNNEL) ||
+		    br_fdb_find_port(l3dev, peer, 0) != wireless)
+			return ERR_PTR(-EOPNOTSUPP);
+	} else {
+		l3dev = wireless;
+	}
+	if (!ether_addr_equal(cpu->base_mac, l3dev->dev_addr) ||
+	    (!input && request->route_mtu >
+		min(READ_ONCE(wireless->mtu), READ_ONCE(l3dev->mtu))))
+		return ERR_PTR(-ESTALE);
+	port = cs_native_port(input ? request->egress_ifindex :
+				     request->ingress_ifindex,
+			      wired, input ? rule->dmac : request->ingress_smac,
+			      input ? request->route_mtu : 0);
+	if (IS_ERR(port) || port->cpu_dp->conduit != conduit)
+		return ERR_PTR(-EOPNOTSUPP);
+	return conduit;
+}
+
+static int cs_wfo_arm(struct cs7542_fe_live *owner, unsigned int slot,
+		      const struct cs_wfo_receipt_seed *seed, u64 generation)
+{
+	struct cs_wfo_endpoint *ep = NULL;
+	struct cs_wfo_live_receipt *live;
+	struct cs_fe_backend_lease *lease;
+	struct net_device *dev;
+	unsigned int i, ifindex;
+	int error;
+
+	lockdep_assert_held(&owner->lock);
+	if (slot >= CS_FE_BACKEND_LEASES)
+		return -ESTALE;
+	lease = &owner->backend.lease[slot];
+	if (!lease->active)
+		return -ESTALE;
+	/* Also refresh an identical active lease, whose backend fast path did not
+	 * invoke prepare/rearm. Initial publication already preceded CLASS valid.
+	 */
+	owner->wfo_pending = seed;
+	error = cs_wfo_receipt_publish(owner, slot, &lease->rows, &lease->plan);
+	owner->wfo_pending = NULL;
+	if (error)
+		return error;
+	live = rcu_dereference_protected(owner->wfo_receipts[slot],
+					 lockdep_is_held(&owner->lock));
+	if (!live)
+		return -EUCLEAN;
+	ifindex = live->identity.wireless_input ? seed->ingress_ifindex :
+						seed->egress_ifindex;
+	for (i = 0; i < CS_WFO_ENDPOINTS; i++) {
+		dev = rcu_dereference_protected(owner->wfo[i].dev,
+						lockdep_is_held(&owner->lock));
+		if (dev && dev->ifindex == ifindex && owner->wfo[i].epoch == seed->epoch) {
+			ep = &owner->wfo[i];
+			break;
+		}
+	}
+	if (!ep)
+		return -ESTALE;
+	/* Drain callbacks holding a pre-publication receipt or doing software
+	 * fallback before opening the new producer generation.
+	 */
+	synchronize_net();
+	spin_lock_bh(&owner->wfo_tx_lock);
+	if (READ_ONCE(ep->paused) || !netif_running(dev) || !netif_carrier_ok(dev) ||
+	    !cs_wfo_plain_device(dev) || generation != (u64)atomic64_read(&cs_native_generation)) {
+		error = -ESTALE;
+	} else {
+		live->admitting = true;
+		WRITE_ONCE(ep->injecting, true);
+	}
+	spin_unlock_bh(&owner->wfo_tx_lock);
+	return error;
+}
+
+int cs7542_fe_live_replace_wfo(struct cs7542_fe_live *owner, u64 block,
+			       unsigned long cookie, u64 version,
+			       const struct cs7542_wfo_native_request *request,
+			       const struct flow_cls_offload *cls)
+{
+	if (!request || request->abi != CS7542_WFO_NATIVE_ABI ||
+	    request->size != sizeof(*request) || !request->wireless_epoch ||
+	    request->path.abi != CS7542_FE_NATIVE_ABI ||
+	    (request->path.rule.native_l4proto != IPPROTO_TCP &&
+	     request->path.rule.native_l4proto != IPPROTO_UDP) ||
+	    !cls || cls->command != FLOW_CLS_REPLACE || cls->cookie != cookie ||
+	    cls->nf_route_mtu != request->path.route_mtu)
+		return -EINVAL;
+	return cs_native_replace(owner, block, cookie, version, &request->path,
+				 request->path.rule.native_l4proto, cls,
+				 request->wireless_epoch);
+}
+EXPORT_SYMBOL_GPL(cs7542_fe_live_replace_wfo);
+
+static void cs_wfo_remove(struct cs7542_fe_live *owner,
+			  struct net_device *dev)
+{
+	struct net_device *held[CS_WFO_ENDPOINTS] = {};
+	unsigned int i;
+	bool changed = false;
+
+	lockdep_assert_held(&owner->lock);
+	cs_wfo_receipt_remove(owner, dev);
+	for (i = 0; i < CS_WFO_ENDPOINTS; i++) {
+		struct cs_wfo_endpoint *ep = &owner->wfo[i];
+		struct net_device *registered = rcu_dereference_protected(ep->dev,
+						lockdep_is_held(&owner->lock));
+
+		if (!registered || (dev && registered != dev))
+			continue;
+		cs_wfo_endpoint_fence(ep);
+		rcu_assign_pointer(ep->dev, NULL);
+		cs_wfo_observe_stop(ep);
+		held[i] = registered;
+		changed = true;
+	}
+	/* Packet callbacks never acquire owner->lock or RTNL. Retire their
+	 * device references before unregister_netdevice waits for them.
+	 */
+	if (changed)
+		synchronize_net();
+	for (i = 0; i < CS_WFO_ENDPOINTS; i++)
+		if (held[i])
+			dev_put(held[i]);
+}
+
+static void cs_wfo_link(struct cs7542_fe_live *owner,
+			struct net_device *dev, bool up)
+{
+	unsigned int i;
+	bool drain = false;
+
+	lockdep_assert_held(&owner->lock);
+	for (i = 0; i < CS_WFO_ENDPOINTS; i++) {
+		struct cs_wfo_endpoint *ep = &owner->wfo[i];
+		struct net_device *registered = rcu_dereference_protected(ep->dev,
+						lockdep_is_held(&owner->lock));
+		bool paused;
+
+		if (!registered || (registered != dev && owner->ports[1] != dev))
+			continue;
+		paused = !up || !netif_running(registered) ||
+			 !netif_carrier_ok(registered) || !owner->ports[1] ||
+			 !netif_running(owner->ports[1]) ||
+			 !netif_carrier_ok(owner->ports[1]);
+		if (READ_ONCE(ep->paused) == paused)
+			continue;
+		cs_wfo_endpoint_fence(ep);
+		cs_wfo_observe_pause(ep, paused);
+		drain |= paused;
+	}
+	/* A callback that saw the old link cannot publish after a later UP. */
+	if (drain)
+		synchronize_net();
+}
+
+static int cs_wfo_label_in_use(void *context, unsigned int label)
+{
+	struct cs7542_fe_live *owner = context;
+	unsigned int i;
+
+	lockdep_assert_held(&owner->lock);
+	if (owner->backend.poisoned || owner->backend.pending ||
+	    owner->hot_state.ledger.blocked || owner->hot_state.ledger.pending)
+		return -EUCLEAN;
+	for (i = 0; i < CS_WFO_ENDPOINTS; i++) {
+		struct cs_wfo_endpoint *ep = &owner->wfo[i];
+
+		if (rcu_access_pointer(ep->dev) && ep->label == label)
+			return 1;
+	}
+	/* A withdrawn lease may still be rearmed with the same action. Keep
+	 * its label until graph reclamation has cleared and read back all rows.
+	 */
+	for (i = 0; i < CS_FE_BACKEND_LEASES; i++) {
+		const struct cs_fe_backend_lease *lease = &owner->backend.lease[i];
+		const struct cs_fe_rule *rule = &lease->rule;
+
+		if (lease->reserved &&
+		    ((cs_fe_link_cpu_nat(&rule->ingress) &&
+		      (rule->ingress.rx_qca_meta & 4095) == label) ||
+		     (cs_fe_link_cpu_nat(&rule->egress) &&
+		      (rule->egress.rx_qca_meta & 4095) == label)))
+			return 1;
+	}
+	for (i = 0; i < CS_WFO_RECEIPTS; i++) {
+		const struct cs_wfo_live_receipt *live =
+			rcu_dereference_protected(owner->wfo_receipts[i],
+						  lockdep_is_held(&owner->lock));
+
+		if (live && live->identity.label == label)
+			return 1;
+	}
+	return 0;
+}
+
+static int cs_wfo_label_drain(void *context)
+{
+	struct cs7542_fe_live *owner = context;
+	int error;
+
+	ASSERT_RTNL();
+	lockdep_assert_held(&owner->lock);
+	/* Removal fences injection before dropping the RCU device pointer.
+	 * Retire those CPU readers, then require the same fixed-profile engine
+	 * drain as action GC. No delay-only or generation-only shortcut.
+	 */
+	synchronize_net();
+	error = cs_fe_live_retire_quiet(owner, cs_fe_live_now(owner) + 2000);
+	if (error && error != -EAGAIN && error != -EOPNOTSUPP) {
+		owner->backend.poisoned = true;
+		owner->hot_state.ledger.blocked = true;
+		if (!owner->backend.first_error)
+			owner->backend.first_error = error;
+		/* An uncertain NI restoration must survive endpoint teardown too. */
+		if (!owner->quarantine_ref) {
+			kref_get(&owner->refs);
+			owner->quarantine_ref = true;
+		}
+	}
+	return error;
+}
+
+int cs7542_fe_live_wfo_register(struct cs7542_fe_live *owner,
+			      struct net_device *conduit,
+			      struct pci_dev *pci, struct net_device *wireless,
+			      enum cs7542_wfo_vif_kind kind,
+			      struct cs7542_wfo_endpoint_info *info)
+{
+	struct cs_wfo_endpoint *ep = NULL;
+	struct device *parent;
+	unsigned int i, label;
+	int error = -ENODEV;
+
+	ASSERT_RTNL();
+	if (!owner || !conduit || !pci || !wireless || !info ||
+	    (kind != CS7542_WFO_STATION && kind != CS7542_WFO_AP) ||
+	    pci->vendor != PCI_VENDOR_ID_ATHEROS ||
+	    (pci->device != 0x0033 && pci->device != 0x003c) ||
+	    wireless->type != ARPHRD_ETHER ||
+	    wireless->addr_len != ETH_ALEN ||
+	    !net_eq(dev_net(wireless), &init_net) ||
+	    wireless->reg_state != NETREG_REGISTERED)
+		return -EOPNOTSUPP;
+	for (parent = wireless->dev.parent; parent && parent != &pci->dev;
+	     parent = parent->parent)
+		;
+	if (!parent)
+		return -EXDEV;
+	mutex_lock(&owner->lock);
+	if (owner->ports[1] != conduit || cs_fe_live_ready(owner))
+		goto unlock;
+	if (owner->backend.pending || owner->hot_state.ledger.blocked ||
+	    owner->hot_state.ledger.pending) {
+		error = -EUCLEAN;
+		goto unlock;
+	}
+	for (i = 0; i < CS_WFO_ENDPOINTS; i++) {
+		struct cs_wfo_endpoint *candidate = &owner->wfo[i];
+		struct net_device *registered = rcu_dereference_protected(
+			candidate->dev, lockdep_is_held(&owner->lock));
+
+		if (registered == wireless) {
+			if (candidate->kind != kind) {
+				error = -ESTALE;
+				goto unlock;
+			}
+			ep = candidate;
+			goto found;
+		}
+		if (!registered && !ep)
+			ep = candidate;
+	}
+	error = -ENOSPC;
+	if (!ep)
+		goto unlock;
+	error = cs_wfo_label_alloc(&owner->wfo_labels, owner,
+				   cs_wfo_label_in_use, cs_wfo_label_drain, &label);
+	if (error)
+		goto unlock;
+	ep->label = label;
+	ep->epoch = owner->wfo_labels.epoch;
+	ep->kind = kind;
+	ep->injecting = false;
+	ep->paused = !netif_running(wireless) || !netif_carrier_ok(wireless);
+	ep->owner = owner;
+	dev_hold(wireless);
+	error = cs_wfo_observe_start(ep, wireless);
+	if (error) {
+		dev_put(wireless);
+		goto unlock;
+	}
+	rcu_assign_pointer(ep->dev, wireless);
+found:
+	*info = (struct cs7542_wfo_endpoint_info) {
+		.epoch = ep->epoch,
+		.ifindex = wireless->ifindex,
+		.label = ep->label,
+	};
+	error = 0;
+unlock:
+	mutex_unlock(&owner->lock);
+	return error;
+}
+EXPORT_SYMBOL_GPL(cs7542_fe_live_wfo_register);
+
+int cs7542_fe_live_wfo_endpoint(struct cs7542_fe_live *owner, u32 ifindex,
+			      struct cs7542_wfo_endpoint_info *out)
+{
+	unsigned int i;
+	int error = -ENOENT;
+
+	ASSERT_RTNL();
+	if (!owner || !ifindex || !out)
+		return -EINVAL;
+	mutex_lock(&owner->lock);
+	if (cs_fe_live_ready(owner)) {
+		error = -ESHUTDOWN;
+		goto unlock;
+	}
+	for (i = 0; i < CS_WFO_ENDPOINTS; i++) {
+		struct cs_wfo_endpoint *ep = &owner->wfo[i];
+		struct net_device *dev = rcu_dereference_protected(ep->dev,
+						lockdep_is_held(&owner->lock));
+
+		if (dev && !READ_ONCE(ep->paused) && dev->ifindex == ifindex &&
+		    netif_running(dev) &&
+		    netif_carrier_ok(dev) && cs_wfo_plain_device(dev)) {
+			*out = (struct cs7542_wfo_endpoint_info) {
+				.epoch = ep->epoch,
+				.ifindex = ifindex,
+				.label = ep->label,
+			};
+			error = 0;
+			break;
+		}
+	}
+unlock:
+	mutex_unlock(&owner->lock);
+	return error;
+}
+EXPORT_SYMBOL_GPL(cs7542_fe_live_wfo_endpoint);
+
+int cs7542_wfo_setup_tc(struct pci_dev *pci, struct net_device *wireless,
+		      enum cs7542_wfo_vif_kind kind, int type, void *data)
+{
+#if IS_ENABLED(CONFIG_CS7542_FT_LIVE_BRIDGE)
+	struct flow_block_offload *block = data;
+	struct cs7542_fe_live *owner, *found = NULL;
+	struct cs7542_wfo_endpoint_info info;
+	struct net_device *conduit = NULL;
+	int error = -ENODEV;
+
+	if (type != TC_SETUP_FT || !block || !wireless ||
+	    block->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS ||
+	    !block->net || !net_eq(block->net, &init_net) ||
+	    !net_eq(dev_net(wireless), &init_net))
+		return -EOPNOTSUPP;
+	if (block->command == FLOW_BLOCK_UNBIND)
+		return cs7542_ft_live_setup_wireless(NULL, wireless->ifindex,
+						     type, data);
+	if (block->command != FLOW_BLOCK_BIND)
+		return -EOPNOTSUPP;
+	/* nft holds its flow-block writer, not RTNL. Never wait on RTNL
+	 * here: netdevice teardown takes those locks in the other order.
+	 * Retained UNBIND above only edits mutex-protected metadata.
+	 */
+	if (!rtnl_trylock())
+		return -EBUSY;
+	mutex_lock(&cs_fe_live_owners_lock);
+	list_for_each_entry(owner, &cs_fe_live_owners, node) {
+		mutex_lock(&owner->lock);
+		if (owner->ports[1] && !cs_fe_live_ready(owner)) {
+			if (found) {
+				mutex_unlock(&owner->lock);
+				error = -EXDEV;
+				goto owners_unlock;
+			}
+			found = owner;
+			conduit = owner->ports[1];
+			dev_hold(conduit);
+			kref_get(&found->refs);
+		}
+		mutex_unlock(&owner->lock);
+	}
+	if (found)
+		error = 0;
+owners_unlock:
+	mutex_unlock(&cs_fe_live_owners_lock);
+	if (!error)
+		error = cs7542_fe_live_wfo_register(found, conduit, pci,
+						 wireless, kind, &info);
+	/* Never acquire live_lock while holding an FE owner mutex. */
+	if (!error)
+		error = cs7542_ne_wfo_setup_tc(conduit, wireless->ifindex,
+					    type, data);
+	if (conduit)
+		dev_put(conduit);
+	if (found)
+		cs7542_fe_live_put(found);
+	rtnl_unlock();
+	return error;
+#else
+	return -EOPNOTSUPP;
+#endif
+}
+EXPORT_SYMBOL_GPL(cs7542_wfo_setup_tc);
+
+/* An edited CPU egress must never fall through to the ordinary QCA tagger. */
+static bool cs_wfo_edited_cpu(const struct cs_wfo_rx_meta *meta)
+{
+	return meta->source == 1 && meta->voq == 56 && meta->class_hit &&
+	       meta->class_index >= 5 &&
+	       meta->class_index < 5 + CS_WFO_RECEIPTS &&
+	       meta->forwarding == 1 && !meta->acl_forward;
+}
+
+bool cs7542_fe_live_wfo_receive(struct cs7542_fe_live *owner,
+			      unsigned int cpu, struct sk_buff *skb,
+			      const u32 cpu_header[4])
+{
+	struct cs_wfo_rx_meta meta = cs_wfo_rx_xram(cpu_header);
+	const struct cs_wfo_receipt *receipt = NULL;
+	struct cs_wfo_live_receipt *live;
+	enum cs_wfo_receipt_kind kind = CS_WFO_RECEIPT_OTHER;
+	struct cs_wfo_packet packet;
+	unsigned int label, i;
+	bool edited = cs_wfo_edited_cpu(&meta);
+
+	/* Wired original HASH/ACL exceptions still take the ordinary DSA path. */
+	if (meta.source != 3 && !edited)
+		return false;
+	if (!owner || cpu != 1 || meta.voq != 56 || !meta.class_hit ||
+	    meta.copy || meta.checksum_error || READ_ONCE(owner->closing) ||
+	    !READ_ONCE(owner->online) || skb_pfmemalloc(skb) ||
+	    skb_is_nonlinear(skb) || skb->len < 18)
+		goto drop;
+	label = get_unaligned_be16(skb->data + 14) & 4095;
+	if (!(edited ? cs_wfo_output_frame(skb->data, skb->len, label) :
+		       cs_wfo_frame(skb->data, skb->len, label)))
+		goto drop;
+	rcu_read_lock();
+	if (meta.class_index >= 5 &&
+	    meta.class_index < 5 + CS_WFO_RECEIPTS) {
+		live = rcu_dereference(owner->wfo_receipts[meta.class_index - 5]);
+		if (live) {
+			receipt = &live->identity;
+			kind = cs_wfo_receipt_metadata(receipt, &meta);
+		}
+	} else if (meta.source == 3 && meta.class_index == CS_WFO_MISS_CLASS &&
+		   !meta.forwarding && !meta.action && !meta.acl_forward) {
+		kind = CS_WFO_RECEIPT_ORIGINAL;
+	}
+	if ((edited && kind != CS_WFO_RECEIPT_TRANSLATED) ||
+	    (!edited && kind != CS_WFO_RECEIPT_ORIGINAL))
+		goto unlock_drop;
+	for (i = 0; i < CS_WFO_ENDPOINTS; i++) {
+		struct cs_wfo_endpoint *ep = &owner->wfo[i];
+		struct net_device *dev = rcu_dereference(ep->dev);
+
+		if (!dev || READ_ONCE(ep->paused) || READ_ONCE(ep->label) != label ||
+		    !netif_running(dev) || !netif_carrier_ok(dev) ||
+		    !cs_wfo_plain_device(dev))
+			continue;
+		if (receipt &&
+		    (receipt->label != label || receipt->path.epoch != READ_ONCE(ep->epoch) ||
+		     (edited ? receipt->path.egress_ifindex :
+			       receipt->path.ingress_ifindex) != dev->ifindex))
+			continue;
+		memmove(skb->data + 4, skb->data, 12);
+		skb_pull(skb, 4);
+		if (edited) {
+			if (!cs_wfo_packet_decode_output(skb->data, skb->len, &packet) ||
+			    !cs_wfo_receipt_output(receipt, &meta, &packet,
+					   READ_ONCE(ep->epoch), label, dev->ifindex))
+				goto unlock_drop;
+			skb->dev = dev;
+			skb_reset_mac_header(skb);
+			skb_set_network_header(skb, ETH_HLEN);
+			skb_set_transport_header(skb, ETH_HLEN +
+						 (packet.ipv6 ? 40 : 20));
+			skb_reset_mac_len(skb);
+			skb->protocol = eth_hdr(skb)->h_proto;
+			skb->ip_summed = CHECKSUM_NONE;
+			skb_clear_hash(skb);
+			/* mac80211 remains the only 802.11/key/PN/TX-status owner. */
+			dev_queue_xmit(skb);
+		} else {
+			/* Close admission before software ingress; its NF hook cannot
+			 * inject this same original packet again. Re-arm requires a
+			 * grace period and a new verified hardware transaction.
+			 */
+			cs_wfo_endpoint_fence(ep);
+			skb->protocol = eth_type_trans(skb, dev);
+			netif_receive_skb_core(skb);
+		}
+		rcu_read_unlock();
+		return true;
+	}
+unlock_drop:
+	rcu_read_unlock();
+drop:
+	dev_kfree_skb_any(skb);
+	return true;
+}
