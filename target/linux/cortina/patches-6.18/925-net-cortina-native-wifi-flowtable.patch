+/* Owner counters, not packet statistics or a claim about table capacity. */
+static int cs_native_reclaim_get(char *buf, const struct kernel_param *kp)
+{
+	struct cs7542_fe_live *owner;
+	int len = 0;
+
+	mutex_lock(&cs_fe_live_owners_lock);
+	list_for_each_entry(owner, &cs_fe_live_owners, node) {
+		unsigned int used = 0, i;
