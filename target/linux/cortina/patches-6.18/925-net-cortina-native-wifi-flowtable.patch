+			owner->hot_state.retire_attempts,
+			owner->hot_state.retire_deferred, used,
+			owner->backend.next_lease,
+			owner->hot_state.reusable_guards);
+		mutex_unlock(&owner->lock);
+		if (len >= PAGE_SIZE - 256)
