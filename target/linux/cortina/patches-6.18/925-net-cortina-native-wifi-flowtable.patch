+#ifdef CONFIG_CS7542_FE_LIVE_OWNER
+static const struct net_device_ops cs_ne_netdev_ops;
+
+int cs7542_ne_wfo_setup_tc(struct net_device *conduit, u32 wireless_ifindex,
+			   int type, void *data)
+{
+#ifdef CONFIG_CS7542_FT_LIVE_BRIDGE
+	struct cs_ne_port *port;
+
+	ASSERT_RTNL();
+	if (!conduit || conduit->netdev_ops != &cs_ne_netdev_ops)
+		return -ENODEV;
+	port = netdev_priv(conduit);
+	if (port->id != 1)
+		return -EXDEV;
+	return cs7542_ft_live_setup_wireless(port->live, wireless_ifindex,
+					    type, data);
+#else
+	return -EOPNOTSUPP;
+#endif
+}
+
+int cs7542_ne_wfo_xmit(struct net_device *conduit, struct sk_buff *skb,
+		       unsigned int label)
+{
+	struct cs_ne_port *port;
+	struct cs_ne_tx_buf *buf;
+	struct cs_ne_txq *txq;
+	struct cs_ne *ne;
+	dma_addr_t dma;
+	int error = -EAGAIN;
+
+	/* No netdev_priv access until this is an actual native NE device. */
+	if (!conduit || conduit->netdev_ops != &cs_ne_netdev_ops || !skb ||
+	    skb_is_nonlinear(skb) || skb_is_gso(skb) ||
+	    skb->len < CS_NE_TX_MIN_LEN ||
+	    skb->ip_summed == CHECKSUM_PARTIAL || skb_vlan_tag_present(skb) ||
+	    !cs_wfo_frame(skb->data, skb->len, label))
+		return -EINVAL;
+	port = netdev_priv(conduit);
+	if (port->id != 1)
+		return -EXDEV;
+	ne = port->ne;
+	txq = &ne->txq;
+	spin_lock_bh(&txq->lock);
+	/* Last-port close/terminal cleanup use this same lock. */
+	if (!port->opened || txq->stopping || txq->poll_stopping || txq->fault)
+		goto unlock;
+	cs_ne_tx_complete(ne);
+	if (txq->fault || cs_ne_tx_free(txq) < 2)
+		goto unlock;
+	dma = dma_map_single(ne->dev, skb->data, skb->len, DMA_TO_DEVICE);
+	if (dma_mapping_error(ne->dev, dma)) {
+		error = -EIO;
+		goto unlock;
+	}
+	/* The owned copy must not retain a wireless netdevice after its
+	 * unregister. Completion only belongs to this native NE from here.
+	 */
+	skb->dev = conduit;
+	buf = &txq->bufs[txq->head];
+	buf->skb = skb;
+	buf->dma = dma;
+	buf->len = skb->len;
+	buf->page = false;
+	cs_ne_tx_desc(txq, cs_wfo_tx_header(), dma, skb->len, skb->len,
+		      true, true);
+	dma_wmb();
+	txq->head = (txq->head + 1) & (CS_NE_TX_DESC_NUM - 1);
+	writel(txq->head, ne->dma + DMA_LSO_TXQ_WPTR(0));
+	if (cs_ne_tx_free(txq) < CS_NE_TX_MAX_FRAGS + 2)
+		cs_ne_tx_stop_all(ne);
+	cs_ne_tx_arm_timer(txq);
+	error = 0;
+unlock:
+	spin_unlock_bh(&txq->lock);
+	return error;
+}
