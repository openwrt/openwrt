+/* No packed native bitfields: the SDK CPU headers are two LE64 words. */
+struct cs_wfo_rx_meta {
+	u32 action;
+	u16 result;
+	u8 source, voq, class_index;
+	u8 forwarding;
+	bool class_hit, copy, checksum_error, acl_forward;
+};
+
+static inline struct cs_wfo_rx_meta
+cs_wfo_rx_decode(const u32 words[4])
+{
+	return (struct cs_wfo_rx_meta) {
+		.source = (words[0] >> 21) & 15,
+		.acl_forward = !!(words[0] & (1U << 7)),
+		.result = ((words[0] >> 25) | (words[1] << 7)) & 8191,
+		.voq = (words[1] >> 6) & 255,
+		.action = words[2] & 0xfffff,
+		.class_index = (words[3] >> 17) & 63,
+		.class_hit = !!(words[3] & (1U << 23)),
+		.forwarding = words[1] >> 30,
+		.copy = !!(words[2] & (1U << 30)),
+		.checksum_error = !!(words[2] & (3U << 28)),
+	};
+}
+
+/* XRAM stores the high32 word first for each CPU64 header. */
+static inline struct cs_wfo_rx_meta
+cs_wfo_rx_xram(const u32 xram[4])
+{
+	u32 words[4] = { xram[1], xram[0], xram[3], xram[2] };
+
+	return cs_wfo_rx_decode(words);
+}
