+static inline bool cs_wfo_label_valid(unsigned int label)
+{
+	return label && label < 4095;
+}
+
+static inline bool cs_wfo_output_frame(const u8 *frame, unsigned int bytes,
+				       unsigned int label)
+{
+	return cs_wfo_label_valid(label) && bytes >= 18 && bytes <= 1518 &&
+	       frame[12] == 0x81 && !frame[13] &&
+	       (frame[14] >> 6) == 2 && (frame[14] & 15) == (label >> 8) &&
+	       frame[15] == (label & 255) &&
+	       ((frame[16] == 8 && !frame[17]) ||
+		(frame[16] == 0x86 && frame[17] == 0xdd));
+}
+
+static inline bool cs_wfo_frame(const u8 *frame, unsigned int bytes,
+				unsigned int label)
+{
+	/* New CPU input uses canonical priority; FVLAN egress preserves the
+	 * incoming QCA header's upper priority bits, outside the epoch VID.
+	 */
+	return cs_wfo_output_frame(frame, bytes, label) &&
+	       (frame[14] & 0xf0) == 0x80;
+}
+
+/*
+ * Linux is still the checksum/crypto owner. This codec only inserts the
+ * internal endpoint tag in a separately allocated, linear Ethernet frame.
+ * A failed call leaves the destination unchanged. Source/destination must
+ * be disjoint or identical; the kernel wrapper supplies separate storage.
+ */
+static inline int cs_wfo_frame_encode(u8 *out, unsigned int capacity,
+				      const u8 *frame, unsigned int bytes,
+				      unsigned int label)
+{
+	if (!cs_wfo_label_valid(label) || bytes < 14 || bytes > 1514 ||
+	    capacity < bytes + 4 ||
+	    !((frame[12] == 8 && !frame[13]) ||
+	      (frame[12] == 0x86 && frame[13] == 0xdd)))
+		return -EINVAL;
+	/* memmove permits an in-place expansion after all validation. */
+	memmove(out + 16, frame + 12, bytes - 12);
+	memmove(out, frame, 12);
+	out[12] = 0x81;
+	out[13] = 0;
+	out[14] = 0x80 | (label >> 8);
+	out[15] = label;
+	return bytes + 4;
+}
+
+/* HEADER_A normal forwarding (not CPU bypass), physical source CPU3. */
+static inline u32 cs_wfo_tx_header(void)
+{
+	return 1U | (3U << 16);
+}
