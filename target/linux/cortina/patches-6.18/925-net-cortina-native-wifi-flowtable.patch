+			       const struct cs7542_wfo_native_request *request,
+			       const struct flow_cls_offload *cls);
+
+/* RTNL held; current native-driver-attested endpoint, without packet evidence. */
+int cs7542_fe_live_wfo_endpoint(struct cs7542_fe_live *owner, u32 ifindex,
+				struct cs7542_wfo_endpoint_info *out);
+
+/* RTNL held; exact original tuple observed before any software NAT. */
+int cs7542_fe_live_wfo_lookup(struct cs7542_fe_live *owner, u32 ifindex,
+			      const struct cs_fe_rule *rule,
+			      struct cs7542_wfo_observation *out);
+
