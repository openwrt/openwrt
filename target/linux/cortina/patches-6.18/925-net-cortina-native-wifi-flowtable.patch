@@ -0,0 +1,202 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef CS_WFO_PACKET_H
+#define CS_WFO_PACKET_H
+
+#include <linux/cs7542_fe_codec.h>
+
+struct cs_wfo_packet {
+	struct cs_fe_tuple tuple;
+	u32 src6[4], dst6[4];
+	u16 bytes;
+	u8 source[6], destination[6], proto, hop_limit;
+	bool ipv6, checksum_valid, udp_zero_checksum;
+};
+
+static inline unsigned int cs_wfo_be16(const u8 *p)
+{
+	return (p[0] << 8) | p[1];
+}
+
+static inline u32 cs_wfo_be32(const u8 *p)
+{
+	return ((u32)p[0] << 24) | ((u32)p[1] << 16) |
+	       ((u32)p[2] << 8) | p[3];
+}
+
+static inline unsigned int cs_wfo_sum(unsigned int sum, const u8 *p,
+				      unsigned int bytes)
+{
+	while (bytes > 1) {
+		sum += cs_wfo_be16(p);
+		p += 2;
+		bytes -= 2;
+	}
+	if (bytes)
+		sum += p[0] << 8;
+	return sum;
+}
+
+static inline bool cs_wfo_sum_valid(unsigned int sum)
+{
+	while (sum >> 16)
+		sum = (sum & 65535) + (sum >> 16);
+	return sum == 65535;
+}
+
+static inline bool cs_wfo_mac_valid(const u8 *mac)
+{
+	return !(mac[0] & 1) &&
+	       (mac[0] | mac[1] | mac[2] | mac[3] | mac[4] | mac[5]);
+}
+
+/*
+ * A header-only observation may corroborate the NF-established flow later;
+ * it NEVER authorizes DMA. Before FE injection complete must be true, so
+ * both the full transport checksum and all bounds have been checked. VLAN,
+ * GSO/partial checksum SKBs, IPv4 fragments/options, IPv6 extensions and exceptional
+ * packets stay in Linux. TCP options fit in the bounded114-byte header view.
+ */
+static inline bool
+cs_wfo_packet_decode_mode(const u8 *p, unsigned int available,
+			  unsigned int wire_bytes, bool complete, bool output,
+			  struct cs_wfo_packet *out)
+{
+	struct cs_wfo_packet next = {};
+	unsigned int ether, offset, l4_bytes, sum, i, end;
+
+	if (wire_bytes < 14 || wire_bytes > 1514 || available < 14 ||
+	    !cs_wfo_mac_valid(p) || !cs_wfo_mac_valid(p + 6))
+		return false;
+	ether = cs_wfo_be16(p + 12);
+	if (ether == 0x0800) {
+		if (available < 34 || p[14] != 0x45 || !p[22] ||
+		    (cs_wfo_be16(p + 20) & 0xbfff) ||
+		    !cs_wfo_sum_valid(cs_wfo_sum(0, p + 14, 20)))
+			return false;
+		end = 14 + cs_wfo_be16(p + 16);
+		offset = 34;
+		next.proto = p[23];
+		next.hop_limit = p[22];
+		next.tuple.src = cs_wfo_be32(p + 26);
+		next.tuple.dst = cs_wfo_be32(p + 30);
+		sum = cs_wfo_sum(0, p + 26, 8);
+	} else if (ether == 0x86dd) {
+		if (available < 54 || (p[14] >> 4) != 6 || !p[21] ||
+		    !cs_wfo_be16(p + 18))
+			return false;
+		end = 54 + cs_wfo_be16(p + 18);
+		offset = 54;
+		next.ipv6 = true;
+		next.proto = p[20];
+		next.hop_limit = p[21];
+		for (i = 0; i < 4; i++) {
+			next.src6[i] = cs_wfo_be32(p + 22 + i * 4);
+			next.dst6[i] = cs_wfo_be32(p + 38 + i * 4);
+		}
+		sum = cs_wfo_sum(0, p + 22, 32);
+	} else {
+		return false;
+	}
+	if (end > wire_bytes || end < offset ||
+	    (complete && end > available))
+		return false;
+	l4_bytes = end - offset;
+	if (next.proto == 17) {
+		if (l4_bytes < 8 || available < offset + 8 ||
+		    cs_wfo_be16(p + offset + 4) != l4_bytes ||
+		    (!cs_wfo_be16(p + offset + 6) && (!output || next.ipv6)))
+			return false;
+	} else if (next.proto == 6) {
+		if (l4_bytes < 20 || available < offset + 20 ||
+		    (!output && (p[offset + 12] & 15)) ||
+		    (p[offset + 12] >> 4) < 5 ||
+		    (p[offset + 12] >> 4) * 4 > l4_bytes ||
+		    (p[offset + 12] >> 4) * 4 > available - offset ||
+		    (p[offset + 13] & ~0xd8) || !(p[offset + 13] & 0x10))
+			return false;
+	} else {
+		return false;
+	}
+	if (complete) {
+		/* IPv4 UDP may legitimately omit its checksum. This output-only
+		 * exception is never proof of a verified transport checksum.
+		 */
+		next.udp_zero_checksum = output && !next.ipv6 && next.proto == 17 &&
+					!cs_wfo_be16(p + offset + 6);
+		if (!next.udp_zero_checksum) {
+			sum = cs_wfo_sum(sum + next.proto + l4_bytes, p + offset, l4_bytes);
+			if (!cs_wfo_sum_valid(sum))
+				return false;
+		}
+	}
+	next.tuple.sport = cs_wfo_be16(p + offset);
+	next.tuple.dport = cs_wfo_be16(p + offset + 2);
+	next.bytes = end;
+	next.checksum_valid = complete && !next.udp_zero_checksum;
+	memcpy(next.source, p + 6, 6);
+	memcpy(next.destination, p, 6);
+	*out = next;
+	return true;
+}
+
+/* Strict admission/observation: unusual packets remain with Linux. */
+static inline bool cs_wfo_packet_decode(const u8 *p, unsigned int available,
+					unsigned int wire_bytes, bool complete,
+					struct cs_wfo_packet *out)
+{
+	return cs_wfo_packet_decode_mode(p, available, wire_bytes, complete,
+					false, out);
+}
+
+/* A wired HASH hit can carry TCP NS/reserved bits or IPv4 UDP checksum zero.
+ * Bounds, IP checksum, TCP control flags and every present L4 checksum still
+ * require validation. Neither exception enables stricter CPU input admission.
+ */
+static inline bool cs_wfo_packet_decode_output(const u8 *p, unsigned int bytes,
+					       struct cs_wfo_packet *out)
+{
+	return cs_wfo_packet_decode_mode(p, bytes, bytes, true, true, out);
+}
+
+static inline bool cs_wfo_packet_output_checked(const struct cs_wfo_packet *p)
+{
+	return p->checksum_valid ||
+	       (p->udp_zero_checksum && !p->ipv6 && p->proto == 17);
+}
+
+static inline bool cs_wfo_packet_match(const struct cs_wfo_packet *p,
+				       const struct cs_fe_rule *rule,
+				       const u8 input_smac[6], bool edited)
+{
+	const struct cs_fe_tuple *tuple = edited ? &rule->translated :
+						  &rule->original;
+	unsigned int i;
+
+	if (p->ipv6 != rule->ipv6 ||
+	    p->proto != (rule->native_l4proto ?: 17) ||
+	    p->tuple.src != tuple->src || p->tuple.dst != tuple->dst ||
+	    p->tuple.sport != tuple->sport || p->tuple.dport != tuple->dport ||
+	    memcmp(p->source, edited ? rule->smac : input_smac, 6) ||
+	    memcmp(p->destination,
+		   edited ? rule->dmac : rule->ingress.base_mac, 6))
+		return false;
+	if (p->ipv6)
+		for (i = 0; i < 4; i++)
+			if (p->src6[i] != rule->src6[i] ||
+			    p->dst6[i] != rule->dst6[i])
+				return false;
+	return true;
+}
+
+static inline bool cs_wfo_packet_same_key(const struct cs_wfo_packet *a,
+					  const struct cs_wfo_packet *b)
+{
+	return a->ipv6 == b->ipv6 && a->proto == b->proto &&
+	       a->tuple.src == b->tuple.src && a->tuple.dst == b->tuple.dst &&
+	       a->tuple.sport == b->tuple.sport &&
+	       a->tuple.dport == b->tuple.dport &&
+	       (!a->ipv6 || (!memcmp(a->src6, b->src6, sizeof(a->src6)) &&
+			    !memcmp(a->dst6, b->dst6, sizeof(a->dst6))));
+}
+
+#endif
