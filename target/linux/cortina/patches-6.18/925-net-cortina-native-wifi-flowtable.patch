@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Strict CPU input uses a private copy; all failures preserve the original. */
+static bool cs_wfo_input_plain(struct sk_buff *skb)
+{
+	if (skb->pkt_type != PACKET_HOST || skb->sk || skb->mark || skb->priority ||
+	    skb->encapsulation || skb_get_nfct(skb) || skb_has_extensions(skb) ||
+	    skb_dst(skb) || skb_pfmemalloc(skb))
+		return false;
+#ifdef CONFIG_NETWORK_SECMARK
+	if (skb->secmark)
+		return false;
+#endif
+#ifdef CONFIG_NET_SWITCHDEV
+	if (skb->offload_fwd_mark || skb->offload_l3_fwd_mark)
+		return false;
+#endif
+	return true;
+}
+
+static bool cs_wfo_try_inject(struct cs_wfo_endpoint *ep, struct sk_buff *skb)
+{
+	struct cs7542_fe_live *owner = ep->owner;
+	struct net_device *dev = rcu_dereference(ep->dev), *conduit;
+	struct cs_wfo_live_receipt *live;
+	struct cs_wfo_packet packet;
+	struct sk_buff *copy;
+	unsigned int bytes, i;
+	bool sent = false;
+
+	if (!dev || !READ_ONCE(ep->injecting) || READ_ONCE(ep->paused) ||
+	    skb->dev != dev || !netif_running(dev) || !netif_carrier_ok(dev) ||
+	    !cs_wfo_plain_device(dev) || !cs_wfo_input_plain(skb) ||
+	    skb_vlan_tag_present(skb) || skb_is_gso(skb) ||
+	    skb->ip_summed == CHECKSUM_PARTIAL || skb->len > 1500 ||
+	    !skb_mac_header_was_set(skb) || skb_headroom(skb) < ETH_HLEN ||
+	    skb_mac_header(skb) != skb->data - ETH_HLEN)
+		return false;
+	bytes = skb->len + ETH_HLEN;
+	copy = alloc_skb(NET_SKB_PAD + NET_IP_ALIGN + bytes + 4, GFP_ATOMIC);
+	if (!copy)
+		return false;
+	skb_reserve(copy, NET_SKB_PAD + NET_IP_ALIGN);
+	skb_put(copy, bytes + 4);
+	if (skb_copy_bits(skb, -ETH_HLEN, copy->data, bytes) ||
+	    !cs_wfo_packet_decode(copy->data, bytes, bytes, true, &packet) ||
+	    packet.hop_limit <= 1 ||
+	    cs_wfo_frame_encode(copy->data, bytes + 4, copy->data, bytes,
+				 READ_ONCE(ep->label)) < 0)
+		goto free;
+	/* No owner mutex or RTNL in a packet callback. Owner removal unregisters
+	 * this hook and waits for network readers before dropping conduit refs.
+	 * Lock order: producer fence -> native shared TX lock, never the reverse.
+	 */
+	spin_lock_bh(&owner->wfo_tx_lock);
+	conduit = READ_ONCE(owner->ports[1]);
+	if (!READ_ONCE(ep->injecting) || READ_ONCE(ep->paused) ||
+	    READ_ONCE(owner->closing) || !READ_ONCE(owner->online) || !conduit ||
+	    !netif_running(conduit) || !netif_carrier_ok(conduit) ||
+	    !cs_wfo_plain_device(dev))
+		goto unlock;
+	for (i = 0; i < CS_WFO_RECEIPTS; i++) {
+		live = rcu_dereference(owner->wfo_receipts[i]);
+		if (!live || !live->admitting || !live->identity.wireless_input ||
+		    live->identity.label != ep->label ||
+		    live->identity.path.epoch != ep->epoch ||
+		    live->identity.path.ingress_ifindex != dev->ifindex ||
+		    !cs_wfo_packet_match(&packet, &live->identity.path.rule,
+				 live->identity.path.ingress_smac, false))
+			continue;
+		/* The native producer owns the copy only on success. DMA-map/ring
+		 * pressure errors leave it ours and leave the original untouched.
+		 */
+		sent = !cs7542_ne_wfo_xmit(conduit, copy, ep->label);
+		break;
+	}
+unlock:
+	spin_unlock_bh(&owner->wfo_tx_lock);
+	if (sent) {
+		consume_skb(skb);
+		return true;
+	}
+free:
+	dev_kfree_skb_any(copy);
+	return false;
+}
