+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef CS_WFO_RECEIPT_H
+#define CS_WFO_RECEIPT_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/string.h>
+#else
+#include <errno.h>
+#include <string.h>
+#endif
+
+#include "cs_wfo_packet.h"
+#include "cs_wfo_transport.h"
+
+#define CS_WFO_RECEIPTS 16
+#define CS_WFO_RESULT_ROWS 8
+
+/* Owner-built immutable identity, never supplied as an external row handle. */
+struct cs_wfo_receipt_seed {
+	struct cs_fe_rule rule;
+	unsigned long long epoch;
+	u32 ingress_ifindex, egress_ifindex;
+	u8 ingress_smac[6];
+};
+
+struct cs_wfo_receipt {
+	struct cs_wfo_receipt_seed path;
+	u32 miss_marker;
+	u16 label, class_row, hit_fwd;
+	bool wireless_input;
+};
+
+enum cs_wfo_receipt_kind {
+	CS_WFO_RECEIPT_OTHER,
+	CS_WFO_RECEIPT_ORIGINAL,
+	CS_WFO_RECEIPT_TRANSLATED,
+	CS_WFO_RECEIPT_BAD,
+};
+
+/* Canonical typed lease rows/plan only. Construction does not arm admission. */
+static inline int cs_wfo_receipt_build(const struct cs_wfo_receipt_seed *seed,
+				       const struct cs_fe_rows *rows,
+				       const struct cs_fe_plan *plan,
+				       struct cs_wfo_receipt *out)
+{
+	struct cs_wfo_receipt next = {};
+	const struct cs_fe_link *cpu, *wired;
+	bool in, egress;
+
+	if (!seed || !rows || !plan || !out || !seed->epoch ||
+	    !seed->ingress_ifindex || !seed->egress_ifindex ||
+	    seed->ingress_ifindex == seed->egress_ifindex)
+		return -EINVAL;
+	in = cs_fe_link_cpu_nat(&seed->rule.ingress);
+	egress = cs_fe_link_cpu_nat(&seed->rule.egress);
+	if (in == egress || !seed->rule.decrement_ttl ||
+	    !cs_wfo_mac_valid(seed->ingress_smac) ||
+	    !cs_wfo_mac_valid(seed->rule.ingress.base_mac) ||
+	    !cs_wfo_mac_valid(seed->rule.smac) ||
+	    !cs_wfo_mac_valid(seed->rule.dmac) ||
+	    memcmp(seed->rule.smac, seed->rule.egress.base_mac, 6))
+		return -EOPNOTSUPP;
+	cpu = in ? &seed->rule.ingress : &seed->rule.egress;
+	wired = in ? &seed->rule.egress : &seed->rule.ingress;
+	if (wired->gmac != 1 || wired->cpu_port || wired->tag_mode != 4 ||
+	    wired->base_voq != 8 || wired->switch_port < 1 ||
+	    wired->switch_port > 5 || rows->class_row < 5 ||
+	    rows->class_row >= 5 + CS_WFO_RECEIPTS ||
+	    rows->sdb_row != rows->class_row ||
+	    rows->miss_fwd != 5 + (rows->class_row - 5) * 2 ||
+	    rows->hit_fwd < 6 ||
+	    rows->hit_fwd >= 6 + 2 * CS_WFO_RESULT_ROWS || rows->hit_fwd % 2 ||
+	    !rows->miss_marker || rows->miss_marker > 0xfffff ||
+	    !(plan->requirements & CS_FE_REQ_WFO_ENDPOINT) ||
+	    (plan->hash[1] & 8191) != rows->hit_fwd ||
+	    (plan->voq.expected[0] & 255) != seed->rule.egress.base_voq ||
+	    /* SWAP_B retains input priority/version above the endpoint VID. */
+	    plan->predicted_tx_qca != (in ?
+			(0x8080 | (1U << wired->switch_port)) :
+			((wired->rx_qca_meta & 0xf000) |
+			 (cpu->rx_qca_meta & 4095))))
+		return -EUCLEAN;
+	next.path = *seed;
+	next.label = cpu->rx_qca_meta & 4095;
+	next.class_row = rows->class_row;
+	/* A shared immutable action need not have this selector's index. */
+	next.hit_fwd = rows->hit_fwd;
+	next.miss_marker = rows->miss_marker;
+	next.wireless_input = in;
+	*out = next;
+	return 0;
+}
+
+static inline enum cs_wfo_receipt_kind
+cs_wfo_receipt_metadata(const struct cs_wfo_receipt *receipt,
+			const struct cs_wfo_rx_meta *meta)
+{
+	if (meta->source != (receipt->wireless_input ? 3 : 1) ||
+	    !meta->class_hit || meta->class_index != receipt->class_row)
+		return CS_WFO_RECEIPT_OTHER;
+	if (meta->voq != 56 || meta->copy || meta->checksum_error)
+		return CS_WFO_RECEIPT_BAD;
+	/* Hash-result indices have no authority when the hash did not hit. */
+	if (meta->acl_forward ||
+	    (!meta->forwarding && meta->action == receipt->miss_marker))
+		return CS_WFO_RECEIPT_ORIGINAL;
+	if (meta->forwarding == 1 && meta->result == receipt->hit_fwd &&
+	    !receipt->wireless_input)
+		return CS_WFO_RECEIPT_TRANSLATED;
+	return CS_WFO_RECEIPT_BAD;
+}
+
+/* The caller must first output-decode the complete untagged Ethernet frame. */
+static inline bool
+cs_wfo_receipt_output(const struct cs_wfo_receipt *receipt,
+		      const struct cs_wfo_rx_meta *meta,
+		      const struct cs_wfo_packet *packet,
+		      unsigned long long current_epoch, unsigned int label,
+		      unsigned int ifindex)
+{
+	return cs_wfo_packet_output_checked(packet) &&
+	       cs_wfo_receipt_metadata(receipt, meta) ==
+		       CS_WFO_RECEIPT_TRANSLATED &&
+	       receipt->path.epoch == current_epoch &&
+	       receipt->label == label &&
+	       receipt->path.egress_ifindex == ifindex &&
+	       cs_wfo_packet_match(packet, &receipt->path.rule,
+				   receipt->path.ingress_smac, true);
+}
+
+#endif
