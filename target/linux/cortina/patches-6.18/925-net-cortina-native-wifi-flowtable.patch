+++ b/drivers/net/ethernet/cortina/cs_wfo_observe.inc
@@ -0,0 +1,158 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Per-endpoint ingress observations; no skb modification or DMA admission. */
+
+static unsigned int cs_wfo_cache_index(const struct cs_wfo_endpoint *ep,
+				       const struct cs_wfo_packet *p)
+{
+	u32 key[12] = { p->tuple.src, p->tuple.dst,
+		       ((u32)p->tuple.sport << 16) | p->tuple.dport,
+		       p->proto | (p->ipv6 << 8) };
+
+	if (p->ipv6) {
+		memcpy(key + 4, p->src6, sizeof(p->src6));
+		memcpy(key + 8, p->dst6, sizeof(p->dst6));
+	}
+	return jhash2(key, ARRAY_SIZE(key), ep->label) % ARRAY_SIZE(ep->cache);
+}
+
+static unsigned int cs_wfo_observe(void *private, struct sk_buff *skb,
+				  const struct nf_hook_state *state)
+{
+	struct cs_wfo_endpoint *ep = private;
+	struct net_device *dev = rcu_dereference(ep->dev);
+	struct cs_wfo_cached_input *entry;
+	struct cs_wfo_packet packet;
+	u8 header[114];
+	unsigned int bytes;
+
+	if (state->in == dev && cs_wfo_try_inject(ep, skb))
+		return NF_STOLEN;
+	if (!dev || READ_ONCE(ep->paused) || state->in != dev || skb->dev != dev ||
+	    !netif_running(dev) || !netif_carrier_ok(dev) ||
+	    !cs_wfo_plain_device(dev) ||
+	    skb_vlan_tag_present(skb) || skb_is_gso(skb) ||
+	    skb->ip_summed == CHECKSUM_PARTIAL ||
+	    skb->len > 1500 || !skb_mac_header_was_set(skb) ||
+	    skb_headroom(skb) < ETH_HLEN ||
+	    skb_mac_header(skb) != skb->data - ETH_HLEN)
+		return NF_ACCEPT;
+	bytes = min_t(unsigned int, sizeof(header), skb->len + ETH_HLEN);
+	if (skb_copy_bits(skb, -ETH_HLEN, header, bytes) ||
+	    !cs_wfo_packet_decode(header, bytes, skb->len + ETH_HLEN,
+				  false, &packet))
+		return NF_ACCEPT;
+	entry = &ep->cache[cs_wfo_cache_index(ep, &packet)];
+	spin_lock_bh(&ep->cache_lock);
+	if (READ_ONCE(ep->paused))
+		goto unlock;
+	if (!entry->valid || !time_before(jiffies, entry->expires)) {
+		entry->packet = packet;
+		entry->valid = true;
+		entry->ambiguous = false;
+	} else if (!cs_wfo_packet_same_key(&entry->packet, &packet)) {
+		/* A fresh colliding key cannot erase another flow's observation. */
+		goto unlock;
+	} else if (memcmp(entry->packet.source, packet.source, ETH_ALEN) ||
+		   memcmp(entry->packet.destination, packet.destination, ETH_ALEN)) {
+		entry->ambiguous = true;
+	}
+	entry->expires = jiffies + 2 * HZ;
+unlock:
+	spin_unlock_bh(&ep->cache_lock);
+	return NF_ACCEPT;
+}
+
+static void cs_wfo_observe_pause(struct cs_wfo_endpoint *ep, bool paused)
+{
+	spin_lock_bh(&ep->cache_lock);
+	WRITE_ONCE(ep->paused, paused);
+	memset(ep->cache, 0, sizeof(ep->cache));
+	spin_unlock_bh(&ep->cache_lock);
+}
+
+static int cs_wfo_observe_start(struct cs_wfo_endpoint *ep,
+			       struct net_device *dev)
+{
+	int error;
+
+	spin_lock_init(&ep->cache_lock);
+	memset(ep->cache, 0, sizeof(ep->cache));
+	ep->hook = (struct nf_hook_ops) {
+		.hook = cs_wfo_observe,
+		.dev = dev,
+		.priv = ep,
+		.pf = NFPROTO_NETDEV,
+		.hooknum = NF_NETDEV_INGRESS,
+		.priority = NF_IP_PRI_FIRST,
+	};
+	error = nf_register_net_hook(&init_net, &ep->hook);
+	if (!error)
+		ep->hook_registered = true;
+	return error;
+}
+
+static void cs_wfo_observe_stop(struct cs_wfo_endpoint *ep)
+{
+	if (ep->hook_registered) {
+		nf_unregister_net_hook(&init_net, &ep->hook);
+		ep->hook_registered = false;
+	}
+	/* Enclosing removal supplies synchronize_net before slot/dev release. */
+}
+
+int cs7542_fe_live_wfo_lookup(struct cs7542_fe_live *owner, u32 ifindex,
+			    const struct cs_fe_rule *rule,
+			    struct cs7542_wfo_observation *out)
+{
+	struct cs_wfo_packet key = {};
+	unsigned int i;
+	int error = -ENOENT;
+
+	ASSERT_RTNL();
+	if (!owner || !ifindex || !rule || !out)
+		return -EINVAL;
+	key.tuple = rule->original;
+	key.ipv6 = rule->ipv6;
+	key.proto = rule->native_l4proto ?: 17;
+	memcpy(key.src6, rule->src6, sizeof(key.src6));
+	memcpy(key.dst6, rule->dst6, sizeof(key.dst6));
+	mutex_lock(&owner->lock);
+	if (cs_fe_live_ready(owner)) {
+		error = -ESHUTDOWN;
+		goto unlock;
+	}
+	for (i = 0; i < CS_WFO_ENDPOINTS; i++) {
+		struct cs_wfo_endpoint *ep = &owner->wfo[i];
+		struct net_device *dev = rcu_dereference_protected(ep->dev,
+						lockdep_is_held(&owner->lock));
+		struct cs_wfo_cached_input *entry;
+
+		if (!dev || READ_ONCE(ep->paused) || dev->ifindex != ifindex ||
+		    !netif_running(dev) ||
+		    !netif_carrier_ok(dev) || !cs_wfo_plain_device(dev))
+			continue;
+		entry = &ep->cache[cs_wfo_cache_index(ep, &key)];
+		spin_lock_bh(&ep->cache_lock);
+		if (entry->valid && time_before(jiffies, entry->expires) &&
+		    cs_wfo_packet_same_key(&entry->packet, &key)) {
+			if (entry->ambiguous) {
+				error = -EUCLEAN;
+			} else {
+				*out = (struct cs7542_wfo_observation) {
+					.endpoint = { .epoch = ep->epoch,
+						      .label = ep->label,
+						      .ifindex = ifindex },
+				};
+				memcpy(out->source, entry->packet.source, ETH_ALEN);
+				memcpy(out->destination, entry->packet.destination, ETH_ALEN);
+				error = 0;
+			}
+		}
+		spin_unlock_bh(&ep->cache_lock);
+		break;
+	}
+unlock:
+	mutex_unlock(&owner->lock);
+	return error;
+}
+EXPORT_SYMBOL_GPL(cs7542_fe_live_wfo_lookup);
