+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef CS_FE_RETIRE_H
+#define CS_FE_RETIRE_H
+#include "cs_fe_encode.h"
+
+/* Fixed external-DDR profile; no counter-only or elapsed-time-only fence. */
+struct cs_fe_retire_sample {
+	u32 ni_fifo, pp_state, pp_count, pe_debug;
+	u32 qm_status, tm_buffers, tm_global, tm_internal;
+	u32 cpu_free[4], cpu_total[4];
+};
+
+static inline bool cs_fe_retire_empty(const struct cs_fe_retire_sample *s,
+				      const u16 pools[8])
+{
+	u32 byte = s->pe_debug & 255;
+	unsigned int i;
+
+	/* NI packet FIFO empty, initialized, all 1024 FIFO credits free, no error. */
+	if ((s->ni_fifo & 0x7fffffffU) != 0x40040000 || s->pp_state ||
+	    s->pe_debug != byte * 0x01010101U ||
+	    s->pp_count != byte * 0x00010101U)
+		return false;
+	/* Compare both total and free fields; never learn an idle threshold
+	 * from the last observation, which could itself contain a live packet.
+	 */
+	if (((s->qm_status >> 16) & 4095) != 2047 ||
+	    s->tm_buffers != 0x07ff0800 || s->tm_global != 0x08000800 ||
+	    s->tm_internal != 0x04000400)
+		return false;
+	for (i = 0; i < 8; i++) {
+		unsigned int shift = (i & 1) * 16;
+		u32 total = (s->cpu_total[i / 2] >> shift) & 8191;
+		u32 free = (s->cpu_free[i / 2] >> shift) & 8191;
+
+		if (total != pools[i] || free != total)
+			return false;
+	}
+	return true;
+}
+#endif
