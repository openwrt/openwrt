+	CS7542_WFO_AP,
+};
+
+struct cs7542_wfo_endpoint_info {
+	u64 epoch;
+	u32 ifindex;
+	u16 label;
+};
+
+struct cs7542_wfo_observation {
+	struct cs7542_wfo_endpoint_info endpoint;
+	u8 source[6], destination[6];
+};
+
+/* Keep the existing wired request/snapshot layout and symbols unchanged. */
+#define CS7542_WFO_NATIVE_ABI 1
