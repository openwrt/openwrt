+/* SPDX-License-Identifier: GPL-2.0 */
+/* The owner mutex serializes publication; RX keeps identities under RCU. */
+static void cs_wfo_receipt_fence(struct cs7542_fe_live *owner, unsigned int slot)
+{
+	struct cs_wfo_live_receipt *live;
+
+	lockdep_assert_held(&owner->lock);
+	if (slot >= CS_WFO_RECEIPTS)
+		return;
+	spin_lock_bh(&owner->wfo_tx_lock);
+	live = rcu_dereference_protected(owner->wfo_receipts[slot],
+					 lockdep_is_held(&owner->lock));
+	if (live)
+		live->admitting = false;
+	spin_unlock_bh(&owner->wfo_tx_lock);
+}
+
+static void cs_wfo_endpoint_fence(struct cs_wfo_endpoint *ep)
+{
+	/* The packet producer will hold this same lock through TX publication. */
+	spin_lock_bh(&ep->owner->wfo_tx_lock);
+	WRITE_ONCE(ep->injecting, false);
+	spin_unlock_bh(&ep->owner->wfo_tx_lock);
+}
+
+static int cs_wfo_receipt_publish(struct cs7542_fe_live *owner, unsigned int slot,
+				  const struct cs_fe_rows *rows,
+				  const struct cs_fe_plan *plan)
+{
+	struct cs_wfo_live_receipt *next = NULL, *old;
+	int error;
+
+	lockdep_assert_held(&owner->lock);
+	if (slot >= CS_WFO_RECEIPTS)
+		return -EINVAL;
+	if (plan->requirements & CS_FE_REQ_WFO_ENDPOINT) {
+		if (!owner->wfo_pending)
+			return -EOPNOTSUPP;
