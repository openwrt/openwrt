+			used += owner->backend.lease[i].reserved;
+		len += sysfs_emit_at(buf, len,
+			"epoch=%llu reclaimed=%llu attempts=%llu deferred=%llu reserved=%u highwater=%u reusable_guards=0x%x\n",
