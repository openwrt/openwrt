@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef CS_WFO_LABELS_H
+#define CS_WFO_LABELS_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#else
+#include <errno.h>
+#endif
+
+#define CS_WFO_LABEL_MAX 4094
+
+struct cs_wfo_label_state {
+	unsigned long long epoch;
+	unsigned int highwater;
+};
+
+/* Caller serializes endpoint, lease and receipt changes with the owner lock.
+ * in_use covers retained hardware rules, not just registered interfaces.
+ * drain must fence old CPU readers and the engine before a VID is reused.
+ */
+static inline int
+cs_wfo_label_alloc(struct cs_wfo_label_state *state, void *context,
+		   int (*in_use)(void *context, unsigned int label),
+		   int (*drain)(void *context), unsigned int *label)
+{
+	unsigned int candidate;
+	int error;
+
+	if (state->highwater > CS_WFO_LABEL_MAX)
+		return -EUCLEAN;
+	if (state->epoch == ~0ULL)
+		return -EOVERFLOW;
+	for (candidate = 1; candidate <= state->highwater; candidate++) {
+		error = in_use(context, candidate);
+		if (error < 0)
+			return error;
+		if (error)
+			continue;
+		error = drain(context);
+		if (!error)
+			goto allocated;
+		if (error != -EAGAIN && error != -EOPNOTSUPP)
+			return error;
+		break;
+	}
+	/* A busy/unsupported drain cannot authorize reuse. A never-published
+	 * label is still safe and preserves admission on unsupported profiles.
+	 */
+	if (state->highwater == CS_WFO_LABEL_MAX)
+		return -ENOSPC;
+	candidate = ++state->highwater;
+allocated:
+	state->epoch++;
+	*label = candidate;
+	return 0;
+}
+#endif
