+#ifdef CONFIG_CS7542_FE_LIVE_OWNER
+struct cs_ne_retire_gate {
+	struct hrtimer timer;
+	struct cs_ne *ne;
+	u32 saved;
+	bool active;
+	int restore_error;
+};
+
+/* Gate state and its only register are serialized by the NI lock. */
+static void cs_ne_retire_restore(struct cs_ne_retire_gate *gate)
+{
+	lockdep_assert_held(&gate->ne->ni_lock);
+	ni_wr(gate->ne, NI_RX_AGG_CONFIG, gate->saved);
+	if (ni_rd(gate->ne, NI_RX_AGG_CONFIG) != gate->saved)
+		gate->restore_error = -EIO;
+	WRITE_ONCE(gate->active, false);
+}
+
+static enum hrtimer_restart cs_ne_retire_timeout(struct hrtimer *timer)
+{
+	struct cs_ne_retire_gate *gate = container_of(timer,
+		struct cs_ne_retire_gate, timer);
+	unsigned long flags;
+
+	spin_lock_irqsave(&gate->ne->ni_lock, flags);
+	if (gate->active)
+		cs_ne_retire_restore(gate);
+	spin_unlock_irqrestore(&gate->ne->ni_lock, flags);
+	return HRTIMER_NORESTART;
+}
+
+/*
+ * After a verified lookup cut, pause common NI admission while old FE work
+ * completes. IRQs/NAPI must remain runnable to return RX buffers. A hard timer
+ * restores admission if this sleeping task loses its deadline. This fixed
+ * profile check is not a general DMA shutdown or engine reset primitive.
+ */
+static int cs_ne_fe_retire_quiet(void *context, u64 end_us)
+{
+	struct cs_ne *ne = context;
+	struct cs_ne_retire_gate gate = { .ne = ne };
+	struct cs_fe_retire_sample sample;
+	u16 pools[8] = {};
+	unsigned long flags;
+	u64 began, deadline, stable = 0;
+	u32 previous = 0;
+	unsigned int i;
+	int error = -EAGAIN;
+	bool tx_empty;
+
+	if (!ne->hw_active || !ne->hw_accessible || ne->hw_cleanup_done)
+		return -EAGAIN;
+	/* Endpoint removal has fenced its producers and drained CPU readers.
+	 * Do not mistake an empty fabric for completion of an older frame still
+	 * waiting in the Linux TX DMA ring. Other live producers may resume after
+	 * this check; the retired endpoint cannot publish another descriptor.
+	 */
+	spin_lock_bh(&ne->txq.lock);
+	tx_empty = false;
+	if (!ne->txq.stopping && !ne->txq.poll_stopping && !ne->txq.fault) {
+		cs_ne_tx_complete(ne);
+		tx_empty = !ne->txq.fault && ne->txq.head == ne->txq.tail;
+	}
+	spin_unlock_bh(&ne->txq.lock);
+	if (!tx_empty)
+		return -EAGAIN;
+	for (i = 0; i < CS_NE_PORTS; i++)
+		if (ne->ports[i])
+			pools[i] = cs_ne_rx_pool_size[i];
+	hrtimer_setup_on_stack(&gate.timer, cs_ne_retire_timeout,
+			       CLOCK_MONOTONIC, HRTIMER_MODE_ABS_HARD);
