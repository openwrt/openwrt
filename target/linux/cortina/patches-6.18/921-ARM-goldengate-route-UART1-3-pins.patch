From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fil Dunsky <filipp.dunsky@gmail.com>
Date: Mon, 12 Oct 2026 19:20:00 +0300
Subject: [PATCH] ARM: goldengate: route the UART1-3 pins to the UARTs

The pins of UART1-3 come out of reset as GPIO 72-77, the boot loader
only sets up UART0. The vendor kernel clears bits 13:8 of the bank 2
GPIO mux register in its UART init. There is no pin controller driver
for the CS75xx yet, so do the same once at boot.

Signed-off-by: Fil Dunsky <filipp.dunsky@gmail.com>
---
--- a/arch/arm/mach-goldengate/Makefile
+++ b/arch/arm/mach-goldengate/Makefile
@@ -1,2 +1,3 @@
 # SPDX-License-Identifier: GPL-2.0-only
+obj-y			+= pinmux.o
 obj-$(CONFIG_SMP)	+= platsmp.o
--- /dev/null
+++ b/arch/arm/mach-goldengate/pinmux.c
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/bits.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/of.h>
+
+#define CS7542_GPIO_MUX_2	0xf0000024
+#define CS7542_GPIO_MUX_2_UART	GENMASK(13, 8)
+
+static int __init cs7542_uart_pinmux(void)
+{
+	void __iomem *mux;
+
+	if (!of_machine_is_compatible("cortina,cs7542"))
+		return 0;
+
+	mux = ioremap(CS7542_GPIO_MUX_2, 4);
+	if (!mux)
+		return -ENOMEM;
+
+	writel(readl(mux) & ~CS7542_GPIO_MUX_2_UART, mux);
+	iounmap(mux);
+
+	return 0;
+}
+arch_initcall(cs7542_uart_pinmux);
