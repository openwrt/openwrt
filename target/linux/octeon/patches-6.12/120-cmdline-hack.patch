From 1773aa5163cc3039ae29f3261d84f98c14836937 Mon Sep 17 00:00:00 2001
From: John Crispin <john@openwrt.org>
Date: Fri, 20 Mar 2015 08:49:08 +0000
Subject: [PATCH] MIPS: octeon: add image cmdline hack

Use a command line embedded into the kernel image (__image_cmdline) on
Octeon: if it starts with '-', it replaces the command line passed by
the bootloader, otherwise it is appended to it.
---
--- a/arch/mips/cavium-octeon/setup.c
+++ b/arch/mips/cavium-octeon/setup.c
@@ -653,6 +653,35 @@ void octeon_user_io_init(void)
 	write_c0_derraddr1(0);
 }
 
+#ifdef CONFIG_IMAGE_CMDLINE_HACK
+extern char __image_cmdline[];
+
+static int __init octeon_use_image_cmdline(void)
+{
+       char *p = __image_cmdline;
+       int replace = 0;
+
+       if (*p == '-') {
+               replace = 1;
+               p++;
+       }
+
+       if (*p == '\0')
+               return 0;
+
+       if (replace) {
+               strscpy(arcs_cmdline, p, sizeof(arcs_cmdline));
+       } else {
+               strlcat(arcs_cmdline, " ", sizeof(arcs_cmdline));
+               strlcat(arcs_cmdline, p, sizeof(arcs_cmdline));
+       }
+
+       return 1;
+}
+#else
+static inline int octeon_use_image_cmdline(void) { return 0; }
+#endif
+
 /**
  * prom_init - Early entry point for arch setup
  */
@@ -896,6 +925,8 @@ void __init prom_init(void)
 		}
 	}
 
+	octeon_use_image_cmdline();
+
 	if (strstr(arcs_cmdline, "console=") == NULL) {
 		if (octeon_uart == 1)
 			strcat(arcs_cmdline, " console=ttyS1,115200");
