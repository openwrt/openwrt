From c4b1d0e8a97f6e5d4c3b2a1908f7e6d5c4b3a291 Mon Sep 17 00:00:00 2001
From: Markus Krause <Krause.Markus@gmx.com>
Date: Sun, 11 Oct 2026 22:00:00 +0200
Subject: kernel: octeon: forward learned bridge frames on CN50xx

The flow shortcut rewrites a routed hop. Two hosts on the same bridge
are not one of those flows, and the firewall flowtable never installs
that traffic. On the CN50xx it was forwarded by the Linux bridge.

This path keeps its own MAC table, filled from the bridge switchdev
notifications, and its own sysfs switch, bridge_shortcut. The switch
boots off. Binding the hardware flowtable turns it on, and the last
unbind turns it off. That binding is the Hardware flow offloading
checkbox, the same control that enables the routed shortcut. A hit
transmits the buffer the chip already holds. Addresses, checksums, and
the TTL stay as they arrived. A miss continues into the bridge, and
then to the flow shortcut.

Eligible frames are unicast and headed for another forwarding Octeon
port of the same bridge. The MAC table holds 1024 addresses. A further
host stays on the Linux bridge.

A VLAN tag is left in the frame. With filtering off, the tag rides
along in the bridge's one broadcast domain. With filtering on, a
frame is forwarded when both ports are in that VLAN and the tag would
still be there on the way out, or when the frame is untagged on both
ports. Adding or removing a tag stays on the Linux bridge. An inner
tag stays in the frame with the outer one.

Broadcast, multicast, ARP, neighbor discovery, bridge netfilter, an
isolated pair, and a shaping qdisc stay on the Linux bridge. The
word2 bits are the CN50xx layout. The same model check as the flow
shortcut refuses every other chip, so EdgeRouter 4 and 6P keep the
Linux bridge. The receive path checks the model too, so setting the
sysfs switch by hand on those boards does nothing.

While the shortcut is hiding frames, the bridge would age the address
out. A work item marks an address the shortcut is using as externally
learned, and removes that mark after the address goes idle.

Signed-off-by: Markus Krause <Krause.Markus@gmx.com>
---
 drivers/staging/octeon/Makefile          |    1 +
 drivers/staging/octeon/ethernet-bridge.c |  722 +++++++++++++++++++++++++++++++
 drivers/staging/octeon/ethernet-bridge.h |   24 +
 drivers/staging/octeon/ethernet-flow.c   |    3 +
 drivers/staging/octeon/ethernet-rx.c     |   11 +-
 drivers/staging/octeon/ethernet.c        |    5 +
 6 files changed, 763 insertions(+), 3 deletions(-)

--- a/drivers/staging/octeon/Makefile
+++ b/drivers/staging/octeon/Makefile
@@ -18,3 +18,4 @@ octeon-ethernet-y += ethernet-sgmii.o
 octeon-ethernet-y += ethernet-spi.o
 octeon-ethernet-y += ethernet-tx.o
 octeon-ethernet-y += ethernet-flow.o
+octeon-ethernet-y += ethernet-bridge.o
--- /dev/null
+++ b/drivers/staging/octeon/ethernet-bridge.c
@@ -0,0 +1,722 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Port-to-port shortcut for a Linux bridge on the CN50xx.
+ *
+ * The firewall flow shortcut rewrites a routed hop. A frame between two
+ * hosts on br-lan is not one of those flows: the bridge forwards it, and
+ * the TTL stays. This file keeps its own MAC table and, on a hit, hands
+ * the buffer the chip already holds to the normal PKO transmit.
+ *
+ * The bridge publishes each learned address through the switchdev
+ * notifier. The receive path does not call into the bridge FDB, because
+ * that lookup wants a lock this loop cannot take. While the shortcut is
+ * hiding frames, the bridge would otherwise age the address out. A work
+ * item marks an active address externally learned, and drops it again
+ * after it goes idle.
+ *
+ * The model check is the same CN50xx test as the flow shortcut. Boards
+ * that share this driver and use a different receive-word layout stay on
+ * the Linux bridge.
+ *
+ * The switch boots off. Binding the hardware flowtable turns it on, and
+ * the last unbind turns it off. That binding is the Hardware flow
+ * offloading checkbox. Sysfs overrides the switch until the next bind.
+ *
+ * The table holds 1024 addresses. A VLAN tag is not rewritten. With
+ * filtering off, the tag rides along in the one broadcast domain. With
+ * filtering on, a frame is forwarded only when both ports belong to
+ * that VLAN and the tag would still be there on the way out, or when
+ * neither port has a tag. An inner tag stays in the frame.
+ */
+
+#include <linux/etherdevice.h>
+#include <linux/if_bridge.h>
+#include <linux/if_ether.h>
+#include <linux/if_vlan.h>
+#include <linux/ipv6.h>
+#include <linux/jhash.h>
+#include <linux/module.h>
+#include <linux/rtnetlink.h>
+#include <linux/workqueue.h>
+
+#include <net/sch_generic.h>
+#include <net/switchdev.h>
+
+#include "ethernet-bridge.h"
+#include "ethernet-defines.h"
+#include "ethernet-tx.h"
+#include "octeon-ethernet.h"
+
+int cvm_oct_bridge_shortcut;
+static unsigned int bridge_shortcut_hit;
+static unsigned int bridge_shortcut_miss;
+static unsigned int bridge_shortcut_entries;
+
+static struct delayed_work cvm_br_dwork;
+static bool cvm_br_alive;
+
+static int cvm_br_param_set(const char *val, const struct kernel_param *kp)
+{
+	int ret;
+
+	ret = param_set_int(val, kp);
+	if (ret)
+		return ret;
+	/* Command-line parsing runs before the work item exists. */
+	if (READ_ONCE(cvm_br_alive))
+		mod_delayed_work(system_wq, &cvm_br_dwork, 0);
+	return 0;
+}
+
+static const struct kernel_param_ops cvm_br_param_ops = {
+	.set = cvm_br_param_set,
+	.get = param_get_int,
+};
+module_param_cb(bridge_shortcut, &cvm_br_param_ops,
+		&cvm_oct_bridge_shortcut, 0644);
+MODULE_PARM_DESC(bridge_shortcut,
+		 "Forward learned unicast between CN50xx bridge ports");
+module_param(bridge_shortcut_hit, uint, 0444);
+module_param(bridge_shortcut_miss, uint, 0444);
+module_param(bridge_shortcut_entries, uint, 0444);
+
+static bool cvm_br_chip_ok(void)
+{
+	static int ok = -1;
+
+	if (READ_ONCE(ok) < 0)
+		WRITE_ONCE(ok, OCTEON_IS_MODEL(OCTEON_CN50XX) &&
+				   !octeon_has_feature(OCTEON_FEATURE_PKND));
+	return READ_ONCE(ok);
+}
+
+/* Hardware flow offload binds one flowtable for the whole box. Follow
+ * that bind so the firewall checkbox is the switch users already have.
+ */
+void cvm_oct_bridge_set(int on)
+{
+	on = on ? 1 : 0;
+	if (!cvm_br_chip_ok())
+		return;
+	if (READ_ONCE(cvm_oct_bridge_shortcut) == on)
+		return;
+	WRITE_ONCE(cvm_oct_bridge_shortcut, on);
+	if (READ_ONCE(cvm_br_alive))
+		mod_delayed_work(system_wq, &cvm_br_dwork, 0);
+}
+
+#define CVM_BR_BUCKETS	256
+#define CVM_BR_MAX	1024
+#define CVM_BR_IDLE	(30 * HZ)
+#define CVM_BR_BATCH	8
+
+struct cvm_br_ent {
+	struct hlist_node	node;
+	struct rcu_head		rcu;
+	u8			addr[ETH_ALEN];
+	u16			vid;
+	struct net_device	*dev;
+	unsigned long		last_hit;
+	bool			local;
+	bool			sticky;
+	bool			seen;
+	bool			promoted;
+};
+
+static struct hlist_head cvm_br_buckets[CVM_BR_BUCKETS];
+static u8 cvm_br_stp[TOTAL_NUMBER_OF_PORTS];
+static DEFINE_SPINLOCK(cvm_br_lock);
+static unsigned int cvm_br_count;
+
+static u32 cvm_br_slot(const u8 *addr, u16 vid)
+{
+	return jhash(addr, ETH_ALEN, vid) & (CVM_BR_BUCKETS - 1);
+}
+
+static void cvm_br_free(struct rcu_head *rcu)
+{
+	struct cvm_br_ent *e = container_of(rcu, struct cvm_br_ent, rcu);
+
+	if (e->dev)
+		dev_put(e->dev);
+	kfree(e);
+}
+
+/* Caller holds cvm_br_lock. */
+static struct cvm_br_ent *cvm_br_find_locked(const u8 *addr, u16 vid)
+{
+	struct cvm_br_ent *e;
+
+	hlist_for_each_entry(e, &cvm_br_buckets[cvm_br_slot(addr, vid)], node) {
+		if (e->vid == vid && ether_addr_equal(e->addr, addr))
+			return e;
+	}
+	return NULL;
+}
+
+static struct cvm_br_ent *cvm_br_lookup(const u8 *addr, u16 vid)
+{
+	struct cvm_br_ent *e;
+
+	hlist_for_each_entry_rcu(e, &cvm_br_buckets[cvm_br_slot(addr, vid)],
+				 node) {
+		if (e->vid == vid && ether_addr_equal(e->addr, addr))
+			return e;
+	}
+	return NULL;
+}
+
+/* Caller holds cvm_br_lock. */
+static void cvm_br_unlink(struct cvm_br_ent *e)
+{
+	hlist_del_rcu(&e->node);
+	if (cvm_br_count)
+		cvm_br_count--;
+	bridge_shortcut_entries = cvm_br_count;
+	call_rcu(&e->rcu, cvm_br_free);
+}
+
+static bool cvm_br_octeon(const struct net_device *dev)
+{
+	return dev->netdev_ops &&
+	       dev->netdev_ops->ndo_start_xmit == cvm_oct_xmit;
+}
+
+static void cvm_br_learn(const u8 *addr, struct net_device *dev,
+			 bool local, bool sticky, u16 vid)
+{
+	struct cvm_br_ent *e;
+
+	if (!cvm_br_chip_ok())
+		return;
+	spin_lock_bh(&cvm_br_lock);
+	e = cvm_br_find_locked(addr, vid);
+	if (e && e->local == local && e->sticky == sticky && e->dev == dev) {
+		spin_unlock_bh(&cvm_br_lock);
+		return;
+	}
+	if (e)
+		cvm_br_unlink(e);
+	if (cvm_br_count >= CVM_BR_MAX) {
+		spin_unlock_bh(&cvm_br_lock);
+		return;
+	}
+	e = kmalloc(sizeof(*e), GFP_ATOMIC);
+	if (!e) {
+		spin_unlock_bh(&cvm_br_lock);
+		return;
+	}
+	ether_addr_copy(e->addr, addr);
+	e->vid = vid;
+	e->dev = dev;
+	e->local = local;
+	e->sticky = sticky;
+	e->seen = false;
+	e->promoted = false;
+	e->last_hit = 0;
+	if (dev)
+		dev_hold(dev);
+	hlist_add_head_rcu(&e->node, &cvm_br_buckets[cvm_br_slot(addr, vid)]);
+	cvm_br_count++;
+	bridge_shortcut_entries = cvm_br_count;
+	spin_unlock_bh(&cvm_br_lock);
+}
+
+static void cvm_br_forget(const u8 *addr, u16 vid)
+{
+	struct cvm_br_ent *e;
+
+	spin_lock_bh(&cvm_br_lock);
+	e = cvm_br_find_locked(addr, vid);
+	if (e)
+		cvm_br_unlink(e);
+	spin_unlock_bh(&cvm_br_lock);
+}
+
+static int cvm_br_fdb_event(struct notifier_block *nb, unsigned long event,
+			    void *ptr)
+{
+	struct switchdev_notifier_fdb_info *fdb = ptr;
+	struct net_device *dev;
+
+	if (!cvm_br_chip_ok())
+		return NOTIFY_DONE;
+	if (is_multicast_ether_addr(fdb->addr))
+		return NOTIFY_DONE;
+
+	dev = switchdev_notifier_info_to_dev(&fdb->info);
+	switch (event) {
+	case SWITCHDEV_FDB_ADD_TO_DEVICE:
+		if (fdb->is_local)
+			cvm_br_learn(fdb->addr, NULL, true, false, fdb->vid);
+		else if (dev && cvm_br_octeon(dev))
+			cvm_br_learn(fdb->addr, dev, false, fdb->added_by_user,
+				     fdb->vid);
+		else
+			cvm_br_forget(fdb->addr, fdb->vid);
+		break;
+	case SWITCHDEV_FDB_DEL_TO_DEVICE:
+		cvm_br_forget(fdb->addr, fdb->vid);
+		break;
+	default:
+		break;
+	}
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block cvm_br_nb = {
+	.notifier_call = cvm_br_fdb_event,
+};
+
+static int cvm_br_port_index(const struct net_device *dev)
+{
+	int i;
+
+	for (i = 0; i < TOTAL_NUMBER_OF_PORTS; i++) {
+		if (cvm_oct_device[i] == dev)
+			return i;
+	}
+	return -1;
+}
+
+static void cvm_br_refresh_stp(void)
+{
+	int i;
+
+	rtnl_lock();
+	for (i = 0; i < TOTAL_NUMBER_OF_PORTS; i++) {
+		struct net_device *dev = cvm_oct_device[i];
+
+		if (!dev || !netif_is_bridge_port(dev))
+			WRITE_ONCE(cvm_br_stp[i], BR_STATE_DISABLED);
+		else
+			WRITE_ONCE(cvm_br_stp[i], br_port_get_stp_state(dev));
+	}
+	rtnl_unlock();
+}
+
+struct cvm_br_act {
+	u8			addr[ETH_ALEN];
+	u16			vid;
+	struct net_device	*dev;
+	bool			del;
+};
+
+static void cvm_br_tell_bridge(struct cvm_br_act *act)
+{
+	struct switchdev_notifier_fdb_info info = {
+		.addr = act->addr,
+		.vid = act->vid,
+		.offloaded = true,
+	};
+	struct cvm_br_ent *e;
+	int rc;
+
+	rcu_read_lock();
+	if (!netif_is_bridge_port(act->dev)) {
+		rcu_read_unlock();
+		spin_lock_bh(&cvm_br_lock);
+		e = cvm_br_find_locked(act->addr, act->vid);
+		if (e && e->dev == act->dev)
+			cvm_br_unlink(e);
+		spin_unlock_bh(&cvm_br_lock);
+		dev_put(act->dev);
+		return;
+	}
+	if (act->del)
+		rc = call_switchdev_notifiers(SWITCHDEV_FDB_DEL_TO_BRIDGE,
+					      act->dev, &info.info, NULL);
+	else
+		rc = call_switchdev_notifiers(SWITCHDEV_FDB_ADD_TO_BRIDGE,
+					      act->dev, &info.info, NULL);
+	rcu_read_unlock();
+
+	spin_lock_bh(&cvm_br_lock);
+	e = cvm_br_find_locked(act->addr, act->vid);
+	if (e && e->dev == act->dev && !notifier_to_errno(rc)) {
+		if (act->del) {
+			if (time_after(READ_ONCE(e->last_hit),
+				       jiffies - CVM_BR_IDLE) &&
+			    READ_ONCE(cvm_oct_bridge_shortcut))
+				e->promoted = true;
+			else
+				cvm_br_unlink(e);
+		} else {
+			e->promoted = true;
+		}
+	}
+	spin_unlock_bh(&cvm_br_lock);
+	dev_put(act->dev);
+}
+
+static void cvm_br_work_fn(struct work_struct *work)
+{
+	struct cvm_br_act act[CVM_BR_BATCH];
+	bool on, more = false, keep = false;
+	int n = 0;
+	int i;
+
+	(void)work;
+
+	if (!READ_ONCE(cvm_br_alive))
+		return;
+
+	on = READ_ONCE(cvm_oct_bridge_shortcut);
+	if (on || cvm_br_count)
+		cvm_br_refresh_stp();
+
+	spin_lock_bh(&cvm_br_lock);
+	for (i = 0; i < CVM_BR_BUCKETS && n < CVM_BR_BATCH; i++) {
+		struct cvm_br_ent *e;
+
+		hlist_for_each_entry(e, &cvm_br_buckets[i], node) {
+			bool idle, hit;
+
+			if (e->local || !e->dev)
+				continue;
+			hit = READ_ONCE(e->seen);
+			idle = hit && time_after(jiffies,
+						 READ_ONCE(e->last_hit) + CVM_BR_IDLE);
+			if (!on && e->promoted)
+				act[n].del = true;
+			else if (on && !e->promoted && !e->sticky && hit)
+				act[n].del = false;
+			else if (on && e->promoted && idle)
+				act[n].del = true;
+			else
+				continue;
+			ether_addr_copy(act[n].addr, e->addr);
+			act[n].vid = e->vid;
+			act[n].dev = e->dev;
+			dev_hold(act[n].dev);
+			n++;
+			if (n == CVM_BR_BATCH) {
+				more = true;
+				break;
+			}
+		}
+	}
+	for (i = 0; !keep && i < CVM_BR_BUCKETS; i++) {
+		struct cvm_br_ent *e;
+
+		hlist_for_each_entry(e, &cvm_br_buckets[i], node) {
+			if (e->promoted) {
+				keep = true;
+				break;
+			}
+		}
+	}
+	spin_unlock_bh(&cvm_br_lock);
+
+	for (i = 0; i < n; i++)
+		cvm_br_tell_bridge(&act[i]);
+
+	if (!READ_ONCE(cvm_br_alive))
+		return;
+	if (on || more || keep)
+		schedule_delayed_work(&cvm_br_dwork, more ? HZ / 5 : HZ);
+}
+
+static bool cvm_br_shaped(const struct net_device *dev)
+{
+	const struct Qdisc *q = rcu_dereference(dev->qdisc);
+	const char *id;
+
+	if (!q || !q->ops)
+		return false;
+	id = q->ops->id;
+	if (!id[0])
+		return false;
+	if (!strcmp(id, "fq_codel") || !strcmp(id, "mq") ||
+	    !strcmp(id, "noqueue") || !strcmp(id, "pfifo") ||
+	    !strcmp(id, "pfifo_fast") || !strcmp(id, "mqprio"))
+		return false;
+	return true;
+}
+
+struct cvm_br_dom {
+	u16 vid;
+	bool filtering;
+	bool tagged;
+};
+
+/* ARP and neighbor discovery still have to reach the bridge. A VLAN
+ * tag stays in the frame; this only looks past it.
+ */
+static bool cvm_br_control_frame(const struct ethhdr *eth, unsigned int len)
+{
+	const u8 *p = (const u8 *)(eth + 1);
+	unsigned int left = len - ETH_HLEN;
+	__be16 proto = eth->h_proto;
+	int tags = 0;
+
+	while ((proto == htons(ETH_P_8021Q) || proto == htons(ETH_P_8021AD)) &&
+	       tags < 2) {
+		const struct vlan_hdr *vh;
+
+		if (left < VLAN_HLEN)
+			return true;
+		vh = (const struct vlan_hdr *)p;
+		proto = vh->h_vlan_encapsulated_proto;
+		p += VLAN_HLEN;
+		left -= VLAN_HLEN;
+		tags++;
+	}
+	if (proto == htons(ETH_P_ARP))
+		return true;
+	if (proto == htons(ETH_P_IPV6)) {
+		const struct ipv6hdr *ip6;
+
+		if (left < sizeof(*ip6))
+			return true;
+		ip6 = (const struct ipv6hdr *)p;
+		if (ip6->nexthdr == IPPROTO_ICMPV6)
+			return true;
+	}
+	return false;
+}
+
+/* vid is the bridge FDB key. tagged means the frame on the wire
+ * already carries that VLAN and must leave with it.
+ */
+static bool cvm_br_domain(const struct net_device *br,
+			  const struct net_device *in,
+			  const struct ethhdr *eth, unsigned int len,
+			  struct cvm_br_dom *dom)
+{
+	const struct vlan_hdr *vh;
+	u16 proto, pvid;
+
+	dom->vid = 0;
+	dom->filtering = br_vlan_enabled(br);
+	dom->tagged = false;
+	if (!dom->filtering)
+		return true;
+	if (br_vlan_get_proto(br, &proto))
+		return false;
+	if (eth->h_proto != htons(proto)) {
+		if (br_vlan_get_pvid_rcu(in, &pvid) || !pvid)
+			return false;
+		dom->vid = pvid;
+		return true;
+	}
+	if (len < ETH_HLEN + VLAN_HLEN)
+		return false;
+	vh = (const struct vlan_hdr *)(eth + 1);
+	dom->vid = ntohs(vh->h_vlan_TCI) & VLAN_VID_MASK;
+	if (!dom->vid)
+		return false;
+	dom->tagged = true;
+	return true;
+}
+
+/* True when forwarding the buffer unchanged matches the bridge.
+ * Filtering off has one broadcast domain, so the tag rides along.
+ * Filtering on keeps a frame whose tag stays, and an untagged frame
+ * whose ports are both untagged in that VLAN. Adding or removing a
+ * tag stays on the Linux bridge.
+ */
+static bool cvm_br_same_wire(const struct net_device *in,
+			     const struct net_device *out,
+			     const struct cvm_br_dom *dom)
+{
+	struct bridge_vlan_info vin, vout;
+
+	if (!dom->filtering)
+		return true;
+	if (br_vlan_get_info_rcu(in, dom->vid, &vin) ||
+	    br_vlan_get_info_rcu(out, dom->vid, &vout))
+		return false;
+	if (dom->tagged)
+		return !(vout.flags & BRIDGE_VLAN_INFO_UNTAGGED);
+	return vout.flags & BRIDGE_VLAN_INFO_UNTAGGED;
+}
+
+bool cvm_oct_bridge_receive(struct net_device *dev, struct sk_buff *skb,
+			    const struct cvmx_wqe *work)
+{
+	struct net_device *br, *txdev, *obr;
+	struct cvm_br_ent *dst, *src;
+	struct cvm_br_dom dom;
+	struct ethhdr *eth;
+	int iport, oport;
+
+	if (!cvm_br_chip_ok())
+		return false;
+	/* Broadcast and multicast stay on the Linux bridge. */
+	if (unlikely(work->word2.snoip.rcv_error ||
+		     work->word2.snoip.is_mcast ||
+		     work->word2.snoip.is_bcast))
+		return false;
+	if (unlikely(skb->len < ETH_HLEN))
+		return false;
+
+	eth = (struct ethhdr *)skb->data;
+	if ((eth->h_dest[0] | eth->h_source[0]) & 1)
+		return false;
+	if (cvm_br_control_frame(eth, skb->len))
+		return false;
+
+	rcu_read_lock();
+	br = netdev_master_upper_dev_get_rcu(dev);
+	if (!br || !netif_is_bridge_master(br))
+		goto out;
+	if (!cvm_br_domain(br, dev, eth, skb->len, &dom))
+		goto out;
+	/*
+	 * Bridge netfilter would filter this frame in the Linux bridge.
+	 * The shortcut runs before that hook, so it stays dark while the
+	 * module is loaded.
+	 */
+	if (rcu_access_pointer(nf_br_ops))
+		goto out;
+
+	iport = cvm_br_port_index(dev);
+	if (iport < 0 ||
+	    READ_ONCE(cvm_br_stp[iport]) != BR_STATE_FORWARDING)
+		goto out;
+
+	dst = cvm_br_lookup(eth->h_dest, dom.vid);
+	if (!dst || dst->local || !dst->dev) {
+		if (!dst)
+			bridge_shortcut_miss++;
+		goto out;
+	}
+	/*
+	 * Both addresses have to be known, and the source has to be on
+	 * this port. An unknown source is one packet for the bridge, so
+	 * it can learn the new host before later frames skip it.
+	 */
+	src = cvm_br_lookup(eth->h_source, dom.vid);
+	if (!src || src->local || src->dev != dev) {
+		bridge_shortcut_miss++;
+		goto out;
+	}
+
+	txdev = dst->dev;
+	if (txdev == dev || !cvm_br_octeon(txdev)) {
+		bridge_shortcut_miss++;
+		goto out;
+	}
+	obr = netdev_master_upper_dev_get_rcu(txdev);
+	if (obr != br) {
+		bridge_shortcut_miss++;
+		goto out;
+	}
+	oport = cvm_br_port_index(txdev);
+	if (oport < 0 ||
+	    READ_ONCE(cvm_br_stp[oport]) != BR_STATE_FORWARDING) {
+		bridge_shortcut_miss++;
+		goto out;
+	}
+	if (!(txdev->flags & IFF_UP) || !netif_carrier_ok(txdev) ||
+	    netif_xmit_stopped(netdev_get_tx_queue(txdev, 0))) {
+		bridge_shortcut_miss++;
+		goto out;
+	}
+	if (br_port_flag_is_set(dev, BR_ISOLATED) &&
+	    br_port_flag_is_set(txdev, BR_ISOLATED)) {
+		bridge_shortcut_miss++;
+		goto out;
+	}
+	if (!cvm_br_same_wire(dev, txdev, &dom) || cvm_br_shaped(txdev)) {
+		bridge_shortcut_miss++;
+		goto out;
+	}
+
+	WRITE_ONCE(dst->seen, true);
+	WRITE_ONCE(dst->last_hit, jiffies);
+	dev_hold(txdev);
+	rcu_read_unlock();
+
+	/*
+	 * protocol stays clear so the PKO checksum offload does not run.
+	 * The frame is unchanged, including the TTL.
+	 */
+	skb->protocol = 0;
+	skb->dev = txdev;
+	cvm_oct_xmit(skb, txdev);
+	dev_put(txdev);
+	bridge_shortcut_hit++;
+	return true;
+out:
+	rcu_read_unlock();
+	return false;
+}
+
+static void cvm_br_drop_promoted(void)
+{
+	int guard = 0;
+
+	while (guard++ < CVM_BR_MAX) {
+		struct cvm_br_act act;
+		struct cvm_br_ent *e;
+		bool found = false;
+		int i;
+
+		spin_lock_bh(&cvm_br_lock);
+		for (i = 0; i < CVM_BR_BUCKETS && !found; i++) {
+			hlist_for_each_entry(e, &cvm_br_buckets[i], node) {
+				if (!e->promoted || !e->dev)
+					continue;
+				ether_addr_copy(act.addr, e->addr);
+				act.vid = e->vid;
+				act.dev = e->dev;
+				act.del = true;
+				dev_hold(act.dev);
+				found = true;
+				break;
+			}
+		}
+		spin_unlock_bh(&cvm_br_lock);
+		if (!found)
+			return;
+		cvm_br_tell_bridge(&act);
+	}
+}
+
+static void cvm_br_flush(void)
+{
+	int i;
+
+	spin_lock_bh(&cvm_br_lock);
+	for (i = 0; i < CVM_BR_BUCKETS; i++) {
+		struct cvm_br_ent *e;
+		struct hlist_node *tmp;
+
+		hlist_for_each_entry_safe(e, tmp, &cvm_br_buckets[i], node)
+			cvm_br_unlink(e);
+	}
+	spin_unlock_bh(&cvm_br_lock);
+}
+
+int cvm_oct_bridge_init(void)
+{
+	int i, ret;
+
+	if (!cvm_br_chip_ok())
+		return 0;
+	for (i = 0; i < CVM_BR_BUCKETS; i++)
+		INIT_HLIST_HEAD(&cvm_br_buckets[i]);
+	INIT_DELAYED_WORK(&cvm_br_dwork, cvm_br_work_fn);
+	ret = register_switchdev_notifier(&cvm_br_nb);
+	if (ret)
+		return ret;
+	WRITE_ONCE(cvm_br_alive, true);
+	schedule_delayed_work(&cvm_br_dwork, HZ);
+	return 0;
+}
+
+void cvm_oct_bridge_exit(void)
+{
+	if (!READ_ONCE(cvm_br_alive))
+		return;
+	WRITE_ONCE(cvm_br_alive, false);
+	WRITE_ONCE(cvm_oct_bridge_shortcut, 0);
+	cancel_delayed_work_sync(&cvm_br_dwork);
+	cancel_delayed_work_sync(&cvm_br_dwork);
+	cvm_br_drop_promoted();
+	unregister_switchdev_notifier(&cvm_br_nb);
+	cvm_br_flush();
+	rcu_barrier();
+}
