+/* The cable is on the PHY of the SFP module, if there is one. Called with
+ * the lock of @phydev held. With @finished the status is asked for, without
+ * the test is started.
+ */
+static int phy_cable_test_op(struct phy_device *phydev, bool *finished)
+{
+	const struct phy_driver *drv = phydev->drv;
+	struct phy_device *phy;
+	int err = -EOPNOTSUPP;
+
+	mutex_lock(&phydev->sfp_phy_lock);
+	phy = phydev->sfp_phy;
+	if (!phy) {
+		if (drv->cable_test_start && drv->cable_test_get_status)
+			err = finished ?
+			      drv->cable_test_get_status(phydev, finished) :
+			      drv->cable_test_start(phydev);
+		goto out;
+	}
+
+	drv = phy->drv;
+	if (!drv || !drv->cable_test_start || !drv->cable_test_get_status)
+		goto out;
+
+	mutex_lock_nested(&phy->lock, SINGLE_DEPTH_NESTING);
+	if (finished) {
+		/* the results go into the message of the PHY the test was
+		 * started on
+		 */
+		phy->skb = phydev->skb;
+		phy->ehdr = phydev->ehdr;
+		phy->nest = phydev->nest;
+		err = drv->cable_test_get_status(phy, finished);
+		phy->skb = NULL;
+		phy->ehdr = NULL;
+		phy->nest = NULL;
+	} else {
+		err = drv->cable_test_start(phy);
+	}
+	mutex_unlock(&phy->lock);
+out:
+	mutex_unlock(&phydev->sfp_phy_lock);
+
+	return err;
+}
