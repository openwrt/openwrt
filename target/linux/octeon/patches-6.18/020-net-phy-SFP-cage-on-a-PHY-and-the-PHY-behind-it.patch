+/* The statistics of a PHY are followed by those of the PHY of an SFP module
+ * behind it, named with "sfp_" in front.
+ */
+static bool phy_has_stats(struct phy_device *phydev)
+{
+	return phydev->drv && phydev->drv->get_sset_count &&
+	       phydev->drv->get_strings && phydev->drv->get_stats;
+}
+
+static int phy_own_stats_count(struct phy_device *phydev)
+{
+	int ret;
+
+	if (!phy_has_stats(phydev))
+		return 0;
+
+	mutex_lock(&phydev->lock);
+	ret = phydev->drv->get_sset_count(phydev);
+	mutex_unlock(&phydev->lock);
+
+	return max(ret, 0);
+}
+
+/* sfp_phy_lock of the upstream PHY must be held */
+static int phy_sfp_phy_stats_count(struct phy_device *phydev)
+{
+	struct phy_device *phy = phydev->sfp_phy;
+	int ret;
+
+	if (!phy || !phy_has_stats(phy))
+		return 0;
+
+	mutex_lock_nested(&phy->lock, SINGLE_DEPTH_NESTING);
+	ret = phy->drv->get_sset_count(phy);
+	mutex_unlock(&phy->lock);
+
+	return max(ret, 0);
+}
+
 /**
  * phy_ethtool_get_strings - Get the statistic counter names
  *
@@ -542,12 +581,35 @@ static void phy_abort_cable_test(struct
  */
 int phy_ethtool_get_strings(struct phy_device *phydev, u8 *data)
 {
+	int count, i;
+
 	if (!phydev->drv)
 		return -EIO;
 
-	mutex_lock(&phydev->lock);
-	phydev->drv->get_strings(phydev, data);
-	mutex_unlock(&phydev->lock);
+	count = phy_own_stats_count(phydev);
+	if (count) {
+		mutex_lock(&phydev->lock);
+		phydev->drv->get_strings(phydev, data);
+		mutex_unlock(&phydev->lock);
+		data += count * ETH_GSTRING_LEN;
+	}
+
+	mutex_lock(&phydev->sfp_phy_lock);
+	count = phy_sfp_phy_stats_count(phydev);
+	if (count) {
+		struct phy_device *phy = phydev->sfp_phy;
+
+		mutex_lock_nested(&phy->lock, SINGLE_DEPTH_NESTING);
+		phy->drv->get_strings(phy, data);
+		mutex_unlock(&phy->lock);
+
+		for (i = 0; i < count; i++, data += ETH_GSTRING_LEN) {
+			memmove(data + 4, data, ETH_GSTRING_LEN - 5);
+			memcpy(data, "sfp_", 4);
+			data[ETH_GSTRING_LEN - 1] = 0;
+		}
+	}
+	mutex_unlock(&phydev->sfp_phy_lock);
 
 	return 0;
 }
@@ -560,22 +622,21 @@ EXPORT_SYMBOL(phy_ethtool_get_strings);
  */
 int phy_ethtool_get_sset_count(struct phy_device *phydev)
 {
-	int ret;
+	int count;
 
 	if (!phydev->drv)
 		return -EIO;
 
-	if (phydev->drv->get_sset_count &&
-	    phydev->drv->get_strings &&
-	    phydev->drv->get_stats) {
-		mutex_lock(&phydev->lock);
-		ret = phydev->drv->get_sset_count(phydev);
-		mutex_unlock(&phydev->lock);
+	count = phy_own_stats_count(phydev);
 
-		return ret;
-	}
+	mutex_lock(&phydev->sfp_phy_lock);
+	count += phy_sfp_phy_stats_count(phydev);
+	mutex_unlock(&phydev->sfp_phy_lock);
 
-	return -EOPNOTSUPP;
+	if (!count && !phy_has_stats(phydev))
+		return -EOPNOTSUPP;
+
+	return count;
 }
 EXPORT_SYMBOL(phy_ethtool_get_sset_count);
 
@@ -589,12 +650,28 @@ EXPORT_SYMBOL(phy_ethtool_get_sset_count
