+/**
+ * phy_sfp_phy_read_status - take the copper side status from the SFP module
+ * @phydev: the upstream PHY, with its lock held and its own status read
+ *
+ * Link, speed and duplex stay what @phydev found out about its link to the
+ * module. What only the PHY in the module can know is copied from it: the
+ * abilities of the link partner, pause, MDI-X, master/slave.
+ */
+void phy_sfp_phy_read_status(struct phy_device *phydev)
+{
+	struct phy_device *phy;
+
+	mutex_lock(&phydev->sfp_phy_lock);
+	phy = phydev->sfp_phy;
+	if (!phy)
+		goto out;
+
+	mutex_lock_nested(&phy->lock, SINGLE_DEPTH_NESTING);
+	if (phydev->link && !phy_read_status(phy)) {
+		linkmode_copy(phydev->lp_advertising, phy->lp_advertising);
+		phydev->pause = phy->pause;
+		phydev->asym_pause = phy->asym_pause;
+		phydev->mdix = phy->mdix;
+		phydev->master_slave_get = phy->master_slave_get;
+		phydev->master_slave_state = phy->master_slave_state;
+	} else {
+		linkmode_zero(phydev->lp_advertising);
+		phydev->mdix = ETH_TP_MDI_INVALID;
+	}
+	mutex_unlock(&phy->lock);
+out:
+	mutex_unlock(&phydev->sfp_phy_lock);
+}
+EXPORT_SYMBOL_GPL(phy_sfp_phy_read_status);
