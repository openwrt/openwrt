+static bool phy_cable_test_supported(struct phy_device *phydev)
+{
+	const struct phy_driver *drv = phydev->drv;
+	bool ret;
+
+	if (!drv)
+		return false;
+
+	mutex_lock(&phydev->sfp_phy_lock);
+	if (phydev->sfp_phy)
+		drv = phydev->sfp_phy->drv;
+	ret = drv && drv->cable_test_start && drv->cable_test_get_status;
+	mutex_unlock(&phydev->sfp_phy_lock);
+
+	return ret;
+}
