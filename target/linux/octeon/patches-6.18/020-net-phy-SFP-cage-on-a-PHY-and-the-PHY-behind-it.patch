+/* Have the driver of the SFP module's PHY set it up for the interface the
+ * module is used with. The module PHY is not attached to a network device and
+ * its state machine does not run: the upstream PHY knows the state of the
+ * link to the module, phy_config_aneg() and phy_read_status() of the upstream
+ * PHY pass the settings on and fetch the rest of the status.
+ */
+static int phy_sfp_phy_setup(struct phy_device *phydev, struct phy_device *phy)
+{
+	const struct sfp_module_caps *caps;
+	phy_interface_t iface;
+	int ret;
+
+	caps = sfp_get_module_caps(phydev->sfp_bus);
+	iface = sfp_select_interface(phydev->sfp_bus, caps->link_modes);
+	if (iface == PHY_INTERFACE_MODE_NA)
+		return -EINVAL;
+
+	phy->interface = iface;
+	ret = phy_init_hw(phy);
+	if (ret)
+		return ret;
+
+	/* The abilities read at probe time were those of the mode the module
+	 * powered up in, often 1000BASE-X to the host and 1000BASE-T only.
+	 */
+	mutex_lock(&phy->lock);
+	if (phy->drv->get_features)
+		ret = phy->drv->get_features(phy);
+	else if (!phy->is_c45)
+		ret = genphy_read_abilities(phy);
+	mutex_unlock(&phy->lock);
+
+	return ret;
+}
