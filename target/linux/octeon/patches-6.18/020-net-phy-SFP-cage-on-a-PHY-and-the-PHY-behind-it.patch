 /**
+ * phy_sfp_phy_apply_settings - pass the link settings on to the SFP module
+ * @phydev: the upstream PHY, with its sfp_phy_lock held
+ *
+ * The PHY of an SFP module behind @phydev has the copper side of the link:
+ * advertisement, forced speed and duplex, MDI-X and master/slave are its to
+ * apply. @phydev configures its own side, the link to the module.
+ */
+void phy_sfp_phy_apply_settings(struct phy_device *phydev)
+{
+	struct phy_device *phy = phydev->sfp_phy;
+	int ret;
+
+	if (!phy)
+		return;
+
+	mutex_lock_nested(&phy->lock, SINGLE_DEPTH_NESTING);
+	linkmode_and(phy->advertising, phydev->advertising, phy->supported);
+	/* flow control is the MAC's to offer, the PHY only advertises it */
+	linkmode_mod_bit(ETHTOOL_LINK_MODE_Pause_BIT, phy->advertising,
+			 linkmode_test_bit(ETHTOOL_LINK_MODE_Pause_BIT,
+					   phydev->advertising));
+	linkmode_mod_bit(ETHTOOL_LINK_MODE_Asym_Pause_BIT, phy->advertising,
+			 linkmode_test_bit(ETHTOOL_LINK_MODE_Asym_Pause_BIT,
+					   phydev->advertising));
+	phy->autoneg = phydev->autoneg;
+	phy->speed = phydev->speed;
+	phy->duplex = phydev->duplex;
+	phy->mdix_ctrl = phydev->mdix_ctrl;
+	phy->master_slave_set = phydev->master_slave_set;
+	ret = phy_config_aneg(phy);
+	mutex_unlock(&phy->lock);
+
+	if (ret)
+		phydev_warn(phydev, "SFP module PHY not configured: %pe\n",
+			    ERR_PTR(ret));
+}
