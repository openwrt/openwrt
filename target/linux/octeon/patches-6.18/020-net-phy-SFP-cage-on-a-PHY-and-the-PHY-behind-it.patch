From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Polack <spolack+git@mailbox.org>
Subject: [PATCH] net: phy: an SFP cage on the fiber media of a PHY, and the module's PHY behind it

Squashed backport of two patches:
  net: phy: mscc: support an SFP cage on the fiber media of the VSC8574 family
  net: phy: configure the PHY of an SFP module behind a PHY

Signed-off-by: Simon Polack <spolack+git@mailbox.org>

--- a/drivers/net/phy/mscc/mscc.h
+++ b/drivers/net/phy/mscc/mscc.h
@@ -201,6 +201,10 @@ enum rgmii_clock_delay {
 
 #define MSCC_PHY_SERDES_TX_VALID_CNT	  21
 #define MSCC_PHY_SERDES_TX_CRC_ERR_CNT	  22
+/* Clause 37 word received on the SerDes media: the 1000BASE-X abilities of
+ * the partner, or the SGMII word (LPA_SGMII_*) of the PHY in a copper SFP.
+ */
+#define MSCC_PHY_SERDES_MEDIA_LPA	  26
 #define MSCC_PHY_SERDES_RX_VALID_CNT	  28
 #define MSCC_PHY_SERDES_RX_CRC_ERR_CNT	  29
 
@@ -382,6 +386,18 @@ struct vsc8531_private {
 	int nstats;
 	/* PHY address within the package. */
 	u8 addr;
+	/* MEDIA_OP_MODE_* of the port, not copper when an SFP module is in
+	 * the cage the PHY's SerDes media interface is wired to.
+	 */
+	u8 media_op_mode;
+	/* The module in the cage is a copper one that asked for SGMII */
+	bool sfp_sgmii;
+	/* VSC8574_SFP_REQ_*: what the SFP cage asked for and the PHY has not
+	 * done yet. The SFP code calls with its locks held, which phy_start()
+	 * and phy_stop() take inside the lock of the PHY, so the request is
+	 * left here for whoever holds the lock of the PHY next.
+	 */
+	atomic_t sfp_req;
 	/* For multiple port PHYs; the MDIO address of the base PHY in the
 	 * package.
 	 */
--- a/drivers/net/phy/mscc/mscc_main.c
+++ b/drivers/net/phy/mscc/mscc_main.c
@@ -14,6 +14,7 @@
 #include <linux/mdio.h>
 #include <linux/mii.h>
 #include <linux/phy.h>
+#include <linux/sfp.h>
 #include <linux/of.h>
 #include <linux/netdevice.h>
 #include <dt-bindings/net/mscc-phy-vsc8531.h>
@@ -1700,6 +1701,71 @@ static int vsc8574_config_host_serdes(st
 			   PROC_CMD_RST_CONF_PORT | PROC_CMD_FIBER_1000BASE_X);
 }
 
+/* Enable or disable the fiber media SerDes of this port for the current
+ * media_op_mode. vsc8574_config_host_serdes() disables it during package
+ * initialisation.
+ *
+ * bus->mdio_lock should be locked when using this function.
+ */
+static int vsc8574_config_fiber_serdes(struct phy_device *phydev)
+{
+	struct vsc8531_private *vsc8531 = phydev->priv;
+	u16 cmd = PROC_CMD_FIBER_MEDIA_CONF |
+		  PROC_CMD_FIBER_PORT(vsc8531->addr) |
+		  PROC_CMD_READ_MOD_WRITE_PORT | PROC_CMD_RST_CONF_PORT;
+	int ret;
+
+	/* SGMII to a copper SFP runs at the 1000BASE-X line rate */
+	if (vsc8531->media_op_mode != MEDIA_OP_MODE_COPPER)
+		return vsc8584_cmd(phydev, cmd | PROC_CMD_FIBER_1000BASE_X);
+
+	ret = vsc8584_cmd(phydev, cmd | PROC_CMD_FIBER_DISABLE |
+			  PROC_CMD_FIBER_100BASE_FX);
+	if (ret)
+		return ret;
+
+	return vsc8584_cmd(phydev, cmd | PROC_CMD_FIBER_DISABLE |
+			   PROC_CMD_FIBER_1000BASE_X);
+}
+
+#define VSC8574_SFP_REQ_NONE		0
+#define VSC8574_SFP_REQ_COPPER		1	/* module removed */
+#define VSC8574_SFP_REQ_1000BASEX	2
+#define VSC8574_SFP_REQ_SGMII		3
+
+static void vsc8574_set_fiber_linkmodes(unsigned long *modes, bool fiber)
+{
+	linkmode_mod_bit(ETHTOOL_LINK_MODE_1000baseX_Full_BIT, modes, fiber);
+	linkmode_mod_bit(ETHTOOL_LINK_MODE_FIBRE_BIT, modes, fiber);
+}
+
+/* Take over what the SFP cage asked for, see vsc8531_private.sfp_req. Returns
+ * true when there was a request; the media mode is then the one to apply.
+ */
+static bool vsc8574_sfp_take_request(struct phy_device *phydev)
+{
+	struct vsc8531_private *vsc8531 = phydev->priv;
+	int req = atomic_xchg(&vsc8531->sfp_req, VSC8574_SFP_REQ_NONE);
+	bool fiber = req != VSC8574_SFP_REQ_COPPER;
+
+	if (req == VSC8574_SFP_REQ_NONE)
+		return false;
+
+	/* A copper module with its own PHY asks for SGMII. Until that PHY is
+	 * set up for SGMII it talks 1000BASE-X to the host as a rule, and
+	 * without a driver for it that never happens: start on the 1000BASE-X
+	 * media, read_status() changes to protocol transfer when it sees
+	 * SGMII.
+	 */
+	vsc8531->sfp_sgmii = req == VSC8574_SFP_REQ_SGMII;
+	vsc8531->media_op_mode = fiber ? MEDIA_OP_MODE_1000BASEX :
+					 MEDIA_OP_MODE_COPPER;
+	vsc8574_set_fiber_linkmodes(phydev->supported, fiber);
+	vsc8574_set_fiber_linkmodes(phydev->advertising, fiber);
+
+	return true;
+}
+
 static int vsc8584_config_init(struct phy_device *phydev)
 {
 	struct vsc8531_private *vsc8531 = phydev->priv;
@@ -1708,6 +1774,9 @@ static int vsc8584_config_init(struct ph
 
 	phydev->mdix_ctrl = ETH_TP_MDI_AUTO;
 
+	/* a module inserted before the PHY was started */
+	vsc8574_sfp_take_request(phydev);
+
 	phy_lock_mdio_bus(phydev);
 
 	/* Some parts of the init sequence are identical for every PHY in the
@@ -1757,6 +1826,13 @@ static int vsc8584_config_init(struct ph
 			goto err;
 	}
 
+	/* The package initialisation above disables the fiber SerDes */
+	if (vsc8531->media_op_mode != MEDIA_OP_MODE_COPPER) {
+		ret = vsc8574_config_fiber_serdes(phydev);
+		if (ret)
+			goto err;
+	}
+
 	phy_unlock_mdio_bus(phydev);
 
 	ret = vsc8584_macsec_init(phydev);
@@ -1769,7 +1845,7 @@ static int vsc8584_config_init(struct ph
 
 	val = phy_read(phydev, MSCC_PHY_EXT_PHY_CNTL_1);
 	val &= ~(MEDIA_OP_MODE_MASK | VSC8584_MAC_IF_SELECTION_MASK);
-	val |= (MEDIA_OP_MODE_COPPER << MEDIA_OP_MODE_POS) |
+	val |= (vsc8531->media_op_mode << MEDIA_OP_MODE_POS) |
 	       (VSC8584_MAC_IF_SELECTION_SGMII << VSC8584_MAC_IF_SELECTION_POS);
 	ret = phy_write(phydev, MSCC_PHY_EXT_PHY_CNTL_1, val);
 	if (ret)
@@ -2196,6 +2272,239 @@ static int vsc85xx_read_status(struct ph
 	return genphy_read_status(phydev);
 }
 
+/* VSC8504/VSC8574: the copper or the SerDes media, depending on the module in
+ * the SFP cage wired to the PHY's SerDes media interface.
+ */
+static int vsc8574_config_aneg(struct phy_device *phydev)
+{
+	struct vsc8531_private *vsc8531 = phydev->priv;
+
+	switch (vsc8531->media_op_mode) {
+	case MEDIA_OP_MODE_1000BASEX:
+		/* The link settings of a copper module are for its PHY, not
+		 * for the 1000BASE-X link to the module.
+		 */
+		if (vsc8531->sfp_sgmii) {
+			int ret = phy_write(phydev, MII_ADVERTISE,
+					    ADVERTISE_1000XFULL);
+
+			return ret ? ret : genphy_restart_aneg(phydev);
+		}
+		return genphy_c37_config_aneg(phydev);
+	case MEDIA_OP_MODE_SERDES:
+		/* Protocol transfer: the PHY in the module negotiates on the
+		 * copper and tells the result in its SGMII word, there is
+		 * nothing to advertise from here. The clause 37 exchange has
+		 * to be enabled for the word to be passed on.
+		 */
+		return genphy_restart_aneg(phydev);
+	default:
+		return vsc85xx_config_aneg(phydev);
+	}
+}
+
+/* Protocol transfer mode: the link is the one of the SerDes to the module,
+ * and with a module that speaks SGMII also the one its PHY reports for the
+ * copper side, together with speed and duplex. A module that speaks
+ * 1000BASE-X to the host, as most 1000BASE-T modules do until their PHY is
+ * reconfigured, sends no SGMII word and takes the SerDes link down with the
+ * copper link.
+ */
+static int vsc8574_read_status_sgmii(struct phy_device *phydev)
+{
+	int bmsr, lpa;
+
+	/* the link bit latches low */
+	bmsr = phy_read(phydev, MII_BMSR);
+	if (bmsr >= 0 && !(bmsr & BMSR_LSTATUS))
+		bmsr = phy_read(phydev, MII_BMSR);
+	if (bmsr < 0)
+		return bmsr;
+
+	phydev->link = !!(bmsr & BMSR_LSTATUS);
+	phydev->autoneg_complete = !!(bmsr & BMSR_ANEGCOMPLETE);
+	phydev->pause = 0;
+	phydev->asym_pause = 0;
+	/* forced settings are kept, they are what the module's PHY is given */
+	if (phydev->autoneg == AUTONEG_ENABLE) {
+		phydev->speed = SPEED_UNKNOWN;
+		phydev->duplex = DUPLEX_UNKNOWN;
+	}
+
+	if (!phydev->link)
+		return 0;
+
+	lpa = phy_read_paged(phydev, MSCC_PHY_PAGE_EXTENDED_3,
+			     MSCC_PHY_SERDES_MEDIA_LPA);
+	if (lpa < 0)
+		return lpa;
+
+	if (!phydev->autoneg_complete || !(lpa & LPA_SGMII)) {
+		phydev->speed = SPEED_1000;
+		phydev->duplex = DUPLEX_FULL;
+		return 0;
+	}
+
+	if (!(lpa & LPA_SGMII_LINK)) {
+		phydev->link = 0;
+		return 0;
+	}
+
+	switch (lpa & LPA_SGMII_SPD_MASK) {
+	case LPA_SGMII_1000:
+		phydev->speed = SPEED_1000;
+		break;
+	case LPA_SGMII_100:
+		phydev->speed = SPEED_100;
+		break;
+	case LPA_SGMII_10:
+		phydev->speed = SPEED_10;
+		break;
+	default:
+		phydev->link = 0;
+		return 0;
+	}
+	phydev->duplex = lpa & LPA_SGMII_FULL_DUPLEX ? DUPLEX_FULL : DUPLEX_HALF;
+
+	return 0;
+}
+
+/* Switch the media of the port. phydev->lock must be held. */
+static int vsc8574_set_media_mode(struct phy_device *phydev, u8 mode)
+{
+	struct vsc8531_private *vsc8531 = phydev->priv;
+	bool fiber = mode == MEDIA_OP_MODE_1000BASEX;
+	int ret;
+
+	vsc8531->media_op_mode = mode;
+	vsc8574_set_fiber_linkmodes(phydev->supported, fiber);
+	vsc8574_set_fiber_linkmodes(phydev->advertising, fiber);
+
+	phy_lock_mdio_bus(phydev);
+	ret = vsc8574_config_fiber_serdes(phydev);
+	phy_unlock_mdio_bus(phydev);
+	if (ret)
+		return ret;
+
+	ret = phy_modify(phydev, MSCC_PHY_EXT_PHY_CNTL_1, MEDIA_OP_MODE_MASK,
+			 mode << MEDIA_OP_MODE_POS);
+	if (ret)
+		return ret;
+
+	/* the media mode takes effect with a software reset */
+	return genphy_soft_reset(phydev);
+}
+
+static int vsc8574_read_status(struct phy_device *phydev)
+{
+	struct vsc8531_private *vsc8531 = phydev->priv;
+	bool changed;
+	int ret;
+
+	/* a module was inserted or removed */
+	if (vsc8574_sfp_take_request(phydev)) {
+		ret = vsc8574_set_media_mode(phydev, vsc8531->media_op_mode);
+		if (ret)
+			return ret;
+
+		phydev->link = 0;
+		return vsc8574_config_aneg(phydev);
+	}
+
+	if (vsc8531->media_op_mode == MEDIA_OP_MODE_SERDES)
+		return vsc8574_read_status_sgmii(phydev);
+
+	if (vsc8531->media_op_mode != MEDIA_OP_MODE_1000BASEX)
+		return vsc85xx_read_status(phydev);
+
+	/* A copper module starts out on the 1000BASE-X media, see
+	 * vsc8574_config_fiber_serdes(). Once its PHY sends an SGMII word, which
+	 * has a bit set that is reserved in 1000BASE-X, it has been switched
+	 * to SGMII and needs the protocol transfer mode.
+	 */
+	if (vsc8531->sfp_sgmii) {
+		ret = phy_read_paged(phydev, MSCC_PHY_PAGE_EXTENDED_3,
+				     MSCC_PHY_SERDES_MEDIA_LPA);
+		if (ret < 0)
+			return ret;
+
+		if (ret & LPA_SGMII) {
+			ret = vsc8574_set_media_mode(phydev,
+						     MEDIA_OP_MODE_SERDES);
+			if (ret)
+				return ret;
+
+			phydev->link = 0;
+			return genphy_restart_aneg(phydev);
+		}
+	}
+
+	ret = genphy_c37_read_status(phydev, &changed);
+	if (ret)
+		return ret;
+
+	/* 1000BASE-X runs at one speed. Without a common mode in the clause 37
+	 * negotiation, e.g. when the partner does not negotiate, speed and
+	 * duplex would stay unknown, and MACs like OCTEON's program them from
+	 * the PHY.
+	 */
+	if (phydev->link) {
+		phydev->speed = SPEED_1000;
+		phydev->duplex = DUPLEX_FULL;
+	}
+
+	return 0;
+}
+
+/* Called by the SFP code with its locks held: only leave the request, the
+ * state machine of the PHY acts on it in read_status(), or config_init() when
+ * the PHY is not started yet.
+ */
+static void vsc8574_sfp_request(struct phy_device *phydev, int req)
+{
+	struct vsc8531_private *vsc8531 = phydev->priv;
+
+	atomic_set(&vsc8531->sfp_req, req);
+	phy_trigger_machine(phydev);
+}
+
+static int vsc8574_sfp_insert(void *upstream, const struct sfp_eeprom_id *id)
+{
+	struct phy_device *phydev = upstream;
+	const struct sfp_module_caps *caps;
+	phy_interface_t interface;
+
+	caps = sfp_get_module_caps(phydev->sfp_bus);
+	interface = sfp_select_interface(phydev->sfp_bus, caps->link_modes);
+
+	switch (interface) {
+	case PHY_INTERFACE_MODE_SGMII:
+		vsc8574_sfp_request(phydev, VSC8574_SFP_REQ_SGMII);
+		return 0;
+	case PHY_INTERFACE_MODE_1000BASEX:
+		vsc8574_sfp_request(phydev, VSC8574_SFP_REQ_1000BASEX);
+		return 0;
+	default:
+		phydev_err(phydev, "SFP module needs %s, only 1000base-x and sgmii are supported\n",
+			   phy_modes(interface));
+		return -EINVAL;
+	}
+}
+
+static void vsc8574_sfp_remove(void *upstream)
+{
+	vsc8574_sfp_request(upstream, VSC8574_SFP_REQ_COPPER);
+}
+
+static const struct sfp_upstream_ops vsc8574_sfp_ops = {
+	.attach = phy_sfp_attach,
+	.detach = phy_sfp_detach,
+	.module_insert = vsc8574_sfp_insert,
+	.module_remove = vsc8574_sfp_remove,
+	.connect_phy = phy_sfp_connect_phy,
+	.disconnect_phy = phy_sfp_disconnect_phy,
+};
+
 static unsigned int vsc85xx_inband_caps(struct phy_device *phydev,
 					phy_interface_t interface)
 {
@@ -2250,6 +2559,7 @@ static int vsc8514_probe(struct phy_devi
 static int vsc8574_probe(struct phy_device *phydev)
 {
 	struct vsc8531_private *vsc8531;
+	int ret;
 	u32 default_mode[4] = {VSC8531_LINK_1000_ACTIVITY,
 	   VSC8531_LINK_100_ACTIVITY, VSC8531_LINK_ACTIVITY,
 	   VSC8531_DUPLEX_COLLISION};
@@ -2273,6 +2583,11 @@ static int vsc8574_probe(struct phy_devi
 	if (!vsc8531->stats)
 		return -ENOMEM;
 
+	/* The fiber media may carry an SFP cage, see vsc8574_config_fiber_serdes() */
+	ret = phy_sfp_probe(phydev, &vsc8574_sfp_ops);
+	if (ret)
+		return ret;
+
 	return vsc85xx_dt_led_modes_get(phydev, default_mode);
 }
 
@@ -2408,9 +2723,9 @@ static struct phy_driver vsc85xx_driver[
 	/* PHY_GBIT_FEATURES */
 	.soft_reset	= &genphy_soft_reset,
 	.config_init    = &vsc8584_config_init,
-	.config_aneg    = &vsc85xx_config_aneg,
+	.config_aneg    = &vsc8574_config_aneg,
 	.aneg_done	= &genphy_aneg_done,
-	.read_status	= &vsc85xx_read_status,
+	.read_status	= &vsc8574_read_status,
 	.handle_interrupt = vsc85xx_handle_interrupt,
 	.config_intr    = &vsc85xx_config_intr,
 	.suspend	= &genphy_suspend,
@@ -2633,9 +2948,9 @@ static struct phy_driver vsc85xx_driver[
 	/* PHY_GBIT_FEATURES */
 	.soft_reset	= &genphy_soft_reset,
 	.config_init    = &vsc8584_config_init,
-	.config_aneg    = &vsc85xx_config_aneg,
