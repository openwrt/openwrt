--- /dev/null
+++ b/arch/mips/cavium-octeon/executive/cvmx-helper-agl.c
@@ -0,0 +1,370 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Functions for AGL (RGMII management port) initialization, configuration,
+ * and monitoring on CN70XX.
+ *
+ * Adapted from the Cavium OCTEON SDK 5.1 executive (cvmx-helper-agl.c and
+ * cvmx-agl.c), Copyright (c) 2013 Cavium Inc. On CN70XX the AGL block is
+ * interface 4 and uses IPD/PKO port 24. Only a single AGL port (port 0) is
+ * supported, using the SDK default clocking (125 MHz RGMII REFCLK, DLL
+ * delays on both RX and TX clocks).
+ */
+#include <linux/delay.h>
+#include <linux/export.h>
+
+#include <asm/octeon/octeon.h>
+
+#include <asm/octeon/cvmx-config.h>
+#include <asm/octeon/cvmx-pko.h>
+#include <asm/octeon/cvmx-helper.h>
+#include <asm/octeon/cvmx-agl-defs.h>
+#include <asm/octeon/cvmx-pko-defs.h>
+
+/* PKO internal port and engine used by AGL on CN70XX (from the SDK). */
+#define AGL_PKO_PID		24
+#define AGL_PKO_EID		10
+#define AGL_PKO_BP_PORT		40
+
+static int cvmx_helper_agl_get_port(int interface)
+{
+	return interface - CVMX_HELPER_AGL_INTERFACE;
+}
+
+/**
+ * cvmx_helper_agl_present - check whether the AGL interface is usable
+ *
+ * Returns 1 if this is a CN70XX with AGL port 0 in RGMII mode.
+ */
+int cvmx_helper_agl_present(void)
+{
+	union cvmx_agl_prtx_ctl agl_prtx_ctl;
+
+	if (!OCTEON_IS_MODEL(OCTEON_CN70XX))
+		return 0;
+
+	agl_prtx_ctl.u64 = cvmx_read_csr(CVMX_AGL_PRTX_CTL(0));
+	return agl_prtx_ctl.cn70xx.mode == 0;	/* 0 = RGMII */
+}
+
+int __cvmx_helper_agl_enumerate(int interface)
+{
+	return cvmx_helper_agl_present() ? 1 : 0;
+}
+
+/**
+ * __cvmx_helper_agl_probe - probe and set up the AGL clocks
+ * @interface: Interface to probe
+ *
+ * The RGMII port is left disabled. Returns the number of ports (0 or 1).
+ */
+int __cvmx_helper_agl_probe(int interface)
+{
+	int port = cvmx_helper_agl_get_port(interface);
+	union cvmx_agl_gmx_bist gmx_bist;
+	union cvmx_agl_gmx_prtx_cfg gmx_prtx_cfg;
+	union cvmx_agl_prtx_ctl agl_prtx_ctl;
+	int result;
+
+	result = __cvmx_helper_agl_enumerate(interface);
+	if (result == 0)
+		return 0;
+
+	/* Check BIST status */
+	gmx_bist.u64 = cvmx_read_csr(CVMX_AGL_GMX_BIST);
+	if (gmx_bist.u64)
+		pr_warn("AGL%d: failed BIST (0x%016llx)\n", port,
+			(unsigned long long)gmx_bist.u64);
+
+	/* Disable the external input/output */
+	gmx_prtx_cfg.u64 = cvmx_read_csr(CVMX_AGL_GMX_PRTX_CFG(port));
+	gmx_prtx_cfg.s.en = 0;
+	cvmx_write_csr(CVMX_AGL_GMX_PRTX_CFG(port), gmx_prtx_cfg.u64);
+
+	/*
+	 * Take the DLL and clocks out of reset. SDK defaults: RGMII
+	 * REFCLK, hardware DLL delay on RXC and TXC (no bypass).
+	 */
+	agl_prtx_ctl.u64 = cvmx_read_csr(CVMX_AGL_PRTX_CTL(port));
+	agl_prtx_ctl.cn70xx.clkrst = 0;
+	agl_prtx_ctl.cn70xx.dllrst = 0;
+	agl_prtx_ctl.cn70xx.refclk_sel = 0;
+	agl_prtx_ctl.cn70xx.clkrx_set = 0;
+	agl_prtx_ctl.cn70xx.clkrx_byp = 0;
+	agl_prtx_ctl.cn70xx.clktx_byp = 0;
+	agl_prtx_ctl.cn70xx.clktx_set = 0;
+	cvmx_write_csr(CVMX_AGL_PRTX_CTL(port), agl_prtx_ctl.u64);
+	/* Force write out before wait */
+	cvmx_read_csr(CVMX_AGL_PRTX_CTL(port));
+	/* Wait for the DLL to lock (the SDK waits 256 reference clocks). */
+	udelay(100);
+
+	/* Enable the compensation controller */
+	agl_prtx_ctl.u64 = cvmx_read_csr(CVMX_AGL_PRTX_CTL(port));
+	agl_prtx_ctl.cn70xx.drv_byp = 0;
+	cvmx_write_csr(CVMX_AGL_PRTX_CTL(port), agl_prtx_ctl.u64);
+	cvmx_read_csr(CVMX_AGL_PRTX_CTL(port));
+
+	agl_prtx_ctl.u64 = cvmx_read_csr(CVMX_AGL_PRTX_CTL(port));
+	agl_prtx_ctl.cn70xx.comp = 1;
+	cvmx_write_csr(CVMX_AGL_PRTX_CTL(port), agl_prtx_ctl.u64);
+	cvmx_read_csr(CVMX_AGL_PRTX_CTL(port));
+
+	/* Wait for the compensation state to lock (SDK: 1024 ref clocks). */
+	udelay(100);
+
+	return result;
+}
+
+/**
+ * __cvmx_helper_agl_enable - bring up the AGL interface
+ * @interface: Interface to bring up
+ *
+ * Called with IPD enabled but PKO disabled. The link itself is enabled
+ * later by __cvmx_helper_agl_link_set() from the PHY state machine.
+ */
+int __cvmx_helper_agl_enable(int interface)
+{
+	int port = cvmx_helper_agl_get_port(interface);
+	union cvmx_pko_mem_port_ptrs pko_mem_port_ptrs;
+	union cvmx_pko_reg_read_idx read_idx;
+	union cvmx_agl_gmx_rxx_frm_ctl rxx_frm_ctl;
+	int i;
+
+	/* Setup PKO for the AGL interface. Back pressure is not supported. */
+	read_idx.u64 = 0;
+	read_idx.s.inc = 1;
+	cvmx_write_csr(CVMX_PKO_REG_READ_IDX, read_idx.u64);
+
+	for (i = 0; i < 40; i++) {
+		pko_mem_port_ptrs.u64 = cvmx_read_csr(CVMX_PKO_MEM_PORT_PTRS);
+		if (pko_mem_port_ptrs.s.pid == AGL_PKO_PID) {
+			pko_mem_port_ptrs.s.eid = AGL_PKO_EID;
+			pko_mem_port_ptrs.s.bp_port = AGL_PKO_BP_PORT;
+			cvmx_write_csr(CVMX_PKO_MEM_PORT_PTRS,
+				       pko_mem_port_ptrs.u64);
+			break;
+		}
+	}
+
+	rxx_frm_ctl.u64 = 0;
+	rxx_frm_ctl.s.pre_align = 1;
+	/* Disable the length check for non-min sized pkts with padding */
+	rxx_frm_ctl.s.pad_len = 1;
+	/* Disable the length check for VLAN pkts */
+	rxx_frm_ctl.s.vlan_len = 1;
+	/* PREAMBLE checking is less strict */
+	rxx_frm_ctl.s.pre_free = 1;
+	/* Control Pause Frames can match station SMAC */
+	rxx_frm_ctl.s.ctl_smac = 0;
+	/* Control Pause Frames can match globally assigned Multicast address */
+	rxx_frm_ctl.s.ctl_mcst = 1;
+	/* Forward pause information to TX block */
+	rxx_frm_ctl.s.ctl_bck = 1;
+	/* Drop Control Pause Frames */
+	rxx_frm_ctl.s.ctl_drp = 1;
+	/* Strip off the preamble */
+	rxx_frm_ctl.s.pre_strp = 1;
+	/* Check PREAMBLE+SFD on every frame */
+	rxx_frm_ctl.s.pre_chk = 1;
+	cvmx_write_csr(CVMX_AGL_GMX_RXX_FRM_CTL(port), rxx_frm_ctl.u64);
+
+	return 0;
+}
+
+/**
+ * __cvmx_helper_agl_link_get - return the link state of the AGL port
+ * @ipd_port: IPD/PKO port to query
+ *
+ * The AGL port is always driven by a PHY via phylib, so there is no
+ * in-band status to report here; return link down.
+ */
+union cvmx_helper_link_info __cvmx_helper_agl_link_get(int ipd_port)
+{
+	union cvmx_helper_link_info result;
+
+	result.u64 = 0;
+	return result;
+}
+
+/**
+ * __cvmx_helper_agl_link_set - configure the AGL port for a link state
+ * @ipd_port:  IPD/PKO port to configure
+ * @link_info: The new link state
+ *
+ * Returns zero on success, negative on failure.
+ */
+int __cvmx_helper_agl_link_set(int ipd_port,
+			       union cvmx_helper_link_info link_info)
+{
+	int interface = cvmx_helper_get_interface_num(ipd_port);
+	int port = cvmx_helper_agl_get_port(interface);
+	union cvmx_agl_gmx_prtx_cfg agl_gmx_prtx;
+	union cvmx_agl_gmx_txx_clk agl_clk;
+	union cvmx_agl_prtx_ctl agl_prtx_ctl;
+
+	/* Disable GMX before we make any changes. */
+	agl_gmx_prtx.u64 = cvmx_read_csr(CVMX_AGL_GMX_PRTX_CFG(port));
+	agl_gmx_prtx.s.en = 0;
+	agl_gmx_prtx.s.tx_en = 0;
+	agl_gmx_prtx.s.rx_en = 0;
+	cvmx_write_csr(CVMX_AGL_GMX_PRTX_CFG(port), agl_gmx_prtx.u64);
+
+	/* Wait for GMX to be idle */
+	if (CVMX_WAIT_FOR_FIELD64(CVMX_AGL_GMX_PRTX_CFG(port),
+				  union cvmx_agl_gmx_prtx_cfg, rx_idle,
+				  ==, 1, 100000) ||
+	    CVMX_WAIT_FOR_FIELD64(CVMX_AGL_GMX_PRTX_CFG(port),
+				  union cvmx_agl_gmx_prtx_cfg, tx_idle,
+				  ==, 1, 100000)) {
+		pr_warn("AGL%d: timeout waiting for GMX to be idle\n", port);
+		return -1;
+	}
+
+	agl_gmx_prtx.u64 = cvmx_read_csr(CVMX_AGL_GMX_PRTX_CFG(port));
+
+	/* Set duplex mode */
+	if (!link_info.s.link_up)
+		agl_gmx_prtx.s.duplex = 1;	/* Force full duplex on down links */
+	else
+		agl_gmx_prtx.s.duplex = link_info.s.full_duplex;
+
+	switch (link_info.s.speed) {
+	case 10:
+		agl_gmx_prtx.s.speed = 0;
+		agl_gmx_prtx.s.slottime = 0;
+		agl_gmx_prtx.s.speed_msb = 1;
+		agl_gmx_prtx.s.burst = 1;
+		break;
+	case 100:
+		agl_gmx_prtx.s.speed = 0;
+		agl_gmx_prtx.s.slottime = 0;
+		agl_gmx_prtx.s.speed_msb = 0;
+		agl_gmx_prtx.s.burst = 1;
+		break;
+	case 1000:
+		agl_gmx_prtx.s.speed_msb = 0;
+		agl_gmx_prtx.s.speed = 1;
+		agl_gmx_prtx.s.slottime = 1;	/* Only matters for half-duplex */
+		agl_gmx_prtx.s.burst = agl_gmx_prtx.s.duplex;
+		break;
+	default:	/* No link */
+		break;
+	}
+
+	/* Write the new GMX setting with the port still disabled. */
+	cvmx_write_csr(CVMX_AGL_GMX_PRTX_CFG(port), agl_gmx_prtx.u64);
+	/* Read GMX CFG again to make sure the config is completed. */
+	agl_gmx_prtx.u64 = cvmx_read_csr(CVMX_AGL_GMX_PRTX_CFG(port));
+
+	/* RGMII TX clock divider: 1 for 1000, 5 for 100, 50 for 10 Mbps. */
+	agl_clk.u64 = cvmx_read_csr(CVMX_AGL_GMX_TXX_CLK(port));
+	agl_clk.s.clk_cnt = 1;
+	if (link_info.s.speed == 10)
+		agl_clk.s.clk_cnt = 50;
+	else if (link_info.s.speed == 100)
+		agl_clk.s.clk_cnt = 5;
+	cvmx_write_csr(CVMX_AGL_GMX_TXX_CLK(port), agl_clk.u64);
+
+	/* Enable transmit and receive ports */
+	agl_gmx_prtx.s.tx_en = 1;
+	agl_gmx_prtx.s.rx_en = 1;
+	cvmx_write_csr(CVMX_AGL_GMX_PRTX_CFG(port), agl_gmx_prtx.u64);
+
+	/* Enable the link. */
+	agl_gmx_prtx.s.en = 1;
+	cvmx_write_csr(CVMX_AGL_GMX_PRTX_CFG(port), agl_gmx_prtx.u64);
+
+	/* OCTEON III: set clkrst and enable the interface */
+	agl_prtx_ctl.u64 = cvmx_read_csr(CVMX_AGL_PRTX_CTL(port));
+	agl_prtx_ctl.cn70xx.clkrst = 1;
+	cvmx_write_csr(CVMX_AGL_PRTX_CTL(port), agl_prtx_ctl.u64);
+	cvmx_read_csr(CVMX_AGL_PRTX_CTL(port));
+	agl_prtx_ctl.cn70xx.enable = 1;
+	cvmx_write_csr(CVMX_AGL_PRTX_CTL(port), agl_prtx_ctl.u64);
+	/* Read the value back to force the previous write */
+	cvmx_read_csr(CVMX_AGL_PRTX_CTL(port));
+
+	return 0;
+}
+
+/**
+ * cvmx_helper_agl_port_enable - enable or disable AGL packet I/O
+ * @port:   AGL port index (0)
+ * @enable: true to enable
+ */
+void cvmx_helper_agl_port_enable(int port, bool enable)
+{
+	union cvmx_agl_gmx_prtx_cfg agl_gmx_prtx;
+
+	agl_gmx_prtx.u64 = cvmx_read_csr(CVMX_AGL_GMX_PRTX_CFG(port));
+	agl_gmx_prtx.s.en = enable;
+	cvmx_write_csr(CVMX_AGL_GMX_PRTX_CFG(port), agl_gmx_prtx.u64);
+}
+EXPORT_SYMBOL_GPL(cvmx_helper_agl_port_enable);
+
+/**
+ * cvmx_helper_agl_set_rx_mode - program the AGL address filter mode
+ * @port:     AGL port index (0)
+ * @promisc:  accept all unicast
+ * @allmulti: accept all multicast
+ */
+void cvmx_helper_agl_set_rx_mode(int port, bool promisc, bool allmulti)
+{
+	union cvmx_agl_gmx_prtx_cfg agl_gmx_prtx;
+	union cvmx_agl_gmx_rxx_adr_ctl control;
+
+	control.u64 = 0;
+	control.s.bcst = 1;			/* Allow broadcast */
+	control.s.mcst = (allmulti || promisc) ? 2 : 1;	/* accept / reject */
+	control.s.cam_mode = promisc ? 0 : 1;	/* reject / accept CAM hits */
+
+	agl_gmx_prtx.u64 = cvmx_read_csr(CVMX_AGL_GMX_PRTX_CFG(port));
+	cvmx_write_csr(CVMX_AGL_GMX_PRTX_CFG(port), agl_gmx_prtx.u64 & ~1ull);
+
+	cvmx_write_csr(CVMX_AGL_GMX_RXX_ADR_CTL(port), control.u64);
+	cvmx_write_csr(CVMX_AGL_GMX_RXX_ADR_CAM_EN(port), promisc ? 0 : 1);
+
+	cvmx_write_csr(CVMX_AGL_GMX_PRTX_CFG(port), agl_gmx_prtx.u64);
+}
+EXPORT_SYMBOL_GPL(cvmx_helper_agl_set_rx_mode);
+
+/**
+ * cvmx_helper_agl_set_mac - program the AGL station MAC and CAM entry 0
+ * @port: AGL port index (0)
+ * @mac:  6-byte MAC address
+ */
+void cvmx_helper_agl_set_mac(int port, const u8 *mac)
