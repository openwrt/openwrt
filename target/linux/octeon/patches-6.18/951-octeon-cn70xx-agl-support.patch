+void cvmx_helper_agl_set_max_frame(int port, int size)
+{
+	cvmx_write_csr(CVMX_AGL_GMX_RXX_FRM_MAX(port), size);
+	cvmx_write_csr(CVMX_AGL_GMX_RXX_JABBER(port), (size + 7) & ~7u);
+}
+EXPORT_SYMBOL_GPL(cvmx_helper_agl_set_max_frame);
