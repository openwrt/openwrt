+/*
+ * Functions for AGL (RGMII management port) initialization, configuration,
+ * and monitoring on CN70XX. Adapted from the Cavium OCTEON SDK 5.1
+ * executive (cvmx-helper-agl.c / cvmx-agl.c).
+ */
+#ifndef __CVMX_HELPER_AGL_H__
+#define __CVMX_HELPER_AGL_H__
+
+/* IPD/PKO port used by the CN70XX AGL interface. */
+#define CVMX_HELPER_AGL_IPD_PORT	24
+/* Interface number of the CN70XX AGL block. */
+#define CVMX_HELPER_AGL_INTERFACE	4
+
+extern int cvmx_helper_agl_present(void);
+extern int __cvmx_helper_agl_enumerate(int interface);
+extern int __cvmx_helper_agl_probe(int interface);
+extern int __cvmx_helper_agl_enable(int interface);
+extern union cvmx_helper_link_info __cvmx_helper_agl_link_get(int ipd_port);
+extern int __cvmx_helper_agl_link_set(int ipd_port,
+				      union cvmx_helper_link_info link_info);
+extern void cvmx_helper_agl_set_mac(int port, const u8 *mac);
+extern void cvmx_helper_agl_set_rx_mode(int port, bool promisc, bool allmulti);
+extern void cvmx_helper_agl_port_enable(int port, bool enable);
+extern void cvmx_helper_agl_set_max_frame(int port, int size);
+
+#endif /* __CVMX_HELPER_AGL_H__ */
