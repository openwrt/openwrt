+/*
+ * PSE buffer in the GDMP SRAM (EN7523, AN7552: vendor fe_ic_dis.h
+ * SUPPORT_PSE_USE_GDMP).  gdump_mode_sel(FE_ACCESS_DATA) in vendor
+ * ecnt_gdump.c writes 3 into GDMP 0x74 and, on AN7552, clears
+ * PCIE_HSGMII1_SEL in SCU SSR3 (ecnt_scu.c CR_NP_SCU_SSR3 = 0x94).
+ * fe_api.c pse_set_total_page() then sets PSE_FQ_CFG to 0x500 pages,
+ * 0x400 of the PSE and 0x100 of GDMP, and the stock fe_core does both
+ * for HIR 0xc and 0xf, followed by a fixed PSE_SHARE_USED_THD.
+ */
+#define AN7552_SCU_SSR3			0x94
+#define AN7552_SSR3_PCIE_HSGMII1_SEL	BIT(30)
+#define AN7552_GDMP_DATA_SEL		0x74
+#define AN7552_GDMP_DATA_SEL_MASK	GENMASK(1, 0)
+#define AN7552_GDMP_FE_ACCESS_DATA	3
+#define AN7552_PSE_FQ_PAGES		0x500
+#define AN7552_PSE_SHARE_USED_THD	0x01e001f4
+
