@@ -45,6 +64,18 @@ u32 airoha_rmw(void __iomem *base, u32 o
 	return val;
 }
 
+/* rx rings whose interrupts go to irq bank @bank, rings the SoC has only */
+static u32 airoha_qdma_rx_irq_bank_mask(struct airoha_qdma *qdma, int bank)
+{
+	const struct airoha_eth_soc_data *soc = qdma->eth->soc;
+	u32 mask = RX_IRQ_BANK_PIN_MASK(bank);
+
+	if (bank == 1 && soc->rx_irq_bank1_mask)
+		mask = soc->rx_irq_bank1_mask;
+
+	return mask & GENMASK(airoha_num_rx_ring(qdma->eth) - 1, 0);
+}
