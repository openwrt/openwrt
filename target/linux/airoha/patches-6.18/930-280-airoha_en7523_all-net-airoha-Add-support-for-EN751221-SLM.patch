From 12a3b4ef6fcff76d3d6d521bb49db67272fce552 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 18 Aug 2026 17:11:38 -0300
Subject: [PATCH] net: airoha: Add support for EN751221 SLM

Implement Support Layer Memory (SLM) for the Airoha EN751221 QDMA. This
feature optimizes memory usage on systems with limited DRAM (<= 256 MiB)
by providing a dedicated memory path for hardware forwarding buffers.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_qdma.c | 215 +++++++++++++++++++++-
 1 file changed, 207 insertions(+), 8 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_qdma.c b/drivers/net/ethernet/airoha/airoha_qdma.c
index eaf281be8c7b..cd48b0d73fca 100644
--- a/drivers/net/ethernet/airoha/airoha_qdma.c
+++ b/drivers/net/ethernet/airoha/airoha_qdma.c
@@ -3,16 +3,22 @@
  * Shared Airoha/EcoNet QDMA helpers and generation-1 QDMA backend.
  */
 #include <linux/bitmap.h>
+#include <linux/debugfs.h>
 #include <linux/dma-mapping.h>
 #include <linux/etherdevice.h>
 #include <linux/interrupt.h>
+#include <linux/io.h>
 #include <linux/netdevice.h>
 #include <linux/if_vlan.h>
 #include <linux/ipv6.h>
+#include <linux/mm.h>
+#include <linux/module.h>
 #include <linux/tcp.h>
 #include <linux/of_reserved_mem.h>
 #include <linux/skbuff.h>
 #include <linux/slab.h>
+#include <linux/sizes.h>
+#include <linux/seq_file.h>
 #include <linux/unaligned.h>
 #include <net/dsa.h>
 #include <net/dst_metadata.h>
@@ -179,6 +185,42 @@ struct econet_tx_doneq {
 	struct napi_struct 		napi;
 };
 
+#define EN751221_SLM_BASE			0x1fa60000
+#define EN751221_SLM_REG_SIZE			SZ_256
+#define EN751221_SLM_HWF_VIRT_BASE		0x1b800000
+#define EN751221_SLM_PHYS_SIZE			SZ_4M
+#define EN751221_SLM_MAX_DRAM_SIZE		SZ_256M
+#define EN751221_SLM_SECTOR_SIZE		SZ_256
+
+#define EN751221_SLM_GLO_CFG_BYPASS		BIT(0)
+#define EN751221_SLM_EN_ENABLE			BIT(0)
+#define EN751221_SLM_EN_ACTIVE			BIT(1)
+
+struct en751221_slm_regs {
+	u32 glo_cfg;
+	u32 enable;
+	u32 reserved_08[2];
+	u32 virt_base;
+	u32 virt_size;
+	u32 phys_base;
+	u32 phys_size;
+	u32 free_min_cnt;
+	u32 free_cur_cnt;
+	u32 free_threshold;
+	u32 reserved_2c;
+	u32 api_cmd;
+	u32 api_base;
+	u32 api_rd_addr;
+	u32 reserved_3c;
+	u32 int_status;
+	u32 int_mask;
+	u32 bus_rd_null_addr;
+	u32 reserved_4c;
+	u32 drop_cmd;
+	u32 drop_addr;
+	u32 drop_cnt;
+};
+
 struct econet_qdma {
 	struct airoha_qdma_common	common;
 
@@ -199,6 +241,12 @@ struct econet_qdma {
 	struct fwdesc 			*hwf_desc;
 	int				num_fwd_descs;
 	u32				fwd_buf_size;
+	struct en751221_slm_regs __iomem *slm_regs;
+	void				*slm_buf;
+	dma_addr_t			slm_dma_addr;
+	size_t				slm_buf_size;
+	bool				slm_enabled;
+	struct dentry			*slm_debugfs_dir;
 	struct net_device 		*napi_dev;
 	struct econet_qdma_cfg 		cfg;
 	const struct airoha_eth_soc_data	*soc;
@@ -364,7 +412,6 @@ union irq_bit {
 	};
 	u32 word;
 };
-static_assert(sizeof(union irq_bit) == 4, "irq_bit size");
 
 /* IRQ functions relevant to the EN751221 IRQ layout */
 
@@ -958,13 +1005,153 @@ static int econet_init_tx_queue(struct econet_q_tx *q,
 	return 0;
 }
 
+static bool econet_en751221_use_slm(struct econet_qdma *qdma)
+{
+	if (!airoha_is(qdma->common.eth, econet_en751221) ||
+	    qdma->common.id != 1)
+		return false;
+
+	/*
+	 * The EN7512 SDK enables QDMA_WAN SLM when GET_DRAM_SIZE <= 256.
+	 * totalram_pages() is slightly smaller than the fitted DRAM because
+	 * kernel reservations are already excluded, which keeps the 256 MiB
+	 * boards on the same side of the threshold as the vendor code.
+	 */
+	return (totalram_pages() << PAGE_SHIFT) <= EN751221_SLM_MAX_DRAM_SIZE;
+}
+
+static int econet_en751221_slm_wait_idle(struct econet_qdma *qdma)
+{
+	u32 val;
+	int ret;
+
+	ret = read_poll_timeout(readl, val,
+				(val & (EN751221_SLM_EN_ENABLE |
+					EN751221_SLM_EN_ACTIVE)) !=
+				(EN751221_SLM_EN_ENABLE |
+				 EN751221_SLM_EN_ACTIVE),
+				USEC_PER_MSEC, 20 * USEC_PER_MSEC, true,
+				&qdma->slm_regs->enable);
+	if (ret)
+		dev_err(qdma->dev, "SLM is still active after 20 ms\n");
+
+	return ret;
+}
+
+static void econet_en751221_slm_disable(struct econet_qdma *qdma)
+{
+	if (!qdma->slm_regs || !qdma->slm_enabled)
+		return;
+
+	/*
+	 * QDMA RX/TX is already stopped by the destroy path. If the SLM busy
+	 * indication nevertheless sticks, report it but still disable the block
+	 * before releasing its DMA backing; leaving the aperture live would be
+	 * worse than reproducing the vendor's forced-disable behaviour here.
+	 */
+	econet_en751221_slm_wait_idle(qdma);
+	writel(0, &qdma->slm_regs->enable);
+	writel(0, &qdma->slm_regs->virt_size);
+	writel(0, &qdma->slm_regs->phys_size);
+	writel(0, &qdma->slm_regs->virt_base);
+	writel(0, &qdma->slm_regs->phys_base);
+	qdma->slm_enabled = false;
+
+	debugfs_remove_recursive(qdma->slm_debugfs_dir);
+	qdma->slm_debugfs_dir = NULL;
+
+	if (qdma->slm_buf) {
+		dmam_free_coherent(qdma->dev, qdma->slm_buf_size,
+				   qdma->slm_buf, qdma->slm_dma_addr);
+		qdma->slm_buf = NULL;
+		qdma->slm_buf_size = 0;
+		qdma->slm_dma_addr = 0;
+	}
+}
+
+static int econet_en751221_slm_init(struct econet_qdma *qdma,
+				    size_t virtual_size, u32 *hwf_data_addr)
+{
+	size_t physical_size = min_t(size_t, virtual_size,
+				     EN751221_SLM_PHYS_SIZE);
+	dma_addr_t dma_addr;
+	u32 glo_cfg;
+	void *buf;
+	int ret;
+
+	if (!IS_ALIGNED(virtual_size, EN751221_SLM_SECTOR_SIZE) ||
+	    !IS_ALIGNED(physical_size, EN751221_SLM_SECTOR_SIZE))
+		return -EINVAL;
+
+	qdma->slm_regs = devm_ioremap(qdma->dev, EN751221_SLM_BASE,
+				      EN751221_SLM_REG_SIZE);
+	if (!qdma->slm_regs)
+		return dev_err_probe(qdma->dev, -ENOMEM,
+				     "failed to map EN751221 SLM registers\n");
+
+	/*
+	 * Boot2 sets GLO_CFG[0] when the image was built without SLM support.
+	 * Do not clear it from Linux: the remaining GLO_CFG bits are undocumented
+	 * and the board has already completed DRAM/arbiter initialisation.
+	 */
+	glo_cfg = readl(&qdma->slm_regs->glo_cfg);
+	if (glo_cfg & EN751221_SLM_GLO_CFG_BYPASS)
+		return dev_err_probe(qdma->dev, -EOPNOTSUPP,
+				     "EN751221 SLM is bypassed by firmware (GLO_CFG=%08x)\n",
+				     glo_cfg);
+
+	ret = econet_en751221_slm_wait_idle(qdma);
+	if (ret)
+		return ret;
+
+	writel(0, &qdma->slm_regs->enable);
+
+	buf = dmam_alloc_coherent(qdma->dev, physical_size, &dma_addr,
+				  GFP_KERNEL);
+	if (!buf)
+		return dev_err_probe(qdma->dev, -ENOMEM,
+				     "failed to allocate SLM backing memory\n");
+	if (upper_32_bits(dma_addr)) {
+		dmam_free_coherent(qdma->dev, physical_size, buf, dma_addr);
+		return dev_err_probe(qdma->dev, -ERANGE,
+				     "SLM backing DMA address must be below 4 GiB\n");
+	}
+
+	qdma->slm_buf = buf;
+	qdma->slm_dma_addr = dma_addr;
+	qdma->slm_buf_size = physical_size;
+
+	writel(virtual_size / EN751221_SLM_SECTOR_SIZE,
+	       &qdma->slm_regs->virt_size);
+	writel(physical_size / EN751221_SLM_SECTOR_SIZE,
+	       &qdma->slm_regs->phys_size);
+	writel(EN751221_SLM_HWF_VIRT_BASE, &qdma->slm_regs->virt_base);
+	writel(lower_32_bits(dma_addr), &qdma->slm_regs->phys_base);
+	qdma->slm_enabled = true;
+	writel(1, &qdma->slm_regs->enable);
+
+	if (!(readl(&qdma->slm_regs->enable) & BIT(0))) {
+		econet_en751221_slm_disable(qdma);
+		return dev_err_probe(qdma->dev, -EIO,
+				     "failed to enable EN751221 SLM\n");
+	}
+
+	*hwf_data_addr = EN751221_SLM_HWF_VIRT_BASE;
+	dev_info(qdma->dev,
+		 "QDMA1 SLM enabled: HWF 0x%08x+%zu KiB -> DMA %pad+%zu KiB\n",
+		 EN751221_SLM_HWF_VIRT_BASE, virtual_size / SZ_1K,
+		 &qdma->slm_dma_addr, physical_size / SZ_1K);
+
+	return 0;
+}
+
 static int econet_init_hw_fwd(struct econet_qdma *qdma)
 {
 	enum qregs_hwf_cfg_pkt_sz buf_size_cfg = QREGS_HWF_CFG_PKT_SZ_2048;
 	int ret, size, index, num_desc = qdma->cfg.num_fwd_descs;
 	struct qregs_hwf_cfg1 cfg1;
 	dma_addr_t dma_addr;
-	u32 buf_size = 2048;
+	u32 buf_size = 2048, hwf_data_addr;
 	struct hwf_cfg cfg;
 	const char *name;
 
@@ -982,6 +1169,14 @@ static int econet_init_hw_fwd(struct econet_qdma *qdma)
 		}
 	}
 
+	if (econet_en751221_use_slm(qdma)) {
+		size = buf_size * num_desc;
+		ret = econet_en751221_slm_init(qdma, size, &hwf_data_addr);
+		if (ret)
+			return ret;
+		goto hwf_data_ready;
+	}
+
 	index = of_property_match_string(qdma->dev->of_node,
 					 "memory-region-names", name);
 	if (index >= 0) {
@@ -1025,11 +1220,10 @@ static int econet_init_hw_fwd(struct econet_qdma *qdma)
 				 buf_size, num_desc);
 	} else {
 		/*
-		 * The vendor QDMA_WAN reserves 8 MiB for 4096 x 2 KiB HWF
-		 * buffers. Do not require such a large contiguous coherent
-		 * allocation on boards that omit the reserved qdma1-buf region;
-		 * keep the exact 4096-entry profile whenever the region exists,
-		 * otherwise use a conservative fallback pool.
+		 * QDMA_WAN uses SLM on <= 256 MiB systems. On larger systems
+		 * without reserved memory, do not require an 8 MiB contiguous
+		 * coherent allocation; keep the exact 4096-entry profile when a
+		 * qdma1-buf region exists, otherwise use a conservative fallback.
 		 */
 		if (airoha_is(qdma->common.eth, econet_en751221) && qdma->common.id == 1 &&
 		    num_desc > 256)
@@ -1041,7 +1235,10 @@ static int econet_init_hw_fwd(struct econet_qdma *qdma)
 			return -ENOMEM;
 	}
 
-	econet_wreg(lower_32_bits(dma_addr), &qdma->regs->hwf_data_addr);
+	hwf_data_addr = lower_32_bits(dma_addr);
+
+hwf_data_ready:
+	econet_wreg(hwf_data_addr, &qdma->regs->hwf_data_addr);
 
 	size = num_desc * sizeof(*qdma->hwf_desc);
 	qdma->hwf_desc = dmam_alloc_coherent(qdma->dev, size, &dma_addr, GFP_KERNEL);
@@ -1406,6 +1603,8 @@ static int airoha_qdma_gen1_destroy_locked(struct econet_qdma *qdma)
 	set_qregs_qcfg_tx_dma_en(&qcfg, false);
 	econet_wreg(qcfg, &qdma->regs->qdma_cfg);
 
+	econet_en751221_slm_disable(qdma);
+
 	for (i = 0; i < ARRAY_SIZE(qdma->irqs); i++) {
 		struct econet_irq *irq = &qdma->irqs[i];
 		int j;
-- 
2.55.0

