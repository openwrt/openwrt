 EXPORT_SYMBOL_GPL(airoha_xpon_get_ppe_downstream);
 
+/*
+ * An upstream flow is to leave through the client's net_device (@odev, the
+ * lowest device of the flow, @vid its outer VLAN or 0): the client says
+ * which VID, GEM port, T-CONT and queue its frames get.  @skprio is the
+ * priority the flowtable carried (FLOW_ACTION_PRIORITY, "meta priority
+ * set"); without one the P-bit follows the DSCP: as ip_forward() does for
+ * IPv4 (net.ipv4.ip_forward_update_priority) and for IPv6 too, whose
+ * forwarding leaves skb->priority 0.  The VLAN device on @odev maps it
+ * through its egress_qos_map.
+ * Returns the GDM device of the client, an ERR_PTR when the flow stays on
+ * the CPU, NULL when @odev is not the client's.
+ */
+struct airoha_gdm_dev *airoha_xpon_ppe_upstream(struct net_device *odev,
+						u16 vid, u8 dsfield, bool ipv4,
+						u32 skprio,
+						struct airoha_xpon_ppe_us *us)
+{
+	int (*cb)(void *priv, struct airoha_xpon_ppe_us *us) = NULL;
+	struct airoha_gdm_dev *gdm = NULL;
+	struct net_device *vdev;
+	unsigned long flags;
+	void *priv = NULL;
+	int err;
+
+	spin_lock_irqsave(&airoha_xpon_lock, flags);
+	if (odev && airoha_xpon_client.tx_dev == odev) {
+		gdm = airoha_xpon_client.gdm;
+		cb = airoha_xpon_client.ppe_upstream;
+		priv = airoha_xpon_client.rx_priv;
+		if (cb)
+			airoha_xpon_inflight++;
+	}
+	spin_unlock_irqrestore(&airoha_xpon_lock, flags);
+
+	if (!gdm)
+		return NULL;
+	if (!cb)
+		return ERR_PTR(-EOPNOTSUPP);
+
+	if (!skprio &&
+	    (!ipv4 || READ_ONCE(dev_net(odev)->ipv4.sysctl_ip_fwd_update_priority)))
+		skprio = rt_tos2priority(dsfield);
+
+	memset(us, 0, sizeof(*us));
+	us->vid = vid;
+	us->dscp = dsfield >> 2;
+	if (vid) {
+		rcu_read_lock();
+		vdev = __vlan_find_dev_deep_rcu(odev, htons(ETH_P_8021Q), vid);
+		if (vdev)
+			us->pcp = vlan_dev_get_egress_qos_mask(vdev, skprio) >>
+				  VLAN_PRIO_SHIFT;
+		rcu_read_unlock();
+	}
+
+	err = cb(priv, us);
+
+	spin_lock_irqsave(&airoha_xpon_lock, flags);
+	airoha_xpon_inflight--;
+	if (!airoha_xpon_inflight)
+		wake_up_all(&airoha_xpon_wq);
+	spin_unlock_irqrestore(&airoha_xpon_lock, flags);
+
+	if (err)
+		return ERR_PTR(err);
+	if (us->channel > AIROHA_XPON_MAX_CHANNEL ||
+	    us->queue > AIROHA_XPON_MAX_QUEUE || us->pcp > 7 ||
+	    us->vid >= VLAN_N_VID)
+		return ERR_PTR(-EINVAL);
+
+	return gdm;
+}
+
+/*
+ * The client's upstream classification changed (rules, VID map, GEMs,
+ * T-CONTs): unbind the upstream flows of the PPE, they carry the old GEM
+ * port and channel.  They go through the CPU until the flowtable's next
+ * REPLACE for them (about once a second while they have traffic) binds
+ * them again with the new classification.  Process context.
+ */
+void airoha_xpon_ppe_flush(void)
+{
+	struct airoha_eth *eth = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&airoha_xpon_lock, flags);
+	if (airoha_xpon_client.gdm)
+		eth = airoha_xpon_client.gdm->eth;
+	spin_unlock_irqrestore(&airoha_xpon_lock, flags);
+
+	if (eth)
+		airoha_ppe_xpon_flush(eth);
+}
+EXPORT_SYMBOL_GPL(airoha_xpon_ppe_flush);
+
