 }
 EXPORT_SYMBOL_GPL(airoha_ppe_wed_detach);
 
+/*
+ * Unbind the upstream flows of the xPON client (airoha_xpon_ppe_flush());
+ * as for a WED detach their software entries stay, marked stale, and a
+ * flow that still has traffic is rebuilt by the flowtable's next REPLACE
+ * with what the client says then.
+ */
+void airoha_ppe_xpon_flush(struct airoha_eth *eth)
+{
+	struct airoha_flow_table_entry *e;
+	struct rhashtable_iter iter;
+
+	mutex_lock(&flow_offload_mutex);
+	rhashtable_walk_enter(&eth->flow_table, &iter);
+	rhashtable_walk_start(&iter);
+	while ((e = rhashtable_walk_next(&iter))) {
+		if (IS_ERR(e) || !e->xpon)
+			continue;
+
+		airoha_ppe_foe_flow_remove_entry(eth->ppe, e);
+		e->xpon = false;
+		e->stale = true;
+	}
+	rhashtable_walk_stop(&iter);
+	rhashtable_walk_exit(&iter);
+	mutex_unlock(&flow_offload_mutex);
+}
+
 static int airoha_ppe_wed_flow_add(int idx)
 {
 	int err = -ENODEV;
@@ -478,11 +506,13 @@ static int airoha_ppe_foe_entry_prepare(
 					struct airoha_foe_entry *hwe,
 					struct net_device *netdev, int type,
 					struct airoha_flow_data *data,
-					int l4proto, u8 dsfield, int *wed_idx)
+					int l4proto, u8 dsfield, int *wed_idx,
+					bool *xpon, u32 skprio)
 {
 	u32 qdata = FIELD_PREP(AIROHA_FOE_SHAPER_ID, 0x7f), ports_pad, val;
 	int wlan_etype = -EINVAL, dsa_port = airoha_get_dsa_port(&netdev);
 	struct airoha_foe_mac_info_common *l2;
+	int gem_etype = -EINVAL;
 	u8 smac_id = 0xf;
 
 	memset(hwe, 0, sizeof(*hwe));
@@ -499,9 +529,49 @@ static int airoha_ppe_foe_entry_prepare(
 	val = FIELD_PREP(AIROHA_FOE_IB2_PORT_AG, 0x1f);
 	if (netdev) {
 		struct airoha_wdma_info info = {};
+		struct airoha_xpon_ppe_us us;
+		struct airoha_gdm_dev *xdev;
 
-		if (!airoha_ppe_get_wdma_info(netdev, data->eth.h_dest,
-					      &info)) {
+		xdev = airoha_xpon_ppe_upstream(netdev,
+						data->vlan.num ?
+						data->vlan.hdr[0].id : 0,
+						dsfield,
+						type < PPE_PKT_TYPE_IPV6_ROUTE_3T,
+						skprio, &us);
+		if (IS_ERR(xdev))
+			return PTR_ERR(xdev);
+
+		if (xdev) {
+			/*
+			 * Upstream to the xPON client, as hw_nat writes it for
+			 * FOE_MAGIC_GPON (ra_nat_entry.c:5136-5145, 5991): the
+			 * QDMA hardware forward port (FP_QDMA_HW, 2) with the
+			 * PSE QoS bit, the T-CONT as channel and NBQ
+			 * (gpon_wan.c:453-456), the queue as qid and the GEM
+			 * port in the etype field.  The outer tag is the one
+			 * the client's tc rules leave on the fibre, P-bit
+			 * included, as hw_nat copies the whole TCI
+			 * (ra_nat_entry.c:1709, 2893).
+			 */
+			if (type == PPE_PKT_TYPE_BRIDGE || data->vlan.num > 1 ||
+			    !!data->vlan.num != !!us.vid)
+				return -EOPNOTSUPP;
+
+			qdata |= FIELD_PREP(AIROHA_FOE_CHANNEL, us.channel) |
+				 FIELD_PREP(AIROHA_FOE_QID, us.queue);
+			val |= FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT,
+					  FE_PSE_PORT_GDM2) |
+			       FIELD_PREP(AIROHA_FOE_IB2_NBQ, us.channel) |
+			       FIELD_PREP(AIROHA_FOE_IB2_DSCP, dsfield) |
+			       AIROHA_FOE_IB2_PSE_QOS;
+			if (data->vlan.num)
+				data->vlan.hdr[0].id = us.vid |
+					(us.pcp << VLAN_PRIO_SHIFT);
+			gem_etype = us.gem_port;
+			smac_id = xdev->port->id;
+			*xpon = true;
+		} else if (!airoha_ppe_get_wdma_info(netdev, data->eth.h_dest,
+						     &info)) {
 			if (eth->soc->wed_cdm4_queues) {
 				/*
 				 * AN7552/AN7563, entry as the vendor hw_nat
@@ -636,6 +706,9 @@ static int airoha_ppe_foe_entry_prepare(
 
