--- a/include/linux/soc/airoha/airoha_xpon.h
+++ b/include/linux/soc/airoha/airoha_xpon.h
@@ -45,14 +45,36 @@ struct airoha_xpon_rx_info {
 };
 
 /**
+ * struct airoha_xpon_ppe_us - an upstream flow the PPE would send to @tx_dev
+ * @vid: in: outer VID the router side sends (0: untagged); out: the VID
+ *	the frames carry on the fibre
+ * @pcp: in: P-bit of that tag on the CPU path; out: the P-bit on the fibre
+ * @dscp: in: DSCP of the flow (IPv4 TOS or IPv6 traffic class)
+ * @gem_port: out: GEM port id
+ * @channel: out: T-CONT channel
+ * @queue: out: queue inside @channel
+ */
+struct airoha_xpon_ppe_us {
+	u16 vid;
+	u8 pcp;
+	u8 dscp;
+	u16 gem_port;
+	u8 channel;
+	u8 queue;
+};
+
+/**
  * struct airoha_xpon_ops - xPON client callbacks
  * @rx: called from the airoha-eth NAPI context for every downstream frame,
  *	must not sleep; the callback owns @skb
- * @priv: opaque pointer handed back to @rx
+ * @priv: opaque pointer handed back to @rx and @ppe_upstream
  * @tx_dev: net_device the client's data frames are sent from; when set,
  *	frames without @oam are charged to its TX queue (BQL) and the queue
  *	is stopped/woken with the QDMA ring
  * @ppe_downstream: bind downstream flows (entering on @tx_dev) in the PPE
+ * @ppe_upstream: where an upstream flow to @tx_dev goes, as the client's
+ *	xmit would send its frames; 0 binds it in the PPE, an error leaves it
+ *	to the CPU.  Must not sleep.  NULL: no upstream flows in the PPE.
  */
 struct airoha_xpon_ops {
 	void (*rx)(void *priv, struct sk_buff *skb,
@@ -60,6 +82,7 @@ struct airoha_xpon_ops {
 	void *priv;
 	struct net_device *tx_dev;
 	bool ppe_downstream;
+	int (*ppe_upstream)(void *priv, struct airoha_xpon_ppe_us *us);
 };
 
