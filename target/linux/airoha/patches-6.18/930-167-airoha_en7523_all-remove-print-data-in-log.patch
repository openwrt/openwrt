From 82dda92822dc369c09d0bbb35aa179a1fb64afd7 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Thu, 30 Jul 2026 12:46:08 -0300
Subject: [PATCH 167/184] remove print data in log

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c | 74 ------------------------
 1 file changed, 74 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 1b30a5881c15..09fe06fc36a1 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -1436,46 +1436,6 @@ static struct sk_buff *airoha_qdma_build_rx_skb(struct airoha_queue *q,
 
 #define AIROHA_XPON_DATA_DUMP_LEN	128
 
-static DEFINE_RATELIMIT_STATE(airoha_xpon_data_dump_rs, HZ, 4);
-
-static void
-airoha_qdma_dump_xpon_data(struct airoha_queue *q,
-			    struct airoha_qdma_desc *desc,
-			    struct airoha_queue_entry *e,
-			    struct net_device *netdev, u32 desc_ctrl,
-			    u32 msg0, unsigned int len)
-{
-	u32 msg1 = le32_to_cpu(READ_ONCE(desc->msg1));
-	u32 msg2 = le32_to_cpu(READ_ONCE(desc->msg2));
-	u32 msg3 = le32_to_cpu(READ_ONCE(desc->msg3));
-	unsigned int channel, gem_port_id, sport;
-
-	if (!__ratelimit(&airoha_xpon_data_dump_rs))
-		return;
-
-	channel = FIELD_GET(EN7523_QDMA_ETH_RXMSG_CHAN_MASK, msg0);
-	gem_port_id = FIELD_GET(EN7523_QDMA_ETH_RXMSG_GEM_MASK, msg0);
-	sport = FIELD_GET(EN7523_QDMA_ETH_RXMSG_SPORT_MASK, msg1);
-
-	dev_warn(&netdev->dev,
-		 "xPON RX classified as data: ring=%td len=%u more=%u "
-		 "channel=%u gem=%u sport=%u no-mic=%u crc=%u "
-		 "runt=%u long=%u msg=%#010x/%#010x/%#010x/%#010x\n",
-		 q - &q->qdma->q_rx[0], len,
-		 !!FIELD_GET(QDMA_DESC_MORE_MASK, desc_ctrl), channel,
-		 gem_port_id, sport,
-		 !!(msg0 & EN7523_QDMA_ETH_RXMSG_NO_MIC_MASK),
-		 !!(msg0 & EN7523_QDMA_ETH_RXMSG_CRC_ERR_MASK),
-		 !!(msg0 & EN7523_QDMA_ETH_RXMSG_RUNT_MASK),
-		 !!(msg0 & EN7523_QDMA_ETH_RXMSG_LONG_MASK),
-		 msg0, msg1, msg2, msg3);
-
-	print_hex_dump(KERN_WARNING, "xPON DATA raw: ",
-		       DUMP_PREFIX_OFFSET, 16, 1, e->buf,
-		       min_t(unsigned int, len, AIROHA_XPON_DATA_DUMP_LEN),
-		       true);
-}
-
 static bool airoha_qdma_foe_entry_is_valid(struct airoha_eth *eth, u32 hash)
 {
 	return airoha_is(eth, en7523) ?
@@ -1569,11 +1529,6 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 		}
 
 		netdev = netdev_from_priv(dev);
-		if (airoha_is(eth, en7523) && !xpon_oam && !q->skb &&
-		    (dev->flags & AIROHA_PRIV_F_XPON_MANAGED))
-			airoha_qdma_dump_xpon_data(q, desc, e, netdev,
-						desc_ctrl, msg0, len);
-
 		if (!q->skb) { /* first buffer */
 			q->skb = airoha_qdma_build_rx_skb(q, desc, e, netdev, xpon_oam);
 			if (!q->skb)
@@ -1593,27 +1548,6 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 		if (FIELD_GET(QDMA_DESC_MORE_MASK, desc_ctrl))
 			continue;
 
-		if (airoha_is(eth, en7523) &&
-		    (dev->flags & AIROHA_PRIV_F_XPON_MANAGED)) {
-			u32 msg2 = le32_to_cpu(READ_ONCE(desc->msg2));
-			u32 msg3 = le32_to_cpu(READ_ONCE(desc->msg3));
-			unsigned int channel, gem_port_id, sport;
-
-			msg1 = le32_to_cpu(READ_ONCE(desc->msg1));
-			channel = FIELD_GET(EN7523_QDMA_ETH_RXMSG_CHAN_MASK, msg0);
-			gem_port_id = FIELD_GET(EN7523_QDMA_ETH_RXMSG_GEM_MASK, msg0);
-			sport = FIELD_GET(EN7523_QDMA_ETH_RXMSG_SPORT_MASK, msg1);
-			dev_info_ratelimited(&netdev->dev,
-					     "xPON RX packet: ring=%td type=%s skb-len=%u desc-len=%d protocol=%#06x channel=%u gem=%u sport=%u no-mic=%u msg=%#010x/%#010x/%#010x/%#010x\n",
-					     q - &q->qdma->q_rx[0],
-					     xpon_oam ? "oam" : "data",
-					     q->skb->len, len,
-					     ntohs(q->skb->protocol), channel,
-					     gem_port_id, sport,
-					     !!(msg0 & EN7523_QDMA_ETH_RXMSG_NO_MIC_MASK),
-					     msg0, msg1, msg2, msg3);
-		}
-
 		if (airoha_is(eth, en7523)) {
 			struct airoha_xpon_oam_handler *handler;
 
@@ -3706,14 +3640,6 @@ static netdev_tx_t __airoha_dev_xmit(struct sk_buff *skb,
 	if (xpon_oam)
 		msg1 |= QDMA_ETH_TXMSG_NO_DROP;
 
-	if (xpon)
-		dev_info_ratelimited(&netdev->dev,
-				     "xPON TX packet: qdma=%td ring=%d type=%s len=%u tcont=%u gem=%u queue=%u fport=%u msg=%#010x/%#010x\n",
-				     qdma - &dev->eth->qdma[0], qid,
-				     xpon->oam ? "oam" : "data", skb->len,
-				     xpon->tcont, xpon->gem_port_id,
-				     xpon->queue, fport, msg0, msg1);
-
 	q = &qdma->q_tx[qid];
 	if (WARN_ON_ONCE(!q->ndesc))
 		goto error;
-- 
2.55.0

