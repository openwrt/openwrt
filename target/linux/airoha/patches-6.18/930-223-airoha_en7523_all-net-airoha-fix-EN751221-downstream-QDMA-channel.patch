From e2bb01cff11af03528b7346685880315de458993 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 11 Aug 2026 14:04:03 -0300
Subject: [PATCH] net: airoha: fix EN751221 downstream QDMA channel

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/econet_eth.c | 43 +++++++++++++++++++-----
 1 file changed, 35 insertions(+), 8 deletions(-)

diff --git a/drivers/net/ethernet/airoha/econet_eth.c b/drivers/net/ethernet/airoha/econet_eth.c
index c048c32e9bc3..19d1784513e0 100644
--- a/drivers/net/ethernet/airoha/econet_eth.c
+++ b/drivers/net/ethernet/airoha/econet_eth.c
@@ -1320,6 +1320,8 @@ static int econet_dev_set_macaddr(struct net_device *dev, void *p)
 
 #define EN751221_CDM_STAG_EN		BIT(0)
 #define EN751221_GDM_STAG_EN		BIT(24)
+#define EN751221_GDM_UNTAG_EN		BIT(25)
+#define EN751221_STAG_PORT_MASK	GENMASK(5, 0)
 
 static void econet_set_gdm_port_fwd_cfg(struct econet_gdm_port *port,
 				      enum etx_fport val)
@@ -1334,10 +1336,13 @@ static void econet_set_gdm_port_fwd_cfg(struct econet_gdm_port *port,
 	set_gdm_fwd_cfg_default_fport(&fc, val);
 	/*
 	 * Bit 25 is DROP_OVERSIZE on newer Airoha GDMs, but GDM_UNTAG_EN
-	 * on EN751221. Keep it untouched there so the MTK special tag from
-	 * the companion MT7530 reaches the DSA tagger intact.
+	 * on EN751221. The vendor EN7512 datapath explicitly leaves UNTAG
+	 * disabled when special-tag mode is enabled. Do not preserve the
+	 * reset value here: some bootloaders leave bit 25 set.
 	 */
-	if (!port->qdma->soc->en751221_special_tag)
+	if (port->qdma->soc->en751221_special_tag)
+		fc.word &= ~EN751221_GDM_UNTAG_EN;
+	else
 		set_gdm_fwd_cfg_drop_oversize(&fc, true);
 	econet_wreg(fc, &port->regs->fwd_cfg);
 }
@@ -1378,10 +1383,12 @@ static int econet_dev_open(struct net_device *dev)
 		    port->fport == ETX_FPORT_GDM1) {
 			struct fwd_cfg fc = econet_rreg(&port->regs->fwd_cfg);
 
-			if (dsa)
+			if (dsa) {
+				fc.word &= ~EN751221_GDM_UNTAG_EN;
 				fc.word |= EN751221_GDM_STAG_EN;
-			else
+			} else {
 				fc.word &= ~EN751221_GDM_STAG_EN;
+			}
 			econet_wreg(fc, &port->regs->fwd_cfg);
 
 			/* CDMA_CSG_CFG is at offset 0 from the GDM1 window. */
@@ -1461,9 +1468,10 @@ static netdev_tx_t econet_dev_xmit(struct sk_buff *skb, struct net_device *dev)
 	int qid, ret = 0, len = skb->len;
 	struct netdev_queue *txq;
 	union desc_msg msg = {0};
+	u8 channel;
 
 	qid = skb_get_queue_mapping(skb);
-	set_etx_channel(&msg.etx, qid / ECONET_NUM_QUEUES);
+	channel = qid / ECONET_NUM_QUEUES;
 	set_etx_queue(&msg.etx, qid % ECONET_NUM_QUEUES);
 	set_etx_fport(&msg.etx, port->fport);
 
@@ -1474,12 +1482,31 @@ static netdev_tx_t econet_dev_xmit(struct sk_buff *skb, struct net_device *dev)
 	if (skb_linearize(skb))
 		goto drop;
 
+	/*
+	 * The EN7512 vendor driver derives the LAN QDMA channel from the
+	 * destination bitmap in the in-band MTK special tag. DSA already
+	 * inserted that tag at bytes 12..15. Keeping channel 0 for every
+	 * DSA packet lets QDMA report TX completion while GDMA1 never drives
+	 * the selected companion-switch port.
+	 */
+	if (port->qdma->soc->en751221_special_tag &&
+	    netdev_uses_dsa(dev) && skb_headlen(skb) >= ETH_HLEN + 4) {
+		u16 stag = get_unaligned_be16(skb->data + 2 * ETH_ALEN);
+		u8 port_mask = stag & EN751221_STAG_PORT_MASK;
+
+		if (port_mask)
+			channel = __ffs(port_mask);
+	}
+
+	set_etx_channel(&msg.etx, channel);
+
 	if (port->qdma->soc->en751221_special_tag) {
 		int dump_len = min_t(int, skb_headlen(skb), 32);
 
 		dev_info(port->qdma->dev,
-			 "DBG TX submit: dev=%s len=%d qid=%d fport=%u proto=0x%04x msg=%08x/%08x/%08x/%08x data=%*phN\n",
-			 dev->name, len, qid, port->fport, ntohs(skb->protocol),
+			 "DBG TX submit: dev=%s len=%d qid=%d channel=%u queue=%u fport=%u proto=0x%04x msg=%08x/%08x/%08x/%08x data=%*phN\n",
+			 dev->name, len, qid, get_etx_channel(&msg.etx),
+			 get_etx_queue(&msg.etx), port->fport, ntohs(skb->protocol),
 			 msg.raw[0], msg.raw[1], msg.raw[2], msg.raw[3],
 			 dump_len, skb->data);
 	}
-- 
