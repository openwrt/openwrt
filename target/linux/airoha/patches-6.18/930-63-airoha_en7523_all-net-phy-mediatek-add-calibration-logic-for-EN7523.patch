+static u16 airoha_tx_amp_limit(int val)
+{
+	if (val < 0)
+		return 0;
+	if (val > 0x3f)
+		return 0x3f;
+
+	return val;
+}
+
+static u16 airoha_field_prep(u16 mask, u16 val)
+{
+	return (val << __ffs(mask)) & mask;
+}
