+		if (airoha_xtal_clock(priv) == 25)
+			return SYSPLL_PCW_25M_EN7523;
+		return SYSPLL_PCW_20M_EN7523;
+	case SOC_AN7581:
+		return CPUPLL_SDM_PCW_AN7581;
+	case SOC_AN7583:
+		return CPUPLL_SDM_PCW_AN7583;
+	default:
+		return 0;
