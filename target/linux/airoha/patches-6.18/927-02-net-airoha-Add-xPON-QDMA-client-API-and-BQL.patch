+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * xPON (GPON) client interface of the Airoha ethernet driver.
+ *
+ * The xPON MAC has no DMA engine of its own: upstream frames are queued on
+ * the WAN QDMA and downstream frames arrive on the WAN QDMA RX rings.  The
+ * GEM port travels in the QDMA message word 0.
+ */
+#ifndef __LINUX_SOC_AIROHA_XPON_H
+#define __LINUX_SOC_AIROHA_XPON_H
+
+#include <linux/types.h>
+
+struct net_device;
+struct sk_buff;
+
+/**
+ * struct airoha_xpon_tx_info - QDMA TX message word 0 for an xPON frame
+ * @gem_port: GEM port id (GPON) carried in msg0[29:14]
+ * @channel: QDMA channel, i.e. the T-CONT, msg0[7:3]
+ * @queue: QDMA queue inside @channel, msg0[2:0]
+ * @oam: frame belongs to the OMCI/OAM channel, msg0[8]
+ */
+struct airoha_xpon_tx_info {
+	u16 gem_port;
+	u8 channel;
+	u8 queue;
+	bool oam;
+};
+
+/**
+ * struct airoha_xpon_rx_info - QDMA RX message word 0 of an xPON frame
+ * @gem_port: source GEM port id (GPON) from msg0[29:14]
+ * @channel: QDMA channel, msg0[7:3]
+ * @oam: frame was received on the OMCI/OAM channel, msg0[8]
+ * @crc_err: the MAC flagged a CRC error, msg0[11]
+ */
+struct airoha_xpon_rx_info {
+	u16 gem_port;
+	u8 channel;
+	bool oam;
+	bool crc_err;
+};
+
+/**
+ * struct airoha_xpon_ops - xPON client callbacks
+ * @rx: called from the airoha-eth NAPI context for every downstream frame,
+ *	must not sleep; the callback owns @skb
+ * @priv: opaque pointer handed back to @rx
+ * @tx_dev: net_device the client's data frames are sent from; when set,
+ *	frames without @oam are charged to its TX queue (BQL) and the queue
+ *	is stopped/woken with the QDMA ring
+ * @ppe_downstream: bind downstream flows (entering on @tx_dev) in the PPE
+ */
+struct airoha_xpon_ops {
+	void (*rx)(void *priv, struct sk_buff *skb,
+		   const struct airoha_xpon_rx_info *info);
+	void *priv;
+	struct net_device *tx_dev;
+	bool ppe_downstream;
+};
+
+#define AIROHA_XPON_MAX_CHANNEL		31
+#define AIROHA_XPON_MAX_QUEUE		7
+
+int airoha_xpon_register(struct net_device *netdev,
+			 const struct airoha_xpon_ops *ops);
+void airoha_xpon_unregister(struct net_device *netdev);
+int airoha_xpon_tx(struct sk_buff *skb,
+		   const struct airoha_xpon_tx_info *info);
+
+#endif /* __LINUX_SOC_AIROHA_XPON_H */
