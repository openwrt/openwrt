 		source = agent->config.equipment_id;
 		source_len = strnlen(agent->config.equipment_id,
@@ -4072,6 +4122,11 @@ int omci_agent_config_get(struct omci_device *odev, u16 key,
 		source = &scalar;
 		source_len = sizeof(scalar);
