-#define OMCI_GENL_VERSION	12
+#define OMCI_GENL_VERSION	13
 #define OMCI_MAX_PDU_LEN	1980
 #define OMCI_MAX_ATTR_DATA	64
 #define OMCI_MAX_CONFIG_VALUE	64
@@ -13,6 +13,8 @@
 #define OMCI_OLT_VENDOR_ID_LEN	4
 #define OMCI_OLT_EQUIPMENT_ID_LEN	20
 #define OMCI_OLT_VERSION_LEN	14
+#define OMCI_HARDWARE_VERSION_LEN	14
+#define OMCI_SOFTWARE_VERSION_LEN	14
 
 /**
  * enum omci_cmd - Generic Netlink commands
@@ -278,6 +280,10 @@ enum omci_config_key {
 	OMCI_CONFIG_OLT_PROFILE,
 	OMCI_CONFIG_OLT_PROFILE_FORCE,
 	OMCI_CONFIG_AGENT_DYING_GASP,
+	OMCI_CONFIG_OMCC_VERSION,
+	OMCI_CONFIG_HARDWARE_VERSION,
+	OMCI_CONFIG_SOFTWARE_VERSION_0,
+	OMCI_CONFIG_SOFTWARE_VERSION_1,
 
