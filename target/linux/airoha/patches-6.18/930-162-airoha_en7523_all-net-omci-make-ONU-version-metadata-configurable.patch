diff --git a/net/omci/identity.c b/net/omci/identity.c
index ce6ee3a7ef22..5ed23fb38e3b 100644
--- a/net/omci/identity.c
+++ b/net/omci/identity.c
@@ -288,7 +288,10 @@ int omci_identity_normalize_config(u16 key, const void *value, size_t len,
