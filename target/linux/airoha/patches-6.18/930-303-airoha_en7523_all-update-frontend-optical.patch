From c0f379adf076afd8eb31a1f537b29ffb58e10f30 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Wed, 19 Aug 2026 01:42:43 -0300
Subject: [PATCH] update frontend optical

separates the optical LDDLA from the Airoha xPON for something
independent code and generic.

It continues to have compatibility with the old dts until the optical
migration is complete

                       airoha_xpon
                     /      |       \
                    /       |        \
             Generic PHY   OMCI    MAC state
                    \       |        /
                     \      |       /
                      optical_frontend
                            |
                 +----------+----------+
                 |                     |
             Airoha EN757x        Semtech GN25L95

gn25l95: optical-frontend@51 {
	compatible = "semtech,gn25l95";
	reg = <0x51>;

	#optical-frontend-cells = <0>;

	firmware-name = "semtech/gpt2741-gn25l95-hwconfig.bin";
};

xpon@1fb60000 {
	/* ... */

	phys = <&xpon_phy>;
	phy-names = "xpon";

	optical-frontends = <&gn25l95>;
	optical-frontend-names = "pon";
};

(cherry picked from commit 74f251f43d321b98755388ad699ad02fb18b587c)
Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
