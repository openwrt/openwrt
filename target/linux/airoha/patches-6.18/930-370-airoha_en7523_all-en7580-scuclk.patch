+#define EN7580_PCIE_HB_RST		28
+#define EN7580_SIMIF_RST		29
+#define EN7580_XPON_MAC_RST		30
+#define EN7580_GFAST_RST		31
+#define EN7580_CPU_TIMER2_RST		32
+#define EN7580_UART3_RST		33
+#define EN7580_UART4_RST		34
