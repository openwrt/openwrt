+#define EN7580_FE_QDMA2_RST		 3
+#define EN7580_FE_UNZIP_RST		 4
+#define EN7580_PCM2_RST		 5
+#define EN7580_PTM_MAC_RST		 6
+#define EN7580_CRYPTO_RST		 7
+#define EN7580_SAR_RST		 8
+#define EN7580_TIMER_RST		 9
+#define EN7580_INTC_RST		10
+#define EN7580_BONDING_RST		11
+#define EN7580_PCM1_RST		12
+#define EN7580_UART_RST		13
+#define EN7580_GPIO_RST		14
+#define EN7580_GDMA_RST		15
+#define EN7580_I2C_MASTER_RST		16
+#define EN7580_PCM2_ZSI_ISI_RST	17
+#define EN7580_SFC_RST		18
+#define EN7580_UART2_RST		19
+#define EN7580_GDMP_RST		20
+#define EN7580_FE_RST			21
+#define EN7580_USB_HOST_P0_RST	22
+#define EN7580_GSW_RST		23
+#define EN7580_SFC2_PCM_RST		24
+#define EN7580_PCIE0_RST		25
+#define EN7580_PCIE1_RST		26
