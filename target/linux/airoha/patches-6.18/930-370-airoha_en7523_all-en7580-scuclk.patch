+
+#endif /* _DT_BINDINGS_CLOCK_ECONET_EN7580_SCU_H_ */
diff --git a/include/dt-bindings/reset/econet,en7580-scu.h b/include/dt-bindings/reset/econet,en7580-scu.h
new file mode 100644
index 000000000..c9c3ce9a4
--- /dev/null
+++ b/include/dt-bindings/reset/econet,en7580-scu.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
