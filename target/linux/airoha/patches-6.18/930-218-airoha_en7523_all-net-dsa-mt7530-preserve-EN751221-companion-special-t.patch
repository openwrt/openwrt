From 45249442e1b06c5ec67c04442d5e132600ff6f23 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 11 Aug 2026 14:03:59 -0300
Subject: [PATCH] net: dsa: mt7530: preserve EN751221 companion special tag PVC

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/dsa/mt7530.c | 39 ++++++++++++++++++++++++++++++++-------
 1 file changed, 32 insertions(+), 7 deletions(-)

diff --git a/drivers/net/dsa/mt7530.c b/drivers/net/dsa/mt7530.c
index 04bd5cfbfae6..3d0fc9178955 100644
--- a/drivers/net/dsa/mt7530.c
+++ b/drivers/net/dsa/mt7530.c
@@ -463,6 +463,21 @@ mt7530_setup_port6(struct dsa_switch *ds, phy_interface_t interface)
 #define EN751221_TRGMII_RX_VALUE_MASK	GENMASK(23, 16)
 #define EN751221_TRGMII_RX_ERR_MASK	GENMASK(11, 8)
 #define EN751221_AGC_L2LEN_CHK		BIT(4)
+/* Exact external port-6 PVC value used by the EN7512 vendor SDK. */
+#define EN751221_MCM_P6_PVC		0x81008120
+
+static bool mt7530_is_en751221_mcm(struct mt7530_priv *priv)
+{
+	return priv->mcm && priv->dev->of_node &&
+	       of_device_is_compatible(priv->dev->of_node,
+				       "econet,en751221-switch");
+}
+
+static void mt7530_en751221_mcm_restore_p6_pvc(struct mt7530_priv *priv)
+{
+	if (mt7530_is_en751221_mcm(priv))
+		mt7530_write(priv, MT7530_PVC_P(6), EN751221_MCM_P6_PVC);
+}
 
 static struct mt7530_priv *
 en751221_trgmii_find_ondie_peer(struct dsa_switch *ds)
@@ -656,9 +671,12 @@ static void en751221_trgmii_pair_setup(struct mt7530_priv *ext,
 	mt7530_clear(ondie, MT753X_AGC, EN751221_AGC_L2LEN_CHK);
 
 	/* Port 6 of the companion MT7530 is the actual MTK tag endpoint. */
-	mt7530_rmw(ext, MT7530_PVC_P(6),
-		   VLAN_ATTR_MASK | PORT_SPEC_TAG | PVC_EG_TAG_MASK,
-		   PORT_SPEC_TAG | PVC_EG_TAG(MT7530_VLAN_EG_CONSISTENT));
+	/*
+	 * Keep the vendor port-6 special-tag format intact. Besides
+	 * PORT_SPEC_TAG and consistent egress tagging, bits 31:16 carry the
+	 * 0x8100 special-tag VPID and bit 15 is required by the EN7512 SDK.
+	 */
+	mt7530_en751221_mcm_restore_p6_pvc(ext);
 	mt7530_rmw(ext, MT7530_PCR_P(6), PCR_MATRIX_MASK | PCR_PORT_VLAN_MASK,
 		   PCR_MATRIX(dsa_user_ports(ext->ds)) |
 		   MT7530_PORT_FALLBACK_MODE);
@@ -1870,8 +1888,12 @@ mt7530_port_set_vlan_unaware(struct dsa_switch *ds, int port)
 
 		mt7530_write(priv, MT7530_PCR_P(cpu_dp->index),
 			     PCR_MATRIX(dsa_user_ports(priv->ds)));
-		mt7530_write(priv, MT7530_PVC_P(cpu_dp->index), PORT_SPEC_TAG
-			     | PVC_EG_TAG(MT7530_VLAN_EG_CONSISTENT));
+		if (mt7530_is_en751221_mcm(priv) && cpu_dp->index == 6)
+			mt7530_en751221_mcm_restore_p6_pvc(priv);
+		else
+			mt7530_write(priv, MT7530_PVC_P(cpu_dp->index),
+				     PORT_SPEC_TAG |
+				     PVC_EG_TAG(MT7530_VLAN_EG_CONSISTENT));
 	}
 }
 
@@ -1910,8 +1932,11 @@ mt7530_port_set_vlan_aware(struct dsa_switch *ds, int port)
 		 * are forwarded to user ports as tagged, and untagged as
 		 * untagged.
 		 */
-		mt7530_rmw(priv, MT7530_PVC_P(port), VLAN_ATTR_MASK,
-			   VLAN_ATTR(MT7530_VLAN_USER));
+		if (mt7530_is_en751221_mcm(priv) && port == 6)
+			mt7530_en751221_mcm_restore_p6_pvc(priv);
+		else
+			mt7530_rmw(priv, MT7530_PVC_P(port), VLAN_ATTR_MASK,
+				   VLAN_ATTR(MT7530_VLAN_USER));
 	}
 }
 
