-static int en7512_fe_r50_cal(struct phy_device *phydev)
-{
-	int addr = phydev->mdio.addr;
-	int status, comp, initial, polarity, val;
-	int zcal = 0x20;
-	int i, ret;
-	u8 tx, rx;
-
-	ret = en7512_fe_paged_write_addr(phydev, EN7512_FE_PHY_BASE_ADDR,
-					 EN7512_FE_PAGE_L3, 25, 0xc000);
-	if (ret < 0)
-		return ret;
-	ret = en7512_fe_paged_modify(phydev, EN7512_FE_PAGE_L3, 25,
-				     BIT(12), BIT(12));
-	if (ret < 0)
-		return ret;
-	ret = en7512_fe_paged_write_addr(phydev, EN7512_FE_PHY_BASE_ADDR,
-					 EN7512_FE_PAGE_L3, 26, zcal);
-	if (ret < 0)
-		return ret;
-
-	status = en7512_fe_cal_wait(phydev, 100, false);
-	if (status <= 0) {
-		ret = status < 0 ? status : -ETIMEDOUT;
-		goto fallback;
-	}
-
-	initial = en7512_fe_cal_comp(phydev);
-	if (initial < 0)
-		return initial;
-	polarity = initial ? -1 : 1;
-
-	for (i = 0; i < 254; i++) {
-		zcal += polarity;
-		if (zcal < 0 || zcal > 0x3f) {
-			ret = -ERANGE;
-			goto fallback;
-		}
-
-		ret = en7512_fe_paged_write_addr(phydev,
-						 EN7512_FE_PHY_BASE_ADDR,
-						  EN7512_FE_PAGE_L3, 26, zcal);
-		if (ret < 0)
-			return ret;
-
-		status = en7512_fe_cal_wait(phydev, 100, false);
-		if (status <= 0) {
-			ret = status < 0 ? status : -ETIMEDOUT;
-			goto fallback;
-		}
-
-		comp = en7512_fe_cal_comp(phydev);
-		if (comp < 0)
-			return comp;
-		if (comp != initial)
-			break;
-	}
-
-	if (i == 254) {
-		ret = -ETIMEDOUT;
-		goto fallback;
-	}
-
-	ret = 0;
-	goto store;
-
-fallback:
-	zcal = 0x20;
-store:
-	if (addr == 11) {
-		tx = en7512_fe_r50_code(zcal - 2);
-		rx = en7512_fe_r50_code(zcal - 8);
-	} else {
-		tx = en7512_fe_r50_code(zcal + 2);
-		rx = en7512_fe_r50_code(zcal - 4);
-	}
