-		return ret;
-
-	val = en7512_fe_paged_read_addr(phydev, EN7512_FE_PHY_BASE_ADDR,
-					EN7512_FE_PAGE_L4, 23);
-	if (val < 0)
-		return val;
-
-	ret = en7512_fe_paged_write_addr(phydev, EN7512_FE_PHY_BASE_ADDR,
