-	en7512_fe_paged_modify(phydev, EN7512_FE_PAGE_L0, 30,
-			       0x02c0, 0x02c0);
-	en7512_fe_paged_write(phydev, EN7512_FE_PAGE_G1, 26, 0x8000);
-	en7512_fe_paged_write(phydev, EN7512_FE_PAGE_L4, 17, 0x0000);
