-static int en7512_fe_analog_cal(struct phy_device *phydev)
-{
-	int saved_l0r26, ret = 0, cal_ret, i;
-
-	if (phydev->mdio.addr < EN7512_FE_PHY_BASE_ADDR ||
-	    phydev->mdio.addr > EN7512_FE_PHY_LAST_ADDR)
-		return -ENODEV;
-
-	saved_l0r26 = en7512_fe_paged_read(phydev, EN7512_FE_PAGE_L0, 26);
-	if (saved_l0r26 < 0)
-		return saved_l0r26;
-
-	en7512_fe_paged_write(phydev, EN7512_FE_PAGE_G2, 25, 0x10c0);
-	en7512_fe_paged_write(phydev, EN7512_FE_PAGE_L0, 26, 0x5603);
-	en7512_fe_paged_write(phydev, EN7512_FE_PAGE_L4, 21, 0x0000);
-	en7512_fe_paged_write(phydev, EN7512_FE_PAGE_L0, 0, 0x2100);
-
-	for (i = 0; i < 3; i++) {
-		cal_ret = en7512_fe_r50_cal(phydev);
-		if (!cal_ret)
-			break;
-	}
-	if (cal_ret)
-		ret = cal_ret;
-
-	for (i = 0; i < 3; i++) {
-		cal_ret = en7512_fe_tx_offset_cal(phydev);
-		if (!cal_ret)
-			break;
-	}
-	if (!ret && cal_ret)
-		ret = cal_ret;
-
-	for (i = 0; i < 3; i++) {
-		cal_ret = en7512_fe_tx_amp_cal(phydev, 30000);
-		if (!cal_ret)
-			break;
-	}
-	/* Vendor SDK runs one final fast TX amplitude pass. */
-	cal_ret = en7512_fe_tx_amp_cal(phydev, 100);
-	if (!ret && cal_ret)
-		ret = cal_ret;
-
-	en7512_fe_paged_write(phydev, EN7512_FE_PAGE_G1, 26, 0x0000);
-	en7512_fe_paged_write(phydev, EN7512_FE_PAGE_L0, 26, saved_l0r26);
-	en7512_fe_paged_write(phydev, EN7512_FE_PAGE_L2, 22, 0x4444);
-	en7512_fe_paged_write(phydev, EN7512_FE_PAGE_L0, 0, 0x3100);
-	en7512_fe_paged_write(phydev, EN7512_FE_PAGE_L0, 30, 0x0d08);
-
-	if (ret)
-		phydev_warn(phydev, "EN7512 FE analog calibration completed with fallback: %d\n",
-			    ret);
