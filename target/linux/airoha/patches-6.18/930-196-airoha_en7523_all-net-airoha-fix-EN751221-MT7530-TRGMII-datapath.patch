-	en7512_fe_paged_write_addr(phydev, EN7512_FE_PHY_BASE_ADDR,
-				   EN7512_FE_PAGE_L3, 25, 0x0000);
-	en7512_fe_paged_write(phydev, EN7512_FE_PAGE_L3, 25, 0x0000);
