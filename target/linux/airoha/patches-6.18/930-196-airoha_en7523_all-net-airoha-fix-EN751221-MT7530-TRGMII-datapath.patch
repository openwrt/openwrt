-	for (i = 0; i < 1000; i++) {
-		if (delay_us >= 1000)
-			usleep_range(delay_us, delay_us + 100);
-		else
-			udelay(delay_us);
-
-		val = en7512_fe_paged_read_addr(phydev,
-						EN7512_FE_PHY_BASE_ADDR,
-						 EN7512_FE_PAGE_L4, 23);
-		if (val < 0)
-			return val;
-		if (val & BIT(6))
