-		return status < 0 ? status : -ETIMEDOUT;
-
-	initial = en7512_fe_cal_comp(phydev);
-	if (initial < 0)
-		return initial;
-	polarity = initial ? -1 : 1;
-	crossings = port == 0 ? 1 : 0;
-
-	for (i = 0; i < 254; i++) {
-		ret = en7512_fe_paged_write(phydev, EN7512_FE_PAGE_L4, 17,
