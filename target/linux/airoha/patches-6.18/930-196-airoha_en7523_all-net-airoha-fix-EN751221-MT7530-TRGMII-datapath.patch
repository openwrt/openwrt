-	for (i = 0; i < ARRAY_SIZE(en7512_fe_global_regs); i++) {
-		ret = en7512_fe_paged_write(phydev,
-					    en7512_fe_global_regs[i].page,
-					    en7512_fe_global_regs[i].reg,
