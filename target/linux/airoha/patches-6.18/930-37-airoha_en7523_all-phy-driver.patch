diff --git a/Documentation/devicetree/bindings/phy/airoha,en7523-xpon-phy.yaml b/Documentation/devicetree/bindings/phy/airoha,en7523-xpon-phy.yaml
new file mode 100644
index 000000000000..064228d51fa4
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/airoha,en7523-xpon-phy.yaml
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/airoha,en7523-xpon-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha EN7523 GPON and EPON PHY
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+description: |
+  The EN7523 family contains a digital xPON PHY shared by the GPON and EPON
+  MAC engines. The PHY controls the receiver CDR, delimiter detection and
+  SerDes interface between the optical analogue front end and the xPON MAC.
+
+properties:
+  compatible:
+    const: airoha,en7523-xpon-phy
+
+  reg:
+    maxItems: 1
+
+  resets:
+    maxItems: 1
+
+  reset-names:
+    const: phy
+
+  airoha,scu:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the EN7523 SCU syscon used for WAN mode and PON pin muxing.
+
+  '#phy-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - resets
+  - reset-names
+  - airoha,scu
+  - '#phy-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/reset/airoha,en7523-reset.h>
+
+    phy@1faf0000 {
+        compatible = "airoha,en7523-xpon-phy";
+        reg = <0x1faf0000 0x5000>;
+        resets = <&scuclk EN7523_XPON_PHY_RST>;
+        reset-names = "phy";
+        airoha,scu = <&scuclk>;
+        #phy-cells = <0>;
+    };
+...
