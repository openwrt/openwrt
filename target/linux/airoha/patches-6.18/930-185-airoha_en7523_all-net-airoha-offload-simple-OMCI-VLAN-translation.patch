+}
+
+static int
+airoha_eth_xpon_rewrite_tx_vlan(struct sk_buff *skb,
+				const struct airoha_xpon_tx_info *info)
+{
+	u16 tci;
+
+	if (!info->vlan_translate)
+		return 0;
+
+	if (skb_vlan_tag_present(skb)) {
+		tci = skb_vlan_tag_get(skb);
+		if ((tci & VLAN_VID_MASK) != info->customer_vlan_id)
+			return -EINVAL;
+		tci = (tci & ~VLAN_VID_MASK) | info->network_vlan_id;
+		__vlan_hwaccel_put_tag(skb, skb->vlan_proto, tci);
+		return 0;
+	}
+
+	if (!pskb_may_pull(skb, sizeof(struct vlan_ethhdr)) ||
+	    skb_cow_head(skb, 0))
+		return -ENOMEM;
+
+	if (eth_type_vlan(((struct vlan_ethhdr *)skb->data)->h_vlan_proto)) {
+		struct vlan_ethhdr *vlan_hdr = (void *)skb->data;
+
+		tci = ntohs(vlan_hdr->h_vlan_TCI);
+		if ((tci & VLAN_VID_MASK) != info->customer_vlan_id)
+			return -EINVAL;
+		vlan_hdr->h_vlan_TCI = htons((tci & ~VLAN_VID_MASK) |
+					      info->network_vlan_id);
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int
+airoha_eth_xpon_translate_rx(struct airoha_gdm_dev *dev, struct sk_buff *skb,
+			     u16 gem_port_id)
+{
+	struct vlan_ethhdr *vlan_hdr;
+	u16 customer_vid = 0, tci;
+	u8 pcp;
+	int i;
+
+	if (!pskb_may_pull(skb, sizeof(*vlan_hdr)))
+		return -EINVAL;
+	vlan_hdr = (void *)skb->data;
+	if (!eth_type_vlan(vlan_hdr->h_vlan_proto))
+		return 0;
+
+	tci = ntohs(vlan_hdr->h_vlan_TCI);
+	pcp = (tci & VLAN_PRIO_MASK) >> VLAN_PRIO_SHIFT;
+
+	spin_lock_bh(&dev->xpon_service_lock);
+	for (i = 0; i < AIROHA_XPON_MAX_SERVICES; i++) {
+		const struct airoha_xpon_service_cfg *service;
+
+		service = &dev->xpon_services[i];
+		if (!service->valid || !service->vlan_translate ||
+		    !service->downstream_inverse ||
+		    service->gem_port_id != gem_port_id ||
+		    !service->vlan_valid || !service->customer_vlan_valid ||
+		    service->vlan_id != (tci & VLAN_VID_MASK) ||
+		    (service->customer_vlan_proto_valid &&
+		     service->customer_vlan_proto != vlan_hdr->h_vlan_proto) ||
+		    (service->pcp_valid && service->pcp != pcp))
+			continue;
+
+		customer_vid = service->customer_vlan_id;
+		break;
+	}
+	spin_unlock_bh(&dev->xpon_service_lock);
+
+	if (!customer_vid)
+		return 0;
+	if (skb_cow_head(skb, 0))
+		return -ENOMEM;
+
+	vlan_hdr = (void *)skb->data;
+	vlan_hdr->h_vlan_TCI = htons((tci & ~VLAN_VID_MASK) | customer_vid);
+
+	return 0;
 }
 
