+}
+
+static int
+airoha_ppe_xpon_translate_vlan(struct airoha_flow_data *data,
+			       const struct airoha_xpon_tx_info *info)
+{
+	int i;
+
+	if (!info->vlan_translate)
+		return 0;
+
+	/*
+	 * netfilter describes the VLAN emitted by the local/customer-side
+	 * VLAN device.  Replace that VID before the FOE L2 words are built so
+	 * hardware forwarding emits the same ANI/network-side tag as the CPU
+	 * transmit path.
+	 */
+	for (i = data->vlan.num - 1; i >= 0; i--) {
+		if (data->vlan.hdr[i].id != info->customer_vlan_id)
+			continue;
+
+		data->vlan.hdr[i].id = info->network_vlan_id;
+		return 0;
+	}
+
+	return -EINVAL;
 }
 
