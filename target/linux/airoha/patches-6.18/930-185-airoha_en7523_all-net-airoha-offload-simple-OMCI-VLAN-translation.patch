 				 port->id, dev->nbq, dsa_port, val,
 				 FIELD_GET(AIROHA_FOE_IB2_NBQ, val), xpon_flow,
-				 xpon.gem_port_id, channel, priority);
+				 xpon.gem_port_id, channel, priority,
+				 xpon.customer_vlan_id, xpon.network_vlan_id,
+				 xpon.vlan_translate);
 		}
 	}
 
