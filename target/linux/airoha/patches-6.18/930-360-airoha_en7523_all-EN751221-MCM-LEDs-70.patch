+				      MTK_GPHY_LED_ON_SET,
+				      MTK_GPHY_LED_RX_BLINK_SET,
+				      MTK_GPHY_LED_TX_BLINK_SET);
+	if (ret)
+		return ret;
+	return mt7530_phy_led_set_phy_mode(phydev, index);
