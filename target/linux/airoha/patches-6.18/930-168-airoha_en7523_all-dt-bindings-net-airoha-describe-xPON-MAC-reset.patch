From 1671432f2250ad586bbad223109a6d33b2db4de8 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Thu, 30 Jul 2026 16:58:15 +0000
Subject: [PATCH 168/183] dt-bindings: net: airoha: describe xPON MAC reset

Describe the shared xPON MAC reset line and require it for the unified
EN7523 binding. The MAC reset is pulsed before each optical session so
protocol table state cannot leak across GPON or EPON restarts.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 .../bindings/net/airoha,en7523-xpon.yaml          | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml b/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
index debcc59ed474..0a66a44ed97a 100644
--- a/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
+++ b/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
@@ -53,6 +53,16 @@ properties:
       - const: mac
       - const: dying-gasp
 
+  resets:
+    maxItems: 1
+    description:
+      Reset line for the shared xPON MAC register and table state. The driver
+      pulses this reset before every GPON or EPON session start so no T-CONT,
+      GEM, OMCC, encryption or activation state leaks between sessions.
+
+  reset-names:
+    const: mac
+
   ethernet:
     $ref: /schemas/types.yaml#/definitions/phandle
     description:
@@ -130,6 +140,8 @@ allOf:
       required:
         - phys
         - phy-names
+        - resets
+        - reset-names
       properties:
         airoha,pon-mode: true
     else:
@@ -141,6 +153,7 @@ additionalProperties: true
 examples:
   - |
     #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/reset/airoha,en7523-reset.h>
 
     pon0: sfp {
         compatible = "sff,sfp";
@@ -153,6 +166,8 @@ examples:
         reg-names = "mac";
         interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
         interrupt-names = "mac";
+        resets = <&scuclk EN7523_XPON_MAC_RST>;
+        reset-names = "mac";
         airoha,scu = <&scuclk>;
         airoha,pon-mode = "gpon";
         airoha,gpon-serial-number = [49 4e 56 50 71 43 86 02];
-- 
