+	ret = airoha_9491_phy_calib(phydev);
+	en7580_phy_set_calibration_gating(phydev, false);
+	if (ret)
+		return ret;
+
+	phy_write(phydev, MII_BMCR, BMCR_ANENABLE | BMCR_ANRESTART);
+
+	return 0;
+}
