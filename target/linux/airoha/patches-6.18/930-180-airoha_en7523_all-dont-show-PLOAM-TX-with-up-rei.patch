---
 drivers/net/ethernet/airoha/airoha_xpon.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_xpon.c b/drivers/net/ethernet/airoha/airoha_xpon.c
index dcd2bac65b09..0f8fdd5f70e3 100644
