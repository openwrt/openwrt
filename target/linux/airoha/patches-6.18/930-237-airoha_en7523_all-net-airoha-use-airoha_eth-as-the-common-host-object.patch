From 82d9075952670229defb6e6e54d5003d58f28d34 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 11 Aug 2026 14:04:36 -0300
Subject: [PATCH] net: airoha: use airoha_eth as the common host object

Allocate struct airoha_eth in the shared platform driver and pass it to both generation backends. Remove the tiny EcoNet host wrapper, keep EN751221 state in generation-private storage, map the common FE/GDMP resources into the shared host, and expose the common PPE device through ppe_dev. This makes GDM, xPON and offload code able to retain one host type across both generations.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c      |  28 +-
 drivers/net/ethernet/airoha/airoha_eth.h      |  10 +-
 drivers/net/ethernet/airoha/airoha_eth_gen1.c | 241 ++++++++----------
 drivers/net/ethernet/airoha/airoha_eth_gen1.h |  12 +-
 drivers/net/ethernet/airoha/airoha_eth_gen2.c |  20 +-
 5 files changed, 149 insertions(+), 162 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index f1e9ef733933..b30f5347d7aa 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -2,28 +2,46 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/slab.h>
 
 #include "airoha_eth.h"
 
 static int airoha_eth_probe(struct platform_device *pdev)
 {
 	const struct airoha_eth_soc_data *soc;
+	struct airoha_eth *eth;
+	int err;
 
 	soc = of_device_get_match_data(&pdev->dev);
 	if (!soc || !soc->eth_ops || !soc->eth_ops->probe)
 		return dev_err_probe(&pdev->dev, -EINVAL,
 				     "missing Ethernet backend data\n");
 
-	return soc->eth_ops->probe(pdev);
+	eth = devm_kzalloc(&pdev->dev, sizeof(*eth), GFP_KERNEL);
+	if (!eth)
+		return -ENOMEM;
+
+	eth->dev = &pdev->dev;
+	eth->soc = soc;
+	platform_set_drvdata(pdev, eth);
+
+	err = soc->eth_ops->probe(pdev, eth);
+	if (err)
+		platform_set_drvdata(pdev, NULL);
+
+	return err;
 }
 
 static void airoha_eth_remove(struct platform_device *pdev)
 {
-	const struct airoha_eth_soc_data *soc;
+	struct airoha_eth *eth = platform_get_drvdata(pdev);
 
-	soc = of_device_get_match_data(&pdev->dev);
-	if (soc && soc->eth_ops && soc->eth_ops->remove)
-		soc->eth_ops->remove(pdev);
+	if (!eth || !eth->soc || !eth->soc->eth_ops ||
+	    !eth->soc->eth_ops->remove)
+		return;
+
+	eth->soc->eth_ops->remove(pdev, eth);
+	platform_set_drvdata(pdev, NULL);
 }
 
