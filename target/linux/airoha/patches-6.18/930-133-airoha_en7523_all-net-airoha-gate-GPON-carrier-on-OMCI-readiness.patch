diff --git a/include/uapi/linux/omci.h b/include/uapi/linux/omci.h
index ae56259b0b50..512befacbac3 100644
--- a/include/uapi/linux/omci.h
+++ b/include/uapi/linux/omci.h
@@ -3,7 +3,7 @@
 #define _UAPI_LINUX_OMCI_H
 
 #define OMCI_GENL_NAME		"omci"
-#define OMCI_GENL_VERSION	9
+#define OMCI_GENL_VERSION	10
 #define OMCI_MAX_PDU_LEN	1980
 #define OMCI_MAX_ATTR_DATA	32
 #define OMCI_MAX_CONFIG_VALUE	64
@@ -107,6 +107,7 @@ enum omci_attr {
 	OMCI_ATTR_OLT_PROFILE_EFFECTIVE,
 	OMCI_ATTR_OLT_PROFILE_FORCED,
