From eb91129ef8fccd1843e1e9961c7b9fb47baee157 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Mon, 8 Jun 2026 10:15:45 -0300
Subject: [PATCH] pse-pd: add PoE controller for Mikrotik devices

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/pse-pd/Kconfig             |   5 +
 drivers/net/pse-pd/Makefile            |   1 +
 drivers/net/pse-pd/mikrotik_gpio_pse.c | 284 +++++++++++++++++++++++++
 3 files changed, 290 insertions(+)
 create mode 100644 drivers/net/pse-pd/mikrotik_gpio_pse.c

diff --git a/drivers/net/pse-pd/Kconfig b/drivers/net/pse-pd/Kconfig
index 7ef29657ee5d..360332f87d7a 100644
--- a/drivers/net/pse-pd/Kconfig
+++ b/drivers/net/pse-pd/Kconfig
@@ -20,6 +20,11 @@ config PSE_REGULATOR
 	  Sourcing Equipment without automatic classification support. For
 	  example for basic implementation of PoDL (802.3bu) specification.
 
+config PSE_MIKROTIK_GPIO
+	tristate "Mikrotik Simples GPIO PoE controller"
+	depends on GPIOLIB
+	depends on OF || COMPILE_TEST
+
 config PSE_PD692X0
 	tristate "PD692X0 PSE controller"
 	depends on I2C
diff --git a/drivers/net/pse-pd/Makefile b/drivers/net/pse-pd/Makefile
index cc78f7ea7f5f..3be336a35cd1 100644
--- a/drivers/net/pse-pd/Makefile
+++ b/drivers/net/pse-pd/Makefile
@@ -4,6 +4,7 @@
 obj-$(CONFIG_PSE_CONTROLLER) += pse_core.o
 
 obj-$(CONFIG_PSE_REGULATOR) += pse_regulator.o
+obj-$(CONFIG_PSE_MIKROTIK_GPIO) += mikrotik_gpio_pse.o
 obj-$(CONFIG_PSE_PD692X0) += pd692x0.o
 obj-$(CONFIG_PSE_SI3474) += si3474.o
 obj-$(CONFIG_PSE_TPS23881) += tps23881.o
diff --git a/drivers/net/pse-pd/mikrotik_gpio_pse.c b/drivers/net/pse-pd/mikrotik_gpio_pse.c
new file mode 100644
index 000000000000..525fa4e10a43
--- /dev/null
+++ b/drivers/net/pse-pd/mikrotik_gpio_pse.c
@@ -0,0 +1,284 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MikroTik GPIO controlled PoE PSE controller.
+ *
+ * Some MikroTik devices implement passive PoE-out/PSE control using discrete
+ * GPIOs rather than a dedicated PSE controller. Each real PSE PI is controlled
+ * by one enable GPIO.
+ *
+ * Optional GPIOs can be provided per PI:
+ * - status-gpios: input reporting whether PoE power is being delivered.
+ * - leds-status-gpios: output driving the corresponding PoE status LED.
+ *
+ * When status-gpios is absent, the requested enable state is used as the PSE
+ * power status. The optional status LED follows the requested admin state.
+ */
+
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pse-pd/pse.h>
+
+struct mikrotik_gpio_pse {
+	struct device *dev;
+	struct pse_controller_dev pcdev;
+
+	struct gpio_descs *enable_gpios;
+	struct gpio_descs *status_gpios;
+	struct gpio_descs *leds_status_gpios;
+
+	/*
+	 * Number of real hardware-controlled PSE PIs.
+	 *
+	 * Keep this separate from pcdev.nr_lines. Some PSE core versions use
+	 * pcdev.nr_lines as the notification kfifo allocation size, and kfifo
+	 * rejects sizes smaller than 2. For a single-port controller, pcdev may
+	 * therefore need a minimum value of 2, while this field must remain 1.
+	 */
+	unsigned int nr_lines;
+};
+
+static struct mikrotik_gpio_pse *
+to_mikrotik_gpio_pse(struct pse_controller_dev *pcdev)
+{
+	return container_of(pcdev, struct mikrotik_gpio_pse, pcdev);
+}
+
+static int mikrotik_gpio_pse_validate_id(struct mikrotik_gpio_pse *priv,
+					 int id)
+{
+	if (id < 0 || id >= priv->nr_lines)
+		return -EINVAL;
+
+	return 0;
+}
+
+static void mikrotik_gpio_pse_set_status_led(struct mikrotik_gpio_pse *priv,
+					     int id, bool enabled)
+{
+	if (!priv->leds_status_gpios)
+		return;
+
+	gpiod_set_value_cansleep(priv->leds_status_gpios->desc[id], enabled);
+}
+
+static int
+mikrotik_gpio_pse_pi_get_admin_state(struct pse_controller_dev *pcdev, int id,
+				     struct pse_admin_state *admin_state)
+{
+	struct mikrotik_gpio_pse *priv = to_mikrotik_gpio_pse(pcdev);
+	int ret;
+
+	ret = mikrotik_gpio_pse_validate_id(priv, id);
+	if (ret)
+		return ret;
+
+	/*
+	 * Admin state is the requested/configured state, not the power-good
+	 * status. Read the enable GPIO, not status-gpios.
+	 */
+	ret = gpiod_get_value_cansleep(priv->enable_gpios->desc[id]);
+	if (ret < 0)
+		return ret;
+
+	admin_state->c33_admin_state = ret ?
+		ETHTOOL_C33_PSE_ADMIN_STATE_ENABLED :
+		ETHTOOL_C33_PSE_ADMIN_STATE_DISABLED;
+
+	return 0;
+}
+
+static int
+mikrotik_gpio_pse_pi_get_pw_status(struct pse_controller_dev *pcdev, int id,
+				   struct pse_pw_status *pw_status)
+{
+	struct mikrotik_gpio_pse *priv = to_mikrotik_gpio_pse(pcdev);
+	int ret;
+
+	ret = mikrotik_gpio_pse_validate_id(priv, id);
+	if (ret)
+		return ret;
+
+	if (priv->status_gpios) {
+		ret = gpiod_get_value_cansleep(priv->status_gpios->desc[id]);
+		if (ret < 0)
+			return ret;
+	} else {
+		/*
+		 * status-gpios is optional. Without a real power-good/status
+		 * GPIO, report the requested software/admin state.
+		 */
+		ret = gpiod_get_value_cansleep(priv->enable_gpios->desc[id]);
+		if (ret < 0)
+			return ret;
+	}
+
+	pw_status->c33_pw_status = ret ?
+		ETHTOOL_C33_PSE_PW_D_STATUS_DELIVERING :
+		ETHTOOL_C33_PSE_PW_D_STATUS_DISABLED;
+
+	return 0;
+}
+
+static int mikrotik_gpio_pse_pi_enable(struct pse_controller_dev *pcdev, int id)
+{
+	struct mikrotik_gpio_pse *priv = to_mikrotik_gpio_pse(pcdev);
+	int ret;
+
+	ret = mikrotik_gpio_pse_validate_id(priv, id);
+	if (ret)
+		return ret;
+
+	gpiod_set_value_cansleep(priv->enable_gpios->desc[id], 1);
+	mikrotik_gpio_pse_set_status_led(priv, id, true);
+
+	return 0;
+}
+
+static int mikrotik_gpio_pse_pi_disable(struct pse_controller_dev *pcdev,
+					int id)
+{
+	struct mikrotik_gpio_pse *priv = to_mikrotik_gpio_pse(pcdev);
+	int ret;
+
+	ret = mikrotik_gpio_pse_validate_id(priv, id);
+	if (ret)
+		return ret;
+
+	gpiod_set_value_cansleep(priv->enable_gpios->desc[id], 0);
+	mikrotik_gpio_pse_set_status_led(priv, id, false);
+
+	return 0;
+}
+
+static const struct pse_controller_ops mikrotik_gpio_pse_ops = {
+	.pi_get_admin_state = mikrotik_gpio_pse_pi_get_admin_state,
+	.pi_get_pw_status = mikrotik_gpio_pse_pi_get_pw_status,
+	.pi_enable = mikrotik_gpio_pse_pi_enable,
+	.pi_disable = mikrotik_gpio_pse_pi_disable,
+};
+
+static int mikrotik_gpio_pse_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mikrotik_gpio_pse *priv;
+	unsigned int pcdev_nr_lines;
+	int err;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = dev;
+
+	/*
+	 * Required DeviceTree property:
+	 *
+	 *   enable-gpios = <...>, <...>;
+	 */
+	priv->enable_gpios = devm_gpiod_get_array(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->enable_gpios))
+		return dev_err_probe(dev, PTR_ERR(priv->enable_gpios),
+				     "failed to get enable GPIOs\n");
+
+	priv->nr_lines = priv->enable_gpios->ndescs;
+	if (!priv->nr_lines)
+		return dev_err_probe(dev, -EINVAL, "no enable GPIOs defined\n");
+
+	/*
+	 * Optional power-good/status inputs, one per real PSE PI:
+	 *
+	 *   status-gpios = <...>, <...>;
+	 */
+	priv->status_gpios = devm_gpiod_get_array_optional(dev, "status",
+							   GPIOD_IN);
+	if (IS_ERR(priv->status_gpios))
+		return dev_err_probe(dev, PTR_ERR(priv->status_gpios),
+				     "failed to get status GPIOs\n");
+
+	if (!priv->status_gpios) {
+		dev_info(dev,
+			 "no status GPIOs defined, using enable state as power status\n");
+	} else if (priv->status_gpios->ndescs != priv->nr_lines) {
+		return dev_err_probe(dev, -EINVAL,
+				     "status GPIO count must match enable GPIO count\n");
+	}
+
+	/*
+	 * Optional PoE status LED outputs, one per real PSE PI:
+	 *
+	 *   leds-status-gpios = <...>, <...>;
+	 *
+	 * The LED follows the requested PSE admin state. GPIO polarity is
+	 * described by the GPIO flags in DeviceTree.
+	 */
+	priv->leds_status_gpios =
+		devm_gpiod_get_array_optional(dev, "leds-status", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->leds_status_gpios))
+		return dev_err_probe(dev, PTR_ERR(priv->leds_status_gpios),
+				     "failed to get PoE status LED GPIOs\n");
+
+	if (priv->leds_status_gpios &&
+	    priv->leds_status_gpios->ndescs != priv->nr_lines)
+		return dev_err_probe(dev, -EINVAL,
+				     "PoE status LED GPIO count must match enable GPIO count\n");
+
+	priv->pcdev.dev = dev;
+	priv->pcdev.owner = THIS_MODULE;
+	priv->pcdev.types = ETHTOOL_PSE_C33;
+	priv->pcdev.ops = &mikrotik_gpio_pse_ops;
+
+	/*
+	 * Driver-local workaround for PSE core versions that allocate the
+	 * notification kfifo with pcdev.nr_lines directly. kfifo rejects sizes
+	 * smaller than 2, so a real single-port controller would otherwise fail
+	 * registration with -EINVAL.
+	 *
+	 * Do not change priv->nr_lines: callbacks must validate against the
+	 * real GPIO-backed PI count to avoid exposing/indexing a fake GPIO line.
+	 */
+	pcdev_nr_lines = max_t(unsigned int, priv->nr_lines, 2);
+	priv->pcdev.nr_lines = pcdev_nr_lines;
+
+	if (pcdev_nr_lines != priv->nr_lines)
+		dev_warn(dev,
+			 "using pcdev.nr_lines=%u for PSE core FIFO workaround, real PIs=%u\n",
+			 pcdev_nr_lines, priv->nr_lines);
+
+	/*
+	 * GPIO-controlled passive PoE cannot dynamically measure/enforce a
+	 * per-port power budget.
+	 */
+	priv->pcdev.supp_budget_eval_strategies =
+		PSE_BUDGET_EVAL_STRAT_DISABLED;
+
+	platform_set_drvdata(pdev, priv);
+	err = devm_pse_controller_register(dev, &priv->pcdev);
+	if (err)
+		return dev_err_probe(dev, err,
+				     "failed to register PSE controller\n");
+
+	return 0;
+}
+
+static const struct of_device_id mikrotik_gpio_pse_of_match[] = {
+	{ .compatible = "mikrotik,gpio-poe" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mikrotik_gpio_pse_of_match);
+
+static struct platform_driver mikrotik_gpio_pse_driver = {
+	.probe = mikrotik_gpio_pse_probe,
+	.driver = {
+		.name = "mikrotik-gpio-pse",
+		.of_match_table = mikrotik_gpio_pse_of_match,
+	},
+};
+module_platform_driver(mikrotik_gpio_pse_driver);
+
+MODULE_AUTHOR("Matheus Sampaio Queiroga <srherobrine20@gmail.com>");
+MODULE_DESCRIPTION("MikroTik GPIO PoE PSE controller driver");
+MODULE_LICENSE("GPL");
-- 
2.55.0

