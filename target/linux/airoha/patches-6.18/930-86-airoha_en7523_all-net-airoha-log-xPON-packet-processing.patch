From 65381d30ab7a70bf89d88bc5d5aab7fe3db410b8 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Fri, 17 Jul 2026 17:51:13 +0000
Subject: [PATCH] net: airoha: log xPON packet processing

Add rate-limited logs when the Airoha Ethernet driver processes
packets on an xPON-managed GDM device.

The RX log reports the ring, packet type, complete skb length,
descriptor length, protocol, T-CONT channel, GEM port, source port
and raw descriptor messages. The TX log reports the selected QDMA
ring, packet type, T-CONT, GEM port, queue, forwarding port and
descriptor messages.

Keep the logs rate limited so they remain usable while testing data
traffic.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c | 29 ++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 94a54947d199..a8c970b52553 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -1487,6 +1487,27 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 		if (FIELD_GET(QDMA_DESC_MORE_MASK, desc_ctrl))
 			continue;
 
+		if (airoha_is(eth, en7523) &&
+		    (dev->flags & AIROHA_PRIV_F_XPON_MANAGED)) {
+			u32 msg2 = le32_to_cpu(READ_ONCE(desc->msg2));
+			u32 msg3 = le32_to_cpu(READ_ONCE(desc->msg3));
+			unsigned int channel, gem_port_id, sport;
+
+			msg1 = le32_to_cpu(READ_ONCE(desc->msg1));
+			channel = FIELD_GET(EN7523_QDMA_ETH_RXMSG_CHAN_MASK, msg0);
+			gem_port_id = FIELD_GET(EN7523_QDMA_ETH_RXMSG_GEM_MASK, msg0);
+			sport = FIELD_GET(EN7523_QDMA_ETH_RXMSG_SPORT_MASK, msg1);
+			dev_info_ratelimited(&netdev->dev,
+					     "xPON RX packet: ring=%td type=%s skb-len=%u desc-len=%d protocol=%#06x channel=%u gem=%u sport=%u no-mic=%u msg=%#010x/%#010x/%#010x/%#010x\n",
+					     q - &q->qdma->q_rx[0],
+					     xpon_oam ? "oam" : "data",
+					     q->skb->len, len,
+					     ntohs(q->skb->protocol), channel,
+					     gem_port_id, sport,
+					     !!(msg0 & EN7523_QDMA_ETH_RXMSG_NO_MIC_MASK),
+					     msg0, msg1, msg2, msg3);
+		}
+
 		if (airoha_is(eth, en7523)) {
 			struct airoha_xpon_oam_handler *handler;
 
@@ -3448,6 +3469,14 @@ static netdev_tx_t __airoha_dev_xmit(struct sk_buff *skb,
 	       FIELD_PREP(QDMA_ETH_TXMSG_FPORT_MASK, fport) |
 	       FIELD_PREP(QDMA_ETH_TXMSG_METER_MASK, 0x7f);
 
+	if (xpon)
+		dev_info_ratelimited(&netdev->dev,
+				     "xPON TX packet: qdma=%td ring=%d type=%s len=%u tcont=%u gem=%u queue=%u fport=%u msg=%#010x/%#010x\n",
+				     qdma - &dev->eth->qdma[0], qid,
+				     xpon->oam ? "oam" : "data", skb->len,
+				     xpon->tcont, xpon->gem_port_id,
+				     xpon->queue, fport, msg0, msg1);
+
 	q = &qdma->q_tx[qid];
 	if (WARN_ON_ONCE(!q->ndesc))
 		goto error;
-- 
