From 0bad0287690d276065f8302de24e08c6c242b6d8 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 11 Aug 2026 14:04:08 -0300
Subject: [PATCH] net: dsa: mtk: pass tags through upstream switches

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 net/dsa/tag_mtk.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/net/dsa/tag_mtk.c b/net/dsa/tag_mtk.c
index bf5a99d8037c..cb85c98f675c 100644
--- a/net/dsa/tag_mtk.c
+++ b/net/dsa/tag_mtk.c
@@ -19,6 +19,7 @@
 #define MTK_HDR_RECV_SOURCE_PORT_MASK	GENMASK(2, 0)
 #define MTK_HDR_XMIT_DP_BIT_MASK	GENMASK(5, 0)
 #define MTK_HDR_XMIT_SA_DIS		BIT(6)
+#define MTK_HDR_XMIT_PASSTHROUGH	BIT(7)
 
 static struct sk_buff *mtk_tag_xmit(struct sk_buff *skb,
 				    struct net_device *dev)
@@ -63,6 +64,12 @@ static struct sk_buff *mtk_tag_xmit(struct sk_buff *skb,
 	mtk_tag[0] = xmit_tpid;
 	mtk_tag[1] = (1 << dp->index) & MTK_HDR_XMIT_DP_BIT_MASK;
 
+	/* Downstream switches need the tag to pass through the upstream
+	 * switch instead of being consumed as a local destination bitmap.
+	 */
+	if (dp->ds->index)
+		mtk_tag[1] |= MTK_HDR_XMIT_PASSTHROUGH;
+
 	/* Tag control information is kept for 802.1Q */
 	if (xmit_tpid == MTK_HDR_XMIT_UNTAGGED) {
 		mtk_tag[2] = 0;
-- 
