From bf2ab8cef924e998974fde46bb9e2c7733a1775e Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Mon, 24 Aug 2026 23:40:11 -0300
Subject: [PATCH] spi: airoha: Add support for EN751221 SoC

Extend the Airoha SPI driver to support the EcoNet EN751221 SoC by
introducing SoC-specific configuration data. This includes handling
platform-specific differences such as NFI availability, dual chip-select
requirements, and the lack of an NFI2SPI engine on older models.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 arch/mips/boot/dts/econet/en751221.dtsi |  12 +-
 drivers/clk/clk-en7523.c                |  11 +-
 drivers/spi/Kconfig                     |   6 +-
 drivers/spi/spi-airoha-snfi.c           | 409 +++++++++++++++++++-----
 4 files changed, 346 insertions(+), 92 deletions(-)

diff --git a/arch/mips/boot/dts/econet/en751221.dtsi b/arch/mips/boot/dts/econet/en751221.dtsi
index c64f3014dc7f..a413d4887ffe 100644
--- a/arch/mips/boot/dts/econet/en751221.dtsi
+++ b/arch/mips/boot/dts/econet/en751221.dtsi
@@ -41,17 +41,21 @@ cpuintc: interrupt-controller {
 		#interrupt-cells = <1>;
 	};
 
-	spi_ctrl: spi_controller@1fa10000 {
-		compatible = "airoha,en7523-spi";
+	spi_ctrl: spi@1fa10000 {
+		compatible = "econet,en751221-spi";
 		reg = <0x1fa10000 0x140>;
+
+		clocks = <&scuclk EN751221_CLK_SPI>;
+		clock-names = "spi";
 		#address-cells = <1>;
 		#size-cells = <0>;
-		spi-rx-bus-width = <2>;
-		spi-tx-bus-width = <2>;
 
 		nand: nand@0 {
 			compatible = "spi-nand";
 			reg = <0>;
+			spi-max-frequency = <25000000>;
+			spi-rx-bus-width = <2>;
+			spi-tx-bus-width = <1>;
 			nand-ecc-engine = <&nand>;
 		};
 	};
