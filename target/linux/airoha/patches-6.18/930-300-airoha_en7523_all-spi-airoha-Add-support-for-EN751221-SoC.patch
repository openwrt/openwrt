 	}
@@ -707,7 +824,7 @@ static int airoha_spi_exec_op(struct spi_mem *mem,
 		else
 			err = airoha_spi_write_data(as_ctrl, op->data.buf.out,
 						    op->data.nbytes,
-						    op->data.buswidth);
+						    op->data.buswidth, 0);
