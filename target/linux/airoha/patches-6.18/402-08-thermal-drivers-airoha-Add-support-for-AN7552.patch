From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Localhost <localhost@localhost>
Date: Sat, 24 Oct 2026 12:00:00 +0200
Subject: [PATCH] thermal: drivers: airoha: Add support for AN7552

AN7552/AN7563 has two sensors read through the one chip SCU TADC, with the
ADC mux selecting the sensor (7 and 6).  The temperature is linear in the
ADC code:

  temp = 1000 * (code - code_at_30) / slope + init_temp   (0.1 C)

The slopes (5565 and 6059), the initial temperatures (30.0 C with the efuse
calibration in PTPSPARE0, 55.0 C without it), the per-sensor mux and the
SCU register values come from the vendor driver (en7552 branch of
drivers/thermal/airoha_thermal.c, v1.0.240605, and thermal_avs/en7552/
ecnt_scu_phy.c).  Both formulas were checked on a running board: with the
mux set like thermal_init() does, the two sensors read 62.7 C and 65.2 C
at idle.

The vendor driver reports the higher of the two, as does this one.  The
PTP monitor and its interrupt are not used: the zone is polled.

Signed-off-by: Lukasz M <lukasz1992@localhost>
---
--- a/drivers/thermal/airoha_thermal.c
+++ b/drivers/thermal/airoha_thermal.c
@@ -195,6 +195,27 @@
 
 #define AIROHA_THERMAL_NO_MUX_SENSOR		-1
 
+/*
+ * AN7552: two sensors read through the one TADC (the vendor driver
+ * drivers/thermal/airoha_thermal.c, en7552 branch).  Sensor 0 is selected
+ * with ADC mux 7 and sensor 1 with ADC mux 6 (thermal_TADC_mode(0, 1 + idx)).
+ * The temperature is the higher of the two.
+ */
+#define AN7552_SCU_THERMAL_PROTECT_KEY		0x80
+#define AN7552_MUX_TADC				0x2e4
+#define   AN7552_TADC_RST			BIT(4)
+#define   AN7552_TADC_MODE_MASK			0xf3ff
+#define   AN7552_TADC_MODE_DIODE		0x33be
+#define AN7552_DOUT_TADC			0x2f0
+#define AN7552_NUM_SENSOR			2
+
+/* PTPSPARE0: efuse ADC code at 30 degrees, sensor 0 in 15:0, sensor 1 in 31:16 */
+#define AN7552_EFUSE_OFFSET_SENSOR0		GENMASK(15, 0)
+#define AN7552_EFUSE_OFFSET_SENSOR1		GENMASK(31, 16)
+
+#define AN7552_INIT_TEMP_CPK_X10		300
+#define AN7552_INIT_TEMP_NONK_X10		550
+
 /* Convert temp to raw value as read from ADC	((((temp / 100) - init) * slope) / 1000) + offset */
 #define TEMP_TO_RAW(priv, temp)			((((((temp) / 100) - (priv)->init_temp) * \
 						  (priv)->default_slope) / 1000) + \
@@ -266,6 +287,7 @@
 	int init_temp;
 	int default_slope;
 	int default_offset;
+	int sensor_offset[AN7552_NUM_SENSOR];
 };
 
 struct airoha_thermal_soc_data {
@@ -735,6 +757,159 @@
 	return 0;
 }
 
+/* ADC mux and slope (x100) per sensor, from the vendor en7552 branch */
+static const int an7552_sensor_mux[AN7552_NUM_SENSOR] = { 7, 6 };
+static const int an7552_sensor_slope[AN7552_NUM_SENSOR] = { 5565, 6059 };
+
+static const struct reg_field an7552_chip_scu_fields[AIROHA_THERMAL_FIELD_MAX] = {
+	[AIROHA_THERMAL_DOUT_TADC] = REG_FIELD(AN7552_DOUT_TADC, 0, 15),
+	[AIROHA_THERMAL_MUX_TADC] = REG_FIELD(AN7552_MUX_TADC, 1, 3),
+};
+
+/* Sample one sensor: 6 reads, drop min and max, average the rest */
+static int an7552_thermal_read_raw(struct airoha_thermal_priv *priv,
+				   int sensor, int *raw)
+{
+	int mux = an7552_sensor_mux[sensor];
+	int tries, i, val, sum, min_value, max_value;
+
+	for (tries = 0; tries < AN7583_MUX_TRIES; tries++) {
+		airoha_set_thermal_mux(priv, mux, AIROHA_THERMAL_NO_MUX_SENSOR);
+
+		sum = 0;
+		min_value = INT_MAX;
+		max_value = INT_MIN;
+		for (i = 0; i < AIROHA_MAX_SAMPLES; i++) {
+			val = airoha_get_thermal_ADC(priv);
+			min_value = min(val, min_value);
+			max_value = max(val, max_value);
+			sum += val;
+		}
+
+		if (airoha_thermal_mux_holds(priv, mux,
+					     AIROHA_THERMAL_NO_MUX_SENSOR)) {
+			*raw = (sum - min_value - max_value) /
+			       (AIROHA_MAX_SAMPLES - 2);
+			return 0;
+		}
+	}
+
+	return -EAGAIN;
+}
+
+static int an7552_thermal_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct airoha_thermal_zone *zone = thermal_zone_device_priv(tz);
+	struct airoha_thermal_priv *priv = zone->priv;
+	int i, raw, ret, t_x10, max_x10 = INT_MIN;
+
+	mutex_lock(&priv->lock);
+	for (i = 0; i < AN7552_NUM_SENSOR; i++) {
+		ret = an7552_thermal_read_raw(priv, i, &raw);
+		if (ret)
+			break;
+
+		/* 1000 * (raw - code at 30 degrees) / slope + init, in 0.1 C */
+		t_x10 = 1000 * (raw - priv->sensor_offset[i]) /
+			an7552_sensor_slope[i] + priv->init_temp;
+		max_x10 = max(max_x10, t_x10);
+	}
+	mutex_unlock(&priv->lock);
+
+	if (ret)
+		return ret;
+
+	*temp = max_x10 * 100;
+	return 0;
+}
+
+static const struct thermal_zone_device_ops an7552_tz_ops = {
+	.get_temp = an7552_thermal_get_temp,
+};
+
+/* thermal_init() of the vendor en7552 branch, TADC part only */
+static void an7552_thermal_hw_init(struct airoha_thermal_priv *priv)
+{
+	u32 pllrg;
+
+	regmap_read(priv->chip_scu, EN7581_PLLRG_PROTECT, &pllrg);
+	regmap_write(priv->chip_scu, EN7581_PLLRG_PROTECT, priv->pllrg_protect);
+
+	/* Reset the TADC, then set its mode */
+	regmap_update_bits(priv->chip_scu, AN7552_MUX_TADC, AN7552_TADC_RST, 0);
+	regmap_update_bits(priv->chip_scu, AN7552_MUX_TADC, AN7552_TADC_RST,
+			   AN7552_TADC_RST);
+	regmap_update_bits(priv->chip_scu, AN7552_MUX_TADC,
+			   AN7552_TADC_MODE_MASK, AN7552_TADC_MODE_DIODE);
+
+	regmap_write(priv->chip_scu, EN7581_PLLRG_PROTECT, pllrg);
+}
+
+static int an7552_thermal_probe(struct platform_device *pdev,
+				struct airoha_thermal_priv *priv)
+{
+	struct device_node *chip_scu_np;
+	struct device *dev = &pdev->dev;
+	void __iomem *base;
+	u32 efuse;
+	int i, ret;
+
+	/* The efuse word is at 0xf20, so the resource has to cover it */
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	priv->map = devm_regmap_init_mmio(dev, base,
+					  &en7581_thermal_regmap_config);
+	if (IS_ERR(priv->map))
+		return PTR_ERR(priv->map);
+
+	chip_scu_np = of_parse_phandle(dev->of_node, "airoha,chip-scu", 0);
+	if (!chip_scu_np)
+		return -EINVAL;
+
+	priv->chip_scu = syscon_node_to_regmap(chip_scu_np);
+	of_node_put(chip_scu_np);
+	if (IS_ERR(priv->chip_scu))
+		return PTR_ERR(priv->chip_scu);
+
+	for (i = 0; i < AIROHA_THERMAL_FIELD_MAX; i++) {
+		struct regmap_field *field;
+
+		/* No MUX_SENSOR: the diode is picked by the TADC mux alone */
+		if (i == AIROHA_THERMAL_MUX_SENSOR)
+			continue;
+
+		field = devm_regmap_field_alloc(dev, priv->chip_scu,
+						an7552_chip_scu_fields[i]);
+		if (IS_ERR(field))
+			return PTR_ERR(field);
+
+		priv->chip_scu_fields[i] = field;
+	}
+
+	an7552_thermal_hw_init(priv);
+
+	regmap_read(priv->map, EN7581_EFUSE_TEMP_OFFSET_REG, &efuse);
+	if (efuse) {
+		priv->sensor_offset[0] = FIELD_GET(AN7552_EFUSE_OFFSET_SENSOR0, efuse);
+		priv->sensor_offset[1] = FIELD_GET(AN7552_EFUSE_OFFSET_SENSOR1, efuse);
+		priv->init_temp = AN7552_INIT_TEMP_CPK_X10;
+		return 0;
+	}
+
+	/* No calibration: take the code now as the one at the initial temp */
+	for (i = 0; i < AN7552_NUM_SENSOR; i++) {
+		ret = an7552_thermal_read_raw(priv, i, &priv->sensor_offset[i]);
+		if (ret)
+			return ret;
+	}
+	priv->init_temp = AN7552_INIT_TEMP_NONK_X10;
+	dev_info(dev, "missing thermal calibration EFUSE, using non calibrated value\n");
+
+	return 0;
+}
+
 static int airoha_thermal_probe(struct platform_device *pdev)
 {
 	const struct airoha_thermal_soc_data *soc_data;
@@ -806,6 +981,13 @@
 	.post_probe = &en7581_thermal_post_probe,
 };
 
+static const struct airoha_thermal_soc_data an7552_data = {
+	.num_sensors = 1,
+	.pllrg_protect = AN7552_SCU_THERMAL_PROTECT_KEY,
+	.thdev_ops = &an7552_tz_ops,
+	.probe = &an7552_thermal_probe,
+};
+
 static const struct airoha_thermal_soc_data an7583_data = {
 	.sensors = an7583_zone_sensors,
 	.num_sensors = AN7583_NUM_SENSOR,
@@ -816,6 +998,7 @@
 
 static const struct of_device_id airoha_thermal_match[] = {
 	{ .compatible = "airoha,en7581-thermal", .data = &en7581_data },
+	{ .compatible = "airoha,an7552-thermal", .data = &an7552_data },
 	{ .compatible = "airoha,an7583-thermal", .data = &an7583_data },
 	{},
 };
