+	struct airoha_qdma *qdma = airoha_qdma_deref(dev);
 	struct airoha_eth *eth = qdma->eth;
 	int qdma_id = qdma - &eth->qdma[0];
 	int i, lro_queue_index = 0;
@@ -1164,7 +1164,7 @@ static void airoha_qdma_wake_netdev_txqs
 			if (!dev)
 				continue;
 
-			if (dev->qdma != qdma)
