+			if (rcu_access_pointer(iter_dev->qdma) !=
+			    rcu_access_pointer(dev->qdma))
 				continue;
 
 			netdev = netdev_from_priv(iter_dev);
@@ -2166,14 +2167,27 @@ static void airoha_update_netdev_feature
 	}
 }
 
+static void airoha_qdma_user_get(struct airoha_qdma *qdma)
+{
+	qdma->users++;
+}
+
+static void airoha_qdma_user_put(struct airoha_qdma *qdma)
+{
+	qdma->users--;
+}
