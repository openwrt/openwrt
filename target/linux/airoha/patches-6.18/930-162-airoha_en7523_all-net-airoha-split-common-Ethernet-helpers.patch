 drivers/net/ethernet/airoha/Makefile        |   3 +
 drivers/net/ethernet/airoha/airoha_common.c | 115 ++++++++++++++++++++
 drivers/net/ethernet/airoha/airoha_common.h |  26 +++++
 drivers/net/ethernet/airoha/airoha_eth.c    |  71 ++----------
 drivers/net/ethernet/airoha/airoha_eth.h    |   6 +-
 6 files changed, 164 insertions(+), 64 deletions(-)
 create mode 100644 drivers/net/ethernet/airoha/airoha_common.c
 create mode 100644 drivers/net/ethernet/airoha/airoha_common.h

