+static int gpon_ndo_open(struct net_device *dev)
+{
+	struct gpon_priv *priv = netdev_priv(dev);
+
+	dev_info(priv->dev, "opening %s and starting GPON upstream\n",
+		 dev->name);
+	netif_start_queue(dev);
+	if (priv->sfp_bus)
+		sfp_upstream_start(priv->sfp_bus);
+
+	return 0;
+}
