+static int gpon_ndo_stop(struct net_device *dev)
+{
+	struct gpon_priv *priv = netdev_priv(dev);
+
+	dev_info(priv->dev, "stopping %s and GPON upstream\n",
+		 dev->name);
+	if (priv->sfp_bus)
+		sfp_upstream_stop(priv->sfp_bus);
+	netif_stop_queue(dev);
+
+	return 0;
+}
