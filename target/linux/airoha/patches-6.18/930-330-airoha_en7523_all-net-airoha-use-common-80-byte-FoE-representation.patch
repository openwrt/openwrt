 		.get_sport = airoha_en751221_get_sport,
 		.get_dev_from_sport = airoha_en751221_get_dev_from_sport,
@@ -9523,6 +9524,7 @@ const struct airoha_eth_soc_data econet_en7528_soc_data = {
