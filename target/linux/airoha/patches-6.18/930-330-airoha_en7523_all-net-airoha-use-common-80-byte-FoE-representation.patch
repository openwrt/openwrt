 					      REG_PPE_RAM_ENTRY(ppe2, i));
 	}
 
-	return ppe->common.foe + sw_idx * sizeof(struct airoha_foe_entry);
+	return ppe->common.foe + sw_idx * AIROHA_FOE_ENTRY_SIZE;
 }
 
