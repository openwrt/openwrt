From 7d7cb169396f75d398a53f9f4a59808a87994a0c Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Tue, 21 Jul 2026 21:38:34 +0000
Subject: [PATCH] net: airoha: stop GPON PLOAM traffic after LOS

Poll the digital xPON PHY link state as a fallback for SFP buses that
do not propagate LOS transitions to their upstream consumer. When
synchronization is lost in O5, stop the BER timer and move the PLOAM
state machine to O6 so TO2 can reset the GPON MAC.

Run periodic REI reporting only while the ONU is in O5 and guard every
non-dying-gasp upstream PLOAM transmission against PHY LOS. This
prevents stale REI messages from being written after the fiber is
disconnected.

Signed-off-by: OpenAI <noreply@openai.com>
Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_xpon.c | 111 ++++++++++++++++++----
 drivers/phy/airoha/phy-airoha-xpon.c      |  24 +++++
 include/linux/phy/phy-airoha-xpon.h       |   1 +
 3 files changed, 120 insertions(+), 16 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_xpon.c b/drivers/net/ethernet/airoha/airoha_xpon.c
index 7bcfd3dfb8d3..1c2bb498628c 100644
--- a/drivers/net/ethernet/airoha/airoha_xpon.c
+++ b/drivers/net/ethernet/airoha/airoha_xpon.c
@@ -538,6 +538,7 @@ static void airoha_xpon_phy_stop(struct device *dev, struct phy *phy,
 #define GPON_TO2_MS		100
 /* Restart delay after an OLT Deactivate_ONU-ID request. */
 #define GPON_DEACTIVATE_RESTART_MS	500
+#define XPON_LINK_POLL_MS		250
 #define GPON_REARM_RETRY_MS		1000
 
 #define GPON_MAX_GEM_ID		4096
@@ -617,6 +618,8 @@ struct xpon_priv {
 	bool			started;
 	bool			optical_active;
 	bool			mac_enabled;
+	bool			phy_link_known;
+	bool			phy_link_up;
 	struct airoha_gpon_omci omci;
 	struct airoha_xpon_oam_handler omci_handler;
 	struct sfp_bus		*sfp_bus;
@@ -644,6 +647,7 @@ struct xpon_priv {
 	struct delayed_work	to1_work;	/* O3/O4: 10 s → O2 */
 	struct delayed_work	to2_work;	/* O6: 100 ms → O1 */
 	struct delayed_work	restart_work;	/* OLT deactivation recovery */
+	struct delayed_work	phy_link_work;	/* Digital PHY link monitor */
 	atomic_t		pending_irqs;
 
 	/*
@@ -1321,7 +1325,18 @@ static void gpon_hw_send_ploam(struct xpon_priv *priv,
 {
 	u8 onu_id = msg->value[0] >> 24;
 	u8 type = msg->value[0] >> 16;
-	int t;
+	bool ready, los;
+	int ret, t;
+
+	if (type != PLOAM_UP_DYING_GASP) {
+		ret = airoha_xpon_phy_get_link_state(priv->phy, &ready, &los);
+		if (!ret && (!ready || los)) {
+			dev_dbg_ratelimited(priv->dev,
+					    "dropping PLOAM type %#04x while PHY ready=%u LOS=%u\n",
+					     type, ready, los);
+			return;
+		}
+	}
 
 	dev_info(priv->dev,
 			    "PLOAM TX: onu=%u type=%#04x copies=%d words=%08x/%08x/%08x\n",
@@ -1658,7 +1673,8 @@ static void gpon_cb_set_ber_interval(void *hw_priv, u32 interval_ms)
 	dev_info(priv->dev, "GPON BER reporting interval=%u ms\n",
 		 interval_ms);
 	priv->ber_interval_ms = interval_ms;
-	if (interval_ms)
+	if (interval_ms && READ_ONCE(priv->mac_enabled) &&
+	    ploam_get_state(priv->ploam) == GPON_O5_OPERATION)
 		mod_timer(&priv->ber_timer,
 			  jiffies + msecs_to_jiffies(interval_ms));
 	else
@@ -2042,6 +2058,9 @@ static void gpon_cb_state_changed(void *hw_priv, enum gpon_state state)
 	mutex_unlock(&priv->link_state_lock);
 	gpon_refresh_netdev_link(priv, false);
 
+	if (state != GPON_O5_OPERATION)
+		timer_delete(&priv->ber_timer);
+
 	switch (state) {
 	case GPON_O2_STANDBY:
 		/*
@@ -2060,8 +2079,12 @@ static void gpon_cb_state_changed(void *hw_priv, enum gpon_state state)
 				 msecs_to_jiffies(GPON_TO1_MS));
 		break;
 	case GPON_O5_OPERATION:
-		/* Cancel TO1 */
+		/* Cancel TO1 and start periodic BER reporting only in O5. */
 		cancel_delayed_work(&priv->to1_work);
+		if (priv->ber_interval_ms)
+			mod_timer(&priv->ber_timer,
+				  jiffies +
+				  msecs_to_jiffies(priv->ber_interval_ms));
 		dev_info(priv->dev, "GPON O5: operational, ONU-ID=%u\n",
 			 ploam_get_onu_id(priv->ploam));
 		break;
@@ -2188,6 +2211,8 @@ static int gpon_enable(struct xpon_priv *priv)
 	gpon_ploam_rx_queue_reset(priv);
 	ploam_start(priv->ploam);
 	WRITE_ONCE(priv->mac_enabled, true);
+	WRITE_ONCE(priv->phy_link_known, false);
+	mod_delayed_work(priv->fsm_wq, &priv->phy_link_work, 0);
 
 	/* Vendor gpon_INT_init() clears W1C status before unmasking the MAC. */
 	gpon_write(priv, GPON_INT_STATUS, ~0U);
@@ -2198,9 +2223,6 @@ static int gpon_enable(struct xpon_priv *priv)
 		 priv->irq, gpon_read(priv, GPON_INT_ENABLE),
 		 gpon_read(priv, GPON_INT_STATUS));
 
-	if (priv->ber_interval_ms)
-		mod_timer(&priv->ber_timer,
-			  jiffies + msecs_to_jiffies(priv->ber_interval_ms));
 	dev_info(priv->dev,
 		 "GPON MAC started: state=%s mbi=%#08x int_enable=%#08x\n",
 		 gpon_state_name(ploam_get_state(priv->ploam)),
@@ -2248,6 +2270,9 @@ static void gpon_disable(struct xpon_priv *priv)
 		cancel_delayed_work_sync(&priv->to2_work);
 
 	timer_delete_sync(&priv->ber_timer);
+	cancel_delayed_work_sync(&priv->phy_link_work);
+	WRITE_ONCE(priv->phy_link_known, false);
+	WRITE_ONCE(priv->phy_link_up, false);
 
 	/* Match the vendor shutdown path: mask and clear MAC interrupts,
 	 * invalidate the runtime identities, disconnect GDM2, then stop the
@@ -2301,19 +2326,66 @@ static void gpon_disable(struct xpon_priv *priv)
 static void gpon_ber_timer_fn(struct timer_list *t)
 {
 	struct xpon_priv *priv = timer_container_of(priv, t, ber_timer);
-	u32 depth;
+	bool ready, los;
+	int ret;
 
-	/* Report a missing MAC IRQ while retaining the FIFO contents for debug. */
-	depth = gpon_read(priv, GPON_PLOAMd_FIFO_STS) & PLOAMd_FIFO_USED_MASK;
-	if (depth && ploam_get_state(priv->ploam) != GPON_O5_OPERATION)
-		dev_warn(priv->dev,
-			"PLOAM FIFO has %u messages without a MAC IRQ: status=%#08x mask=%#08x\n",
-			depth, gpon_read(priv, GPON_INT_STATUS),
-			gpon_read(priv, GPON_INT_ENABLE));
+	if (!READ_ONCE(priv->mac_enabled) || !priv->ber_interval_ms ||
+	    ploam_get_state(priv->ploam) != GPON_O5_OPERATION)
+		return;
+
+	ret = airoha_xpon_phy_get_link_state(priv->phy, &ready, &los);
+	if (!ret && (!ready || los)) {
+		mod_delayed_work(priv->fsm_wq, &priv->phy_link_work, 0);
+		return;
+	}
 
 	ploam_notify_ber(priv->ploam, 0);
-	mod_timer(&priv->ber_timer,
-		  jiffies + msecs_to_jiffies(priv->ber_interval_ms));
+	if (READ_ONCE(priv->mac_enabled) && priv->ber_interval_ms &&
+	    ploam_get_state(priv->ploam) == GPON_O5_OPERATION)
+		mod_timer(&priv->ber_timer,
+			  jiffies +
+			  msecs_to_jiffies(priv->ber_interval_ms));
+}
+
+static void airoha_xpon_phy_link_work_fn(struct work_struct *work)
+{
+	struct xpon_priv *priv =
+		container_of(to_delayed_work(work), struct xpon_priv,
+			     phy_link_work);
+	bool ready, los, link, changed;
+	int ret;
+
+	if (!READ_ONCE(priv->phy_powered))
+		return;
+
+	ret = airoha_xpon_phy_get_link_state(priv->phy, &ready, &los);
+	if (ret)
+		goto rearm;
+
+	link = ready && !los;
+	changed = !READ_ONCE(priv->phy_link_known) ||
+		  READ_ONCE(priv->phy_link_up) != link;
+	WRITE_ONCE(priv->phy_link_known, true);
+	WRITE_ONCE(priv->phy_link_up, link);
+
+	if (changed)
+		dev_info(priv->dev,
+			 "%s digital PHY link %s: ready=%u LOS=%u\n",
+			 airoha_xpon_mode_name(priv->mode),
+			 link ? "up" : "down", ready, los);
+
+	if (!link && priv->mode == AIROHA_XPON_MODE_GPON &&
+	    ploam_get_state(priv->ploam) == GPON_O5_OPERATION) {
+		dev_warn(priv->dev,
+			 "GPON synchronization lost in O5, stopping upstream PLOAM\n");
+		timer_delete(&priv->ber_timer);
+		ploam_notify_los(priv->ploam);
+	}
+
+rearm:
+	if (READ_ONCE(priv->phy_powered))
+		mod_delayed_work(priv->fsm_wq, &priv->phy_link_work,
+				 msecs_to_jiffies(XPON_LINK_POLL_MS));
 }
 
 /* TO1: O3/O4 timeout — no Ranging_Time received within 10 s → return to O2 */
@@ -3351,6 +3423,8 @@ static int epon_enable(struct xpon_priv *priv)
 	usleep_range(50, 100);
 
 	WRITE_ONCE(priv->mac_enabled, true);
+	WRITE_ONCE(priv->phy_link_known, false);
+	mod_delayed_work(priv->fsm_wq, &priv->phy_link_work, 0);
 	epon_write(priv, EPON_INT_STATUS, ~0U);
 	epon_write(priv, EPON_INT_EN, int_en);
 	dev_info(priv->dev, "EPON interrupt mask=%#08x irq=%d\n",
@@ -3372,6 +3446,9 @@ static void epon_disable(struct xpon_priv *priv)
 		 "stopping EPON MAC: registered_llids=%d glb_cfg=%#08x\n",
 		 priv->registered_llids, epon_read(priv, EPON_GLB_CFG));
 	WRITE_ONCE(priv->mac_enabled, false);
+	cancel_delayed_work_sync(&priv->phy_link_work);
+	WRITE_ONCE(priv->phy_link_known, false);
+	WRITE_ONCE(priv->phy_link_up, false);
 	epon_write(priv, EPON_INT_EN, 0);
 	epon_write(priv, EPON_INT_STATUS, ~0U);
 	synchronize_irq(priv->irq);
@@ -3744,6 +3821,8 @@ static int airoha_xpon_probe(struct platform_device *pdev)
 		return -ENOMEM;
 	priv->dev = dev;
 	priv->mode = data->mode;
+	INIT_DELAYED_WORK(&priv->phy_link_work,
+			  airoha_xpon_phy_link_work_fn);
 
 	dev_info(dev, "xPON initial mode: %s\n",
 		 airoha_xpon_mode_name(priv->mode));
diff --git a/drivers/phy/airoha/phy-airoha-xpon.c b/drivers/phy/airoha/phy-airoha-xpon.c
index fab207355974..136c0fc3c360 100644
--- a/drivers/phy/airoha/phy-airoha-xpon.c
+++ b/drivers/phy/airoha/phy-airoha-xpon.c
@@ -144,6 +144,30 @@ static bool airoha_xpon_phy_los(struct airoha_xpon_phy *priv)
 		XPON_TRANS_STATUS_LOS;
 }
 
+int airoha_xpon_phy_get_link_state(struct phy *phy, bool *ready, bool *los)
+{
+	struct airoha_xpon_phy *priv;
+
+	if (!phy || !ready || !los)
+		return -EINVAL;
+
+	priv = phy_get_drvdata(phy);
+	if (!priv)
+		return -ENODEV;
+
+	if (!READ_ONCE(priv->powered)) {
+		*ready = false;
+		*los = true;
+		return 0;
+	}
+
+	*ready = airoha_xpon_phy_ready(priv);
+	*los = airoha_xpon_phy_los(priv);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_xpon_phy_get_link_state);
+
 static int airoha_xpon_phy_get_active_gpon(
 	struct phy *phy, struct airoha_xpon_phy **privp)
 {
diff --git a/include/linux/phy/phy-airoha-xpon.h b/include/linux/phy/phy-airoha-xpon.h
index 3621dea5051d..551b6a7eac47 100644
--- a/include/linux/phy/phy-airoha-xpon.h
+++ b/include/linux/phy/phy-airoha-xpon.h
@@ -24,6 +24,7 @@ enum airoha_xpon_phy_gpon_oper_state {
 	AIROHA_XPON_PHY_GPON_OPER_OPERATION = 3,
 };
 
+int airoha_xpon_phy_get_link_state(struct phy *phy, bool *ready, bool *los);
 int airoha_xpon_phy_get_gpon_tx_counters(struct phy *phy,
 					 u32 *frame_count,
 					 u32 *burst_count);
-- 
2.55.0

