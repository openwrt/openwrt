+static void
+en8801s_led_get_control_events(struct en8801s_priv *priv, u8 index,
+			       u16 *on_evt, u16 *blk_evt)
+{
+	struct airoha_leds_config *cfg = &priv->led_cfg[index];
+
+	switch (priv->led_control[index]) {
+	case EN8801S_LED_CONTROL_HW:
+		*on_evt = cfg->on_cfg;
+		*blk_evt = cfg->blk_cfg;
+		break;
+	case EN8801S_LED_CONTROL_ON:
+		*on_evt = LED_ON_EVT_FORCE;
+		*blk_evt = 0;
+		break;
+	case EN8801S_LED_CONTROL_BLINK:
+		*on_evt = 0;
+		*blk_evt = LED_BLK_EVT_FORCE;
+		break;
+	case EN8801S_LED_CONTROL_OFF:
+	default:
+		*on_evt = 0;
+		*blk_evt = 0;
+		break;
+	}
+}
