@@ -0,0 +1,40 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/optical-frontend.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Common optical frontend provider properties
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+description: |
+  Common properties for analog optical frontend providers such as laser
+  drivers, limiting amplifiers and APD controllers. Provider-specific
+  bindings describe the compatible string and transport.
+
+select:
+  required:
+    - '#optical-frontend-cells'
+
+properties:
+  '#optical-frontend-cells':
+    const: 0
+    description:
+      The device exposes one optical frontend provider.
+
+  tx-disable-gpios:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    maxItems: 1
+    description: |
+      GPIO connected to the optical transmitter disable input. Its polarity
+      must describe the asserted (transmitter disabled) level. The optical
+      frontend core asserts this GPIO while registering the provider and only
+      deasserts it after the provider is ready to transmit.
+
+required:
+  - '#optical-frontend-cells'
+
+additionalProperties: true
+...
