 {
+	struct airoha_xpon_link_state new_state;
 	struct airoha_gdm_dev *dev;
+	unsigned long flags;
 
+	if (!state)
+		return;
 	if (airoha_eth_get_xpon_gdm2(netdev, &dev))
 		return;
 	if (!(dev->flags & AIROHA_PRIV_F_XPON_MANAGED))
 		return;
