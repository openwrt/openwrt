From 2636ad73a1cb4070d6d319ccb576f17edc8c195b Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 11 Aug 2026 14:04:15 -0300
Subject: [PATCH] net: airoha: align EN751221 PPE and switch throughput setup

The EN751221 vendor SDK uses a 3-bit PPE QID field and programs the
MT7530 global flow-control register to 0x80083020 on both the on-die
and companion switches for throughput operation.

Keep the previously validated default-QID PPE behavior, correct the
QID mask for future users, and mirror the vendor global flow-control
setup without changing ingress or egress rate-limit accounting.

Signed-off-by: OpenAI <noreply@openai.com>
Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/dsa/mt7530.c                 | 10 ++++++++++
 drivers/net/ethernet/airoha/airoha_ppe.c |  2 +-
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/net/dsa/mt7530.c b/drivers/net/dsa/mt7530.c
index bb676c84cf4b..0a6008800cae 100644
--- a/drivers/net/dsa/mt7530.c
+++ b/drivers/net/dsa/mt7530.c
@@ -464,6 +464,8 @@ mt7530_setup_port6(struct dsa_switch *ds, phy_interface_t interface)
 #define EN751221_TRGMII_RX_VALUE_MASK	GENMASK(23, 16)
 #define EN751221_TRGMII_RX_ERR_MASK	GENMASK(11, 8)
 #define EN751221_AGC_L2LEN_CHK		BIT(4)
+#define EN751221_GSW_FC_CTL		0x1fe0
+#define EN751221_GSW_FC_CTL_VAL		0x80083020
 /* Exact external port-6 PVC value used by the EN7512 vendor SDK. */
 #define EN751221_MCM_P6_PVC		0x81008120
 
@@ -695,6 +697,14 @@ static void en751221_trgmii_pair_setup(struct mt7530_priv *ext,
 	/* Special-tag frames can look like short L2 frames to the on-die switch. */
 	mt7530_clear(ondie, MT753X_AGC, EN751221_AGC_L2LEN_CHK);
 
+	/*
+	 * The EN7512 vendor SDK disables global switch flow control on both
+	 * sides of the cascade for throughput operation. Keep this separate
+	 * from ingress/egress rate-limit accounting, which is not changed here.
+	 */
+	mt7530_write(ondie, EN751221_GSW_FC_CTL, EN751221_GSW_FC_CTL_VAL);
+	mt7530_write(ext, EN751221_GSW_FC_CTL, EN751221_GSW_FC_CTL_VAL);
+
 	/* Port 6 of the companion MT7530 is the actual MTK tag endpoint. */
 	/*
 	 * Keep the vendor port-6 special-tag format intact. Besides
diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
index b96aa3c48d4b..a17559e62052 100644
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -2499,7 +2499,7 @@ EXPORT_SYMBOL_GPL(airoha_ppe_deinit);
 #define EN75_FOE_IB1_STATE		GENMASK(29, 28)
 #define EN75_FOE_IB1_UDP		BIT(30)
 
-#define EN75_FOE_IB2_QID		GENMASK(3, 0)
+#define EN75_FOE_IB2_QID		GENMASK(2, 0)
 #define EN75_FOE_IB2_PSE_QOS		BIT(4)
 #define EN75_FOE_IB2_DEST_PORT		GENMASK(7, 5)
 #define EN75_FOE_IB2_MULTICAST		BIT(8)
-- 
