+#define EN7571_T1DELAY			0x0008	/* T-GEN timing, ERC enable, T0/T1 delay */
+#define EN7571_TIASD			0x000c	/* TIA signal-detect threshold */
+#define EN7571_T0C			0x0010	/* T0C/T1C burst counters (read-only) */
