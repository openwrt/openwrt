 }
 
@@ -571,6 +771,9 @@ static int econet_ethtool_nway_reset(struct net_device *dev)
 {
 	struct econet_gdm_port *port = netdev_priv(dev);
 
+	if (READ_ONCE(port->xpon_managed))
