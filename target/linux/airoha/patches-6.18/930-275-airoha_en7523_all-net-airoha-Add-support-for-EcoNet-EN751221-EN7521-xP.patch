 drivers/net/ethernet/airoha/airoha_eth.h      |   5 +
 drivers/net/ethernet/airoha/airoha_eth_gen1.c | 785 +++++++++++++++++-
 drivers/net/ethernet/airoha/airoha_eth_gen1.h |  31 +
 drivers/net/ethernet/airoha/airoha_qdma.c     | 133 ++-
 drivers/net/ethernet/airoha/airoha_xpon.c     | 191 ++++-
 6 files changed, 1109 insertions(+), 94 deletions(-)

diff --git a/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml b/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
index 0a66a44ed97a..43a149b94434 100644
--- a/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
+++ b/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
@@ -4,21 +4,29 @@
 $id: http://devicetree.org/schemas/net/airoha,en7523-xpon.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Airoha EN7523 shared GPON and EPON MAC
+title: Airoha and EcoNet shared GPON and EPON MAC
 
 maintainers:
   - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
 
 description: |
-  The EN7523 family contains one xPON MAC complex shared by the GPON and
-  EPON protocol engines.  Both modes use GDM2/CDM2 as the packet datapath.
-  The common register region starts at 0x1fb60000, with the GPON register
-  window at offset 0x4000 and the EPON register window at offset 0x6000.
+  The Airoha EN7523 and EcoNet EN751221/EN7521 families contain one xPON
+  MAC complex shared by the GPON and EPON protocol engines. Both generations
+  use GDM2/CDM2 as the packet datapath and expose the xPON register region at
+  0x1fb60000, with GPON at offset 0x4000 and EPON at offset 0x6000.
+
+  EN7523 exposes a standalone xPON MAC interrupt. On EN751221-family MIPS
+  SoCs the GPON/EPON MAC interrupt is aggregated by the WAN QDMA block and
+  therefore is not described as a platform interrupt on this node.
 
 properties:
   compatible:
     oneOf:
-      - const: airoha,en7523-xpon
+      - enum:
+          - airoha,en7523-xpon
+          - econet,en751221-xpon
+          - econet,en7521-xpon
+          - econet,en7526-xpon
       - enum:
           - airoha,en7523-gpon
           - airoha,en7523-epon
@@ -44,8 +52,9 @@ properties:
     minItems: 1
     maxItems: 2
     description:
-      The first interrupt is generated by the xPON MAC. The optional second
-      interrupt reports the platform power-fail/dying-gasp condition.
+      EN7523 xPON MAC interrupt followed by an optional platform
+      power-fail/dying-gasp interrupt. EcoNet EN751221-family SoCs route the
+      MAC interrupt through QDMA1 and normally omit this property.
 
   interrupt-names:
     minItems: 1
@@ -66,18 +75,18 @@ properties:
   ethernet:
     $ref: /schemas/types.yaml#/definitions/phandle
     description:
-      Optional phandle to the airoha,eth-mac GDM2 child used as the xPON
-      datapath. When omitted, the driver discovers the EN7523 GDM2 netdev.
+      Optional phandle to the GDM2 child used as the xPON datapath. When
+      omitted, the driver discovers the SoC GDM2 netdev.
 
   airoha,scu:
     $ref: /schemas/types.yaml#/definitions/phandle
     description:
-      Phandle to the EN7523 SCU syscon used to select GPON or EPON mode.
+      Phandle to the SoC SCU syscon used to select GPON or EPON mode.
 
   airoha,pon-mode:
     description:
-      Protocol engine selected for airoha,en7523-xpon.  The property is
-      optional and defaults to GPON.  Legacy mode-specific compatibles do
+      Protocol engine selected for a unified *-xpon compatible. The property
+      is optional and defaults to GPON. Legacy mode-specific compatibles do
       not require it.
     enum: [gpon, epon]
 
@@ -110,7 +119,7 @@ properties:
 
   phys:
     maxItems: 1
-    description: Phandle to the EN7523 digital xPON PHY.
+    description: Phandle to the SoC digital xPON PHY.
 
   phy-names:
     const: xpon
@@ -122,7 +131,6 @@ properties:
 required:
   - compatible
   - reg
-  - interrupts
   - airoha,scu
   - sfp
 
@@ -135,7 +143,11 @@ allOf:
   - if:
       properties:
         compatible:
-          const: airoha,en7523-xpon
+          enum:
+            - airoha,en7523-xpon
+            - econet,en751221-xpon
+            - econet,en7521-xpon
+            - econet,en7526-xpon
     then:
       required:
         - phys
@@ -145,8 +157,22 @@ allOf:
       properties:
         airoha,pon-mode: true
     else:
+      required:
+        - phys
+        - phy-names
       properties:
         airoha,pon-mode: false
+  - if:
+      properties:
+        compatible:
+          enum:
+            - airoha,en7523-xpon
+            - airoha,en7523-gpon
+            - airoha,en7523-epon
+    then:
+      required:
+        - interrupts
+        - interrupt-names
 
 additionalProperties: true
 
