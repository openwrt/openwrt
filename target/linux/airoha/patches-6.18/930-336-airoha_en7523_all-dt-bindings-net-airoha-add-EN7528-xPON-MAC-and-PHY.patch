From c6626fe4ffa57925a23831d2597c6101bf0676dd Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Wed, 26 Aug 2026 01:29:27 -0300
Subject: [PATCH] dt-bindings: net: airoha: add EN7528 xPON MAC and PHY

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 .../devicetree/bindings/net/airoha,en7523-xpon.yaml  |  7 +++++--
 .../bindings/phy/airoha,en7523-xpon-phy.yaml         | 12 ++++++++++--
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml b/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
index 0766ad17246f..f63174d3588e 100644
--- a/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
+++ b/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
@@ -10,12 +10,12 @@ maintainers:
   - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
 
 description: |
-  The Airoha EN7523 and EcoNet EN751221/EN7521 families contain one xPON
+  The Airoha EN7523/EN7528 and EcoNet EN751221/EN7521 families contain one xPON
   MAC complex shared by the GPON and EPON protocol engines. Both generations
   use GDM2/CDM2 as the packet datapath and expose the xPON register region at
   0x1fb60000, with GPON at offset 0x4000 and EPON at offset 0x6000.
 
-  EN7523 exposes a standalone xPON MAC interrupt. On EN751221-family MIPS
+  EN7523 and EN7528 expose a standalone xPON MAC interrupt. On EN751221-family MIPS
   SoCs the GPON/EPON MAC interrupt is aggregated by the WAN QDMA block and
   therefore is not described as a platform interrupt on this node.
 
@@ -24,6 +24,7 @@ properties:
     oneOf:
       - enum:
           - airoha,en7523-xpon
+          - airoha,en7528-xpon
           - econet,en751221-xpon
           - econet,en7521-xpon
           - econet,en7526-xpon
@@ -163,6 +164,7 @@ allOf:
         compatible:
           enum:
             - airoha,en7523-xpon
+            - airoha,en7528-xpon
             - econet,en751221-xpon
             - econet,en7521-xpon
             - econet,en7526-xpon
@@ -185,6 +187,7 @@ allOf:
         compatible:
           enum:
             - airoha,en7523-xpon
+            - airoha,en7528-xpon
             - airoha,en7523-gpon
             - airoha,en7523-epon
     then:
diff --git a/Documentation/devicetree/bindings/phy/airoha,en7523-xpon-phy.yaml b/Documentation/devicetree/bindings/phy/airoha,en7523-xpon-phy.yaml
index 3e8185eedbcf..2860adf64f6c 100644
--- a/Documentation/devicetree/bindings/phy/airoha,en7523-xpon-phy.yaml
+++ b/Documentation/devicetree/bindings/phy/airoha,en7523-xpon-phy.yaml
@@ -10,19 +10,27 @@ maintainers:
   - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
 
 description: |
-  Airoha EN7523 and EcoNet EN751221 contain a digital xPON PHY shared by the
+  Airoha EN7523/EN7528 and EcoNet EN751221 contain a digital xPON PHY shared by the
   GPON and EPON MAC engines. The generations share the GPON/EPON digital
-  register block; EN7523 additionally integrates PMA/SerDes controls.
+  register block; EN7523 and EN7528 additionally integrate PMA/SerDes controls.
 
 properties:
   compatible:
     enum:
       - airoha,en7523-xpon-phy
+      - airoha,en7528-xpon-phy
       - econet,en751221-xpon-phy
 
   reg:
     maxItems: 1
 
+  interrupts:
+    maxItems: 1
+    description: Optional EN7528 digital PHY interrupt.
+
+  interrupt-names:
+    const: phy
+
   resets:
     maxItems: 1
 
-- 
2.55.0

