+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/econet,en7528-xhci.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: EcoNet EN7528 and EN7580 USB3 xHCI host controllers
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+allOf:
+  - $ref: usb-xhci.yaml#
+
+description:
+  These controllers use the MediaTek xHCI host driver. EN7528 has one
+  controller and EN7580 has two independent controllers. Each controller
+  has a MAC register bank and an IP Port Control register bank.
+
+properties:
+  compatible:
+    enum:
+      - econet,en7528-xhci
+      - econet,en7580-xhci
+
+  reg:
+    items:
+      - description: xHCI MAC registers
+      - description: IP Port Control registers
+
+  reg-names:
+    items:
+      - const: mac
+      - const: ippc
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-names:
+    items:
+      - const: host
+
+  phys:
+    items:
+      - description: USB2 PHY
+      - description: USB3 PHY
+
+  phy-names:
+    items:
+      - const: usb2-phy
+      - const: usb3-phy
+
+  vbus-supply:
+    description: Regulator supplying USB VBUS
+
+  vusb33-supply:
+    description: Regulator supplying the USB 3.3 V rail
+
+  resets:
+    maxItems: 1
+
+  usb3-lpm-capable: true
+
+  usb2-lpm-disable: true
+
+  mediatek,u2p-dis-msk:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Mask of disabled USB2 ports
+
+  mediatek,u3p-dis-msk:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Mask of disabled USB3 ports
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - phys
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/mips-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/phy/phy.h>
+
+    usb@1fb90000 {
+        compatible = "econet,en7580-xhci";
+        reg = <0x1fb90000 0x4000>, <0x1fa84700 0x100>;
+        reg-names = "mac", "ippc";
+        interrupts = <GIC_SHARED 17 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-names = "host";
+        phys = <&usb_phy0 PHY_TYPE_USB2>, <&usb_phy0 PHY_TYPE_USB3>;
+        phy-names = "usb2-phy", "usb3-phy";
+        usb3-lpm-capable;
+    };
