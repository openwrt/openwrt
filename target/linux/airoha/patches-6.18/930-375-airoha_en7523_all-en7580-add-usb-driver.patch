--- /dev/null
+++ b/Documentation/devicetree/bindings/nvmem/econet,en7580-efuse.yaml
@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/nvmem/econet,en7580-efuse.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: EcoNet EN7580 eFuse shadow
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+description:
+  The EN7580 exposes a byte-addressed eFuse shadow containing package and
+  factory calibration data. This is the region read by the vendor
+  package-info parser. Only read access to the shadow is supported.
+
+allOf:
+  - $ref: nvmem.yaml#
+
+properties:
+  compatible:
+    const: econet,en7580-efuse
+
+  reg:
+    maxItems: 1
+
+  read-only: true
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    efuse@1fa40b00 {
+        compatible = "econet,en7580-efuse";
+        reg = <0x1fa40b00 0x3c>;
+        read-only;
+
+        nvmem-layout {
+            compatible = "fixed-layout";
+            #address-cells = <1>;
+            #size-cells = <1>;
+
+            usb3-tx-imp@6 {
+                reg = <0x6 0x2>;
+                bits = <4 5>;
+            };
+        };
+    };
diff --git a/Documentation/devicetree/bindings/phy/econet,en7528-usb-phy.yaml b/Documentation/devicetree/bindings/phy/econet,en7528-usb-phy.yaml
new file mode 100644
index 000000000..c30686e80
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/econet,en7528-usb-phy.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/econet,en7528-usb-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: EcoNet EN7528 and EN7580 USB PHYs
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+description:
+  EN7528 has two USB2 PHYs sharing a frequency meter and one USB3 PHY.
+  EN7580 has one USB2 PHY, one USB3 PHY and an independent frequency meter
+  for each of its two host controllers. PHY_TYPE_USB2 and PHY_TYPE_USB3
+  select the PHY type. EN7580 factory trims may be supplied through NVMEM.
+
+properties:
+  compatible:
+    enum:
+      - econet,en7528-usb-phy
+      - econet,en7580-usb-phy
+
+  reg:
+    maxItems: 1
+
+  "#phy-cells":
+    const: 1
+
+  nvmem-cells:
+    items:
+      - description: USB2 internal current calibration
+      - description: USB3 external current calibration
+      - description: USB3 transmitter impedance calibration
+      - description: USB3 receiver impedance calibration
+
+  nvmem-cell-names:
+    items:
+      - const: u2-intr
+      - const: u3-intr
+      - const: tx-imp
+      - const: rx-imp
+
+dependencies:
+  nvmem-cells: [nvmem-cell-names]
+  nvmem-cell-names: [nvmem-cells]
+
+required:
+  - compatible
+  - reg
+  - "#phy-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    usb-phy@1fa80000 {
+        compatible = "econet,en7580-usb-phy";
+        reg = <0x1fa80000 0x1000>;
+        #phy-cells = <1>;
+    };
