 #define EN7528_USB_PHY_FREQDET_TIMEOUT		(EN7528_USB_PHY_FREQDET_SLEEP * 10)
 
@@ -59,6 +81,22 @@ struct en7528_usb_phy_instance {
 	u32 type;
 };
 
+struct en7528_usb_phy_soc_data {
+	unsigned int num_u2_ports;
+	unsigned int sr_reg;
+	u32 sr_cal_en;
+	u32 sr_ctrl;
