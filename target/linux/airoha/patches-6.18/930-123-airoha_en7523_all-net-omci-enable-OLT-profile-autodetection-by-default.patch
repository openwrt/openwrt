From c675a3f4e551db64ad92497e2eca10402816c2a1 Mon Sep 17 00:00:00 2001
From: Matheus <sirherobrine23@users.noreply.github.com>
Date: Tue, 28 Jul 2026 14:56:25 +0000
Subject: [PATCH] net: omci: enable OLT profile autodetection by default

Use AUTO as the default configured profile while retaining GENERIC as the
effective profile until OLT-G identification is available. This lets the
agent select vendor policy without requiring a userspace configuration
step.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 net/omci/agent.c    | 2 +-
 net/omci/profiles.c | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/net/omci/agent.c b/net/omci/agent.c
index ae43d6e61..92f8b6e11 100644
--- a/net/omci/agent.c
+++ b/net/omci/agent.c
@@ -1605,7 +1605,7 @@ int omci_agent_init(struct omci_device *odev)
 	agent->config.uni_count = 4;
 	agent->config.onu_type = 2;
 	agent->config.traffic_mgmt_option = 0;
-	agent->config.olt_profile = OMCI_OLT_PROFILE_GENERIC;
+	agent->config.olt_profile = OMCI_OLT_PROFILE_AUTO;
 	agent->config.olt_profile_force = OMCI_OLT_PROFILE_UNSPEC;
 	agent->config.olt_profile_source = OMCI_CONFIG_SOURCE_DEFAULT;
 	agent->config.olt_profile_force_source = OMCI_CONFIG_SOURCE_DEFAULT;
diff --git a/net/omci/profiles.c b/net/omci/profiles.c
index 264b2e462..ab5843811 100644
--- a/net/omci/profiles.c
+++ b/net/omci/profiles.c
@@ -3,8 +3,8 @@
  * OMCI OLT interoperability profiles
  *
  * Profiles describe policy deviations required by selected OLT families.
- * The generic profile remains the default. Automatic detection is opt-in
- * and uses OLT-G identification attributes only as a hint.
+ * Automatic detection is the default and uses OLT-G identification attributes
+ * only as a hint. Until OLT-G is available, the effective profile is generic.
  */
 
 #include <linux/export.h>
-- 
2.55.0

