+};
+MODULE_DEVICE_TABLE(i2c, gn25l95_i2c_ids);
+
+struct i2c_driver gn25l95_i2c_driver = {
+	.driver = {
+		.name = "gn25l95",
+		.of_match_table = gn25l95_of_match,
+	},
+	.probe = gn25l95_probe,
+	.remove = gn25l95_remove,
+	.id_table = gn25l95_i2c_ids,
+};
