diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
index d3ce500177c3..0a4c2e7b2ba2 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -830,10 +830,30 @@ struct econet_foe_ipv4 {
 	struct econet_foe_mac_info l2;
 };
 
+/* EN7512 SDK _ipv6_5t_route layout. The hardware keeps the 5-tuple in
+ * words 1..9 and PpeClearEntryInfo() clears the entry starting at byte 40.
+ */
+struct econet_foe_ipv6 {
+	u32 src_ip[4];
+	u32 dest_ip[4];
+	union {
+		struct {
+			u16 src_port;
+			u16 dest_port;
+		};
+		u32 ports;
+	};
+	u32 reserved[3];
+	u32 udf_tsid;
+	u32 ib2;
+	struct econet_foe_mac_info l2;
+};
+
 struct econet_foe_entry {
 	u32 ib1;
 	union {
 		struct econet_foe_ipv4 ipv4;
+		struct econet_foe_ipv6 ipv6;
 		u32 data[19];
 	};
 };
@@ -851,6 +871,14 @@ static_assert(offsetof(struct econet_foe_entry, ipv4.l2.dest_mac_lo) == 52);
 static_assert(offsetof(struct econet_foe_entry, ipv4.l2.vlan2) == 54);
 static_assert(offsetof(struct econet_foe_entry, ipv4.l2.src_mac_lo) == 60);
 static_assert(offsetof(struct econet_foe_entry, ipv4.l2.pppoe_id) == 62);
+static_assert(offsetof(struct econet_foe_entry, ipv6.src_ip) == 4);
+static_assert(offsetof(struct econet_foe_entry, ipv6.dest_ip) == 20);
+static_assert(offsetof(struct econet_foe_entry, ipv6.src_port) == 36);
+static_assert(offsetof(struct econet_foe_entry, ipv6.dest_port) == 38);
+static_assert(offsetof(struct econet_foe_entry, ipv6.udf_tsid) == 52);
+static_assert(offsetof(struct econet_foe_entry, ipv6.ib2) == 56);
+static_assert(offsetof(struct econet_foe_entry, ipv6.l2.etype) == 60);
+static_assert(offsetof(struct econet_foe_entry, ipv6.l2.pppoe_id) == 78);
 
 struct econet_flow_entry {
 	struct list_head list;
@@ -858,9 +886,12 @@ struct econet_flow_entry {
 	unsigned long cookie;
 	u32 src_ip;
 	u32 dest_ip;
+	struct in6_addr src_ip6;
+	struct in6_addr dest_ip6;
 	u16 src_port;
 	u16 dest_port;
 	u16 hash;
+	u16 addr_type;
 };
 
 struct econet_ppe {
diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
index a20db3d010e2..fed5fef79bc1 100644
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -2587,31 +2587,58 @@ static void econet_ppe_cache_clean(struct econet_ppe *ppe)
 		     gate | EN751221_PPE_CAH_GATE_EN);
 }
 
+static bool econet_foe_entry_is_ipv6(const struct econet_foe_entry *entry)
+{
+	return FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, entry->ib1) ==
+	       PPE_PKT_TYPE_IPV6_ROUTE_5T;
+}
+
+static u32 *econet_foe_entry_ib2(struct econet_foe_entry *entry)
+{
+	return econet_foe_entry_is_ipv6(entry) ? &entry->ipv6.ib2 :
+						 &entry->ipv4.ib2;
+}
+
+static u32 *econet_foe_entry_udf(struct econet_foe_entry *entry)
+{
+	return econet_foe_entry_is_ipv6(entry) ? &entry->ipv6.udf_tsid :
+						 &entry->ipv4.udf_tsid;
+}
+
+static struct econet_foe_mac_info *
+econet_foe_entry_l2(struct econet_foe_entry *entry)
+{
+	return econet_foe_entry_is_ipv6(entry) ? &entry->ipv6.l2 :
+						 &entry->ipv4.l2;
+}
+
 static void econet_foe_entry_prepare(struct econet_foe_entry *entry, u8 l4proto,
-				     u8 pse_port, const u8 *src_mac,
-				     const u8 *dest_mac)
+				     u8 pkt_type, u8 pse_port,
+				     const u8 *src_mac, const u8 *dest_mac)
 {
-	u32 ib2;
+	struct econet_foe_mac_info *l2;
+	u32 *ib2;
 
 	memset(entry, 0, sizeof(*entry));
 	entry->ib1 = FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE, AIROHA_FOE_STATE_BIND) |
-		FIELD_PREP(AIROHA_FOE_IB1_BIND_PACKET_TYPE,
-			   PPE_PKT_TYPE_IPV4_HNAPT) |
+		FIELD_PREP(AIROHA_FOE_IB1_BIND_PACKET_TYPE, pkt_type) |
 		FIELD_PREP(AIROHA_FOE_IB1_BIND_UDP, l4proto == IPPROTO_UDP) |
 		EN751221_FOE_IB1_BIND_CACHE | AIROHA_FOE_IB1_BIND_TTL;
 
-	ib2 = FIELD_PREP(EN751221_FOE_IB2_DEST_PORT, pse_port) |
-		FIELD_PREP(EN751221_FOE_IB2_PORT_MG, 0x3f) |
-		FIELD_PREP(EN751221_FOE_IB2_PORT_AG, 0x3f);
+	ib2 = econet_foe_entry_ib2(entry);
+	*ib2 = FIELD_PREP(EN751221_FOE_IB2_DEST_PORT, pse_port) |
+	       FIELD_PREP(EN751221_FOE_IB2_PORT_MG, 0x3f) |
+	       FIELD_PREP(EN751221_FOE_IB2_PORT_AG, 0x3f);
 	if (is_multicast_ether_addr(dest_mac))
-		ib2 |= EN751221_FOE_IB2_MULTICAST;
-	entry->ipv4.ib2 = ib2;
+		*ib2 |= EN751221_FOE_IB2_MULTICAST;
 
-	entry->ipv4.l2.dest_mac_hi = get_unaligned_be32(dest_mac);
-	entry->ipv4.l2.dest_mac_lo = get_unaligned_be16(dest_mac + 4);
-	entry->ipv4.l2.src_mac_hi = get_unaligned_be32(src_mac);
-	entry->ipv4.l2.src_mac_lo = get_unaligned_be16(src_mac + 4);
-	entry->ipv4.l2.etype = ETH_P_IP;
+	l2 = econet_foe_entry_l2(entry);
+	l2->dest_mac_hi = get_unaligned_be32(dest_mac);
+	l2->dest_mac_lo = get_unaligned_be16(dest_mac + 4);
+	l2->src_mac_hi = get_unaligned_be32(src_mac);
+	l2->src_mac_lo = get_unaligned_be16(src_mac + 4);
+	l2->etype = pkt_type == PPE_PKT_TYPE_IPV6_ROUTE_5T ? ETH_P_IPV6 :
+							 ETH_P_IP;
 }
 
 static void econet_foe_entry_set_ipv4_tuple(struct econet_foe_entry *entry,
@@ -2628,18 +2655,38 @@ static void econet_foe_entry_set_ipv4_tuple(struct econet_foe_entry *entry,
 	tuple->dest_port = be16_to_cpu(dest_port);
 }
 
+static void econet_foe_entry_set_ipv6_tuple(struct econet_foe_entry *entry,
+					    const struct in6_addr *src_addr,
+					    __be16 src_port,
+					    const struct in6_addr *dest_addr,
+					    __be16 dest_port)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(entry->ipv6.src_ip); i++) {
+		entry->ipv6.src_ip[i] = be32_to_cpu(src_addr->s6_addr32[i]);
+		entry->ipv6.dest_ip[i] = be32_to_cpu(dest_addr->s6_addr32[i]);
+	}
+	entry->ipv6.src_port = be16_to_cpu(src_port);
+	entry->ipv6.dest_port = be16_to_cpu(dest_port);
+}
+
 static void econet_foe_entry_set_pse_port(struct econet_foe_entry *entry, u8 port)
 {
-	entry->ipv4.ib2 &= ~(EN751221_FOE_IB2_DEST_PORT | EN751221_FOE_IB2_PSE_QOS);
-	entry->ipv4.ib2 |= FIELD_PREP(EN751221_FOE_IB2_DEST_PORT, port);
+	u32 *ib2 = econet_foe_entry_ib2(entry);
+
+	*ib2 &= ~(EN751221_FOE_IB2_DEST_PORT | EN751221_FOE_IB2_PSE_QOS);
+	*ib2 |= FIELD_PREP(EN751221_FOE_IB2_DEST_PORT, port);
 	if (port == EN751221_DPORT_QDMA_HW)
-		entry->ipv4.ib2 |= EN751221_FOE_IB2_PSE_QOS;
+		*ib2 |= EN751221_FOE_IB2_PSE_QOS;
 }
 
 static void econet_foe_entry_set_queue(struct econet_foe_entry *entry, u8 queue)
 {
-	entry->ipv4.ib2 &= ~EN751221_FOE_IB2_QID;
-	entry->ipv4.ib2 |= FIELD_PREP(EN751221_FOE_IB2_QID, queue);
+	u32 *ib2 = econet_foe_entry_ib2(entry);
+
+	*ib2 &= ~EN751221_FOE_IB2_QID;
+	*ib2 |= FIELD_PREP(EN751221_FOE_IB2_QID, queue);
 }
 
 static int econet_foe_entry_set_xpon(struct econet_foe_entry *entry,
@@ -2665,11 +2712,11 @@ static int econet_foe_entry_set_xpon(struct econet_foe_entry *entry,
 	 */
 	econet_foe_entry_set_pse_port(entry, EN751221_DPORT_QDMA_HW);
 	econet_foe_entry_set_queue(entry, info.queue);
-	entry->ipv4.udf_tsid &= ~(EN751221_FOE_UDF_TSID |
-				  EN751221_FOE_UDF_CHANNEL);
-	entry->ipv4.udf_tsid |= FIELD_PREP(EN751221_FOE_UDF_CHANNEL,
-				      info.tcont);
-	entry->ipv4.l2.etype = info.gem_port_id;
+	*econet_foe_entry_udf(entry) &= ~(EN751221_FOE_UDF_TSID |
+					 EN751221_FOE_UDF_CHANNEL);
+	*econet_foe_entry_udf(entry) |= FIELD_PREP(EN751221_FOE_UDF_CHANNEL,
+					     info.tcont);
+	econet_foe_entry_l2(entry)->etype = info.gem_port_id;
 
 	return 0;
 }
@@ -2685,7 +2732,7 @@ static int econet_foe_entry_set_vlan(struct econet_foe_entry *entry, u16 vid,
 			AIROHA_FOE_IB1_BIND_VPM);
 	entry->ib1 |= FIELD_PREP(EN751221_FOE_IB1_BIND_VLAN_LAYER, 1) |
 		      FIELD_PREP(AIROHA_FOE_IB1_BIND_VPM, 1);
-	entry->ipv4.l2.vlan1 = FIELD_PREP(VLAN_PRIO_MASK, prio) | vid;
+	econet_foe_entry_l2(entry)->vlan1 = FIELD_PREP(VLAN_PRIO_MASK, prio) | vid;
 
 	return 0;
 }
@@ -2693,7 +2740,7 @@ static int econet_foe_entry_set_vlan(struct econet_foe_entry *entry, u16 vid,
 static void econet_foe_entry_set_dsa(struct econet_foe_entry *entry, int port,
 				     bool passthrough)
 {
-	struct econet_foe_mac_info *l2 = &entry->ipv4.l2;
+	struct econet_foe_mac_info *l2 = econet_foe_entry_l2(entry);
 
 	l2->etype = BIT(port) & GENMASK(5, 0);
 	if (passthrough)
@@ -2708,7 +2755,7 @@ static void econet_foe_entry_set_dsa(struct econet_foe_entry *entry, int port,
 
 static void econet_foe_entry_set_pppoe(struct econet_foe_entry *entry, u16 sid)
 {
-	struct econet_foe_mac_info *l2 = &entry->ipv4.l2;
+	struct econet_foe_mac_info *l2 = econet_foe_entry_l2(entry);
 
 	if (!(entry->ib1 & EN751221_FOE_IB1_BIND_VLAN_LAYER) ||
 	    (entry->ib1 & EN751221_FOE_IB1_BIND_VLAN_TAG))
@@ -2719,16 +2766,17 @@ static void econet_foe_entry_set_pppoe(struct econet_foe_entry *entry, u16 sid)
 
 static void econet_foe_entry_set_bind_metadata(struct econet_foe_entry *entry)
 {
-	u8 port = FIELD_GET(EN751221_FOE_IB2_DEST_PORT, entry->ipv4.ib2);
+	u32 *udf = econet_foe_entry_udf(entry);
+	u32 *ib2 = econet_foe_entry_ib2(entry);
+	u8 port = FIELD_GET(EN751221_FOE_IB2_DEST_PORT, *ib2);
 
 	entry->ib1 &= ~EN751221_FOE_IB1_BIND_VLAN_LAYER;
 	entry->ib1 |= FIELD_PREP(EN751221_FOE_IB1_BIND_VLAN_LAYER, 1);
 
 	/* act_dp is a pseudo-interface UDF, not the PSE destination. */
-	entry->ipv4.udf_tsid &= ~EN751221_FOE_UDF_ACT_DP;
+	*udf &= ~EN751221_FOE_UDF_ACT_DP;
 	if (port != EN751221_DPORT_QDMA_HW)
-		entry->ipv4.udf_tsid |= FIELD_PREP(EN751221_FOE_UDF_ACT_DP,
-					     port + 6);
+		*udf |= FIELD_PREP(EN751221_FOE_UDF_ACT_DP, port + 6);
 }
 
 static u32 econet_ppe_raw_packet_type(const struct econet_foe_entry *raw)
@@ -2758,22 +2806,28 @@ static void econet_ppe_commit_entry(struct econet_ppe *ppe,
 	econet_ppe_encode_entry(entry, &raw);
 
 	/*
-	 * The EN7512 PPE creates the IPv4 lookup key itself in an UNB entry and
-	 * PpeClearEntryInfo() only memsets from ib2 onwards, so keep the source
-	 * and destination addresses the hardware hashed.
-	 *
-	 * The port word at offset 12 is only part of the key for IPV4_HNAPT.
-	 * The PPE learns new IPv4 flows as IPV4_ROUTE, where that word is the
-	 * reserved field of _ipv4_hnapt and holds no ports.  The vendor bind
-	 * path guards the copy on the packet type the hardware assigned, so do
-	 * the same and let the parsed tuple supply the ports otherwise.
+	 * Preserve the lookup key generated by the EN7512 PPE. The vendor
+	 * PpeClearEntryInfo() keeps bytes 0..11 for IPv4 and bytes 0..39 for
+	 * IPv6 3T/5T before filling the rewrite payload. For IPv4 HNAPT the
+	 * port word at offset 12 is also part of the key; IPv4 ROUTE leaves it
+	 * reserved. IPv6 5T keeps SIP, DIP and ports in words 1..9.
 	 */
 	if (lookup_raw) {
-		raw_words[1] = lookup_words[1];
-		raw_words[2] = lookup_words[2];
-		if (econet_ppe_raw_packet_type(lookup_raw) ==
-		    PPE_PKT_TYPE_IPV4_HNAPT)
+		switch (econet_ppe_raw_packet_type(lookup_raw)) {
+		case PPE_PKT_TYPE_IPV4_HNAPT:
 			raw_words[3] = lookup_words[3];
+			fallthrough;
+		case PPE_PKT_TYPE_IPV4_ROUTE:
+			raw_words[1] = lookup_words[1];
+			raw_words[2] = lookup_words[2];
+			break;
+		case PPE_PKT_TYPE_IPV6_ROUTE_5T:
+			for (i = 1; i <= 9; i++)
+				raw_words[i] = lookup_words[i];
+			break;
+		default:
+			break;
+		}
 	}
 	words = (const u32 *)&raw;
 
@@ -2897,16 +2951,29 @@ static u16 econet_ppe_find_bind_way(struct econet_ppe *ppe,
 	return EN751221_PPE_INVALID_HASH;
 }
 
-static bool econet_ppe_parse_ipv4_tuple(struct sk_buff *skb, u32 *src_ip,
-					u32 *dest_ip, u16 *src_port,
-					u16 *dest_port)
+struct econet_ppe_tuple {
+	u16 addr_type;
+	union {
+		struct {
+			u32 src;
+			u32 dest;
+		} v4;
+		struct {
+			struct in6_addr src;
+			struct in6_addr dest;
+		} v6;
+	};
+	u16 src_port;
+	u16 dest_port;
+};
+
+static bool econet_ppe_parse_tuple(struct sk_buff *skb,
+				   struct econet_ppe_tuple *tuple)
 {
 	const u8 *data = skb->data;
 	unsigned int len = skb->len;
-	const u8 *iph, *l4;
 	unsigned int proto_off = 12, off;
 	u16 proto;
-	u8 ihl;
 
 	if (len < ETH_HLEN)
 		return false;
@@ -2917,7 +2984,8 @@ static bool econet_ppe_parse_ipv4_tuple(struct sk_buff *skb, u32 *src_ip,
 			return false;
 		proto_off += VLAN_HLEN;
 		proto = get_unaligned_be16(data + proto_off);
-	} else if (proto != ETH_P_IP && proto != ETH_P_PPP_SES) {
+	} else if (proto != ETH_P_IP && proto != ETH_P_IPV6 &&
+		   proto != ETH_P_PPP_SES) {
 		/* MTK special tag occupies the ethertype/TCI position. */
 		if (len < ETH_HLEN + 4)
 			return false;
@@ -2927,39 +2995,101 @@ static bool econet_ppe_parse_ipv4_tuple(struct sk_buff *skb, u32 *src_ip,
 	off = proto_off + sizeof(__be16);
 
 	if (proto == ETH_P_PPP_SES) {
-		if (len < proto_off + 10 ||
-		    get_unaligned_be16(data + proto_off + 8) != PPP_IP)
+		u16 ppp_proto;
+
+		if (len < proto_off + 10)
+			return false;
+		ppp_proto = get_unaligned_be16(data + proto_off + 8);
+		if (ppp_proto == PPP_IP)
+			proto = ETH_P_IP;
+		else if (ppp_proto == PPP_IPV6)
+			proto = ETH_P_IPV6;
+		else
 			return false;
 		off = proto_off + 10;
-		proto = ETH_P_IP;
 	}
-	if (proto != ETH_P_IP || len < off + sizeof(struct iphdr))
-		return false;
 
-	iph = data + off;
-	if ((iph[0] >> 4) != 4 ||
-	    (iph[9] != IPPROTO_TCP && iph[9] != IPPROTO_UDP))
-		return false;
-	ihl = (iph[0] & 0x0f) * 4;
-	if (ihl < sizeof(struct iphdr) || len < off + ihl + 4)
+	memset(tuple, 0, sizeof(*tuple));
+	if (proto == ETH_P_IP) {
+		const u8 *iph, *l4;
+		u8 ihl;
+
+		if (len < off + sizeof(struct iphdr))
+			return false;
+		iph = data + off;
+		if ((iph[0] >> 4) != 4 ||
+		    (iph[9] != IPPROTO_TCP && iph[9] != IPPROTO_UDP))
+			return false;
+		ihl = (iph[0] & 0x0f) * 4;
+		if (ihl < sizeof(struct iphdr) || len < off + ihl + 4)
+			return false;
+
+		l4 = iph + ihl;
+		tuple->addr_type = FLOW_DISSECTOR_KEY_IPV4_ADDRS;
+		tuple->v4.src = get_unaligned_be32(iph + offsetof(struct iphdr, saddr));
+		tuple->v4.dest = get_unaligned_be32(iph + offsetof(struct iphdr, daddr));
+		tuple->src_port = get_unaligned_be16(l4);
+		tuple->dest_port = get_unaligned_be16(l4 + 2);
+		return true;
+	}
+
+	if (proto == ETH_P_IPV6) {
+		unsigned short fragoff = 0;
+		unsigned int l4off = off;
+		int flags = 0, nexthdr;
+
+		if (len < off + sizeof(struct ipv6hdr) ||
+		    (data[off] >> 4) != 6)
+			return false;
+
+		nexthdr = ipv6_find_hdr(skb, &l4off, -1, &fragoff, &flags);
+		if ((nexthdr != IPPROTO_TCP && nexthdr != IPPROTO_UDP) ||
+		    (flags & IP6_FH_F_FRAG) || len < l4off + 4)
+			return false;
+
+		tuple->addr_type = FLOW_DISSECTOR_KEY_IPV6_ADDRS;
+		memcpy(&tuple->v6.src,
+		       data + off + offsetof(struct ipv6hdr, saddr),
+		       sizeof(tuple->v6.src));
+		memcpy(&tuple->v6.dest,
+		       data + off + offsetof(struct ipv6hdr, daddr),
+		       sizeof(tuple->v6.dest));
+		tuple->src_port = get_unaligned_be16(data + l4off);
+		tuple->dest_port = get_unaligned_be16(data + l4off + 2);
+		return true;
+	}
+
+	return false;
+}
+
+static bool
+econet_ppe_flow_matches_tuple(const struct econet_flow_entry *flow,
+			      const struct econet_ppe_tuple *tuple)
+{
+	if (flow->addr_type != tuple->addr_type ||
+	    flow->src_port != tuple->src_port ||
+	    flow->dest_port != tuple->dest_port)
 		return false;
 
-	l4 = iph + ihl;
-	*src_ip = get_unaligned_be32(iph + offsetof(struct iphdr, saddr));
-	*dest_ip = get_unaligned_be32(iph + offsetof(struct iphdr, daddr));
-	*src_port = get_unaligned_be16(l4);
-	*dest_port = get_unaligned_be16(l4 + 2);
-	return true;
+	if (tuple->addr_type == FLOW_DISSECTOR_KEY_IPV4_ADDRS)
+		return flow->src_ip == tuple->v4.src &&
+		       flow->dest_ip == tuple->v4.dest;
+
+	if (tuple->addr_type == FLOW_DISSECTOR_KEY_IPV6_ADDRS)
+		return ipv6_addr_equal(&flow->src_ip6, &tuple->v6.src) &&
+		       ipv6_addr_equal(&flow->dest_ip6, &tuple->v6.dest);
+
+	return false;
 }
 
 static void econet_ppe_rx_check(struct econet_ppe *ppe, struct sk_buff *skb,
 				u16 hash, u8 reason)
 {
+	struct econet_ppe_tuple tuple;
 	struct econet_flow_entry *flow;
 	struct econet_foe_entry entry, lookup_raw = {};
-	u32 src_ip, dest_ip;
 	bool lookup_valid;
-	u16 src_port, dest_port, bind_hash;
+	u16 bind_hash;
 
 	if (!ppe || !READ_ONCE(ppe->armed) ||
 	    hash >= ppe->common.eth->soc->ppe_dram_entries)
