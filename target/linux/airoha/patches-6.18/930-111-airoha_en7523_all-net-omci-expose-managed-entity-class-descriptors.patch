+	OMCI_CLASS_CATEGORY_UNSPEC,
+	OMCI_CLASS_CATEGORY_EQUIPMENT,
+	OMCI_CLASS_CATEGORY_ANI,
+	OMCI_CLASS_CATEGORY_UNI,
+	OMCI_CLASS_CATEGORY_LAYER2,
+	OMCI_CLASS_CATEGORY_LAYER3,
+	OMCI_CLASS_CATEGORY_MULTICAST,
+	OMCI_CLASS_CATEGORY_VOICE,
+	OMCI_CLASS_CATEGORY_SECURITY,
+	OMCI_CLASS_CATEGORY_MANAGEMENT,
+	OMCI_CLASS_CATEGORY_PERFORMANCE,
+	OMCI_CLASS_CATEGORY_XDSL,
+	OMCI_CLASS_CATEGORY_LEGACY,
