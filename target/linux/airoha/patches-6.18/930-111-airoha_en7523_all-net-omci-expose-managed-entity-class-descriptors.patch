+#define OMCI_CLASS_F_VENDOR_SPECIFIC	(1U << 3)
+#define OMCI_CLASS_F_PERFORMANCE	(1U << 4)
+#define OMCI_CLASS_F_TABLE		(1U << 5)
+#define OMCI_CLASS_F_DATAPATH		(1U << 6)
+
