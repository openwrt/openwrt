@@ -1813,8 +1911,15 @@ static int gpon_sfp_module_start(void *upstream)
 		 gpon_state_name(state));
 
 	/* PHY ready: if we were in emergency stop, stay there */
-	if (state == GPON_O1_INITIAL)
