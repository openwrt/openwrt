 				 "GPON MAC error interrupt: %#08x\n",
 				 active & (u32)GPON_INT_ERROR_MASK);
 
-		if (active & INT_TX_LATE_START)
+		if (active & INT_TX_LATE_START) {
+			gpon_dump_activation_regs(priv, "TX late start");
 			dev_warn(priv->dev,
