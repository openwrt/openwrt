+	ret = airoha_p0_read_mmd(phydev, MDIO_MMD_VEND1, MTK_PHY_RG_AD_CAL_CLK);
 	if (ret < 0)
 		goto out;
 
@@ -535,15 +588,15 @@ static int airoha_cal_cycle_wait(struct phy_device *phydev)
