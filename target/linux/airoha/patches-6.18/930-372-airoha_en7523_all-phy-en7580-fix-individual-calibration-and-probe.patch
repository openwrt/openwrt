-			       MTK_PHY_DA_CALIN_FLAG);
+	ret = airoha_p0_modify_mmd(phydev, MDIO_MMD_VEND1, MTK_PHY_RG_AD_CALIN,
+				   0, MTK_PHY_DA_CALIN_FLAG);
 	if (ret)
 		return ret;
 
 	udelay(20);
 
