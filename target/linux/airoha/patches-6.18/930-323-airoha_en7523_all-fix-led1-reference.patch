From 71a027f3cc23b8a7a0660d94e35ec76305157f50 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Wed, 26 Aug 2026 00:22:11 -0300
Subject: [PATCH] fix led1 reference

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 arch/mips/boot/dts/econet/en7528.dtsi | 14 +++++-----
 arch/mips/econet/init.c               | 12 ++++++++-
 include/linux/soc/airoha/pkgids.h     | 39 +++++++++++++++++++++++++++
 3 files changed, 57 insertions(+), 8 deletions(-)

diff --git a/arch/mips/boot/dts/econet/en7528.dtsi b/arch/mips/boot/dts/econet/en7528.dtsi
index 21d9d861261b..499e4e619a43 100644
--- a/arch/mips/boot/dts/econet/en7528.dtsi
+++ b/arch/mips/boot/dts/econet/en7528.dtsi
@@ -457,12 +457,12 @@ xpon: xmac@1fb60000 {
 			status = "disabled";
 		};
 
-		/* <GIC_SHARED 53 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 0 port 0 */
-		/* <GIC_SHARED 54 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 0 port 1 */
-		/* <GIC_SHARED 55 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 0 for WOE */
-		/* <GIC_SHARED 56 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 1 port 0 */
-		/* <GIC_SHARED 56 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 1 port 1 */
-		/* <GIC_SHARED 58 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 1 for WOE */
+	  /* <GIC_SHARED 53 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 0 port 0 */
+	  /* <GIC_SHARED 54 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 0 port 1 */
+	  /* <GIC_SHARED 55 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 0 for WOE */
+	  /* <GIC_SHARED 56 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 1 port 0 */
+	  /* <GIC_SHARED 56 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 1 port 1 */
+	  /* <GIC_SHARED 58 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 1 for WOE */
 		wed0: wed@1fa02000 {
 			compatible = "airoha,en7523-wed", "syscon";
 			reg = <0x1fa02000 0xb00>,
@@ -470,7 +470,7 @@ wed0: wed@1fa02000 {
 			reg-names = "wed", "wdma";
 			interrupts = <GIC_SHARED 51 IRQ_TYPE_LEVEL_HIGH>;
 		};
-
+	
 		wed1: wed@1fa03000 {
 			compatible = "airoha,en7523-wed", "syscon";
 			reg = <0x1fa03000 0xb00>,
diff --git a/arch/mips/econet/init.c b/arch/mips/econet/init.c
index 2ff154774d86..3e813081036b 100644
--- a/arch/mips/econet/init.c
+++ b/arch/mips/econet/init.c
@@ -18,8 +18,11 @@
 #include <asm/reboot.h>
 #include <asm/mips-cps.h>
 
+#include "linux/soc/airoha/pkgids.h"
+
 #define CR_AHB_RSTCR		((void __iomem *)CKSEG1ADDR(0x1fb00040))
 #define RESET			BIT(31)
+#define NP_SCU_BASE		((void __iomem *)CKSEG1ADDR(0x1fa20000))
 
 #ifdef CONFIG_CPU_LITTLE_ENDIAN
 #define UART_BASE		CKSEG1ADDR(0x1fbf0000)	/* LE: byte at offset 0 */
@@ -77,7 +80,14 @@ void __init device_tree_init(void)
 
 const char *get_system_type(void)
 {
-	return "EcoNet-EN75xx";
+	static char system_type[64];
+	const char *soc;
+
+	soc = airoha_soc_name(get_pkg_mem(NP_SCU_BASE),
+			      get_pkgid_mem(NP_SCU_BASE));
+
+	snprintf(system_type, sizeof(system_type), "EcoNet %s", soc);
+	return system_type;
 }
 
 /* 4. Initialize the IRQ subsystem */
diff --git a/include/linux/soc/airoha/pkgids.h b/include/linux/soc/airoha/pkgids.h
index 4cb64a974aeb..ecee6bff6325 100644
--- a/include/linux/soc/airoha/pkgids.h
+++ b/include/linux/soc/airoha/pkgids.h
@@ -302,6 +302,45 @@ static inline const char *airoha_pkg_id_name(enum airoha_pkg_ids id)
 	return airoha_pkg_id_names[id];
 }
 
+static inline const char *
+airoha_pkg_id_range_name(u32 pkgid, enum airoha_pkg_ids first,
+			 enum airoha_pkg_ids last)
+{
+	if (pkgid > (u32)(last - first))
+		return "unknown";
+
+	return airoha_pkg_id_name((enum airoha_pkg_ids)(first + pkgid));
+}
+
+static inline const char *airoha_soc_name(enum airoha_pkg pkg, u32 pkgid)
+{
+	switch (pkg) {
+	case AN7583_PKG:
+		return airoha_pkg_id_range_name(pkgid, AN7583GT, AN7583FF);
+	case AN7552_PKG:
+		return airoha_pkg_id_range_name(pkgid, AN7552CT, AN7563PT);
+	case EN7581_PKG:
+		return airoha_pkg_id_range_name(pkgid, AN7581GT, AN7581SIT);
+	case EN7523_PKG:
+		return airoha_pkg_id_range_name(pkgid, EN7529DU, EN7523DTM);
+	case EN7528_PKG:
+		return airoha_pkg_id_range_name(pkgid, EN7528HU,
+						EN7521GEN7528DU);
+	case EN7580_PKG:
+		return airoha_pkg_id_range_name(pkgid, EN7580GT, EN7580);
+	case EN751627_PKG:
+		return airoha_pkg_id_range_name(pkgid, EN7516G, EN751627);
+	case EN7526C_PKG:
+		return airoha_pkg_id_range_name(pkgid, EN7521FCUD, EN751221);
+	case EN751221_PKG:
+		return airoha_pkg_id_range_name(pkgid, EN7512, EN751221);
+	case MT751020_PKG:
+		return airoha_pkg_id_range_name(pkgid, MT7520S, MT7525G);
+	default:
+		return "unknown";
+	}
+}
+
 static inline u32 airoha_pkgid_from_screg(u32 value)
 {
 	u32 pkgid = FIELD_GET(AIROHA_NP_SCU_PACKAGE_ID_MASK, value);
-- 
2.55.0

