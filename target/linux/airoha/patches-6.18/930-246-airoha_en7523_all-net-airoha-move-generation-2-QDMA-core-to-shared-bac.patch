-				FIELD_PREP(RX_RING_CPU_IDX_MASK, q->head));
-	}
+	msleep(20);
+	err = airoha_fe_init(eth);
+	if (err)
+		return err;
 
-	return nframes;
-}
+	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
+		eth->qdma[i].q_tx = devm_kzalloc(&pdev->dev,
+			sizeof(*eth->qdma[i].q_tx) * eth->soc->tx_ring,
