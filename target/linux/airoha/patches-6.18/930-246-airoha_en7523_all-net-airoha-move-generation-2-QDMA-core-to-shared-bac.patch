-			       DMA_TO_DEVICE);
-	else
-		dma_unmap_single(eth->dev, e->dma_addr, e->dma_len,
-				 DMA_TO_DEVICE);
-
-	e->dma_addr = 0;
-	e->dma_len = 0;
-	e->dma_map_page = false;
-}
