@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/dma/econet,ecnt-gdma.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: EcoNet general-purpose DMA block
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+description: |
+  The EcoNet GDMA block provides fixed-request and memory-copy channels used
+  by several peripherals. In particular, the EN7512 and EN7516 DMT engines use
+  GDMA channel zero for QAM data transfers, but the block is not part of the
+  DMT register window and must be described as an independent SoC device.
+
+properties:
+  compatible:
+    const: econet,ecnt-gdma
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    gdma@1fb30000 {
+        compatible = "econet,ecnt-gdma";
+        reg = <0x1fb30000 0x2b0>;
+    };
diff --git a/Documentation/devicetree/bindings/dma/econet,ecnt-hsdma.yaml b/Documentation/devicetree/bindings/dma/econet,ecnt-hsdma.yaml
