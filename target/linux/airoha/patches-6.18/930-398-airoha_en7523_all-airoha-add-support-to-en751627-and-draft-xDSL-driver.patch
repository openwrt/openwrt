+/dts-v1/;
+
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/interrupt-controller/mips-gic.h>
+#include <dt-bindings/clock/econet,en751627-scu.h>
+#include <dt-bindings/phy/phy.h>
+#include <dt-bindings/reset/econet,en751627-scu.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/soc/airoha,scu-ssr.h>
+#include <dt-bindings/soc/airoha,soc-variant.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	compatible = "econet,en751627";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		linux,usable-memory-range = <0x00020000 0x1fe00000>;
+	};
+
+	aliases {
+		serial0 = &uart1;
+	};
+
+	hpt_clock: clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <200000000>;  /* 200 MHz */
+	};
+
+	i2cclock: i2c-clock {
+		#clock-cells = <0>;
+		compatible = "fixed-clock";
+
+		/* 20 MHz */
+		clock-frequency = <20000000>;
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			device_type = "cpu";
+			compatible = "mips,mips1004Kc";
+			reg = <0>;
+		};
+
+		cpu@1 {
+			device_type = "cpu";
+			compatible = "mips,mips1004Kc";
+			reg = <1>;
+		};
+	};
+
+	cpuintc: interrupt-controller {
+		compatible = "mti,cpu-interrupt-controller";
+		interrupt-controller;
+		#address-cells = <0>;
+		#interrupt-cells = <1>;
+	};
+
+	gic: interrupt-controller@1f8c0000 {
+		compatible = "mti,gic";
+		reg = <0x1f8c0000 0x20000>;
+
+		interrupt-controller;
+		#interrupt-cells = <3>;
+
+		interrupt-parent = <&cpuintc>;
+		interrupts = <2>;
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		interrupt-parent = <&gic>;
+		ranges;
+
+		pcie_phy0: pcie-phy@1faf2000 {
+			compatible = "econet,en751627-pcie-phy0";
+			reg = <0x1faf2000 0x1000>;
+			#phy-cells = <0>;
+		};
+
+		pcie_phy1: pcie-phy@1fac0000 {
+			compatible = "econet,en751627-pcie-phy1";
+			reg = <0x1fac0000 0x1000>;
+			#phy-cells = <0>;
+		};
+
+		chip_scu: syscon@1fa20000 {
+			compatible = "airoha,scuclk", "econet,en751627-chip-scu", "syscon";
+			reg = <0x1fa20000 0x400>;
+		};
+
+		scuclk: system-controller@1fb00000 {
+			compatible = "econet,en751627-scu", "syscon";
+			reg = <0x1fb00000 0x1000>;
+
+			airoha,chip-scu = <&chip_scu>;
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+		};
+
+		system-controller@1fbf0200 {
+			compatible = "syscon", "simple-mfd";
+			reg = <0x1fbf0200 0xc0>;
+
+			pinctrl: pinctrl {
+				compatible = "econet,en751627-pinctrl";
+				airoha,chip-scu = <&chip_scu>;
+
+				interrupt-parent = <&gic>;
+				interrupts = <GIC_SHARED 10 IRQ_TYPE_LEVEL_HIGH>;
+
+				gpio-controller;
+				#gpio-cells = <2>;
+
+				interrupt-controller;
+				#interrupt-cells = <2>;
+
+				gpio-ranges = <&pinctrl 0 0 42>;
+
+				pcie0_rst_pins: pcie0-rst-pins {
+					conf {
+						pins = "pcie_reset0";
+						drive-open-drain = <1>;
+					};
+				};
+
+				pcie1_rst_pins: pcie1-rst-pins {
+					conf {
+						pins = "pcie_reset1";
+						drive-open-drain = <1>;
+					};
+				};
+
+				uart2_pins: uart2 {
+					mux {
+						function = "uart";
+						groups = "uart2";
+					};
+				};
+
+				uart3_pins: uart3 {
+					mux {
+						function = "uart";
+						groups = "uart3";
+					};
+				};
+
+				pon_pinctrl: pon {
+					mux {
+						function = "pon";
+						groups = "pon";
+					};
+				};
+
+				swp1_led0: switch_port-1-led0 {
+					mux {
+						function = "phy1_led0";
+						groups = "gpio30";
+					};
+				};
+
+				swp1_led1: switch_port-1-led1 {
+					mux {
+						function = "phy1_led1";
+						groups = "gpio31";
+					};
+				};
+
+				swp2_led0: switch_port-2-led0 {
+					mux {
+						function = "phy2_led0";
+						groups = "gpio32";
+					};
+				};
+
+				swp2_led1: switch_port-2-led1 {
+					mux {
+						function = "phy2_led1";
+						groups = "gpio33";
+					};
+				};
+
+				swp3_led0: switch_port-3-led0 {
+					mux {
+						function = "phy3_led0";
+						groups = "gpio34";
+					};
+				};
+
+				swp3_led1: switch_port-3-led1 {
+					mux {
+						function = "phy3_led1";
+						groups = "gpio35";
+					};
+				};
+
+				swp4_led0: switch_port-4-led0 {
+					mux {
+						function = "phy4_led0";
+						groups = "gpio36";
+					};
+				};
+
+				swp4_led1: switch_port-4-led1 {
+					mux {
+						function = "phy4_led1";
+						groups = "gpio37";
+					};
+				};
+			};
+		};
+
+		timer_hpt: timer@1fbf0400 {
+			compatible = "econet,en751627-timer";
+			reg = <0x1fbf0400 0x14>,
+			      <0x1fbe0000 0x14>;
+
+			interrupts = <GIC_SHARED 30 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SHARED 29 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SHARED 37 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SHARED 36 IRQ_TYPE_LEVEL_HIGH>;
+
+			clocks = <&hpt_clock>;
+		};
+
+		spi: spi@1fa10000 {
+			compatible = "airoha,en7523-spi";
+			reg = <0x1fa10000 0x140>,
+			      <0x1fa11000 0x160>;
+
+			clocks = <&scuclk EN751627_CLK_SPI>;
+			clock-names = "spi";
+
+			airoha,scu = <&scuclk>, <&chip_scu>;
+			airoha,scu-names = "scuclk", "chip-scu";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+		};
+
+		watchdog: watchdog@1fbf0100 {
+			compatible = "econet,en751221-wdt";
+			reg = <0x1fbf0100 0x3c>;
+
+			clocks = <&scuclk EN751627_CLK_BUS>;
+			clock-names = "bus";
+
+			interrupts = <GIC_SHARED 9 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		crypto@1fb70000 {
+			compatible = "inside-secure,safexcel-eip93ies";
+			reg = <0x1fb70000 0x1000>;
+			interrupts = <GIC_SHARED 28 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		i2c0: i2c0@1fbf8000 {
+			compatible = "airoha,en7523-i2c";
+			reg = <0x1fbf8000 0x100>;
+
+			clocks = <&i2cclock>;
+
+			/* 100 kHz */
+			clock-frequency = <100000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			status = "disabled";
+		};
+
+		usb_phy: usb-phy@1fa80000 {
+			compatible = "econet,en751627-usb-phy";
+			reg = <0x1fa80000 0x1400>;
+			#phy-cells = <1>;
+		};
+
+		usb: usb@1fb90000 {
+			compatible = "econet,en751627-xhci";
+			reg = <0x1fb90000 0x3e00>,
+			      <0x1fb93e00 0x100>;
+			reg-names = "mac", "ippc";
+			interrupts = <GIC_SHARED 17 IRQ_TYPE_LEVEL_HIGH>;
+			phys = <&usb_phy PHY_TYPE_USB2>, <&usb_phy PHY_TYPE_USB3>;
+			usb3-lpm-capable;
+			status = "disabled";
+		};
+
+		uart1: serial@1fbf0000 {
+			compatible = "airoha,en7523-uart";
+			reg = <0x1fbf0000 0x30>;
+			reg-io-width = <4>;
+			reg-shift = <2>;
+
+			interrupts = <GIC_SHARED 2 IRQ_TYPE_LEVEL_HIGH>;
+
+			/*
+			 * The EcoNet/Airoha UART uses the vendor XYD fractional divider.
+			 * The generic 8250 driver does not program XYD, so keep the bootloader
+			 * XYD setup and expose a fixed 115200 baud base clock.
+			 */
+			clock-frequency = <1843200>;
+		};
+
+		uart2: serial@1fbf0300 {
+			compatible = "airoha,en7523-uart";
+			reg = <0x1fbf0300 0x30>;
+			interrupts = <GIC_SHARED 16 IRQ_TYPE_LEVEL_HIGH>;
+
+			pinctrl-names = "default";
+			pinctrl-0 = <&uart2_pins>;
+
+			status = "disabled";
+		};
+
+		uart3: serial@1fbe1000 {
+			compatible = "airoha,en7523-uart";
+			reg = <0x1fbe1000 0x30>;
+			interrupts = <GIC_SHARED 38 IRQ_TYPE_LEVEL_HIGH>;
+
+			pinctrl-names = "default";
+			pinctrl-0 = <&uart3_pins>;
+
+			status = "disabled";
+		};
+
+		pciecfg: pciecfg@1fb80000 {
+			compatible = "mediatek,generic-pciecfg", "syscon";
+			reg = <0x1fb80000 0x1000>;
+		};
+
+		pcie0: pcie@1fb81000 {
+			compatible = "econet,en751627-pcie";
+			device_type = "pci";
+			reg = <0x1fb81000 0x1000>;
+			reg-names = "port0";
+			linux,pci-domain = <0>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			interrupts = <GIC_SHARED 23 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "pcie_irq";
+			clocks = <&scuclk EN751627_CLK_PCIE>;
+			clock-names = "sys_ck0";
+			phys = <&pcie_phy0>;
+			phy-names = "pcie-phy0";
+			bus-range = <0x00 0xff>;
+			ranges = <0x01000000 0 0x00000000 0x1f600000 0 0x00010000>,
+				 <0x82000000 0 0x20000000 0x20000000 0 0x08000000>;
+			status = "disabled";
+
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &pcie_intc0 0>,
+					<0 0 0 2 &pcie_intc0 1>,
+					<0 0 0 3 &pcie_intc0 2>,
+					<0 0 0 4 &pcie_intc0 3>;
+
+			pcie_intc0: interrupt-controller {
+				interrupt-controller;
+				#address-cells = <0>;
+				#interrupt-cells = <1>;
+			};
+
+			slot0: pcie@0,0 {
+				reg = <0x0000 0 0 0 0>;
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+			};
+		};
+
+		pcie1: pcie@1fb83000 {
+			compatible = "econet,en751627-pcie";
+			device_type = "pci";
+			reg = <0x1fb83000 0x1000>;
+			reg-names = "port1";
+			linux,pci-domain = <1>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			interrupts = <GIC_SHARED 24 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "pcie_irq";
+			clocks = <&scuclk EN751627_CLK_PCIE>;
+			clock-names = "sys_ck1";
+			phys = <&pcie_phy1>;
+			phy-names = "pcie-phy1";
+			bus-range = <0x00 0xff>;
+			ranges = <0x01000000 0 0x00000000 0x1f610000 0 0x00010000>,
+				 <0x82000000 0 0x28000000 0x28000000 0 0x08000000>;
+			status = "disabled";
+
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &pcie_intc1 0>,
+					<0 0 0 2 &pcie_intc1 1>,
+					<0 0 0 3 &pcie_intc1 2>,
+					<0 0 0 4 &pcie_intc1 3>;
+
+			pcie_intc1: interrupt-controller {
+				interrupt-controller;
+				#address-cells = <0>;
+				#interrupt-cells = <1>;
+			};
+
+			slot1: pcie@1,0 {
+				reg = <0x0800 0 0 0 0>;
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+			};
+		};
+
+		gdma: gdma@1fb30000 {
+			compatible = "econet,en751627-gdma";
+			reg = <0x1fb30000 0x1000>;
+
+			interrupts = <GIC_SHARED 14 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		xpon_phy: phy@1faf0000 {
+			compatible = "airoha,en751627-xpon-phy";
+			reg = <0x1faf0000 0x600>;
+
+			pinctrl-names = "default";
+			pinctrl-0 = <&pon_pinctrl>;
+
+			resets = <&scuclk EN751627_XPON_PHY_RST>;
+			reset-names = "phy";
+
+			interrupts = <GIC_SHARED 27 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "phy";
+			airoha,scu = <&scuclk>;
+			#phy-cells = <0>;
+
+			status = "disabled";
+		};
+
+		xpon: xmac@1fb60000 {
+			compatible = "airoha,en751627-xpon";
+
+			reg = <0x1fb60000 0x10000>,
+			      <0x1fa2ff24 0x4>;
+			reg-names = "mac", "tx-off";
+
+			interrupts = <GIC_SHARED 26 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SHARED 18 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "mac", "dying-gasp";
+
+			resets = <&scuclk EN751627_XPON_MAC_RST>;
+			reset-names = "mac";
+			phys = <&xpon_phy>;
+			phy-names = "xpon";
+			ethernet = <&gdm2>;
+			airoha,scu = <&scuclk>;
+
+			status = "disabled";
+		};
+
+		xdsl: dsl@1f900000 {
+			compatible = "econet,en751627-xdsl";
+			reg = <0x1f900000 0x10000>,
+			      <0x1fb62000 0x200>;
+			reg-names = "dmt", "ptm";
+
+			interrupts = <GIC_SHARED 19 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "dmt";
+
+			resets = <&scuclk EN751627_DMT_RST>,
+				 <&scuclk EN751627_PTM_MAC_RST>;
+			reset-names = "dmt", "ptm";
+
+			ethernet = <&gdm2>;
+			airoha,scu = <&scuclk>;
+
+			status = "disabled";
+		};
+
+		/* <GIC_SHARED 53 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 0 port 0 */
+		/* <GIC_SHARED 54 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 0 port 1 */
+		/* <GIC_SHARED 55 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 0 for WOE */
+		/* <GIC_SHARED 56 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 1 port 0 */
+		/* <GIC_SHARED 56 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 1 port 1 */
+		/* <GIC_SHARED 58 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 1 for WOE */
+		wed0: wed@1fa02000 {
+			compatible = "econet,en751627-wed", "syscon";
+			reg = <0x1fa02000 0xb00>,
+			      <0x1fa06000 0x400>;
+			reg-names = "wed", "wdma";
+			interrupts = <GIC_SHARED 51 IRQ_TYPE_LEVEL_HIGH>;
+			airoha,scu = <&scuclk>;
+		};
+
+		wed1: wed@1fa03000 {
+			compatible = "econet,en751627-wed", "syscon";
+			reg = <0x1fa03000 0xb00>,
+			      <0x1fa06400 0x400>;
+			reg-names = "wed", "wdma";
+			interrupts = <GIC_SHARED 52 IRQ_TYPE_LEVEL_HIGH>;
+			airoha,scu = <&scuclk>;
+		};
+
+		eth: ethernet@1fb50000 {
+			compatible = "econet,en751627-eth";
+			status = "disabled";
+			reg = <0x1fb50000 0x2600>,
+			      <0x1fb54000 0x1000>,
+			      <0x1fb55000 0x1000>,
+			      <0x1fa40000 0x8000>;
+			reg-names = "fe", "qdma0", "qdma1", "gdmp";
+
+			resets = <&scuclk EN751627_FE_RST>,
+				 <&scuclk EN751627_FE_QDMA1_RST>,
+				 <&scuclk EN751627_FE_QDMA2_RST>,
+				 <&scuclk EN751627_GDMP_RST>;
+			reset-names = "fe", "pdma", "qdma", "gdmp";
+
+			airoha,wed = <&wed0>, <&wed1>;
+			interrupts = <GIC_SHARED 21 IRQ_TYPE_LEVEL_HIGH>,  /* QDMA LAN0 */
+				     <GIC_SHARED 22 IRQ_TYPE_LEVEL_HIGH>,  /* QDMA WAN0 */
+				     <GIC_SHARED 39 IRQ_TYPE_LEVEL_HIGH>,  /* QDMA LAN1 */
+				     <GIC_SHARED 40 IRQ_TYPE_LEVEL_HIGH>,  /* QDMA LAN2 */
+				     <GIC_SHARED 41 IRQ_TYPE_LEVEL_HIGH>,  /* QDMA LAN3 */
+				     <GIC_SHARED 42 IRQ_TYPE_LEVEL_HIGH>,  /* QDMA WAN1 */
+				     <GIC_SHARED 43 IRQ_TYPE_LEVEL_HIGH>,  /* QDMA WAN2 */
+				     <GIC_SHARED 44 IRQ_TYPE_LEVEL_HIGH>,  /* QDMA WAN3 */
+				     <GIC_SHARED 33 IRQ_TYPE_LEVEL_HIGH>;  /* Frame Error */
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			gdm1: ethernet@1 {
+				compatible = "econet,eth-mac";
+				reg = <1>;
+				phy-mode = "internal";
+				status = "disabled";
+
+				fixed-link {
+					speed = <1000>;
+					full-duplex;
+					pause;
+				};
+			};
+
+			gdm2: ethernet@2 {
+				compatible = "econet,eth-mac";
+				reg = <2>;
+				phy-mode = "internal";
+
+				status = "disabled";
+			};
+		};
+
+		switch: switch@1fb58000 {
+			compatible = "econet,en751627-switch";
+			reg = <0x1fb58000 0x8000>;
+			resets = <&scuclk EN751627_GSW_RST>;
+
+			interrupt-controller;
+			#interrupt-cells = <1>;
+			interrupts = <GIC_SHARED 15 IRQ_TYPE_LEVEL_HIGH>;
+
+			status = "disabled";
+
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				gsw_port1: port@1 {
+					reg = <1>;
+					phy-mode = "internal";
+					phy-handle = <&gsw_phy1>;
+					status = "disabled";
+				};
+
+				gsw_port2: port@2 {
+					reg = <2>;
+					phy-mode = "internal";
+					phy-handle = <&gsw_phy2>;
+					status = "disabled";
+				};
+
+				gsw_port3: port@3 {
+					reg = <3>;
+					phy-mode = "internal";
+					phy-handle = <&gsw_phy3>;
+					status = "disabled";
+				};
+
+				gsw_port4: port@4 {
+					reg = <4>;
+					phy-mode = "internal";
+					phy-handle = <&gsw_phy4>;
+					status = "disabled";
+				};
+
+				gsw_port6: port@6 {
+					reg = <6>;
+					ethernet = <&gdm1>;
+					phy-mode = "internal";
+
+					fixed-link {
+						speed = <1000>;
+						full-duplex;
+						pause;
+					};
+				};
+			};
+
+			mdio: mdio {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				gsw_phy1: ethernet-phy@9 {
+					compatible = "ethernet-phy-ieee802.3-c22";
+					reg = <9>;
+					phy-mode = "internal";
+					status = "disabled";
+
+					pinctrl-names = "gbe-led";
+					pinctrl-0 = <&swp1_led0 &swp1_led1>;
+					airoha,scu = <&scuclk>;
+
+					leds {
+						#address-cells = <1>;
+						#size-cells = <0>;
+
+						gsw_phy1_led0: led0@0 {
+							reg = <0>;
+							function = LED_FUNCTION_LAN;
+							status = "disabled";
+							active-low;
+						};
+
+						gsw_phy1_led1: led1@1 {
+							reg = <1>;
+							status = "disabled";
+							function = LED_FUNCTION_ACTIVITY;
+							active-low;
+						};
+					};
+				};
+
+				gsw_phy2: ethernet-phy@10 {
