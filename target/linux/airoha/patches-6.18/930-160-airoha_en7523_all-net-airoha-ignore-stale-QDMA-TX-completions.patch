From 203e1b2d4401cd74d160132990a348ac53ed3107 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Mon, 3 Aug 2026 21:25:11 -0300
Subject: [PATCH] net: airoha: ignore stale QDMA TX completions

A long-running bidirectional GPON traffic test can eventually report the
same TX descriptor more than once. The completion path currently leaves
the queue entry skb pointer and descriptor DONE state intact after
recycling the entry.

If a stale completion arrives while another descriptor is queued, the old
entry is returned to the free list again and its skb is accounted to BQL a
second time. This violates the dql_completed() invariant and triggers a
fatal BUG.

Use the existing zero dma_addr value as the entry ownership marker before
inspecting descriptor writeback. Consume completions for entries that have
already been recycled without touching queue depth or BQL. Clear the skb,
DMA length and descriptor contents before returning a live entry to the
free list so completion processing is idempotent.

Signed-off-by: OpenAI <noreply@openai.com>
Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 6cadc46910d6..d371be78a522 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -2017,6 +2017,10 @@ static int airoha_qdma_tx_napi_poll(struct napi_struct *napi, int budget)
 		if (!q->queued)
 			goto unlock_consume;
 
+		e = &q->entry[index];
+		if (!e->dma_addr)
+			goto unlock_consume;
+
 		desc = &q->desc[index];
 		desc_ctrl = le32_to_cpu(READ_ONCE(desc->ctrl));
 
@@ -2026,16 +2030,20 @@ static int airoha_qdma_tx_napi_poll(struct napi_struct *napi, int budget)
 			break;
 		}
 
-		e = &q->entry[index];
 		skb = e->skb;
-
 		dma_unmap_single(eth->dev, e->dma_addr, e->dma_len,
 				 DMA_TO_DEVICE);
 		e->dma_addr = 0;
+		e->dma_len = 0;
+		e->skb = NULL;
 		list_add_tail(&e->list, &q->tx_list);
 
+		WRITE_ONCE(desc->ctrl, 0);
+		WRITE_ONCE(desc->addr, 0);
+		WRITE_ONCE(desc->data, 0);
 		WRITE_ONCE(desc->msg0, 0);
 		WRITE_ONCE(desc->msg1, 0);
+		WRITE_ONCE(desc->msg2, 0);
 		q->queued--;
 
 		if (skb) {
-- 
