From 071b397baac6ac89e6a9f42bad2b741fd03f2301 Mon Sep 17 00:00:00 2001
From: ChatGPT <noreply@openai.com>
Date: Thu, 6 Aug 2026 10:46:58 +0000
Subject: [PATCH] dt-bindings: net: add EcoNet EN751221 frame engine

Document the EN751221-family dual-GDM, dual-QDMA frame engine,
including the EN7528 variant, optional reset lines and per-port
Ethernet child nodes.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 .../bindings/net/econet,en751221-eth.yaml     | 108 ++++++++++++++++++
 MAINTAINERS                                   |   1 +
 2 files changed, 109 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/net/econet,en751221-eth.yaml

diff --git a/Documentation/devicetree/bindings/net/econet,en751221-eth.yaml b/Documentation/devicetree/bindings/net/econet,en751221-eth.yaml
new file mode 100644
index 000000000..40716b504
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/econet,en751221-eth.yaml
@@ -0,0 +1,108 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/econet,en751221-eth.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: EcoNet EN751221 Frame Engine Ethernet controller
+
+maintainers:
+  - Caleb James DeLisle <cjd@cjdns.fr>
+
+description:
+  The EN751221-family frame engine contains two GDM Ethernet ports and two
+  QDMA packet engines. The first pair is normally connected to the integrated
+  LAN switch and the second pair is normally used by WAN or xPON datapaths.
+
+properties:
+  compatible:
+    enum:
+      - econet,en751221-eth
+      - econet,en7528-eth
+
+  reg:
+    minItems: 1
+    maxItems: 1
+    description:
+      Frame engine register window. A 0x8000-byte window contains the frame
+      engine, both GDM ports and both QDMA engines. A 0x10000-byte window also
+      contains the integrated switch registers and allows legacy dumb-switch
+      setup when the switch is not owned by another driver.
+
+  interrupts:
+    items:
+      - description: QDMA0 interrupt
+      - description: QDMA1 interrupt
+
+  resets:
+    minItems: 1
+    maxItems: 6
+
+  reset-names:
+    minItems: 1
+    items:
+      - const: fe
+      - const: qdma0
+      - const: qdma1
+      - const: gsw
+      - const: xpon-mac
+      - const: xpon-phy
+
+  "#address-cells":
+    const: 1
+
+  "#size-cells":
+    const: 0
+
+patternProperties:
+  "^ethernet@[01]$":
+    type: object
+    $ref: ethernet-controller.yaml#
+    unevaluatedProperties: false
+
+    properties:
+      compatible:
+        const: econet,eth-mac
+
+      reg:
+        minimum: 0
+        maximum: 1
+        description: GDM port identifier
+
+    required:
+      - compatible
+      - reg
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - "#address-cells"
+  - "#size-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    ethernet@1fb50000 {
+        compatible = "econet,en751221-eth";
+        reg = <0x1fb50000 0x8000>;
+
+        interrupt-parent = <&intc>;
+        interrupts = <21>, <22>;
+
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        ethernet@0 {
+            compatible = "econet,eth-mac";
+            reg = <0>;
+            phy-mode = "internal";
+        };
+
+        ethernet@1 {
+            compatible = "econet,eth-mac";
+            reg = <1>;
+            phy-mode = "internal";
+        };
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
