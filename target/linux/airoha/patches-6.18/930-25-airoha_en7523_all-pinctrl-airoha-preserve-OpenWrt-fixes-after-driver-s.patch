From c7d0cbf836f693b68b306f5efc6aa5613359b8df Mon Sep 17 00:00:00 2001
From: Sirherobrine23 <sirherobrine23@users.noreply.github.com>
Date: Tue, 4 Aug 2026 20:20:20 +0000
Subject: [PATCH] pinctrl: airoha: preserve OpenWrt fixes after driver split

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 .../pinctrl/airoha,an7583-pinctrl.yaml        |  10 +-
 drivers/pinctrl/airoha/airoha-common.h        |   7 +
 drivers/pinctrl/airoha/pinctrl-airoha.c       |  18 ++-
 drivers/pinctrl/airoha/pinctrl-an7581.c       |  58 +++++++-
 drivers/pinctrl/airoha/pinctrl-an7583.c       | 128 ++++++++----------
 5 files changed, 136 insertions(+), 85 deletions(-)

diff --git a/Documentation/devicetree/bindings/pinctrl/airoha,an7583-pinctrl.yaml b/Documentation/devicetree/bindings/pinctrl/airoha,an7583-pinctrl.yaml
index f016e0da6..4609cc76b 100644
--- a/Documentation/devicetree/bindings/pinctrl/airoha,an7583-pinctrl.yaml
+++ b/Documentation/devicetree/bindings/pinctrl/airoha,an7583-pinctrl.yaml
@@ -60,7 +60,7 @@ patternProperties:
           function:
             description:
               A string containing the name of the function to mux to the group.
-            enum: [pon, olt, tod_1pps, sipo, mdio, uart, jtag, pcm, spi,
+            enum: [pon, olt, tod_1pps, sipo, mdio, uart, i2c, jtag, pcm, spi,
                    pcm_spi, emmc, pnand, gpio, pcie_reset, pwm, phy1_led0,
                    phy2_led0, phy3_led0, phy4_led0, phy1_led1, phy2_led1,
                    phy3_led1, phy4_led1]
@@ -125,6 +125,14 @@ patternProperties:
                     enum: [uart2, uart2_cts_rts, hsuart, hsuart_cts_rts,
                            uart4, uart5, npu_uart]
                   maxItems: 2
+          - if:
+              properties:
+                function:
+                  const: i2c
+            then:
+              properties:
+                groups:
+                  enum: [i2c0, i2c1]
           - if:
               properties:
                 function:
diff --git a/drivers/pinctrl/airoha/airoha-common.h b/drivers/pinctrl/airoha/airoha-common.h
index 47900be19..c6144e249 100644
--- a/drivers/pinctrl/airoha/airoha-common.h
+++ b/drivers/pinctrl/airoha/airoha-common.h
@@ -153,6 +153,11 @@ struct airoha_pinctrl {
 	struct irq_chip gpio_irq_chip;
 };
 
+struct airoha_pinctrl_hwinit_reg {
+	u32 offset;
+	u32 val;
+};
+
 struct airoha_pinctrl_match_data {
 	const char *chip_scu_compatible;
 	const char *pinctrl_name;
@@ -163,6 +168,8 @@ struct airoha_pinctrl_match_data {
 	const unsigned int num_grps;
 	const struct airoha_pinctrl_func *funcs;
 	const unsigned int num_funcs;
+	const struct airoha_pinctrl_hwinit_reg *hwinit_regs;
+	const unsigned int num_hwinit_regs;
 	const struct airoha_pinctrl_confs_info confs_info[AIROHA_PINCTRL_CONFS_MAX];
 };
 
diff --git a/drivers/pinctrl/airoha/pinctrl-airoha.c b/drivers/pinctrl/airoha/pinctrl-airoha.c
index e24e03b39..6dcd939cb 100644
--- a/drivers/pinctrl/airoha/pinctrl-airoha.c
+++ b/drivers/pinctrl/airoha/pinctrl-airoha.c
@@ -341,7 +341,7 @@ static int airoha_pinmux_set_direction(struct pinctrl_dev *pctrl_dev,
 {
 	struct airoha_pinctrl *pinctrl = pinctrl_dev_get_drvdata(pctrl_dev);
 	u32 mask, index;
-	int err, pin;
+	int err, pin, offset;
 
 	pin = airoha_convert_pin_to_reg_offset(pctrl_dev, range, p);
 	if (pin < 0)
@@ -356,11 +356,12 @@ static int airoha_pinmux_set_direction(struct pinctrl_dev *pctrl_dev,
 		return err;
 
 	/* set direction */
-	mask = BIT(2 * (pin % AIROHA_REG_GPIOCTRL_NUM_PIN));
+	offset = 2 * (pin % AIROHA_REG_GPIOCTRL_NUM_PIN);
+	mask = GENMASK(offset + 1, offset);
 	index = pin / AIROHA_REG_GPIOCTRL_NUM_PIN;
 	return regmap_update_bits(pinctrl->regmap,
 				  pinctrl->gpiochip.dir[index], mask,
-				  !input ? mask : 0);
+				  !input ? BIT(offset) : 0);
 }
 
 static const struct pinmux_ops airoha_pmxops = {
@@ -692,6 +693,17 @@ int airoha_pinctrl_probe(struct platform_device *pdev)
 
 	pinctrl->chip_scu = map;
 
+	/* Restore SoC mux registers to their reset/default state. */
+	for (i = 0; i < data->num_hwinit_regs; i++) {
+		err = regmap_write(pinctrl->chip_scu,
+				   data->hwinit_regs[i].offset,
+				   data->hwinit_regs[i].val);
+		if (err)
+			return dev_err_probe(dev, err,
+				"Failed to reset SCU IOMUX register 0x%x\n",
+				data->hwinit_regs[i].offset);
+	}
+
 	/* Init pinctrl desc struct */
 	pinctrl->desc.name = data->pinctrl_name;
 	pinctrl->desc.owner = data->pinctrl_owner;
