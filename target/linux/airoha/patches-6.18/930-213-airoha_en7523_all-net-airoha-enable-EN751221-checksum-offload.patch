From b9738cbab45c005a66ae5923e89b1156ef2a1d16 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 11 Aug 2026 14:04:13 -0300
Subject: [PATCH] net: airoha: enable EN751221 checksum offload

The EN751221 QDMA supports IPv4/IPv6 TCP and UDP checksum offload, but
the EcoNet driver leaves those netdev features disabled. This keeps
locally terminated traffic on the MIPS CPU for checksum work that the
hardware can perform.

Advertise IP_CSUM, IPV6_CSUM and RXCSUM. Set the vendor ICO/UCO/TCO TX
descriptor bits for CHECKSUM_PARTIAL skbs, and only report
CHECKSUM_UNNECESSARY on RX when the descriptor identifies an IP packet
without IP or L4 checksum failure.

Keep TSO, TSO6 and scatter-gather disabled because EN751221 does not
provide TSO and the current TX path still linearizes fragmented skbs.
Also correct the ERX IP4F/L4F documentation to match the vendor
descriptor semantics.

Signed-off-by: OpenAI <noreply@openai.com>
Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/econet_eth.c | 46 +++++++++++++++---------
 drivers/net/ethernet/airoha/econet_eth.h |  4 +--
 2 files changed, 32 insertions(+), 18 deletions(-)

diff --git a/drivers/net/ethernet/airoha/econet_eth.c b/drivers/net/ethernet/airoha/econet_eth.c
index 7292415f8e75..03e1b92722be 100644
--- a/drivers/net/ethernet/airoha/econet_eth.c
+++ b/drivers/net/ethernet/airoha/econet_eth.c
@@ -192,7 +192,7 @@ static void econet_qdma_rx_process_one(struct econet_q_rx *q, u32 cpu_i,
 
 	__skb_put(skb, len);
 	skb_mark_for_recycle(skb);
-	skb->ip_summed = CHECKSUM_UNNECESSARY;
+	skb->ip_summed = CHECKSUM_NONE;
 
 	hash = get_erx_ppe_entry(&desc.msg.erx);
 	skb_set_hash(skb, jhash_1word(hash, 0),
@@ -201,10 +201,20 @@ static void econet_qdma_rx_process_one(struct econet_q_rx *q, u32 cpu_i,
 					get_erx_crsn(&desc.msg.erx));
 
 	sport = get_erx_sport(&desc.msg.erx);
-	if (econet_rx_before_recv(q->qdma->eth, skb, sport))
+	if (econet_rx_before_recv(q->qdma->eth, skb, sport)) {
 		dev_kfree_skb(skb);
-	else
+	} else {
+		if ((skb->dev->features & NETIF_F_RXCSUM) &&
+		    sport != ETX_FPORT_QDMA0_CPU &&
+		    sport != ETX_FPORT_QDMA1_CPU &&
+		    (is_erx_ip4(&desc.msg.erx) ||
+		     is_erx_ip6(&desc.msg.erx)) &&
+		    !is_erx_ip4f(&desc.msg.erx) &&
+		    !is_erx_l4f(&desc.msg.erx))
+			skb->ip_summed = CHECKSUM_UNNECESSARY;
+
 		napi_gro_receive(&q->napi, skb);
+	}
 
 	return;
 
@@ -1491,6 +1501,18 @@ static netdev_tx_t econet_dev_xmit(struct sk_buff *skb, struct net_device *dev)
 
 	set_etx_channel(&msg.etx, channel);
 
+	/*
+	 * EN751221 QDMA can generate IPv4/IPv6 TCP and UDP checksums.
+	 * The vendor driver programs all parser checksum-offload bits for a
+	 * CHECKSUM_PARTIAL skb and lets the hardware select the applicable
+	 * protocol.
+	 */
+	if (skb->ip_summed == CHECKSUM_PARTIAL) {
+		set_etx_ico(&msg.etx, true);
+		set_etx_uco(&msg.etx, true);
+		set_etx_tco(&msg.etx, true);
+	}
+
 	netdev_tx_sent_queue(txq, len);
 
 	ret = econet_qdma_xmit(port->qdma, skb, &msg, 0);
@@ -1773,20 +1795,12 @@ struct net_device *econet_alloc_gdm_port(struct econet_eth *eth,
 	ndev->watchdog_timeo = 5 * HZ;
 
 	/*
-	 * This driver is meant to forward packets, not send/receive them.
-	 * Therefore most features are not that useful.
-	 *
-	 * NETIF_F_TSO | NETIF_F_TSO6:
-	 *   - Supported in EN751627, not in EN751221, not used in forwarding.
-	 *
-	 * NETIF_F_IP_CSUM | NETIF_F_RXCSUM | NETIF_F_IPV6_CSUM:
-	 *   - Supported but disabled for simplicity.
-	 *
-	 * NETIF_F_HW_TC:
-	 *   - TODO: When we get the PPE working, we will enable this for
-	 *           TC_SETUP_BLOCK / TC_SETUP_FT for NAT flow-table offloading.
+	 * EN751221 supports IPv4/IPv6 TCP/UDP checksum offload, but unlike
+	 * EN751627 it does not provide TSO/TSO6. Scatter-gather also remains
+	 * disabled until the QDMA TX path can submit fragmented skbs directly.
 	 */
-	ndev->hw_features = 0;
+	ndev->hw_features = NETIF_F_IP_CSUM | NETIF_F_RXCSUM |
+			      NETIF_F_IPV6_CSUM;
 	if (eth->ppe && eth->ppe->enabled)
 		ndev->hw_features |= NETIF_F_HW_TC;
 
diff --git a/drivers/net/ethernet/airoha/econet_eth.h b/drivers/net/ethernet/airoha/econet_eth.h
index 87aee88fd725..3ebfc97e3b4a 100644
--- a/drivers/net/ethernet/airoha/econet_eth.h
+++ b/drivers/net/ethernet/airoha/econet_eth.h
@@ -270,10 +270,10 @@ static inline void set_etx_vlan_tag(struct etx *x, u16 v)
  *   @unknown1 "nknwn" (bits 31..29): Revision number? (unused)
  *   @ip6 "I" (bit 28): IPv6 packet indicator
  *   @ip4 "P" (bit 27): IPv4 packet indicator
- *   @ip4f "F" (bit 26): IPv4 fragment flag
+ *   @ip4f "F" (bit 26): IPv4 header checksum failure
  *   @tack "T" (bit 25): TCP ACK flag
  *   @l2vld "L" (bit 24): Layer 2 valid flag
- *   @l4f "A" (bit 23): Layer 4 flag (e.g., checksum failure)
+ *   @l4f "A" (bit 23): TCP/UDP checksum failure
  *   @sport (bits 22..19): Where the packet came from, mostly unknown / unused,
  *                         needs testing
  *   @crsn (bits 18..14): Most likely a MediaTek PPE CPU_REASON
-- 
2.55.0

