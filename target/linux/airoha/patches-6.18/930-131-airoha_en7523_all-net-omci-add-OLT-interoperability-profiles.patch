+/**
+ * enum omci_olt_profile - OLT interoperability policy profile
+ * @OMCI_OLT_PROFILE_UNSPEC: no forced profile
+ * @OMCI_OLT_PROFILE_GENERIC: standards-oriented profile without vendor quirks
+ * @OMCI_OLT_PROFILE_AUTO: detect the effective profile from OLT-G
+ * @OMCI_OLT_PROFILE_NOKIA_ALCL: Nokia/Alcatel-Lucent interoperability
+ * @OMCI_OLT_PROFILE_DASAN: DASAN interoperability
+ * @OMCI_OLT_PROFILE_HUAWEI: Huawei interoperability
+ * @OMCI_OLT_PROFILE_FIBERHOME: FiberHome interoperability
+ * @OMCI_OLT_PROFILE_ZTE: ZTE interoperability
+ */
+enum omci_olt_profile {
+	OMCI_OLT_PROFILE_UNSPEC,
+	OMCI_OLT_PROFILE_GENERIC,
+	OMCI_OLT_PROFILE_AUTO,
+	OMCI_OLT_PROFILE_NOKIA_ALCL,
+	OMCI_OLT_PROFILE_DASAN,
+	OMCI_OLT_PROFILE_HUAWEI,
+	OMCI_OLT_PROFILE_FIBERHOME,
+	OMCI_OLT_PROFILE_ZTE,
+};
+
+#define OMCI_OLT_QUIRK_ALLOW_SET_CREATE		(1U << 0)
+#define OMCI_OLT_QUIRK_FAKE_UNSUPPORTED_SUCCESS	(1U << 1)
+#define OMCI_OLT_QUIRK_IGNORE_UNSUPPORTED_UNI	(1U << 2)
+#define OMCI_OLT_QUIRK_FULL_UNI_ENTITY_ID		(1U << 3)
+#define OMCI_OLT_QUIRK_SANITIZE_VERSION		(1U << 4)
+#define OMCI_OLT_QUIRK_ZTE_VLAN_TAG_MODE		(1U << 5)
+#define OMCI_OLT_QUIRK_VENDOR_SPECIFIC_MES		(1U << 6)
+#define OMCI_OLT_QUIRK_DASAN_MULTICAST_ANI		(1U << 7)
+
