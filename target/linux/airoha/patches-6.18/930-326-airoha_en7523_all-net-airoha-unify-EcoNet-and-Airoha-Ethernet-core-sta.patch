From 72e6c8f5b427d6a031c61503f4a35917027fb946 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Wed, 26 Aug 2026 00:22:29 -0300
Subject: [PATCH] net: airoha: unify EcoNet and Airoha Ethernet core state

Consolidate the EcoNet/MIPS Ethernet state into the common Airoha driver core. Keep PPE/FOE consolidation for a follow-up change.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c  | 1816 +++++++++------------
 drivers/net/ethernet/airoha/airoha_eth.h  |  202 ++-
 drivers/net/ethernet/airoha/airoha_regs.h |    9 +-
 3 files changed, 868 insertions(+), 1159 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index a529d10403ad..70d833a01c36 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -289,18 +289,15 @@ EXPORT_SYMBOL_GPL(airoha_gdm_phylink_destroy);
 /* ------------------------------------------------------------------------- */
 /* QDMA common helpers and hardware-specific implementations. */
 
-void airoha_qdma_common_init(struct airoha_qdma_common *qdma,
-			     struct airoha_eth *eth, void __iomem *regs, u8 id)
+void airoha_qdma_setup(struct airoha_qdma *qdma, struct airoha_eth *eth,
+		       void __iomem *regs, u8 id, u8 num_channels)
 {
 	qdma->eth = eth;
 	qdma->regs = regs;
 	qdma->id = id;
+	qdma->num_channels = num_channels;
 }
 
-#define AIROHA_MTK_HDR_LEN			4
-#define AIROHA_MTK_STAG_PORT_MASK		GENMASK(5, 0)
-#define AIROHA_MTK_HDR_XMIT_TAGGED_TPID_8100	1
-#define AIROHA_MTK_HDR_XMIT_TAGGED_TPID_88A8	2
 
 static void airoha_qdma_skb_meta_init(struct airoha_qdma_skb_meta *meta)
 {
@@ -386,7 +383,7 @@ struct econet_q_rx {
 	u16				cpu_i;
 
 	/* Not modified after init */
-	struct econet_qdma		*qdma;
+	struct airoha_qdma_mips		*qdma;
 	struct qchain_regs __iomem	*qchain_regs;
 	int				ndesc;
 	int				buf_size;
@@ -414,7 +411,7 @@ struct econet_q_tx {
 	u16				freelist_tail;
 
 	/* Not modified after init */
-	struct econet_qdma		*qdma;
+	struct airoha_qdma_mips		*qdma;
 	struct qchain_regs __iomem	*qchain_regs;
 	int				ndesc;
 	struct napi_struct		napi;
@@ -429,7 +426,7 @@ struct econet_irq {
 	u32 __iomem 			*status_reg[ECONET_QDMA_IRQ_REGS];
 
 	/* Not modified after init */
-	struct econet_qdma 		*qdma;
+	struct airoha_qdma_mips 		*qdma;
 	int 				irq;
 };
 
@@ -439,77 +436,27 @@ struct econet_tx_doneq {
 	struct qregs_doneq __iomem	*regs;
 
 	/* Not modified after init */
-	struct econet_qdma 		*qdma;
+	struct airoha_qdma_mips 		*qdma;
 	int 				size;
 	struct napi_struct 		napi;
 };
 
-#define EN751221_SLM_BASE			0x1fa60000
-#define EN751221_SLM_REG_SIZE			SZ_256
-#define EN751221_SLM_HWF_VIRT_BASE		0x1b800000
-#define EN751221_SLM_PHYS_SIZE			SZ_4M
-#define EN751221_SLM_MAX_DRAM_SIZE		SZ_256M
-#define EN751221_SLM_SECTOR_SIZE		SZ_256
 
-#define EN751221_SLM_GLO_CFG_BYPASS		BIT(0)
-#define EN751221_SLM_EN_ENABLE			BIT(0)
-#define EN751221_SLM_EN_ACTIVE			BIT(1)
-
-struct en751221_slm_regs {
-	u32 glo_cfg;
-	u32 enable;
-	u32 reserved_08[2];
-	u32 virt_base;
-	u32 virt_size;
-	u32 phys_base;
-	u32 phys_size;
-	u32 free_min_cnt;
-	u32 free_cur_cnt;
-	u32 free_threshold;
-	u32 reserved_2c;
-	u32 api_cmd;
-	u32 api_base;
-	u32 api_rd_addr;
-	u32 reserved_3c;
-	u32 int_status;
-	u32 int_mask;
-	u32 bus_rd_null_addr;
-	u32 reserved_4c;
-	u32 drop_cmd;
-	u32 drop_addr;
-	u32 drop_cnt;
-};
-
-struct econet_qdma {
-	struct airoha_qdma_common	common;
-
-	/* Protects register programming and users. */
-	struct mutex			lock;
-	/* Typed EcoNet view of common.regs. */
-	struct qregs __iomem		*regs;
-	int				users;
-	int				num_irqs;
-
-	/* Synchronized inside of the structure */
-	struct econet_irq 		irqs[ECONET_MAX_QDMA_IRQS];
-	struct econet_tx_doneq 		q_tx_done[QDMA_NUM_TX_DONE];
-	struct econet_q_tx 		q_tx[QDMA_NUM_CHAINS];
-	struct econet_q_rx 		q_rx[QDMA_NUM_CHAINS];
-
-	/* Not modified after init */
-	struct device 			*dev;
-	struct fwdesc 			*hwf_desc;
-	int				num_fwd_descs;
-	u32				fwd_buf_size;
-	struct en751221_slm_regs __iomem *slm_regs;
-	void				*slm_buf;
-	dma_addr_t			slm_dma_addr;
-	size_t				slm_buf_size;
-	bool				slm_enabled;
-	struct dentry			*slm_debugfs_dir;
-	struct net_device 		*napi_dev;
-	struct econet_qdma_cfg 		cfg;
-	const struct airoha_eth_soc_data	*soc;
+struct airoha_qdma_mips {
+	struct airoha_qdma *qdma;
+	struct mutex lock;
+	struct qregs __iomem *regs;
+
+	struct econet_irq irqs[ECONET_MAX_QDMA_IRQS];
+	struct econet_tx_doneq q_tx_done[QDMA_NUM_TX_DONE];
+	struct econet_q_tx q_tx[QDMA_NUM_CHAINS];
+	struct econet_q_rx q_rx[QDMA_NUM_CHAINS];
+
+	struct fwdesc *hwf_desc;
+	int num_fwd_descs;
+	u32 fwd_buf_size;
+	struct airoha_qdma_slm slm;
+	struct airoha_qdma_mips_cfg cfg;
 };
 
 static void econet_fill_rx_queue(struct econet_q_rx *q, u32 end_i)
@@ -567,7 +514,7 @@ static void econet_qdma_rx_process_one(struct econet_q_rx *q, u32 cpu_i,
 
 	memcpy(&desc, &q->desc[cpu_i], sizeof(desc));
 
-	dma_sync_single_for_cpu(q->qdma->dev, e->dma_addr, e->dma_len, dir);
+	dma_sync_single_for_cpu(q->qdma->qdma->eth->dev, e->dma_addr, e->dma_len, dir);
 
 	/* Not needed but a couple of WARN_ON_ONCE() check this later */
 	e->dma_addr = 0;
@@ -598,18 +545,18 @@ static void econet_qdma_rx_process_one(struct econet_q_rx *q, u32 cpu_i,
 	 * FE RX layout.  Divert management frames before interpreting them as
 	 * Ethernet/PPE traffic.
 	 */
-	if (econet_rx_xpon_oam(q->qdma->common.eth,
-					q->qdma->common.id, skb, &desc.msg))
+	if (econet_rx_xpon_oam(q->qdma->qdma->eth,
+					q->qdma->qdma->id, skb, &desc.msg))
 		return;
 
 	hash = get_erx_ppe_entry(&desc.msg.erx);
 	skb_set_hash(skb, jhash_1word(hash, 0),
 		     PKT_HASH_TYPE_L4);
-	airoha_ppe_dev_check_skb_reason(q->qdma->common.eth->ppe_dev, skb, hash,
+	airoha_ppe_dev_check_skb_reason(q->qdma->qdma->eth->ppe_dev, skb, hash,
 					get_erx_crsn(&desc.msg.erx));
 
 	sport = get_erx_sport(&desc.msg.erx);
-	if (econet_rx_before_recv(q->qdma->common.eth, skb, sport)) {
+	if (econet_rx_before_recv(q->qdma->qdma->eth, skb, sport)) {
 		dev_kfree_skb(skb);
 	} else {
 		if ((skb->dev->features & NETIF_F_RXCSUM) &&
@@ -726,39 +673,35 @@ static union irq_bit econet_irq_bit(union econet_irq_purpose purpose)
 	return bit;
 }
 
-#define EN7516_QDMA_INT_STATUS1_OFFSET		0x700
-#define EN7516_QDMA_INT_STATUS2_OFFSET		0x704
-#define EN7516_QDMA_INT_ENABLE_BASE		0x704
-#define EN7516_QDMA_INT_ENABLE_STRIDE		0x0c
 
-static u32 __iomem *econet_irq_status_reg(struct econet_qdma *qdma,
+static u32 __iomem *econet_irq_status_reg(struct airoha_qdma_mips *qdma,
 					 int bank, int reg)
 {
-	void __iomem *base = qdma->common.regs;
+	u8 __iomem *base = qdma->qdma->regs;
 
-	if (bank >= qdma->num_irqs || reg >= ECONET_QDMA_IRQ_REGS)
+	if (bank >= qdma->qdma->eth->soc->irq_banks || reg >= ECONET_QDMA_IRQ_REGS)
 		return NULL;
 
 	if (reg == 0)
 		return &qdma->regs->int_status;
 
-	if (!airoha_is(qdma->common.eth, econet_en7528))
+	if (!airoha_is(qdma->qdma->eth, econet_en7528))
 		return NULL;
 
-	return (u32 __iomem *)((u8 __iomem *)base +
+	return (u32 __iomem *)(base +
 	       (reg == 1 ? EN7516_QDMA_INT_STATUS1_OFFSET :
 			   EN7516_QDMA_INT_STATUS2_OFFSET));
 }
 
-static u32 __iomem *econet_irq_enable_reg(struct econet_qdma *qdma,
+static u32 __iomem *econet_irq_enable_reg(struct airoha_qdma_mips *qdma,
 					 int bank, int reg)
 {
-	void __iomem *base = qdma->common.regs;
+	u8 __iomem *base = qdma->qdma->regs;
 
-	if (bank >= qdma->num_irqs || reg >= ECONET_QDMA_IRQ_REGS)
+	if (bank >= qdma->qdma->eth->soc->irq_banks || reg >= ECONET_QDMA_IRQ_REGS)
 		return NULL;
 
-	if (!airoha_is(qdma->common.eth, econet_en7528))
+	if (!airoha_is(qdma->qdma->eth, econet_en7528))
 		return bank == 0 && reg == 0 ? &qdma->regs->int_enable : NULL;
 
 	/* EN7516/EN7527 INT1 keeps ENABLE0 at 0x54. The remaining
@@ -767,18 +710,17 @@ static u32 __iomem *econet_irq_enable_reg(struct econet_qdma *qdma,
 	if (bank == 0 && reg == 0)
 		return &qdma->regs->int_enable;
 
-	return (u32 __iomem *)((u8 __iomem *)base +
-	       EN7516_QDMA_INT_ENABLE_BASE +
+	return (u32 __iomem *)(base + EN7516_QDMA_INT_ENABLE_BASE +
 	       bank * EN7516_QDMA_INT_ENABLE_STRIDE + reg * sizeof(u32));
 }
 
 /* End EcoNet QDMA IRQ layout helpers */
 
-static void econet_qdma_set_irqmask(struct econet_qdma *qdma, union irq_bit b, bool enable)
+static void econet_qdma_set_irqmask(struct airoha_qdma_mips *qdma, union irq_bit b, bool enable)
 {
 	struct econet_irq *irq;
 
-	if (WARN_ON_ONCE(b.irq_idx >= qdma->num_irqs))
+	if (WARN_ON_ONCE(b.irq_idx >= qdma->qdma->eth->soc->irq_banks))
 		return;
 
 	irq = &qdma->irqs[b.irq_idx];
@@ -807,13 +749,13 @@ static void econet_qdma_set_irqmask(struct econet_qdma *qdma, union irq_bit b, b
 	econet_rreg(irq->mask_reg[b.reg_idx]);
 }
 
-int econet_qdma_set_xpon_irq(struct econet_qdma *qdma,
+static int econet_qdma_set_xpon_irq_mips(struct airoha_qdma_mips *qdma,
 				  enum airoha_xpon_mode mode, bool enable)
 {
 	union econet_irq_purpose purpose;
 	union irq_bit bit;
 
-	if (!qdma || qdma->common.id != 1)
+	if (!qdma || qdma->qdma->id != 1)
 		return -EINVAL;
 
 	switch (mode) {
@@ -841,7 +783,7 @@ int econet_qdma_set_xpon_irq(struct econet_qdma *qdma,
 static int econet_qdma_rx_napi_poll(struct napi_struct *napi, int budget)
 {
 	struct econet_q_rx *q = container_of(napi, struct econet_q_rx, napi);
-	struct econet_qdma *qdma = q->qdma;
+	struct airoha_qdma_mips *qdma = q->qdma;
 	int cur, done = 0;
 
 	do {
@@ -864,7 +806,7 @@ static int econet_qdma_rx_napi_poll(struct napi_struct *napi, int budget)
 static irqreturn_t econet_irq_handler(int irq_num, void *dev_instance)
 {
 	struct econet_irq *irq = dev_instance;
-	struct econet_qdma *qdma = irq->qdma;
+	struct airoha_qdma_mips *qdma = irq->qdma;
 	unsigned long xpon_pending = 0;
 	int i;
 
@@ -914,7 +856,7 @@ static irqreturn_t econet_irq_handler(int irq_num, void *dev_instance)
 					xpon_pending |= BIT(AIROHA_XPON_MODE_EPON);
 					continue;
 				}
-				dev_dbg_ratelimited(qdma->dev,
+				dev_dbg_ratelimited(qdma->qdma->eth->dev,
 						    "%s IRQ from %s[%d]\n",
 						    econet_irq_purpose_type_str(p.type),
 						    econet_irq_purpose_source_str(p.source),
@@ -932,10 +874,10 @@ static irqreturn_t econet_irq_handler(int irq_num, void *dev_instance)
 	 * drain operations.
 	 */
 	if (xpon_pending & BIT(AIROHA_XPON_MODE_GPON))
-		econet_xpon_irq(qdma->common.eth, qdma->common.id,
+		econet_xpon_irq(qdma->qdma->eth, qdma->qdma->id,
 					 AIROHA_XPON_MODE_GPON);
 	if (xpon_pending & BIT(AIROHA_XPON_MODE_EPON))
-		econet_xpon_irq(qdma->common.eth, qdma->common.id,
+		econet_xpon_irq(qdma->qdma->eth, qdma->qdma->id,
 					 AIROHA_XPON_MODE_EPON);
 
 	return IRQ_HANDLED;
@@ -945,7 +887,7 @@ static int econet_poll_tx_complete(struct napi_struct *napi, int budget)
 {
 	struct qregs_doneq_state state;
 	struct econet_tx_doneq *done_q;
-	struct econet_qdma *qdma;
+	struct airoha_qdma_mips *qdma;
 	int irq_queued;
 	u32 done = 0, head;
 
@@ -998,7 +940,7 @@ static int econet_poll_tx_complete(struct napi_struct *napi, int budget)
 		e = &q->entry[index];
 		skb = e->skb;
 
-		dma_unmap_single(qdma->dev, e->dma_addr, e->dma_len,
+		dma_unmap_single(qdma->qdma->eth->dev, e->dma_addr, e->dma_len,
 				 DMA_TO_DEVICE);
 		memset(e, 0, sizeof(*e));
 
@@ -1053,7 +995,7 @@ static int econet_poll_tx_complete(struct napi_struct *napi, int budget)
 	return done;
 }
 
-int econet_qdma_xmit(struct econet_qdma *qdma, struct sk_buff *skb,
+static int econet_qdma_xmit_mips(struct airoha_qdma_mips *qdma, struct sk_buff *skb,
 		   union desc_msg *msg, int qid)
 {
 	struct econet_q_tx *q = &qdma->q_tx[qid];
@@ -1075,8 +1017,8 @@ int econet_qdma_xmit(struct econet_qdma *qdma, struct sk_buff *skb,
 	if (next_index == 0xffff)
 		return -EBUSY;
 
-	addr = dma_map_single(qdma->dev, skb->data, len, DMA_TO_DEVICE);
-	ret = dma_mapping_error(qdma->dev, addr);
+	addr = dma_map_single(qdma->qdma->eth->dev, skb->data, len, DMA_TO_DEVICE);
+	ret = dma_mapping_error(qdma->qdma->eth->dev, addr);
 	if (unlikely(ret))
 		return ret;
 
@@ -1111,7 +1053,7 @@ int econet_qdma_xmit(struct econet_qdma *qdma, struct sk_buff *skb,
 /* Init functions, no locks, assumed non-concurrent */
 
 static int econet_init_rx_queue(struct econet_q_rx *q,
-			      struct econet_qdma *qdma, int ndesc)
+			      struct airoha_qdma_mips *qdma, int ndesc)
 {
 	const struct page_pool_params pp_params = {
 		.order = 0,
@@ -1120,7 +1062,7 @@ static int econet_init_rx_queue(struct econet_q_rx *q,
 		.dma_dir = DMA_FROM_DEVICE,
 		.max_len = PAGE_SIZE,
 		.nid = NUMA_NO_NODE,
-		.dev = qdma->dev,
+		.dev = qdma->qdma->eth->dev,
 		.napi = &q->napi,
 	};
 	int threshold;
@@ -1128,20 +1070,20 @@ static int econet_init_rx_queue(struct econet_q_rx *q,
 	struct qregs_rxring_low rrl;
 	dma_addr_t dma_addr;
 
-	q->buf_size = ECONET_MAX_PACKET_SIZE;
+	q->buf_size = AIROHA_MAX_PACKET_SIZE;
 	q->ndesc = ndesc;
 	q->qdma = qdma;
 
-	if (airoha_is(qdma->common.eth, econet_en751221))
+	if (airoha_is(qdma->qdma->eth, econet_en751221))
 		/* QDMA_LAN uses 32 for both rings; QDMA_WAN uses ring_size / 4. */
-		threshold = qdma->common.id == 0 ? 32 : ndesc >> 2;
+		threshold = qdma->qdma->id == 0 ? 32 : ndesc >> 2;
 	else
 		threshold = clamp(ndesc >> 3, 1, 32);
 	q->qchain_regs = (q == &qdma->q_rx[0]) ?
 			 &qdma->regs->qchain0 :
 			 &qdma->regs->qchain1;
 
-	q->entry = devm_kzalloc(qdma->dev, q->ndesc * sizeof(*q->entry),
+	q->entry = devm_kzalloc(qdma->qdma->eth->dev, q->ndesc * sizeof(*q->entry),
 				GFP_KERNEL);
 	if (!q->entry)
 		return -ENOMEM;
@@ -1154,14 +1096,14 @@ static int econet_init_rx_queue(struct econet_q_rx *q,
 		return err;
 	}
 
-	q->desc = dmam_alloc_coherent(qdma->dev, q->ndesc * sizeof(*q->desc),
+	q->desc = dmam_alloc_coherent(qdma->qdma->eth->dev, q->ndesc * sizeof(*q->desc),
 				      &dma_addr, GFP_KERNEL);
 	if (!q->desc)
 		return -ENOMEM;
 
 	memset(q->desc, 0, q->ndesc * sizeof(*q->desc));
 
-	netif_napi_add(qdma->napi_dev, &q->napi, econet_qdma_rx_napi_poll);
+	netif_napi_add(qdma->qdma->eth->napi_dev, &q->napi, econet_qdma_rx_napi_poll);
 
 	econet_wreg(lower_32_bits(dma_addr), &q->qchain_regs->rxbase);
 
@@ -1195,17 +1137,15 @@ static int econet_init_rx_queue(struct econet_q_rx *q,
 	return 0;
 }
 
-static int econet_init_irqs(struct device *dev, struct econet_qdma *qdma,
-			    int *irqs, int num_irqs)
+static int econet_init_irqs(struct device *dev, struct airoha_qdma_mips *qdma,
+			    int *irqs)
 {
 	int i;
 
-	if (num_irqs <= 0 || num_irqs > ARRAY_SIZE(qdma->irqs))
+	if (qdma->qdma->eth->soc->irq_banks > ARRAY_SIZE(qdma->irqs))
 		return -EINVAL;
 
-	qdma->num_irqs = num_irqs;
-
-	for (i = 0; i < qdma->num_irqs; i++) {
+	for (i = 0; i < qdma->qdma->eth->soc->irq_banks; i++) {
 		struct econet_irq *irq = &qdma->irqs[i];
 		const char *name;
 		int err;
@@ -1224,7 +1164,7 @@ static int econet_init_irqs(struct device *dev, struct econet_qdma *qdma,
 		}
 
 		name = devm_kasprintf(dev, GFP_KERNEL,
-				      KBUILD_MODNAME "-%d.%d", qdma->common.id, i);
+				      KBUILD_MODNAME "-%d.%d", qdma->qdma->id, i);
 		if (!name)
 			return -ENOMEM;
 
@@ -1239,14 +1179,14 @@ static int econet_init_irqs(struct device *dev, struct econet_qdma *qdma,
 }
 
 static int econet_init_tx_doneq(struct econet_tx_doneq *done_q,
-			      struct econet_qdma *qdma, int size,
+			      struct airoha_qdma_mips *qdma, int size,
 			      int irq_threshold)
 {
 	dma_addr_t dma_addr;
 
-	netif_napi_add_tx(qdma->napi_dev, &done_q->napi,
+	netif_napi_add_tx(qdma->qdma->eth->napi_dev, &done_q->napi,
