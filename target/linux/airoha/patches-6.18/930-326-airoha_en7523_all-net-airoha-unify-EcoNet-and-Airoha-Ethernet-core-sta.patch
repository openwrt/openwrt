 	dma_addr_t dma_addr;
@@ -1278,12 +1218,12 @@ static int econet_init_tx_queue(struct econet_q_tx *q,
 			 &qdma->regs->qchain0 :
 			 &qdma->regs->qchain1;
 
-	q->entry = devm_kzalloc(qdma->dev, q->ndesc * sizeof(*q->entry),
+	q->entry = devm_kzalloc(qdma->qdma->eth->dev, q->ndesc * sizeof(*q->entry),
 				GFP_KERNEL);
 	if (!q->entry)
 		return -ENOMEM;
 
-	q->desc = dmam_alloc_coherent(qdma->dev, q->ndesc * sizeof(*q->desc),
+	q->desc = dmam_alloc_coherent(qdma->qdma->eth->dev, q->ndesc * sizeof(*q->desc),
 				      &dma_addr, GFP_KERNEL);
 	if (!q->desc)
 		return -ENOMEM;
@@ -1306,10 +1246,10 @@ static int econet_init_tx_queue(struct econet_q_tx *q,
 	return 0;
 }
 
-static bool econet_en751221_use_slm(struct econet_qdma *qdma)
+static bool econet_en751221_use_slm(struct airoha_qdma_mips *qdma)
 {
-	if (!airoha_is(qdma->common.eth, econet_en751221) ||
-	    qdma->common.id != 1)
+	if (!airoha_is(qdma->qdma->eth, econet_en751221) ||
+	    qdma->qdma->id != 1)
 		return false;
 
 	/*
@@ -1321,7 +1261,7 @@ static bool econet_en751221_use_slm(struct econet_qdma *qdma)
