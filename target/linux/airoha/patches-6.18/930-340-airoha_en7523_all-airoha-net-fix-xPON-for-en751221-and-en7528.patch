 	if (!ppe)
 		return -ENODEV;
-	if (READ_ONCE(ppe->v1.armed))
+	if (READ_ONCE(ppe->v1.armed)) {
+		/*
+		 * Netdev initialization may rewrite GDM forwarding after the
