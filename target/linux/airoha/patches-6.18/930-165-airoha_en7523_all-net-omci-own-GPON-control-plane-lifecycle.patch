 	.get_ani_topology = airoha_gpon_omci_get_ani_topology,
 	.set_tcont = airoha_gpon_omci_set_tcont,
@@ -153,6 +179,16 @@ int airoha_gpon_omci_register(struct airoha_gpon_omci *omci,
 	return ret;
 }
 
