+
+static void airoha_gpon_omci_stop_transport(struct omci_device *odev)
+{
+	struct airoha_gpon_omci *omci = omci_device_priv(odev);
+
+	airoha_gpon_omci_hw_stop(omci->hw_priv);
+	airoha_eth_xpon_control_stop(omci->gdm_dev);
+}
+
