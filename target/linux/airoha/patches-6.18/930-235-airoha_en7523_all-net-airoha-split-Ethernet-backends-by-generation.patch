-
-		for (j = 0; j < AIROHA_FE_MC_MAX_VLAN_PORT; j++) {
-			airoha_fe_wr(eth, REG_MC_VLAN_DATA, 0x0);
-
-			val = FIELD_PREP(MC_VLAN_CFG_TABLE_ID_MASK, i) |
