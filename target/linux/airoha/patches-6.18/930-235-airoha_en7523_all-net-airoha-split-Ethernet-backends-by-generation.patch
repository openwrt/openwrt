-		}
-	}
-
-	set_bit(channel, dev->qos_sq_bmap);
-	opt->qid = dev->eth->soc->tx_ring + channel;
-
-	return 0;
-error:
-	clear_bit(channel, qdma->qos_channel_map);
-
-	return err;
