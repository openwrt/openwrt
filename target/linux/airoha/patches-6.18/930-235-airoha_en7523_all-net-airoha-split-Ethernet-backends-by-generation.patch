-static bool airoha_qdma_should_check_ppe_skb(struct airoha_eth *eth,
-					     u32 reason)
-{
-	if (reason == AIROHA_PPE_CPU_REASON_HIT_UNBIND_RATE_REACHED)
-		return true;
-
-	if (!airoha_is(eth, airoha_en7523))
-		return false;
