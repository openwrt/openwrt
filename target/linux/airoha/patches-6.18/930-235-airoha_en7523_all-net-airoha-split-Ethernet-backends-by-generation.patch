-	clear_bit(queue, dev->qos_sq_bmap);
-
-	if (!bitmap_empty(dev->qos_sq_bmap, AIROHA_NUM_QOS_CHANNELS))
-		num_tx_queues += find_last_bit(dev->qos_sq_bmap,
-					       AIROHA_NUM_QOS_CHANNELS) + 1;
