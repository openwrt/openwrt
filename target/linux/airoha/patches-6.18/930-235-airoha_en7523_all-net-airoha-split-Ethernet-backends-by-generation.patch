From d3cccab3e1d283167845cd8b2ae2a51bf1277530 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 11 Aug 2026 14:04:35 -0300
Subject: [PATCH] net: airoha: split Ethernet backends by generation

Build the EcoNet and Airoha frame engines under one airoha-eth platform driver and move the existing implementations to generation backends. Keep the hardware compatibles unchanged while putting the shared of_match table and module lifetime in airoha_eth.c. Move the legacy register/descriptor definitions to airoha_eth_gen1.h and carry the gen1 QDMA quirks in the shared soc_data.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/Kconfig           |    7 +
 drivers/net/ethernet/airoha/Makefile          |   10 +-
 drivers/net/ethernet/airoha/airoha_eth.c      | 6005 +----------------
 drivers/net/ethernet/airoha/airoha_eth.h      |   16 +
 .../{econet_eth.c => airoha_eth_gen1.c}       |   54 +-
 .../{econet_eth.h => airoha_eth_gen1.h}       |    9 +-
 drivers/net/ethernet/airoha/airoha_eth_gen2.c | 5994 ++++++++++++++++
 7 files changed, 6069 insertions(+), 6026 deletions(-)
 rename drivers/net/ethernet/airoha/{econet_eth.c => airoha_eth_gen1.c} (98%)
 rename drivers/net/ethernet/airoha/{econet_eth.h => airoha_eth_gen1.h} (99%)
 create mode 100644 drivers/net/ethernet/airoha/airoha_eth_gen2.c

diff --git a/drivers/net/ethernet/airoha/Kconfig b/drivers/net/ethernet/airoha/Kconfig
index fd2fed549ad2..31f8746f08cd 100644
--- a/drivers/net/ethernet/airoha/Kconfig
+++ b/drivers/net/ethernet/airoha/Kconfig
@@ -8,6 +8,11 @@ config NET_VENDOR_AIROHA
 
 if NET_VENDOR_AIROHA
 
+config NET_AIROHA_ETH_CORE
+	tristate
+	select NET_AIROHA_COMMON
+	select PAGE_POOL
+
 config NET_AIROHA_COMMON
 	tristate
 	select PHYLINK
@@ -28,6 +33,7 @@ config NET_AIROHA_NPU
 
 config NET_AIROHA
 	tristate "Airoha SoC Gigabit Ethernet support"
+	select NET_AIROHA_ETH_CORE
 	select NET_AIROHA_COMMON
 	select PAGE_POOL
 	imply NET_AIROHA_NPU if ARCH_AIROHA
@@ -39,6 +45,7 @@ config NET_ECONET
 	tristate "EcoNet SoC Gigabit Ethernet support"
 	depends on ECONET || COMPILE_TEST
 	depends on OF
+	select NET_AIROHA_ETH_CORE
 	select NET_AIROHA_COMMON
 	select PAGE_POOL
 	help
diff --git a/drivers/net/ethernet/airoha/Makefile b/drivers/net/ethernet/airoha/Makefile
index 66b591619a63..209d6bdd38de 100644
--- a/drivers/net/ethernet/airoha/Makefile
+++ b/drivers/net/ethernet/airoha/Makefile
@@ -8,15 +8,11 @@ obj-$(CONFIG_NET_AIROHA_COMMON) += airoha-common.o
 airoha-common-y := airoha_common.o airoha_ppe.o
 airoha-common-$(CONFIG_NET_AIROHA_PPE_DEBUGFS) += airoha_ppe_debugfs.o
 
-# EN7523/EN7581 datapath.
-obj-$(CONFIG_NET_AIROHA) += airoha-eth.o
-airoha-eth-y := airoha_eth.o
+# Shared Ethernet host with generation-specific FE backends.
+obj-$(CONFIG_NET_AIROHA_ETH_CORE) += airoha-eth.o
+airoha-eth-y := airoha_eth.o airoha_eth_gen1.o airoha_eth_gen2.o
 airoha-eth-$(CONFIG_NET_AIROHA_SOC_WED) += airoha_wed.o airoha_wed_debugfs.o
 
-# EN7512/EN7521/EN7526 datapath.
-obj-$(CONFIG_NET_ECONET) += econet-eth.o
-econet-eth-y := econet_eth.o
-
 obj-$(CONFIG_NET_AIROHA_NPU) += airoha_npu.o
 
 # Airoha/EcoNet shared GPON + EPON MAC complex.
