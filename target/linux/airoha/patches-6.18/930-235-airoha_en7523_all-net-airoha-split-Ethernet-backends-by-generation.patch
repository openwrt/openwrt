-static bool airoha_qdma_foe_entry_is_valid(struct airoha_eth *eth, u32 hash)
-{
-	return airoha_is(eth, airoha_en7523) ?
-	       hash != EN7523_AIROHA_RXD4_FOE_ENTRY_INVALID :
-	       hash != AN7581_AIROHA_RXD4_FOE_ENTRY_INVALID;
