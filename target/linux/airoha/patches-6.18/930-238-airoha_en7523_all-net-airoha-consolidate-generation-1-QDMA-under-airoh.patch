-static int econet_init_final(struct econet_qdma *qdma)
-{
-	struct qregs_qcfg qcfg;
-	int i;
-
-	for (i = 0; i < ARRAY_SIZE(qdma->irqs); i++) {
-		int j;
-
-		/* clear pending irqs */
-		for (j = 0; j < ARRAY_SIZE(qdma->irqs[i].status_reg); j++)
-			econet_wreg(0xffffffffU, qdma->irqs[i].status_reg[j]);
