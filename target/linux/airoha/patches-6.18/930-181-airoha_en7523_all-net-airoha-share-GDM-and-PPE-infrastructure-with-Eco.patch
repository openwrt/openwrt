 drivers/net/ethernet/airoha/Kconfig         |   82 +-
 drivers/net/ethernet/airoha/Makefile        |   26 +-
 drivers/net/ethernet/airoha/airoha_common.c |  124 +++
 drivers/net/ethernet/airoha/airoha_common.h |   81 +-
 drivers/net/ethernet/airoha/airoha_eth.c    |  149 ++-
 drivers/net/ethernet/airoha/airoha_eth.h    |   27 +-
 drivers/net/ethernet/airoha/airoha_ppe.c    | 1049 ++++++++++++++++++-
 drivers/net/ethernet/airoha/airoha_wed.h    |    4 +
 drivers/net/ethernet/airoha/econet_eth.c    |  368 +++----
 drivers/net/ethernet/airoha/econet_eth.h    |    6 +-
 include/linux/soc/airoha/airoha_offload.h   |   64 +-
 12 files changed, 1687 insertions(+), 294 deletions(-)

