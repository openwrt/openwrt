From f15aab39fa16434c0272b0627e28fee4391b2b85 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 11 Aug 2026 14:04:31 -0300
Subject: [PATCH] net: airoha: match EN751221 stock congestion thresholds

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/econet_eth.c | 40 ++++++++++++++++--------
 1 file changed, 27 insertions(+), 13 deletions(-)

diff --git a/drivers/net/ethernet/airoha/econet_eth.c b/drivers/net/ethernet/airoha/econet_eth.c
index 9d000ff920d5..b4e9b6813b42 100644
--- a/drivers/net/ethernet/airoha/econet_eth.c
+++ b/drivers/net/ethernet/airoha/econet_eth.c
@@ -991,9 +991,10 @@ static void econet_init_en751221_qdma(struct econet_qdma *qdma)
 	econet_wreg(val, &qdma->regs->tx_meter_cfg);
 
 	/*
-	 * Reproduce qdma_set_txq_cngst_auto_config() for the actual LMGR
-	 * descriptor count. This matters when a DTS reserved-memory region is
-	 * smaller than the preferred 1024 descriptors.
+	 * Start from qdma_set_txq_cngst_auto_config() so reduced fallback
+	 * pools remain usable.  The production firmware retunes the total
+	 * threshold after this initial auto profile, however, and the final
+	 * values are materially larger than CONFIG_HWFWD_DSCP_NUM / 5.
 	 */
 	if (qdma->num_fwd_descs <= 256) {
 		total_min = 48;
@@ -1010,6 +1011,24 @@ static void econet_init_en751221_qdma(struct econet_qdma *qdma)
 	channel_max = total_max;
 	queue_max = total_min;
 
+	/* Final steady-state values captured from the shipping EN751221
+	 * firmware.  Keep the auto profile for reduced/no-reserved-memory
+	 * fallback pools, where these full-size thresholds would be invalid.
+	 */
+	if (qdma->fwd_buf_size == 2048 && qdma->id == 0 &&
+	    qdma->num_fwd_descs == 1024) {
+		total_min = 5120;
+		total_max = 7680;
+		channel_max = 7680;
+		queue_max = 204;
+	} else if (qdma->fwd_buf_size == 2048 && qdma->id == 1 &&
+		   qdma->num_fwd_descs == 4096) {
+		total_min = 2048;
+		total_max = 15360;
+		channel_max = 15360;
+		queue_max = 819;
+	}
+
 	airoha_wr((void __iomem *)&qdma->regs->tx_congest_thr, 0,
 		  FIELD_PREP(EN751221_TXQ_MAX_THR_MASK, total_max) |
 		  FIELD_PREP(EN751221_TXQ_MIN_THR_MASK, total_min));
@@ -1021,18 +1040,13 @@ static void econet_init_en751221_qdma(struct econet_qdma *qdma)
 		     &qdma->regs->tx_per_q_dthr);
 
 	/*
-	 * Dynamic normal mode, all three update triggers, 250 us tick and a
-	 * 1/2 DEI threshold. The four TX-ring blocking bits intentionally stay
-	 * clear, matching the SDK.
-	 */
-	/*
-	 * qdma_dev.c configures the dynamic controller with read-modify-write
-	 * operations and deliberately leaves DROP_EN/DEI_DROP_EN untouched.
-	 * Do the same instead of forcing drop policy on while enabling the
-	 * dynamic thresholds.  In particular this preserves the hardware reset
-	 * policy used by the vendor LAN driver.
+	 * Match the final production dynamic-congestion state: normal and DEI
+	 * drops enabled, all three update triggers, 250 us tick and a 1/2 DEI
+	 * threshold. The four TX-ring blocking bits stay clear.
 	 */
 	cngst_cfg = econet_rreg(&qdma->regs->tx_congest_cfg);
+	set_qregs_tx_congest_cfg_tail_drop_en(&cngst_cfg, true);
+	set_qregs_tx_congest_cfg_dei_drop_en(&cngst_cfg, true);
 	set_qregs_tx_congest_cfg_dyncong_en(&cngst_cfg, true);
 	set_qregs_tx_congest_cfg_max_thr_blk_tx1(&cngst_cfg, false);
 	set_qregs_tx_congest_cfg_min_thr_blk_tx1(&cngst_cfg, false);
-- 
