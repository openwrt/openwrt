From ccc66c512411ba5f0c35560b8f37a3e9501c805f Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Fri, 17 Jul 2026 18:38:04 +0000
Subject: [PATCH] net: airoha: restore EN7523 RX ring map and expand
 diagnostics

The EN7523 QDMA in the current kernel tree uses the native Airoha RX
ring register layout. The legacy window selected for rings 2 through 15
returns sentinel values such as 0xbeef for the ring indices and prevents
the driver from programming the actual ring.

Restore the native RX ring registers and scatter configuration for all
queues. Expand the GPON OMCI diagnostics to report the QDMA global state,
ring base and size, raw producer indices, and descriptors 127, 0, 1, and
2. This makes it possible to determine whether the hardware advances the
producer index without setting the descriptor completion bit.

Keep the xPON packet processing logs added by the previous commit.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c  | 166 ++++++++++------------
 drivers/net/ethernet/airoha/airoha_regs.h |   7 -
 2 files changed, 76 insertions(+), 97 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 630fb39f5..4e72ccf41 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -79,48 +79,6 @@ static void airoha_qdma_irq_disable(struct airoha_irq_bank *irq_bank,
 	airoha_qdma_set_irqmask(irq_bank, index, mask, 0);
 }
 
-static bool airoha_qdma_uses_legacy_rx_ring(struct airoha_qdma *qdma,
-					    int qid)
-{
-	return airoha_is(qdma->eth, en7523) && qid >= 2 && qid < 16;
-}
-
-static u32 airoha_qdma_rx_ring_base_reg(struct airoha_qdma *qdma, int qid)
-{
-	return airoha_qdma_uses_legacy_rx_ring(qdma, qid) ?
-	       EN7523_REG_RX_RING_BASE(qid) : REG_RX_RING_BASE(qid);
-}
-
-static u32 airoha_qdma_rx_ring_size_reg(struct airoha_qdma *qdma, int qid)
-{
-	return airoha_qdma_uses_legacy_rx_ring(qdma, qid) ?
-	       EN7523_REG_RX_RING_SIZE(qid) : REG_RX_RING_SIZE(qid);
-}
-
-static u32 airoha_qdma_rx_cpu_idx_reg(struct airoha_qdma *qdma, int qid)
-{
-	return airoha_qdma_uses_legacy_rx_ring(qdma, qid) ?
-	       EN7523_REG_RX_CPU_IDX(qid) : REG_RX_CPU_IDX(qid);
-}
-
-static u32 airoha_qdma_rx_dma_idx_reg(struct airoha_qdma *qdma, int qid)
-{
-	return airoha_qdma_uses_legacy_rx_ring(qdma, qid) ?
-	       EN7523_REG_RX_DMA_IDX(qid) : REG_RX_DMA_IDX(qid);
-}
-
-static u32 airoha_qdma_rx_delay_int_reg(struct airoha_qdma *qdma, int qid)
-{
-	return airoha_qdma_uses_legacy_rx_ring(qdma, qid) ?
-	       EN7523_REG_RX_DELAY_INT_IDX(qid) : REG_RX_DELAY_INT_IDX(qid);
-}
-
-static bool airoha_qdma_has_rx_scatter_reg(struct airoha_qdma *qdma,
-					   int qid)
-{
-	return !airoha_qdma_uses_legacy_rx_ring(qdma, qid);
-}
-
 static int airoha_set_macaddr(struct airoha_gdm_dev *dev, const u8 *addr)
 {
 	u8 ref_addr[ETH_ALEN] __aligned(2);
@@ -411,16 +369,47 @@ void airoha_eth_xpon_set_carrier(struct net_device *netdev, bool up)
 }
 EXPORT_SYMBOL_GPL(airoha_eth_xpon_set_carrier);
 
-void airoha_eth_xpon_dump_oam_rx_state(struct net_device *netdev)
+static void airoha_eth_xpon_dump_rx_desc(struct net_device *netdev,
+					 struct airoha_queue *q,
+					 unsigned int index, u32 ring_base)
 {
 	struct airoha_qdma_desc *desc;
+	u32 ctrl, msg0, msg1, msg2, msg3;
+	unsigned int channel, desc_len, gem_port_id;
+
+	if (index >= q->ndesc)
+		return;
+
+	desc = &q->desc[index];
+	ctrl = le32_to_cpu(READ_ONCE(desc->ctrl));
+	msg0 = le32_to_cpu(READ_ONCE(desc->msg0));
+	msg1 = le32_to_cpu(READ_ONCE(desc->msg1));
+	msg2 = le32_to_cpu(READ_ONCE(desc->msg2));
+	msg3 = le32_to_cpu(READ_ONCE(desc->msg3));
+	desc_len = FIELD_GET(EN7523_QDMA_DESC_LEN_MASK, ctrl);
+	channel = FIELD_GET(EN7523_QDMA_ETH_RXMSG_CHAN_MASK, msg0);
+	gem_port_id = FIELD_GET(EN7523_QDMA_ETH_RXMSG_GEM_MASK, msg0);
+
+	dev_info_ratelimited(&netdev->dev,
+			     "GPON OAM RX descriptor: index=%u dma=%#010x ctrl=%#010x done=%u len=%u msg=%#010x/%#010x/%#010x/%#010x oam=%u channel=%u gem=%u no-mic=%u\n",
+			     index,
+			     ring_base + index * sizeof(struct airoha_qdma_desc),
+			     ctrl, !!(ctrl & QDMA_DESC_DONE_MASK), desc_len,
+			     msg0, msg1, msg2, msg3,
+			     !!(msg0 & EN7523_QDMA_ETH_RXMSG_OAM_MASK),
+			     channel, gem_port_id,
+			     !!(msg0 & EN7523_QDMA_ETH_RXMSG_NO_MIC_MASK));
+}
+
+void airoha_eth_xpon_dump_oam_rx_state(struct net_device *netdev)
+{
 	struct airoha_gdm_dev *dev;
 	struct airoha_queue *q;
 	struct airoha_qdma *qdma;
-	u32 ctrl, msg0, msg1, msg2, msg3;
-	u32 cpu_idx, dma_idx, int_enable, int_status;
-	unsigned int desc_len, channel, gem_port_id;
-	unsigned int tail;
+	u32 cpu_raw, dma_raw, global_cfg, int_enable, int_status;
+	u32 ring_base, ring_size, scatter_cfg;
+	u32 cpu_idx, dma_idx;
+	unsigned int head, tail;
 	int ret;
 
 	ret = airoha_eth_get_xpon_gdm2(netdev, &dev);
@@ -444,36 +433,39 @@ void airoha_eth_xpon_dump_oam_rx_state(struct net_device *netdev)
 		return;
 	}
 
+	head = READ_ONCE(q->head);
 	tail = READ_ONCE(q->tail);
-	desc = &q->desc[tail];
-	ctrl = le32_to_cpu(READ_ONCE(desc->ctrl));
-	msg0 = le32_to_cpu(READ_ONCE(desc->msg0));
-	msg1 = le32_to_cpu(READ_ONCE(desc->msg1));
-	msg2 = le32_to_cpu(READ_ONCE(desc->msg2));
-	msg3 = le32_to_cpu(READ_ONCE(desc->msg3));
-	cpu_idx = FIELD_GET(RX_RING_CPU_IDX_MASK,
-			    airoha_qdma_rr(qdma, airoha_qdma_rx_cpu_idx_reg(qdma, 15)));
-	dma_idx = FIELD_GET(RX_RING_DMA_IDX_MASK,
-			    airoha_qdma_rr(qdma, airoha_qdma_rx_dma_idx_reg(qdma, 15)));
+	global_cfg = airoha_qdma_rr(qdma, REG_QDMA_GLOBAL_CFG);
+	ring_base = airoha_qdma_rr(qdma, REG_RX_RING_BASE(15));
+	ring_size = airoha_qdma_rr(qdma, REG_RX_RING_SIZE(15));
+	scatter_cfg = airoha_qdma_rr(qdma, REG_RX_SCATTER_CFG(15));
+	cpu_raw = airoha_qdma_rr(qdma, REG_RX_CPU_IDX(15));
+	dma_raw = airoha_qdma_rr(qdma, REG_RX_DMA_IDX(15));
+	cpu_idx = FIELD_GET(RX_RING_CPU_IDX_MASK, cpu_raw);
+	dma_idx = FIELD_GET(RX_RING_DMA_IDX_MASK, dma_raw);
 	int_status = airoha_qdma_rr(qdma, REG_INT_STATUS(1));
 	int_enable = airoha_qdma_rr(qdma, REG_INT_ENABLE(0, 1));
-	desc_len = FIELD_GET(EN7523_QDMA_DESC_LEN_MASK, ctrl);
-	channel = FIELD_GET(EN7523_QDMA_ETH_RXMSG_CHAN_MASK, msg0);
-	gem_port_id = FIELD_GET(EN7523_QDMA_ETH_RXMSG_GEM_MASK, msg0);
 
 	dev_info_ratelimited(&netdev->dev,
-			     "GPON OAM RX state: qdma=%td cdm2-fwd=%#010x ring=15 ndesc=%d queued=%d sw=%u/%u hw=%u/%u int=%#010x enable=%#010x\n",
-			     qdma - &dev->eth->qdma[0],
+			     "GPON OAM RX state: qdma=%td global=%#010x cdm2-fwd=%#010x ring=15 base=%#010x size=%#010x scatter=%#010x ndesc=%d queued=%d\n",
+			     qdma - &dev->eth->qdma[0], global_cfg,
 			     airoha_fe_rr(dev->eth, REG_CDM_FWD_CFG(2)),
-			     q->ndesc, READ_ONCE(q->queued), READ_ONCE(q->head),
-			     tail, cpu_idx, dma_idx, int_status, int_enable);
+			     ring_base, ring_size, scatter_cfg, q->ndesc,
+			     READ_ONCE(q->queued));
 	dev_info_ratelimited(&netdev->dev,
-			     "GPON OAM RX descriptor: index=%u ctrl=%#010x done=%u len=%u msg=%#010x/%#010x/%#010x/%#010x oam=%u channel=%u gem=%u no-mic=%u\n",
-			     tail, ctrl, !!(ctrl & QDMA_DESC_DONE_MASK),
-			     desc_len, msg0, msg1, msg2, msg3,
-			     !!(msg0 & EN7523_QDMA_ETH_RXMSG_OAM_MASK),
-			     channel, gem_port_id,
-			     !!(msg0 & EN7523_QDMA_ETH_RXMSG_NO_MIC_MASK));
+			     "GPON OAM RX indices: sw=%u/%u hw=%u/%u raw=%#010x/%#010x int=%#010x enable=%#010x check-done=%u rx-dma=%u rx-busy=%u\n",
+			     head, tail, cpu_idx, dma_idx, cpu_raw, dma_raw,
+			     int_status, int_enable,
+			     !!(global_cfg & GLOBAL_CFG_CHECK_DONE_MASK),
+			     !!(global_cfg & GLOBAL_CFG_RX_DMA_EN_MASK),
+			     !!(global_cfg & GLOBAL_CFG_RX_DMA_BUSY_MASK));
+
+	/* Read descriptor contents after all producer index observations. */
+	dma_rmb();
+	airoha_eth_xpon_dump_rx_desc(netdev, q, q->ndesc - 1, ring_base);
+	airoha_eth_xpon_dump_rx_desc(netdev, q, 0, ring_base);
+	airoha_eth_xpon_dump_rx_desc(netdev, q, 1, ring_base);
+	airoha_eth_xpon_dump_rx_desc(netdev, q, 2, ring_base);
 	rcu_read_unlock();
 }
 EXPORT_SYMBOL_GPL(airoha_eth_xpon_dump_oam_rx_state);
@@ -1150,7 +1142,7 @@ static int airoha_qdma_fill_rx_queue(struct airoha_queue *q)
 	}
 
 	if (nframes)
-		airoha_qdma_rmw(qdma, airoha_qdma_rx_cpu_idx_reg(qdma, qid),
+		airoha_qdma_rmw(qdma, REG_RX_CPU_IDX(qid),
 				RX_RING_CPU_IDX_MASK,
 				FIELD_PREP(RX_RING_CPU_IDX_MASK, q->head));
 
@@ -1694,27 +1686,22 @@ static int airoha_qdma_init_rx_queue(struct airoha_queue *q,
 	q->ndesc = ndesc;
 	netif_napi_add(eth->napi_dev, &q->napi, airoha_qdma_rx_napi_poll);
 
-	airoha_qdma_wr(qdma, airoha_qdma_rx_ring_base_reg(qdma, qid),
-		       dma_addr);
-	airoha_qdma_rmw(qdma, airoha_qdma_rx_ring_size_reg(qdma, qid),
+	airoha_qdma_wr(qdma, REG_RX_RING_BASE(qid), dma_addr);
+	airoha_qdma_rmw(qdma, REG_RX_RING_SIZE(qid),
 			RX_RING_SIZE_MASK,
 			FIELD_PREP(RX_RING_SIZE_MASK, ndesc));
 
 	thr = clamp(ndesc >> 3, 1, 32);
-	airoha_qdma_rmw(qdma, airoha_qdma_rx_ring_size_reg(qdma, qid),
-			RX_RING_THR_MASK,
+	airoha_qdma_rmw(qdma, REG_RX_RING_SIZE(qid), RX_RING_THR_MASK,
 			FIELD_PREP(RX_RING_THR_MASK, thr));
-	airoha_qdma_rmw(qdma, airoha_qdma_rx_dma_idx_reg(qdma, qid),
-			RX_RING_DMA_IDX_MASK,
+	airoha_qdma_rmw(qdma, REG_RX_DMA_IDX(qid), RX_RING_DMA_IDX_MASK,
 			FIELD_PREP(RX_RING_DMA_IDX_MASK, q->head));
-	if (airoha_qdma_has_rx_scatter_reg(qdma, qid)) {
-		if (lro_q)
-			airoha_qdma_clear(qdma, REG_RX_SCATTER_CFG(qid),
-					  RX_RING_SG_EN_MASK);
-		else
-			airoha_qdma_set(qdma, REG_RX_SCATTER_CFG(qid),
-					RX_RING_SG_EN_MASK);
-	}
+	if (lro_q)
+		airoha_qdma_clear(qdma, REG_RX_SCATTER_CFG(qid),
+				  RX_RING_SG_EN_MASK);
+	else
+		airoha_qdma_set(qdma, REG_RX_SCATTER_CFG(qid),
+				RX_RING_SG_EN_MASK);
 
 	airoha_qdma_fill_rx_queue(q);
 
@@ -1753,10 +1740,9 @@ static void airoha_qdma_cleanup_rx_queue(struct airoha_queue *q)
 	/* Set RX_DMA_IDX to RX_CPU_IDX to notify the hw the QDMA RX ring is
 	 * empty.
 	 */
-	airoha_qdma_rmw(qdma, airoha_qdma_rx_cpu_idx_reg(qdma, qid), RX_RING_CPU_IDX_MASK,
+	airoha_qdma_rmw(qdma, REG_RX_CPU_IDX(qid), RX_RING_CPU_IDX_MASK,
 			FIELD_PREP(RX_RING_CPU_IDX_MASK, q->head));
-	airoha_qdma_rmw(qdma, airoha_qdma_rx_dma_idx_reg(qdma, qid),
-			RX_RING_DMA_IDX_MASK,
+	airoha_qdma_rmw(qdma, REG_RX_DMA_IDX(qid), RX_RING_DMA_IDX_MASK,
 			FIELD_PREP(RX_RING_DMA_IDX_MASK, q->tail));
 }
 
@@ -2284,7 +2270,7 @@ static int airoha_qdma_hw_init(struct airoha_qdma *qdma)
 		if (!qdma->q_rx[i].ndesc)
 			continue;
 
-		airoha_qdma_clear(qdma, airoha_qdma_rx_delay_int_reg(qdma, i),
+		airoha_qdma_clear(qdma, REG_RX_DELAY_INT_IDX(i),
 				  RX_DELAY_INT_MASK);
 	}
 
diff --git a/drivers/net/ethernet/airoha/airoha_regs.h b/drivers/net/ethernet/airoha/airoha_regs.h
index cd77e0843..d6af4db84 100644
--- a/drivers/net/ethernet/airoha/airoha_regs.h
+++ b/drivers/net/ethernet/airoha/airoha_regs.h
@@ -839,13 +839,6 @@
 #define REG_RX_SCATTER_CFG(_n)	\
 	(((_n) < 16) ? 0x0214 + ((_n) << 5) : 0x0e14 + (((_n) - 16) << 5))
 
-/* EN7523 keeps RX rings 2 through 15 in the legacy QDMA window. */
-#define EN7523_REG_RX_RING_BASE(_n)	(0x0800 + (((_n) - 2) << 5))
-#define EN7523_REG_RX_RING_SIZE(_n)	(0x0804 + (((_n) - 2) << 5))
-#define EN7523_REG_RX_CPU_IDX(_n)	(0x0808 + (((_n) - 2) << 5))
-#define EN7523_REG_RX_DMA_IDX(_n)	(0x080c + (((_n) - 2) << 5))
-#define EN7523_REG_RX_DELAY_INT_IDX(_n)	(0x0810 + (((_n) - 2) << 5))
-
 #define RX_DELAY_INT_MASK		GENMASK(15, 0)
 
 #define RX_RING_DMA_IDX_MASK		GENMASK(15, 0)
-- 
2.55.0

