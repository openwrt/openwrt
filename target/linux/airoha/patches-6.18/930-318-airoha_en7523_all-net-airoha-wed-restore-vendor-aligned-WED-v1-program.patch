 {
@@ -75,6 +109,8 @@ wed_txinfo_show(struct seq_file *s, void *data)
 
 	dump_wed_regs(s, dev, wed_regs);
 
+	dump_wed_tx_rings(s, dev);
+
 	return 0;
 }
 
