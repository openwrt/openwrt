From 6d7cc3b6ca7c8e00a2fd9bfe8a16cae5e1277a36 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 11 Aug 2026 14:04:06 -0300
Subject: [PATCH] net: dsa: mt7530: set EN751221 TRGMII drive strength

The EN7512 vendor TRGMII sequence programs the five data-lane ODT
registers to 0x88 and the clock-lane ODT register to 0x77 on both the
on-die switch and companion MT7530.

Restore those values before releasing the TRGMII receive reset. Delay
calibration remains responsible for selecting the sampling taps.

Signed-off-by: OpenAI <noreply@openai.com>
Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/dsa/mt7530.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/net/dsa/mt7530.c b/drivers/net/dsa/mt7530.c
index 3d0fc9178955..c3427f004d26 100644
--- a/drivers/net/dsa/mt7530.c
+++ b/drivers/net/dsa/mt7530.c
@@ -460,6 +460,7 @@ mt7530_setup_port6(struct dsa_switch *ds, phy_interface_t interface)
 #define EN751221_TRGMII_FE_PHY_CTRL	0x7840
 #define EN751221_TRGMII_FE_PHY_DISABLE	GENMASK(3, 0)
 #define EN751221_TRGMII_TD(i)		(0x7a50 + (i) * 8)
+#define EN751221_TRGMII_TCK_ODT	0x7a7c
 #define EN751221_TRGMII_RX_VALUE_MASK	GENMASK(23, 16)
 #define EN751221_TRGMII_RX_ERR_MASK	GENMASK(11, 8)
 #define EN751221_AGC_L2LEN_CHK		BIT(4)
@@ -598,6 +599,17 @@ static void en751221_trgmii_calibrate(struct mt7530_priv *ext,
 	en751221_trgmii_calibrate_direction(ext, ondie, "MCM->SoC");
 }
 
+static void en751221_trgmii_set_drive_strength(struct mt7530_priv *priv)
+{
+	int i;
+
+	/* Exact P6 TRGMII drive-strength values from the EN7512 SDK. */
+	for (i = 0; i < NUM_TRGMII_CTRL; i++)
+		mt7530_write(priv, MT7530_TRGMII_TD_ODT(i), 0x88);
+
+	mt7530_write(priv, EN751221_TRGMII_TCK_ODT, 0x77);
+}
+
 static void en751221_trgmii_pair_setup(struct mt7530_priv *ext,
 				       struct mt7530_priv *ondie)
 {
@@ -635,6 +647,8 @@ static void en751221_trgmii_pair_setup(struct mt7530_priv *ext,
 
 	mt7530_set(ext, MT7530_TRGMII_RCK_CTRL, RX_RST);
 	mt7530_set(ondie, MT7530_TRGMII_RCK_CTRL, RX_RST);
+	en751221_trgmii_set_drive_strength(ext);
+	en751221_trgmii_set_drive_strength(ondie);
 	mt7530_write(ext, MT7530_P6ECR, P6_INTF_MODE(1));
 	mt7530_write(ondie, MT7530_P6ECR, P6_INTF_MODE(1));
 	mt7530_clear(ext, MT7530_TRGMII_RCK_CTRL, RX_RST);
-- 
