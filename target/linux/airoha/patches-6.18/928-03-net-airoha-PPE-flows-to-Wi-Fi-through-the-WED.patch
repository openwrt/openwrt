+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef AIROHA_WED_H
+#define AIROHA_WED_H
+
+/*
+ * What the PPE of airoha-eth asks of the WED driver: a flow to a Wi-Fi card
+ * is added (the first one hands the WED's token space to the hardware, as
+ * mtk_wed_flow_add() does) or removed (the last one gives it back).  idx is
+ * the WDMA index of the WED, struct mtk_wed_device.wdma_idx.
+ */
+struct airoha_ppe_wed_ops {
+	int (*flow_add)(int idx);
+	void (*flow_remove)(int idx);
+};
+
+int airoha_ppe_wed_register(const struct airoha_ppe_wed_ops *ops);
+void airoha_ppe_wed_unregister(const struct airoha_ppe_wed_ops *ops);
+/* the WED idx is detached: its flows are unbound and no longer counted */
+void airoha_ppe_wed_detach(int idx);
+void airoha_ppe_wed_flow_flush(int idx, u16 wcid);
+
+#endif
