From 4a014176e49839fb694182284b98d652b8452d75 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Fri, 17 Jul 2026 23:32:01 +0000
Subject: [PATCH 103/162] net: airoha: retry EN7571 transmitter rearm after
 timeout

Repeated OLT Deactivate_ONU-ID requests can leave the EN7571
transmitter safety circuit temporarily unable to rearm. The restart
worker currently returns on -ETIMEDOUT and leaves GPON permanently in O1
until the interface is restarted manually.

Keep the MAC disabled after the first deactivation shutdown and
reschedule the restart worker when transmitter rearm fails. Subsequent
attempts skip the redundant GPON shutdown and retry the safety circuit
once per second.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_xpon.c | 23 ++++++++++++++++-------
 1 file changed, 16 insertions(+), 7 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_xpon.c b/drivers/net/ethernet/airoha/airoha_xpon.c
index b601ae74389d..2ff452fc3c4c 100644
--- a/drivers/net/ethernet/airoha/airoha_xpon.c
+++ b/drivers/net/ethernet/airoha/airoha_xpon.c
@@ -552,6 +552,7 @@ static void airoha_xpon_phy_stop(struct device *dev, struct phy *phy,
 #define GPON_TO2_MS		100
 /* Restart delay after an OLT Deactivate_ONU-ID request. */
 #define GPON_DEACTIVATE_RESTART_MS	500
+#define GPON_REARM_RETRY_MS		1000
 
 #define GPON_MAX_GEM_ID		4096
 #define GPON_MAX_TCONT		32
@@ -2078,17 +2079,25 @@ static void gpon_restart_work_fn(struct work_struct *work)
 	if (!READ_ONCE(priv->started))
 		return;
 
-	dev_warn(priv->dev,
-		 "restarting GPON after Deactivate_ONU-ID from the OLT\n");
-	gpon_disable(priv);
+	if (ploam_get_state(priv->ploam) != GPON_O1_INITIAL) {
+		dev_warn(priv->dev,
+			 "restarting GPON after Deactivate_ONU-ID from the OLT\n");
+		gpon_disable(priv);
 
-	msleep(GPON_DEACTIVATE_RESTART_MS);
-	if (!READ_ONCE(priv->started))
-		return;
+		msleep(GPON_DEACTIVATE_RESTART_MS);
+		if (!READ_ONCE(priv->started))
+			return;
+	}
 
 	ret = airoha_xpon_tx_rearm(priv->dev, priv->lddla_dev);
-	if (ret)
+	if (ret) {
+		dev_warn(priv->dev,
+			 "retrying optical transmitter rearm in %u ms\n",
+			 GPON_REARM_RETRY_MS);
+		mod_delayed_work(priv->fsm_wq, &priv->restart_work,
+				 msecs_to_jiffies(GPON_REARM_RETRY_MS));
 		return;
+	}
 
 	ret = gpon_enable(priv);
 	if (ret)
-- 
