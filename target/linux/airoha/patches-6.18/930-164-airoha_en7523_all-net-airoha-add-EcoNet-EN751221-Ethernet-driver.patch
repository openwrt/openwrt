+}
+
+/** Checksum offload, probably TCP */
+static inline bool is_etx_tco(struct etx *x)
+{
+	return FIELD_GET(ETX_TCO, x->bitfield_1);
+}
+static inline void set_etx_tco(struct etx *x, bool v)
