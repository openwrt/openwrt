+
+	/**
+	 * See accessors:
+	 * is_etx_ico()
+	 * set_etx_ico()
+	 * is_etx_uco()
+	 * set_etx_uco()
+	 * is_etx_tco()
+	 * set_etx_tco()
+	 * is_etx_sco()
+	 * set_etx_sco()
+	 * get_etx_udf_pmap()
+	 * set_etx_udf_pmap()
+	 * get_etx_fport()
+	 * set_etx_fport()
+	 * is_etx_vlan_en()
