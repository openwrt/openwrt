+
+#define FIELD_SET(current, mask, val)	\
+	(((current) & ~(mask)) | FIELD_PREP((mask), (val)))
+
+/** etx:  */
+struct etx {
+	/**
+	 * See accessors:
+	 * get_etx_unknown0()
+	 * set_etx_unknown0()
+	 * get_etx_sp_tag()
