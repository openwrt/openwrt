+{
+	x->bitfield_1 = FIELD_SET(x->bitfield_1, ETX_VLAN_EN, v);
+}
+
+/** Which type of vlan to add to the packet header */
+static inline enum etx_vlan_type get_etx_vlan_type(struct etx *x)
