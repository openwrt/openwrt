-		airoha_fe_set_pse_oq_rsv(eth, FE_PSE_PORT_GDM3, q,
-					 PSE_QUEUE_RSV_PAGES);
-	/* PPE1 */
-	for (q = 0; q < pse_port_num_queues[FE_PSE_PORT_PPE1]; q++) {
-		if (q < pse_port_num_queues[FE_PSE_PORT_PPE1] / 2)
-			airoha_fe_set_pse_oq_rsv(eth, FE_PSE_PORT_PPE1, q,
