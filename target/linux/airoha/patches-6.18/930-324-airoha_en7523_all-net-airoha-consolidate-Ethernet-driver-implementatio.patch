-		airoha_qdma_skb_get_mtk_meta(skb, netdev,
-					     AIROHA_MTK_TAG_TO_DESC,
-					     &skb_meta);
-		tag = skb_meta.mtk_tag;
-		chn = skb_meta.channel;
