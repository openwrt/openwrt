+	return FIELD_GET(GDM_RED_DSCP_RXM_SZ_MASK, x->word);
+}
+static inline void set_gdm_red_dscp_rxm_sz(struct red_drop_criteria *x, enum gdm_red_dscp_rxm_sz v)
