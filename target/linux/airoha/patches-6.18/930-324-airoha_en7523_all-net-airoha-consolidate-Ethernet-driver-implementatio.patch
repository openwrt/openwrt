-		e->dma_len = len;
-		e->dma_map_page = map_page;
-
-		e = list_first_entry(&q->tx_list, struct airoha_queue_entry,
-				     list);
-		index = e - q->entry;
-
-		val = airoha_is(qdma->common.eth, airoha_en7523) ?
