+{
+	return FIELD_GET(GDM_VLAN_URX, x->bitfield_0);
+}
+static inline void set_gdm_vlan_urx(struct gdm_vlan *x, bool v)
+{
+	x->bitfield_0 = FIELD_SET(x->bitfield_0, GDM_VLAN_URX, v);
+}
