-static int airoha_en7523_get_dev_from_sport(struct airoha_qdma_desc *desc,
-					    u16 *port, u16 *dev)
-{
-	u32 sport = FIELD_GET(EN7523_QDMA_ETH_RXMSG_SPORT_MASK,
-			      le32_to_cpu(READ_ONCE(desc->msg1)));
