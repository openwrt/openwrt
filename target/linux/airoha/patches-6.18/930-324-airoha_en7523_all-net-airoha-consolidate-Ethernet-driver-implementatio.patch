-		chn = skb_meta.channel;
-		msg0 = FIELD_PREP(QDMA_ETH_TXMSG_CHAN_MASK, chn) |
-		       FIELD_PREP(QDMA_ETH_TXMSG_SP_TAG_MASK, tag | 0x8000);
