-static int airoha_tc_setup_qdisc_ets(struct net_device *dev,
-				     struct tc_ets_qopt_offload *opt)
-{
-	int channel;
-
-	if (opt->parent == TC_H_ROOT)
-		return -EINVAL;
-
-	channel = TC_H_MAJ(opt->handle) >> 16;
-	channel = channel % AIROHA_NUM_QOS_CHANNELS;
