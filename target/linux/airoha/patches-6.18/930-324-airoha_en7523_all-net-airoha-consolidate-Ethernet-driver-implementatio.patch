-	int i;
-
-	for (i = 0; i < qdma->common.eth->soc->rx_ring; i++) {
-		int err;
-
-		if (!qdma->q_rx[i].ndesc)
-			continue;
-
-		err = airoha_qdma_init_rl_config(qdma, i, !!rate, unit_type);
-		if (err)
-			return err;
-
-		err = airoha_qdma_set_rl_token_bucket(qdma, i, rate,
