-	switch (opt->command) {
-	case TC_ETS_REPLACE:
-		return airoha_qdma_set_tx_ets_sched(dev, channel, opt);
-	case TC_ETS_DESTROY:
-		/* PRIO is default qdisc scheduler */
-		return airoha_qdma_set_tx_prio_sched(dev, channel);
-	case TC_ETS_STATS:
-		return airoha_qdma_get_tx_ets_stats(dev, channel, opt);
-	default:
-		return -EOPNOTSUPP;
-	}
