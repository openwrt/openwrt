-	if (!READ_ONCE(port->xpon_managed) ||
-	    READ_ONCE(port->xpon_mode) != AIROHA_XPON_MODE_GPON)
-		return -EOPNOTSUPP;
-
-	return econet_xpon_lookup_service(port, vlan_valid, vlan_id,
-					  pcp_valid, pcp, info);
