+#define GDM_RED_CP_MASK					GENMASK(31, 30)
+#define GDM_RED_LP_MASK					GENMASK(29, 28)
+#define GDM_RED_HP_MASK					GENMASK(27, 26)
+#define GDM_RED_DSCP_RXM_SZ_MASK			GENMASK(25, 24)
