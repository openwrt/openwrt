-	for_each_set_bit(q, dev->qos_sq_bmap, AIROHA_NUM_QOS_CHANNELS)
-		airoha_tc_remove_htb_queue(netdev, q);
-
-	dev->flags &= ~AIROHA_PRIV_F_QOS;
-
-	return 0;
