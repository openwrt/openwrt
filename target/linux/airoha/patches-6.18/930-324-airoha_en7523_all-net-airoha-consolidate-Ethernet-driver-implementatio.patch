+{
+	return FIELD_GET(GDM_RED_HP_MASK, x->word);
+}
+static inline void set_gdm_red_hp(struct red_drop_criteria *x, u8 v)
+{
+	x->word = FIELD_SET(x->word, GDM_RED_HP_MASK, v);
+}
