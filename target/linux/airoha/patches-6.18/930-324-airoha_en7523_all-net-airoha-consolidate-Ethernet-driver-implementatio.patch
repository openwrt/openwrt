-static int airoha_eth_gen2_validate_xpon_gdm2(struct net_device *netdev,
-					 struct airoha_gdm_dev **gdm)
-{
-	struct airoha_gdm_dev *dev;
-	struct airoha_eth *eth;
-
-	if (!netdev)
-		return -EINVAL;
-	if (netdev->netdev_ops != &airoha_netdev_ops)
-		return -ENODEV;
-
-	dev = netdev_priv(netdev);
-	eth = dev->eth;
-	if (!eth || !dev->port || !airoha_is(eth, airoha_en7523) ||
-	    dev->port->id != AIROHA_GDM2_IDX)
-		return -EOPNOTSUPP;
-
-	*gdm = dev;
-	return 0;
-}
