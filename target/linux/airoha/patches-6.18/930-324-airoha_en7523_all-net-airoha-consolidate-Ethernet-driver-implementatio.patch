-	u32 reserved_2c;
-	u32 api_cmd;
-	u32 api_base;
-	u32 api_rd_addr;
-	u32 reserved_3c;
-	u32 int_status;
-	u32 int_mask;
-	u32 bus_rd_null_addr;
-	u32 reserved_4c;
-	u32 drop_cmd;
-	u32 drop_addr;
-	u32 drop_cnt;
