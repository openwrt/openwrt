-static int airoha_alloc_gdm_device(struct airoha_eth *eth,
-				   struct airoha_gdm_port *port,
-				   int nbq, struct device_node *np)
-{
-	struct net_device *netdev;
-	struct airoha_gdm_dev *dev;
-	u8 index;
-	int err;
-
-	netdev = devm_alloc_etherdev_mqs(eth->dev, sizeof(*dev),
-					 AIROHA_NUM_NETDEV_TX_RINGS(eth->soc),
-					 eth->soc->rx_ring);
-	if (!netdev) {
-		dev_err(eth->dev, "alloc_etherdev failed\n");
-		return -ENOMEM;
-	}
-
-	netdev->netdev_ops = &airoha_netdev_ops;
-	netdev->ethtool_ops = &airoha_ethtool_ops;
-	netdev->max_mtu = AIROHA_MAX_MTU;
-	netdev->watchdog_timeo = 5 * HZ;
-	netdev->hw_features = AIROHA_HW_FEATURES | NETIF_F_GRO_HW;
-	netdev->features |= AIROHA_HW_FEATURES;
-	netdev->vlan_features = AIROHA_HW_FEATURES;
-	SET_NETDEV_DEV(netdev, eth->dev);
-
-	/* reserve hw queues for HTB offloading */
-	err = netif_set_real_num_tx_queues(netdev, eth->soc->tx_ring);
-	if (err)
-		return err;
-
-	err = airoha_eth_init_mac_address(eth->dev, np, netdev);
-	if (err)
-		return err;
-
-	/* Allowed nbq for EN7581 on GDM3 port are 4 and 5 for PCIE0
-	 * and PCIE1 respectively.
-	 */
-	index = nbq;
-	if (index && airoha_is(eth, airoha_en7581, airoha_en7523) && port->id == AIROHA_GDM3_IDX)
-		index -= 4;
-
-	if (index >= ARRAY_SIZE(port->devs) || port->devs[index]) {
-		dev_err(eth->dev, "invalid nbq id: %d\n", nbq);
-		return -EINVAL;
-	}
-
-	netdev->dev.of_node = of_node_get(np);
-	dev = netdev_priv(netdev);
-	airoha_gdm_common_init(&dev->common, eth, netdev,
-			       AIROHA_ETH_FAMILY_AIROHA, port->id, 0,
-			       dev, &airoha_gdm_mac_ops);
-	u64_stats_init(&dev->stats.syncp);
-	dev->port = port;
-	dev->eth = eth;
-	dev->nbq = nbq;
-	mutex_init(&dev->xpon_lock);
-	spin_lock_init(&dev->xpon_state_lock);
-	spin_lock_init(&dev->xpon_service_lock);
-	if (of_property_read_bool(np, "airoha,xpon-managed")) {
-		dev->flags |= AIROHA_PRIV_F_XPON_MANAGED;
-		netdev->features |= NETIF_F_GRO_HW;
-
-		/* The EN7523 vendor SDK handles checksum, scatter-gather and
-		 * TSO through a private descriptor-chain engine.  Advertising
-		 * those features through the generic Linux netdev path stalls
-		 * GPON TX after the first few MiB.  Keep the validated hardware
-		 * GRO receive path, but force TX checksum, segmentation and
-		 * linearisation into the networking stack.
-		 */
-		netdev->hw_features &= ~AIROHA_XPON_TX_OFFLOAD_FEATURES;
-		netdev->features &= ~AIROHA_XPON_TX_OFFLOAD_FEATURES;
-		netdev->vlan_features &= ~AIROHA_XPON_TX_OFFLOAD_FEATURES;
-	}
-	port->devs[index] = dev;
-
-	return airoha_setup_phylink(netdev);
-}
