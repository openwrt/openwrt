-	cmd->base.speed = state.valid ? state.speed : SPEED_UNKNOWN;
-	cmd->base.duplex = state.valid ? state.duplex : DUPLEX_UNKNOWN;
-	cmd->base.autoneg = AUTONEG_DISABLE;
-	cmd->base.port = state.valid ? state.port : PORT_FIBRE;
