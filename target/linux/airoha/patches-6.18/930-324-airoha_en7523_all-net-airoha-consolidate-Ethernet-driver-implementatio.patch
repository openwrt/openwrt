+{
+	return FIELD_GET(DESC_INFO_NLS, x->word);
+}
+static inline void set_desc_info_nls(struct desc_info *x, bool v)
+{
+	x->word = FIELD_SET(x->word, DESC_INFO_NLS, v);
+}
