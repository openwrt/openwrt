+static u32 omci_agent_service_cookie(u16 lan_port, u16 gem_ctp,
+				     u16 gem_port, u16 selector)
+{
+	u32 cookie;
+
+	cookie = jhash_3words(((u32)lan_port << 16) | gem_ctp,
+			      ((u32)gem_port << 16) | selector,
+			      0x4f4d4349, 0);
+
+	return cookie ?: 1;
+}
