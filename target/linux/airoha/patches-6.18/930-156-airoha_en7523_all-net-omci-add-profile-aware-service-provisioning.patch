+static void omci_agent_free_object_array(struct xarray *objects)
+{
+	struct omci_mib_object *object;
+	unsigned long index;
+
+	xa_for_each(objects, index, object) {
+		xa_erase(objects, index);
+		kfree(object);
+	}
