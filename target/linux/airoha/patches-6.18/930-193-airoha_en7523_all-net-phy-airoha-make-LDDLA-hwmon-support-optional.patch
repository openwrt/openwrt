From f04d4d1ef4eb47a133fdfc1e5432237c4e7f0c88 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Thu, 6 Aug 2026 22:50:24 -0300
Subject: [PATCH] net: phy: airoha: make LDDLA hwmon support optional

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/phy/airoha/Kconfig        |  1 -
 drivers/net/phy/airoha/airoha_lddla.c | 11 +++++++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/net/phy/airoha/Kconfig b/drivers/net/phy/airoha/Kconfig
index 008b17556..f4a2e0b9c 100644
--- a/drivers/net/phy/airoha/Kconfig
+++ b/drivers/net/phy/airoha/Kconfig
@@ -1,6 +1,5 @@
 config AIROHA_LDDLA_PHY
 	tristate "Airoha EN757x xPON PHY lddla devices"
-	select HWMON
 	select PHY_COMMON_PROPS
 	default n
 	help
diff --git a/drivers/net/phy/airoha/airoha_lddla.c b/drivers/net/phy/airoha/airoha_lddla.c
index f8b70ceb4..0277ed49e 100644
--- a/drivers/net/phy/airoha/airoha_lddla.c
+++ b/drivers/net/phy/airoha/airoha_lddla.c
@@ -276,6 +276,8 @@ int lddla_flash_load(struct airoha_lddla *lddla)
 /* hwmon								      */
 /* ------------------------------------------------------------------ */
 
+#if IS_REACHABLE(CONFIG_HWMON)
+
 static umode_t airoha_lddla_hwmon_is_visible(const void *data,
 					    enum hwmon_sensor_types type,
 					    u32 attr, int channel)
@@ -454,6 +456,15 @@ int lddla_hwmon_register(struct airoha_lddla *lddla)
 	return PTR_ERR_OR_ZERO(lddla->hwmon);
 }
 
+#else
+
+int lddla_hwmon_register(struct airoha_lddla *lddla)
+{
+	return 0;
+}
+
+#endif /* CONFIG_HWMON */
+
 /**
  * airoha_lddla_get_telemetry() - refresh optical frontend telemetry
  * @dev: LDDLA I2C device
-- 
2.55.0

