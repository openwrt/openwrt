From 55249a7ed481dbfa51e31608ff88fc3f56d2ce58 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 22 Sep 2026 19:21:42 -0300
Subject: [PATCH] mips: airoha: fix zloader

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 arch/mips/boot/compressed/Makefile | 1 +
 arch/mips/econet/Platform          | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/mips/boot/compressed/Makefile b/arch/mips/boot/compressed/Makefile
index 5f3514571..92a9cff20 100644
--- a/arch/mips/boot/compressed/Makefile
+++ b/arch/mips/boot/compressed/Makefile
@@ -98,6 +98,7 @@ UIMAGE_LOADADDR = $(VMLINUZ_LOAD_ADDRESS)
 
 zboot-dtb-reserve-y := 0x100000
 zboot-dtb-reserve-$(CONFIG_SOC_ECONET_EN7528) := 0x20000
+zboot-dtb-reserve-$(CONFIG_SOC_ECONET_EN751221) := 0x20000
 
 vmlinuzobjs-y += $(obj)/piggy.o
 
diff --git a/arch/mips/econet/Platform b/arch/mips/econet/Platform
index ea5616447..a4212d9c0 100644
--- a/arch/mips/econet/Platform
+++ b/arch/mips/econet/Platform
@@ -2,4 +2,4 @@
 # we put the load address well above where the bootloader loads and then use
 # zboot. So please set CONFIG_ZBOOT_LOAD_ADDRESS to the address where your
 # bootloader actually places the kernel.
-load-$(CONFIG_ECONET)	+= 0xffffffff81000000
+load-$(CONFIG_ECONET)	+= 0xffffffff82000000
-- 
2.55.0

