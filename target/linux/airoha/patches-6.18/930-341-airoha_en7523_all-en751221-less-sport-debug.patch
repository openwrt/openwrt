From 69c941ff906e04f9159c23511aa49e4b882519fb Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Fri, 28 Aug 2026 00:58:35 -0300
Subject: [PATCH] en751221: less sport debug

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 5fb3471d27e5..cf46d979e085 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -9200,7 +9200,6 @@ airoha_en751221_get_dev_from_sport(struct airoha_eth *eth, u32 sport,
 				    u16 *port, u16 *dev)
 {
 	*dev = 0;
-	dev_info_ratelimited(eth->dev, "EN751221 RX sport %#x\n", sport);
 
 	if (sport == ETX_FPORT_GDM2 || sport == ETX_FPORT_QDMA1_CPU) {
 		*port = AIROHA_GDM2_IDX - 1;
@@ -9213,6 +9212,7 @@ airoha_en751221_get_dev_from_sport(struct airoha_eth *eth, u32 sport,
 		return 0;
 	}
 
+	dev_info_ratelimited(eth->dev, "EN751221 RX sport %#x\n", sport);
 	return -EINVAL;
 }
 
-- 
2.55.0

