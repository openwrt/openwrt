+static int an7589_pci_is_enabled(struct clk_hw *hw)
+{
+	struct en_clk_gate *cg = container_of(hw, struct en_clk_gate, hw);
+	u32 val, mask;
+	mask = REG_PCI_CONTROL_REFCLK_EN0 | REG_PCI_CONTROL_REFCLK_EN1;
+	regmap_read(cg->map, REG_PCI_CONTROL, &val);
+	return (val & mask) == mask;
+}
+static int an7589_pci_enable(struct clk_hw *hw)
+{
+	/*7589 PCIe device reset(PERST) uses mac reg 0x148 instead of scu reg 0x1fb0_0088*/
+	return 0;
+}
+static void an7589_pci_disable(struct clk_hw *hw)
+{
+	/*7589 PCIe device reset(PERST) uses mac reg 0x148 instead of scu reg 0x1fb0_0088*/
+}
