From d653573628f09675cee32ec3c15bccec8e621557 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Thu, 20 Aug 2026 16:57:01 -0300
Subject: [PATCH] net: airoha: do not restart the GPON session while the fibre
 is still dark

O6 is entered from LOS, and the TO2 handler then stopped the MAC and
scheduled a restart unconditionally. With the light still gone that restart
relocks nothing, fails, and re-arms itself, so a dirty connector or a
flapping fibre produces a stream of PHY stop/start cycles instead of one
quiet wait.

Ask the PHY for the link state first. While LOS is asserted, stop the MAC and
leave it stopped: gpon_sfp_link_up() already restarts the session once the
fibre is back. Only a TO2 that expires with the link present keeps the old
restart path, for the case where the popup itself was missed.

The vendor TO2 handler makes the same distinction before deciding whether to
reset or to wait for the fibre.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_xpon.c | 31 ++++++++++++++++++-----
 1 file changed, 25 insertions(+), 6 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_xpon.c b/drivers/net/ethernet/airoha/airoha_xpon.c
index 7171f3a69b15..a32f7c86a682 100644
--- a/drivers/net/ethernet/airoha/airoha_xpon.c
+++ b/drivers/net/ethernet/airoha/airoha_xpon.c
@@ -2803,14 +2803,33 @@ static void gpon_to2_work_fn(struct work_struct *work)
 	struct xpon_priv *priv =
 		container_of(to_delayed_work(work), struct xpon_priv, to2_work);
 
-	if (ploam_get_state(priv->ploam) == GPON_O6_POPUP) {
-		dev_warn(priv->dev, "GPON TO2 expired in O6, resetting\n");
+	bool ready, los;
+	int ret;
+
+	if (ploam_get_state(priv->ploam) != GPON_O6_POPUP)
+		return;
+
+	/*
+	 * O6 is entered on LOS, so ask the PHY whether the fibre came back
+	 * before scheduling anything.  While the light is still gone a restart
+	 * cannot succeed: it relocks nothing, fails, and re-arms itself, which
+	 * on a dirty connector turns one glitch into a restart storm.  Stop the
+	 * MAC and wait instead -- gpon_sfp_link_up() restarts the session when
+	 * the fibre is back.  The vendor TO2 handler makes the same check.
+	 */
+	ret = airoha_xpon_phy_get_link_state(priv->phy, &ready, &los);
+	if (!ret && (los || !ready)) {
+		dev_warn(priv->dev,
+			 "GPON TO2 expired in O6 with the optical link still down, waiting for the fibre\n");
 		gpon_disable(priv);
-		if (READ_ONCE(priv->started) &&
-		    READ_ONCE(priv->optical_active))
-			mod_delayed_work(priv->fsm_wq, &priv->restart_work,
-					 msecs_to_jiffies(GPON_DEACTIVATE_RESTART_MS));
+		return;
 	}
+
+	dev_warn(priv->dev, "GPON TO2 expired in O6, resetting\n");
+	gpon_disable(priv);
+	if (READ_ONCE(priv->started) && READ_ONCE(priv->optical_active))
+		mod_delayed_work(priv->fsm_wq, &priv->restart_work,
+				 msecs_to_jiffies(GPON_DEACTIVATE_RESTART_MS));
 }
 
 static bool
-- 
