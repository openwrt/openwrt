From: OpenWrt Project <openwrt-devel@lists.openwrt.org>
Date: Sat, 13 Jun 2026 12:00:00 +0200
Subject: [PATCH] PCI: mediatek: ignore EN7523 root port BARs

The EN7523 root ports expose a read-only value at the standard BAR0
configuration-space offset.  It looks like a 64-bit prefetchable BAR, but
returns a bogus 8 GiB size when probed and does not accept an assigned base
address.  This results in misleading PCI errors during enumeration:

  BAR 0: can't handle BAR larger than 4GB
  BAR 0: error updating

The root ports do not implement usable BARs.  Mark both EN7523 root port
device IDs as having non-compliant BARs so PCI core skips BAR probing for
them.  Endpoint BARs and the bridge memory windows are unaffected.

Signed-off-by: OpenWrt Project <openwrt-devel@lists.openwrt.org>
---
 drivers/pci/controller/pcie-mediatek.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/pci/controller/pcie-mediatek.c b/drivers/pci/controller/pcie-mediatek.c
index 7a71095399418f843422cf5023fcef16f8ed1113..475ccdeefaaf3a328a3a786a7203c8ea89524c6b 100644
--- a/drivers/pci/controller/pcie-mediatek.c
+++ b/drivers/pci/controller/pcie-mediatek.c
@@ -1447,6 +1447,20 @@ static const struct mtk_pcie_soc mtk_pcie_soc_en7528 = {
 	.quirks = MTK_PCIE_RETRAIN,
 };
 
+#define PCI_DEVICE_ID_MEDIATEK_EN7523_PCIE0	0x0810
+#define PCI_DEVICE_ID_MEDIATEK_EN7523_PCIE1	0x0811
+
+static void mtk_pcie_en7523_bar_quirk(struct pci_dev *pdev)
+{
+	pdev->non_compliant_bars = 1;
+}
+DECLARE_PCI_FIXUP_EARLY(PCI_VENDOR_ID_MEDIATEK,
+			PCI_DEVICE_ID_MEDIATEK_EN7523_PCIE0,
+			mtk_pcie_en7523_bar_quirk);
+DECLARE_PCI_FIXUP_EARLY(PCI_VENDOR_ID_MEDIATEK,
+			PCI_DEVICE_ID_MEDIATEK_EN7523_PCIE1,
+			mtk_pcie_en7523_bar_quirk);
+
 static const struct of_device_id mtk_pcie_ids[] = {
 	{ .compatible = "airoha,an7583-pcie", .data = &mtk_pcie_soc_an7583 },
 	{ .compatible = "econet,en7528-pcie", .data = &mtk_pcie_soc_en7528 },
