From 4371d0e20e793e20a424c6efd4efad219846777b Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 11 Aug 2026 14:04:26 -0300
Subject: [PATCH] net: airoha: preserve EN751221 QDMA congestion drop policy

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/econet_eth.c | 28 ++++++++++++++----------
 1 file changed, 17 insertions(+), 11 deletions(-)

diff --git a/drivers/net/ethernet/airoha/econet_eth.c b/drivers/net/ethernet/airoha/econet_eth.c
index 0d3d632b54b4..cf3147d301af 100644
--- a/drivers/net/ethernet/airoha/econet_eth.c
+++ b/drivers/net/ethernet/airoha/econet_eth.c
@@ -944,8 +944,6 @@ static int econet_init_hw_fwd(struct econet_qdma *qdma)
 #define EN751221_TX_RATE_METER_DIV_MASK	GENMASK(17, 16)
 #define EN751221_TX_RATE_METER_SLICE_MASK GENMASK(15, 0)
 
-#define EN751221_TXQ_DROP_EN		BIT(31)
-#define EN751221_TXQ_DEI_DROP_EN		BIT(30)
 #define EN751221_TXQ_DYN_CONGEST_EN	BIT(29)
 #define EN751221_TXQ_CFG_TRIGGER		BIT(18)
 #define EN751221_TXQ_PKT_TRIGGER		BIT(17)
@@ -1020,15 +1018,23 @@ static void econet_init_en751221_qdma(struct econet_qdma *qdma)
 	 * 1/2 DEI threshold. The four TX-ring blocking bits intentionally stay
 	 * clear, matching the SDK.
 	 */
-	val = EN751221_TXQ_DROP_EN |
-	      EN751221_TXQ_DEI_DROP_EN |
-	      EN751221_TXQ_DYN_CONGEST_EN |
-	      EN751221_TXQ_CFG_TRIGGER |
-	      EN751221_TXQ_PKT_TRIGGER |
-	      EN751221_TXQ_TIME_TRIGGER |
-	      FIELD_PREP(EN751221_TXQ_DEI_SCALE_MASK, 0) |
-	      FIELD_PREP(EN751221_TXQ_TICK_MASK, 250);
-	airoha_wr((void __iomem *)&qdma->regs->tx_congest_cfg, 0, val);
+	/*
+	 * qdma_dev.c configures the dynamic controller with read-modify-write
+	 * operations and deliberately leaves DROP_EN/DEI_DROP_EN untouched.
+	 * Do the same instead of forcing drop policy on while enabling the
+	 * dynamic thresholds.  In particular this preserves the hardware reset
+	 * policy used by the vendor LAN driver.
+	 */
+	val = econet_rreg(&qdma->regs->tx_congest_cfg);
+	val &= ~(GENMASK(27, 24) | EN751221_TXQ_DEI_SCALE_MASK |
+		 EN751221_TXQ_TICK_MASK);
+	val |= EN751221_TXQ_DYN_CONGEST_EN |
+	       EN751221_TXQ_CFG_TRIGGER |
+	       EN751221_TXQ_PKT_TRIGGER |
+	       EN751221_TXQ_TIME_TRIGGER |
+	       FIELD_PREP(EN751221_TXQ_DEI_SCALE_MASK, 0) |
+	       FIELD_PREP(EN751221_TXQ_TICK_MASK, 250);
+	econet_wreg(val, &qdma->regs->tx_congest_cfg);
 }
 
 static int econet_init_final(struct econet_qdma *qdma)
-- 
