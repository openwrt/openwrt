From 3e69b7a80795c3b63825da30b5122fe4f00abb9e Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 11 Aug 2026 19:03:21 -0300
Subject: [PATCH] mips: dts: econet: add EN751221 watchdog

Expose the EN751221 SCU clock/reset provider required by the existing
clock driver and give CHIP-SCU the compatible used for its syscon
lookup. The clock driver reads CHIP-SCU registers above the old 0x200
window, so describe the full 0x388 range.

Add the watchdog timer at 0x1fbf0100 and feed it from the EN751221 BUS
clock. The watchdog hardware divides that clock by two internally.

Signed-off-by: OpenAI <noreply@openai.com>
Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 arch/mips/boot/dts/econet/en751221.dtsi | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/arch/mips/boot/dts/econet/en751221.dtsi b/arch/mips/boot/dts/econet/en751221.dtsi
index 004bced398b2..5769b0222920 100644
--- a/arch/mips/boot/dts/econet/en751221.dtsi
+++ b/arch/mips/boot/dts/econet/en751221.dtsi
@@ -34,12 +34,13 @@ cpuintc: interrupt-controller {
 
 	chip_scu: syscon@1fa20000 {
 		compatible = "airoha,chip-scu", "syscon";
-		reg = <0x1fa20000 0x200>;
+		reg = <0x1fa20000 0x400>;
 	};
 
 	scuclk: system-controller@1fb00000 {
 		compatible = "econet,en751221-scu", "syscon";
 		reg = <0x1fb00000 0x1000>;
+		airoha,chip-scu = <&chip_scu>;
 
 		#clock-cells = <1>;
 		#reset-cells = <1>;
@@ -106,6 +107,14 @@ uart: serial@1fbf0000 {
 		clock-frequency = <1843200>;
 	};
 
+	watchdog: watchdog@1fbf0100 {
+		compatible = "econet,en751221-wdt";
+		reg = <0x1fbf0100 0x3c>;
+
+		clocks = <&scuclk EN751221_CLK_BUS>;
+		clock-names = "bus";
+	};
+
 	timer_hpt: timer@1fbf0400 {
 		compatible = "econet,en751221-timer";
 		reg = <0x1fbf0400 0x100>;
-- 
