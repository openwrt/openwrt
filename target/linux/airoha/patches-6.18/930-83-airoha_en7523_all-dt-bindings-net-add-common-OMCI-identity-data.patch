From 217aed651e57661a50ddee1d8a5052cd918dbb03 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Sat, 18 Jul 2026 11:07:04 +0000
Subject: [PATCH] dt-bindings: net: add common OMCI identity data

Define normalized ONU serial, vendor, password, version and equipment
identity properties and their optional NVMEM cell names. Reference the
common schema from the Airoha EN7523 xPON binding.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 .../bindings/net/airoha,en7523-xpon.yaml      |  3 +
 .../devicetree/bindings/net/omci.yaml         | 88 +++++++++++++++++++
 MAINTAINERS                                   |  8 ++
 3 files changed, 99 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/net/omci.yaml

diff --git a/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml b/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
index 5c9f6ebfd004..0a82e94193d2 100644
--- a/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
+++ b/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
@@ -68,6 +68,7 @@ properties:
     enum: [gpon, epon]
 
   airoha,gpon-serial-number:
+    deprecated: true
     $ref: /schemas/types.yaml#/definitions/uint8-array
     minItems: 8
     maxItems: 8
@@ -76,6 +77,7 @@ properties:
       and the last four bytes are the vendor-specific serial number.
 
   airoha,gpon-password:
+    deprecated: true
     $ref: /schemas/types.yaml#/definitions/uint8-array
     minItems: 10
     maxItems: 10
@@ -103,6 +105,7 @@ required:
   - sfp
 
 allOf:
+  - $ref: /schemas/net/omci.yaml#
   - if:
       properties:
         compatible:
diff --git a/Documentation/devicetree/bindings/net/omci.yaml b/Documentation/devicetree/bindings/net/omci.yaml
new file mode 100644
index 000000000000..569b0ed12645
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/omci.yaml
@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/omci.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OMCI ONU identity data
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+description: |
+  Common ONU identity and registration properties used by OMCI and the
+  underlying PON activation engine. Factory data should normally be provided
+  through NVMEM cells. Direct properties are intended as board-level fallback
+  values.
+
+allOf:
+  - $ref: /schemas/nvmem/nvmem-consumer.yaml#
+
+properties:
+  nvmem-cells:
+    minItems: 1
+    maxItems: 5
+
+  nvmem-cell-names:
+    minItems: 1
+    maxItems: 5
+    uniqueItems: true
+    items:
+      enum:
+        - gpon-serial-number
+        - gpon-password
+        - omci-vendor-id
+        - omci-version
+        - omci-equipment-id
+
+  omci-serial-number:
+    description: |
+      GPON serial number. Accepted forms are an eight-byte raw value, four
+      vendor characters followed by eight hexadecimal serial digits, or all
+      eight bytes encoded as sixteen hexadecimal digits.
+    oneOf:
+      - $ref: /schemas/types.yaml#/definitions/string
+      - $ref: /schemas/types.yaml#/definitions/uint8-array
+        minItems: 8
+        maxItems: 8
+
+  omci-vendor-id:
+    description: |
+      Four-byte vendor identifier, as raw bytes, four characters, or eight
+      hexadecimal digits. When present it also replaces the vendor prefix of
+      the normalized GPON serial number.
+    oneOf:
+      - $ref: /schemas/types.yaml#/definitions/string
+      - $ref: /schemas/types.yaml#/definitions/uint8-array
+        minItems: 4
+        maxItems: 4
+
+  omci-password:
+    description: |
+      GPON registration password. Accepted forms are ten raw or ASCII bytes,
+      up to ten ASCII characters padded with zeroes, or twenty hexadecimal
+      digits. Implementations must not print this value.
+    oneOf:
+      - $ref: /schemas/types.yaml#/definitions/string
+      - $ref: /schemas/types.yaml#/definitions/uint8-array
+        minItems: 10
+        maxItems: 10
+
+  omci-version:
+    description: ONU-G version string, up to fourteen bytes.
+    oneOf:
+      - $ref: /schemas/types.yaml#/definitions/string
+      - $ref: /schemas/types.yaml#/definitions/uint8-array
+        minItems: 1
+        maxItems: 14
+
+  omci-equipment-id:
+    description: ONU2-G equipment identifier, up to twenty bytes.
+    oneOf:
+      - $ref: /schemas/types.yaml#/definitions/string
+      - $ref: /schemas/types.yaml#/definitions/uint8-array
+        minItems: 1
+        maxItems: 20
+
+additionalProperties: true
+...
diff --git a/MAINTAINERS b/MAINTAINERS
