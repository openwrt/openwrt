From 2c7044c686d399d321c093f62511828a23ca2a07 Mon Sep 17 00:00:00 2001
From: Christian Marangi <ansuelsmth@gmail.com>
Date: Tue, 15 Sep 2026 14:59:17 +0200
Subject: [PATCH 5/5] clk: en7523: Add support for selecting the Serdes port in
 SCU for AN7583

The Airoha AN7583 SoC follow the same implementation of Airoha AN7581 for
selecting the Serdes with SCU. Reuse the same function to also support the
feature on this specific SoC.

Signed-off-by: Christian Marangi <ansuelsmth@gmail.com>
---
 drivers/clk/clk-en7523.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

--- a/drivers/clk/clk-en7523.c
+++ b/drivers/clk/clk-en7523.c
@@ -1391,8 +1391,12 @@ static int an7583_clk_hw_init(struct pla
 	regmap_update_bits(clk_map, REG_NP_SCU_PCIC, REG_PCIE_CTRL,
 			   FIELD_PREP(REG_PCIE_CTRL, 3));
 
-	return en7581_reset_register(dev, clk_map, an7583_rst_map,
-				     ARRAY_SIZE(an7583_rst_map));
+	err = en7581_reset_register(dev, clk_map, an7583_rst_map,
+				    ARRAY_SIZE(an7583_rst_map));
+	if (err)
+		return err;
+
+	return en7581_serdes_phy_register(&pdev->dev);
 }
 
 static int en7523_clk_probe(struct platform_device *pdev)
