+		return ret;
+
 	ret = omci_mib_add_default(agent, OMCI_CLASS_ONU_DATA, 0, data,
 				   sizeof(data));
 	if (ret)
@@ -1256,23 +1493,32 @@ static int omci_agent_populate_defaults(struct omci_agent *agent)
 	if (ret)
 		return ret;
 
-	for (i = 0; i < 8; i++) {
