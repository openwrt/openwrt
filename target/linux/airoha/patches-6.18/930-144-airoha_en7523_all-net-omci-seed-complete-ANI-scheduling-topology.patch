-	}
 
-	ret = omci_mib_add_default(agent, OMCI_CLASS_TRAFFIC_SCHEDULER,
-				   0x8000, data, sizeof(data));
-	if (ret)
-		return ret;
+		for (queue = 0; queue < topology.queues_per_tcont; queue++) {
