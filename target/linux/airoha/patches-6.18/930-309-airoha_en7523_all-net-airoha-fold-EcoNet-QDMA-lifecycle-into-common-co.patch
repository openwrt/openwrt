From aaeccec84b8c63eef789725497970a295c1157ef Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Wed, 26 Aug 2026 00:22:34 -0300
Subject: [PATCH] net: airoha: fold EcoNet QDMA lifecycle into common core

Route EN751221/EN7528 QDMA initialization and NAPI/DMA lifecycle through the common airoha_qdma entry points. Decode source ports through soc_data callbacks and use the EN7528 five-bit RX SPORT layout while retaining rate-limited diagnostics for the MIPS SoCs. Keep the MIPS SoC data beside the other Airoha SoC descriptions.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c | 464 ++++++++++++-----------
 drivers/net/ethernet/airoha/airoha_eth.h |   3 +-
 2 files changed, 237 insertions(+), 230 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 7aeb33ac20d1..48faa6f8bf3a 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -60,6 +60,10 @@
 #include "airoha_regs.h"
 #include "airoha_wed.h"
 
+static void econet_prepare_qdma_cfg(struct airoha_qdma_mips_cfg *cfg,
+				    const struct airoha_eth_soc_data *soc,
+				    int id);
+
 /* ------------------------------------------------------------------------- */
 /* Common Ethernet helpers shared by all supported frame engines. */
 
@@ -555,7 +559,12 @@ static void econet_qdma_rx_process_one(struct econet_q_rx *q, u32 cpu_i,
 	airoha_ppe_dev_check_skb_reason(q->qdma->qdma->eth->ppe_dev, skb, hash,
 					get_erx_crsn(&desc.msg.erx));
 
-	sport = get_erx_sport(&desc.msg.erx);
+	if (airoha_is(q->qdma->qdma->eth, econet_en7528))
+		sport = FIELD_GET(EN7528_ERX_SPORT_MASK,
+				  desc.msg.erx.bitfield_0);
+	else
+		sport = get_erx_sport(&desc.msg.erx);
+
 	if (econet_rx_before_recv(q->qdma->qdma->eth, skb, sport)) {
 		dev_kfree_skb(skb);
 	} else {
@@ -1896,54 +1905,10 @@ static int econet_qdma_destroy(struct airoha_qdma_mips *qdma)
 	return econet_qdma_destroy_locked(qdma);
 }
 
-static int econet_qdma_use_mips(struct airoha_qdma_mips *qdma)
-{
-	struct qregs_qcfg qcfg;
-	int i;
-
-	guard(mutex)(&qdma->lock);
-
-	if (qdma->qdma->users++ > 0)
-		return 0;
-
-	for (i = 0; i < ARRAY_SIZE(qdma->q_rx); i++)
-		napi_enable(&qdma->q_rx[i].napi);
-
-	for (i = 0; i < ARRAY_SIZE(qdma->q_tx_done); i++)
-		napi_enable(&qdma->q_tx_done[i].napi);
-
-	/* NAPI must be ready before enabling a DMA engine that can raise IRQs. */
-	qcfg = econet_rreg(&qdma->regs->qdma_cfg);
-	set_qregs_qcfg_rx_dma_en(&qcfg, true);
-	set_qregs_qcfg_tx_dma_en(&qcfg, true);
-	econet_wreg(qcfg, &qdma->regs->qdma_cfg);
-
-	return 0;
-}
-
-static int econet_qdma_unuse_mips(struct airoha_qdma_mips *qdma)
+static void econet_qdma_cleanup_tx(struct airoha_qdma_mips *qdma)
 {
-	struct qregs_qcfg qcfg;
 	int i, j;
 
-	guard(mutex)(&qdma->lock);
-
-	if (WARN_ON_ONCE(qdma->qdma->users <= 0))
-		return -EINVAL;
-	if (--qdma->qdma->users > 0)
-		return 0;
-
-	qcfg = econet_rreg(&qdma->regs->qdma_cfg);
-	set_qregs_qcfg_rx_dma_en(&qcfg, false);
-	set_qregs_qcfg_tx_dma_en(&qcfg, false);
-	econet_wreg(qcfg, &qdma->regs->qdma_cfg);
-
-	for (i = 0; i < ARRAY_SIZE(qdma->q_rx); i++)
-		napi_disable(&qdma->q_rx[i].napi);
-
-	for (i = 0; i < ARRAY_SIZE(qdma->q_tx_done); i++)
-		napi_disable(&qdma->q_tx_done[i].napi);
-
 	for (i = 0; i < ARRAY_SIZE(qdma->q_tx); i++) {
 		struct econet_q_tx *q = &qdma->q_tx[i];
 
@@ -1951,12 +1916,11 @@ static int econet_qdma_unuse_mips(struct airoha_qdma_mips *qdma)
 		for (j = 0; j < q->ndesc; j++) {
 			struct econet_q_tx_ent *e = &q->entry[j];
 
-			/* In the free list already */
 			if (!e->dma_addr)
 				continue;
 
-			dma_unmap_single(qdma->qdma->eth->dev, e->dma_addr, e->dma_len,
-					DMA_TO_DEVICE);
+			dma_unmap_single(qdma->qdma->eth->dev, e->dma_addr,
+					 e->dma_len, DMA_TO_DEVICE);
 			dev_kfree_skb_any(e->skb);
 			memset(e, 0, sizeof(*e));
 
@@ -1965,18 +1929,6 @@ static int econet_qdma_unuse_mips(struct airoha_qdma_mips *qdma)
 			q->freelist_tail = j;
 		}
 	}
-
-	return 0;
-}
-
-static int airoha_qdma_mips_use(struct airoha_qdma *qdma)
-{
-	return qdma->econet ? econet_qdma_use_mips(qdma->econet) : -ENODEV;
-}
-
-static int airoha_qdma_mips_unuse(struct airoha_qdma *qdma)
-{
-	return qdma->econet ? econet_qdma_unuse_mips(qdma->econet) : -ENODEV;
 }
 
 static int airoha_qdma_mips_xmit(struct airoha_qdma *qdma,
@@ -1993,45 +1945,6 @@ static int airoha_qdma_mips_set_xpon_irq(struct airoha_qdma *qdma,
 			     -ENODEV;
 }
 
-static int airoha_qdma_init_mips(struct platform_device *pdev,
-			 struct airoha_eth *eth, struct airoha_qdma *qdma,
-			 int *irqs, struct airoha_qdma_mips_cfg *cfg)
-{
-	struct airoha_qdma_mips *econet;
-	int id = qdma - &eth->qdma[0];
-	const char *res;
-	int err;
-
-	res = devm_kasprintf(eth->dev, GFP_KERNEL, "qdma%d", id);
-	if (!res)
-		return -ENOMEM;
-
-	qdma->regs = devm_platform_ioremap_resource_byname(pdev, res);
-	if (IS_ERR(qdma->regs))
-		return dev_err_probe(eth->dev, PTR_ERR(qdma->regs),
-				     "failed to iomap qdma%d regs\n", id);
-
-	econet = devm_kzalloc(eth->dev, sizeof(*econet), GFP_KERNEL);
-	if (!econet)
-		return -ENOMEM;
-
-	airoha_qdma_setup(qdma, eth, qdma->regs, id, cfg->num_channels);
-	qdma->econet = econet;
-	econet->qdma = qdma;
-	econet->regs = qdma->regs;
-	mutex_init(&econet->lock);
-	memcpy(&econet->cfg, cfg, sizeof(*cfg));
-
-	err = econet_init(eth->dev, econet, irqs);
-	if (err) {
-		econet_qdma_destroy(econet);
-		qdma->econet = NULL;
-		return err;
-	}
-
-	return 0;
-}
-
 static int airoha_qdma_get_mips_irqs(struct platform_device *pdev,
 				      struct airoha_qdma *qdma, int *irqs)
 {
@@ -2170,13 +2083,26 @@ airoha_qdma_get_xpon_dev(struct airoha_eth *eth)
 	return ERR_PTR(-ENODEV);
 }
 
+static u32
+airoha_qdma_get_rx_sport(struct airoha_eth *eth,
+			 struct airoha_qdma_desc *desc)
+{
+	u32 msg1 = le32_to_cpu(READ_ONCE(desc->msg1));
+
+	if (airoha_is(eth, airoha_en7523))
+		return FIELD_GET(EN7523_QDMA_ETH_RXMSG_SPORT_MASK, msg1);
+
+	return FIELD_GET(QDMA_ETH_RXMSG_SPORT_MASK, msg1);
+}
+
 static struct airoha_gdm_dev *
-airoha_qdma_get_gdm_dev(struct airoha_eth *eth, struct airoha_qdma_desc *desc)
+airoha_qdma_get_gdm_dev(struct airoha_eth *eth, u32 sport)
 {
 	struct airoha_gdm_port *port;
 	u16 p, d;
 
-	if (eth->soc->ops.get_dev_from_sport(desc, &p, &d))
+	if (!eth->soc->ops.get_dev_from_sport ||
+	    eth->soc->ops.get_dev_from_sport(eth, sport, &p, &d))
 		return ERR_PTR(-ENODEV);
 
 	if (p >= eth->soc->max_gdm_ports)
@@ -2477,8 +2403,11 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 		 * source port. Resolve them through the registered xPON GDM2
 		 * provider before applying the normal source-port decoder.
 		 */
-		dev = xpon_oam ? airoha_qdma_get_xpon_dev(eth) :
-				 airoha_qdma_get_gdm_dev(eth, desc);
+		if (xpon_oam)
+			dev = airoha_qdma_get_xpon_dev(eth);
+		else
+			dev = airoha_qdma_get_gdm_dev(
+				eth, airoha_qdma_get_rx_sport(eth, desc));
 		if (IS_ERR(dev)) {
 			if (xpon_oam)
 				dev_warn_ratelimited(eth->dev,
@@ -3461,8 +3390,7 @@ static int airoha_qdma_init_irq_banks(struct platform_device *pdev,
 }
 
 int airoha_qdma_init(struct platform_device *pdev,
-			    struct airoha_eth *eth,
-			    struct airoha_qdma *qdma)
+		     struct airoha_eth *eth, struct airoha_qdma *qdma)
 {
 	int err, id = qdma - &eth->qdma[0];
 	const char *res;
@@ -3476,8 +3404,51 @@ int airoha_qdma_init(struct platform_device *pdev,
 		return dev_err_probe(eth->dev, PTR_ERR(qdma->regs),
 				     "failed to iomap qdma%d regs\n", id);
 
+	if (airoha_is_econet(eth)) {
+		struct airoha_qdma_mips_cfg cfg;
+		struct airoha_qdma_mips *econet;
+		int irqs[ECONET_MAX_QDMA_IRQS] = {};
+
+		econet_prepare_qdma_cfg(&cfg, eth->soc, id);
+		airoha_qdma_setup(qdma, eth, qdma->regs, id, cfg.num_channels);
+
+		err = airoha_qdma_get_mips_irqs(pdev, qdma, irqs);
+		if (err)
+			return err;
+
+		econet = devm_kzalloc(eth->dev, sizeof(*econet), GFP_KERNEL);
+		if (!econet)
+			return -ENOMEM;
+
+		qdma->econet = econet;
+		econet->qdma = qdma;
+		econet->regs = qdma->regs;
+		mutex_init(&econet->lock);
+		memcpy(&econet->cfg, &cfg, sizeof(cfg));
+
+		err = econet_init(eth->dev, econet, irqs);
+		if (err) {
+			econet_qdma_destroy(econet);
+			qdma->econet = NULL;
+		}
+
+		return err;
+	}
+
 	airoha_qdma_setup(qdma, eth, qdma->regs, id, AIROHA_NUM_QOS_CHANNELS);
 
+	qdma->q_tx = devm_kcalloc(&pdev->dev,
+				 eth->soc->tx_ring,
+				 sizeof(*qdma->q_tx), GFP_KERNEL);
+	if (!qdma->q_tx)
+		return -ENOMEM;
+
+	qdma->q_rx = devm_kcalloc(&pdev->dev,
+				 eth->soc->rx_ring,
+				 sizeof(*qdma->q_rx), GFP_KERNEL);
+	if (!qdma->q_rx)
+		return -ENOMEM;
+
 	err = airoha_qdma_init_irq_banks(pdev, qdma);
 	if (err)
 		return err;
@@ -3535,13 +3506,18 @@ void airoha_qdma_cleanup(struct airoha_qdma *qdma)
 
 }
 
-/* Airoha QDMA runtime lifecycle. */
+/* QDMA runtime lifecycle shared by Airoha and EcoNet layouts. */
 void airoha_qdma_start_napi(struct airoha_qdma *qdma)
 {
 	int i;
 
-	if (qdma->econet)
+	if (qdma->econet) {
+		for (i = 0; i < ARRAY_SIZE(qdma->econet->q_tx_done); i++)
+			napi_enable(&qdma->econet->q_tx_done[i].napi);
+		for (i = 0; i < ARRAY_SIZE(qdma->econet->q_rx); i++)
+			napi_enable(&qdma->econet->q_rx[i].napi);
 		return;
+	}
 
 	for (i = 0; i < ARRAY_SIZE(qdma->q_tx_irq); i++)
 		napi_enable(&qdma->q_tx_irq[i].napi);
@@ -3558,8 +3534,13 @@ void airoha_qdma_stop_napi(struct airoha_qdma *qdma)
 {
 	int i;
 
-	if (qdma->econet)
+	if (qdma->econet) {
+		for (i = 0; i < ARRAY_SIZE(qdma->econet->q_tx_done); i++)
+			napi_disable(&qdma->econet->q_tx_done[i].napi);
+		for (i = 0; i < ARRAY_SIZE(qdma->econet->q_rx); i++)
+			napi_disable(&qdma->econet->q_rx[i].napi);
 		return;
+	}
 
 	for (i = 0; i < ARRAY_SIZE(qdma->q_tx_irq); i++)
 		napi_disable(&qdma->q_tx_irq[i].napi);
@@ -3574,17 +3555,52 @@ void airoha_qdma_stop_napi(struct airoha_qdma *qdma)
 
 void airoha_qdma_start(struct airoha_qdma *qdma)
 {
+	if (qdma->econet) {
+		struct qregs_qcfg qcfg;
+
+		guard(mutex)(&qdma->econet->lock);
+		if (qdma->users++ > 0)
+			return;
+
+		qcfg = econet_rreg(&qdma->econet->regs->qdma_cfg);
+		set_qregs_qcfg_rx_dma_en(&qcfg, true);
+		set_qregs_qcfg_tx_dma_en(&qcfg, true);
+		econet_wreg(qcfg, &qdma->econet->regs->qdma_cfg);
+		return;
+	}
+
+	if (qdma->users++ > 0)
+		return;
+
 	airoha_qdma_set(qdma, REG_QDMA_GLOBAL_CFG,
 			GLOBAL_CFG_TX_DMA_EN_MASK |
 			GLOBAL_CFG_RX_DMA_EN_MASK);
-	qdma->users++;
 }
 
 void airoha_qdma_stop(struct airoha_qdma *qdma)
 {
 	u32 status;
 
-	if (--qdma->users)
+	if (qdma->econet) {
+		struct qregs_qcfg qcfg;
+
+		guard(mutex)(&qdma->econet->lock);
+		if (WARN_ON_ONCE(qdma->users <= 0))
+			return;
+		if (--qdma->users > 0)
+			return;
+
+		qcfg = econet_rreg(&qdma->econet->regs->qdma_cfg);
+		set_qregs_qcfg_rx_dma_en(&qcfg, false);
+		set_qregs_qcfg_tx_dma_en(&qcfg, false);
+		econet_wreg(qcfg, &qdma->econet->regs->qdma_cfg);
+		econet_qdma_cleanup_tx(qdma->econet);
+		return;
+	}
+
+	if (WARN_ON_ONCE(qdma->users <= 0))
+		return;
+	if (--qdma->users > 0)
 		return;
 
 	airoha_qdma_clear(qdma, REG_QDMA_GLOBAL_CFG,
@@ -3773,20 +3789,13 @@ static int econet_dev_open(struct net_device *dev)
 		econet_wreg(rlt, &port->econet_regs->rx_len_threshold);
 	}
 
-	err = airoha_qdma_mips_use(port->qdma);
-	if (err) {
-		scoped_guard(spinlock, &port->reg_lock)
-			econet_wreg(0U, &port->econet_regs->stag_en);
-		airoha_gdm_phylink_disconnect(&port->common);
-		return err;
-	}
-
+	airoha_qdma_start(port->qdma);
 	netif_tx_start_all_queues(dev);
 
 	err = econet_xpon_start(port);
 	if (err) {
 		netif_tx_disable(dev);
-		airoha_qdma_mips_unuse(port->qdma);
+		airoha_qdma_stop(port->qdma);
 		airoha_gdm_phylink_disconnect(&port->common);
 		return err;
 	}
@@ -3814,7 +3823,8 @@ static int econet_dev_stop(struct net_device *dev)
 		}
 	}
 
-	return airoha_qdma_mips_unuse(port->qdma);
+	airoha_qdma_stop(port->qdma);
+	return 0;
 }
 
 static int econet_dev_change_mtu(struct net_device *dev, int mtu)
@@ -4347,45 +4357,23 @@ airoha_eth_get_gdm_dev(struct airoha_eth *eth, unsigned int id)
 }
 
 
-static bool econet_en751221_dsa_sport(u8 sport)
+static bool econet_en751221_dsa_sport(u32 sport)
 {
 	return sport >= EN751221_DSA_SPORT_BASE &&
 	       sport < EN751221_DSA_SPORT_BASE + EN751221_DSA_NUM_PORTS;
 }
 
-static struct net_device *econet_get_sport_dev(struct airoha_eth *eth,
-					     u8 sport)
-{
-	struct airoha_gdm_dev *dev;
-
-	/*
-	 * EN7512/EN7521 vendor RX metadata uses SPORT_QDMA_LAN (0) for packets
-	 * delivered to the CPU by QDMA0 and SPORT_QDMA_WAN (5) for QDMA1.
-	 * These are valid source-port values, not malformed descriptors.
-	 */
-	if (sport == ETX_FPORT_GDM2 || sport == ETX_FPORT_QDMA1_CPU)
-		dev = airoha_eth_get_gdm_dev(eth, AIROHA_GDM2_IDX);
-	else if (sport == ETX_FPORT_GDM1 || sport == ETX_FPORT_QDMA0_CPU ||
-		 (airoha_is(eth, econet_en751221) &&
-		  econet_en751221_dsa_sport(sport)))
-		dev = airoha_eth_get_gdm_dev(eth, AIROHA_GDM1_IDX);
-	else {
-		dev_info_ratelimited(eth->dev, "rx: on unexpected sport %u\n",
-				     sport);
-		dev = airoha_eth_get_gdm_dev(eth, AIROHA_GDM1_IDX);
-	}
-
-	return dev ? dev->common.netdev : NULL;
-}
-
 int econet_rx_before_recv(struct airoha_eth *eth, struct sk_buff *skb,
 			  u8 sport)
 {
+	struct airoha_gdm_dev *dev;
 	struct net_device *port;
 
-	port = econet_get_sport_dev(eth, sport);
-	if (!port)
-		return -ENODEV;
+	dev = airoha_qdma_get_gdm_dev(eth, sport);
+	if (IS_ERR(dev))
+		return PTR_ERR(dev);
+
+	port = dev->common.netdev;
 
 	/*
 	 * EN7512/EN7521 keeps the MT7530 special tag in-band. The vendor
@@ -4643,9 +4631,9 @@ static int econet_xpon_control_start(struct net_device *netdev)
 	 * QDMA1 alive independently from ndo_open(), mirroring the vendor WAN
 	 * QDMA control-plane ownership.
 	 */
-	ret = airoha_qdma_mips_use(port->qdma);
-	if (!ret)
-		port->xpon_control_started = true;
+	airoha_qdma_start(port->qdma);
+	port->xpon_control_started = true;
+	ret = 0;
 out:
 	mutex_unlock(&port->xpon_lock);
 	return ret;
@@ -4661,7 +4649,7 @@ static void econet_xpon_control_stop(struct net_device *netdev)
 	mutex_lock(&port->xpon_lock);
 	if (port->xpon_control_started) {
 		port->xpon_control_started = false;
-		airoha_qdma_mips_unuse(port->qdma);
+		airoha_qdma_stop(port->qdma);
 	}
 	mutex_unlock(&port->xpon_lock);
 }
@@ -5109,42 +5097,6 @@ static void econet_prepare_qdma_cfg(struct airoha_qdma_mips_cfg *cfg,
 	}
 }
 
-/*
- * EN751221/EN7528 source-port decoding is intentionally kept on the
- * EN7523 mapping while the EcoNet/EN7516 RX metadata is being validated.
- * The MIPS frame engines only expose GDM1/GDM2 here and do not use the
- * EN7523+ NBQ-to-VIP mapping.
- */
-static int airoha_en7523_get_sport(struct airoha_gdm_port *port, int nbq);
-static int airoha_en7523_get_dev_from_sport(struct airoha_qdma_desc *desc,
-					    u16 *port, u16 *dev);
-
-const struct airoha_eth_soc_data econet_en751221_soc_data = {
-	.version = econet_en751221,
-	.xpon_ops = &econet_xpon_ops,
-	.num_ppe = 1,
-	.irq_banks = 1,
-	.max_gdm_ports = 2,
-	.pse_fq_cfg = PSE_FQ_CFG,
-	.ppe_dram_entries = 16 * 1024,
-	.ops = {
-		.get_sport = airoha_en7523_get_sport,
-		.get_dev_from_sport = airoha_en7523_get_dev_from_sport,
-	},
-};
-
-const struct airoha_eth_soc_data econet_en7528_soc_data = {
-	.version = econet_en7528,
-	.num_ppe = 1,
-	.irq_banks = 4,
-	.max_gdm_ports = 2,
-	.pse_fq_cfg = PSE_FQ_CFG,
-	.ppe_dram_entries = 16 * 1024,
-	.ops = {
-		.get_sport = airoha_en7523_get_sport,
-		.get_dev_from_sport = airoha_en7523_get_dev_from_sport,
-	},
-};
 
 /* ------------------------------------------------------------------------- */
 /* Airoha GDM/QDMA datapath. */
@@ -6442,36 +6394,7 @@ static int airoha_hw_init(struct platform_device *pdev,
 		return err;
 
 	for (i = 0; i < AIROHA_MAX_NUM_QDMA; i++) {
-		struct airoha_qdma *qdma = &eth->qdma[i];
-
-		if (airoha_is_econet(eth)) {
-			struct airoha_qdma_mips_cfg cfg;
-			int irqs[ECONET_MAX_QDMA_IRQS] = {};
-
-			econet_prepare_qdma_cfg(&cfg, eth->soc, i);
-			airoha_qdma_setup(qdma, eth, NULL, i, cfg.num_channels);
-			err = airoha_qdma_get_mips_irqs(pdev, qdma, irqs);
-			if (err)
-				goto error;
-
-			err = airoha_qdma_init_mips(pdev, eth, qdma, irqs, &cfg);
-		} else {
-			qdma->q_tx = devm_kcalloc(&pdev->dev, eth->soc->tx_ring,
-						 sizeof(*qdma->q_tx), GFP_KERNEL);
-			if (!qdma->q_tx) {
-				err = -ENOMEM;
-				goto error;
