diff --git a/Documentation/devicetree/bindings/dma/econet,gdma.yaml b/Documentation/devicetree/bindings/dma/econet,gdma.yaml
new file mode 100644
index 000000000..a8a1f5623
--- /dev/null
+++ b/Documentation/devicetree/bindings/dma/econet,gdma.yaml
@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/dma/econet,gdma.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha/EcoNet general DMA controller
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+description: |
+  The GDMA controller has eight channels with source, destination and control
+  registers. Each hardware transfer can copy up to 65535 bytes. The DMA specifier
+  selects a channel number from 0 to 7, rather than a peripheral request line.
+  Only memory-to-memory copies are currently supported. Registers use native
+  SoC byte order; EN751221 and EN751627 are big endian, the other variants are
+  little endian. The EN7523 vendor Device Tree does not describe an interrupt,
+  so the driver also supports polling for completion.
+
+allOf:
+  - $ref: dma-controller.yaml#
+
+properties:
+  compatible:
+    enum:
+      - econet,en751221-gdma
+      - airoha,en7523-gdma
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  resets:
+    maxItems: 1
+
+  '#dma-cells':
+    const: 1
+
+  dma-channels:
+    const: 8
+
+required:
+  - compatible
+  - reg
+  - '#dma-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/interrupt-controller/mips-gic.h>
+
+    dma-controller@1fb30000 {
+        compatible = "econet,en7580-gdma";
+        reg = <0x1fb30000 0x1000>;
+        interrupts = <GIC_SHARED 14 IRQ_TYPE_LEVEL_HIGH>;
+        #dma-cells = <1>;
+        dma-channels = <8>;
+    };
diff --git a/Documentation/devicetree/bindings/dma/econet,hsdma.yaml b/Documentation/devicetree/bindings/dma/econet,hsdma.yaml
new file mode 100644
index 000000000..7780f9dc0
--- /dev/null
+++ b/Documentation/devicetree/bindings/dma/econet,hsdma.yaml
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/dma/econet,hsdma.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha/EcoNet high-speed DMA controller
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+description: |
+  The HSDMA controller has two independent transmit/receive ring pairs and
+  uses 32-byte little-endian descriptors with a 16-bit length field. The DMA
+  specifier selects physical channel 0 or 1. Only memory copies are supported;
+  this controller does not expose a slave peripheral request interface.
+
+allOf:
+  - $ref: dma-controller.yaml#
+
+properties:
+  compatible:
+    enum:
+      - econet,en7580-hsdma
+      - airoha,en7523-hsdma
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  resets:
+    maxItems: 1
+
+  '#dma-cells':
+    const: 1
+
+  dma-channels:
+    const: 2
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - '#dma-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    dma-controller@1fa01800 {
+        compatible = "econet,en7523-hsdma";
+        reg = <0x1fa01800 0x300>;
+        interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
+        #dma-cells = <1>;
+        dma-channels = <2>;
+    };
