diff --git a/arch/arm/boot/dts/airoha/en7523.dtsi b/arch/arm/boot/dts/airoha/en7523.dtsi
index 35611455f..e8962c984 100644
--- a/arch/arm/boot/dts/airoha/en7523.dtsi
+++ b/arch/arm/boot/dts/airoha/en7523.dtsi
@@ -5,6 +5,7 @@
 #include <dt-bindings/clock/en7523-clk.h>
 #include <dt-bindings/reset/airoha,en7523-reset.h>
 #include <dt-bindings/leds/common.h>
+#include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/soc/airoha,scu-ssr.h>
 #include <dt-bindings/thermal/thermal.h>
 #include <dt-bindings/phy/phy.h>
@@ -374,6 +375,56 @@ mux {
 					pins = "gpio4";
 				};
 			};
+
+			/*
+			 * PCM/ISI pin groups from pinctrl-en7523.c. Mux
+			 * bits all live in chip_scu + 0x214
+			 * (REG_GPIO_SPI_CS1_MODE): pcm1 gpio 24-27 bit 12,
+			 * pcm2 gpio 16-19 bit 13, pcm_spi gpio 16-19,24-27
+			 * bit 16, pcm_spi_rst gpio 14 bit 8, pcm_spi_int
+			 * gpio 15 bit 9, pcm_spi_cs1 gpio 22 bit 17.
+			 * "pcm_spi" occupies the same eight pins as pcm1
+			 * and pcm2 together -- the SLIC control channel is
+			 * multiplexed onto the PCM pins, not a separate
+			 * bus. Do not select pcm1/pcm2 and pcm_spi at the
+			 * same time.
+			 */
+			pcm1_pins: pcm1-pins {
+				mux {
+					function = "pcm";
+					groups = "pcm1";
+				};
+			};
+
+			pcm2_pins: pcm2-pins {
+				mux {
+					function = "pcm";
+					groups = "pcm2";
+				};
+			};
+
+			/* PCM bus plus the multiplexed SLIC control channel */
+			pcm_spi_pins: pcm-spi-pins {
+				mux {
+					function = "pcm_spi";
+					groups = "pcm_spi", "pcm_spi_int", "pcm_spi_rst";
+				};
+			};
+
+			/* one chip select per SLIC; add only what the board wires */
+			pcm_spi_cs1_pins: pcm-spi-cs1-pins {
+				mux {
+					function = "pcm_spi";
+					groups = "pcm_spi_cs1";
+				};
+			};
+
+			pcm_spi_cs2_pins: pcm-spi-cs2-pins {
+				mux {
+					function = "pcm_spi";
+					groups = "pcm_spi_cs2_p128";
+				};
+			};
 		};
 
 		pwm: pwm {
@@ -383,6 +434,116 @@ pwm: pwm {
 		};
 	};
 
+	pcm0: pcm@1fbd0000 {
+		compatible = "airoha,en7523-pcm";
+		reg = <0x1fbd0000 0x1000>;
+		reg-names = "pcm";
+
+		interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
+
+		resets = <&scuclk EN7523_PCM1_RST>;
+		reset-names = "pcm";
+
+		/*
+		 * With a pinctrl state present the driver leaves the mux
+		 * alone -- the pinctrl core applies it before probe.
+		 * Boards using the multiplexed SLIC control channel want
+		 * &pcm_spi_pins here instead of &pcm1_pins.
+		 */
+		pinctrl-names = "default";
+		pinctrl-0 = <&pcm1_pins>;
+
+		/*
+		 * The computed default from the vendor's own config node
+		 * is 0x00051306; the value below is what a stock device
+		 * reads back. If a board misbehaves, 0x00051306 is the
+		 * other candidate.
+		 */
+		airoha,pcm-interface-control = <0xf5071306>;
+
+		airoha,tx-slot-config = <0x10301020 0x10501040
+					 0x10701060 0x10901080>;
+		airoha,rx-slot-config = <0x10301020 0x10501040
+					 0x10701060 0x10901080>;
+		airoha,dma-channel-mask = <0x0f>;
+
+		status = "disabled";
+	};
+
+	/*
+	 * Second PCM instance. Present in silicon and inside the vendor's
+	 * window, but the confirmed EN7523 map exposes one PCM interrupt
+	 * (GIC SPI 27) and a separate I2S interrupt (GIC SPI 48). Do not
+	 * assign the I2S interrupt to this speculative second PCM node.
+	 * Without "interrupts" the driver uses its polling worker.
+	 */
+	pcm1: pcm@1fbd2000 {
+		compatible = "airoha,en7523-pcm";
+		reg = <0x1fbd2000 0x1000>;
+		reg-names = "pcm";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pcm2_pins>;
+		airoha,pcm-interface-control = <0xf5071306>;
+		status = "disabled";
+	};
+
+	/*
+	 * ZSI. On EN7523 the SLIC serial path does not use the old SIF
+	 * block, and it does not use spi@1fa10000 either -- that is the
+	 * flash controller. It rides the PCM pins through the wrapper in
+	 * this window, which is why this node wants &pcm_spi_pins and why
+	 * a board cannot have both this and pcm1_pins on pcm0.
+	 */
+	zsi0: zsi@1fbd1000 {
+		compatible = "airoha,en7523-zsi";
+		reg = <0x1fbd1000 0x1000>;
+		reg-names = "zsi";
+		resets = <&scuclk EN7523_PCM1_ZSI_ISI_RST>;
+		reset-names = "zsi";
+		clocks = <&scuclk EN7523_CLK_SLIC>;
+		clock-names = "slic";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pcm_spi_pins>, <&pcm_spi_cs1_pins>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+		airoha,zsi-gap-us = <5000>;
+		status = "disabled";
+	};
+
+	/*
+	 * ISI. Same wrapper as zsi0 above, same pins, same reset line --
+	 * ISI and ZSI are alternate framings of one physical block, so a
+	 * board enables at most one of these two nodes, never both.
+	 *
+	 * Unlike zsi0, this needs the raw SCU phandles: SYS SCU 0x94
+	 * (interface mode) and chip SCU 0x214/0x1d0/0x264 (clock source,
+	 * pin routing, audio PLL) are not modelled as clock/reset
+	 * providers upstream, so en75xx_isi_spi.c reaches them directly.
+	 * EN7523 additionally needs the audio PLL (see en75xx_isi_spi.c);
+	 * that is what produces the 24.576 MHz PSCLK the SLIC needs here,
+	 * since the generic peripheral clock tops out at 5 MHz.
+	 */
+	isi0: spi@1fbd1000 {
+		compatible = "airoha,en7523-isi-spi";
+		reg = <0x1fbd1000 0x1000>;
+		reg-names = "isi";
+		resets = <&scuclk EN7523_PCM1_ZSI_ISI_RST>;
+		reset-names = "isi";
+		clocks = <&scuclk EN7523_CLK_SLIC>;
+		clock-names = "slic";
+		airoha,scu = <&scuclk>;
+		airoha,chip-scu = <&chip_scu>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pcm_spi_pins>, <&pcm_spi_cs1_pins>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "disabled";
+	};
+
 	uart1: serial@1fbf0000 {
 		compatible = "ns16550";
 		reg = <0x1fbf0000 0x30>;
@@ -430,6 +591,27 @@ crypto@1e004000 {
 		interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>;
 	};
 
+	gdma: dma-controller@1fb30000 {
+		compatible = "airoha,en7523-gdma";
+		reg = <0x1fb30000 0x1000>;
+
+		resets = <&scuclk EN7523_GDMA_RST>;
+
+		#dma-cells = <1>;
+		dma-channels = <8>;
+	};
+
+	hsdma: dma-controller@1fa01800 {
+		compatible = "airoha,en7523-hsdma";
+		reg = <0x1fa01800 0x300>;
+
+		resets = <&scuclk EN7523_HSDMA_RST>;
+		interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
+
+		#dma-cells = <1>;
+		dma-channels = <2>;
+	};
+
 	thermal: thermal-sensor@1efbd800 {
 		compatible = "airoha,en7523-thermal";
 		reg = <0x1efbd000 0x0fff>;
@@ -617,6 +799,8 @@ xpon_phy: phy@1faf0000 {
 
 		airoha,scu = <&scuclk>;
 
+		tx-disable-gpios = <&pinctrl 16 GPIO_ACTIVE_HIGH>;
+
 		#phy-cells = <0>;
 
 		status = "disabled";
@@ -762,7 +946,7 @@ eth: ethernet@1fb50000 {
 		         <&scuclk EN7523_GDMP_RST>;
 		reset-names = "fe", "pdma", "qdma",
 		              "hsi0-mac", "hsi1-mac", "hsi-mac",
-									"gdmp";
+		              "gdmp";
 
 		interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>,
 		             <GIC_SPI 55 IRQ_TYPE_LEVEL_HIGH>,
diff --git a/arch/mips/boot/dts/econet/en751221.dtsi b/arch/mips/boot/dts/econet/en751221.dtsi
index c2677ed30..6493e91f3 100644
--- a/arch/mips/boot/dts/econet/en751221.dtsi
+++ b/arch/mips/boot/dts/econet/en751221.dtsi
@@ -18,6 +18,14 @@ / {
 	#address-cells = <1>;
 	#size-cells = <1>;
 
+	aliases {
+		serial0 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
 	hpt_clock: clock {
 		compatible = "fixed-clock";
 		#clock-cells = <0>;
@@ -270,7 +278,7 @@ usb: usb@1fb90000 {
 		usb3-lpm-capable;
 	};
 
-	uart: serial@1fbf0000 {
+	uart1: serial@1fbf0000 {
 		compatible = "ns16550";
 		reg = <0x1fbf0000 0x30>;
 		reg-io-width = <4>;
@@ -299,7 +307,7 @@ pinctrl: pinctrl {
 
 			gpio-controller;
 			#gpio-cells = <2>;
-			gpio-ranges = <&pinctrl 0 13 29>;
+			gpio-ranges = <&pinctrl 0 13 31>;
 
 			interrupt-controller;
 			#interrupt-cells = <2>;
@@ -317,14 +325,136 @@ mux {
 					groups = "pon";
 				};
 			};
+
+			/*
+			 * PCM/ZSI pin groups. Every PCM mux bit lives in
+			 * chip_scu + 0x0104 (REG_IOMUX_CONTROL1): pcm1
+			 * gpio 25-28 bit 13, pcm2 gpio 17-20 bit 14,
+			 * pcm_spi gpio 17-20 bit 12 (SPI2_MODE), pcm_spi_int
+			 * gpio 16 bit 11, pcm_spi_rst gpio 15 bit 10,
+			 * pcm_spi_cs4 gpio 22 bit 9, pcm_spi_cs3 gpio 16
+			 * bit 8. "pcm_spi" occupies the same four pins as
+			 * "pcm2", so a board using the multiplexed SLIC
+			 * control channel gives up the second PCM bus.
+			 * pcm_spi_int and pcm_spi_cs3 are both gpio 16 --
+			 * pick one.
+			 */
+			pcm1_pins: pcm1-pins {
+				mux {
+					function = "pcm";
+					groups = "pcm1";
+				};
+			};
+
+			pcm2_pins: pcm2-pins {
+				mux {
+					function = "pcm";
+					groups = "pcm2";
+				};
+			};
+
+			/* PCM bus 2 pins carrying the multiplexed SLIC control channel */
+			pcm_spi_pins: pcm-spi-pins {
+				mux {
+					function = "pcm_spi";
+					groups = "pcm_spi", "pcm_spi_rst";
+				};
+			};
+
+			pcm_spi_cs4_pins: pcm-spi-cs4-pins {
+				mux {
+					function = "pcm_spi";
+					groups = "pcm_spi_cs4";
+				};
+			};
 		};
 	};
 
-	gdma: gdma@1fb30000 {
-		compatible = "econet,en751627-gdma";
-		reg = <0x1fb30000 0x1000>;
+	pcm0: pcm@1fbd0000 {
+		compatible = "econet,en751221-pcm";
+		reg = <0x1fbd0000 0x1000>;
+		reg-names = "pcm";
+
+		/* PCM1 input in the EN751221 interrupt controller. */
+		interrupt-parent = <&intc>;
+		interrupts = <11>;
+
+		resets = <&scuclk EN751221_PCM1_RST>;
+		reset-names = "pcm";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pcm1_pins>;
+
+		/* read back from stock firmware; see pcm_asterisk docs/01 */
+		airoha,pcm-interface-control = <0xf5071306>;
+
+		/*
+		 * 16-bit slots at bit offsets 32, 48, 64, 80, 96, 112,
+		 * 128, 144. Two slots per register; low half is the even
+		 * slot, high half the odd one.
+		 */
+		airoha,tx-slot-config = <0x10301020 0x10501040
+					 0x10701060 0x10901080>;
+		airoha,rx-slot-config = <0x10301020 0x10501040
+					 0x10701060 0x10901080>;
+		airoha,dma-channel-mask = <0xff>;
+
+		status = "disabled";
+	};
+
+	/* Second PCM instance. Present in silicon; rarely wired up. */
+	pcm1: pcm@1fbd2000 {
+		compatible = "econet,en751221-pcm";
+		reg = <0x1fbd2000 0x1000>;
+		reg-names = "pcm";
+		/* PCM2 input; hwirq 33 is in the controller's second bank. */
+		interrupt-parent = <&intc>;
+		interrupts = <33>;
+		resets = <&scuclk EN751221_PCM2_RST>;
+		reset-names = "pcm";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pcm2_pins>;
+		airoha,pcm-interface-control = <0xf5071306>;
+		status = "disabled";
+	};
+
+	/*
+	 * ZSI: the SLIC control channel multiplexed over the PCM bus.
+	 * It rides the pcm2 pins, so a board that enables this cannot
+	 * also mux pcm2 on pcm1 above.
+	 */
+	zsi0: zsi@1fbd1000 {
+		compatible = "econet,en751221-zsi";
+		reg = <0x1fbd1000 0x1000>;
+		reg-names = "zsi";
+
+		airoha,scu = <&scuclk>;
+		airoha,chip-scu = <&chip_scu>;
+		resets = <&scuclk EN751221_PCM1_ZSI_ISI_RST>;
+		reset-names = "zsi";
+
+		/*
+		 * Temporary compatibility path: the current MIPS clock provider
+		 * has no SLIC clock. These raw offsets are verified on EN751221
+		 * only and the driver rejects this property on other SoCs.
+		 */
+		airoha,legacy-scu-programming;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pcm_spi_pins>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/*
+		 * Inter-byte gap. The wrapper acknowledges a byte as soon
+		 * as it has sent it, but the SLIC still has to clock it
+		 * over the 8 kHz bus. Below about 2000 us the SLIC
+		 * mis-parses profile streams.
+		 */
+		airoha,zsi-gap-us = <5000>;
 
-		interrupts = <GIC_SHARED 14 IRQ_TYPE_LEVEL_HIGH>;
+		status = "disabled";
 	};
 
 	xpon_phy: phy@1faf0000 {
@@ -341,6 +471,8 @@ xpon_phy: phy@1faf0000 {
 		airoha,scu = <&scuclk>;
 		airoha,chip-scu = <&chip_scu>;
 
+		tx-disable-gpios = <&pinctrl 16 GPIO_ACTIVE_HIGH>;
+
 		#phy-cells = <0>;
 
 		status = "disabled";
@@ -380,7 +512,7 @@ xdsl: dsl@1f900000 {
 		interrupt-names = "dmt";
 
 		resets = <&scuclk EN751221_DMT_RST>,
-			 <&scuclk EN751221_PTM_MAC_RST>;
+		         <&scuclk EN751221_PTM_MAC_RST>;
 		reset-names = "dmt", "ptm";
 
 		ethernet = <&gdm2>;
@@ -530,13 +662,14 @@ fsw_phy0: ethernet-phy@8 {
 				leds {
 					#address-cells = <1>;
 					#size-cells = <0>;
-					led@0 {
+
+					fsw_phy0_led0: led@0 {
 						reg = <0>;
 						function = LED_FUNCTION_LAN;
