 		dev_kfree_skb(skb);
 	} else {
@@ -581,7 +601,8 @@ static void econet_qdma_rx_process_one(struct econet_q_rx *q, u32 cpu_i,
 	page_pool_put_full_page(q->page_pool, page, false);
