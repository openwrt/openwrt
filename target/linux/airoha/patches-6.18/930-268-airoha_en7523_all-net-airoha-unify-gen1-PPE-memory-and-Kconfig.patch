+	return (__le32 *)((u8 *)ppe->foe_table +
+			 (size_t)hash * EN751221_FOE_ENTRY_SIZE);
 }
 
-static void en75_ppe_read_entry(struct en75_ppe *ppe, u16 hash,
-				struct en75_foe_entry *entry)
