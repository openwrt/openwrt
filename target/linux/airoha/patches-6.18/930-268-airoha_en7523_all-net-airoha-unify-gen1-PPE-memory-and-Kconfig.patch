From 8bc487ab0bb164b34c3b0278e7134f0e7ee9a75a Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 11 Aug 2026 14:04:48 -0300
Subject: [PATCH] net: airoha: unify gen1 PPE memory and Kconfig

Use CONFIG_NET_AIROHA as the single build switch for both EcoNet generation-1 and Airoha generation-2 frame-engine support. The device-tree compatible and airoha_eth_soc_data version now select the hardware backend at runtime.

Move the generation-1 PPE state and FoE layout into airoha_eth.h, rename the en75_* namespace to econet_*, and reuse shared FE/PPE register definitions where the hardware layout is common.

Allocate the EN751221/EN7528 FoE table with dmam_alloc_coherent() under the common Ethernet DMA mask instead of requiring a fixed reserved-memory mapping. Access the coherent FoE table as RAM and retain DMA barriers around hardware ownership changes.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/Kconfig           |  47 +-
 drivers/net/ethernet/airoha/Makefile          |  12 +-
 drivers/net/ethernet/airoha/airoha_eth.h      |  72 ++-
 drivers/net/ethernet/airoha/airoha_eth_gen1.c |   4 -
 drivers/net/ethernet/airoha/airoha_eth_gen2.c |   1 -
 drivers/net/ethernet/airoha/airoha_ppe.c      | 577 ++++++++----------
 drivers/net/ethernet/airoha/airoha_regs.h     |  63 +-
 include/linux/soc/airoha/airoha_offload.h     |   2 +-
 8 files changed, 374 insertions(+), 404 deletions(-)

diff --git a/drivers/net/ethernet/airoha/Kconfig b/drivers/net/ethernet/airoha/Kconfig
index b31a0747a6a9..016b75fbcccb 100644
--- a/drivers/net/ethernet/airoha/Kconfig
+++ b/drivers/net/ethernet/airoha/Kconfig
@@ -8,18 +8,6 @@ config NET_VENDOR_AIROHA
 
 if NET_VENDOR_AIROHA
 
-config NET_AIROHA_ETH_CORE
-	tristate
-	select NET_AIROHA_COMMON
-	select PAGE_POOL
-
-config NET_AIROHA_COMMON
-	tristate
-	select PHYLINK
-	help
-	  Common GDM, phylink and PPE infrastructure shared by the Airoha ARM
-	  and EcoNet MIPS Ethernet datapaths.
-
 config NET_AIROHA_NPU
 	tristate "Airoha NPU support"
 	depends on ARCH_AIROHA || COMPILE_TEST
@@ -32,37 +20,26 @@ config NET_AIROHA_NPU
 	  available and PPE statistics or firmware-assisted commits are needed.
 
 config NET_AIROHA
-	tristate "Airoha SoC Gigabit Ethernet support"
-	select NET_AIROHA_ETH_CORE
-	select NET_AIROHA_COMMON
-	select PAGE_POOL
-	imply NET_AIROHA_NPU if ARCH_AIROHA
-	help
-	  Support the EN7523/EN7581-family Ethernet datapath. GDM/phylink and
-	  PPE infrastructure are provided by the shared Airoha common module.
-
-config NET_ECONET
-	tristate "EcoNet SoC Gigabit Ethernet support"
-	depends on ECONET || COMPILE_TEST
+	tristate "Airoha/EcoNet frame-engine Ethernet support"
 	depends on OF
-	select NET_AIROHA_ETH_CORE
-	select NET_AIROHA_COMMON
+	select PHYLINK
 	select PAGE_POOL
+	imply NET_AIROHA_NPU if ARCH_AIROHA
 	help
-	  Support the dual-QDMA, dual-GDM frame engine found in EcoNet EN7512,
-	  EN7521, EN7526 and related EN751221-family MIPS SoCs.
-
-	  The generation-1 and generation-2 datapaths share the Ethernet host,
-	  QDMA classification, GDM/phylink and PPE infrastructure while keeping
-	  generation-specific descriptor/register handling isolated.
+	  Support the shared Airoha/EcoNet frame-engine Ethernet datapath,
+	  including generation-1 EN751221/EN7528 and generation-2
+	  EN7523/EN7581/AN7583 SoCs. The hardware generation is selected
+	  from the device-tree compatible and SoC data at runtime. QDMA, GDM,
+	  PPE and phylink infrastructure are built as one driver so both
+	  generations follow the same lifecycle and common interfaces.
 
 config NET_AIROHA_PPE_DEBUGFS
 	bool
 	default y
 	depends on NET_AIROHA && DEBUG_FS
 	help
-	  Build the EN7523/EN7581 PPE debugfs interface. EcoNet uses the
-	  shared PPE module without registering or building this interface.
+	  Build the PPE debugfs interface for the shared Airoha/EcoNet
+	  Ethernet driver.
 
 config NET_AIROHA_FLOW_STATS
 	default y
@@ -85,7 +62,7 @@ config NET_AIROHA_SOC_WED
 config AIROHA_XPON_V1
 	tristate "Airoha/EcoNet xPON MAC driver"
 	depends on ARCH_AIROHA || ECONET || COMPILE_TEST
-	depends on NET_AIROHA || NET_ECONET
+	depends on NET_AIROHA
 	depends on OF
 	depends on SFP
 	depends on AIROHA_LDDLA_PHY || AIROHA_LDDLA_PHY=n
diff --git a/drivers/net/ethernet/airoha/Makefile b/drivers/net/ethernet/airoha/Makefile
index f4165eae9a35..7ef6848ac3b3 100644
--- a/drivers/net/ethernet/airoha/Makefile
+++ b/drivers/net/ethernet/airoha/Makefile
@@ -3,14 +3,10 @@
 # Airoha and EcoNet frame-engine Ethernet drivers
 #
 
-# Shared GDM/phylink helpers and the common PPE frontend/backends.
-obj-$(CONFIG_NET_AIROHA_COMMON) += airoha-common.o
-airoha-common-y := airoha_common.o airoha_ppe.o
-airoha-common-$(CONFIG_NET_AIROHA_PPE_DEBUGFS) += airoha_ppe_debugfs.o
-
-# Shared Ethernet host with generation-specific FE backends.
-obj-$(CONFIG_NET_AIROHA_ETH_CORE) += airoha-eth.o
-airoha-eth-y := airoha_eth.o airoha_qdma.o airoha_eth_gen1.o airoha_eth_gen2.o
+obj-$(CONFIG_NET_AIROHA) += airoha-eth.o
+airoha-eth-y := airoha_common.o airoha_ppe.o airoha_eth.o airoha_qdma.o \
+		airoha_eth_gen1.o airoha_eth_gen2.o
+airoha-eth-$(CONFIG_NET_AIROHA_PPE_DEBUGFS) += airoha_ppe_debugfs.o
 airoha-eth-$(CONFIG_NET_AIROHA_SOC_WED) += airoha_wed.o airoha_wed_debugfs.o
 
 obj-$(CONFIG_NET_AIROHA_NPU) += airoha_npu.o
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
index 6a1c02f8e521..1297370bd587 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -775,6 +775,77 @@ struct airoha_ppe {
 	struct dentry *debugfs_dir;
 };
 
+/* EcoNet generation-1 PPE/FoE layout. */
+struct econet_foe_mac_info {
+	u16 vlan1;
+	u16 etype;
+	u32 dest_mac_hi;
+	u16 vlan2;
+	u16 dest_mac_lo;
+	u32 src_mac_hi;
+	u16 pppoe_id;
+	u16 src_mac_lo;
+	u16 minfo;
+	u16 winfo;
+	u32 w3info;
+	u32 amsdu;
+};
+
+struct econet_ipv4_tuple {
+	u32 src_ip;
+	u32 dest_ip;
+	union {
+		struct {
+			u16 dest_port;
+			u16 src_port;
+		};
+		u32 ports;
+	};
+};
+
+struct econet_foe_ipv4 {
+	struct econet_ipv4_tuple orig;
+	u32 ib2;
+	struct econet_ipv4_tuple new;
+	u16 timestamp;
+	u16 reserved[3];
+	u32 udf_tsid;
+	struct econet_foe_mac_info l2;
+};
+
+struct econet_foe_entry {
+	u32 ib1;
+	union {
+		struct econet_foe_ipv4 ipv4;
+		u32 data[19];
+	};
+};
+
+struct econet_flow_entry {
+	struct list_head list;
+	struct econet_foe_entry data;
+	unsigned long cookie;
+	u32 src_ip;
+	u32 dest_ip;
+	u16 src_port;
+	u16 dest_port;
+	u16 hash;
+};
+
+struct econet_ppe {
+	struct airoha_ppe_dev dev;
+	struct airoha_eth *eth;
+
+	void *foe_table;
+	dma_addr_t foe_dma;
+
+	/* Protects flows and FoE slot ownership in RX and TC paths. */
+	spinlock_t lock;
+	struct list_head flows;
+	struct list_head block_cb_list;
+	bool armed;
+};
+
 enum airoha_ids {
 	econet_en751221 = 0x751221,
 	econet_en7528 = 0x7528,
@@ -851,7 +922,6 @@ struct airoha_eth {
 
 	unsigned long state;
 	void __iomem *fe_regs;
-	void __iomem *ppe_regs;
 	void __iomem *gdmp_regs;
 
 	struct airoha_npu __rcu *npu;
