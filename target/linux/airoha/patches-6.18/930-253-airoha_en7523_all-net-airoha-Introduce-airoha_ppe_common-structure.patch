+
+struct airoha_ppe {
+	struct airoha_ppe_common common;
+
 	struct rhashtable l2_flows;
 	struct hlist_head pending_flows;
 
@@ -771,8 +777,6 @@ struct airoha_ppe {
 	 * the airoha-npu module) on every flow.
 	 */
