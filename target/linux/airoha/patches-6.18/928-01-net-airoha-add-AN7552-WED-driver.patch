+/* ---- platform driver ---- */
+
+static int airoha_wed_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node, *wdma_np, *pcie_np;
+	struct of_phandle_args args;
+	struct resource res;
+	struct mtk_wed_hw *hw;
+	int ret;
+
+	hw = devm_kzalloc(dev, sizeof(*hw), GFP_KERNEL);
+	if (!hw)
+		return -ENOMEM;
+
+	hw->dev = dev;
+	hw->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(hw->regs))
+		return PTR_ERR(hw->regs);
+
+	hw->irq = platform_get_irq(pdev, 0);
+	if (hw->irq < 0)
+		return hw->irq;
+
+	/* airoha,wdma = <&wdma n>: the WDMA engine of this WED */
+	ret = of_parse_phandle_with_fixed_args(np, "airoha,wdma", 1, 0, &args);
+	if (ret)
+		return dev_err_probe(dev, ret, "no airoha,wdma\n");
+	wdma_np = args.np;
+	hw->index = args.args[0];
+	if (hw->index >= AIROHA_WED_MAX_HW) {
+		of_node_put(wdma_np);
+		return dev_err_probe(dev, -EINVAL, "bad airoha,wdma index\n");
+	}
+	ret = of_address_to_resource(wdma_np, hw->index, &res);
+	of_node_put(wdma_np);
+	if (ret || res.start > U32_MAX)
+		return dev_err_probe(dev, ret ? ret : -EINVAL,
+				     "bad airoha,wdma\n");
+	hw->wdma_phy = res.start;
+	hw->wdma = devm_ioremap(dev, res.start, resource_size(&res));
+	if (!hw->wdma)
+		return -ENOMEM;
+
+	/* airoha,pcie = <&pcie>: the controller of the card this WED serves */
+	pcie_np = of_parse_phandle(np, "airoha,pcie", 0);
+	if (!pcie_np)
+		return dev_err_probe(dev, -EINVAL, "no airoha,pcie\n");
+	ret = of_address_to_resource(pcie_np, 0, &res);
+	if (ret || res.start > U32_MAX) {
+		of_node_put(pcie_np);
+		return dev_err_probe(dev, ret ? ret : -EINVAL, "bad airoha,pcie\n");
+	}
+	hw->pcie = pcie_np;			/* released in remove */
+	hw->pcie_base = res.start;
+
+	mutex_lock(&hw_lock);
+	if (hw_list[hw->index]) {
+		mutex_unlock(&hw_lock);
+		of_node_put(pcie_np);
+		return dev_err_probe(dev, -EBUSY, "WDMA %d is taken\n", hw->index);
+	}
+	hw_list[hw->index] = hw;
+	rcu_assign_pointer(mtk_soc_wed_ops, &airoha_wed_ops);
+	mutex_unlock(&hw_lock);
+
+	hw->debugfs_dir = debugfs_create_dir(dev_name(dev), NULL);
+	debugfs_create_file("regs", 0400, hw->debugfs_dir, hw,
+			    &airoha_wed_regs_fops);
+
+	platform_set_drvdata(pdev, hw);
+	dev_info(dev, "WED %d, REV 0x%08x, WDMA at 0x%08x, PCIe at 0x%08x\n",
+		 hw->index, readl(hw->regs + WED_REV_ID), hw->wdma_phy,
+		 hw->pcie_base);
+
+	return 0;
+}
+
+static void airoha_wed_remove(struct platform_device *pdev)
+{
+	struct mtk_wed_hw *hw = platform_get_drvdata(pdev);
+	bool last = true;
+	int i;
+
+	mutex_lock(&hw_lock);
+	hw_list[hw->index] = NULL;
+	for (i = 0; i < ARRAY_SIZE(hw_list); i++)
+		if (hw_list[i])
+			last = false;
+	if (last)
+		rcu_assign_pointer(mtk_soc_wed_ops, NULL);
+	mutex_unlock(&hw_lock);
+
+	if (last)
+		synchronize_rcu();
+	debugfs_remove_recursive(hw->debugfs_dir);
+	of_node_put(hw->pcie);
+}
+
+static const struct of_device_id airoha_wed_of_match[] = {
+	{ .compatible = "airoha,an7552-wed" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, airoha_wed_of_match);
+
+static struct platform_driver airoha_wed_driver = {
+	.probe = airoha_wed_probe,
+	.remove = airoha_wed_remove,
+	.driver = {
+		.name = "airoha-wed",
+		.of_match_table = airoha_wed_of_match,
+		.suppress_bind_attrs = true,	/* hw must outlive an attached chip */
+	},
+};
+module_platform_driver(airoha_wed_driver);
+
