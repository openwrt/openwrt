+	seq_printf(s, "WED %d, WDMA at 0x%08x, PCIe at 0x%08x, attached: %s\n",
+		   hw->index, hw->wdma_phy, hw->pcie_base,
+		   hw->wed_dev ? "yes" : "no");
+	for (i = 0; i < ARRAY_SIZE(airoha_wed_regs); i++)
+		seq_printf(s, "%-24s 0x%03x = 0x%08x\n", airoha_wed_regs[i].name,
+			   airoha_wed_regs[i].offset,
+			   readl(hw->regs + airoha_wed_regs[i].offset));
+	for (i = 0; i < ARRAY_SIZE(airoha_wdma_regs); i++)
+		seq_printf(s, "%-24s 0x%03x = 0x%08x\n", airoha_wdma_regs[i].name,
+			   airoha_wdma_regs[i].offset,
+			   readl(hw->wdma + airoha_wdma_regs[i].offset));
+
+	return 0;
+}
