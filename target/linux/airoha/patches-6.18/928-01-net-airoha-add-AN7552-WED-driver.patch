+static u32 airoha_wed_irq_get(struct mtk_wed_device *dev, u32 mask)
+{
+	u32 val;
+
+	val = wed_r32(dev, WED_EXT_INT_STATUS);
+	wed_w32(dev, WED_EXT_INT_STATUS, val);
+	val &= WED_EXT_INT_STATUS_ERROR_MASK;
+	if (val && net_ratelimit())
+		pr_err("airoha_wed%d: error status=%08x\n", dev->hw->index, val);
+
+	val = wed_r32(dev, WED_INT_STATUS);
+	val &= mask;
+	wed_w32(dev, WED_INT_STATUS, val);	/* ACK */
+
+	return val;
+}
+
+static void airoha_wed_irq_set_mask(struct mtk_wed_device *dev, u32 mask)
+{
+	wed_set_ext_int(dev, !!mask);
+	wed_w32(dev, WED_INT_MASK, mask);
+}
