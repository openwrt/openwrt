From 6dc203843d8128ac3152383af5a45f74a234d458 Mon Sep 17 00:00:00 2001
From: Cristian Papa <pcristian292@gmail.com>
Date: Wed, 30 Sep 2026 15:40:34 -0300
Subject: [PATCH] net: optical: airoha: lddla: wait longer for the lock on TX
 bring-up

lddla_lock() gives up after 100 ms, which suits the control loops and
the diagnostic paths: they can skip a round. TX re-arm and TX timing
calibration are different: they run once per PON bring-up, and when
either returns an error the xPON MAC tears the bring-up down and
starts it again.

On the Archer XR500v the GPON restart that follows the OMCI
configuration sometimes loses that race:

  airoha-xpon 1fb60000.xmac: xPON TX timing calibration failed: -145
  airoha-xpon 1fb60000.xmac: failed to restart GPON: -145

(-145 is -ETIMEDOUT on MIPS), and a boot through the BootROM rescue
showed the same for the re-arm. The retry a second later works, so it
only costs that second, but nothing keeps the retry from losing too.

Let these two operations wait up to 2 s for the lock. Everything else
keeps the 100 ms bound.

Logging every wait of 50 ms or more over 15 boots with this change: the
1 Hz control-loop tick held the lock for 130-180 ms, telemetry reads
for 110-160 ms and the timing calibration itself for up to ~450 ms. One
TX re-arm had to wait 165 ms and one timing calibration 111 ms behind
the tick; both would have failed with -ETIMEDOUT before. None of the 15
boots had a failed re-arm, calibration or GPON restart.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Signed-off-by: Cristian Papa <pcristian292@gmail.com>
Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 .../net/optical/airoha/airoha_lddla_core.c    | 37 +++++++++++++------
 1 file changed, 25 insertions(+), 12 deletions(-)

diff --git a/drivers/net/optical/airoha/airoha_lddla_core.c b/drivers/net/optical/airoha/airoha_lddla_core.c
index e40c69e85..b02a367c4 100644
--- a/drivers/net/optical/airoha/airoha_lddla_core.c
+++ b/drivers/net/optical/airoha/airoha_lddla_core.c
@@ -182,17 +182,9 @@ int lddla_rd32(struct airoha_lddla *lddla, u16 addr, u32 *val)
 	return 0;
 }
 
-/**
- * lddla_lock() - bounded acquire of the I2C/ADC lock.
- * @lddla: device
- *
- * The control loops and diagnostic paths must not block forever on contention,
- * so cap the wait at ~100 ms.  Return: 0 once held, -ETIMEDOUT on timeout, or
- * -ERESTARTSYS if a signal arrives in a user-context caller.
- */
-int lddla_lock(struct airoha_lddla *lddla)
+static int lddla_lock_ms(struct airoha_lddla *lddla, unsigned int ms)
 {
-	unsigned long deadline = jiffies + msecs_to_jiffies(100);
+	unsigned long deadline = jiffies + msecs_to_jiffies(ms);
 
 	while (!mutex_trylock(&lddla->lock)) {
 		if (signal_pending(current))
@@ -204,6 +196,27 @@ int lddla_lock(struct airoha_lddla *lddla)
 	return 0;
 }
 
+/**
+ * lddla_lock() - bounded acquire of the I2C/ADC lock.
+ * @lddla: device
+ *
+ * The control loops and diagnostic paths must not block forever on contention,
+ * so cap the wait at ~100 ms.  Return: 0 once held, -ETIMEDOUT on timeout, or
+ * -ERESTARTSYS if a signal arrives in a user-context caller.
+ */
+int lddla_lock(struct airoha_lddla *lddla)
+{
+	return lddla_lock_ms(lddla, 100);
+}
+
+/*
+ * TX re-arm and TX timing calibration run once per PON bring-up, and the MAC
+ * restarts the whole bring-up when either fails.  Other holders (the 1 Hz
+ * control loop, telemetry and diagnostics) can keep the lock for longer than
+ * the 100 ms that suits them, so give these two a longer, still bounded, wait.
+ */
+#define LDDLA_BRINGUP_LOCK_MS	2000
+
 /* ------------------------------------------------------------------ */
 /* Shared BOB / calibration store                                     */
 /* ------------------------------------------------------------------ */
@@ -575,7 +588,7 @@ static int airoha_lddla_frontend_tx_rearm(struct optical_frontend *frontend)
 	if (!lddla || !lddla->ops->tx_rearm)
 		return -EOPNOTSUPP;
 
-	ret = lddla_lock(lddla);
+	ret = lddla_lock_ms(lddla, LDDLA_BRINGUP_LOCK_MS);
 	if (ret)
 		return ret;
 
@@ -594,7 +607,7 @@ airoha_lddla_frontend_tx_timing_calibrate(struct optical_frontend *frontend)
 	if (!lddla || !lddla->ops->tx_timing_calibrate)
 		return -EOPNOTSUPP;
 
-	ret = lddla_lock(lddla);
+	ret = lddla_lock_ms(lddla, LDDLA_BRINGUP_LOCK_MS);
 	if (ret)
 		return ret;
 
-- 
