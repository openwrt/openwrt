-
-	ehdr = (struct ethhdr *)skb->data;
-	tag = be16_to_cpu(ehdr->h_proto);
-	xmit_tpid = tag >> 8;
-
-	switch (xmit_tpid) {
-	case MTK_HDR_XMIT_TAGGED_TPID_8100:
-		ehdr->h_proto = cpu_to_be16(ETH_P_8021Q);
