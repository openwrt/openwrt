-	qid = airoha_qdma_get_txq(qdma, skb_get_queue_mapping(skb));
-	if (xpon_oam) {
+	if (!xpon && (dev->flags & AIROHA_PRIV_F_XPON_MANAGED) &&
+	    dev->xpon_mode == AIROHA_XPON_MODE_GPON) {
