+				 INT_SN_ONU_SEND_O4 | INT_SN_REQ_CRS | \
+				 INT_LOSS_GEM_DEL | INT_AES_KEY_SWITCH_DONE | \
+				 INT_DYING_GASP | INT_CAL_GNT_SIZE_DONE)
