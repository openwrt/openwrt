+ */
+#define GPON_GEM_TBL_INIT	0x04C
+/* Upstream PLOAM FIFO */
+#define GPON_PLOAMu_FIFO_STS	0x050
+#define GPON_PLOAMu_WDATA	0x054
+/* Downstream PLOAM FIFO */
+#define GPON_PLOAMd_FIFO_STS	0x058
+#define GPON_PLOAMd_RDATA	0x05C
