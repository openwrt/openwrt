From 5bd79248e24536ac67d83513b21abba8c1653170 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Sat, 5 Sep 2026 22:29:06 -0300
Subject: [PATCH] net: phy: airoha: Add support for the AN8801 PHY

Refactor the existing EN8801S driver to support the Airoha AN8801 PHY
by introducing common data structures and abstracting device-specific
LED configurations.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/phy/airoha/Kconfig   |    3 +-
 drivers/net/phy/airoha/en8801s.c | 2183 +++++++++++++++++++++---------
 2 files changed, 1523 insertions(+), 663 deletions(-)

diff --git a/drivers/net/phy/airoha/Kconfig b/drivers/net/phy/airoha/Kconfig
index c2e0c2cf6..bdcc4d021 100644
--- a/drivers/net/phy/airoha/Kconfig
+++ b/drivers/net/phy/airoha/Kconfig
@@ -1,10 +1,11 @@
 config AIROHA_EN8801S_PHY
 	tristate "Drivers for Airoha EN8801S Gigabit PHYs"
 	help
-	  Currently supports the Airoha EN8801S PHY.
+	  Currently supports the Airoha EN8801S and AN8801 PHY.
 
 config AIROHA_EN8811H_PHY
 	tristate "Airoha EN8811H 2.5 Gigabit PHY"
 	select PHY_COMMON_PROPS
+	default n
 	help
 	  Currently supports the Airoha EN8811H PHY.
