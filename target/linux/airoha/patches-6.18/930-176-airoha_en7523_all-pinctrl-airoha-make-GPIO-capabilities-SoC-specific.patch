index f6c8f8344..77e0f0ac9 100644
--- a/drivers/pinctrl/airoha/pinctrl-en7528.c
+++ b/drivers/pinctrl/airoha/pinctrl-en7528.c
@@ -1162,7 +1162,7 @@ static const struct airoha_pinctrl_match_data pinctrl_match_data = {
 	.funcs = pinctrl_funcs,
 	.num_funcs = ARRAY_SIZE(pinctrl_funcs),
