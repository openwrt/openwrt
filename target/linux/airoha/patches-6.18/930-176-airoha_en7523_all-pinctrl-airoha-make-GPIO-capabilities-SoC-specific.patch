index 4509ced23..a8caf9d09 100644
--- a/drivers/pinctrl/airoha/pinctrl-an7581.c
+++ b/drivers/pinctrl/airoha/pinctrl-an7581.c
@@ -1484,9 +1484,9 @@ static const struct airoha_pinctrl_match_data pinctrl_match_data = {
 	.num_grps = ARRAY_SIZE(pinctrl_groups),
 	.funcs = pinctrl_funcs,
 	.num_funcs = ARRAY_SIZE(pinctrl_funcs),
-	.num_irq_pins = AIROHA_NUM_PINS,
 	.hwinit_regs = hwinit_regs,
 	.num_hwinit_regs = ARRAY_SIZE(hwinit_regs),
+	.num_irq = AIROHA_NUM_PINS,
 	.force_gpio_reg = REG_FORCE_GPIO_EN,
 	.confs_info = {
 		[AIROHA_PINCTRL_CONFS_PULLUP] = {
