+	err = airoha_qdma_prepare(pdev, eth, qdma, id);
+	if (err)
+		return err;
+
+	err = airoha_qdma_init_irqs(pdev, qdma);
 	if (err)
 		return err;
 
@@ -3454,7 +3491,7 @@ int airoha_qdma_init(struct platform_device *pdev,
 	if (err)
 		return err;
 
-	err = airoha_qdma_init_hfwd_queues(qdma);
+	err = airoha_qdma_init_hfwd(qdma);
 	if (err)
 		return err;
 
@@ -3615,49 +3652,6 @@ void airoha_qdma_stop(struct airoha_qdma *qdma)
 	}
 }
 
