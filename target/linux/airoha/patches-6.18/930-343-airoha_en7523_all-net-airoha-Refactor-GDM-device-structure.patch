From f4ac96b17331570f1fbe7b90c696fe96180a0075 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Fri, 28 Aug 2026 23:25:04 -0300
Subject: [PATCH] net: airoha: Refactor GDM device structure

Remove the intermediate `airoha_gdm_common` structure and integrate its
fields directly into `airoha_gdm_dev`. This simplifies the device
handling and aligns the data structures.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c | 1360 ++++++++++------------
 drivers/net/ethernet/airoha/airoha_eth.h |  115 +-
 drivers/net/ethernet/airoha/airoha_ppe.c |   14 +-
 3 files changed, 628 insertions(+), 861 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 0c8b7f156256..592d40e9984f 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -64,6 +64,15 @@ static void econet_prepare_qdma_cfg(struct airoha_qdma_mips_cfg *cfg,
 				    const struct airoha_eth_soc_data *soc,
 				    int id);
 
+static void airoha_mac_config(struct airoha_gdm_dev *dev, unsigned int mode,
+			      const struct phylink_link_state *state);
+static void airoha_mac_link_up(struct airoha_gdm_dev *dev,
+			       struct phy_device *phy,
+			       unsigned int mode, phy_interface_t interface,
+			       int speed, int duplex, bool tx_pause, bool rx_pause);
+static void airoha_mac_link_down(struct airoha_gdm_dev *dev, unsigned int mode,
+				 phy_interface_t interface);
+
 /* ------------------------------------------------------------------------- */
 /* Common Ethernet helpers shared by all supported frame engines. */
 
@@ -169,11 +178,11 @@ static void airoha_gdm_mac_config(struct phylink_config *config,
 				  unsigned int mode,
 				  const struct phylink_link_state *state)
 {
-	struct airoha_gdm_common *gdm;
+	struct airoha_gdm_dev *dev;
 
-	gdm = container_of(config, struct airoha_gdm_common, phylink_config);
-	if (gdm->mac_ops && gdm->mac_ops->mac_config)
-		gdm->mac_ops->mac_config(gdm->priv, mode, state);
+	dev = container_of(config, struct airoha_gdm_dev, phylink_config);
+	if (!airoha_is_econet(dev->eth))
+		airoha_mac_config(dev, mode, state);
 }
 
 static void airoha_gdm_mac_link_up(struct phylink_config *config,
@@ -183,23 +192,23 @@ static void airoha_gdm_mac_link_up(struct phylink_config *config,
 				   int speed, int duplex,
 				   bool tx_pause, bool rx_pause)
 {
-	struct airoha_gdm_common *gdm;
+	struct airoha_gdm_dev *dev;
 
-	gdm = container_of(config, struct airoha_gdm_common, phylink_config);
-	if (gdm->mac_ops && gdm->mac_ops->mac_link_up)
-		gdm->mac_ops->mac_link_up(gdm->priv, phy, mode, interface,
-					  speed, duplex, tx_pause, rx_pause);
+	dev = container_of(config, struct airoha_gdm_dev, phylink_config);
+	if (!airoha_is_econet(dev->eth))
+		airoha_mac_link_up(dev, phy, mode, interface, speed, duplex,
+				   tx_pause, rx_pause);
 }
 
 static void airoha_gdm_mac_link_down(struct phylink_config *config,
 				     unsigned int mode,
 				     phy_interface_t interface)
 {
-	struct airoha_gdm_common *gdm;
+	struct airoha_gdm_dev *dev;
 
-	gdm = container_of(config, struct airoha_gdm_common, phylink_config);
-	if (gdm->mac_ops && gdm->mac_ops->mac_link_down)
-		gdm->mac_ops->mac_link_down(gdm->priv, mode, interface);
+	dev = container_of(config, struct airoha_gdm_dev, phylink_config);
+	if (!airoha_is_econet(dev->eth))
+		airoha_mac_link_down(dev, mode, interface);
 }
 
 static const struct phylink_mac_ops airoha_gdm_phylink_ops = {
@@ -208,80 +217,61 @@ static const struct phylink_mac_ops airoha_gdm_phylink_ops = {
 	.mac_link_down = airoha_gdm_mac_link_down,
 };
 
-void airoha_gdm_common_init(struct airoha_gdm_common *gdm,
-			    struct airoha_eth *eth, struct net_device *netdev,
-			    enum airoha_eth_family family, u8 id,
-			    u8 pse_port, void *priv,
-			    const struct airoha_gdm_mac_ops *mac_ops)
-{
-	memset(gdm, 0, sizeof(*gdm));
-	gdm->magic = AIROHA_GDM_COMMON_MAGIC;
-	gdm->family = family;
-	gdm->id = id;
-	gdm->pse_port = pse_port;
-	gdm->eth = eth;
-	gdm->netdev = netdev;
-	gdm->priv = priv;
-	gdm->mac_ops = mac_ops;
-	gdm->phylink_config.dev = &netdev->dev;
-	gdm->phylink_config.type = PHYLINK_NETDEV;
-}
-
-int airoha_gdm_phylink_create(struct airoha_gdm_common *gdm,
+int airoha_gdm_phylink_create(struct airoha_gdm_dev *dev,
 			      struct device_node *np,
 			      phy_interface_t phy_mode)
 {
 	struct phylink *phylink;
 
-	phylink = phylink_create(&gdm->phylink_config,
+	phylink = phylink_create(&dev->phylink_config,
 				 of_fwnode_handle(np), phy_mode,
 				 &airoha_gdm_phylink_ops);
 	if (IS_ERR(phylink))
 		return PTR_ERR(phylink);
 
-	gdm->phylink = phylink;
+	dev->phylink = phylink;
 	return 0;
 }
 
-int airoha_gdm_phylink_connect(struct airoha_gdm_common *gdm,
+int airoha_gdm_phylink_connect(struct airoha_gdm_dev *dev,
 			       bool allow_no_phy)
 {
+	struct net_device *netdev = netdev_from_priv(dev);
 	int err;
 
-	if (!gdm->phylink)
+	if (!dev->phylink)
 		return -ENODEV;
 
-	err = phylink_of_phy_connect(gdm->phylink,
-				     gdm->netdev->dev.of_node, 0);
+	err = phylink_of_phy_connect(dev->phylink, netdev->dev.of_node, 0);
 	if (err) {
 		if (allow_no_phy && err == -ENODEV)
 			return 0;
 		return err;
 	}
 
-	phylink_start(gdm->phylink);
-	gdm->phylink_started = true;
+	phylink_start(dev->phylink);
+	dev->phylink_started = true;
 	return 0;
 }
 
-void airoha_gdm_phylink_disconnect(struct airoha_gdm_common *gdm)
+void airoha_gdm_phylink_disconnect(struct airoha_gdm_dev *dev)
 {
-	if (!gdm->phylink_started)
+	if (!dev->phylink_started)
 		return;
 
-	phylink_stop(gdm->phylink);
-	phylink_disconnect_phy(gdm->phylink);
-	gdm->phylink_started = false;
+	phylink_stop(dev->phylink);
+	phylink_disconnect_phy(dev->phylink);
+	dev->phylink_started = false;
 }
 
-void airoha_gdm_phylink_destroy(struct airoha_gdm_common *gdm)
+void airoha_gdm_phylink_destroy(struct airoha_gdm_dev *dev)
 {
-	airoha_gdm_phylink_disconnect(gdm);
-	if (!gdm->phylink)
+	airoha_gdm_phylink_disconnect(dev);
+	if (!dev->phylink)
 		return;
 
-	phylink_destroy(gdm->phylink);
-	gdm->phylink = NULL;
+	phylink_destroy(dev->phylink);
+	dev->phylink = NULL;
 }
 
 
@@ -1387,7 +1377,7 @@ static int econet_en751221_slm_init(struct airoha_qdma_mips *qdma,
 	return 0;
 }
 
-static int econet_init_hw_fwd(struct airoha_qdma_mips *qdma)
+static int econet_qdma_init_hfwd(struct airoha_qdma_mips *qdma)
 {
 	enum qregs_hwf_cfg_pkt_sz buf_size_cfg = QREGS_HWF_CFG_PKT_SZ_2048;
 	int ret, size, index, num_desc = qdma->cfg.num_fwd_descs;
@@ -1632,7 +1622,7 @@ static void econet_init_en751221_qdma(struct airoha_qdma_mips *qdma)
 	econet_wreg(cngst_cfg, &qdma->regs->tx_congest_cfg);
 }
 
-static int econet_init_final(struct airoha_qdma_mips *qdma)
+static int econet_qdma_hw_init(struct airoha_qdma_mips *qdma)
 {
 	struct qregs_qcfg qcfg;
 	int i;
@@ -1772,49 +1762,6 @@ static int econet_init_final(struct airoha_qdma_mips *qdma)
 	return 0;
 }
 
-static int econet_init(struct device *dev,
-		     struct airoha_qdma_mips *qdma,
-		     int *irqs)
-{
-	int err;
-	int i;
-
-	/* Make sure RX and TX are shutdown */
-	econet_wreg((struct qregs_qcfg) { 0 }, &qdma->regs->qdma_cfg);
-
-	err = econet_init_irqs(dev, qdma, irqs);
-	if (err)
-		return err;
-
-	for (i = 0; i < ARRAY_SIZE(qdma->q_rx); i++) {
-		err = econet_init_rx_queue(&qdma->q_rx[i], qdma,
-					 qdma->cfg.num_rx_descs[i]);
-		if (err)
-			return err;
-	}
-
-	for (i = 0; i < ARRAY_SIZE(qdma->q_tx_done); i++) {
-		err = econet_init_tx_doneq(&qdma->q_tx_done[i], qdma,
-					 qdma->cfg.done_list_size[i],
-					 qdma->cfg.done_list_irq_threshold[i]);
-		if (err)
-			return err;
-	}
-
-	for (i = 0; i < ARRAY_SIZE(qdma->q_tx); i++) {
-		err = econet_init_tx_queue(&qdma->q_tx[i], qdma,
-					 qdma->cfg.num_tx_descs[i]);
-		if (err)
-			return err;
-	}
-
-	err = econet_init_hw_fwd(qdma);
-	if (err)
-		return err;
-
-	return econet_init_final(qdma);
-}
-
 /* End init functions */
 
 static void econet_qdma_destroy_rxq_locked(struct econet_q_rx *q)
@@ -1966,6 +1913,55 @@ static int airoha_qdma_get_mips_irqs(struct platform_device *pdev,
 	return 0;
 }
 
+static int econet_qdma_init_irqs(struct platform_device *pdev,
+				 struct airoha_qdma_mips *qdma)
+{
+	int irqs[ECONET_MAX_QDMA_IRQS] = {};
+	int err;
+
+	err = airoha_qdma_get_mips_irqs(pdev, qdma->qdma, irqs);
+	if (err)
+		return err;
+
+	return econet_init_irqs(qdma->qdma->eth->dev, qdma, irqs);
+}
+
+static int econet_qdma_init_rx(struct airoha_qdma_mips *qdma)
+{
+	int i, err;
+
+	for (i = 0; i < ARRAY_SIZE(qdma->q_rx); i++) {
+		err = econet_init_rx_queue(&qdma->q_rx[i], qdma,
+					   qdma->cfg.num_rx_descs[i]);
+		if (err)
+			return err;
+	}
+
+	return 0;
+}
+
+static int econet_qdma_init_tx(struct airoha_qdma_mips *qdma)
+{
+	int i, err;
+
+	for (i = 0; i < ARRAY_SIZE(qdma->q_tx_done); i++) {
+		err = econet_init_tx_doneq(&qdma->q_tx_done[i], qdma,
+					   qdma->cfg.done_list_size[i],
+					   qdma->cfg.done_list_irq_threshold[i]);
+		if (err)
+			return err;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(qdma->q_tx); i++) {
+		err = econet_init_tx_queue(&qdma->q_tx[i], qdma,
+					   qdma->cfg.num_tx_descs[i]);
+		if (err)
+			return err;
+	}
+
+	return 0;
+}
+
 /* Airoha QDMA backend. */
 static void airoha_qdma_set_irqmask(struct airoha_irq_bank *irq_bank,
 				    int index, u32 clear, u32 set)
@@ -2681,7 +2677,7 @@ static void airoha_qdma_cleanup_rx_queue(struct airoha_queue *q)
 			FIELD_PREP(RX_RING_DMA_IDX_MASK, q->tail));
 }
 
-static int airoha_qdma_init_rx(struct airoha_qdma *qdma)
+static int airoha_qdma_modern_init_rx(struct airoha_qdma *qdma)
 {
 	int i;
 
@@ -2966,7 +2962,7 @@ static int airoha_qdma_tx_irq_init(struct airoha_tx_irq_queue *irq_q,
 	return 0;
 }
 
-static int airoha_qdma_init_tx(struct airoha_qdma *qdma)
+static int airoha_qdma_modern_init_tx(struct airoha_qdma *qdma)
 {
 	int i, err;
 
@@ -3036,7 +3032,7 @@ void airoha_qdma_cleanup_tx_queue(struct airoha_queue *q)
 	spin_unlock_bh(&q->lock);
 }
 
-static int airoha_qdma_init_hfwd_queues(struct airoha_qdma *qdma)
+static int airoha_qdma_modern_init_hfwd(struct airoha_qdma *qdma)
 {
 	int size, index, num_desc = HW_DSCP_NUM;
 	struct airoha_eth *eth = qdma->eth;
@@ -3212,7 +3208,7 @@ static void airoha_qdma_init_qos_stats(struct airoha_qdma *qdma)
 	}
 }
 
-static int airoha_qdma_hw_init(struct airoha_qdma *qdma)
+static int airoha_qdma_modern_hw_init(struct airoha_qdma *qdma)
 {
 	int i;
 
@@ -3345,8 +3341,8 @@ static irqreturn_t airoha_irq_handler(int irq, void *dev_instance)
 	return IRQ_HANDLED;
 }
 
-static int airoha_qdma_init_irq_banks(struct platform_device *pdev,
-				      struct airoha_qdma *qdma)
+static int airoha_qdma_modern_init_irqs(struct platform_device *pdev,
+					struct airoha_qdma *qdma)
 {
 	struct airoha_eth *eth = qdma->eth;
 	int i, id = qdma - &eth->qdma[0];
@@ -3382,67 +3378,108 @@ static int airoha_qdma_init_irq_banks(struct platform_device *pdev,
 	return 0;
 }
 
-int airoha_qdma_init(struct platform_device *pdev,
-		     struct airoha_eth *eth, struct airoha_qdma *qdma)
+static int airoha_qdma_prepare(struct platform_device *pdev,
+			       struct airoha_eth *eth,
+			       struct airoha_qdma *qdma, int id)
 {
-	int err, id = qdma - &eth->qdma[0];
