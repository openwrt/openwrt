/dts-v1/;

#include "en751221.dtsi"

/ {
	model = "Nokia G-240G-E";
	compatible = "nokia,g240g-e", "econet,en751221";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;
	};

	chosen {
		rootdisk = <&firmware>;
		bootargs = "console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait";
		linux,usable-memory-range = <0x00020000 0x0ffe0000>;
	};

	aliases {
		led-boot = &power_green;
		led-failsafe = &power_red;
		led-upgrade = &power_red;
		led-running = &power_green;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		wps5 {
			label = "led";
			linux,code = <BTN_0>;
			gpios = <&pinctrl 5 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		/* Power Green */
		power_green: led@6 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <6>;
			gpios = <&pinctrl 6 GPIO_ACTIVE_LOW>;
		};

		/* Power Red */
		power_red: led@9 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <9>;
			gpios = <&pinctrl 9 GPIO_ACTIVE_LOW>;
		};

		/* xPON/Internet */
		pon_led: led@2 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <2>;
			gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
		};

		/* USB */
		led@11 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_USB;
			function-enumerator = <11>;
			gpios = <&pinctrl 11 GPIO_ACTIVE_LOW>;
		};

		/* AUTH */
		pon_los: led@24 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <24>;
			gpios = <&pinctrl 24 GPIO_ACTIVE_LOW>;
		};

		/* FXS1 */
		led@25 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <25>;
			gpios = <&pinctrl 25 GPIO_ACTIVE_LOW>;
		};

		/* FXS2 */
		led@26 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <26>;
			gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
		};

		/* Internet */
		led@28 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <28>;
			gpios = <&pinctrl 28 GPIO_ACTIVE_LOW>;
		};

		/* VoIP */
		led@29 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <29>;
			gpios = <&pinctrl 29 GPIO_ACTIVE_LOW>;
		};
	};
};

&nand {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "u-boot";
			reg = <0x000000 0x100000>;
		};

		partition@100000 {
			label = "ubi";
			compatible = "linux,ubi";
			reg = <0x100000 0x000000>;

			volumes {
				ubi-volume-art {
					volname = "ri";
					read-only;

					nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <1>;
						#size-cells = <1>;

						macaddr_ri_3e: macaddr@3e {
							compatible = "mac-base";
							reg = <0x3e 0x6>;
							#nvmem-cell-cells = <1>;
						};
					};
				};

				ubi-volume-bosa {
					volname = "bosa";
					read-only;

					nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <1>;
						#size-cells = <1>;

						cal_l98: cal@800 {
							reg = <0x0 0x800>;
						};
					};
				};

				firmware: ubi-volume-firmware {
					volname = "fit";
					compatible = "denx,uimage";
				};
			};
		};
	};
};

/*
 * One PEF32002/DXS102 provides both FXS ports.
 * Audio uses PCM1; control transactions are transported over ZSI.
 */
&pcm0 {
	airoha,dma-channel-mask = <0x3>;
	// status = "okay";
};

&zsi0 {
	/*
	 * Replaces the platform-style Zarlink ZSI bus with the ZSI-to-SPI
	 * controller required by drv_tapi_dxs.
	 */
	compatible = "econet,en751221-zsi-spi";
	// status = "okay";

	dxs0: slic@0 {
		compatible = "maxlinear,pef32002";
		reg = <0>;

		spi-max-frequency = <2000000>;
		spi-cpol;
		spi-cpha;

		/*
		 * Start in polling mode. Add interrupts only after confirming
		 * the physical DXS interrupt routing.
		 */
	};
};

&i2c0 {
	status = "okay";

	gn25l98: optical-frontend@51 {
		compatible = "semtech,gn25l98";
		reg = <0x51>;

		nvmem-cells = <&cal_l98>;
		nvmem-cell-names = "calibration";

		#optical-frontend-cells = <0>;
	};
};

&xpon_phy {
	status = "okay";

	/* Needs confirm in hardware, in `led.conf` contains `42  27  1   0   1` */
	vcc-disable-gpios = <&pinctrl 27 GPIO_ACTIVE_HIGH>;

	airoha,rx-sd-inverted;
};

&xpon {
	status = "okay";

	airoha,gpon-serial-from-mac;
	omci-vendor-id = "ALCL";

	optical-frontends = <&gn25l98>;
	optical-frontend-names = "pon";

	leds = <&pon_led>, <&pon_los>, <&pon_los>;
	led-names = "fiber", "los", "pon";
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";

	nvmem-cells = <&macaddr_ri_3e 0>;
	nvmem-cell-names = "mac-address";
};

&gdm2 {
	status = "okay";
	phy-mode = "internal";

	nvmem-cells = <&macaddr_ri_3e 0>;
	nvmem-cell-names = "mac-address";

	airoha,xpon-managed;
	openwrt,netdev-name = "pon0";
};

&switch0 {
	status = "okay";
};

&switch1 {
	status = "okay";
};

&gsw_port0 {
	label = "lan0";
	status = "okay";
};

&gsw_port1 {
	label = "lan1";
	status = "okay";
};

&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

&gsw_phy1 {
	status = "okay";
};

&gsw_phy2 {
	status = "okay";
};

&gsw_phy3 {
	status = "okay";
};

&gsw_phy4 {
	status = "okay";
};
