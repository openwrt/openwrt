/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "en7523.dtsi"

/ {
	model = "Askey RTF8225VW";
	compatible = "askey,rtf8225vw", "airoha,en7523";

	chosen {
		rootdisk = <&firmware>;
		bootargs = "console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait";
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = &uart1;
		led-boot = &led_power;
		led-failsafe = &led_pon;
		led-upgrade = &led_pon;
		led-running = &led_power;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		wps5 {
			label = "wps5";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pinctrl 21 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		wps2 {
			label = "wps2";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		/* 2.4Ghz */
		led@10 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN_2GHZ;
			function-enumerator = <10>;
			gpios = <&pinctrl 10 GPIO_ACTIVE_LOW>;
		};

		/* 5Ghz */
		led@11 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN_5GHZ;
			function-enumerator = <11>;
			gpios = <&pinctrl 11 GPIO_ACTIVE_LOW>;
		};

		/* Power */
		led_power: led@8 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <8>;
			gpios = <&pinctrl 8 GPIO_ACTIVE_LOW>;
		};

		/* xPON */
		led_pon: led@9 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <9>;
			gpios = <&pinctrl 9 GPIO_ACTIVE_LOW>;
		};
	};

	pon0: pon0 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c_sfp>;

		tx-disable-gpios = <&pinctrl 16 GPIO_ACTIVE_HIGH>;
	};
};

/*
Old maping NAND
0x000000000000-0x000000080000 : "bootloader"
0x000000080000-0x0000000c0000 : "romfile"
0x0000000c0000-0x0000028c0000 : "tclinux"
0x0000028c0000-0x0000050c0000 : "tclinux_slave"
0x0000050c0000-0x000005100000 : "bootenv0"
0x000005100000-0x000005140000 : "bootenv1"
0x000005140000-0x000005540000 : "defcfg"
0x000005540000-0x000005940000 : "bakcfg"
0x000005940000-0x000005d40000 : "config"
0x000005d40000-0x000006540000 : "status"
0x000006dc0000-0x000007000000 : "reservearea"
0x000007000000-0x00000ac00000 : "coredump"
0x00000ac00000-0x00000b000000 : "persistentscript"
0x00000b000000-0x00000e000000 : "unused"

New Maping:
	0x00000000-0x00100000 : BL1 + FIP (BL2 + BL31 + BL33)
	0x00100000-           : UBI (uboot env{1,2} + ART (misc part) + fit (firmware))
*/
&spi0 {
	flash@0 {
		reg = <0>;
		compatible = "spi-nand";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x100000>;
				read-only;
			};

			partition@100000 {
				label = "ubi";
				compatible = "linux,ubi";
				reg = <0x100000 0x000000>;

				volumes {
					ubi-volume-ubootenv {
						volname = "ubootenv";
						nvmem-layout {
							compatible = "u-boot,env-redundant-bool";
						};
					};

					ubi-volume-ubootenv2 {
						volname = "ubootenv2";
						nvmem-layout {
							compatible = "u-boot,env-redundant-bool";

							macaddr: ethaddr {
								#nvmem-cell-cells = <1>;
							};

							gponsn: asp_gpon_sn {
								#nvmem-cell-cells = <1>;
							};
						};
					};

					ubi-volume-art {
						volname = "art";
						read-only;

						nvmem-layout {
							compatible = "fixed-layout";
							#address-cells = <1>;
							#size-cells = <1>;

							mt76_eeprom_2g: eeprom@0 {
								reg = <0x000000 0x020000>;
							};

							mt76_eeprom_5g: eeprom@20000 {
								reg = <0x020000 0x020000>;
							};

							mt76_precal_5g: precal@20e10 {
								reg = <0x020e10 0x019c10>;
							};

							en7571_bob: en7571_bob@1c0400 {
								reg = <0x1c0400 0xff>;
							};
						};
					};

					firmware: ubi-volume-firmware {
						volname = "fit";
						compatible = "denx,uimage";
					};
				};
			};
		};
	};
};

&pcie0 {
	status = "okay";

	pcie@0,0 {
		reg = <0x00000000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;

		mt7915@0,0 {
			reg = <0x0000 0 0 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			nvmem-cells = <&mt76_eeprom_2g>;
			nvmem-cell-names = "eeprom";
			airoha,npu = <&npu>;
			airoha,eth = <&eth>;

			/* 2.4Ghz */
			band@0 {
				reg = <0>;
				nvmem-cells = <&macaddr 0>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};

&pcie1 {
	status = "okay";

	pcie@1,0 {
		reg = <0x00000800 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;

		/* 5Ghz */
		mt7915@0,0 {
			reg = <0x0000 0 0 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			nvmem-cells = <&mt76_eeprom_5g>, <&mt76_precal_5g>;
			nvmem-cell-names = "eeprom", "precal";
			airoha,npu = <&npu>;
			airoha,eth = <&eth>;

			band@0 {
				reg = <0>;
				nvmem-cells = <&macaddr 2>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};

&eth {
	status = "okay";
};

&i2c0 {
	status = "okay";

	en7571: lddla@70 {
		compatible = "airoha,en7571";
		reg = <0x70>;

		nvmem-cells = <&en7571_bob>;
		nvmem-cell-names = "calibration";

		i2c_sfp: i2c-sfp {
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};

&xpon_phy {
	status = "okay";
};

&xpon {
	status = "okay";
	gpon-serial-number = <&gponsn>;

	sfp = <&pon0>;
};

&gdm2 {
	status = "okay";
	phy-mode = "internal";

	nvmem-cells = <&macaddr 0>;
	nvmem-cell-names = "mac-address";

	/delete-property/ pcs-handle;
	/delete-property/ phy-handle;
	/delete-property/ managed;

	airoha,xpon-managed;
	openwrt,netdev-name = "pon0";
};

&gdm1 {
	status = "okay";
	nvmem-cells = <&macaddr 0>;
	nvmem-cell-names = "mac-address";
};

&switch {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;

	status = "okay";
};

&gsw_port1 {
	label = "lan1";
	status = "okay";
};

&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

&gsw_port6 {
	nvmem-cells = <&macaddr 0>;
	nvmem-cell-names = "mac-address";
};

/* Leds act is inverted */
&swp1_led1 {
	mux {
		pins = "gpio4";
	};
};
&swp2_led1 {
	mux {
		pins = "gpio5";
	};
};
&swp3_led1 {
	mux {
		pins = "gpio6";
	};
};
&swp4_led1 {
	mux {
		pins = "gpio7";
	};
};

&gsw_phy1 {
	status = "okay";

	pinctrl-0 = <&swp1_led0 &swp1_led1>;
};

&gsw_phy2 {
	status = "okay";

	pinctrl-0 = <&swp2_led0 &swp2_led1>;
};

&gsw_phy3 {
	status = "okay";

	pinctrl-0 = <&swp3_led0 &swp3_led1>;
};

&gsw_phy4 {
	status = "okay";

	pinctrl-0 = <&swp4_led0 &swp4_led1>;
};

&gsw_phy1_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy1_led1 {
	status = "okay";
	color = <LED_COLOR_ID_YELLOW>;
};

&gsw_phy2_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy2_led1 {
	status = "okay";
	color = <LED_COLOR_ID_YELLOW>;
};

&gsw_phy3_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy3_led1 {
	status = "okay";
	color = <LED_COLOR_ID_YELLOW>;
};

&gsw_phy4_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy4_led1 {
	status = "okay";
	color = <LED_COLOR_ID_YELLOW>;
};
