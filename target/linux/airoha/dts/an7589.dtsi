#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/en7523-clk.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/reset/airoha,en7581-reset.h>
#include <dt-bindings/reset/airoha,an7583-reset.h>
#include <dt-bindings/reset/airoha,an7589-reset.h>
#include <dt-bindings/phy/airoha,an7581-usb-phy.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		atf@80000000 {
			no-map;
			reg = <0x0 0x80000000 0x0 0x200000>;
		};

		npu_binary: npu-binary@84000000 {
			no-map;
			reg = <0x0 0x84000000 0x0 0xa00000>;
		};
		/*
		ai_npu_freeRTOS: ai-npu-freeRTOS@84a00000{
			no-map;
			reg = <0x0 0x84a00000 0x0 0x800000>;
		};
		ai_npu_input: ai-npu-input@85a00000 {
			no-map;
			reg = <0x0 0x85a00000 0x0 0x20000>;
		};

		ai_npu_model: ai-npu-model@86000000 {
			no-map;
			reg = <0x0 0x86000000 0x0 0x100000>;
		};

		ai_npu_mbox: ai-npu-mbox@86100000 {
			no-map;
			reg = <0x0 0x86100000 0x0 0x10000>;
		};
		*/
		dq0_buf: dq0-buf@87000000 {
			no-map;
			reg = <0x0 0x87000000 0x0 0x2000000>;
		};

		dq1_buf: dq1-buf@89000000 {
			no-map;
			reg = <0x0 0x89000000 0x0 0x1000000>;
		};

		npu_pkt: npu-pkt@8a000000 {
			no-map;
			reg = <0x0 0x8a000000 0x0 0x2c00000>;
		};

		npu_txpkt: npu-txpkt@8cc00000 {
			no-map;
			reg = <0x0 0x8cc00000 0x0 0x8900000>;
		};

		npu_txbufid: npu-txbufid@95500000  {
			no-map;
			reg = <0x0 0x95500000 0x0 0x6800>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};

				core2 {
					cpu = <&cpu2>;
				};

				core3 {
					cpu = <&cpu3>;
				};
			};
		};

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x0>;
			operating-points-v2 = <&cpu_opp_table>;
			enable-method = "psci";
			clocks = <&cpufreq>;
			clock-names = "cpu";
			power-domains = <&cpufreq>;
			power-domain-names = "perf";
			next-level-cache = <&l2>;
			#cooling-cells = <2>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x1>;
			operating-points-v2 = <&cpu_opp_table>;
			enable-method = "psci";
			clocks = <&cpufreq>;
			clock-names = "cpu";
			power-domains = <&cpufreq>;
			power-domain-names = "perf";
			next-level-cache = <&l2>;
			#cooling-cells = <2>;
		};

		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x2>;
			operating-points-v2 = <&cpu_opp_table>;
			enable-method = "psci";
			clocks = <&cpufreq>;
			clock-names = "cpu";
			power-domains = <&cpufreq>;
			power-domain-names = "perf";
			next-level-cache = <&l2>;
			#cooling-cells = <2>;
		};

		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x3>;
			operating-points-v2 = <&cpu_opp_table>;
			enable-method = "psci";
			clocks = <&cpufreq>;
			clock-names = "cpu";
			power-domains = <&cpufreq>;
			power-domain-names = "perf";
			next-level-cache = <&l2>;
			#cooling-cells = <2>;
		};

		l2: l2-cache {
			compatible = "cache";
			cache-size = <0x80000>;
			cache-line-size = <64>;
			cache-level = <2>;
			cache-unified;
		};
	};

	cpufreq: cpufreq {
		compatible = "airoha,en7581-cpufreq";

		operating-points-v2 = <&cpu_smcc_opp_table>;

		#power-domain-cells = <0>;
		#clock-cells = <0>;
	};

	cpu_opp_table: opp-table {
		compatible = "operating-points-v2";
		opp-shared;

		opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			required-opps = <&smcc_opp0>;
		};

		opp-550000000 {
			opp-hz = /bits/ 64 <550000000>;
			required-opps = <&smcc_opp1>;
		};

		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			required-opps = <&smcc_opp2>;
		};

		opp-650000000 {
			opp-hz = /bits/ 64 <650000000>;
			required-opps = <&smcc_opp3>;
		};

		opp-7000000000 {
			opp-hz = /bits/ 64 <700000000>;
			required-opps = <&smcc_opp4>;
		};

		opp-7500000000 {
			opp-hz = /bits/ 64 <750000000>;
			required-opps = <&smcc_opp5>;
		};

		opp-8000000000 {
			opp-hz = /bits/ 64 <800000000>;
			required-opps = <&smcc_opp6>;
		};

		opp-8500000000 {
			opp-hz = /bits/ 64 <850000000>;
			required-opps = <&smcc_opp7>;
		};

		opp-9000000000 {
			opp-hz = /bits/ 64 <900000000>;
			required-opps = <&smcc_opp8>;
		};

		opp-9500000000 {
			opp-hz = /bits/ 64 <950000000>;
			required-opps = <&smcc_opp9>;
		};

		opp-10000000000 {
			opp-hz = /bits/ 64 <1000000000>;
			required-opps = <&smcc_opp10>;
		};

		opp-10500000000 {
			opp-hz = /bits/ 64 <1050000000>;
			required-opps = <&smcc_opp11>;
		};

		opp-11000000000 {
			opp-hz = /bits/ 64 <1100000000>;
			required-opps = <&smcc_opp12>;
		};

		opp-11500000000 {
			opp-hz = /bits/ 64 <1150000000>;
			required-opps = <&smcc_opp13>;
		};

		opp-12000000000 {
			opp-hz = /bits/ 64 <1200000000>;
			required-opps = <&smcc_opp14>;
		};
	};

	cpu_smcc_opp_table: opp-table-cpu-smcc {
		compatible = "operating-points-v2";

		smcc_opp0: opp0 {
			opp-level = <0>;
		};

		smcc_opp1: opp1 {
			opp-level = <1>;
		};

		smcc_opp2: opp2 {
			opp-level = <2>;
		};

		smcc_opp3: opp3 {
			opp-level = <3>;
		};

		smcc_opp4: opp4 {
			opp-level = <4>;
		};

		smcc_opp5: opp5 {
			opp-level = <5>;
		};

		smcc_opp6: opp6 {
			opp-level = <6>;
		};

		smcc_opp7: opp7 {
			opp-level = <7>;
		};

		smcc_opp8: opp8 {
			opp-level = <8>;
		};

		smcc_opp9: opp9 {
			opp-level = <9>;
		};

		smcc_opp10: opp10 {
			opp-level = <10>;
		};

		smcc_opp11: opp11 {
			opp-level = <11>;
		};

		smcc_opp12: opp12 {
			opp-level = <12>;
		};

		smcc_opp13: opp13 {
			opp-level = <13>;
		};

		smcc_opp14: opp14 {
			opp-level = <14>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
	};

	thermal-zones {
		cpu_thermal: cpu-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <5000>;

			thermal-sensors = <&thermal 0>;

			trips {
				cpu_hot: cpu-hot {
					temperature = <95000>;
					hysteresis = <1000>;
					type = "hot";
				};

				cpu-critical {
					temperature = <120000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
#if 0
			cooling-maps {
				map0 {
					trip = <&cpu_hot>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
#endif
		};
	};

	clk25m: oscillator {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <25000000>;
		clock-output-names = "clkxtal";
	};

	sys_hclk: clk-oscillator-100mhz {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
		clock-output-names = "sys_hclk";
	};

	vmmc_3v3: regulator-vmmc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vmmc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	sfp1: sfp1 {
		compatible = "sff,sfp";
	};

	efuse-banks {
		compatible = "airoha,an7581-efuses";
		#address-cells = <1>;
		#size-cells = <0>;

		bank@0 {
			reg = <0>;
		};

		bank@1 {
			reg = <1>;
		};
	};

	gdump@1fbf9000 {
		compatible = "airoha,airoha-gdump";
		reg = <0x0 0x1fbf9000 0x0 0x84>;
	};

	sram@1fa40000 {
		compatible = "airoha,airoha-sram";
		reg = <0x0 0x1fa40000 0x0 0x10000>,		//GDMP SRAM
			  <0x0 0x1f400000 0x0 0x10000>;		//GDMP SRAM2 (for 7589)
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		gic: interrupt-controller@0c000000{
			compatible = "arm,gic-v3";
			interrupt-controller;
			#interrupt-cells = <3>;
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x0 0x0c000000 0x0 0x40000>,
				  <0x0 0x0c080000 0x0 0x200000>,
				  <0x0 0x0c400000 0x0 0x2000>,
				  <0x0 0x0c410000 0x0 0x1000>,
				  <0x0 0x0c420000 0x0 0x1000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_LOW>;
		};

		uart1: serial@1fbf0000 {
			compatible = "ns16550";
			reg = <0x0 0x1fbf0000 0x0 0x30>;
			reg-io-width = <4>;
			reg-shift = <2>;
			interrupts = <GIC_SPI 74 IRQ_TYPE_LEVEL_HIGH>;
			clock-frequency = <1843200>;
		};

		watchdog@1fbf0100 {
			compatible = "airoha,en7581-wdt";
			reg = <0x0 0x1fbf0100 0x0 0x38>;

			clocks = <&sys_hclk>;
			clock-names = "bus";
		};

		uart2: serial@1fbf0300 {
			compatible = "ns16550";
			reg = <0x0 0x1fbf0300 0x0 0x30>;
			reg-io-width = <4>;
			reg-shift = <2>;
			interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>;
			clock-frequency = <1843200>;

			status = "disabled";
		};

		uart3: serial@1fbf0600 {
			compatible = "ns16550";
			reg = <0x0 0x1fbf0600 0x0 0x30>;
			reg-io-width = <4>;
			reg-shift = <2>;
			interrupts = <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH>;
			clock-frequency = <1843200>;

			status = "disabled";
		};

		afe: afe@1fbe2200 {
			compatible = "airoha,an7581-afe";
			reg = <0x0 0x1fbe2200 0x0 0xfc>,
				<0x0 0x1fbe2f00 0x0 0x14>;
			interrupts = <GIC_SPI 104 IRQ_TYPE_LEVEL_HIGH>;

			resets = <&scuclk AN7589_I2S_RST>;

			status = "disabled";
		};

		uart4: serial@1ec10000 {
			compatible = "ns16550";
			reg = <0x0 0x1ec10000 0x0 0x30>;
			reg-io-width = <4>;
			reg-shift = <2>;
			interrupts = <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH>;
			clock-frequency = <1843200>;

			status = "disabled";
		};

		uart5: serial@1fbe1000 {
			compatible = "airoha,arht-hsuart";
			reg = <0x0 0x1fbe1000 0x0 0x80>;
			reg-io-width = <4>;
			reg-shift = <2>;
			interrupts = <GIC_SPI 117 IRQ_TYPE_LEVEL_HIGH>;
			clock-frequency = <14745600>;
			port-index = <0>;

			status = "disabled";
		};

		uart6: serial@1fbf5000 {
			compatible = "airoha,arht-hsuart";
			reg = <0x0 0x1fbf5000 0x0 0x80>;
			reg-io-width = <4>;
			reg-shift = <2>;
			interrupts = <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>;
			clock-frequency = <14745600>;
			port-index = <1>;

			status = "disabled";
		};

		eth00_pcs: pcs@1fdb0000 {
			compatible = "airoha,an7589-pcs-eth00";
			reg = <0x0 0x1fdb0000 0x0 0x64>,
				  <0x0 0x1fdb1000 0x0 0x64>,
				  <0x0 0x1fdb2000 0x0 0x64>,
				  <0x0 0x1fdb3000 0x0 0x64>,
			      <0x0 0x1fdb0a00 0x0 0x1b0>,
			      <0x0 0x1fdb8000 0x0 0x58c>,
			      <0x0 0x1fdb0c00 0x0 0x3a8>,
			      <0x0 0x1fdb9000 0x0 0x748>,
				  <0x0 0x1fdb1c00 0x0 0x400>,
				  <0x0 0x1fdb2c00 0x0 0x400>,
				  <0x0 0x1fdbc000 0x0 0x250>,
				  <0x0 0x1fda0000 0x0 0x9000>;
			reg-names = "hsgmii_an", "hsgmii_an_p1", "hsgmii_an_p2",
					"hsgmii_an_p3","hsgmii_pcs", "multi_sgmii", "usxgmii",
					"hsgmii_rate_adp", "usxgmii_m_1", "usxgmii_m_2", "qsgmii", "pma";

			// resets = <&scuclk AN7583_XSI_MAC_RST>,
			//	 <&scuclk AN7583_XSI_PHY_RST>;
			// reset-names = "mac", "phy";

			airoha,scu = <&scuclk>;
		};

		eth01_pcs: pcs@1fdd0000 {
			compatible = "airoha,an7589-pcs-eth01";
			reg = <0x0 0x1fdd0000 0x0 0x64>,
				  <0x0 0x1fdd1000 0x0 0x64>,
				  <0x0 0x1fdd2000 0x0 0x64>,
				  <0x0 0x1fdd3000 0x0 0x64>,
			      <0x0 0x1fdd0a00 0x0 0x1b0>,
			      <0x0 0x1fdd8000 0x0 0x58c>,
			      <0x0 0x1fdd0c00 0x0 0x3a8>,
			      <0x0 0x1fdd9000 0x0 0x748>,
				  <0x0 0x1fdd1c00 0x0 0x400>,
				  <0x0 0x1fdd2c00 0x0 0x400>,
				  <0x0 0x1fddc000 0x0 0x250>,
				  <0x0 0x1fdc0000 0x0 0x9000>;
			reg-names = "hsgmii_an", "hsgmii_an_p1","hsgmii_an_p2",
					"hsgmii_an_p3","hsgmii_pcs", "multi_sgmii", "usxgmii",
					"hsgmii_rate_adp", "usxgmii_m_1", "usxgmii_m_2",  "qsgmii", "pma";

			// resets = <&scuclk AN7583_XSI_MAC_RST>,
			//	 <&scuclk AN7583_XSI_PHY_RST>;
			// reset-names = "mac", "phy";

			airoha,scu = <&scuclk>;
		};

		eth02_pcs: pcs@1fdf0000 {
			compatible = "airoha,an7589-pcs-eth02";
			reg = <0x0 0x1fdf0000 0x0 0x414>,
				  <0x0 0x1fdf1000 0x0 0x404>,
				  <0x0 0x1fdf2000 0x0 0x764>,
				  <0x0 0x1fdf3000 0x0 0x23c>,
				  <0x0 0x1fdf4000 0x0 0xc0c>,
				  <0x0 0x1fdf5000 0x0 0x424>,
				  <0x0 0x1fdf6000 0x0 0x90c>,
				  <0x0 0x1fdf7000 0x0 0xc20>,
				  <0x0 0x1fdf8000 0x0 0x314>,
				  <0x0 0x1fdf9000 0x0 0xd8>,
				  <0x0 0x1fde0000 0x0 0x9000>;
			reg-names = "ethl_0", "ethl_1", "ethl_misc",
				    "ethl_com", "ethl_txm", "ethl_rxm", "ethl_txl",
				    "ethl_rxl", "ethl_fifo", "ethl_ra", "pma";

			// resets = <&scuclk AN7583_XSI_MAC_RST>,
			//	 <&scuclk AN7583_XSI_PHY_RST>;
			// reset-names = "mac", "phy";

			airoha,scu = <&scuclk>;
		};

		eth03_pcs: pcs@1fe40000 {
			compatible = "airoha,an7589-pcs-eth03";
			reg = <0x0 0x1fe40000 0x0 0x414>,
				  <0x0 0x1fe41000 0x0 0x404>,
				  <0x0 0x1fe42000 0x0 0x764>,
				  <0x0 0x1fe43000 0x0 0x23c>,
				  <0x0 0x1fe44000 0x0 0xc0c>,
				  <0x0 0x1fe45000 0x0 0x424>,
				  <0x0 0x1fe46000 0x0 0x90c>,
				  <0x0 0x1fe47000 0x0 0xc20>,
				  <0x0 0x1fe48000 0x0 0x314>,
				  <0x0 0x1fe49000 0x0 0xd8>,
				  <0x0 0x1fe30000 0x0 0xf000>;
			reg-names = "ethl_0", "ethl_1", "ethl_misc",
				    "ethl_com", "ethl_txm", "ethl_rxm", "ethl_txl",
				    "ethl_rxl", "ethl_fifo", "ethl_ra", "pma";

			// resets = <&scuclk AN7583_XSI_MAC_RST>,
			// 	 <&scuclk AN7583_XSI_PHY_RST>;
			// reset-names = "mac", "phy";

			airoha,scu = <&scuclk>;
		};

		eth04_pcs: pcs@1fe50000 {
			compatible = "airoha,an7589-pcs-eth04";
			reg = <0x0 0x1fe50000 0x0 0x414>,
				  <0x0 0x1fe51000 0x0 0x404>,
				  <0x0 0x1fe52000 0x0 0x764>,
				  <0x0 0x1fe53000 0x0 0x23c>,
				  <0x0 0x1fe54000 0x0 0xc0c>,
				  <0x0 0x1fe55000 0x0 0x424>,
				  <0x0 0x1fe56000 0x0 0x90c>,
				  <0x0 0x1fe57000 0x0 0xc20>,
				  <0x0 0x1fe58000 0x0 0x314>,
				  <0x0 0x1fe59000 0x0 0xd8>,
				  <0x0 0x1feb0000 0x0 0xf000>;
			reg-names = "ethl_0", "ethl_1", "ethl_misc",
				    "ethl_com", "ethl_txm", "ethl_rxm", "ethl_txl",
				    "ethl_rxl", "ethl_fifo", "ethl_ra", "pma";

			resets = <&scuclk AN7583_XSI_MAC_RST>,
				 <&scuclk AN7583_XSI_PHY_RST>;
			reset-names = "mac", "phy";

			airoha,scu = <&scuclk>;
		};

		chip_scu: syscon@1fa20000 {
			compatible = "airoha,an7589-chip-scu", "simple-mfd", "syscon";
			reg = <0x0 0x1fa20000 0x0 0x410>;
			interrupts = <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
			thermal: thermal-sensor {
				compatible = "airoha,an7589-thermal";
				#thermal-sensor-cells = <0>;
			};
		};

		pbus_csr: syscon@1fbe3400 {
			compatible = "airoha,en7581-pbus-csr", "syscon";
			reg = <0x0 0x1fbe3400 0x0 0xff>;
		};

		scuclk: clock-controller@1fa00000 {
			compatible = "airoha,an7589-scu", "syscon";
			reg = <0x0 0x1fb00000 0x0 0x9fc>;

			#address-cells = <1>;
			#size-cells = <0>;

			#clock-cells = <1>;
			#reset-cells = <1>;

			airoha,chip-scu = <&chip_scu>;

			mdio_0: mdio-bus@c8 {
				compatible = "airoha,an7583-mdio";
				reg = <0xc8>;

				clocks = <&scuclk AN7583_CLK_MDIO0>;
				resets = <&scuclk AN7589_MDIO0>;
			};

			mdio_1: mdio-bus@cc {
				compatible = "airoha,an7583-mdio";
				reg = <0xcc>;

				clocks = <&scuclk AN7583_CLK_MDIO1>;
				resets = <&scuclk AN7589_MDIO1>;
			};

			mdio_2: mdio-bus@d8 {
				compatible = "airoha,an7583-mdio";
				reg = <0xd8>;

				clocks = <&scuclk AN7589_CLK_MDIO2>;
				resets = <&scuclk AN7589_MDIO2>;
			};

			scu_ssr: system-controller {
				compatible = "airoha,an7581-scu-ssr";
			};
		};
		rng@1faa1000 {
			compatible = "airoha,en7581-trng";
			reg = <0x0 0x1faa1000 0x0 0xc04>;
			interrupts = <GIC_SPI 91 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		trng_v3: trng_v3@1faa2000 {
			compatible = "airoha,arht-an7589-trng-v3";
			reg = <0x0 0x1faa2000 0x0 0x300>;
			interrupts = <GIC_SPI 203 IRQ_TYPE_LEVEL_HIGH>;
			status = "okay";
		};

		usb1: usb1@1fab0000 {
			compatible = "mediatek,mtk-xhci";
			reg = <0x0 0x1fab0000 0x0 0x3e00>,
				<0x0 0x1fab3e00 0x0 0x100>;
			reg-names = "mac", "ippc";
			interrupts = <GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&usb1_u2 PHY_TYPE_USB2>, <&usb1_u3 PHY_TYPE_USB3>;
			status = "disabled";
		};

		usb0: usb0@1fad0000 {
			compatible = "mediatek,mtk-xhci";
			reg = <0x0 0x1fad0000 0x0 0x3e00>,
				<0x0 0x1fad3e00 0x0 0x100>;
			reg-names = "mac", "ippc";
			interrupts = <GIC_SPI 206 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&usb0_u2 PHY_TYPE_USB2>, <&usb0_u3 PHY_TYPE_USB3>;
			status = "disabled";
		};

		usb0_phy: usb0_phy@1fae0000 {
			compatible = "airoha,an7589-usb-phy";
			reg = <0x0 0x1fae0000 0x0 0x11ff>,
			      <0x0 0x1fedf000 0x0 0xff>,
			      <0x0 0x1fed0000 0x0 0x8ff>,
			      <0x0 0x1feda000 0x0 0x3ff>,
			      <0x0 0x1fbe2100 0x0 0xff>;
			reg-names = "phy", "ana", "pma", "dig", "csr";


			airoha,port-id = <0>;
			airoha,scu-ssr = <&scu_ssr>;

			usb0_u2: usb2-phy {
				reg = <0x0>;
				airoha,usb2-monitor-clk-sel = <AIROHA_USB2_MONCLK_SEL1>;

				#phy-cells = <1>;
			};

			usb0_u3: usb3-phy {
				airoha,scu = <&scuclk>;

				#phy-cells = <1>;
			};
		};

		usb1_phy: usb1_phy@1fac0000 {
			compatible = "airoha,an7589-usb-phy";
			reg = <0x0 0x1fac0000 0x0 0x11ff>,
			      <0x0 0x1fe7f000 0x0 0xff>,
			      <0x0 0x1fe70000 0x0 0x8ff>,
			      <0x0 0x1fe7a000 0x0 0x3ff>,
			      <0x0 0x1fbe2000 0x0 0xff>;
			reg-names = "phy", "ana", "pma", "dig", "csr";


			airoha,port-id = <1>;
			airoha,scu-ssr = <&scu_ssr>;

			usb1_u2: usb2-phy {
				reg = <0x0>;
				airoha,usb2-monitor-clk-sel = <AIROHA_USB2_MONCLK_SEL2>;

				#phy-cells = <1>;
			};

			usb1_u3: usb3-phy {
				airoha,scu = <&scuclk>;

				#phy-cells = <1>;
			};
		};

		gpon_phy: gpon-phy {
			compatible = "airoha,an7589-pon-phy";
			airoha,usb-phy = <&usb1_phy>;
			status = "disabled";
		};

		crypto-safexcel@1f800000 {
			compatible = "inside-secure,safexcel-eip197b",
					"security-ip-197_srv";
			reg = <0x0 0x1f800000 0x0 0x200000>,
				<0x0 0x1f630000 0x0 0x8000>;
			interrupts = <GIC_SPI 135 IRQ_TYPE_LEVEL_HIGH>, //63+72
					<GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>, //3+72
					<GIC_SPI 209 IRQ_TYPE_LEVEL_HIGH>, //137+72
					<GIC_SPI 267 IRQ_TYPE_LEVEL_HIGH>, //195+72
					<GIC_SPI 274 IRQ_TYPE_LEVEL_HIGH>; //202+72
			interrupt-names = "global","ring0","ring1","ring2","ring3";
			status = "okay";
		};

		system-controller@1fbf0200 {
			compatible = "syscon", "simple-mfd";
			reg = <0x0 0x1fbf0200 0x0 0x100>;
#if 0
			en7581_pinctrl: pinctrl {
				compatible = "airoha,en7581-pinctrl";

				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;

				gpio-controller;
				#gpio-cells = <2>;

				interrupt-controller;
				#interrupt-cells = <2>;
			};
#endif
			an7589_pwm: pwm {
				compatible = "airoha,an7589-pwm";

				#pwm-cells = <3>;
			};
		};


		/*
		 * GPIO and Pinctrl Controller
		 *
		 * AN7589 uses two separate register regions:
		 * 1. GPIO control base @ 0x1FBF2000 - DIR, DOUT, DIN, INT, PULL, DRV
		 *    (Source: AN7589_GPIO_CODA_GPIO_internal.docx)
		 * 2. IOMUX base @ 0x1FA30000 - MODE registers for pin multiplexing
		 *    (Source: acd2coda_default_gpio_reg_internal.docx)
		 */
		an7589_pinctrl: pinctrl@1fbf2000 {
			compatible = "airoha,an7589-pinctrl";

			/* Two register regions */
			reg = <0x0 0x1fbf0200 0x0 0x100>,  /* GPIO control base */
			      <0x0 0x1fa30000 0x0 0x34>;  /* IOMUX base */
			reg-names = "base", "iomux";

			gpio-controller;
			#gpio-cells = <2>;

			interrupt-controller;
			#interrupt-cells = <2>;
			interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;

			i2c0_pins: i2c0-pins {
				mux {
					function = "i2c0";
					groups = "i2c0_grp";
				};
			};

			i2c3_pins: i2c3-pins {
				mux {
					function = "i2c3";
					groups = "i2c3_grp";
				};
			};

			mmc_pins: mmc-pins {
				mux {
					function = "emmc";
					groups = "emmc_grp";
				};
			};

			uart2_pins: uart2-pins {
				mux {
					function = "uart2";
					groups = "uart2_grp";
				};
			};

			uart3_pins: uart3-pins {
				mux {
					function = "uart3";
					groups = "uart3_grp";
				};
			};

			uart4_pins: uart4-pins {
				mux {
					function = "uart4";
					groups = "uart4_grp";
				};
			};

			uart5_pins: uart5-pins {
				mux {
					function = "uart5";
					groups = "uart5_grp";
				};
			};

			uart6_pins: uart6-pins {
				mux {
					function = "uart6";
					groups = "uart6_grp";
				};
			};

			i2s_pins: i2s-pins {
				mux {
					function = "i2s";
					groups = "i2s_grp";
				};
			};

			pcm1_pins: pcm1-pins {
				mux {
					function = "pcm1";
					groups = "pcm1_grp";
				};
			};

			pon1_default_pins: pon1_default_pins {
				mux {
					function = "pon1";
					groups = "pon1_default_grp";
				};
			};

			pon1_working_pins: pon1_working_pins {
				mux {
					function = "pon1";
					groups = "pon1_working_grp";
				};
			};

			pon1_reset_pins: pon1_reset_pins {
				mux {
					function = "pon1";
					groups = "pon1_reset_grp";
				};
			};

			pon2_default_pins: pon2_default_pins {
				mux {
					function = "pon2";
					groups = "pon2_default_grp";
				};
			};

			pon2_working_pins: pon2_working_pins {
				mux {
					function = "pon2";
					groups = "pon2_working_grp";
				};
			};

			pon2_reset_pins: pon2_reset_pins {
				mux {
					function = "pon2";
					groups = "pon2_reset_grp";
				};
			};

			ext_spi2_full_pins: ext-spi2-full-pins {
				mux {
					function = "ext_spi2";
					groups = "ext_spi2_full_grp";
				};
			};
		};

#if 0
		spi_ctrl: spi_controller@1fa10000 {
			compatible = "econet,ecnt-spi_ctrl";
			reg = <0x0 0x1fa10000 0x0 0x140>,		//SPI Controller Base
				  <0x0 0x00000000 0x0 0x1000>;		//SPI Controller auto read interrupt test
			interrupts = <GIC_SPI 51 IRQ_TYPE_LEVEL_HIGH>;
		};

		spi_spi2nfi: spi_spi2nfi@1fa11000 {
