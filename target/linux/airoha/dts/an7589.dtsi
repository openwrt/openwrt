		i2cclock: i2cclock@0 {
			#clock-cells = <0>;
			compatible = "fixed-clock";

			/* 160 MHz for FPGA, 200 MHz for ASIC*/
			clock-frequency = <200000000>;
		};

		i2c0: i2c0@1fbf8000 {
			compatible = "airoha,an7589-i2c";
			reg = <0x0 0x1fbf8000 0x0 0x100>;

			clocks = <&i2cclock>;

			/* 100 kHz */
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;

			status = "okay";
		};

		i2c1: i2c1@1fbf8100 {
			compatible = "airoha,an7589-i2c";
			reg = <0x0 0x1fbf8100 0x0 0x100>;

			clocks = <&i2cclock>;

			/* 100 kHz */
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;

			status = "okay";
		};

		i2c2: i2c2@1fbf7d00 {
			compatible = "airoha,an7589-i2c";
			reg = <0x0 0x1fbf7d00 0x0 0x100>;

			clocks = <&i2cclock>;

			/* 100 kHz */
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;

			status = "okay";
		};

		i2c3: i2c3@1fbf7e00 {
			compatible = "airoha,an7589-i2c";
			reg = <0x0 0x1fbf7e00 0x0 0x100>;

			clocks = <&i2cclock>;

			/* 100 kHz */
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;

			status = "okay";
		};

		i2c4: i2c4@1fbf7f00 {
			compatible = "airoha,an7589-i2c";
			reg = <0x0 0x1fbf7f00 0x0 0x100>;

			clocks = <&i2cclock>;

			/* 100 kHz */
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;

			status = "okay";
		};

		snfi: spi@1fa10000 {
			compatible = "airoha,en7581-snand";
			reg = <0x0 0x1fa10000 0x0 0x140>,
			      <0x0 0x1fa11000 0x0 0x600>;

			clocks = <&scuclk EN7523_CLK_SPI>;
			clock-names = "spi";

			#address-cells = <1>;
			#size-cells = <0>;

			status = "disabled";

			spi_nand: nand@0 {
				compatible = "spi-nand";
				reg = <0>;
				spi-max-frequency = <50000000>;
				spi-tx-bus-width = <1>;
				spi-rx-bus-width = <2>;
			};
		};

		/* Non-boot SPI-NOR connected to SPIM2 (GPIO27/28/30-33). */
		spim2: spi@1fb20800 {
			compatible = "mediatek,spi-ipm";
			reg = <0 0x1fb20800 0 0x1000>;
			interrupts = <GIC_SPI 203 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-names = "default";
			pinctrl-0 = <&ext_spi2_full_pins>;
			mediatek,pad-select = <0>;
			clocks = <&scuclk CLK_TOP_CB_M_D2>,
				 <&scuclk CLK_TOP_SPI2_SEL>,
				 <&scuclk CLK_INFRA_104M_SPI2>,
				 <&scuclk CLK_INFRA_66M_SPI2_HCK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk", "hclk";
			/* Select the 200 MHz SPIM2 source; IPM divides it to 50 MHz. */
			assigned-clocks = <&scuclk CLK_INFRA_104M_SPI2>;
			assigned-clock-rates = <200000000>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			spim2_nor: flash@0 {
				compatible = "jedec,spi-nor";
				reg = <0>;
				spi-max-frequency = <50000000>;
				/* AN7589 IPM input sampling delay for the external NOR. */
				mediatek,tick-delay = <3>;
				/* Validate Dual I/O at the established 50 MHz clock rate. */
				spi-tx-bus-width = <2>;
				spi-rx-bus-width = <2>;

				/*
				 * TODO: Quad I/O requires board support for NOR IO2/IO3.
				 * Do not enable it on the current hardware.
				 * spi-tx-bus-width = <4>;
				 * spi-rx-bus-width = <4>;
				 */
			};
		};

		mmc0: mmc@1fa0e000 {
			compatible = "mediatek,mt7986-mmc";
			reg = <0x0 0x1fa0e000 0x0 0x1000>,
			      <0x0 0x1fa0c000 0x0 0x60>;
			interrupts = <GIC_SPI 226 IRQ_TYPE_LEVEL_HIGH>;	// 226 = 154 + 72
			clocks = <&scuclk EN7581_CLK_EMMC>, <&clk25m>;
			clock-names = "source", "hclk";
			bus-width = <8>;
			max-frequency = <200000000>;
			vmmc-supply = <&vmmc_3v3>;
			disable-wp;
			cap-mmc-highspeed;
			mmc-hs200-1_8v;
			mmc-hs400-1_8v;
			mmc-hs400-enhanced-strobe;
			hs400-ds-delay = <0x14014>;
			non-removable;
			no-sd;
			no-sdio;

			status = "disabled";
		};

		npu: npu@1e900000 {
			compatible = "airoha,an7589-npu";
			reg = <0x0 0x1e900000 0x0 0x317000>, //NEQ reg 0x1ec1_6800 - 0x1ec1_6FFF
				<0x0 0x1e800000 0x0 0x60000>,
				<0x0 0x70200000 0x0 0x88000>,
				<0x0 0x70300000 0x0 0x48000>;
			reg-names = "npuRegs", "shared_SRAM", "cluster0_SPAD", "cluster1_SPAD";
			interrupts = <GIC_SPI 181 IRQ_TYPE_LEVEL_HIGH>, 	//mbox2host irq
				<GIC_SPI 190 IRQ_TYPE_LEVEL_HIGH>,	//npu timer0 wdog intr
				<GIC_SPI 191 IRQ_TYPE_LEVEL_HIGH>,	//npu timer1 wdog intr
				<GIC_SPI 192 IRQ_TYPE_LEVEL_HIGH>,	//npu timer2 wdog intr
				<GIC_SPI 193 IRQ_TYPE_LEVEL_HIGH>,	//npu timer3 wdog intr
				<GIC_SPI 165 IRQ_TYPE_LEVEL_HIGH>,	//npu timer4 wdog intr
				<GIC_SPI 166 IRQ_TYPE_LEVEL_HIGH>,	//npu timer5 wdog intr
				<GIC_SPI 167 IRQ_TYPE_LEVEL_HIGH>,	//npu timer6 wdog intr
				<GIC_SPI 168 IRQ_TYPE_LEVEL_HIGH>,	//npu timer7 wdog intr
				<GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 175 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 176 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 177 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 178 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 179 IRQ_TYPE_LEVEL_HIGH>;
			memory-region = <&npu_binary>, <&npu_pkt>, <&npu_txpkt>,
					<&npu_txbufid>;
			memory-region-names = "binary", "pkt", "tx-pkt",
					      "tx-bufid";
			status = "disabled";
		};

		maccr: syscon@1fb70000 {
			compatible = "syscon";
			reg = <0 0x1fb70000 0 0x4700>,
			<0 0x1fb80000 0 0x4700>,
			<0 0x1fb90000 0 0x4100>,
			<0 0x1fba0000 0 0x4100>,
			<0 0x1fbb0000 0 0x4100>;
		};

		tod_gen: tod@1fbe2300 {
			compatible = "airoha,an7589-tod";
			reg = <0x0 0x1fbe2300 0x0 0xD0>;
			interrupts = <GIC_SPI 134 IRQ_TYPE_LEVEL_HIGH>; // TOD GEN INT 62+72
		};

		ups: ups@1f600000 {
			compatible = "airoha,an7589-ups";
			reg = <0x0 0x1f600000 0x0 0x10000>,	//DQ
				  <0x0 0x1f610000 0x0 0x4000>,	//PP
				  <0x0 0x1f614000 0x0 0x1000>,	//PDMA0
				  <0x0 0x1f615000 0x0 0x1000>,	//PDMA1
				  <0x0 0x1f616000 0x0 0x200>,	//PM
				  <0x0 0x1f616200 0x0 0x200>,	//TCE
				  <0x0 0x1f620000 0x0 0x20000>,	//TM
				  <0x0 0x1fa2ff38 0x0 0x4>;		//FPGA_STATUS
			reg-names = "dq","pp","pdma0","pdma1","pm","tce","tm","status";
			reset-names = "pdma0";
			interrupts = <GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>, // PDMA0 INT1 21+72
						   <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>, // PDMA0 INT2 39+72
						   <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH>, // PDMA0 INT3 40+72
						   <GIC_SPI 113 IRQ_TYPE_LEVEL_HIGH>, // PDMA0 INT4 41+72
						   <GIC_SPI 301 IRQ_TYPE_LEVEL_HIGH>, // serdes00 ptp INT 229+72
						   <GIC_SPI 306 IRQ_TYPE_LEVEL_HIGH>, // serdes01 ptp INT 234+72
						   <GIC_SPI 311 IRQ_TYPE_LEVEL_HIGH>, // serdes02 ptp INT 239+72
						   <GIC_SPI 293 IRQ_TYPE_LEVEL_HIGH>, // serdes03 ptp INT 221+72
						   <GIC_SPI 282 IRQ_TYPE_LEVEL_HIGH>; // serdes04 ptp INT 210+72
			airoha,maccr = <&maccr>;
			memory-region = <&dq0_buf>, <&dq1_buf>;
			memory-region-names = "dq0_buf", "dq1_buf";

			port0: ethernet@0 {
				compatible = "airoha,eth-mac";
				reg = <0>;
				phy-mode = "internal";
				status = "okay";
				pcs = <&eth00_pcs>;

				fixed-link {
					speed = <10000>;
					full-duplex;
					pause;
				};
			};

			port1: ethernet@1 {
				compatible = "airoha,eth-mac";
				reg = <1>;
				phy-mode = "usxgmii";
				status = "okay";
				pcs = <&eth01_pcs>;


			};

			port2: ethernet@2 {
				compatible = "airoha,eth-mac";
				reg = <2>;
				phy-mode = "usxgmii";
				status = "okay";
				pcs = <&eth02_pcs>;


			};

			port3: ethernet@3 {
				compatible = "airoha,eth-mac";
				reg = <3>;
				phy-mode = "usxgmii";
				status = "okay";
				pcs = <&eth03_pcs>;

			};

			port4: ethernet@4 {
				compatible = "airoha,eth-mac";
				reg = <4>;
				phy-mode = "usxgmii";
				status = "okay";
				pcs = <&eth04_pcs>;


			};

			/* reg is keep with switch@1fb58000 subnode ports.*/
			/* type: 0(unknow), 1(cpu), 2(phy), 3(xsi). */
			eth_ports {
				xsi_port0: port@0 {
					label = "serdes_00";
					reg = <0>;
					type = <3>;
					serdes = <0>;
					index = <0>;
					dma_src_port = <0x0>;
					status = "disabled";
				};
				xsi_port1: port@1 {
					label = "serdes_00";
					reg = <1>;
					type = <3>;
					serdes = <0>;
					index = <0>;
					dma_src_port = <0x1>;
					status = "disabled";
				};
				xsi_port2: port@2 {
					label = "serdes_00";
					reg = <2>;
					type = <3>;
					serdes = <0>;
					index = <0>;
					dma_src_port = <0x2>;
					status = "disabled";
				};
				xsi_port3: port@3 {
					label = "serdes_00";
					reg = <3>;
					type = <3>;
					serdes = <0>;
					index = <0>;
					dma_src_port = <0x3>;
					status = "disabled";
				};
				xsi_port4: port@4 {
					label = "serdes_01";
					reg = <4>;
					type = <3>;
					serdes = <1>;
					index = <0>;
					dma_src_port = <0x4>;
					status = "disabled";
				};
				xsi_port5: port@5 {
					label = "serdes_01";
					reg = <5>;
					type = <3>;
					serdes = <1>;
					index = <0>;
					dma_src_port = <0x5>;
					status = "disabled";
				};
				xsi_port6: port@6 {
					label = "serdes_01";
					reg = <6>;
					type = <3>;
					serdes = <1>;
					index = <0>;
					dma_src_port = <0x6>;
					status = "disabled";
				};
				xsi_port7: port@7 {
					label = "serdes_01";
					reg = <7>;
					type = <3>;
					serdes = <1>;
					index = <0>;
					dma_src_port = <0x7>;
					status = "disabled";
				};
				xsi_port8: port@8 {
					label = "serdes_02";
					reg = <8>;
					type = <3>;
					serdes = <1>;
					index = <0>;
					dma_src_port = <0x8>;
					status = "disabled";
				};
				xsi_port9: port@9 {
					label = "serdes_03";
					reg = <9>;
					type = <3>;
					serdes = <1>;
					index = <0>;
					dma_src_port = <0x9>;
					status = "disabled";
				};
				xsi_port10: port@10 {
					label = "serdes_04";
					reg = <10>;
					type = <3>;
					serdes = <1>;
					index = <0>;
					dma_src_port = <0xa>;
					status = "disabled";
				};

				cpu_port: port@12 {
					reg = <12>;
					type = <1>;
					index = <0>;
					dma_src_port = <0xc>;
				};


			};
		};
		switch: switch@1fb58000 {
			compatible = "airoha,an7589-switch";
			airoha,maccr = <&maccr>;
			resets = <&scuclk EN7581_GSW_RST>;

			interrupt-controller;
			#interrupt-cells = <1>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 265 IRQ_TYPE_LEVEL_HIGH>;

			status = "okay";

			#address-cells = <1>;
			#size-cells = <1>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				an7589_port1: port@0 {
					reg = <0>;
					label = "lan1";
					phy-mode = "10g-qxgmii";
					sfp = <&sfp1>;
					port-handle = <&xsi_port0>;
					managed = "in-band-status";
					status = "disabled";
				};
				an7589_port2: port@1 {
					reg = <1>;
					label = "lan2";
					phy-mode = "10g-qxgmii";
					port-handle = <&xsi_port1>;
					managed = "in-band-status";
					status = "disabled";
				};
				an7589_port3: port@2 {
					reg = <2>;
					label = "lan3";
					phy-mode = "10g-qxgmii";
					port-handle = <&xsi_port2>;
					managed = "in-band-status";
					status = "disabled";
				};
				an7589_port4: port@3 {
					reg = <3>;
					label = "lan4";
					phy-mode = "10g-qxgmii";
					port-handle = <&xsi_port3>;
					managed = "in-band-status";
					status = "disabled";
				};
				an7589_port5: port@4 {
					reg = <4>;
					label = "lan5";
					phy-mode = "usxgmii";
					sfp = <&sfp1>;
					port-handle = <&xsi_port4>;
					managed = "in-band-status";
					status = "disabled";
				};
				an7589_port6: port@5 {
					reg = <5>;
					label = "lan6";
					phy-mode = "10g-qxgmii";
					port-handle = <&xsi_port5>;
					managed = "in-band-status";
					status = "disabled";
				};
				an7589_port7: port@6 {
					reg = <6>;
					label = "lan7";
					phy-mode = "10g-qxgmii";
					port-handle = <&xsi_port6>;
					managed = "in-band-status";
					status = "disabled";
				};
				an7589_port8: port@7 {
					reg = <7>;
					label = "lan8";
					phy-mode = "10g-qxgmii";
					port-handle = <&xsi_port7>;
					managed = "in-band-status";
					status = "disabled";
				};
				an7589_port9: port@8 {
					reg = <8>;
					label = "lan9";
					phy-mode = "usxgmii";
					sfp = <&sfp1>;
					port-handle = <&xsi_port8>;
					managed = "in-band-status";
					status = "disabled";
				};
				an7589_port10: port@9 {
					reg = <9>;
					label = "lan10";
					phy-mode = "usxgmii";
					sfp = <&sfp1>;
					port-handle = <&xsi_port9>;
					managed = "in-band-status";
					status = "disabled";
				};
				an7589_port11: port@10 {
					reg = <10>;
					label = "wan1";
					phy-mode = "usxgmii";
					sfp = <&sfp1>;
					port-handle = <&xsi_port10>;
					managed = "in-band-status";
					status = "disabled";
				};

				port@12 {
					reg = <12>;
					label = "cpu";
					ethernet = <&port0>;
					phy-mode = "internal";

					fixed-link {
						speed = <10000>;
						full-duplex;
						pause;
					};
				};
			};
		};
	};

	ipsec: ipsec@1fbfa000 {
		compatible = "airoha,airoha-ipsec";
		reg = <0x0 0x1fbfa000 0x0 0x268>;
		interrupts = <GIC_SPI 92 IRQ_TYPE_LEVEL_HIGH>; // IPSEC_INTR 20+72
	};

	pcm: pcm@1fbd0000 {
		compatible = "airoha,airoha-pcm";
		reg = <0x0 0x1fbd0000 0x0 0x4fff>;
		interrupts = <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>;
	};

