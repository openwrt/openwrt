/dts-v1/;

#include "en751221.dtsi"

/ {
	model = "Mitrastar GPT-2741GNAC-N1";
	compatible = "mitrastar,gpt-2741gnac-n1", "econet,en751221";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		ppe_foe: ppe-foe@dc00000 {
			reg = <0x0dc00000 0x00180000>;
			no-map;
		};
	};

	chosen {
		stdout-path = "/serial@1fbf0000:115200";
		linux,usable-memory-range = <0x00020000 0x0ffe0000>;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		// wps5 {
		// 	label = "wps5";
		// 	linux,code = <KEY_WPS_BUTTON>;
		// 	gpios = <&pinctrl 21 GPIO_ACTIVE_LOW>;
		// 	debounce-interval = <60>;
		// };

		// wps2 {
		// 	label = "wps2";
		// 	linux,code = <KEY_WPS_BUTTON>;
		// 	gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
		// 	debounce-interval = <60>;
		// };
	};

	pon0: pon0 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c_sfp>;

		tx-disable-gpios = <&pinctrl 16 GPIO_ACTIVE_HIGH>;
	};
};

/*

0x000000000000-0x000000020000 : "bootloader"
0x000000020000-0x000000040000 : "romfile"
0x000001c60c19-0x000001c6804e : "Defcfg_main"
0x000000040000-0x000003220000 : "Tclinux_main"
0x000004e3e16f-0x000004e455a4 : "defcfg"
0x000003220000-0x000006400000 : "tclinux"
0x000007520000-0x0000075a0000 : "reservearea"
0x0000075a0000-0x0000075c0000 : "romd"
0x0000075c0000-0x0000075e0000 : "second_romfile"
0x000006420000-0x000006820000 : "data"
0x000006820000-0x000006a20000 : "bosa_main"
0x000006a20000-0x000006c20000 : "bosa_backup"
0x000006c20000-0x000007520000 : "app"
*/

&nand {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* MAC Address: 0x06D2BB18 */
		partition@0 {
			label = "bootloader";
			reg = <0x000000000000 0x000000020000>;
			read-only;
		};

		partition@400000 {
			label = "rest_of_flash";
			reg = <0x000000020000 0x000000000000>;
		};
	};
};

&eth {
	memory-region = <&ppe_foe>;
	memory-region-names = "ppe-foe";
	status = "okay";
};

&gdm1 {
	status = "okay";
};

&i2c0 {
	status = "okay";

	en7570: lddla@70 {
		compatible = "airoha,en7570";
		reg = <0x70>;

		// nvmem-cells = <&en7570_bob>;
		// nvmem-cell-names = "calibration";

		i2c_sfp: i2c-sfp {
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};

&xpon_phy {
	status = "okay";
};

&xpon {
	status = "okay";

	airoha,gpon-serial-from-mac;
	omci-vendor-id = "MSTC";

	sfp = <&pon0>;
};

&gdm2 {
	status = "okay";
	phy-mode = "internal";

	// nvmem-cells = <&macaddr 0>;
	// nvmem-cell-names = "mac-address";

	/delete-property/ pcs-handle;
	/delete-property/ phy-handle;
	/delete-property/ managed;

	airoha,xpon-managed;
	openwrt,netdev-name = "pon0";
};

&switch {
	status = "okay";
};

&switch0 {
	status = "okay";
};

&gsw_port1 {
	label = "lan1";
	status = "okay";
};

&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

&gsw_phy1 {
	status = "okay";
};

&gsw_phy2 {
	status = "okay";
};

&gsw_phy3 {
	status = "okay";
};

&gsw_phy4 {
	status = "okay";
};