/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/phy/phy.h>
#include "an7581.dtsi"

/ {
	model = "Quantum Fiber Q1000K (UBI)";
	compatible = "quantum,q1000k-ubi", "quantum,q1000k", "airoha,an7581",
		     "airoha,en7581";

	aliases {
		serial0 = &uart1;
		led-boot = &led_status_red;
		led-failsafe = &led_status_blue;
		led-upgrade = &led_status_blue;
		led-running = &led_status_green;
	};

	chosen {
		rootdisk = <&ubi_rootfs>;
		bootargs = "console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait";
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		/* AN7581SIT board with 512 MiB DRAM. */
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		key-restart {
			label = "reset";
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status_green: led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
		};

		led_status_blue: led-1 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
		};

		led_status_red: led-2 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 29 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led_status_white: led-3 {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
		};

		led-4 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 24 GPIO_ACTIVE_LOW>;
		};

		led-5 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			function-enumerator = <1>;
			gpios = <&en7581_pinctrl 22 GPIO_ACTIVE_HIGH>;
		};

		led-6 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 30 GPIO_ACTIVE_HIGH>;
		};

		/* 1 GbE jack; the 10 GbE LEDs are driven by the RTL8261N. */
		led-7 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&en7581_pinctrl 33 GPIO_ACTIVE_LOW>;
		};

		led-8 {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_LAN;
			gpios = <&en7581_pinctrl 43 GPIO_ACTIVE_LOW>;
		};
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};

		conf {
			pins = "gpio2";
			output-high;
		};
	};

	uart2_pins: uart2-pins {
		mux {
			function = "uart";
			groups = "uart2";
		};
	};
};

&snfi {
	status = "okay";
};

&spi_nand {
	#address-cells = <1>;
	#size-cells = <1>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "vendor";
			reg = <0x00000000 0x00600000>;
			read-only;
		};

		partition@600000 {
			label = "chainloader";
			reg = <0x00600000 0x00100000>;
			read-only;
		};

		partition@700000 {
			label = "ubi";
			reg = <0x00700000 0x1b600000>;
			compatible = "linux,ubi";

			volumes {
				ubi-volume-ubootenv {
					volname = "ubootenv";
					nvmem-layout {
						compatible = "u-boot,env-redundant-bool";
					};
				};

				ubi-volume-ubootenv2 {
					volname = "ubootenv2";
					nvmem-layout {
						compatible = "u-boot,env-redundant-bool";
					};
				};

				ubi_rootfs: ubi-volume-fit {
					volname = "fit";
				};
			};
		};

		partition@1bd00000 {
			label = "art";
			reg = <0x1bd00000 0x00300000>;
			read-only;
		};

		partition@1c000000 {
			label = "reserved_bmt";
			reg = <0x1c000000 0x04000000>;
			read-only;
		};
	};
};

&npu {
	status = "okay";
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";
};

/* Optical uplink; enable once the PON data path is supported. */
&pon_pcs {
	status = "disabled";
};

&gdm2 {
	status = "disabled";
};

&eth_pcs {
	status = "okay";
};

&gdm4 {
	/* 10 GbE LAN through the external RTL8261N at MDIO address 8. */
	status = "okay";

	managed = "in-band-status";
	phy-handle = <&phy8>;
	phy-mode = "usxgmii";

	openwrt,netdev-name = "lan2";
};

&switch {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;

	mdio {
		phy8: ethernet-phy@8 {
			compatible = "ethernet-phy-ieee802.3-c45";
			reg = <8>;
			reset-gpios = <&en7581_pinctrl 27 GPIO_ACTIVE_LOW>;
			reset-assert-us = <200000>;
			reset-deassert-us = <200000>;
			tx-polarity = <PHY_POL_INVERT>;
			rx-polarity = <PHY_POL_INVERT>;
		};
	};
};

/* 1 GbE LAN on the internal switch (GDM1 CPU port). */
&gsw_phy1 {
	status = "okay";
	interrupts = <1>;
};

&gsw_port1 {
	status = "okay";
	label = "lan1";
};

&uart2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pins>;
};
