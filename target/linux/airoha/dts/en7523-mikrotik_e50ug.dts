#include "en7523-mikrotik.dtsi"

/ {
	model = "MikroTik E50UG (hEX refresh)";
	compatible = "mikrotik,e50ug", "airoha,en7523";
};

&leds {
	led@12 {
		color = <LED_COLOR_ID_GREEN>;
		function = LED_FUNCTION_STATUS;
		function-enumerator = <12>;
		gpios = <&pinctrl 12 GPIO_ACTIVE_LOW>;
	};
};

&pon_pcs {
	status = "okay";
};

&gdm2 {
	status = "okay";

	nvmem-cells = <&macaddr_hard 0>;
	nvmem-cell-names = "mac-address";

	openwrt,netdev-name = "wan";

	phy-mode = "sgmii";
	managed = "in-band-status";
	phy-handle = <&en8801sc>;
};

&mdio {
	en8801sc: ethernet-phy@0 {
		compatible = "ethernet-phy-id03a2.9461";
		reg = <0x0>;
		phy-mode = "sgmii";

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			led@1 {
				reg = <1>;

				function = LED_FUNCTION_WAN;
				color = <LED_COLOR_ID_GREEN>;
			};
		};
	};
};
