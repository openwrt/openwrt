/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "en7523.dtsi"

/ {
	model = "MitraStar GPT-2742GX4X5v6";
	compatible = "mitrastar,gpt-2742gx4x5v6", "airoha,en7523";

	chosen {
		// rootdisk = <&firmware>;
		// bootargs = "console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait";
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = &uart1;
		led-boot = &led_power;
		led-failsafe = &led_pon;
		led-upgrade = &led_pon;
		led-running = &led_power;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		wps5 {
			label = "wps5";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pinctrl 8 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		wps2 {
			label = "wps2";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pinctrl 11 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		// red:internet
		led_pon: led@3 {
			function = LED_FUNCTION_WAN_ONLINE;
			function-enumerator = <3>;
			color = <LED_COLOR_ID_RED>;
			gpios = <&pinctrl 3 GPIO_ACTIVE_HIGH>;
		};

		// blue:internet
		led_power: led@10 {
			function = LED_FUNCTION_WAN_ONLINE;
			function-enumerator = <10>;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&pinctrl 10 GPIO_ACTIVE_LOW>;
		};

		// blue:wlan-2g
		led@9 {
			function = LED_FUNCTION_WLAN_2GHZ;
			function-enumerator = <9>;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&pinctrl 9 GPIO_ACTIVE_LOW>;
		};

		// blue:wlan-5g
		led@21 {
			function = LED_FUNCTION_WLAN_5GHZ;
			function-enumerator = <21>;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&pinctrl 21 GPIO_ACTIVE_LOW>;
		};

		// green:fxs
		led@1 {
			function = LED_FUNCTION_ACTIVITY;
			function-enumerator = <1>;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pinctrl 1 GPIO_ACTIVE_LOW>;
		};

		// red:fxs
		led@26 {
			function = LED_FUNCTION_ACTIVITY;
			function-enumerator = <26>;
			color = <LED_COLOR_ID_RED>;
			gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
		};

		// blue:fxs
		led@27 {
			function = LED_FUNCTION_ACTIVITY;
			function-enumerator = <27>;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&pinctrl 27 GPIO_ACTIVE_LOW>;
		};
	};
};

/*
Old maping NAND
[    3.718322] 0x000000000000-0x000000080000 : "bootloader"
[    3.724363] 0x000000080000-0x0000000c0000 : "romfile"
[    3.757166] 0x0000000c0000-0x0000028c0000 : "tclinux"
[    3.792055] 0x0000028c0000-0x0000050c0000 : "tclinux_slave"
[    3.798150] 0x0000050c0000-0x000005100000 : "bootenv0"
[    3.803746] 0x000005100000-0x000005140000 : "bootenv1"
[    3.809388] 0x000005140000-0x000005540000 : "defcfg"
[    3.814821] 0x000005540000-0x000005940000 : "bakcfg"
[    3.820215] 0x000005940000-0x000005d40000 : "config"
[    3.825617] 0x000005d40000-0x000006540000 : "status"
[    3.831003] 0x000006dc0000-0x000007000000 : "reservearea"
[    3.836879] 0x000007000000-0x00000ac00000 : "coredump"
[    3.842506] 0x00000ac00000-0x00000b000000 : "persistentscript"
[    3.848833] 0x00000b000000-0x00000e000000 : "unused"
*/
&spi0 {
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x00000000 0x00080000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/*
					 * Factory board data from the NAND dump:
					 *   0x5fc48: E8:45:8B:05:30:50
					 *   0x5fc68: "E8458B053051"
					 */
					macaddr: macaddr@5fc48 {
						reg = <0x0005fc48 0x6>;
						compatible = "mac-base";
						#nvmem-cell-cells = <1>;
					};

					factory_serial: serial@5fc68 {
						reg = <0x0005fc68 0xc>;
					};
				};
			};

			partition@80000 {
				label = "romfile";
				reg = <0x00080000 0x00040000>;
			};

			partition@c0000 {
				label = "tclinux";
				reg = <0x000c0000 0x05a00000>;
			};

			partition@5ac0000 {
				label = "tclinux_slave";
				reg = <0x05ac0000 0x05a00000>;
			};

			partition@b4c0000 {
				label = "second_romfile";
				reg = <0x0b4c0000 0x00040000>;
			};

			partition@b500000 {
				label = "data";
				reg = <0x0b500000 0x00d00000>;
			};

			partition@c200000 {
				label = "app";
				reg = <0x0c200000 0x02980000>;
			};

			partition@eb80000 {
				label = "reservearea_backup";
				reg = <0x0eb80000 0x00240000>;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/*
					 * reservearea_backup starts at 0xeb80000 and has size 0x240000.
					 * The vendor dump shows MT7915 EEPROM headers at offsets
					 * 0x000000 and 0x020000 inside this partition.
					 */
					mt76_eeprom_2g: eeprom@0 {
						reg = <0x000000 0x1000>;
					};

					mt76_eeprom_5g: eeprom@20000 {
						reg = <0x020000 0x1000>;
					};

					/*
					 * Do not use the MT7915 EEPROM MAC at +0x4 as the board MAC:
					 * both blobs contain the same MediaTek calibration address
					 * 00:0c:43:26:46:44. Use factory_mac from bootloader instead.
					 */
					/*
					 * Optical/BOB data is not located after the first EEPROM.
					 * The dump shows a non-0xff calibration/config block around 0x140000.
					 */
					en7571_bob: bob@140000 {
						reg = <0x140000 0x1000>;
					};
				};
			};

			partition@edc0000 {
				label = "reservearea";
				reg = <0x0edc0000 0x00240000>;
			};
		};
	};
};

&i2c0 {
	status = "okay";
};

&pcie0 {
	status = "okay";

	pcie@0,0 {
		reg = <0x00000000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;

		mt7915@0,0 {
			reg = <0x0000 0 0 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			nvmem-cells = <&mt76_eeprom_2g>;
			nvmem-cell-names = "eeprom";
			airoha,npu = <&npu>;
			airoha,eth = <&eth>;

			/* 2.4Ghz */
			band@0 {
				reg = <0>;
				nvmem-cells = <&macaddr 0>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};

&pcie1 {
	status = "okay";

	pcie@1,0 {
		reg = <0x00000800 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;

		/* 5Ghz */
		mt7915@0,0 {
			reg = <0x0000 0 0 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			nvmem-cells = <&mt76_eeprom_5g>;
			nvmem-cell-names = "eeprom";
			airoha,npu = <&npu>;
			airoha,eth = <&eth>;

			band@0 {
				reg = <0>;
				nvmem-cells = <&macaddr 2>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};

&eth {
	status = "okay";
};

&en7571 {
	nvmem-cells = <&en7571_bob>;
	nvmem-cell-names = "calibration";
};

&gdm2 {
	status = "okay";
	phy-mode = "internal";

	nvmem-cells = <&macaddr 0>;
	nvmem-cell-names = "mac-address";

	/delete-property/ pcs-handle;
	/delete-property/ phy-handle;
	/delete-property/ managed;

	airoha,xpon-managed;
	openwrt,netdev-name = "pon0";
};

&xpon_phy {
	status = "okay";
};

&pon_pcs {
	status = "disabled";
};

&xpon {
	status = "okay";
};

&gdm1 {
	status = "okay";
	nvmem-cells = <&macaddr>;
	nvmem-cell-names = "mac-address";
};

&switch {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;

	status = "okay";
};

&gsw_port1 {
	label = "lan1";
	status = "okay";
};

&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

&gsw_port6 {
	nvmem-cells = <&macaddr>;
	nvmem-cell-names = "mac-address";
};

&gsw_phy1 {
	status = "okay";

	pinctrl-0 = <&swp1_led0 &swp1_led1>;
};

&gsw_phy2 {
	status = "okay";

	pinctrl-0 = <&swp2_led0 &swp2_led1>;
};

&gsw_phy3 {
	status = "okay";

	pinctrl-0 = <&swp3_led0 &swp3_led1>;
};

&gsw_phy4 {
	status = "okay";

	pinctrl-0 = <&swp4_led0 &swp4_led1>;
};

&gsw_phy1_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy1_led1 {
	status = "okay";
	color = <LED_COLOR_ID_YELLOW>;
};

&gsw_phy2_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy2_led1 {
	status = "okay";
	color = <LED_COLOR_ID_YELLOW>;
};

&gsw_phy3_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy3_led1 {
	status = "okay";
	color = <LED_COLOR_ID_YELLOW>;
};

&gsw_phy4_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy4_led1 {
	status = "okay";
	color = <LED_COLOR_ID_YELLOW>;
};
