/dts-v1/;

#include "en751221.dtsi"

/ {
	model = "TP-Link Archer XR500v v1";
	compatible = "tplink,archer-xr500v-v1", "econet,en751221";

	/* The sampled board identifies as EN7526G within the EN751221 family. */
	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * The boot firmware leaves the QDMA SLM bypassed, so the WAN
		 * forwarding pool lives in DRAM. Without this region the driver
		 * falls back to 256 x 2048-byte buffers and the reduced
		 * congestion profile, and bursty WiFi upstream is tail-dropped.
		 */
		qdma1_buf: qdma1-buf@d400000 {
			reg = <0x0d400000 0x00800000>;
			no-map;
		};
	};

	chosen {
		stdout-path = "/serial@1fbf0000:115200";
		rootdisk = <&firmware>;
		bootargs = "console=ttyS0,115200 loglevel=4 ubi.block=0,fit root=/dev/fit0 rootwait";
		linux,usable-memory-range = <0x00020000 0x0ffe0000>;
	};

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	leds {
		compatible = "gpio-leds";

		/* GPIO 6, not hardwired: the OEM bootloader switched it on and
		 * OpenWrt's U-Boot uses it as its boot LED. Keep it on.
		 */
		led_power: led-power {
			gpios = <&pinctrl 6 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			function-enumerator = <6>;
			default-state = "on";
		};

		led_pon: led-pon {
			gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_XPON;
			function-enumerator = <2>;
			default-state = "off";
		};

		led-wps {
			gpios = <&pinctrl 7 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WPS;
			function-enumerator = <7>;
			default-state = "off";
		};

		led-usb {
			gpios = <&pinctrl 11 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_USB;
			function-enumerator = <11>;
			default-state = "off";
		};

		led_los: led-los {
			gpios = <&pinctrl 24 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_XPON_LOS;
			function-enumerator = <24>;
			default-state = "off";
		};

		led-phone1 {
			gpios = <&pinctrl 25 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_VOIP;
			function-enumerator = <25>;
			default-state = "off";
		};

		led-phone2 {
			gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_VOIP;
			function-enumerator = <26>;
			default-state = "off";
		};

		led-internet {
			gpios = <&pinctrl 28 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			function-enumerator = <6>;
			default-state = "off";
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		key-wifi {
			label = "wifi";
			linux,code = <KEY_RFKILL>;
			gpios = <&pinctrl 4 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		key-wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pinctrl 9 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

&eth {
	memory-region = <&qdma1_buf>;
	memory-region-names = "qdma1-buf";
	status = "okay";
};

&gdm1 {
	nvmem-cells = <&macaddr_misc_f100 0>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&switch0 {
	status = "okay";
};

/* The four RJ45 ports hang off the MT7530 (switch1) behind the internal
 * switch; port 0 of the MT7530 is not wired. Physical LAN labels run
 * opposite to the switch port indices.
 */
&switch1 {
	status = "okay";
};

&gsw_port1 {
	label = "lan4";
	status = "okay";
};

&gsw_port2 {
	label = "lan3";
	status = "okay";
};

&gsw_port3 {
	label = "lan2";
	status = "okay";
};

&gsw_port4 {
	label = "lan1";
	status = "okay";
};

&gsw_phy1 {
	status = "okay";
};

&gsw_phy2 {
	status = "okay";
};

&gsw_phy3 {
	status = "okay";
};

&gsw_phy4 {
	status = "okay";
};

&gsw_phy1_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy2_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy3_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy4_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
};

&spi0 {
	nand: flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <25000000>;
		spi-rx-bus-width = <2>;
		spi-tx-bus-width = <1>;
		nand-ecc-engine = <&nand>;

		/* Layout of OpenWrt's U-Boot for this board (airoha/u-boot), which replaces
		 * the OEM bootloader and its BMT block remapping: tcboot.bin (DDR stage and
		 * U-Boot) in the first MiB, everything else in one UBI partition. U-Boot's
		 * format_ubi_part creates the volumes and copies the OEM "misc" partition
		 * into the "misc" volume, so the factory data keeps its OEM offsets.
		 */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x100000>;
				read-only;
			};

			partition@100000 {
				label = "ubi";
				compatible = "linux,ubi";
				reg = <0x100000 0x7f00000>;

				volumes {
					ubi-volume-ubootenv {
						volname = "ubootenv";

						nvmem-layout {
							compatible = "u-boot,env-redundant-bool";
						};
					};

					ubi-volume-ubootenv2 {
						volname = "ubootenv2";

						nvmem-layout {
							compatible = "u-boot,env-redundant-bool";
						};
					};

					ubi-volume-misc {
						volname = "misc";
						read-only;

						nvmem-layout {
							compatible = "fixed-layout";
							#address-cells = <1>;
							#size-cells = <1>;

							/* LAN MAC from the label; WAN is +1, Wi-Fi +2. */
							macaddr_misc_f100: macaddr@f100 {
								compatible = "mac-base";
								reg = <0xf100 0x6>;
								#nvmem-cell-cells = <1>;
							};

							/* Airoha LDD/LA calibration: 100 words, magic 0x07050700 at +0x94. */
							en7570_cal: calibration@20000 {
								reg = <0x20000 0x190>;
							};

							/* MT7662 (5 GHz) EEPROM, for the PCIe radio node. */
							eeprom_misc_e0000: eeprom@e0000 {
								reg = <0xe0000 0x200>;
							};
						};
					};

					firmware: ubi-volume-firmware {
						volname = "fit";
						compatible = "denx,uimage";
					};
				};
			};
		};
	};
};

/* Airoha LDD/LA at I2C 0x70, bound as en7570 like the other EN751221 boards
 * (Genexis Platinum-4410, Jiuzhou EN7526GT), with the factory calibration
 * from the "misc" volume.
 */
&i2c0 {
	status = "okay";

	en7570: lddla@70 {
		compatible = "airoha,en7570";
		reg = <0x70>;

		phys = <&xpon_phy>;
		phy-names = "xpon";

		nvmem-cells = <&en7570_cal>;
		nvmem-cell-names = "calibration";

		#optical-frontend-cells = <0>;
	};
};

&xpon_phy {
	status = "okay";

	vcc-disable-gpios = <&pinctrl 27 GPIO_ACTIVE_HIGH>;
};

&xpon {
	status = "okay";

	airoha,gpon-serial-from-mac;
	omci-vendor-id = "TPLG";

	/* Order consumed by airoha-xpon: GPON status, then LOS. */
	leds = <&led_pon>, <&led_los>;
	led-names = "pon", "los";

	optical-frontends = <&en7570>;
	optical-frontend-names = "pon";
};

&gdm2 {
	status = "okay";
	phy-mode = "internal";
	airoha,xpon-managed;

	nvmem-cells = <&macaddr_misc_f100 1>;
	nvmem-cell-names = "mac-address";

	openwrt,netdev-name = "pon0";
};

&usb0 {
	/* The populated connector uses USB2; there is no USB3 PHY lane. */
	mediatek,u3p-dis-msk = <0x1>;
	status = "okay";
};

/* PCIe port 0 carries the MT7603 (2.4 GHz). It only enumerates with the
 * vendor config-TLP format and a second reset after the PHY comes up, both
 * opt-in in pcie-mediatek (airoha/kernel). Port 1 carries the MT7662 (5 GHz).
 */
&pcie0 {
	status = "okay";
	econet,en751221-port0-quirks;
};

&pcie1 {
	status = "okay";
};

&pcie0_slot0 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;

		/*
		 * MT7603 expects a 1 KiB EEPROM. mt76 zero-initializes that
		 * buffer before copying this compact 256-byte non-zero prefix;
		 * valid calibration-free fields are then merged from eFuse.
		 */
		mediatek,eeprom-data = [
			03 76 00 00 02 76 03 50 00 01 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 22 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 b8 40 c8 20 00 00 00 40 c8 20 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			05 00 00 00 a4 00 00 88 00 00 00 00 00 00 00 00
		];
		mediatek,eeprom-merge-otp;
		/* The panel Wi-Fi LED hangs off the chip's GPIO12/13 pads. */
		mediatek,gpio-led;
		nvmem-cells = <&macaddr_misc_f100 1>;
		nvmem-cell-names = "mac-address";
	};
};

&pcie1_slot1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_misc_e0000>, <&macaddr_misc_f100 2>;
		nvmem-cell-names = "eeprom", "mac-address";

		led {
			led-sources = <2>;
			led-active-low;
		};
	};
};
