/dts-v1/;

#include "en751221.dtsi"

/ {
	model = "TP-Link Archer XR500v v1";
	compatible = "tplink,archer-xr500v-v1", "econet,en751221";

	/* The sampled board identifies as EN7526G within the EN751221 family. */
	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;
	};

	chosen {
		stdout-path = "/serial@1fbf0000:115200";
		bootargs = "console=ttyS0,115200 loglevel=4";
		linux,usable-memory-range = <0x00020000 0x0ffe0000>;
	};

	leds {
		compatible = "gpio-leds";

		led_pon: led-pon {
			label = "green:pon";
			gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led-wps {
			label = "green:wps";
			gpios = <&pinctrl 7 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led-usb {
			label = "green:usb";
			gpios = <&pinctrl 11 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_los: led-los {
			label = "red:los";
			gpios = <&pinctrl 24 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led-phone1 {
			label = "green:phone1";
			gpios = <&pinctrl 25 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led-phone2 {
			label = "green:phone2";
			gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led-internet {
			label = "green:internet";
			gpios = <&pinctrl 28 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		key-wifi {
			label = "wifi";
			linux,code = <KEY_RFKILL>;
			gpios = <&pinctrl 4 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		key-wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pinctrl 9 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

/* GPIO 27 enables the BOSA transmitter 3V3 supply (OEM "LED_PHY_VCC_DISABLE").
 * The pin floats high (supply disabled) unless driven low; the OEM firmware
 * drives it low right after the transmitter is disabled. Without it the laser
 * only survives short bursts and upstream stalls at ~60 Mbit/s. GPIO 16
 * (TX_DISABLE) is left to the optical driver.
 */
&pinctrl {
	pon-vcc-enable-hog {
		gpio-hog;
		gpios = <27 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "pon-vcc-disable";
	};
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";
};

&switch0 {
	status = "okay";
};

/* The four RJ45 ports hang off the MT7530 (switch1) behind the internal
 * switch; port 0 of the MT7530 is not wired. Physical LAN labels run
 * opposite to the switch port indices.
 */
&switch1 {
	status = "okay";
};

&gsw_port1 {
	label = "lan4";
	status = "okay";
};

&gsw_port2 {
	label = "lan3";
	status = "okay";
};

&gsw_port3 {
	label = "lan2";
	status = "okay";
};

&gsw_port4 {
	label = "lan1";
	status = "okay";
};

&gsw_phy1 {
	status = "okay";
};

&gsw_phy2 {
	status = "okay";
};

&gsw_phy3 {
	status = "okay";
};

&gsw_phy4 {
	status = "okay";
};

/* The SPI-NAND is exposed as a whole; the OEM tcboot layout uses BMT block
 * remapping, so no fixed partitions are described here. The UBI layout comes
 * with the U-Boot port for this board.
 */
&spi0 {
	status = "okay";
};

/* Airoha LDD/LA at I2C 0x70, bound as en7570 like the other EN751221 boards
 * (Genexis Platinum-4410, Jiuzhou EN7526GT). The factory LDD/LA calibration
 * lives in the OEM "misc" partition and will be referenced through nvmem once
 * the flash layout is described.
 */
&i2c0 {
	status = "okay";

	en7570: lddla@70 {
		compatible = "airoha,en7570";
		reg = <0x70>;
		phys = <&xpon_phy>;
		phy-names = "xpon";
	};
};

&xpon_phy {
	status = "okay";
};

&xpon {
	status = "okay";
	airoha,gpon-serial-from-mac;
	omci-vendor-id = "TPLG";
	/* Order consumed by airoha-xpon: GPON status, then LOS. */
	leds = <&led_pon>, <&led_los>;
	led-names = "pon", "los";
};

&gdm2 {
	status = "okay";
	phy-mode = "internal";
};

&usb {
	/* The populated connector uses USB2; there is no USB3 PHY lane. */
	mediatek,u3p-dis-msk = <0x1>;
	status = "okay";
};
