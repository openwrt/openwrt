. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

# Switch
case "$board" in
  mitrastar,gpt-2741gnac-n1)
    ucidef_set_led_netdev "lan1" "lan1" "mt7530-0:09:green:lan" "lan1" "link tx rx"
    ucidef_set_led_netdev "lan2" "lan2" "mt7530-0:0a:green:lan" "lan2" "link tx rx"
    ucidef_set_led_netdev "lan3" "lan3" "mt7530-0:0b:green:lan" "lan3" "link tx rx"
    ucidef_set_led_netdev "lan4" "lan4" "mt7530-0:0c:green:lan" "lan4" "link tx rx"
    ;;
  tplink,archer-xr500v-v1)
    ucidef_set_led_netdev "lan1" "LAN1" "green:lan1" "lan1" "link tx rx"
    ucidef_set_led_netdev "lan2" "LAN2" "green:lan2" "lan2" "link tx rx"
    ucidef_set_led_netdev "lan3" "LAN3" "green:lan3" "lan3" "link tx rx"
    ucidef_set_led_netdev "lan4" "LAN4" "green:lan4" "lan4" "link tx rx"
    ;;
esac

board_config_flush

exit 0
