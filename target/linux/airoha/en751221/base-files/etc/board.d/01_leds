. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

# Switch
case "$board" in
  mitrastar,gpt-2741gnac-n1)
    ucidef_set_led_netdev "lan1" "lan1" "mt7530-2:01:green:lan" "lan1" "link_1000"
    ucidef_set_led_netdev "lan2" "lan2" "mt7530-2:02:green:lan" "lan2" "link_1000"
    ucidef_set_led_netdev "lan3" "lan3" "mt7530-2:03:green:lan" "lan3" "link_1000"
    ucidef_set_led_netdev "lan4" "lan4" "mt7530-2:04:green:lan" "lan4" "link_1000"

    ucidef_set_led_netdev "lan1" "lan1" "mt7530-2:01:yellow:lan" "lan1" "link tx rx"
    ucidef_set_led_netdev "lan2" "lan2" "mt7530-2:02:yellow:lan" "lan2" "link tx rx"
    ucidef_set_led_netdev "lan3" "lan3" "mt7530-2:03:yellow:lan" "lan3" "link tx rx"
    ucidef_set_led_netdev "lan4" "lan4" "mt7530-2:04:yellow:lan" "lan4" "link tx rx"
    ;;
  nokia,g240g-e)
    ucidef_set_led_netdev "lan1" "lan1" "mt7530-2:01:green:lan" "lan1" "link tx rx"
    ucidef_set_led_netdev "lan2" "lan2" "mt7530-2:02:green:lan" "lan2" "link tx rx"
    ucidef_set_led_netdev "lan3" "lan3" "mt7530-2:03:green:lan" "lan3" "link tx rx"
    ucidef_set_led_netdev "lan4" "lan4" "mt7530-2:04:green:lan" "lan4" "link tx rx"
    ;;
  tplink,archer-xr500v-v1)
    ucidef_set_led_netdev "lan4" "lan4" "mt7530-2:01:green:lan" "lan4" "link tx rx"
    ucidef_set_led_netdev "lan3" "lan3" "mt7530-2:02:green:lan" "lan3" "link tx rx"
    ucidef_set_led_netdev "lan2" "lan2" "mt7530-2:03:green:lan" "lan2" "link tx rx"
    ucidef_set_led_netdev "lan1" "lan1" "mt7530-2:04:green:lan" "lan1" "link tx rx"
    ;;
esac

case "$board" in
  nokia,g240g-e)
    ucidef_set_led_netdev "pon0" "pon0" "green:status-28" "pon0" "pon0"
    ;;
esac

board_config_flush

exit 0
