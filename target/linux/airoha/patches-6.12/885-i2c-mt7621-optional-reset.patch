From 9131cb44ffc39372eb77bd068ccb2b349f1a5fa7 Mon Sep 17 00:00:00 2001
From: Christian Marangi <ansuelsmth@gmail.com>
Date: Thu, 17 Oct 2024 15:54:52 +0200
Subject: [PATCH] i2c: mt7621: use optional device reset

Use device_reset_optional() instead of device_reset(), so that probing
does not fail on Airoha SoCs, which do not provide a reset for the I2C
controller.
---
--- a/drivers/i2c/busses/i2c-mt7621.c
+++ b/drivers/i2c/busses/i2c-mt7621.c
@@ -85,7 +85,7 @@ static void mtk_i2c_reset(struct mtk_i2c
 {
 	int ret;
 
-	ret = device_reset(i2c->adap.dev.parent);
+	ret = device_reset_optional(i2c->adap.dev.parent);
 	if (ret)
 		dev_err(i2c->dev, "I2C reset failed!\n");
 
