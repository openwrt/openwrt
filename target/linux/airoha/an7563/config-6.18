CONFIG_CMDLINE="console=ttyS0,115200n8 earlycon root=/dev/ubiblock0_0 rootfstype=squashfs"
#
# The stock Econet U-Boot 2014.04 rewrites /chosen/bootargs unconditionally:
#
#   common/image-fdt.c:460   image_setup_libfdt(): fdt_chosen(blob, 1)
#   common/fdt_support.c:265  if ((path == NULL) || force)
#                            fdt_setprop(fdt, chosen, "bootargs", getenv("bootargs"));
#
# and "flash tpimg" does setenv("root", CONFIG_ENV_ROOT) before building it
# (common/ecnt/cmd_flash.c:259, "root" is in mi_conf[]), which on this board
# is "/dev/mtdblock5 ro" -- the stock index of the rootfs partition.  With our
# partition table nothing is at index 5, so the kernel aborts with ENXIO.
#
# CMDLINE_FORCE makes of_fdt_chosen() strscpy() this string over whatever the
# bootloader supplied (drivers/of/fdt.c, CONFIG_CMDLINE_FORCE branch), which
# is the only override that exists here: /chosen/bootargs-append is additive
# and there is no "bootargs-override" property in the kernel at all.
#
# The recovery image is unaffected: init/main.c only calls prepare_namespace()
# when /init is NOT reachable from the initramfs, so root= is never looked at.
#
# No rootwait on purpose: UBI attaches from device_initcall/late_initcall
# (drivers/mtd/ubi/build.c), both of which run strictly before the root mount,
# so there is no race to cover up and a failure should panic loudly on the
# serial console rather than hang silently.
#
CONFIG_CMDLINE_FORCE=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_EN7523=y
CONFIG_COMPACT_UNEVICTABLE_DEFAULT=1
CONFIG_COMPAT_32BIT_TIME=y
