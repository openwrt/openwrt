. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
airoha,an7581-evb)
	ucidef_set_led_usbport "usb1" "USB 1" "green:usb-1" "usb1-port1" "usb2-port1"
	ucidef_set_led_usbport "usb2" "USB 2" "green:usb-2" "usb3-port1" "usb4-port1"
	;;
gemtek,w1700k-ubi)
	ucidef_set_led_netdev "wan-yellow" "wan" "mt7530-0:08:yellow:wan" "wan" "link_10 link_100 link_10000"
	ucidef_set_led_netdev "wan-green" "wan" "mt7530-0:08:green:wan" "wan" "link_1000 link_2500 link_5000 link_10000 tx rx"
	ucidef_set_led_netdev "lan2-yellow" "lan2" "mt7530-0:05:yellow:lan-2" "lan2" "link_10 link_100 link_10000"
	ucidef_set_led_netdev "lan2-green" "lan2" "mt7530-0:05:green:lan-2" "lan2" "link_1000 link_2500 link_5000 link_10000 tx rx"
	ucidef_set_led_netdev "lan3-yellow" "lan3" "yellow:lan-3" "lan3" "link_10 link_100"
	ucidef_set_led_netdev "lan3-green" "lan3" "green:lan-3" "lan3" "link_1000 tx rx"
	ucidef_set_led_netdev "lan4-yellow" "lan4" "yellow:lan-4" "lan4" "link_10 link_100"
	ucidef_set_led_netdev "lan4-green" "lan4" "green:lan-4" "lan4" "link_1000 tx rx"
	;;
nokia,xg-040g-md|\
nokia,xg-040g-md-ubi)
	ucidef_set_led_netdev "lan2" "lan2" "mt7530-0:0a:green:lan-2" "lan2" "link tx rx"
	ucidef_set_led_netdev "lan3" "lan3" "mt7530-0:0b:green:lan-3" "lan3" "link tx rx"
	ucidef_set_led_netdev "lan4" "lan4" "mt7530-0:0c:green:lan-4" "lan4" "link tx rx"
	;;
quantum,q1000k-ubi)
	ucidef_set_led_netdev "lan1-yellow" "lan1" "yellow:lan" "lan1" "link_10 link_100"
	ucidef_set_led_netdev "lan1-green" "lan1" "green:lan" "lan1" "link_1000 tx rx"
	;;
tplink,xb432v)
	# Front LEDs
	ucidef_set_led_default	"power"			"POWER"		"blue:power"				"1"
	ucidef_set_led_default	"fiber"			"FIBER"		"blue:fiber"				"0"
	ucidef_set_led_default	"fiber-fault"	"NOFIBER"	"red:fiber"					"0"
	ucidef_set_led_netdev	"internet"		"NET"		"blue:internet"				"wan"	"link tx rx"
	ucidef_set_led_netdev	"lan"			"LAN"		"blue:lan"					"lan3"	"link tx rx"
	ucidef_set_led_wlan		"wifi"			"WIFI"		"blue:wlan"					"phy0tpt"
	ucidef_set_led_default	"phone"			"PHONE"		"blue:phone"				"0"
	ucidef_set_led_usbport	"usb"			"USB"		"blue:usb"					"usb1-port1" "usb2-port1"
	# Rear ports LEDs
	ucidef_set_led_netdev	"lan1"			"LAN1"		"mt7530-0:0b:green:lan-1"	"lan1"	"link tx rx"
	ucidef_set_led_netdev	"lan2"			"LAN2"		"mt7530-0:0a:green:lan-2"	"lan2"	"link tx rx"
	ucidef_set_led_netdev	"lan3"			"LAN3"		"green:lan-3"				"lan3"	"link tx rx"
	ucidef_set_led_netdev	"wan"			"WAN"		"green:wan"					"wan"	"link tx rx"
	;;
esac

board_config_flush

exit 0
