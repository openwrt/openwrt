#include "qcom-ipq4019.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/soc/qcom,tcsr.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Gryphon Guardian";
	compatible = "gryphon,guardian", "qcom,ipq4019";

	aliases {
		led-boot = &led_white;
		led-failsafe = &led_orange;
		led-running = &led_white;
		led-upgrade = &led_orange;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&tlmm 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_white: white {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_WHITE>;
			gpios = <&tlmm 39 GPIO_ACTIVE_HIGH>;
		};

		led_orange: orange {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_ORANGE>;
			gpios = <&tlmm 40 GPIO_ACTIVE_HIGH>;
		};
	};

	soc {

		tcsr@1949000 {
			compatible = "qcom,tcsr";
			reg = <0x1949000 0x100>;
			qcom,wifi_glb_cfg = <TCSR_WIFI_GLB_CFG>;
		};

		ess_tcsr@1953000 {
			compatible = "qcom,tcsr";
			reg = <0x1953000 0x1000>;
			qcom,ess-interface-select = <TCSR_ESS_PSGMII>;
		};

		tcsr@1957000 {
			compatible = "qcom,tcsr";
			reg = <0x1957000 0x100>;
			qcom,wifi_noc_memtype_m0_m2 = <TCSR_WIFI_NOC_MEMTYPE_M0_M2>;
		};
	};
};

&prng {
	status = "okay";
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-delay-us = <2000>;
	reset-post-delay-us = <2000>;
	reset-gpios = <&tlmm 47 GPIO_ACTIVE_LOW>;
};

&crypto {
	status = "okay";
};

&watchdog {
	status = "okay";
};

&blsp_dma {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&tlmm {
	mdio_pins: mdio-pinmux {
		mux_mdio {
			pins = "gpio6";
			function = "mdio";
			bias-pull-up;
		};

		mux_mdc {
			pins = "gpio7";
			function = "mdc";
			bias-pull-up;
		};
	};

	serial_pins: serial-pinmux {
		function = "blsp_uart0";
		pins = "gpio16", "gpio17";
		bias-disable;
	};

	nand_pins: nand-pins {
		pullups {
			pins = "gpio52", "gpio53", "gpio58", "gpio59";
			function = "qpic";
			bias-pull-up;
		};

		pulldowns {
			pins =	"gpio54", "gpio55", "gpio56",
				"gpio57", "gpio60", "gpio61",
				"gpio62", "gpio63", "gpio64",
				"gpio65", "gpio66", "gpio67",
				"gpio68", "gpio69";
			function = "qpic";
			bias-pull-down;
		};
	};
};

&nand {
	pinctrl-0 = <&nand_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x00000000 0x00200000>;
				read-only;
			};

			partition@200000 {
				label = "0:MIBIB";
				reg = <0x00200000 0x00200000>;
				read-only;
			};

			partition@400000 {
				label = "0:BOOTCONFIG";
				reg = <0x00400000 0x00200000>;
				read-only;
			};

			partition@600000 {
				label = "0:QSEE";
				reg = <0x00600000 0x00200000>;
				read-only;
			};

			partition@800000 {
				label = "0:QSEE_1";
				reg = <0x00800000 0x00200000>;
				read-only;
			};

			partition@a00000 {
				label = "0:CDT";
				reg = <0x00a00000 0x00100000>;
				read-only;
			};

			partition@b00000 {
				label = "0:CDT_1";
				reg = <0x00b00000 0x00100000>;
				read-only;
			};

			partition@c00000 {
				label = "0:BOOTCONFIG1";
				reg = <0x00c00000 0x00100000>;
				read-only;
			};

			partition@d00000 {
				label = "0:APPSBLENV";
				reg = <0x00d00000 0x00100000>;
			};

			partition@e00000 {
				label = "0:APPSBL";
				reg = <0x00e00000 0x00300000>;
				read-only;
			};

			partition@1100000 {
				label = "0:APPSBL_1";
				reg = <0x01100000 0x00200000>;
				read-only;
			};

			partition@1300000 {
				label = "0:ART";
				reg = <0x01300000 0x00100000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_gmac0: macaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};

					precal_art_1000: precal@1000 {
						reg = <0x1000 0x2f20>;
					};

					precal_art_5000: precal@5000 {
						reg = <0x5000 0x2f20>;
					};
				};
			};

			partition@1400000 {
				label = "rootfs";
				reg = <0x01400000 0x1ec00000>;
			};
		};
	};
};

&blsp1_uart1 {
	status = "okay";
	pinctrl-0 = <&serial_pins>;
	pinctrl-names = "default";
};

&cryptobam {
	status = "okay";
};

&gmac {
	status = "okay";
	nvmem-cells = <&macaddr_gmac0 0>;
	nvmem-cell-names = "mac-address";
};

&switch {
	status = "okay";
};

&swport3 {
	status = "okay";
	label = "lan";
	nvmem-cells = <&macaddr_gmac0 1>;
	nvmem-cell-names = "mac-address";
};

&swport4 {
	status = "okay";
	label = "wan";
	nvmem-cells = <&macaddr_gmac0 0>;
	nvmem-cell-names = "mac-address";
};

&wifi0 {
	status = "okay";
	nvmem-cell-names = "pre-calibration", "mac-address";
	nvmem-cells = <&precal_art_1000>, <&macaddr_gmac0 2>;
	qcom,ath10k-calibration-variant = "Gryphon-Guardian";
};

&wifi1 {
	status = "okay";
	nvmem-cell-names = "pre-calibration", "mac-address";
	nvmem-cells = <&precal_art_5000>, <&macaddr_gmac0 3>;
	qcom,ath10k-calibration-variant = "Gryphon-Guardian";
};
