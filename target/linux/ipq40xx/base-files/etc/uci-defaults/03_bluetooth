#!/bin/sh

. /lib/functions.sh

[ "$(board_name)" = "arista,w-118" ] || exit 0
# Without bluetooth-uart (it needs bluez from the packages feed) stay
# pending: the script runs again at the next boot, after it is installed.
[ "$(uci -q get bluetooth-uart.main)" = "uart" ] || exit 1

# Preserve an already configured UART, including a disabled one.
[ -z "$(uci -q get bluetooth-uart.main.device)" ] || exit 0

# The NXP controller's UART has no flow control.
uci -q batch <<-EOF
	set bluetooth-uart.main.device='/dev/ttyMSM1'
	set bluetooth-uart.main.protocol='h4'
	set bluetooth-uart.main.speed='115200'
	set bluetooth-uart.main.flow_control='0'
	set bluetooth-uart.main.enabled='1'
EOF
