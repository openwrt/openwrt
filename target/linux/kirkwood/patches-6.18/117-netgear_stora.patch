From 0dfc0495fc4194eff2379293c90863ac0161fdb1 Mon Sep 17 00:00:00 2001
From: Zoltan HERPAI <wigyori@uid0.hu>
Date: Thu, 5 May 2022 08:47:27 +0200
Subject: [PATCH] ARM: dts: marvell: build kirkwood-stora.dtb

Add the device tree of the Netgear Stora (MS2000/MS2110) to the device
trees built for kirkwood.
---
--- a/arch/arm/boot/dts/marvell/Makefile
+++ b/arch/arm/boot/dts/marvell/Makefile
@@ -157,6 +157,7 @@ dtb-$(CONFIG_MACH_KIRKWOOD) += \
 	kirkwood-rs411.dtb \
 	kirkwood-sheevaplug.dtb \
 	kirkwood-sheevaplug-esata.dtb \
+	kirkwood-stora.dtb \
 	kirkwood-t5325.dtb \
 	kirkwood-topkick.dtb \
 	kirkwood-ts219-6281.dtb \
