From b6db23018357e66a83de4b8bb5e1e86874d6049f Mon Sep 17 00:00:00 2001
From: Adrian Schmutzler <freifunk@adrianschmutzler.de>
Date: Wed, 19 Feb 2020 16:39:32 +0100
Subject: [PATCH] ARM: dts: kirkwood-nsa325: add LED aliases and triggers

Add the LED aliases used by OpenWrt to indicate the boot, failsafe,
running and upgrade states and assign default triggers to the LEDs of
the ZyXEL NSA325.
---
--- a/arch/arm/boot/dts/marvell/kirkwood-nsa325.dts
+++ b/arch/arm/boot/dts/marvell/kirkwood-nsa325.dts
@@ -15,6 +15,13 @@
 	model = "ZyXEL NSA325";
 	compatible = "zyxel,nsa325", "marvell,kirkwood-88f6282", "marvell,kirkwood";
 
+	aliases {
+		led-boot = &led_green_sys;
+		led-failsafe = &led_orange_sys;
+		led-running = &led_green_sys;
+		led-upgrade = &led_orange_sys;
+	};
+
 	memory {
 		device_type = "memory";
 		reg = <0x00000000 0x20000000>;
@@ -162,17 +169,19 @@
 			     &pmx_led_hdd1_green &pmx_led_hdd1_red>;
 		pinctrl-names = "default";
 
-		led-green-sys {
+		led_green_sys: led-green-sys {
 			label = "nsa325:green:sys";
 			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
+			default-state = "on";
 		};
-		led-orange-sys {
+		led_orange_sys: led-orange-sys {
 			label = "nsa325:orange:sys";
 			gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
 		};
 		led-green-hdd1 {
 			label = "nsa325:green:hdd1";
 			gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "ata1";
 		};
 		led-red-hdd1 {
 			label = "nsa325:red:hdd1";
@@ -181,6 +190,7 @@
 		led-green-hdd2 {
 			label = "nsa325:green:hdd2";
 			gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "ata2";
 		};
 		led-red-hdd2 {
 			label = "nsa325:red:hdd2";
@@ -189,6 +199,7 @@
 		led-green-usb {
 			label = "nsa325:green:usb";
 			gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "usb-host";
 		};
 		led-green-copy {
 			label = "nsa325:green:copy";
