From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andy Boxer <andyboxer@gmail.com>
Date: Sat, 4 Jul 2026 13:48:20 +0300
Subject: [PATCH] bcm47xx: copy legacy b44 RX frames out of the DMA buffer

page_frag_alloc() is only byte-aligned. On SSB-only bcm47xx builds, give
b44 and b43 RX skbs one extra L1 cache line and leave the DMA length
unchanged. That tailroom did not stop a large b44 RX skb from oopsing in
skb_zcopy_clear(). On those builds, copy every b44 RX frame and leave the
DMA buffer on the ring.

Signed-off-by: Andy Boxer <andyboxer@gmail.com>
---
--- a/drivers/net/ethernet/broadcom/b44.c
+++ b/drivers/net/ethernet/broadcom/b44.c
@@ -12,7 +12,7 @@
  */
 
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
-
+#define B44_RX_SKB_TAIL (IS_ENABLED(CONFIG_BCM47XX_SSB) && !IS_ENABLED(CONFIG_BCM47XX_BCMA) ? L1_CACHE_BYTES : 0)
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/moduleparam.h>
@@ -644,7 +644,7 @@ static int b44_alloc_rx_skb(struct b44 *
 		src_map = &bp->rx_buffers[src_idx];
 	dest_idx = dest_idx_unmasked & (B44_RX_RING_SIZE - 1);
 	map = &bp->rx_buffers[dest_idx];
-	skb = netdev_alloc_skb(bp->dev, RX_PKT_BUF_SZ);
+	skb = netdev_alloc_skb(bp->dev, RX_PKT_BUF_SZ + B44_RX_SKB_TAIL);
 	if (skb == NULL)
 		return -ENOMEM;
 
@@ -661,7 +661,7 @@ static int b44_alloc_rx_skb(struct b44 *
 			dma_unmap_single(bp->sdev->dma_dev, mapping,
 					     RX_PKT_BUF_SZ, DMA_FROM_DEVICE);
 		dev_kfree_skb_any(skb);
-		skb = alloc_skb(RX_PKT_BUF_SZ, GFP_ATOMIC | GFP_DMA);
+		skb = alloc_skb(RX_PKT_BUF_SZ + B44_RX_SKB_TAIL, GFP_ATOMIC | GFP_DMA);
 		if (skb == NULL)
 			return -ENOMEM;
 		mapping = dma_map_single(bp->sdev->dma_dev, skb->data,
@@ -2345,7 +2345,7 @@ static int b44_init_one(struct ssb_devic
 	bp = netdev_priv(dev);
 	bp->sdev = sdev;
 	bp->dev = dev;
-	bp->force_copybreak = 0;
+	bp->force_copybreak = IS_ENABLED(CONFIG_BCM47XX_SSB) && !IS_ENABLED(CONFIG_BCM47XX_BCMA);
 
 	bp->msg_enable = netif_msg_init(b44_debug, B44_DEF_MSG_ENABLE);
 
--- a/drivers/net/wireless/broadcom/b43/dma.c
+++ b/drivers/net/wireless/broadcom/b43/dma.c
@@ -28,6 +28,11 @@
 #include <linux/slab.h>
 #include <asm/div64.h>
 
+#if IS_ENABLED(CONFIG_BCM47XX_SSB) && !IS_ENABLED(CONFIG_BCM47XX_BCMA)
+#define B43_RX_SKB_TAIL	L1_CACHE_BYTES
+#else
+#define B43_RX_SKB_TAIL	0
+#endif
 
 /* Required number of TX DMA slots per TX frame.
  * This currently is 2, because we put the header and the ieee80211 frame
@@ -598,7 +603,7 @@ static int setup_rx_descbuffer(struct b4
 
 	B43_WARN_ON(ring->tx);
 
-	skb = __dev_alloc_skb(ring->rx_buffersize, gfp_flags);
+	skb = __dev_alloc_skb(ring->rx_buffersize + B43_RX_SKB_TAIL, gfp_flags);
 	if (unlikely(!skb))
 		return -ENOMEM;
 	b43_poison_rx_buffer(ring, skb);
@@ -609,7 +614,7 @@ static int setup_rx_descbuffer(struct b4
 
 		dev_kfree_skb_any(skb);
 
-		skb = __dev_alloc_skb(ring->rx_buffersize, gfp_flags);
+		skb = __dev_alloc_skb(ring->rx_buffersize + B43_RX_SKB_TAIL, gfp_flags);
 		if (unlikely(!skb))
 			return -ENOMEM;
 		b43_poison_rx_buffer(ring, skb);
