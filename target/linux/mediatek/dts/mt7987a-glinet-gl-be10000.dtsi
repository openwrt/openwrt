#include "mt7987a.dtsi"
#include <dt-bindings/input/input.h>

#define GL_BE10000_NVMEM_LAYOUT				\
	nvmem-layout {					\
		compatible = "fixed-layout";		\
		#address-cells = <1>;			\
		#size-cells = <1>;			\
							\
		eeprom_factory_0: eeprom@0 {		\
			reg = <0x0 0x1e00>;		\
		};					\
							\
		macaddr_factory_4: macaddr@4000 {	\
			reg = <0x4000 0x6>;		\
			compatible = "mac-base";	\
			#nvmem-cell-cells = <1>;	\
		};					\
	}

/ {
	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x40000000>;
	};

	aliases {
		serial0 = &uart0;
		label-mac-device = &gmac0;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 4 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
		};

		button-switch {
			label = "switch";
			linux,code = <BTN_0>;
			gpios = <&pio 3 GPIO_ACTIVE_HIGH>;
			debounce-interval = <10>;
			linux,input-type = <EV_SW>;
		};
	};

	usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&pio 23 GPIO_ACTIVE_HIGH>;
		regulator-name = "usb_vbus";
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 2 50000>;
		brightness-levels = <0 16 32 48 64 80 96 112 128 144 160 176 192 208 224 255>;
		default-brightness-level = <12>;
	};

	fan_3v: regulator-fan-3p3v {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&pio 6 GPIO_ACTIVE_HIGH>;
		regulator-name = "fan";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};
};

&cpu_thermal {
	polling-delay-passive = <0>;
	polling-delay = <1000>;
	critical-action = "reboot";

	/delete-node/ cooling-maps;
	/delete-node/ trips;

	trips {
		cpu_crit: critical {
			temperature = <125000>;
			hysteresis = <4000>;
			type = "critical";
		};

		cpu_hot: hot {
			temperature = <120000>;
			hysteresis = <4000>;
			type = "hot";
		};

		cpu_active_high: active-high {
			temperature = <110000>;
			hysteresis = <4000>;
			type = "active";
		};

		cpu_active_med: active-med {
			temperature = <80000>;
			hysteresis = <4000>;
			type = "active";
		};

		cpu_active_low: active-low {
			temperature = <60000>;
			hysteresis = <4000>;
			type = "active";
		};

		cpu_active_silent: active-silent {
			temperature = <40000>;
			hysteresis = <4000>;
			type = "active";
		};
	};

	cooling-maps {
		map3 {
			trip = <&cpu_active_high>;
			cooling-device = <&fan 3 3>,
					 <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
		};

		map2 {
			trip = <&cpu_active_med>;
			cooling-device = <&fan 2 2>;
		};

		map1 {
			trip = <&cpu_active_low>;
			cooling-device = <&fan 1 1>;
		};

		map0 {
			trip = <&cpu_active_silent>;
			cooling-device = <&fan 0 0>;
		};
	};
};

&fan {
	fan-supply = <&fan_3v>;
	interrupt-parent = <&pio>;
	interrupts = <5 IRQ_TYPE_EDGE_RISING>;
	pwms = <&pwm 1 50000>;

	cooling-levels = <61 77 102 128>;
	pulses-per-revolution = <2>;

	status = "okay";
};

&gmac0 {
	phy-mode = "2500base-x";
	phy-handle = <&phy7>;
	status = "okay";
	nvmem-cells = <&macaddr_factory_4 0>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	phy-mode = "internal";
	phy-handle = <&phy15>;
	status = "okay";
	nvmem-cells = <&macaddr_factory_4 1>;
	nvmem-cell-names = "mac-address";
};

&mdio {
	reset-gpios = <&pio 0 GPIO_ACTIVE_LOW>;
	reset-delay-us = <10000>;

	phy7: phy@7 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <7>;
		reset-assert-us = <100000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&pio 42 GPIO_ACTIVE_LOW>;
		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-parent = <&pio>;
		interrupts = <41 IRQ_TYPE_LEVEL_LOW>;
	};

	phy15: phy@f {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <15>;
		pinctrl-names = "i2p5gbe-led";
		pinctrl-0 = <&i2p5gbe_led0_pins>;
	};
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_pins>;
	status = "okay";

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;

			nvmem-cells = <&eeprom_factory_0>;
			nvmem-cell-names = "eeprom";

			#address-cells = <1>;
			#size-cells = <0>;

			ieee80211-freq-limit = <2400000 2500000>,
					       <5170000 5835000>,
					       <5945000 7125000>;

			band@0 {
				reg = <0>;
				nvmem-cells = <&macaddr_factory_4 2>;
				nvmem-cell-names = "mac-address";
			};

			band@1 {
				reg = <1>;
				nvmem-cells = <&macaddr_factory_4 3>;
				nvmem-cell-names = "mac-address";
			};

			band@2 {
				reg = <2>;
				nvmem-cells = <&macaddr_factory_4 4>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	status = "okay";

	touchscreen@58 {
		compatible = "hynitron,cst3530";
		reg = <0x58>;

		interrupt-parent = <&pio>;
		interrupts = <11 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pio 8 GPIO_ACTIVE_LOW>;

		/* the panel is mounted upside down, the display compensates
		 * in its MADCTL and the touch axes follow here
		 */
		touchscreen-size-x = <240>;
		touchscreen-size-y = <320>;
		touchscreen-swapped-x-y;
		touchscreen-inverted-y;
	};
};

&pio {
	pwm1_pins: pwm1-pins {
		mux {
			function = "pwm";
			groups = "pwm1_0";
		};
	};

	pwm2_pins: pwm2-pins {
		mux {
			function = "pwm";
			groups = "pwm2_0";
		};
	};

	spi1_pins: spi1-pins {
		mux {
			function = "spi";
			groups = "spi1_1";
		};
	};
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm1_pins>, <&pwm2_pins>;
	status = "okay";
};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;
	status = "okay";

	display@0 {
		compatible = "glinet,gl-be10000-panel", "panel-mipi-dbi-spi";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <0>;
		spi-cpol;
		spi-cpha;

		dc-gpios = <&pio 22 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pio 10 GPIO_ACTIVE_HIGH>;
		te-gpios = <&pio 9 GPIO_ACTIVE_HIGH>;
		write-only;

		format = "r5g6b5";
		backlight = <&backlight>;

		/* physical dimensions are approximate; verify against the panel */
		width-mm = <41>;
		height-mm = <31>;

		panel-timing {
			hactive = <320>;
			vactive = <240>;
			hback-porch = <0>;
			vback-porch = <0>;
			clock-frequency = <0>;
			hfront-porch = <0>;
			hsync-len = <0>;
			vfront-porch = <0>;
			vsync-len = <0>;
		};
	};
};

&ssusb {
	vbus-supply = <&usb_vbus>;
	status = "okay";
};

&tphyu3port0 {
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
	status = "okay";
};
