/dts-v1/;

#include "mt7988a.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/mt65xx.h>
#include <dt-bindings/regulator/richtek,rt5190a-regulator.h>

/ {
	compatible = "glinet,gl-be14000", "mediatek,mt7988a";
	model = "GL.iNet GL-BE14000";

	aliases {
		serial0 = &serial0;
		label-mac-device = &gmac2;
	};

	chosen {
		stdout-path = "serial0:115200n1";
		rootdisk = <&emmc_rootfs>;
		bootargs = "console=ttyS0,115200n1 pci=pcie_bus_perf root=PARTLABEL=rootfs rootwait";
	};

	memory@40000000 {
		reg = <0x0 0x40000000 0x0 0x80000000>;
		device_type = "memory";
	};

	reg_1p8v: regulator-1p8v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_fan_3p3v: regulator-fan-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fan-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&pio 60 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 13 GPIO_ACTIVE_LOW>;
		};
	};

	gpio-export {
		compatible = "gpio-export";

		usb_power {
			gpio-export,name = "usb_power";
			gpio-export,output = <1>;
			gpios = <&pio 52 GPIO_ACTIVE_HIGH>;
		};

		typec_power {
			gpio-export,name = "typec_power";
			gpio-export,output = <1>;
			gpios = <&pio 53 GPIO_ACTIVE_HIGH>;
		};
	};

	fan: pwm-fan {
		compatible = "pwm-fan";
		#cooling-cells = <2>;
		#thermal-sensor-cells = <1>;
		/* duty 255 (constant-high) stalls this fan, so cap the top level below it */
		cooling-levels = <0 80 150 240>;
		pwms = <&pwm 0 50000>;
		fan-supply = <&reg_fan_3p3v>;
		interrupt-parent = <&pio>;
		interrupts = <21 IRQ_TYPE_EDGE_FALLING>;
		pulses-per-revolution = <2>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 3 50000>;
		brightness-levels = <0 16 32 48 64 80 96 112 128 144 160 176 192 208 224 255>;
		default-brightness-level = <12>;
	};

	i2c_sfp: i2c-gpio {
		compatible = "i2c-gpio";
		scl-gpios = <&pio 69 GPIO_ACTIVE_HIGH>;
		sda-gpios = <&pio 70 GPIO_ACTIVE_HIGH>;
		i2c-gpio,delay-us = <5>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	sfp_yt9224: sfp {
		compatible = "sff,sfp";
		i2c-bus = <&i2c_sfp>;
		mod-def0-gpios = <&pio 82 GPIO_ACTIVE_LOW>;
		los-gpios = <&pio 81 GPIO_ACTIVE_HIGH>;
		tx-fault-gpios = <&pio 37 GPIO_ACTIVE_HIGH>;
		tx-disable-gpios = <&pio 36 GPIO_ACTIVE_HIGH>;
		rate-select0-gpios = <&pio 83 GPIO_ACTIVE_HIGH>;
		rate-select1-gpios = <&pio 80 GPIO_ACTIVE_HIGH>;
		maximum-power-milliwatt = <3000>;
	};
};

&cpu0 {
	proc-supply = <&rt5190_buck3>;
};

&cpu1 {
	proc-supply = <&rt5190_buck3>;
};

&cpu2 {
	proc-supply = <&rt5190_buck3>;
};

&cpu3 {
	proc-supply = <&rt5190_buck3>;
};

&cci {
	proc-supply = <&rt5190_buck3>;
};

&cpu_thermal {
	/delete-node/cooling-maps;
	/delete-node/trips;

	trips {
		cpu_trip_crit: crit {
			temperature = <125000>;
			hysteresis = <2000>;
			type = "critical";
		};

		cpu_trip_hot: hot {
			temperature = <120000>;
			hysteresis = <2000>;
			type = "hot";
		};

		cpu_trip_active_high: active-high {
			temperature = <110000>;
			hysteresis = <2000>;
			type = "active";
		};

		cpu_trip_active_med: active-med {
			temperature = <80000>;
			hysteresis = <2000>;
			type = "active";
		};

		cpu_trip_active_low: active-low {
			temperature = <60000>;
			hysteresis = <2000>;
			type = "active";
		};

		cpu_trip_active_silent: active-silent {
			temperature = <40000>;
			hysteresis = <2000>;
			type = "active";
		};
	};

	cooling-maps {
		cpu-active-high {
			cooling-device = <&fan 3 3>;
			trip = <&cpu_trip_active_high>;
		};

		cpu-active-med {
			cooling-device = <&fan 2 2>;
			trip = <&cpu_trip_active_med>;
		};

		cpu-active-low {
			cooling-device = <&fan 1 1>;
			trip = <&cpu_trip_active_low>;
		};

		cpu-active-silent {
			cooling-device = <&fan 0 0>;
			trip = <&cpu_trip_active_silent>;
		};
	};
};

&eth {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio0_pins>;
	status = "okay";
};

&gmac0 {
	nvmem-cells = <&macaddr_ethernet 2>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&gmac1 {
	phy-mode = "usxgmii";
	phy-connection-type = "usxgmii";
	nvmem-cells = <&macaddr_ethernet 1>;
	nvmem-cell-names = "mac-address";
	status = "okay";

	fixed-link {
		speed = <10000>;
		full-duplex;
		pause;
	};
};

&usxgmiisys1 {
	mediatek,force-fixed-10g;
};

&gmac2 {
	phy-mode = "usxgmii";
	phy-connection-type = "usxgmii";
	phy = <&phy0>;
	openwrt,netdev-name = "wan";
	nvmem-cells = <&macaddr_ethernet 0>;
	nvmem-cell-names = "mac-address";
	managed = "in-band-status";
	status = "okay";
};

&switch {
	status = "okay";

	dsa,member = <0 0>;

	ports {
		port@0 {
			label = "lan6";
		};

		port@1 {
			label = "lan7";
		};

		port@2 {
			label = "lan8";
		};

		port@3 {
			label = "lan9";
		};
	};
};

&mdio_bus {
	clock-frequency = <10500000>;

	phy0: ethernet-phy@0 {
		/* external multi-gig PHY (c45) */
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0>;

		reset-gpios = <&pio 1 GPIO_ACTIVE_LOW>;
		reset-assert-us = <100000>;
		reset-deassert-us = <300000>;
	};

	switch@1d {
		compatible = "motorcomm,yt9224";
		reg = <0x1d>;

		dsa,member = <1 0>;

		reset-gpios = <&pio 0 GPIO_ACTIVE_LOW>;
		reset-assert-us = <50000>;
		reset-deassert-us = <200000>;
		interrupt-parent = <&pio>;
		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * The driver puts the four integral GbE PHYs on ports
			 * 4 to 7 and leaves ports 0 and 8 as serdes, which is
			 * what internal_mask 0x1f1 and yt922x_dsa_phylink_get_caps()
			 * describe. The vendor tree numbered the same sockets
			 * 0 to 3, so do not copy that map here.
			 */
			port@4 {
				reg = <4>;
				label = "lan2";
				phy-mode = "internal";
				phy-handle = <&yt8824_phy4>;
			};

			port@5 {
				reg = <5>;
				label = "lan3";
				phy-mode = "internal";
				phy-handle = <&yt8824_phy5>;
			};

			port@6 {
				reg = <6>;
				label = "lan4";
				phy-mode = "internal";
				phy-handle = <&yt8824_phy6>;
			};

			port@7 {
				reg = <7>;
				label = "lan5";
				phy-mode = "internal";
				phy-handle = <&yt8824_phy7>;
			};

			port@0 {
				reg = <0>;
				label = "sfp";
				phy-mode = "10gbase-r";
				managed = "in-band-status";
				sfp = <&sfp_yt9224>;
			};

			port@8 {
				reg = <8>;
				label = "cpu";
				ethernet = <&gmac1>;
				dsa-tag-protocol = "yt922x_4b";
				phy-mode = "usxgmii";

				fixed-link {
					speed = <10000>;
					full-duplex;
					pause;
				};
			};
		};

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-phy-package@4 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <4>;
				motorcomm,interface-mode = "internal";

				yt8824_phy4: ethernet-phy@4 {
					reg = <4>;
				};

				yt8824_phy5: ethernet-phy@5 {
					reg = <5>;
				};

				yt8824_phy6: ethernet-phy@6 {
					reg = <6>;
				};

				yt8824_phy7: ethernet-phy@7 {
					reg = <7>;
				};
			};
		};
	};
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	status = "okay";

	rt5190a_64: rt5190a@64 {
		compatible = "richtek,rt5190a";
		reg = <0x64>;
		vin2-supply = <&rt5190_buck1>;
		vin3-supply = <&rt5190_buck1>;
		vin4-supply = <&rt5190_buck1>;

		regulators {
			rt5190_buck1: buck1 {
				regulator-name = "rt5190a-buck1";
				regulator-min-microvolt = <5090000>;
				regulator-max-microvolt = <5090000>;
				regulator-allowed-modes =
					<RT5190A_OPMODE_AUTO RT5190A_OPMODE_FPWM>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck2 {
				regulator-name = "vcore";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <1400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			rt5190_buck3: buck3 {
				regulator-name = "vproc";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <1400000>;
				regulator-boot-on;
			};

			buck4 {
				regulator-name = "rt5190a-buck4";
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-allowed-modes =
					<RT5190A_OPMODE_AUTO RT5190A_OPMODE_FPWM>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo {
				regulator-name = "rt5190a-ldo";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	status = "okay";

	touchscreen@58 {
		compatible = "hynitron,cst3530";
		reg = <0x58>;

		interrupt-parent = <&pio>;
		interrupts = <32 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pio 34 GPIO_ACTIVE_LOW>;

		touchscreen-size-x = <240>;
		touchscreen-size-y = <320>;
		touchscreen-swapped-x-y;
		touchscreen-inverted-y;
	};
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_emmc_51>;
	pinctrl-1 = <&mmc0_pins_emmc_51>;
	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;
	non-removable;
	no-sd;
	no-sdio;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

		block {
			compatible = "block-device";

			partitions {
				emmc_rootfs: block-partition-rootfs {
					partname = "rootfs";
				};

				block-partition-factory {
					partname = "factory";

					nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <1>;
						#size-cells = <1>;

						eeprom_factory_0: eeprom@0 {
							reg = <0x0 0x1e00>;
						};

						macaddr_ethernet: macaddr@4000 {
							compatible = "mac-base";
							reg = <0x4000 0x6>;
							#nvmem-cell-cells = <1>;
						};

						macaddr_wifi: macaddr@4006 {
							compatible = "mac-base";
							reg = <0x4006 0x6>;
							#nvmem-cell-cells = <1>;
						};
					};
				};
			};
		};
	};
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_pins>;
	status = "okay";

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;

		mt7996@0,0 {
			reg = <0x0000 0 0 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			nvmem-cells = <&eeprom_factory_0>;
			nvmem-cell-names = "eeprom";

			band@0 {
				/* 2.4 GHz */
				reg = <0>;
				nvmem-cells = <&macaddr_wifi 0>;
				nvmem-cell-names = "mac-address";
			};

			band@1 {
				/* 5 GHz */
				reg = <1>;
				nvmem-cells = <&macaddr_wifi 1>;
				nvmem-cell-names = "mac-address";
			};

			band@2 {
				/* 6 GHz */
				reg = <2>;
				nvmem-cells = <&macaddr_wifi 2>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};

&pcie1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_pins>;
	status = "okay";
};

&pcie2 {
	status = "disabled";
};

&pcie3 {
	status = "disabled";
};

&pio {
	i2c0_pins: i2c0-g0-pins {
		mux {
			function = "i2c";
			groups = "i2c0_1";
		};
	};

	i2c1_pins: i2c1-pins {
		mux {
			function = "i2c";
			groups = "i2c1_0";
		};
	};

	mdio0_pins: mdio0-pins {
		mux {
			function = "eth";
			groups = "mdc_mdio0";
		};

		conf {
			groups = "mdc_mdio0";
			drive-strength = <MTK_DRIVE_8mA>;
		};
	};

	mmc0_pins_emmc_51: mmc0-emmc-51-pins {
		mux {
			function = "flash";
			groups = "emmc_51";
		};
	};

	pcie0_pins: pcie0-pins {
		mux {
			function = "pcie";
			groups = "pcie_2l_0_pereset", "pcie_clk_req_n0_0",
				 "pcie_wake_n0_0";
		};
	};

	pcie1_pins: pcie1-pins {
		mux {
			function = "pcie";
			groups = "pcie_2l_1_pereset", "pcie_clk_req_n1",
				 "pcie_wake_n1_0";
		};
	};

	pwm_pins: pwm-pins {
		mux {
			function = "pwm";
			groups = "pwm0";
		};
	};

	pwm3_pins: pwm3-pins {
		mux {
			function = "pwm";
			groups = "pwm3_0";
		};
	};

	spi1_pins: spi1-pins {
		mux {
			function = "spi";
			groups = "spi1";
		};
	};
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_pins>, <&pwm3_pins>;
	status = "okay";
};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;
	status = "okay";

	display@0 {
		compatible = "glinet,gl-be14000-panel", "panel-mipi-dbi-spi";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <0>;
		spi-cpol;
		spi-cpha;

		dc-gpios = <&pio 62 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pio 68 GPIO_ACTIVE_HIGH>;
		te-gpios = <&pio 35 GPIO_ACTIVE_HIGH>;
		write-only;

		format = "r5g6b5";
		backlight = <&backlight>;

		/* physical dimensions are approximate; verify against the panel */
		width-mm = <41>;
		height-mm = <31>;

		panel-timing {
			hactive = <320>;
			vactive = <240>;
			hback-porch = <0>;
			vback-porch = <0>;
			clock-frequency = <0>;
			hfront-porch = <0>;
			hsync-len = <0>;
			vfront-porch = <0>;
			vsync-len = <0>;
		};
	};
};

&ssusb0 {
	status = "okay";
};

&ssusb1 {
	status = "okay";
};

&tphy {
	status = "okay";
};

&xsphy {
	status = "okay";
};

&serial0 {
	status = "okay";
};

&watchdog {
	status = "okay";
};
