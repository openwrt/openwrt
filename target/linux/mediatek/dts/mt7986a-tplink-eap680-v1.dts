/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/mt65xx.h>

#include "mt7986a.dtsi"

/ {
	compatible = "tplink,eap680-v1", "mediatek,mt7986a";
	model = "TP-Link EAP680 v1";

	aliases {
		serial0 = &uart0;
		ethernet0 = &gmac1;
		label-mac-device = &gmac1;
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_status;
		led-upgrade = &led_status;
	};

	/*
	 * The stock TP-Link U-Boot unconditionally passes
	 * "ubi.mtd=rootfs root=/dev/ubiblock0_0" (or rootfs_1) on the kernel
	 * command line, pointing at fixed UBI volume ids. Override it so the
	 * rootfs is found by UBI volume name instead.
	 */
	chosen {
		bootargs-override = "console=ttyS0,115200n8 earlycon=uart8250,mmio32,0x11002000";
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		reg = <0 0x40000000 0 0x40000000>;
		device_type = "memory";
	};

	/*
	 * TI CC2652-class BLE / 802.15.4 co-processor. Reset and the ROM
	 * bootloader backdoor, per stock /etc/EAP680_1.0/gpio.conf. Both idle
	 * high; the backdoor is active low (CCFG BL_CONFIG selects DIO19,
	 * BL_LEVEL = 0), so pulling it low across a reset pulse drops the part
	 * into its serial bootloader on uart1.
	 */
	gpio-export {
		compatible = "gpio-export";

		cc2652_backdoor {
			gpio-export,name = "cc2652_backdoor";
			gpio-export,output = <1>;
			gpios = <&pio 44 GPIO_ACTIVE_HIGH>;
		};

		cc2652_reset {
			gpio-export,name = "cc2652_reset";
			gpio-export,output = <1>;
			gpios = <&pio 7 GPIO_ACTIVE_HIGH>;
		};
	};

	keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			gpios = <&pio 9 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status: led-0 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&pio 11 GPIO_ACTIVE_HIGH>;
		};
	};
};

&auxadc {
	status = "okay";
};

&crypto {
	status = "okay";
};

&eth {
	status = "okay";

	gmac1: mac@1 {
		compatible = "mediatek,eth-mac";
		reg = <1>;
		phy-handle = <&phy5>;
		phy-mode = "2500base-x";
	};

	mdio-bus {
		#address-cells = <1>;
		#size-cells = <0>;
		reset-gpios = <&pio 10 GPIO_ACTIVE_LOW>;
		reset-delay-us = <600>;
		reset-post-delay-us = <20000>;

		/* MaxLinear GPY211C 2.5G PHY on the single PoE ethernet port */
		phy5: ethernet-phy@5 {
			compatible = "maxlinear,gpy211", "ethernet-phy-ieee802.3-c45";
			reg = <5>;
			phy-mode = "2500base-x";
		};
	};
};

&pio {
	spi_flash_pins: spi-flash-pins-33-to-38 {
		mux {
			function = "spi";
			groups = "spi0", "spi0_wp_hold";
		};
		conf-pu {
			pins = "SPI2_CS", "SPI2_HOLD", "SPI2_WP";
			drive-strength = <MTK_DRIVE_8mA>;
			mediatek,pull-up-adv = <MTK_PUPD_SET_R1R0_11>;
		};
		conf-pd {
			pins = "SPI2_CLK", "SPI2_MOSI", "SPI2_MISO";
			drive-strength = <MTK_DRIVE_8mA>;
			mediatek,pull-down-adv = <MTK_PUPD_SET_R1R0_11>;
		};
	};

	uart1_pins: uart1-pins {
		mux {
			function = "uart";
			groups = "uart1_2_rx_tx", "uart1_2_cts_rts";
		};
	};

	wf_2g_5g_pins: wf_2g_5g-pins {
		mux {
			function = "wifi";
			groups = "wf_2g", "wf_5g";
		};
		conf {
			pins = "WF0_HB1", "WF0_HB2", "WF0_HB3", "WF0_HB4",
			       "WF0_HB0", "WF0_HB0_B", "WF0_HB5", "WF0_HB6",
			       "WF0_HB7", "WF0_HB8", "WF0_HB9", "WF0_HB10",
			       "WF0_TOP_CLK", "WF0_TOP_DATA", "WF1_HB1",
			       "WF1_HB2", "WF1_HB3", "WF1_HB4", "WF1_HB0",
			       "WF1_HB5", "WF1_HB6", "WF1_HB7", "WF1_HB8",
			       "WF1_TOP_CLK", "WF1_TOP_DATA";
			drive-strength = <MTK_DRIVE_4mA>;
		};
	};
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi_flash_pins>;
	/*
	 * Stock places the SPI-NAND at chip-select 1. The controller must
	 * advertise two chip-selects or mtk-spi rejects flash@1
	 * ("cs1 >= max 1"), leaving /proc/mtd empty.
	 */
	cs-gpios = <0>, <0>;
	status = "okay";

	/*
	 * The flash is managed by MediaTek NMBM, created by the stock
	 * firmware; attach to the existing mapping table.
	 */
	flash@1 {
		compatible = "spi-nand";
		reg = <1>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <52000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;
		mediatek,nmbm;
		mediatek,bmt-max-ratio = <1>;
		mediatek,bmt-max-reserved-blocks = <64>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				reg = <0x0 0x100000>;
				label = "BL2";
				read-only;
			};

			partition@100000 {
				reg = <0x100000 0x100000>;
				label = "boot-config";
				read-only;
			};

			partition@200000 {
				reg = <0x200000 0x100000>;
				label = "boot-config1";
				read-only;
			};

			partition@300000 {
				reg = <0x300000 0x100000>;
				label = "u-boot-env";
			};

			partition@400000 {
				reg = <0x400000 0x200000>;
				label = "FIP0";
				read-only;
			};

			partition@600000 {
				reg = <0x600000 0x200000>;
				label = "FIP1";
				read-only;
			};

			partition@800000 {
				reg = <0x800000 0x100000>;
				label = "oops";
			};

			/* stock firmware slot A: OpenWrt lives here */
			partition@900000 {
				reg = <0x900000 0x2680000>;
				label = "ubi";
			};

			/* stock firmware slot B: left untouched for revert */
			partition@2f80000 {
				reg = <0x2f80000 0x2680000>;
				label = "ubi1";
				read-only;
			};

			/* UBIFS holding the radio caldata and default-mac */
			partition@5600000 {
				reg = <0x5600000 0x800000>;
				label = "factory_data";
				read-only;
			};

			partition@5e00000 {
				reg = <0x5e00000 0xc00000>;
				label = "runtime_data";
				read-only;
			};

			partition@6a00000 {
				reg = <0x6a00000 0x800000>;
				label = "backup_data";
				read-only;
			};

			/*
			 * Stock declares 0x800000, but NMBM reserves the last 64
			 * blocks, so the visible device ends at 0x7800000 and the
			 * partition would be truncated.
			 */
			partition@7200000 {
				reg = <0x7200000 0x600000>;
				label = "runtime_backup";
				read-only;
			};
		};
	};
};

&trng {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>;
	status = "okay";
};

&watchdog {
	status = "okay";
};

&wifi {
	pinctrl-names = "default";
	pinctrl-0 = <&wf_2g_5g_pins>;
	status = "okay";
};
