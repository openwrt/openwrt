#include "mt7981b-keenetic-kn-1012.dtsi"

/ {
	model = "Keenetic KN-1012";
	compatible = "keenetic,kn-1012", "mediatek,mt7981";
};

&switch {
	ports {
		port@5 {
			reg = <5>;
			label = "lan4";
			phy-mode = "2500base-x";
			phy-handle = <&phy13>;
		};
	};
};
