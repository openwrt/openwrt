#include "mt7988d-tplink-tl-7dr72xx.dtsi"

&gmac0 {
	nvmem-cells = <&macaddr_config_1c 0>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&gmac1 {
	nvmem-cells = <&macaddr_config_1c 1>;
	nvmem-cell-names = "mac-address";
};

&gsw_phy0_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	status = "okay";
};

&gsw_phy1_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	status = "okay";
};

&gsw_phy2_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	status = "okay";
};

&gsw_phy3_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	status = "okay";
};

&gsw_port0 {
	label = "lan1";
};

&gsw_port1 {
	label = "lan2";
};

&gsw_port2 {
	label = "lan3";
};

&gsw_port3 {
	label = "lan4";
};

&i2p5gbe_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_WAN;
};
