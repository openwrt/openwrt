/dts-v1/;

#include "mt7981a-ubnt-unifi-6-plus.dtsi"

/ {
	model = "Ubiquiti UniFi 6 Plus (U-Boot mod)";
	compatible = "ubnt,unifi-6-plus-ubootmod", "mediatek,mt7981";

	aliases {
		/*
		 * U-Boot's fdt_fixup_ethernet() writes its env ethaddr into
		 * the node this alias points at, giving Linux a MAC that is
		 * stable across boots (NET_RANDOM_ETHADDR generates one and
		 * the first saveenv persists it; set ethaddr manually to use
		 * a specific address).
		 */
		ethernet0 = &gmac1;
	};

	chosen {
		rootdisk = <&emmc_rootdisk>;
		bootargs = "earlycon=uart8250,mmio32,0x11002000 console=ttyS0,115200n8 root=/dev/fit0 rootwait";
	};
};

&spi2 {
	flash@0 {
		partitions {
			/*
			 * Backup copy of the Wi-Fi calibration blob (EEPROM +
			 * pre-cal). The primary copy lives in the eMMC
			 * 'factory' GPT partition (see &mmc0); U-Boot's
			 * boot_tftp_write_factory writes both, and
			 * factory_restore_emmc recovers the eMMC copy from
			 * here. The stock UBNT board data (MACs) is not used -
			 * both ethernet and Wi-Fi MAC addresses are randomly
			 * generated at boot.
			 */
			partition@0 {
				label = "factory-backup";
				reg = <0x00000 0x80000>;
				read-only;
			};
		};
	};
};

&mmc0 {
	cap-mmc-hw-reset;
	no-sd;
	no-sdio;

	card@0 {
		block {
			partitions {
				emmc_rootdisk: block-partition-production {
					partname = "production";
				};
			};
		};
	};
};
