/dts-v1/;

#include "mt7981b-zyxel-common.dtsi"

/ {
	model = "Zyxel WAX300H";
	compatible = "zyxel,wax300h", "mediatek,mt7981";

	aliases {
		label-mac-device = &uplink;
	};
};

&eth {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;

	status = "okay";

	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "2500base-x";

		nvmem-cells = <&macaddr_mrd_1fff8 0>;
		nvmem-cell-names = "mac-address";

		fixed-link {
			speed = <2500>;
			full-duplex;
			pause;
		};
	};
};

&mdio_bus {
	switch@1f {
		compatible = "mediatek,mt7531";
		reg = <31>;
		reset-gpios = <&pio 39 GPIO_ACTIVE_HIGH>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "lan3";

				nvmem-cells = <&macaddr_mrd_1fff8 3>;
				nvmem-cell-names = "mac-address";
			};

			port@1 {
				reg = <1>;
				label = "lan2";

				nvmem-cells = <&macaddr_mrd_1fff8 2>;
				nvmem-cell-names = "mac-address";
			};

			/* PoE PSE */
			port@2 {
				reg = <2>;
				label = "lan1";

				nvmem-cells = <&macaddr_mrd_1fff8 1>;
				nvmem-cell-names = "mac-address";
			};

			/* PoE PD */
			uplink: port@3 {
				reg = <3>;
				label = "uplink";

				nvmem-cells = <&macaddr_mrd_1fff8 0>;
				nvmem-cell-names = "mac-address";
			};

			port@6 {
				reg = <6>;
				ethernet = <&gmac0>;
				phy-mode = "2500base-x";

				fixed-link {
					speed = <2500>;
					full-duplex;
					pause;
				};
			};
		};
	};
};

&wifi0 { nvmem-cells = <&macaddr_mrd_1fff8 4>; };
&wifi1 { nvmem-cells = <&macaddr_mrd_1fff8 5>; };
