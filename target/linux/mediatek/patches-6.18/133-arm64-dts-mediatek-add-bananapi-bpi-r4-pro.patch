+			reg = <1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			chan-sel-gpios = <&pio 3 GPIO_ACTIVE_HIGH>;
+			mod-def0-gpios = <&pio 1 GPIO_ACTIVE_LOW>;
