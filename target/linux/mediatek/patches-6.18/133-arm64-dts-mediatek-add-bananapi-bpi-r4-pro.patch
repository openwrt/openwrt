--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-4e-sfp.dts
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/*
+ * Device Tree for the Banana Pi BPI-R4 Pro 4E-SFP variant.
+ *
+ * Copyright (C) 2025 MediaTek Inc.
+ * Author: Frank Wunderlich <frank-w@public-files.de>
+ *
+ * Like the 4E, the 10G copper PHYs (phy24/phy28) and the SFP/PHY combo
+ * muxes are not populated.  WAN is the SoC SFP cage (sfp2) on gmac1,
+ * and switch port 12 goes straight to the lan SFP cage (sfp1).
+ */
+
+/dts-v1/;
+
+#include "mt7988a-bananapi-bpi-r4-pro.dtsi"
+
+/ {
+	model = "Bananapi BPI-R4 Pro 4E-SFP";
+	compatible = "bananapi,bpi-r4-pro-4e-sfp", "bananapi,bpi-r4-pro",
+		     "mediatek,mt7988a";
+};
+
+&phy24 {
+	status = "disabled";
+};
+
+&phy28 {
+	status = "disabled";
+};
+
+&mux1 {
+	status = "disabled";
+};
+
+&mux2 {
+	status = "disabled";
+};
+
+&ds_mux0 {
+	status = "disabled";
+};
+
+&int_2p5g_phy {
+	status = "disabled";
+};
+
+&i2p5gbe_led0 {
+	status = "disabled";
+	color = <LED_COLOR_ID_GREEN>;
+};
+
+&i2p5gbe_led1 {
+	status = "disabled";
+	color = <LED_COLOR_ID_AMBER>;
+};
+
+&gmac1 {
+	phy-mode = "10gbase-r";
+	phy-connection-type = "10gbase-r";
+	managed = "in-band-status";
+	sfp = <&sfp2>;
+
+	/delete-property/ phy-handle;
+	/delete-property/ mac-type;
+};
+
+&port12 {
+	label = "lan_sfp";
+	phy-mode = "10gbase-r";
+	phy-connection-type = "10gbase-r";
+	managed = "in-band-status";
+	sfp = <&sfp1>;
+
+	/delete-property/ compatible;
+	/delete-property/ phy-handle;
+	/delete-property/ aeon,skip-sds-eth-wait;
+};
+
+&gsw_port2 {
+	status = "okay";
+	label = "lan1";
+};
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-4e.dts
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/*
+ * Device Tree for the Banana Pi BPI-R4 Pro 4E variant.
+ *
+ * Adapts the shared BPI-R4 Pro base to the 4E hardware: the 10G copper
+ * PHYs (phy24/phy28) and the SFP/PHY combo muxes are not populated, WAN
+ * is served by the internal 2.5G PHY.  lan1 (GSW P2) and the lan
+ * SFP cage (switch port 12) are populated on both 4E variants; only
+ * the WAN port differs.
+ */
+
+/dts-v1/;
+
+#include "mt7988a-bananapi-bpi-r4-pro.dtsi"
+
+/ {
+	model = "Bananapi BPI-R4 Pro 4E";
+	compatible = "bananapi,bpi-r4-pro-4e", "bananapi,bpi-r4-pro",
+		     "mediatek,mt7988a";
+};
+
+&phy24 {
+	status = "disabled";
+};
+
+&phy28 {
+	status = "disabled";
+};
+
+&mux1 {
+	status = "disabled";
+};
+
+&mux2 {
+	status = "disabled";
+};
+
+&ds_mux0 {
+	status = "disabled";
+};
+
+&int_2p5g_phy {
+	status = "okay";
+};
+
+&i2p5gbe_led0 {
+	status = "okay";
+	color = <LED_COLOR_ID_GREEN>;
+};
+
+&i2p5gbe_led1 {
+	status = "okay";
+	color = <LED_COLOR_ID_AMBER>;
+};
+
+&gmac1 {
+	phy-mode = "internal";
+	phy-connection-type = "internal";
+	phy-handle = <&int_2p5g_phy>;
+
+	/delete-property/ mac-type;
+	/delete-property/ managed;
+};
+
+&port12 {
+	label = "lan_sfp";
+	phy-mode = "10gbase-r";
+	managed = "in-band-status";
+	sfp = <&sfp1>;
+
+	/delete-property/ compatible;
+	/delete-property/ phy-handle;
+	/delete-property/ aeon,skip-sds-eth-wait;
+};
+
+&gsw_port2 {
+	status = "okay";
+	label = "lan1";
+};
