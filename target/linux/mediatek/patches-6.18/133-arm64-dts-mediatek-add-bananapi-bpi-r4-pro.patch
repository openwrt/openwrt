--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-wifi-mt7996a.dtso
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/dts-v1/;
+/plugin/;
+
+/*
+ * The R4 Pro board docs show GPIO4 as the MaxLinear switch reset line, while
+ * the mini-PCIe 12V rail is handled off-SoC. Use the same Factory-partition
+ * calibration data as the legacy mediatek,mtd-eeprom property.
+ */
+
+/ {
+	compatible = "bananapi,bpi-r4-pro-4e-sfp",
+		     "bananapi,bpi-r4-pro-4e",
+		     "bananapi,bpi-r4-pro",
+		     "mediatek,mt7988a";
+
+	fragment@0 {
+		target = <&pcie0>;
+		__overlay__ {
+			#address-cells = <3>;
+			#size-cells = <2>;
+
+			pcie@0,0 {
+				#address-cells = <3>;
+				#size-cells = <2>;
+				reg = <0x0000 0 0 0 0>;
+
+				mt7996@0,0 {
+					compatible = "mediatek,mt76";
+					reg = <0x0000 0 0 0 0>;
+					/delete-property/ mediatek,mtd-eeprom;
+					nvmem-cells = <&wifi_eeprom_data>;
+					nvmem-cell-names = "eeprom";
+				};
+			};
+		};
+	};
+
+	fragment@1 {
+		target = <&pcie1>;
+		__overlay__ {
+			#address-cells = <3>;
+			#size-cells = <2>;
+
+			pcie@0,0 {
+				#address-cells = <3>;
+				#size-cells = <2>;
+				reg = <0x0000 0 0 0 0>;
+
+				mt7996@0,0 {
+					compatible = "mediatek,mt76";
+					reg = <0x0000 0 0 0 0>;
+				};
+			};
+		};
+	};
+};
