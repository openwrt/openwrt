+#if IS_ENABLED(CONFIG_PHY_MTK_XFI_TPHY)
+bool mtk_xfi_tphy_is_ctle_valid(struct phy *phy);
+#else
+static inline bool mtk_xfi_tphy_is_ctle_valid(struct phy *phy)
+{
+	/* Default to true so the PCS doesn't hang if the PHY driver is missing */
+	return true;
+}
+#endif
