+	if (linkmode_test_bit(ETHTOOL_LINK_MODE_5000baseT_Full_BIT,
+			      advertising))
+		return adv | MDIO_USXGMII_5000FULL;
+
+	if (linkmode_test_bit(ETHTOOL_LINK_MODE_2500baseT_Full_BIT,
+			      advertising) ||
+	    linkmode_test_bit(ETHTOOL_LINK_MODE_2500baseX_Full_BIT,
+			      advertising))
+		return adv | MDIO_USXGMII_2500FULL;
+
+	if (linkmode_test_bit(ETHTOOL_LINK_MODE_1000baseT_Full_BIT,
+			      advertising) ||
+	    linkmode_test_bit(ETHTOOL_LINK_MODE_1000baseX_Full_BIT,
+			      advertising) ||
+	    linkmode_test_bit(ETHTOOL_LINK_MODE_1000baseKX_Full_BIT,
+			      advertising))
+		return adv | MDIO_USXGMII_1000FULL;
+
+	if (linkmode_test_bit(ETHTOOL_LINK_MODE_100baseT_Full_BIT,
+			      advertising))
+		return adv | MDIO_USXGMII_100FULL;
+
+	if (linkmode_test_bit(ETHTOOL_LINK_MODE_10baseT_Full_BIT,
+			      advertising))
+		return adv | MDIO_USXGMII_10FULL;
+
+	if (linkmode_empty(advertising))
+		return adv | MDIO_USXGMII_10GFULL;
+
+	return -EINVAL;
+}
