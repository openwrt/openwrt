+static unsigned int mtk_pcs_usxgmii_inband_caps(struct phylink_pcs *pcs,
+						phy_interface_t interface)
+{
+		/* USXGMII *protocol* carries inband AN ordered sets even when
+		 * no user data is flowing. With USXGMII_AN_ENABLE armed in
+		 * pcs_config(), the SoC PCS continuously emits 16-bit AN
+		 * config words on the line — which the partner PHY's host-PCS
+		 * sees as a live data path. The AS21xxx 1.9.2 firmware's
+		 * SYS_DPC_SDS_WAIT_DATA_MODE state requires this constant
+		 * signal to declare the data path up; without it the firmware
+		 * times out into RESTART_AN within milliseconds.
+		 *
+		 * That wire-side carrier is governed by the USXGMII_AN_ENABLE
+		 * register bit, which pcs_config() arms *unconditionally* for
+		 * USXGMII regardless of the resolved neg_mode. So the carrier
+		 * is preserved no matter what mode phylink resolves to.
+		 *
+		 * phylink's neg_mode is a *link-state* concern (whether to
+		 * read link state from the PCS via inband AN, or from a PHY
+		 * interrupt) — it does not control the wire-protocol-level AN
+		 * ordered sets. Report both LINK_INBAND_DISABLE and
+		 * LINK_INBAND_ENABLE here so phylink can resolve cleanly for
+		 * either DT shape:
+		 *   - DT with managed="in-band-status"  -> INBAND_ENABLED
+		 *   - DT with phy-managed (default)      -> OUTBAND
+		 * On BPI-R4 Pro eth1 the DT uses phy-managed (PHY drives link
+		 * state); reporting ENABLE-only would make phylink reject the
+		 * configuration with "firmware wants phy mode, but PCS
+		 * requires inband", which is what you'll see if you revert
+		 * this without also adding managed="in-band-status" to the DT.
+		 *
+		 * The AS21xxx-side bugs that originally masked this analysis
+		 * (eth_speed/restart_an race, and aeon_sds_wait_eth_cfg(0,...)
+		 * skipping the SDS-eth handshake) are fixed in as21xxx.c.
+		 */
+	switch (interface) {
+	case PHY_INTERFACE_MODE_10GBASER:
+	case PHY_INTERFACE_MODE_5GBASER:
+	case PHY_INTERFACE_MODE_10GKR:
+		return LINK_INBAND_DISABLE;
+	case PHY_INTERFACE_MODE_USXGMII:
+		return LINK_INBAND_ENABLE;
+	case PHY_INTERFACE_MODE_2500BASEX:
+	case PHY_INTERFACE_MODE_1000BASEX:
+		return LINK_INBAND_DISABLE | LINK_INBAND_ENABLE;
+	default:
+		return 0;
+	}
+}
