From: John Crispin <john@phrozen.org>
Subject: [PATCH] Input: add driver for Hynitron CST3530

The Hynitron CST3530 is a single touch controller on I2C. It shares the
vendor and the reset-then-interrupt flow with the cst3xx parts that
hynitron_cstxxx.c handles, but not the wire protocol:

  - register addresses are 32 bits wide and big endian. A two byte
    address, as hynitron_cstxxx.c sends, reads unrelated memory
  - a touch report is one 9 byte frame at 0xd0070000, with a 16 bit
    additive checksum seeded with 0x55 in its first two bytes
  - a frame is acknowledged by writing 0xd00002ab
  - the cst3xx firmware information registers read back as zero

The driver reports through a single multitouch slot with INPUT_MT_DIRECT,
which also provides BTN_TOUCH, ABS_X, ABS_Y and INPUT_PROP_DIRECT. A
frame that fails to read, fails its checksum or lies outside the native
240x320 range is reported as a release, so a touch cannot stay pressed.
Orientation comes from the touchscreen-* device tree properties only.

Signed-off-by: John Crispin <john@phrozen.org>
---
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -487,6 +487,18 @@ config TOUCHSCREEN_HYNITRON_CST816X
 	  To compile this driver as a module, choose M here: the
 	  module will be called hynitron-cst816x.
 
+config TOUCHSCREEN_HYNITRON_CST3530
+	tristate "Hynitron CST3530 touchscreen"
+	depends on I2C
+	help
+	  Say Y here if you have a touchscreen using a Hynitron
+	  CST3530 touchscreen controller.
+
+	  If unsure, say N.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called hynitron-cst3530.
+
 config TOUCHSCREEN_ILI210X
 	tristate "Ilitek ILI210X based touchscreen"
 	depends on I2C
--- a/drivers/input/touchscreen/Makefile
+++ b/drivers/input/touchscreen/Makefile
@@ -52,6 +52,7 @@ obj-$(CONFIG_TOUCHSCREEN_HIDEEP)	+= hide
 obj-$(CONFIG_TOUCHSCREEN_HIMAX_HX852X)	+= himax_hx852x.o
 obj-$(CONFIG_TOUCHSCREEN_HYNITRON_CSTXXX)	+= hynitron_cstxxx.o
 obj-$(CONFIG_TOUCHSCREEN_HYNITRON_CST816X)	+= hynitron-cst816x.o
+obj-$(CONFIG_TOUCHSCREEN_HYNITRON_CST3530)	+= hynitron-cst3530.o
 obj-$(CONFIG_TOUCHSCREEN_ILI210X)	+= ili210x.o
 obj-$(CONFIG_TOUCHSCREEN_ILITEK)	+= ilitek_ts_i2c.o
 obj-$(CONFIG_TOUCHSCREEN_IMAGIS)	+= imagis.o
--- /dev/null
+++ b/drivers/input/touchscreen/hynitron-cst3530.c
@@ -0,0 +1,224 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Driver for I2C connected Hynitron CST3530 touchscreen controllers
+ *
+ * Based on the driver supplied by GL.iNet.
+ */
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/unaligned.h>
+
+#define CST3530_FRAME_REG	0xd0070000
+#define CST3530_FRAME_END_REG	0xd00002ab
+#define CST3530_FRAME_LEN	9
+#define CST3530_CHECKSUM_SEED	0x55
+
+#define CST3530_MAX_X		240
+#define CST3530_MAX_Y		320
+
+struct cst3530_priv {
+	struct i2c_client *client;
+	struct gpio_desc *reset;
+	struct input_dev *input;
+	struct touchscreen_properties prop;
+};
+
+struct cst3530_touch {
+	bool down;
+	unsigned int x;
+	unsigned int y;
+};
+
+static int cst3530_frame_read(struct cst3530_priv *priv, u8 *frame)
+{
+	struct i2c_client *client = priv->client;
+	u8 reg[4];
+	struct i2c_msg xfer[] = {
+		{
+			.addr = client->addr,
+			.len = sizeof(reg),
+			.buf = reg,
+		}, {
+			.addr = client->addr,
+			.flags = I2C_M_RD,
+			.len = CST3530_FRAME_LEN,
+			.buf = frame,
+		},
+	};
+	int rc;
+
+	put_unaligned_be32(CST3530_FRAME_REG, reg);
+
+	rc = i2c_transfer(client->adapter, xfer, ARRAY_SIZE(xfer));
+	if (rc != ARRAY_SIZE(xfer))
+		return rc < 0 ? rc : -EIO;
+
+	return 0;
+}
+
+static int cst3530_frame_end(struct cst3530_priv *priv)
+{
+	u8 reg[4];
+	int rc;
+
+	put_unaligned_be32(CST3530_FRAME_END_REG, reg);
+
+	rc = i2c_master_send(priv->client, reg, sizeof(reg));
+	if (rc != sizeof(reg))
+		return rc < 0 ? rc : -EIO;
+
+	return 0;
+}
+
+static int cst3530_touch_parse(const u8 *frame, struct cst3530_touch *touch)
+{
+	u16 checksum = CST3530_CHECKSUM_SEED + frame[4] + frame[5] + frame[6] +
+		       frame[7] + frame[8];
+
+	if (get_unaligned_le16(frame) != checksum)
+		return -EBADMSG;
+
+	touch->down = frame[8] >> 4;
+	touch->x = frame[4] | (frame[7] & 0x0f) << 8;
+	touch->y = frame[5] | (frame[7] & 0xf0) << 4;
+
+	if (touch->x >= CST3530_MAX_X || touch->y >= CST3530_MAX_Y)
+		return -ERANGE;
+
+	return 0;
+}
+
+static irqreturn_t cst3530_irq(int irq, void *dev_id)
+{
+	struct cst3530_priv *priv = dev_id;
+	struct cst3530_touch touch = { };
+	u8 frame[CST3530_FRAME_LEN];
+	int rc;
+
+	rc = cst3530_frame_read(priv, frame);
+	if (!rc)
+		rc = cst3530_touch_parse(frame, &touch);
+	if (rc) {
+		dev_dbg(&priv->client->dev, "dropped frame: %d\n", rc);
+		touch.down = false;
+	}
+
+	input_mt_slot(priv->input, 0);
+	input_mt_report_slot_state(priv->input, MT_TOOL_FINGER, touch.down);
+	if (touch.down)
+		touchscreen_report_pos(priv->input, &priv->prop,
+				       touch.x, touch.y, true);
+	input_mt_sync_frame(priv->input);
+	input_sync(priv->input);
+
+	cst3530_frame_end(priv);
+
+	return IRQ_HANDLED;
+}
+
+static int cst3530_input_register(struct cst3530_priv *priv)
+{
+	struct device *dev = &priv->client->dev;
+	struct input_dev *input;
+	int rc;
+
+	input = devm_input_allocate_device(dev);
+	if (!input)
+		return -ENOMEM;
+
+	input->name = "Hynitron CST3530 Touchscreen";
+	input->phys = "input/ts";
+	input->id.bustype = BUS_I2C;
+
+	input_set_abs_params(input, ABS_MT_POSITION_X, 0, CST3530_MAX_X - 1, 0, 0);
+	input_set_abs_params(input, ABS_MT_POSITION_Y, 0, CST3530_MAX_Y - 1, 0, 0);
+	touchscreen_parse_properties(input, true, &priv->prop);
+
+	rc = input_mt_init_slots(input, 1, INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (rc)
+		return rc;
+
+	priv->input = input;
+
+	return input_register_device(input);
+}
+
+static void cst3530_reset(struct cst3530_priv *priv)
+{
+	gpiod_set_value_cansleep(priv->reset, 1);
+	msleep(50);
+	gpiod_set_value_cansleep(priv->reset, 0);
+	msleep(100);
+}
+
+static int cst3530_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	u8 frame[CST3530_FRAME_LEN];
+	struct cst3530_priv *priv;
+	int rc;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->client = client;
+
+	priv->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(priv->reset))
+		return dev_err_probe(dev, PTR_ERR(priv->reset),
+				     "failed to request reset gpio\n");
+
+	cst3530_reset(priv);
+
+	rc = cst3530_frame_read(priv, frame);
+	if (rc)
+		return dev_err_probe(dev, rc, "no response from controller\n");
+	cst3530_frame_end(priv);
+
+	rc = cst3530_input_register(priv);
+	if (rc)
+		return dev_err_probe(dev, rc, "failed to register input device\n");
+
+	rc = devm_request_threaded_irq(dev, client->irq, NULL, cst3530_irq,
+				       IRQF_ONESHOT, dev_driver_string(dev), priv);
+	if (rc)
+		return dev_err_probe(dev, rc, "failed to request irq\n");
+
+	return 0;
+}
+
+static const struct i2c_device_id cst3530_id[] = {
+	{ "cst3530" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, cst3530_id);
+
+static const struct of_device_id cst3530_of_match[] = {
+	{ .compatible = "hynitron,cst3530" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cst3530_of_match);
+
+static struct i2c_driver cst3530_driver = {
+	.driver = {
+		.name = "hynitron-cst3530",
+		.of_match_table = cst3530_of_match,
+		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
+	},
+	.id_table = cst3530_id,
+	.probe = cst3530_probe,
+};
+module_i2c_driver(cst3530_driver);
+
+MODULE_AUTHOR("John Crispin <john@phrozen.org>");
+MODULE_DESCRIPTION("Hynitron CST3530 touchscreen driver");
+MODULE_LICENSE("GPL");
