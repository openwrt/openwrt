From c6743063989ca00a2a633f79c41711c93d0c0559 Mon Sep 17 00:00:00 2001
From: Alexander A <st7105@gmail.com>
Date: Thu, 26 Nov 2026 07:36:40 +0300
Subject: net: ethernet: mtk_eth_soc: map MT7986 traffic classes per GMAC

Allow a shared traffic class to select distinct queues on different GMACs.

Signed-off-by: Alexander A <st7105@gmail.com>
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c   | 62 +++++++++++-
 drivers/net/ethernet/mediatek/mtk_eth_soc.h   |  5 +
 .../net/ethernet/mediatek/mtk_ppe_debugfs.c   | 95 +++++++++++++++++++
 .../net/ethernet/mediatek/mtk_ppe_offload.c   |  3 +-
 4 files changed, 163 insertions(+), 2 deletions(-)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -797,6 +797,28 @@
 	return priority & 0xf;
 }
 
+/* A class is shared by a flow; each GMAC can select a different queue. */
+int mtk_hqos_port_queue(struct mtk_eth *eth, int port, u32 priority)
+{
+	int cls = mtk_hqos_priority_queue(eth, priority);
+	u8 mapped;
+
+	if (cls < 0 || port < 0 || port >= MTK_MAX_DEVS)
+		return cls;
+	mapped = READ_ONCE(eth->hqos.port_queue[port][cls]);
+	return mapped ? mapped - 1 : cls;
+}
+
+static u32 mtk_hqos_scheduler_config(struct mtk_eth *eth, unsigned int q, u32 val)
+{
+	u8 scheduler = eth->hqos.scheduler[q];
+
+	if (!scheduler)
+		return val;
+	return (val & ~GENMASK(31, 30)) |
+	       FIELD_PREP(GENMASK(31, 30), scheduler - 1);
+}
+
 static u32 mtk_hqos_decode_rate(u32 val)
 {
 	u32 rate = FIELD_GET(MTK_QTX_SCH_MAX_RATE_MAN, val);
@@ -877,6 +899,7 @@
 	eth->hqos.baseline[idx] = val;
 	val = mtk_hqos_queue_config(val, eth->hqos.rate[idx],
 				    eth->hqos.minimum[idx], eth->hqos.weight[idx]);
+	val = mtk_hqos_scheduler_config(eth, idx, val);
 	mtk_w32(eth, val, eth->soc->reg_map->qdma.qtx_sch + ofs);
 	spin_unlock_bh(&eth->hqos.lock);
 }
@@ -898,6 +921,7 @@
 	eth->hqos.rate[queue] = rate;
 	val = mtk_hqos_queue_config(eth->hqos.baseline[queue], rate,
 				    eth->hqos.minimum[queue], eth->hqos.weight[queue]);
+	val = mtk_hqos_scheduler_config(eth, queue, val);
 	mtk_w32(eth, val, eth->soc->reg_map->qdma.qtx_sch +
 		MTK_QTX_OFFSET * queue);
 	spin_unlock_bh(&eth->hqos.lock);
@@ -928,12 +952,48 @@
 	eth->hqos.rate[queue] = rate;
 	eth->hqos.minimum[queue] = minimum;
 	eth->hqos.weight[queue] = weight;
+	val = mtk_hqos_scheduler_config(eth, queue, val);
 	mtk_w32(eth, val, eth->soc->reg_map->qdma.qtx_sch +
 		MTK_QTX_OFFSET * queue);
 	spin_unlock_bh(&eth->hqos.lock);
 	return 0;
 }
 
+/* One validated policy replaces every scheduler assignment and port map.
+ * Scheduler 0/1 retain the native WFQ mode and bandwidth settings.
+ */
+int mtk_hqos_set_policy(struct mtk_eth *eth, const int *policy)
+{
+	unsigned int q, port, n = MTK_HQOS_QUEUES;
+	u32 val;
+
+	ASSERT_RTNL();
+	if (!mtk_hqos_supported(eth))
+		return -EOPNOTSUPP;
+	for (q = 0; q < MTK_HQOS_QUEUES; q++)
+		if (policy[q] < -1 || policy[q] > 1)
+			return -EINVAL;
+	for (port = 0; port < MTK_MAX_DEVS; port++)
+		for (q = 0; q < MTK_HQOS_QUEUES; q++, n++)
+			if (policy[n] < -1 || policy[n] >= MTK_HQOS_QUEUES ||
+			    (policy[n] >= 0 && !eth->netdev[port]))
+				return -EINVAL;
+	spin_lock_bh(&eth->hqos.lock);
+	for (q = 0; q < MTK_HQOS_QUEUES; q++) {
+		eth->hqos.scheduler[q] = policy[q] + 1;
+		val = mtk_hqos_queue_config(eth->hqos.baseline[q],
+			eth->hqos.rate[q], eth->hqos.minimum[q], eth->hqos.weight[q]);
+		val = mtk_hqos_scheduler_config(eth, q, val);
+		mtk_w32(eth, val, eth->soc->reg_map->qdma.qtx_sch + MTK_QTX_OFFSET * q);
+	}
+	n = MTK_HQOS_QUEUES;
+	for (port = 0; port < MTK_MAX_DEVS; port++)
+		for (q = 0; q < MTK_HQOS_QUEUES; q++, n++)
+			WRITE_ONCE(eth->hqos.port_queue[port][q], policy[n] + 1);
+	spin_unlock_bh(&eth->hqos.lock);
+	return 0;
+}
