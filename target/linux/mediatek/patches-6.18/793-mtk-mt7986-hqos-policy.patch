+/* ABI: 16 scheduler IDs, then 16 queue IDs for each GMAC; -1 inherits.
+ * Every write is a complete policy. Existing PPE entries require new flows.
+ */
+#define MTK_HQOS_POLICY_SIZE (MTK_HQOS_QUEUES * (1 + MTK_MAX_DEVS))
+
+static bool mtk_hqos_running(struct mtk_eth *eth)
+{
+	int i;
+
+	if (test_bit(MTK_RESETTING, &eth->state))
+		return false;
+	for (i = 0; i < MTK_MAX_DEVS; i++)
+		if (eth->netdev[i] && netif_running(eth->netdev[i]))
+			return true;
+	return false;
+}
+
+static int mtk_hqos_policy_show(struct seq_file *m, void *unused)
+{
+	struct mtk_eth *eth = ((struct mtk_ppe *)m->private)->eth;
+	int policy[MTK_HQOS_POLICY_SIZE], q, port, n = MTK_HQOS_QUEUES;
+	u32 sched;
+
+	rtnl_lock();
+	if (!mtk_hqos_running(eth)) {
+		rtnl_unlock();
+		return -EBUSY;
+	}
+	spin_lock_bh(&eth->hqos.lock);
+	for (q = 0; q < MTK_HQOS_QUEUES; q++)
+		policy[q] = (int)eth->hqos.scheduler[q] - 1;
+	for (port = 0; port < MTK_MAX_DEVS; port++)
+		for (q = 0; q < MTK_HQOS_QUEUES; q++)
+			policy[n++] = (int)eth->hqos.port_queue[port][q] - 1;
+	sched = mtk_r32(eth, eth->soc->reg_map->qdma.tx_sch_rate);
+	spin_unlock_bh(&eth->hqos.lock);
+	seq_puts(m, "policy");
+	for (q = 0; q < MTK_HQOS_POLICY_SIZE; q++)
+		seq_printf(m, " %d", policy[q]);
+	seq_puts(m, "\n");
+	for (port = 0; port < MTK_MAX_DEVS; port++)
+		if (eth->netdev[port])
+			seq_printf(m, "port %d %s\n", port, eth->netdev[port]->name);
+	seq_printf(m, "scheduler 0 0x%04x\nscheduler 1 0x%04x\n",
+		   sched & 0xffff, sched >> 16);
+	rtnl_unlock();
+	return 0;
+}
+
+static int mtk_hqos_policy_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, mtk_hqos_policy_show, inode->i_private);
+}
+
+static ssize_t mtk_hqos_policy_write(struct file *file, const char __user *user,
+				   size_t count, loff_t *pos)
+{
+	struct mtk_eth *eth = ((struct mtk_ppe *)((struct seq_file *)file->private_data)->private)->eth;
+	int policy[MTK_HQOS_POLICY_SIZE], n = 0, ret;
+	char buf[512], *cursor = buf, *token;
+
+	if (!capable(CAP_NET_ADMIN))
+		return -EPERM;
+	if (!count || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, user, count))
+		return -EFAULT;
+	buf[count] = '\0';
+	if (memchr(buf, '\0', count))
+		return -EINVAL;
+	while ((token = strsep(&cursor, " \t\n"))) {
+		if (!*token)
+			continue;
+		if (n == MTK_HQOS_POLICY_SIZE || kstrtoint(token, 10, &policy[n]))
+			return -EINVAL;
+		n++;
+	}
+	if (n != MTK_HQOS_POLICY_SIZE)
+		return -EINVAL;
+	rtnl_lock();
+	ret = mtk_hqos_running(eth) ? mtk_hqos_set_policy(eth, policy) : -EBUSY;
+	rtnl_unlock();
+	return ret ? ret : count;
+}
+
+static const struct file_operations mtk_hqos_policy_fops = {
+	.owner = THIS_MODULE,
+	.open = mtk_hqos_policy_open,
+	.read = seq_read,
+	.write = mtk_hqos_policy_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
