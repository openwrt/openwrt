From: Łukasz Buśko <lukasz.busko@guns4hire.cc>
Date: Sat, 17 Oct 2026 09:20:00 +0200
Subject: [PATCH] arm64: dts: mediatek: mt7988a: give each PCIe host its PEXTP
 reference clock

mtk_pcie_parse_port() takes every clock listed on the host with
devm_clk_bulk_get_all() and mtk_pcie_power_up() enables them before the
LTSSM is started. The MT7988 device tree lists four infracfg clocks per
host and stops there, so the per-port transceiver PHY reference clock
(topckgen pextp_p<n>_sel) is never among them and is left disabled as an
unused clock:

  pextp_p0_sel  0  0  0  26000000  ...  N  deviceless

The host then polls a link that cannot come up because its PHY has no
reference clock:

  mtk-pcie-gen3 11300000.pcie: PCIe link down, current LTSSM state: detect.quiet (0x1)

Describe that clock on all four hosts and move them onto the
mediatek,mt7988-pcie compatible, which the binding now pins to the five
clocks. The driver keeps matching through the mediatek,mt8192-pcie
fallback, so this is a description-only change.

Based on the BPi-R4 Pro 8X device tree from the Bananapi vendor tree.
---
 arch/arm64/boot/dts/mediatek/mt7988a.dtsi | 28 ++++++++++++++------------
 1 file changed, 16 insertions(+), 12 deletions(-)

--- a/arch/arm64/boot/dts/mediatek/mt7988a.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt7988a.dtsi
@@ -632,7 +632,7 @@
 		};
 
 		pcie2: pcie@11280000 {
-			compatible = "mediatek,mt7986-pcie",
+			compatible = "mediatek,mt7988-pcie",
 				     "mediatek,mt8192-pcie";
 			device_type = "pci";
 			#address-cells = <3>;
@@ -649,9 +649,10 @@
 			clocks = <&infracfg CLK_INFRA_PCIE_PIPE_P2>,
 				 <&infracfg CLK_INFRA_PCIE_GFMUX_TL_P2>,
 				 <&infracfg CLK_INFRA_PCIE_PERI_26M_CK_P2>,
-				 <&infracfg CLK_INFRA_133M_PCIE_CK_P2>;
+				 <&infracfg CLK_INFRA_133M_PCIE_CK_P2>,
+				 <&topckgen CLK_TOP_PEXTP_P2_SEL>;
 			clock-names = "pl_250m", "tl_26m", "peri_26m",
-				      "top_133m";
+				      "top_133m", "pextp_clk";
 			pinctrl-names = "default";
 			pinctrl-0 = <&pcie2_pins>;
 			status = "disabled";
@@ -673,7 +674,7 @@
 		};
 
 		pcie3: pcie@11290000 {
-			compatible = "mediatek,mt7986-pcie",
+			compatible = "mediatek,mt7988-pcie",
 				     "mediatek,mt8192-pcie";
 			device_type = "pci";
 			#address-cells = <3>;
@@ -690,9 +691,10 @@
 			clocks = <&infracfg CLK_INFRA_PCIE_PIPE_P3>,
 				 <&infracfg CLK_INFRA_PCIE_GFMUX_TL_P3>,
 				 <&infracfg CLK_INFRA_PCIE_PERI_26M_CK_P3>,
-				 <&infracfg CLK_INFRA_133M_PCIE_CK_P3>;
+				 <&infracfg CLK_INFRA_133M_PCIE_CK_P3>,
+				 <&topckgen CLK_TOP_PEXTP_P3_SEL>;
 			clock-names = "pl_250m", "tl_26m", "peri_26m",
-				      "top_133m";
+				      "top_133m", "pextp_clk";
 			pinctrl-names = "default";
 			pinctrl-0 = <&pcie3_pins>;
 			status = "disabled";
@@ -711,7 +713,7 @@
 		};
 
 		pcie0: pcie@11300000 {
-			compatible = "mediatek,mt7986-pcie",
+			compatible = "mediatek,mt7988-pcie",
 				     "mediatek,mt8192-pcie";
 			device_type = "pci";
 			#address-cells = <3>;
@@ -728,9 +730,10 @@
 			clocks = <&infracfg CLK_INFRA_PCIE_PIPE_P0>,
 				 <&infracfg CLK_INFRA_PCIE_GFMUX_TL_P0>,
 				 <&infracfg CLK_INFRA_PCIE_PERI_26M_CK_P0>,
-				 <&infracfg CLK_INFRA_133M_PCIE_CK_P0>;
+				 <&infracfg CLK_INFRA_133M_PCIE_CK_P0>,
+				 <&topckgen CLK_TOP_PEXTP_P0_SEL>;
 			clock-names = "pl_250m", "tl_26m", "peri_26m",
-				      "top_133m";
+				      "top_133m", "pextp_clk";
 			pinctrl-names = "default";
 			pinctrl-0 = <&pcie0_pins>;
 			status = "disabled";
@@ -749,7 +752,7 @@
 		};
 
 		pcie1: pcie@11310000 {
-			compatible = "mediatek,mt7986-pcie",
+			compatible = "mediatek,mt7988-pcie",
 				     "mediatek,mt8192-pcie";
 			device_type = "pci";
 			#address-cells = <3>;
@@ -766,9 +769,10 @@
 			clocks = <&infracfg CLK_INFRA_PCIE_PIPE_P1>,
 				 <&infracfg CLK_INFRA_PCIE_GFMUX_TL_P1>,
 				 <&infracfg CLK_INFRA_PCIE_PERI_26M_CK_P1>,
-				 <&infracfg CLK_INFRA_133M_PCIE_CK_P1>;
+				 <&infracfg CLK_INFRA_133M_PCIE_CK_P1>,
+				 <&topckgen CLK_TOP_PEXTP_P1_SEL>;
 			clock-names = "pl_250m", "tl_26m", "peri_26m",
-				      "top_133m";
+				      "top_133m", "pextp_clk";
 			pinctrl-names = "default";
 			pinctrl-0 = <&pcie1_pins>;
 			status = "disabled";
