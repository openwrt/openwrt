+static int aeon_gen2_read_pid(struct phy_device *phydev)
+{
+	int pid1 = 0, pid2 = 0, pid = 0;
+
+	pid1 = aeon_cl45_read(phydev, MDIO_MMD_PMAPMD, 2);
