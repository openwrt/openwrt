+static int aeon_config_vend_prov(struct phy_device *phydev)
+{
+	u16 adv = 0;
+
+	if (linkmode_test_bit(ETHTOOL_LINK_MODE_1000baseT_Full_BIT,
+			      phydev->advertising))
+		adv |= AEON_1GBASE_T_ADVERTISE;         /* bit 15 */
+	if (linkmode_test_bit(ETHTOOL_LINK_MODE_2500baseT_Full_BIT,
+			      phydev->advertising))
+		adv |= AEON_2_5GBASE_T_ADVERTISE;       /* bit 10 */
+	if (linkmode_test_bit(ETHTOOL_LINK_MODE_5000baseT_Full_BIT,
+			      phydev->advertising))
+		adv |= AEON_5GBASE_T_ADVERTISE;         /* bit 11 */
+
+	return phy_modify_mmd_changed(phydev, MDIO_MMD_AN,
+				      AEON_AUTONEG_VENDOR_PROVISION_1_REG,
+				      AEON_1GBASE_T_ADVERTISE |
+				      AEON_2_5GBASE_T_ADVERTISE |
+				      AEON_5GBASE_T_ADVERTISE, adv);
+}
