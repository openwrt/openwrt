+		phydev_warn(phydev, "failed to configure 100M advertisement: %d\n", ret);
+		return ret;
+	} else if (ret > 0) {
+		changed = true;
+	} else {
+		ret = aeon_set_eth_speed(phydev);
+		if (ret) {
+			phydev_warn(phydev, "failed to set advertised speed: %d\n", ret);
+			return ret;
+		}
+	}
+
+	mdio_adv = ADVERTISE_1000FULL | ADVERTISE_1000HALF;
+	adv = linkmode_adv_to_mii_ctrl1000_t(phydev->advertising);
+	ret = aeon_modify_mmd_changed(phydev, MDIO_MMD_AN,
+				      AEON_MDIO_AN_C22 + MII_CTRL1000,
+				      mdio_adv,
+				      adv);
+	if (ret < 0) {
+		phydev_warn(phydev, "failed to configure 1G advertisement: %d\n", ret);
+		return ret;
+	} else if (ret > 0) {
+		changed = true;
+	}
+
+	ret = aeon_config_vend_prov(phydev);
+	if (ret < 0) {
+		phydev_warn(phydev, "failed to configure vendor advertisement: %d\n", ret);
+		return ret;
+	} else if (ret > 0) {
+		changed = true;
+	} else {
+		ret = aeon_set_eth_speed(phydev);
+		if (ret) {
+			phydev_warn(phydev, "failed to set advertised speed: %d\n", ret);
+			return ret;
+		}
+	}
+
+	mdio_adv = MDIO_AN_10GBT_CTRL_ADV2_5G;
+	adv = linkmode_adv_to_mii_10gbt_adv_t(phydev->advertising);
+	if (priv->features.max_speed > SPEED_2500)
+		mdio_adv |= MDIO_AN_10GBT_STAT_LP5G;
+	if (priv->features.max_speed > SPEED_5000)
+		mdio_adv |= MDIO_AN_10GBT_STAT_LP10G;
+	ret = aeon_modify_mmd_changed(phydev, MDIO_MMD_AN, MDIO_AN_10GBT_CTRL, mdio_adv, adv);
+	if (ret < 0) {
+		phydev_warn(phydev, "failed to configure 10GBase-T advertisement: %d\n", ret);
+		return ret;
+	} else if (ret > 0) {
+		changed = true;
+	} else {
+		ret = aeon_set_eth_speed(phydev);
+		if (ret) {
+			phydev_warn(phydev, "failed to set advertised speed: %d\n", ret);
+			return ret;
+		}
+	}
+
+	if (phydev->interface == PHY_INTERFACE_MODE_USXGMII) {
+		ret = aeon_config_usxgmii(phydev, false);
+		if (ret < 0) {
+			phydev_warn(phydev, "failed to configure USXGMII: %d\n", ret);
+			return ret;
+		}
+	}
+
+	return changed;
+}
