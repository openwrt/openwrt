+struct as21xxx_priv {
+	/* Protect the complete mailbox transaction and its parity state. */
+	struct mutex ipc_lock;
+	/* Driver-owned last-resort hardware reset ("aeonsemi,reset-gpios");
+	 * intentionally not phylib's reset-gpios, which is asserted on
+	 * every phy_detach() and reboots the firmware each ifdown/ifup.
+	 */
+	struct gpio_desc *hw_reset;
+	bool ipc_parity_valid;
+	bool ipc_next_parity;
+	/* LED callbacks can run from phylib probe before the firmware accepts
+	 * configuration commands. Cache their settings until config_init has
+	 * verified the firmware configuration interface.
+	 */
+	bool fw_cfg_ready;
+	/* The INFO reply selects optional firmware operations. The core
+	 * mailbox and copper AN ABI is shared by 1.9.1 and 1.9.2. The 1.9.2
+	 * vendor driver moves normal LED programming to SET_LED for its new
+	 * 10G/non-10G modes and adds firmware counters and an SDS reset debug
+	 * command.
+	 */
+	enum aeon_fw_api fw_api;
+	char fw_version[AEON_IPC_DATA_MAX + 1];
+	unsigned short raw_eye_data[EYE_TOTAL_BYTES];
+	bool inband_configured;
+	/* The driver found firmware which it did not upload. The first USXGMII
+	 * configuration must fully resynchronise the live system-side SerDes.
+	 */
+	bool fw_reused;
+	/* Capabilities encoded by the firmware-visible model PHY ID. */
+	struct aeon_phy_features features;
+	/* Derived from the firmware AN arbitration state and host PCS state. */
+	enum aeon_link_status link_status;
+	unsigned int inband_mode;
+	int inband_interface;
+	/* Last MDI/MDI-X ctrl mode pushed to firmware via MAN_MDI cfg IPC.
+	 * 0 (ETH_TP_MDI_INVALID) = never sent, firmware at its auto default.
+	 */
+	u8 mdix_ctrl_sent;
+	/* Last (port_type, ms_en, ms_config) triple pushed to the firmware
+	 * CU-AN MS cfg; ms_cfg_pushed = false means firmware defaults
+	 * (single-port, automatic M/S) are still in effect.
+	 */
+	bool ms_cfg_pushed;
+	u8 ms_port_type_sent;
+	u8 ms_en_sent;
+	u8 ms_config_sent;
+	/* Desired downshift (smartspeed) retry count: 0 = disabled,
+	 * else fails-per-speed before laddering down. Firmware default
+	 * is enabled with 3. downshift_pushed is cleared at config_init
+	 * so the cfg is re-applied after a firmware reboot.
+	 */
+	u8 downshift_cnt;
+	bool downshift_pushed;
+	u16 led_cfg[LED_PARAM];
+	u64 lb_dis_to;
+	unsigned long cable_test_report_at;
+	unsigned int ipc_cmd_num;
+};
