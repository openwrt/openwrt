+static int aeon_gen1_match_phy_device(struct phy_device *phydev,
+				      const struct phy_driver *phydrv)
+{
+	u32 phy_id = aeon_gen1_read_pid(phydev);
+
+	/* Bootstrap ID: firmware not running yet (still booting from the
+	 * PHY's flash, or awaiting an MDIO firmware load).
+	 */
+	if (phy_id == PHY_ID_AS21XXX)
+		goto match;
+
+	/* Model IDs (0x750094x2): firmware already alive, e.g. a warm
+	 * reboot with no PHY reset line wired. This match function is used
+	 * by every gen1 entry (it overrides the PHY_ID_MATCH_EXACT values),
+	 * so without this case a warm PHY would land on the Generic C45
+	 */
+	if (aeon_is_gen1_model_id(phy_id))
+		goto match;
+
+	return 0;
+
+match:
+	phydev->phy_id = phy_id;
+	aeon_cl45_write(phydev, MDIO_MMD_VEND1, VEND1_PTP_CLK, 0x48);
+
+	return 1;
+}
