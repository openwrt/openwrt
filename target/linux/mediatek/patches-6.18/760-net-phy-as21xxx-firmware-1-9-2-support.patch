+static int aeon_gen1_config_init(struct phy_device *phydev)
+{
+	struct as21xxx_priv *priv = phydev->priv;
+	int ret;
+
+	mutex_lock(&priv->ipc_lock);
+	priv->fw_cfg_ready = false;
+	mutex_unlock(&priv->ipc_lock);
+
+	/* A board reset also restores the slow MDC timing. Reapply the Gen1
+	 * access timing before probing the firmware mailbox.
+	 */
+	aeon_set_fast_mdc_timing(phydev);
+	ret = aeon_wait_reset_complete(phydev);
+
+	if (ret) {
+		phydev_warn(phydev, "%s wait_reset_complete ret=%d\n", __func__, ret);
+		aeon_cl45_write(phydev, MDIO_MMD_VEND1, VEND1_PTP_CLK, 0x48);
+		/* The indirect loader preamble must precede a fresh upload. */
+		aeon_set_default_value(phydev);
+		ret = aeon_fw_check_and_load(phydev);
+		if (ret) {
+			phydev_warn(phydev, "%s aeon_fw_check_and_load ret=%d\n", __func__, ret);
+			return ret;
+		}
+	}
+
+	/* Gate on the cfg interface being usable before anything (LED cfg,
+	 * config_aneg's pushes) talks to it. Failing the attach here is
+	 * deliberate: the retry (netifd or manual ifup) asserts the reset
+	 * line and reboots the firmware - the only known recovery.
+	 */
+	ret = aeon_wait_cfg_ready(phydev);
+	if (ret) {
+		phydev_warn(phydev, "%s aeon_wait_cfg_ready ret=%d\n", __func__, ret);
+		return ret;
+	}
+
+	/* Firmware may have (re)booted since cfg was last pushed (fw load
+	 * above, or board soft-reboot with the PHY left powered): drop the
+	 * push caches so config_aneg re-applies MS/MDI/downshift cfg.
+	 */
+	priv->ms_cfg_pushed = false;
+	priv->mdix_ctrl_sent = ETH_TP_MDI_INVALID;
+	priv->downshift_pushed = false;
+
+	mutex_lock(&priv->ipc_lock);
+	priv->fw_cfg_ready = true;
+	mutex_unlock(&priv->ipc_lock);
+
+	ret = aeon_config_led(phydev);
+	if (ret)
+		phydev_warn(phydev, "failed to apply LED configuration: %d\n",
+			    ret);
+
+	return 0;
+}
