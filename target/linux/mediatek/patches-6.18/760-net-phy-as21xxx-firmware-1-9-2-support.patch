+	val = phy_read_mmd(phydev, MDIO_MMD_AN, AEON_MDIO_AN_CTRL1);
+	if (val < 0) {
+		phydev_warn(phydev, "%s MDIO_AN_CTRL1 val=%d\n", __func__, val);
+		return val;
+	}
+
+	ret = aeon_fast_retrain_config(phydev,
+				       val & AEON_MDIO_AN_CTRL1_2p5GBT_FR);
+	if (ret) {
+		phydev_warn(phydev, "%s aeon_fast_retrain_config ret=%d\n", __func__, ret);
+		return ret;
+	}
+
+	if (recover_sds) {
+		phydev_warn(phydev, "%s as21xxx_sds_restart_aneg\n", __func__);
+		return as21xxx_sds_restart_aneg(phydev);
+	}
+
+	return 0;
+}
 
