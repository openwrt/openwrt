+static int aeon_parse_phy_id(struct phy_device *phydev, u32 phy_id)
+{
+	struct as21xxx_priv *priv = phydev->priv;
+	unsigned int speed = FIELD_GET(AEON_PHY_ID_SPEED_MASK, phy_id);
+	unsigned int revision = FIELD_GET(AEON_PHY_ID_REVISION_MASK, phy_id);
+	const char *speed_caps;
+	bool second_serdes;
+	bool synce_ptp;
+	char speed_id;
+	int max_speed;
+
+	priv->features.valid = false;
+
+	if (!aeon_is_gen1_model_id(phy_id))
+		return -ENODEV;
+
+	switch (speed) {
