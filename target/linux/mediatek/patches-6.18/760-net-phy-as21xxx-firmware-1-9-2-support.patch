+static bool aeon_hard_reset(struct phy_device *phydev)
+{
+	struct as21xxx_priv *priv = phydev->priv;
+	bool core_reset;
+
+	/* reset-gpios/reset-controls are owned by the MDIO core. Do not try to
+	 * acquire the standard reset-gpios property a second time in probe.
+	 */
+	core_reset = phydev->mdio.reset_gpio || phydev->mdio.reset_ctrl;
+	if (!core_reset && !priv->hw_reset)
+		return false;
+
+	/* A hardware reset replaces the firmware mailbox state. Serialize the
+	 * reset with every IPC transaction and invalidate cached parity first.
+	 */
+	mutex_lock(&priv->ipc_lock);
+	priv->ipc_parity_valid = false;
+	priv->fw_cfg_ready = false;
+	priv->fw_api = AEON_FW_API_UNKNOWN;
+	priv->fw_version[0] = '\0';
+
+	if (core_reset) {
+		phy_device_reset(phydev, 1);
+		phy_device_reset(phydev, 0);
+	} else {
+		/* Compatibility with the Gen2 vendor-only reset property. */
+		gpiod_set_value_cansleep(priv->hw_reset, 1);
+		msleep(200);
+		gpiod_set_value_cansleep(priv->hw_reset, 0);
+		msleep(350);
+	}
+
+	priv->inband_configured = false;
+	priv->fw_reused = false;
+	priv->link_status = LINK_STATUS_UNKNOWN;
+	mutex_unlock(&priv->ipc_lock);
+
+	return true;
+}
