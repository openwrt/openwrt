+	c = aeon_caps_lookup_by_linkmode(phydev->advertising);
+	if (c) {
+		phydev->speed = c->speed;
+		phydev->duplex = c->duplex;
+	}
+	mdio_adv = ADVERTISE_ALL | ADVERTISE_100BASE4 |
+		   ADVERTISE_PAUSE_CAP |
+		   ADVERTISE_PAUSE_ASYM;
+	adv = linkmode_adv_to_mii_adv_t(phydev->advertising);
+	ret = aeon_modify_mmd_changed(phydev, MDIO_MMD_AN,
+				      AEON_MDIO_AN_C22 + MII_ADVERTISE,
+				      mdio_adv, adv);
