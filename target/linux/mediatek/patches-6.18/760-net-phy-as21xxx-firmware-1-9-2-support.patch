+static int aeon_config_usxgmii(struct phy_device *phydev, bool recover_sds)
+{
+	int ret, val;
+
+	/* A warm kernel can bind to firmware and SerDes state left by the
+	 * previous owner. Reinitialise the system-side lane before applying the
+	 * current RA/fast-retrain policy, then explicitly restart SerDes AN.
+	 */
+	if (recover_sds) {
+		ret = aeon_restart_sds(phydev, 0);
+		if (ret) {
+			phydev_warn(phydev, "%s aeon_restart_sds ret=%d\n", __func__, ret);
