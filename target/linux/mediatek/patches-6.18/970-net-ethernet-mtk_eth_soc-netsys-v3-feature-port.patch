+	dma_unmap_single(eth->dma_dev, addr, len, DMA_TO_DEVICE);
+}
+
+static inline dma_addr_t mtk_dma_map_rx(struct mtk_eth *eth, void *data,
+					size_t len)
+{
+	return dma_map_single(eth->dma_dev, data, len, DMA_FROM_DEVICE);
+}
+
+static inline void mtk_dma_unmap_rx(struct mtk_eth *eth, dma_addr_t addr,
+				    size_t len)
+{
+	dma_unmap_single(eth->dma_dev, addr, len, DMA_FROM_DEVICE);
+}
