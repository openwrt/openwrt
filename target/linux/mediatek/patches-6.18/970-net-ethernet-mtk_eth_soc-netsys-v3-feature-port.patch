+static void mtk_get_pause_stats(struct net_device *dev,
+				struct ethtool_pause_stats *pause_stats)
+{
+	struct mtk_mac *mac = netdev_priv(dev);
+	struct mtk_hw_stats *hwstats = mac->hw_stats;
+	unsigned int start;
+
+	if (unlikely(test_bit(MTK_RESETTING, &mac->hw->state)))
+		return;
+
+	if (netif_running(dev) && netif_device_present(dev) &&
+	    spin_trylock_bh(&hwstats->stats_lock)) {
+		mtk_stats_update_mac(mac);
+		spin_unlock_bh(&hwstats->stats_lock);
+	}
+
+	/* The common GDM/XGDM MIB path currently exposes only the received
+	 * flow-control frame count. Leave tx_pause_frames as NOT_SET until a
+	 * documented counter is available for every MAC mode.
+	 */
+	do {
+		start = u64_stats_fetch_begin(&hwstats->syncp);
+		pause_stats->rx_pause_frames =
+			hwstats->rx_flow_control_packets;
+	} while (u64_stats_fetch_retry(&hwstats->syncp, start));
+}
