+/* ---- TX BQL stop/wake thresholds + ring-room helper -----------------------
+ *
+ * MTK_TX_STOP_THRESH: minimum free-descriptor count below which the netdev
+ *   TX queue is stopped. Sized at MAX_SKB_FRAGS + 4 so a fully-fragmented
+ *   skb (which costs MAX_SKB_FRAGS + 1 descriptors) cannot deplete the ring
+ *   below the wake threshold between two successive ndo_start_xmit calls in
+ *   steady state. This is the cornerstone of avoiding NETDEV_TX_BUSY: stop
+ *   *before* the ring is genuinely too full to accept the next packet,
+ *   rather than as a recovery path after the fact.
+ *
+ * MTK_TX_WAKE_THRESH: 2x stop threshold. The hysteresis differential
+ *   prevents flap under sustained fragmented traffic where completion is
+ *   keeping pace with submit only by single-descriptor margins. Doubling
+ *   the threshold means we accumulate ~MAX_SKB_FRAGS+4 freshly-freed
+ *   descriptors after a stop before waking back up.
+ *
+ * These are kernel-internal constants (not exposed to userspace) and apply
+ * uniformly across V1/V2/V3 SOCs; ring depth differs across SOCs but the
+ * worst-case per-skb descriptor cost (MAX_SKB_FRAGS + 1) does not.
+ *
+ * mtk_tx_ring_has_room() centralizes the `free_count` atomic read and the
+ * strict-greater comparison so call sites cannot drift on the boundary
+ * semantics. Use it everywhere a ring-fullness check is needed: post-flight
+ * stop in mtk_start_xmit, XDP submit pre-flight, and the post-completion
+ * wake in mtk_poll_tx.
+ */
+#define MTK_TX_STOP_THRESH	(MAX_SKB_FRAGS + 4)
+#define MTK_TX_WAKE_THRESH	(MTK_TX_STOP_THRESH * 2)
+
+static inline bool mtk_tx_ring_has_room(const struct mtk_tx_ring *ring, int n)
+{
+	return atomic_read(&ring->free_count) > n;
+}
