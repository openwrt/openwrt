+/* The RX rings are shared by all GMACs and their buffers are sized from
+ * eth->rx_buf_len when the first netdev opens (mtk_start_dma). Multi-frag
+ * RX is not supported yet, so a frame larger than the live buffer size is
+ * scattered over several descriptors and dropped in mtk_poll_rx: the MAC
+ * level max-rx filters admit it, but it never reaches the stack. Growing
+ * any GMAC MTU past the live buffer size therefore needs a full stop/open
+ * cycle of every running netdev - mirroring mtk_pending_work() - so the
+ * rings are reallocated with the new eth->rx_buf_len.
+ */
+static int mtk_update_rx_buf_len(struct mtk_eth *eth)
+{
+	u32 buf_len = mtk_calc_rx_buf_len(mtk_max_gmac_mtu(eth));
+	unsigned long restart = 0;
+	int i, err = 0;
+
+	if (!refcount_read(&eth->dma_refcnt)) {
+		/* No live rings: the next mtk_open picks up the new size */
+		eth->rx_buf_len = buf_len;
+		return 0;
+	}
+
+	/* Live rings already large enough; never shrink them in place */
+	if (buf_len <= eth->rx_buf_len)
+		return 0;
+
+	for (i = 0; i < MTK_MAX_DEVS; i++) {
+		if (!eth->netdev[i] || !netif_running(eth->netdev[i]))
+			continue;
+
+		mtk_stop(eth->netdev[i]);
+		__set_bit(i, &restart);
+	}
+
+	/* All users stopped: the last mtk_stop() freed the DMA rings */
+	eth->rx_buf_len = buf_len;
+
+	for (i = 0; i < MTK_MAX_DEVS; i++) {
+		if (!test_bit(i, &restart))
+			continue;
+
+		err = mtk_open(eth->netdev[i]);
+		if (err) {
+			netif_alert(eth, ifup, eth->netdev[i],
+				    "Driver up/down cycle failed, closing device.\n");
+			dev_close(eth->netdev[i]);
+		}
+	}
+
+	return err;
+}
