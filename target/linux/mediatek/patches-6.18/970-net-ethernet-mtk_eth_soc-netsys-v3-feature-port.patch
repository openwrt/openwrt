+static int mtk_mux_switch_channel(struct mtk_mux *mux,
+				  unsigned int new_channel)
+{
+	struct mtk_mac *mac = mux->mac;
+	struct mtk_eth *eth = mac->hw;
+	struct net_device *dev = eth->netdev[mac->id];
+	unsigned int old_channel = mux->active_channel;
+	int err, restore_err;
+
+	rtnl_lock();
+	if (!netif_running(dev) || mux->switching ||
+	    test_bit(MTK_RESETTING, &eth->state) ||
+	    test_and_set_bit_lock(MTK_MUX_SWITCHING, &eth->state)) {
+		rtnl_unlock();
+		return -EBUSY;
+	}
+	mux->switching = true;
+
+	err = mtk_stop(dev);
+	if (err) {
+		mux->switching = false;
+		clear_bit_unlock(MTK_MUX_SWITCHING, &eth->state);
+		rtnl_unlock();
+		return err;
+	}
+
+	/* mtk_stop() leaves the PHY attached for normal netdev flaps. A mux
+	 * transition destroys this phylink, so detach while RTNL is still held
+	 * as required by phylink_disconnect_phy().
+	 */
+	mtk_mux_disconnect_phylink(mac);
+	mux->stopped = true;
+	rtnl_unlock();
+
+	mtk_mux_destroy_phylink(mac);
+
+	/* Route the SerDes lane before the new phylink registers an SFP bus or
+	 * starts its PHY/PCS. The previous order started the new endpoint while
+	 * the passive mux was still connected to the old one.
+	 */
+	gpiod_set_value_cansleep(mux->chan_sel_gpio, new_channel);
+
+	err = mtk_mux_create_phylink(mux, new_channel);
+	if (err)
+		goto restore;
+
+	rtnl_lock();
+	if (!netif_running(dev)) {
+		/* Userspace administratively closed the device while RTNL was
+		 * dropped. Keep the selected phylink stopped for the next open.
+		 */
+		mux->active_channel = new_channel;
+		mux->switching = false;
+		mux->stopped = false;
+		clear_bit_unlock(MTK_MUX_SWITCHING, &eth->state);
+		rtnl_unlock();
+		return 0;
+	}
+
+	mux->switching = false;
+	err = mtk_open(dev);
+	if (!err) {
+		mux->active_channel = new_channel;
+		mux->stopped = false;
+		clear_bit_unlock(MTK_MUX_SWITCHING, &eth->state);
+		rtnl_unlock();
+		dev_info(eth->dev, "Ethernet mux: switched to channel %u\n",
+			 new_channel);
+		return 0;
+	}
+
+	/* mtk_open() normally detaches a newly attached PHY on failure, but
+	 * keep this path correct if a later failure is added in the future.
+	 */
+	mux->switching = true;
+	mtk_mux_disconnect_phylink(mac);
+	rtnl_unlock();
+
+	mtk_mux_destroy_phylink(mac);
+	dev_err(eth->dev, "Ethernet mux: channel %u: open failed: %d\n",
+		new_channel, err);
+
+restore:
+	/* Restore both the physical lane and the previous phylink. Without
+	 * rollback, a phylink_create() failure leaves a running netdev with a
+	 * NULL phylink and the next 100 ms poll dereferences it in mtk_stop().
+	 */
+	gpiod_set_value_cansleep(mux->chan_sel_gpio, old_channel);
+	restore_err = mtk_mux_create_phylink(mux, old_channel);
+
+	rtnl_lock();
+	if (!restore_err && netif_running(dev)) {
+		mux->switching = false;
+		restore_err = mtk_open(dev);
+		if (restore_err) {
+			mux->switching = true;
+			mtk_mux_disconnect_phylink(mac);
+		}
+	}
+
+	mux->active_channel = old_channel;
+	if (!restore_err) {
+		mux->switching = false;
+		mux->stopped = false;
+		clear_bit_unlock(MTK_MUX_SWITCHING, &eth->state);
+		rtnl_unlock();
+		dev_warn(eth->dev,
+			 "Ethernet mux: restored channel %u after switch failure: %d\n",
+			 old_channel, err);
+		return err;
+	}
+
+	/* The driver was already stopped before phylink replacement. Let the
+	 * networking core mark the interface down without stopping it twice.
+	 */
+	mux->switching = false;
+	if (netif_running(dev))
+		dev_close(dev);
+	mux->stopped = false;
+	clear_bit_unlock(MTK_MUX_SWITCHING, &eth->state);
+	rtnl_unlock();
+
+	dev_err(eth->dev,
+		"Ethernet mux: failed to restore channel %u: %d (switch error: %d)\n",
+		old_channel, restore_err, err);
+	return restore_err;
+}
