+/* Build an skb from a legacy-backend RX buffer.
+ *
+ * Returns the new skb (with skb_reserve / skb_put already applied), or NULL
+ * on allocation failure (in which case the old buffer has been recycled
+ * back to its provider and netdev->stats.rx_dropped has been bumped).
+ *
+ * @data, @pktlen, @netdev are derived in the caller; passing them in keeps
+ * this helper free of caller-scope assumptions.
+ */
+static struct sk_buff *
+mtk_build_skb(struct mtk_eth *eth, struct mtk_rx_ring *ring,
+	      struct mtk_rx_mem *old, void *data, u32 pktlen,
+	      struct net_device *netdev)
+{
+	struct sk_buff *skb;
+
+	skb = build_skb(data, old->frame_len);
+	if (unlikely(!skb)) {
+		ring->mem_ops->recycle(eth, ring, old, true);
+		netdev->stats.rx_dropped++;
+		return NULL;
+	}
+	skb_reserve(skb, old->data_off);
+	skb_put(skb, pktlen);
+
+	return skb;
