+/* ---- DMA ordering / mapping wrappers --------------------------------------
+ *
+ * Centralizes coherent allocation policy, streaming TX/RX mappings, and the
+ * descriptor-publish barrier so SOC-specific behavior stays in one place
+ * rather than spreading across the hot paths. All helpers take a
+ * struct mtk_eth * so future per-SOC specialization (caps-gated branches on
+ * MTK_NETSYS_V1/V2/V3, MTK_QDMA, MTK_SOC_MT7628, etc.) can be added inline
+ * without churning every call site.
+ *
+ * Coherent descriptor rings (TX/RX/HWLRO/RSS/scratch/PDMA shadow) are
+ * allocated through mtk_dma_ring_alloc()/mtk_dma_ring_free() so the MT7988
+ * on-die SRAM gen_pool path is honored where applicable.
+ *
+ * Streaming buffer mappings (TX skb head/frags, RX refills) should go
+ * through the mtk_dma_map_*_mtk_dma_unmap_* wrappers. Per kernel DMA API
+ * guidance (Documentation/core-api/dma-api.rst), drivers must not touch
+ * dma_map_ops directly; these inlines are the driver-side wrapper.
+ *
+ * mtk_desc_publish() is the descriptor-ownership barrier used immediately
+ * before a MMIO doorbell write that hands ownership to the device. It
+ * expands to dma_wmb() which is the correct (and cheaper on arm64 / weakly
+ * ordered cores: DMB OSHST vs DSB ST) primitive for ordering CPU writes to
+ * DMA-coherent descriptor memory against subsequent device reads. The MMIO
+ * write that follows provides MMIO-vs-CPU ordering via writel()'s own
+ * built-in barrier; do not double-fence by following mtk_desc_publish()
+ * with a bare wmb().
+ */
+
+static inline void mtk_desc_publish(struct mtk_eth *eth)
+{
+	/* CPU writes to coherent descriptor memory complete before the next
+	 * MMIO doorbell write that follows this barrier. Reserved arg `eth`
+	 * lets us caps-gate a stronger barrier per SOC revision without
+	 * touching call sites.
+	 */
+	dma_wmb();
+}
+
+static inline dma_addr_t mtk_dma_map_tx(struct mtk_eth *eth, void *data,
+					size_t len)
+{
+	return dma_map_single(eth->dma_dev, data, len, DMA_TO_DEVICE);
+}
+
+static inline void mtk_dma_unmap_tx(struct mtk_eth *eth, dma_addr_t addr,
+				    size_t len)
