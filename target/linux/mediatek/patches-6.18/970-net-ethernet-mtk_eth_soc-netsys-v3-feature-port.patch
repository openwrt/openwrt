+	 * rings must be flipped to PSE (non-LRO) mode first. On v2/v3
+	 * descriptor SoCs (this tree: RSS rings 1..3, HWLRO rings 5..7)
+	 * the sets are disjoint and this is not needed.
+	 */
+	if (eth->soc->rx.desc_size == sizeof(struct mtk_rx_dma)) {
+		for (i = 1; i <= MTK_HW_LRO_RING_NUM; i++) {
+			val = mtk_r32(eth, MTK_LRO_CTRL_DW2_CFG(i));
