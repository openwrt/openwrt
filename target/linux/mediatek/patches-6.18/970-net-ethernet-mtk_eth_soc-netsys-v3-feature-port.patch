+/* enum mtk_rx_mem_kind - tag for the backing memory provider of an RX buffer.
+ *
+ * Carried by every struct mtk_rx_mem handle so the consume path can dispatch
+ * on backend kind (XDP/napi_build_skb vs legacy build_skb) without poking at
+ * the provider-specific union members. MTK_RXMEM_NETMEM_FUTURE is reserved
+ * for capability-neutral netmem handles; the rest of the code paths are
+ * designed so a netmem backend can be added without touching every call site.
+ */
+enum mtk_rx_mem_kind {
+	MTK_RXMEM_LEGACY,
+	MTK_RXMEM_PP_PAGE,
+	MTK_RXMEM_PP_FRAG,
+	/* MTK_RXMEM_NETMEM_FUTURE - reserved */
+};
+
+/* struct mtk_rx_mem - typed memory handle for one in-flight RX buffer.
+ *
+ * Replaces the prior void * "data" with a self-describing handle that records
+ * the backing memory provider, the device DMA address, the headroom offset
+ * within the buffer, the buffer-level length used for skb construction, and
+ * (for backends that own page-backed memory) the underlying struct page.
+ *
+ * Per the netmem documentation, drivers should not assume payload memory is
+ * page-backed, directly DMA-mappable, or CPU-readable. This struct accommodates
+ * that constraint: the @va field may become NULL when a future netmem backend
+ * is wired in, and consumers MUST go through mem_ops->data() rather than
+ * dereferencing @va directly.
+ *
+ * @kind:	Which backend allocated this buffer (drives consume dispatch).
+ * @dma_addr:	Device address of the packet-data start (= buffer start +
+ *		@data_off). For PP_FRAG this already includes the fragment
+ *		offset within the underlying page.
+ * @va:		CPU virtual address of buffer start. Always set for the
+ *		current three backends; may be NULL once netmem is added.
+ * @page:	Backing page for PP_PAGE/PP_FRAG (head page, for recycle).
+ *		NULL for LEGACY.
+ * @data_off:	Offset from buffer start to where the device writes packet
+ *		data. XDP_PACKET_HEADROOM for PP_PAGE, NET_SKB_PAD for
+ *		PP_FRAG, NET_SKB_PAD+NET_IP_ALIGN for LEGACY.
+ * @frame_len:	Total buffer size — the argument to napi_build_skb() /
+ *		build_skb().
+ */
+struct mtk_rx_mem {
+	enum mtk_rx_mem_kind kind;
+	dma_addr_t dma_addr;
+	void *va;
+	struct page *page;
+	u16 data_off;
+	u16 frame_len;
+};
+
+/* struct mtk_rx_mem_ops - per-queue RX memory provider backend.
+ *
+ * Centralizes alloc / sync / data-access / recycle for one RX queue. Each
+ * backend (mtk_legacy_rx_ops, mtk_pp_page_ops, mtk_pp_frag_ops) implements
+ * the same vtable; selection happens once at ring init in mtk_rx_alloc()
+ * based on HWLRO state, SOC capability bits, MTU/page-size geometry, and
+ * (for pp_frag) XDP attachment state.
+ *
+ * @init:		Set up per-queue state (page pool, xdp_rxq, geometry).
+ *			Owns the computation of ring->frag_size / ring->buf_size
+ *			so each backend controls its memory shape directly.
+ * @cleanup:		Tear down per-queue state. Called after all posted
+ *			buffers have been released via @sync_for_cpu+@recycle.
+ * @alloc:		Allocate one RX buffer. Fills the caller-provided
+ *			struct mtk_rx_mem with backend, dma_addr, va, page (if
+ *			applicable), data_off and frame_len. Returns 0 on
+ *			success, negative errno on failure.
+ * @sync_for_cpu:	Complete the device→CPU ownership transition for a
+ *			completed buffer. LEGACY: dma_unmap_single. PP variants:
+ *			dma_sync_single_for_cpu. Also used during ring teardown
+ *			to release the DMA lifecycle on unconsumed buffers.
+ * @data:		Return CPU virtual address of buffer start
+ *			(suitable for napi_build_skb / build_skb). May return
+ *			NULL for future netmem backends; callers MUST handle.
+ * @recycle:		Return the buffer to its provider. For PP backends this
+ *			is page_pool_put_full_page (which handles fragment
+ *			refcount internally); for LEGACY it is skb_free_frag.
+ */
+struct mtk_rx_mem_ops {
+	int   (*init)(struct mtk_eth *eth, struct mtk_rx_ring *ring,
+		      int ring_size);
+	void  (*cleanup)(struct mtk_eth *eth, struct mtk_rx_ring *ring);
+	int   (*alloc)(struct mtk_eth *eth, struct mtk_rx_ring *ring,
+		       struct mtk_rx_mem *m, gfp_t gfp);
+	void  (*sync_for_cpu)(struct mtk_eth *eth, struct mtk_rx_ring *ring,
+			      struct mtk_rx_mem *m, u32 pktlen);
+	void *(*data)(struct mtk_rx_mem *m);
+	void  (*recycle)(struct mtk_eth *eth, struct mtk_rx_ring *ring,
+			 struct mtk_rx_mem *m, bool napi);
+};
+
+extern const struct mtk_rx_mem_ops mtk_legacy_rx_ops;
+extern const struct mtk_rx_mem_ops mtk_pp_page_ops;
+extern const struct mtk_rx_mem_ops mtk_pp_frag_ops;
+
