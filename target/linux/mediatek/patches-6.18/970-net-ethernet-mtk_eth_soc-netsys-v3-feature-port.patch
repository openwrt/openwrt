+static void mtk_set_mcr_max_rx(struct mtk_mac *mac, u32 val)
+{
+	struct mtk_eth *eth = mac->hw;
+	u32 mcr_cur, mcr_new, enc;
+
+	if (MTK_HAS_CAPS(eth->soc->caps, MTK_SOC_MT7628))
+		return;
+
+	if (mac->type == MTK_XGDM_TYPE && mac->id != MTK_GMAC1_ID) {
+		val = min_t(u32, val, MTK_MAX_RX_LENGTH_9K);
+
+		mcr_cur = mtk_r32(mac->hw, MTK_XMAC_RX_CFG2(mac->id));
+		mcr_new = mcr_cur & ~MTK_XMAC_MAX_RX_MASK;
+		mcr_new |= FIELD_PREP(MTK_XMAC_MAX_RX_MASK, val);
+
+		if (mcr_new != mcr_cur)
+			mtk_w32(mac->hw, mcr_new, MTK_XMAC_RX_CFG2(mac->id));
+
+		return;
+	}
+
+	if (mac->type != MTK_GDM_TYPE)
+		return;
+
+	if (val <= 1522)
+		enc = MAC_MCR_MAX_RX_1518;
+	else if (val <= 1536)
+		enc = MAC_MCR_MAX_RX_1536;
+	else if (val <= 1552)
+		enc = MAC_MCR_MAX_RX_1552;
+	else
+		enc = MAC_MCR_MAX_RX_2048;	/* uses MAX_RX_JUMBO */
+
+	mcr_cur = mtk_r32(mac->hw, MTK_MAC_MCR(mac->id));
+	mcr_new = mcr_cur & ~MAC_MCR_MAX_RX_MASK;
+	mcr_new |= MAC_MCR_MAX_RX(enc);
+
+	/* If selecting the jumbo enum, ensure MAX_RX_JUMBO is at the only
+	 * legal FE/GDM value (4'h2 = 2 KB). The reset default may leave
+	 * this at 4'h0 (reserved), which makes enum 3 nonsensical.
+	 */
+	if (enc == MAC_MCR_MAX_RX_2048) {
+		mcr_new &= ~GENMASK(31, 28);
+		mcr_new |= 0x2u << 28;
+	}
+
+	if (mcr_new != mcr_cur)
+		mtk_w32(mac->hw, mcr_new, MTK_MAC_MCR(mac->id));
+}
