+static void mtk_check_pse_oq_sta(struct mtk_eth *eth, u8 port, u16 *pre_opq, u8 *err_opq)
+{
+	u32 val;
+	u8 id = port / 2;
+	u16 cur_opq;
+
+	if (MTK_HAS_CAPS(eth->soc->caps, MTK_NETSYS_V1))
+		return;
+
+	val = mtk_r32(eth, MTK_PSE_OQ_STA(id));
+	cur_opq = (val >> ((port % 2) ? 16 : 0)) & 0x0fff;
+	if (cur_opq != 0 && cur_opq == *pre_opq)
+		(*err_opq)++;
+	else
+		*err_opq = 0;
+
+	*pre_opq = cur_opq;
+}
