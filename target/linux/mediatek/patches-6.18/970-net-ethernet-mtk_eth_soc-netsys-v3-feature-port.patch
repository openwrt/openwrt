+static unsigned long mtk_mac_get_caps(struct phylink_config *config,
+				      phy_interface_t interface)
+{
+	struct mtk_mac *mac = container_of(config, struct mtk_mac,
+					   phylink_config);
+	unsigned long caps = MAC_SYM_PAUSE | MAC_ASYM_PAUSE;
+
+	switch (interface) {
+	case PHY_INTERFACE_MODE_USXGMII:
+	case PHY_INTERFACE_MODE_10GKR:
+	case PHY_INTERFACE_MODE_10GBASER:
+		if (!MTK_HAS_CAPS(mac->hw->soc->caps, MTK_USXGMII))
+			return 0;
+		caps |= MAC_100FD | MAC_1000FD | MAC_2500FD |
+			MAC_5000FD | MAC_10000FD;
+		break;
+	case PHY_INTERFACE_MODE_5GBASER:
+		if (!MTK_HAS_CAPS(mac->hw->soc->caps, MTK_USXGMII))
+			return 0;
+		caps |= MAC_5000FD;
+		break;
+	case PHY_INTERFACE_MODE_2500BASEX:
+		caps |= MAC_2500FD;
+		break;
+	case PHY_INTERFACE_MODE_1000BASEX:
+		caps |= MAC_1000FD;
+		break;
+	case PHY_INTERFACE_MODE_SGMII:
+		if (!MTK_HAS_CAPS(mac->hw->soc->caps, MTK_SGMII))
+			return 0;
+		caps |= MAC_10 | MAC_100 | MAC_1000HD | MAC_1000FD;
+		break;
+	case PHY_INTERFACE_MODE_RGMII:
+	case PHY_INTERFACE_MODE_RGMII_ID:
+	case PHY_INTERFACE_MODE_RGMII_RXID:
+	case PHY_INTERFACE_MODE_RGMII_TXID:
+		if (!MTK_HAS_CAPS(mac->hw->soc->caps, MTK_RGMII))
+			return 0;
+		caps |= MAC_10 | MAC_100 | MAC_1000HD | MAC_1000FD;
+		break;
+	case PHY_INTERFACE_MODE_TRGMII:
+		if (!MTK_HAS_CAPS(mac->hw->soc->caps, MTK_TRGMII) || mac->id)
+			return 0;
+		caps |= MAC_1000FD;
+		break;
+	case PHY_INTERFACE_MODE_MII:
+	case PHY_INTERFACE_MODE_GMII:
+	case PHY_INTERFACE_MODE_RMII:
+	case PHY_INTERFACE_MODE_REVMII:
+		caps |= MAC_10 | MAC_100;
+		break;
+	case PHY_INTERFACE_MODE_INTERNAL:
+		if (MTK_HAS_CAPS(mac->hw->soc->caps, MTK_ESW) &&
+		    mac->id == MTK_GMAC1_ID)
+			caps |= MAC_10000FD;
+		else if (MTK_HAS_CAPS(mac->hw->soc->caps, MTK_2P5GPHY) &&
+			 mac->id == MTK_GMAC2_ID)
+			caps |= MAC_2500FD;
+		else
+			return 0;
+		break;
+	default:
+		return 0;
+	}
+
+	/* XGDM-side MACs don't support half-duplex on copper rates. */
+	if (mac->type == MTK_XGDM_TYPE)
+		caps &= ~(MAC_10HD | MAC_100HD | MAC_1000HD);
+
+	return caps;
+}
