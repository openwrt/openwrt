+
+/* Build an skb from a page-pool RX buffer via the XDP fast path.
+ *
+ * Runs the XDP program (no-op when none is attached), and on XDP_PASS wraps
+ * the data in an skb via napi_build_skb() + skb_mark_for_recycle. Returns
+ * the new skb, or NULL if XDP consumed the packet (DROP / REDIRECT / TX)
+ * or napi_build_skb() failed. On NULL return, the handle has already been
+ * recycled (by mtk_xdp_run for non-PASS verdicts, or by this helper on
+ * skb-build failure).
+ *
+ * @xdp_flush is set to true (via the caller-owned pointer) when XDP_REDIRECT
+ * fires, so the caller's end-of-poll xdp_do_flush() runs.
+ */
+static struct sk_buff *
+mtk_build_xdp(struct mtk_eth *eth, struct mtk_rx_ring *ring,
+	      struct mtk_rx_mem *old, void *data, u32 pktlen,
+	      struct net_device *rx_dev, int mac_id, bool *xdp_flush)
+{
+	struct mtk_xdp_channel *ch = ring->xdp;
+	struct sk_buff *skb;
+	struct xdp_buff xdp;
+	u32 ret, metasize;
