+	val |= MTK_RSS_CFG_REQ;
+	mtk_w32(eth, val, rss_base);
+
+	/* Enable RSS */
+	val |= MTK_RSS_EN;
+	mtk_w32(eth, val, rss_base);
+
+	/* Release pause */
+	val &= ~(MTK_RSS_CFG_REQ);
+	mtk_w32(eth, val, rss_base);
+
+	/* Route each RSS ring's RX-done interrupt to its own PDMA group so
+	 * each ring can fire a separate PDMA IRQ line (ring 0 keeps the
+	 * default group programmed in mtk_hw_init). MTK_RSS_RING(x) is
+	 * (x) + 1 in this tree, so index from 0; upstream MTK uses
+	 * MTK_RSS_RING(1..3) with MTK_RSS_RING(x) == (x).
