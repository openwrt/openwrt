 static void __iomem *mtk_pcie_map_bus(struct pci_bus *bus, unsigned int devfn,
-				      int where)
+					  int where)
 {
 	struct mtk_gen3_pcie *pcie = bus->sysdata;
 
 	return pcie->base + PCIE_CFG_OFFSET_ADDR + where;
 }
 
+static bool mtk_pcie_valid_device(struct pci_bus *bus, unsigned int devfn)
+{
+	struct mtk_gen3_pcie *pcie = bus->sysdata;
+
+	/* The root bus contains only the integrated root port at slot 0. */
+	if (pci_is_root_bus(bus))
+		return PCI_SLOT(devfn) == 0;
+
+	/* A config TLP to a failed link can raise an asynchronous SError. */
+	return readl_relaxed(pcie->base + PCIE_LINK_STATUS_REG) &
+		PCIE_PORT_LINKUP;
+}
+
 static int mtk_pcie_config_read(struct pci_bus *bus, unsigned int devfn,
 				int where, int size, u32 *val)
 {
+	struct mtk_gen3_pcie *pcie = bus->sysdata;
+
+	/* The controller registers are unclocked while the port is soft off;
+	 * even the link-status read in mtk_pcie_valid_device() must not run.
+	 */
+	if (unlikely(READ_ONCE(pcie->soft_off))) {
+		*val = U32_MAX;
+		return PCIBIOS_DEVICE_NOT_FOUND;
+	}
+
+	if (!mtk_pcie_valid_device(bus, devfn)) {
+		*val = U32_MAX;
+		return PCIBIOS_DEVICE_NOT_FOUND;
+	}
+
 	mtk_pcie_config_tlp_header(bus, devfn, where, size);
 
 	return pci_generic_config_read32(bus, devfn, where, size, val);
@@ -297,6 +384,14 @@ static int mtk_pcie_config_read(struct p
