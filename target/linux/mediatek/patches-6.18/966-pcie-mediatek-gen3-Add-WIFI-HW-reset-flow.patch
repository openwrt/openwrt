+/**
+ * mtk_pcie_soft_off() - power a PCIe port down without unbinding the driver
+ * @bus: any bus in the affected hierarchy (typically pdev->bus)
+ *
+ * Software-controlled port power cycle, the strongest reset available short
+ * of a board power cycle: move the link towards L2, assert PERST#, save the
+ * root port config space and RC interrupt state, then power the MAC/PHY
+ * down. While the port is soft off, config accessors return
+ * PCIBIOS_DEVICE_NOT_FOUND without touching the (unclocked) controller.
+ *
+ * Endpoint config state is the caller's responsibility
+ * (pci_save_state()/pci_restore_state() around the cycle).
+ *
+ * Return: 0 on success. -ENODEV/-EPERM mean the port was NOT powered off.
+ * Any other error comes from the L2 transition (a dead link cannot reach
+ * L2) and is returned after the port has been powered off regardless.
+ */
+int mtk_pcie_soft_off(struct pci_bus *bus)
+{
+	struct pci_host_bridge *host;
+	struct mtk_gen3_pcie *pcie;
+	struct pci_dev *port;
+	int ret;
+	u32 val;
+
+	if (!bus || !bus->sysdata)
+		return -ENODEV;
+
+	pcie = bus->sysdata;
+	if (READ_ONCE(pcie->soft_off)) {
+		dev_err(pcie->dev, "port is already soft off\n");
+		return -EPERM;
+	}
+
+	host = pci_host_bridge_from_priv(pcie);
+	port = pci_get_slot(host->bus, 0);
+	if (!port) {
+		dev_err(pcie->dev, "no root port on bus\n");
+		return -ENODEV;
+	}
+
+	/* Trigger link to L2; a dead link cannot get there - power off anyway */
+	ret = mtk_pcie_turn_off_link(pcie);
+
+	if (!(pcie->soc->flags & SKIP_PCIE_RSTB)) {
+		/* Hold PERST# asserted across the power cycle */
+		val = readl_relaxed(pcie->base + PCIE_RST_CTRL_REG);
+		val |= PCIE_PE_RSTB;
+		writel_relaxed(val, pcie->base + PCIE_RST_CTRL_REG);
+	}
+
+	pci_save_state(port);
+	pci_dev_put(port);
+
+	/* Set the flag before mtk_pcie_irq_save(): the gated irqchip ops
+	 * serialize on irq_lock, which irq_save takes, so any op acquiring
+	 * the lock afterwards observes soft_off. The controller is still
+	 * clocked here - irq_save's own register reads are safe.
+	 */
+	WRITE_ONCE(pcie->soft_off, true);
+	mtk_pcie_irq_save(pcie);
+
+	/* Drain in-flight config accessors: they run under the global
+	 * pci_lock, which this read also takes. Anything that entered the
+	 * accessor seeing soft_off == false has completed by the time this
+	 * returns; everything later sees the flag (and this read's early
+	 * return through the gate is the publication barrier).
+	 */
+	pci_bus_read_config_dword(host->bus, 0, PCI_VENDOR_ID, &val);
+
+	mtk_pcie_power_down(pcie);
+
+	dev_info(pcie->dev, "pcie soft off done (link off: %d)\n", ret);
+
+	return ret;
+}
