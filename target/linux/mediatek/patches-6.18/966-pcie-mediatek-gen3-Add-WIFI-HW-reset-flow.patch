 }
 
+static struct mtk_pcie_irq *
+mtk_msi_hwirq_get_irq(struct mtk_gen3_pcie *pcie, unsigned long hwirq)
+{
+	if (hwirq >= PCIE_MSI_IRQS_PER_SET)
+		return NULL;
+
+	return &pcie->irqs[pcie->msi_vector_parent[hwirq]];
+}
+
+static int mtk_pcie_set_parent_affinity(struct irq_data *data,
+					unsigned int parent_irq,
+					const struct cpumask *mask, bool force)
+{
+	const struct cpumask *effective_affinity;
+	struct irq_data *port_data;
+	struct irq_chip *port_chip;
+	int ret;
+
+	port_data = irq_get_irq_data(parent_irq);
+	if (!port_data)
+		return -EINVAL;
+
+	port_chip = irq_data_get_irq_chip(port_data);
+	if (!port_chip || !port_chip->irq_set_affinity)
+		return -EINVAL;
+
+	ret = port_chip->irq_set_affinity(port_data, mask, force);
+	if (ret >= 0) {
+		effective_affinity =
+			irq_data_get_effective_affinity_mask(port_data);
+		irq_data_update_effective_affinity(data, effective_affinity);
+	}
+
+	return ret;
+}
+
+static int mtk_pcie_msi_set_affinity(struct irq_data *data,
+				     const struct cpumask *mask, bool force)
+{
+	struct mtk_gen3_pcie *pcie = data->domain->host_data;
+	struct mtk_pcie_irq *parent;
+	unsigned long hwirq;
+
+	hwirq = data->hwirq % PCIE_MSI_IRQS_PER_SET;
+	parent = mtk_msi_hwirq_get_irq(pcie, hwirq);
+	if (!parent)
+		return -EINVAL;
+
+	return mtk_pcie_set_parent_affinity(data, parent->irq, mask, force);
+}
