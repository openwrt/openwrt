 /**
+ * enum mtk_msi_group_type - PCIe controller MSI group type
+ * @MTK_MSI_GROUP0_MERGED: all MSI vectors are merged into group 0
+ * @MTK_MSI_GROUP1_DIRECT: MSI vectors use independent group 1 parent IRQs
+ * @MTK_MSI_GROUP_BOUND: MSI vectors are distributed among multiple groups
+ */
+enum mtk_msi_group_type {
+	MTK_MSI_GROUP0_MERGED,
+	MTK_MSI_GROUP1_DIRECT,
+	MTK_MSI_GROUP_BOUND,
+};
+
+/**
  * struct mtk_msi_set - MSI information for each set
  * @base: IO mapped register base
+ * @enable: IO mapped enable register address
  * @msg_addr: MSI message address
  * @saved_irq_state: IRQ enable state saved at suspend time
  */
 struct mtk_msi_set {
 	void __iomem *base;
+	void __iomem *enable[PCIE_MSI_GROUP_NUM];
 	phys_addr_t msg_addr;
-	u32 saved_irq_state;
+	u32 saved_irq_state[PCIE_MSI_GROUP_NUM];
+};
+
+/**
+ * struct mtk_pcie_irq - PCIe controller interrupt information
+ * @pcie: PCIe controller using this parent interrupt
+ * @irq: IRQ interrupt number
+ * @group: IRQ MSI group number
+ * @mapped_table: IRQ MSI group mapped table
+ */
+struct mtk_pcie_irq {
+	struct mtk_gen3_pcie *pcie;
+	int irq;
+	u8 group;
+	u32 mapped_table;
 };
 
