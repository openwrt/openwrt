From ffdf06ab1b63a85613e809b447217b7db11baf23 Mon Sep 17 00:00:00 2001
From: Murad Rabadanov <the21.21@mail.ru>
Date: Sun, 22 Nov 2026 13:57:23 +0300
Subject: [PATCH] mtd: spinand: detect Wooposit SGM7000I by its ONFI page

Some WR3000K units return zeros for READ ID. Probe their ONFI
parameter page after ID matching fails. Require the Wooposit model
and vendor fields and a valid CRC before selecting the geometry.

This part uses a three-byte cache address. Shift the column by eight
bits for cache reads, including reads of the bad-block marker.

Link: https://github.com/openwrt/openwrt/issues/23842
Assisted-by: OpenAI Codex
Signed-off-by: Murad Rabadanov <the21.21@mail.ru>

--- a/drivers/mtd/nand/spi/core.c
+++ b/drivers/mtd/nand/spi/core.c
@@ -387,6 +387,8 @@ static int spinand_load_page_op(struct s
 	return spi_mem_exec_op(spinand->spimem, &op);
 }
 
+static const struct spinand_manufacturer wooposit_onfi_manufacturer;
+
 static int spinand_read_from_cache_op(struct spinand_device *spinand,
 				      const struct nand_page_io_req *req)
 {
@@ -425,7 +427,12 @@ static int spinand_read_from_cache_op(st
 		column |= req->pos.plane << fls(nanddev_page_size(nand));
 
 	while (nbytes) {
-		ret = spi_mem_dirmap_read(rdesc, column, nbytes, buf);
+		u32 address = column;
+
+		if (spinand->manufacturer == &wooposit_onfi_manufacturer)
+			address <<= 8;
+
+		ret = spi_mem_dirmap_read(rdesc, address, nbytes, buf);
 		if (ret < 0)
 			return ret;
 
@@ -1527,6 +1534,150 @@ int spinand_match_and_init(struct spinan
 	return -ENOTSUPP;
 }
 
+static SPINAND_OP_VARIANTS(wooposit_read_cache,
+		SPI_MEM_OP(SPI_MEM_OP_CMD(0x03, 1),
+			   SPI_MEM_OP_ADDR(3, 0, 1),
+			   SPI_MEM_OP_NO_DUMMY,
+			   SPI_MEM_OP_DATA_IN(0, NULL, 1)));
+
+static SPINAND_OP_VARIANTS(wooposit_write_cache,
+		SPINAND_PROG_LOAD_1S_1S_1S_OP(true, 0, NULL, 0));
+
+static SPINAND_OP_VARIANTS(wooposit_update_cache,
+		SPINAND_PROG_LOAD_1S_1S_1S_OP(false, 0, NULL, 0));
+
+static int wooposit_ooblayout_ecc(struct mtd_info *mtd, int section,
+				 struct mtd_oob_region *region)
+{
+	return -ERANGE;
+}
+
+static int wooposit_ooblayout_free(struct mtd_info *mtd, int section,
+				  struct mtd_oob_region *region)
+{
+	if (section)
+		return -ERANGE;
+
+	region->offset = 2;
+	region->length = mtd->oobsize - 2;
+	return 0;
+}
+
+static const struct mtd_ooblayout_ops wooposit_onfi_ooblayout = {
+	.ecc = wooposit_ooblayout_ecc,
+	.free = wooposit_ooblayout_free,
+};
+
+static const struct spinand_info wooposit_onfi_table[] = {
+	SPINAND_INFO("SGM7000I-S24W4GH",
+		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE, 0x01),
+		     NAND_MEMORG(1, 2048, 64, 64, 1024, 20, 1, 1, 1),
+		     NAND_ECCREQ(8, 512),
+		     SPINAND_INFO_OP_VARIANTS(&wooposit_read_cache,
+					      &wooposit_write_cache,
+					      &wooposit_update_cache),
+		     0, SPINAND_ECCINFO(&wooposit_onfi_ooblayout, NULL)),
+};
+
+static const struct spinand_manufacturer_ops wooposit_onfi_ops = {};
+
+static const struct spinand_manufacturer wooposit_onfi_manufacturer = {
+	.id = 0xea,
+	.name = "Wooposit",
+	.chips = wooposit_onfi_table,
+	.nchips = ARRAY_SIZE(wooposit_onfi_table),
+	.ops = &wooposit_onfi_ops,
+};
+
+/* ONFI uses polynomial 0x8005 and seed 0x4f4e. */
+static u16 wooposit_onfi_crc16(const u8 *data, size_t len)
+{
+	u16 crc = 0x4f4e;
+	int bit;
+
+	while (len--) {
+		crc ^= (u16)*data++ << 8;
+		for (bit = 0; bit < 8; bit++)
+			crc = (crc << 1) ^ ((crc & 0x8000) ? 0x8005 : 0);
+	}
+
+	return crc;
+}
+
+static int spinand_wooposit_onfi_detect(struct spinand_device *spinand)
+{
+	struct nand_page_io_req request = { .pos.page = 1 };
+	u8 prefix[3];
+	u8 cfg, status;
+	int ret, restore;
+	struct spi_mem_op op;
+	u8 *raw;
+
+	raw = kmalloc(256, GFP_KERNEL);
+
+	if (!raw)
+		return -ENOMEM;
+
+	op = (struct spi_mem_op)SPI_MEM_OP(SPI_MEM_OP_CMD(0x03, 1),
+					   SPI_MEM_OP_ADDR(3, 0x300, 1),
+					   SPI_MEM_OP_NO_DUMMY,
+					   SPI_MEM_OP_DATA_IN(256, raw, 1));
+
+	ret = spinand_reset_op(spinand);
+	if (ret)
+		goto out_free;
+
+	ret = spinand_read_reg_op(spinand, REG_CFG, &cfg);
+	if (ret)
+		goto out_free;
+
+	ret = spinand_write_reg_op(spinand, REG_CFG, cfg | BIT(6));
+	if (ret)
+		goto out_free;
+
+	ret = spinand_load_page_op(spinand, &request);
+	if (!ret)
+		ret = spinand_wait(spinand, SPINAND_READ_INITIAL_DELAY_US,
+				   SPINAND_READ_POLL_DELAY_US, &status);
+	if (!ret)
+		ret = spi_mem_exec_op(spinand->spimem, &op);
+
+	restore = spinand_write_reg_op(spinand, REG_CFG, cfg);
+	if (!ret)
+		ret = restore;
+	if (ret)
+		goto out_free;
+
+	/* The cached parameter page wraps its first three bytes to the end. */
+	if (memcmp(raw + 253, "ONF", 3) || raw[0] != 'I' ||
+	    memcmp(raw + 29, "Wooposit", 8) ||
+	    memcmp(raw + 41, "SGM7000I-S24W4GH", 16) || raw[61] != 0xea) {
+		ret = -ENODEV;
+		goto out_free;
+	}
+
+	memcpy(prefix, raw + 253, sizeof(prefix));
+	memmove(raw + sizeof(prefix), raw, 253);
+	memcpy(raw, prefix, sizeof(prefix));
+
+	if (wooposit_onfi_crc16(raw, 254) != (raw[254] | ((u16)raw[255] << 8))) {
+		ret = -EBADMSG;
+		goto out_free;
+	}
+
+	spinand->id.data[0] = 0xea;
+	spinand->id.data[1] = 0x01;
+	ret = spinand_match_and_init(spinand, wooposit_onfi_table,
+				     ARRAY_SIZE(wooposit_onfi_table),
+				     SPINAND_READID_METHOD_OPCODE);
+	if (!ret)
+		spinand->manufacturer = &wooposit_onfi_manufacturer;
+
+out_free:
+	kfree(raw);
+	return ret;
+}
+
 static int spinand_detect(struct spinand_device *spinand)
 {
 	struct device *dev = &spinand->spimem->spi->dev;
@@ -1538,6 +1689,8 @@ static int spinand_detect(struct spinand
 		return ret;
 
 	ret = spinand_id_detect(spinand);
+	if (ret)
+		ret = spinand_wooposit_onfi_detect(spinand);
 	if (ret) {
 		dev_err(dev, "unknown raw ID %*phN\n", SPINAND_MAX_ID_LEN,
 			spinand->id.data);
