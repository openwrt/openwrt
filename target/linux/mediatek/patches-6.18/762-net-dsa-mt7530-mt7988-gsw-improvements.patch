+/* The built-in GPHYs can be unresponsive on MDIO for a while after
+ * mt7988_setup()'s reset_control cycle of the whole switch block (NOT the
+ * SYS_CTRL write: per the MT7988A IODS, SYS_CTRL has no PHY_RST bit — bit 2
+ * is unimplemented on this GSW). If the MDIO bus is registered inside that
+ * window, the bus scan reads PHY ID 0x00000000, mtk-ge-soc never matches,
+ * and phy_attach_direct() silently falls back to genphy — leaving the GPHYs
+ * without efuse calibration (dead RX at 1000BASE-T).
+ *
+ * Wait until PHY 0 returns the real MediaTek OUI word. A loose
+ * "nonzero and not 0xffff" check is NOT sufficient: the indirect-access
+ * (IAC) data register can hold stale junk latched from the bootloader's
+ * own switch accesses, which such a check accepts on the first poll.
+ * Log unconditionally so boot logs document the bring-up timing.
+ */
+static void
+mt7988_wait_internal_phys(struct mt7530_priv *priv)
+{
+	const unsigned int max_tries = 250;	/* 250 * 20ms = 5s */
+	unsigned int tries = 1;
+	int id1, id2 = 0;
+
+	for (;;) {
+		id1 = priv->info->phy_read_c22(priv, 0, MII_PHYSID1);
+		if (id1 == 0x03a2) {
+			/* Demand the second ID word too: a stale latch can
+			 * only replay one value, not two different ones.
+			 * 0x94xx covers MT7988 (0x9481) and Airoha (0x94xx).
+			 */
+			id2 = priv->info->phy_read_c22(priv, 0, MII_PHYSID2);
+			if (id2 >= 0 && (id2 & 0xff00) == 0x9400)
+				break;
+		}
+		if (++tries > max_tries)
+			break;
+		msleep(20);
+	}
+
+	if (id1 == 0x03a2 && (id2 & 0xff00) == 0x9400)
+		dev_info(priv->dev,
+			 "internal PHY 0 id 0x%04x%04x after %u poll(s)\n",
+			 id1, id2 < 0 ? 0 : id2, tries);
+	else
+		dev_warn(priv->dev,
+			 "internal PHY 0 not ready after %u polls (last read: 0x%x)\n",
+			 max_tries, id1);
+}
