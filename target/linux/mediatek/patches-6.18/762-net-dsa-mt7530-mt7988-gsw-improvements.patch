 static int
 mt7530_setup_mdio(struct mt7530_priv *priv)
 {
@@ -2341,11 +2371,30 @@ mt7530_setup_mdio(struct mt7530_priv *pr
 	if (priv->irq_domain && !mnp)
 		mt7530_setup_mdio_irq(priv);
 
+	if (priv->id == ID_MT7988 || priv->id == ID_AN7583)
+		mt7988_wait_internal_phys(priv);
+
 	ret = devm_of_mdiobus_register(dev, bus, mnp);
 	if (ret) {
 		dev_err(dev, "failed to register MDIO bus: %d\n", ret);
 		if (priv->irq_domain && !mnp)
 			mt7530_free_mdio_irq(priv);
+	} else if (priv->id == ID_MT7988 || priv->id == ID_AN7583) {
+		/* Diagnostic: compare what the bus scan stored against a
+		 * live read taken right now through the same accessor.
+		 * stored==0 with a correct live id means the scan's reads
+		 * diverged; stored correct with genphy bound means the
+		 * specific driver's probe failed silently (-ENODEV /
+		 * -EPROBE_DEFER are logged at debug level only).
+		 */
+		struct phy_device *phy0 = mdiobus_get_phy(bus, 0);
+
+		dev_info(dev,
+			 "post-scan: phy0 %s, stored id 0x%08x, live id 0x%04x%04x\n",
+			 phy0 ? dev_name(&phy0->mdio.dev) : "missing",
+			 phy0 ? phy0->phy_id : 0xffffffff,
+			 (u16)priv->info->phy_read_c22(priv, 0, MII_PHYSID1),
+			 (u16)priv->info->phy_read_c22(priv, 0, MII_PHYSID2));
 	}
 
