+static int mxl862xx_legacy_pcs_config(struct phylink_pcs *pcs,
+				      unsigned int neg_mode,
+			       phy_interface_t interface,
+			       const unsigned long *advertising,
+			       bool permit_pause_to_mac)
+{
+	struct mxl862xx_pcs *mpcs = pcs_to_mxl862xx_pcs(pcs);
+	int ret;
+
+	mpcs->neg_mode = neg_mode;
+	if (advertising)
+		linkmode_copy(mpcs->advertising, advertising);
+
+	ret = mxl862xx_usxgmii_pcs_encode_advertisement(interface, mpcs->advertising);
+	if (ret < 0)
+		return ret;
+
+	/* On this firmware the module-facing SerDes lane keeps its
+	 * power-on protocol (USXGMII toward the optional copper PHY)
+	 * until SYS_MISC_SFP_SET retargets it, so an SFP module can
+	 * never frame without this. Request firmware auto-rate for the
+	 * SFP-class modes. The CPU/DSA conduit lane is left alone: its
+	 * fixed 10gbase-r link is firmware-managed and working.
+	 */
+	if (interface != mpcs->interface) {
+		struct dsa_port *dp = dsa_to_port(mpcs->priv->ds, mpcs->port);
+		bool conduit = dp && (dp->type == DSA_PORT_TYPE_CPU ||
+				      dp->type == DSA_PORT_TYPE_DSA);
+
+		switch (interface) {
+		case PHY_INTERFACE_MODE_SGMII:
+		case PHY_INTERFACE_MODE_1000BASEX:
+		case PHY_INTERFACE_MODE_2500BASEX:
+		case PHY_INTERFACE_MODE_10GBASER:
+			if (conduit)
+				break;
+
+			ret = mxl862xx_legacy_sfp_lane_auto(mpcs, interface);
+			if (ret)
+				return ret;
+			break;
+		default:
+			break;
+		}
+	}
+
+	mpcs->interface = interface;
+
+	return 0;
+}
