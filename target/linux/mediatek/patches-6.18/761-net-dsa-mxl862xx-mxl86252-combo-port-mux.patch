+		/* If 802.3z AN will not complete against a module that
+		 * expects SerDes-side autoneg, ANEG_1G is the fallback.
+		 */
+		sfp.speed = MXL862XX_SFP_PORT_SPEED_BASEX_1000;
+		break;
+	case PHY_INTERFACE_MODE_2500BASEX:
+		sfp.speed = MXL862XX_SFP_PORT_SPEED_BASEX_2500;
