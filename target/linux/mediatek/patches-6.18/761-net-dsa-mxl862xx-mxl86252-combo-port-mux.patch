+	if ((stat & MXL_AN_STAT_REQ_BITS) != MXL_AN_STAT_REQ_BITS)
+		return 0;
+	if (stat & MXL_AN_STAT_BAD_BITS)
+		return 0;
+	if ((ctrl & MXL_AN_CTRL_REQ_BITS) != MXL_AN_CTRL_REQ_BITS)
+		return 0;
+	if (ctrl & MXL_AN_CTRL_BAD_BITS)
+		return 0;
