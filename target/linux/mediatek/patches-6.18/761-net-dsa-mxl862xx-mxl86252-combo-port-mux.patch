+static void mxl862xx_legacy_pcs_get_state(struct phylink_pcs *pcs,
+					  unsigned int neg_mode,
+				   struct phylink_link_state *state)
+{
+	struct mxl862xx_pcs *mpcs = pcs_to_mxl862xx_pcs(pcs);
+	struct mxl862xx_priv *priv = mpcs->priv;
+	struct phy_device *phydev;
+	struct dsa_port *dp;
+	int phy_up;
+
+	/* Keep failures and unresolved firmware replies pessimistically down. */
+	state->link = false;
+	state->an_complete = false;
+	state->speed = SPEED_UNKNOWN;
+	state->duplex = DUPLEX_UNKNOWN;
+
+	dp = dsa_to_port(priv->ds, mpcs->port);
+	phydev = (dp && dp->user) ? dp->user->phydev : NULL;
+
+	/* Direct SFP ports have no PHY, so sample firmware unconditionally.
+	 * With an attached PHY, only query firmware after the PHY's line side
+	 * is up. In particular, do not mistake a negative MDIO error for true.
+	 */
+	phy_up = mxl862xx_legacy_pcs_phy_baser_up(phydev);
+	if (!phydev || phy_up > 0)
+		mxl862xx_refresh_state(mpcs, state);
+	else if (phy_up < 0)
+		dev_warn_ratelimited(priv->ds->dev,
+				     "port %d: PHY status read failed: %d\n",
+				     mpcs->port, phy_up);
+
+	linkmode_copy(state->advertising, mpcs->advertising);
+}
