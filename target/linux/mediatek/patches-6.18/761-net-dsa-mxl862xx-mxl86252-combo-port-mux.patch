+#define MXL_AN_STAT_REQ_BITS	(BIT(5) | BIT(3) | BIT(2))  /* AN_COMPLETE | AN_ABLE | LINK */
+#define MXL_AN_STAT_BAD_BITS	(BIT(4))                     /* REMOTE_FAULT */
+#define MXL_AN_CTRL_REQ_BITS	(BIT(12))                    /* AN_ENABLE */
+#define MXL_AN_CTRL_BAD_BITS	(BIT(15) | BIT(9))           /* RESET | RESTART_AN */
