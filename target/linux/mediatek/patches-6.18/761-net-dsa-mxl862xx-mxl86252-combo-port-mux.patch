+	ret = MXL862XX_API_WRITE(priv, SYS_MISC_SFP_SET, sfp);
+	dev_info(priv->ds->dev,
+		 "port %d: SFP_SET mode %u speed %u on SerDes %u for %s: %d\n",
+		 mpcs->port, sfp.mode, sfp.speed, mpcs->serdes_id,
+		 phy_modes(interface), ret);
