+#define MXL862XX_MUX_POLL_INTERVAL	msecs_to_jiffies(1000)
+
+static void sfp_monitor_work_func(struct work_struct *work)
+{
+	struct combo_port_mux *mux =
+		container_of(work, struct combo_port_mux, sfp_monitor_work.work);
+	struct dsa_switch *ds = mux->dp->ds;
+	unsigned int new_channel;
+	int sfp_present;
+
+	if (IS_ERR(mux->mod_def0_gpio) || IS_ERR(mux->chan_sel_gpio))
+		goto reschedule;
+
+	sfp_present = gpiod_get_value_cansleep(mux->mod_def0_gpio);
+	if (sfp_present < 0)
+		goto reschedule;
+
+	new_channel = sfp_present ? mux->sfp_present_channel :
+				    !mux->sfp_present_channel;
+
+	if (new_channel >= ARRAY_SIZE(mux->data) || !mux->data[new_channel])
+		goto reschedule;
+
+	if (READ_ONCE(mux->channel) == new_channel)
+		goto reschedule;
+
+	gpiod_set_value_cansleep(mux->chan_sel_gpio, new_channel);
+	WRITE_ONCE(mux->channel, new_channel);
+
+	dev_info(ds->dev, "dsa mux: switch to channel%u\n", new_channel);
+
+reschedule:
+	mod_delayed_work(system_wq, &mux->sfp_monitor_work,
+			 MXL862XX_MUX_POLL_INTERVAL);
+}
