+		mxl862xx_free_mux_channel(mux->data[i]);
+		mux->data[i] = NULL;
+	}
+}
+
+static int ds_add_mux_channel(struct combo_port_mux *mux, struct device_node *np)
+{
+	struct dsa_switch *ds = mux->dp->ds;
+	struct dp_mux_data *data;
+	phy_interface_t phy_mode;
+	u32 id;
+	int err;
+
+	err = of_property_read_u32(np, "reg", &id);
+	if (err) {
+		dev_err(ds->dev, "missing mux channel id\n");
+		return err;
+	}
+
+	if (id >= ARRAY_SIZE(mux->data)) {
+		dev_err(ds->dev, "%d is not a valid mux channel id\n", id);
+		return -EINVAL;
+	}
+
+	if (mux->data[id]) {
+		dev_err(ds->dev, "duplicate mux channel id %u\n", id);
+		return -EEXIST;
+	}
+
+	data = kzalloc(sizeof(*data), GFP_KERNEL);
+	if (unlikely(!data)) {
+		dev_err(ds->dev, "failed to create mux data structure\n");
+		return -ENOMEM;
+	}
+
+	err = of_get_phy_mode(np, &phy_mode);
+	if (err) {
+		dev_err(ds->dev, "incorrect phy-mode\n");
+		goto err_free_data;
+	}
+
+	data->of_node = of_node_get(np);
+	data->phy_mode = phy_mode;
+	mux->data[id] = data;
+
+	return 0;
+
+err_free_data:
+	kfree(data);
+	return err;
+}
+
+static int ds_add_mux(struct mxl862xx_priv *priv, struct device_node *np)
+{
+	struct device *dev = priv->ds->dev;
+	struct device_node *child;
+	struct fwnode_handle *fwnode = of_fwnode_handle(np);
+	struct combo_port_mux *mux;
+	u32 id;
+	int err;
+
+	err = of_property_read_u32(np, "reg", &id);
+	if (err) {
+		dev_err(dev, "missing attach dp id\n");
+		return err;
+	}
+
+	if (id >= MXL862XX_MAX_PORTS) {
+		dev_err(dev, "%d is not a valid attach dp id\n", id);
+		return -EINVAL;
+	}
+
+	if (priv->ds_mux[id]) {
+		dev_err(dev, "duplicate mux for dp id %u\n", id);
+		return -EEXIST;
+	}
+
+	mux = kzalloc(sizeof(*mux), GFP_KERNEL);
+	if (unlikely(!mux)) {
+		dev_err(dev, "failed to create mux structure\n");
+		return -ENOMEM;
+	}
+
+	mux->dp = dsa_to_port(priv->ds, id);
+	mux->orig_of_node = mux->dp->dn;
+
+	mux->mod_def0_gpio = fwnode_gpiod_get_index(fwnode, "mod-def0", 0,
+						    GPIOD_IN,
+						    "?");
+
+	if (IS_ERR(mux->mod_def0_gpio)) {
+		dev_err(dev, "failed to request gpio for mod-def0\n");
+		err = PTR_ERR(mux->mod_def0_gpio);
+		goto err_free_mux;
+	}
+
+	mux->chan_sel_gpio = fwnode_gpiod_get_index(fwnode, "chan-sel", 0,
+						    GPIOD_OUT_LOW, "?");
+
+	if (IS_ERR(mux->chan_sel_gpio)) {
+		dev_err(dev, "failed to request gpio for chan-sel\n");
+		err = PTR_ERR(mux->chan_sel_gpio);
+		goto err_put_mod_def0;
+	}
+
+	of_property_read_u32(np, "sfp-present-channel",
+			     &mux->sfp_present_channel);
+	if (mux->sfp_present_channel >= ARRAY_SIZE(mux->data)) {
+		dev_err(dev, "invalid sfp-present-channel %u\n",
+			mux->sfp_present_channel);
+		err = -EINVAL;
+		goto err_put_chan_sel;
+	}
+
+	priv->ds_mux[id] = mux;
+
+	/* configure default channel to 10G PHY */
+	mux->channel = !mux->sfp_present_channel;
+	gpiod_set_value_cansleep(mux->chan_sel_gpio, mux->channel);
+
+	for_each_child_of_node(np, child) {
+		err = ds_add_mux_channel(mux, child);
+		if (err) {
+			dev_err(dev, "failed to add ds_mux\n");
+			of_node_put(child);
+			goto err_put_chan_sel;
+		}
+	}
+
+	if (!mux->data[0] || !mux->data[1]) {
+		dev_err(dev, "mux needs channel@0 and channel@1\n");
+		err = -EINVAL;
+		goto err_put_chan_sel;
+	}
+
+	INIT_DELAYED_WORK(&mux->sfp_monitor_work, sfp_monitor_work_func);
+	mod_delayed_work(system_wq, &mux->sfp_monitor_work, msecs_to_jiffies(3000));
+
+	return 0;
+
+err_put_chan_sel:
+	mxl862xx_free_mux_channels(mux);
+	gpiod_put(mux->chan_sel_gpio);
+err_put_mod_def0:
+	gpiod_put(mux->mod_def0_gpio);
+err_free_mux:
+	kfree(mux);
+	priv->ds_mux[id] = NULL;
+	return err;
+}
+
+static void mxl862xx_release_mux(struct mxl862xx_priv *priv, int port_id)
+{
+	struct combo_port_mux *mux = priv->ds_mux[port_id];
+
+	if (!mux)
+		return;
+
+	cancel_delayed_work_sync(&mux->sfp_monitor_work);
+
+	if (!IS_ERR_OR_NULL(mux->mod_def0_gpio))
+		gpiod_put(mux->mod_def0_gpio);
+
+	if (!IS_ERR_OR_NULL(mux->chan_sel_gpio))
+		gpiod_put(mux->chan_sel_gpio);
+
+	mxl862xx_free_mux_channels(mux);
+	kfree(mux);
+	priv->ds_mux[port_id] = NULL;
+}
+
+static void mxl862xx_release_all_muxes(struct mxl862xx_priv *priv)
+{
+	for (int i = 0; i < MXL862XX_MAX_PORTS; i++)
+		mxl862xx_release_mux(priv, i);
+}
+
+static void mxl862xx_stop_work(struct mxl862xx_priv *priv, int num_ports)
+{
+	set_bit(MXL862XX_FLAG_WORK_STOPPED, &priv->flags);
+	cancel_delayed_work_sync(&priv->stats_work);
+
+	for (int i = 0; i < num_ports; i++)
+		cancel_work_sync(&priv->ports[i].host_flood_work);
+
+	cancel_work_sync(&priv->crc_err_work);
+}
+
+static void mxl862xx_parse_muxes(struct mxl862xx_priv *priv)
+{
+	struct device *dev = priv->ds->dev;
+	struct device_node *mux_np;
+	struct device_node *child;
+	int ret;
+
+	mux_np = of_get_child_by_name(priv->ds->dev->of_node, "ds-mux-bus");
+	if (!mux_np)
+		return;
+
+	if (!of_device_is_available(mux_np)) {
+		of_node_put(mux_np);
+		return;
+	}
+
+	for_each_available_child_of_node(mux_np, child) {
+		if (!of_device_is_compatible(child, "mxl862xx,ds-mux"))
+			continue;
+
+		ret = ds_add_mux(priv, child);
+		if (ret)
+			dev_err(dev, "failed to add mux %pOF: %pe\n",
+				child, ERR_PTR(ret));
+	}
+
+	of_node_put(mux_np);
+}
