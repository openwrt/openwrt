. /lib/functions/netdev-name.sh

set_netdev_labels() {
	local dir
	local phase

	# park: move every mislabelled interface to a temporary name first,
	# so that swaps (e.g. eth0 <-> eth1) cannot collide
	# rename: give every interface its final name
	for phase in park rename; do
		for dir in /sys/class/net/*; do
			netdev_name_set "$dir" "$phase"
		done
	done
}

set_netdev_label_event() {
	netdev_name_set "/sys$DEVPATH"
}

boot_hook_add preinit_main set_netdev_labels
boot_hook_add preinit_netdev set_netdev_label_event
