. /lib/functions.sh

case "$(board_name)" in
	edgepi,e87n)
		# Requested factory login for fresh images: root / password.
		printf '%s\n%s\n' 'password' 'password' | passwd root >/dev/null 2>&1
		uci -q set system.@system[0].hostname='EdgePi E87N'
		uci -q set system.@system[0].zonename='Asia/Shanghai'
		uci -q set system.@system[0].timezone='CST-8'
		uci -q delete system.ntp.server
		uci -q add_list system.ntp.server='ntp1.aliyun.com'
		uci -q add_list system.ntp.server='ntp2.aliyun.com'
		uci -q add_list system.ntp.server='ntp3.aliyun.com'
		uci -q commit system
		if [ -f /usr/share/e87n/banner ]; then
			cp /usr/share/e87n/banner /etc/banner
			build_epoch="$(sed -n 's/^OPENWRT_BUILD_DATE="\([0-9][0-9]*\)"$/\1/p' /usr/lib/os-release)"
			build_date="$(TZ='CST-8' date -d "@$build_epoch" '+%Y-%m-%d' 2>/dev/null)"
			[ -n "$build_date" ] || build_date="$build_epoch"
			(
				. /etc/openwrt_release
				build_name="${DISTRIB_ID:-OpenWrt} ${DISTRIB_RELEASE:-SNAPSHOT}"
				sed -i "s|@E87N_BUILD_INFO@|$build_name, $build_date By ZJJCKA|" /etc/banner
			)
		fi

		# Keep the prefix explicit. On current netifd an address without a
		# prefix becomes /32, which prevents dnsmasq from deriving a pool.
		uci -q set network.lan.ipaddr='192.168.88.1/24'
		uci -q delete network.lan.dns
		uci -q add_list network.lan.dns='223.5.5.5'
		uci -q add_list network.lan.dns='223.6.6.6'
		uci -q commit network

		# Allocate the 192.168.88.2-254 pool from the lowest free address.
		uci -q set 'dhcp.@dnsmasq[0].sequential_ip=1'
		uci -q set 'dhcp.lan.ignore=0'
		uci -q set 'dhcp.lan.dhcpv4=server'
		uci -q set 'dhcp.lan.start=2'
		uci -q set 'dhcp.lan.limit=253'
		# Keep AliDNS as the router fallback in WAN, 5G and LAN-only modes.
		uci -q set 'dhcp.@dnsmasq[0].noresolv=1'
		uci -q delete 'dhcp.@dnsmasq[0].server'
		uci -q add_list 'dhcp.@dnsmasq[0].server=223.5.5.5'
		uci -q add_list 'dhcp.@dnsmasq[0].server=223.6.6.6'
		uci -q commit dhcp

		# Keep storage management headless: block-mount provides the backend
		# needed by NVMe/Samba, while luci-app-mounts stays excluded from E87N.
		# Mount recognised, supported filesystems below /mnt without formatting
		# or modifying their partition tables.
		if ! uci -q get 'fstab.@global[0]' >/dev/null; then
			uci -q add fstab global >/dev/null
		fi
		uci -q set 'fstab.@global[0].anon_swap=0'
		uci -q set 'fstab.@global[0].anon_mount=1'
		uci -q set 'fstab.@global[0].auto_swap=0'
		uci -q set 'fstab.@global[0].auto_mount=1'
		uci -q set 'fstab.@global[0].delay_root=5'
		uci -q set 'fstab.@global[0].check_fs=0'
		uci -q commit fstab
		/etc/init.d/fstab enable >/dev/null 2>&1 || true

		# Fresh E87N images expose the first NVMe partition as an open LAN
		# share. anon_mount above uses the stable device-derived target
		# /mnt/nvme0n1p1; do not add another share when a preserved Samba
		# configuration already contains one.
		if [ -f /etc/config/samba4 ] && \
		   ! uci -q show samba4 | grep -q '=sambashare$'; then
			samba_share="$(uci -q add samba4 sambashare)"
			if [ -n "$samba_share" ]; then
				uci -q set "samba4.$samba_share.name=share"
				uci -q set "samba4.$samba_share.path=/mnt/nvme0n1p1"
				uci -q set "samba4.$samba_share.browseable=yes"
				uci -q set "samba4.$samba_share.read_only=no"
				uci -q set "samba4.$samba_share.force_root=1"
				uci -q set "samba4.$samba_share.guest_ok=yes"
				uci -q set "samba4.$samba_share.guest_only=no"
				uci -q set "samba4.$samba_share.inherit_owner=no"
				uci -q set "samba4.$samba_share.create_mask=0666"
				uci -q set "samba4.$samba_share.dir_mask=0777"
				uci -q commit samba4
			fi
		fi
		/etc/init.d/samba4 enable >/dev/null 2>&1 || true

		uci -q set 'luci.themes.Argon=/luci-static/argon'
		uci -q set 'luci.main.mediaurlbase=/luci-static/argon'
		# LuCI exposes Simplified Chinese through the zh_cn UCI key.
		uci -q set 'luci.main.lang=zh_cn'
		uci -q delete luci.themes.Bootstrap
		uci -q commit luci

		uci -q set 'argon.@global[0].online_wallpaper=bing'
		uci -q set 'argon.@global[0].mode=normal'
		uci -q set 'argon.@global[0].primary=#5e72e4'
		uci -q set 'argon.@global[0].transparency=0'
		uci -q set 'argon.@global[0].blur=0'
		uci -q set 'argon.@global[0].dark_primary=#483d8b'
		uci -q set 'argon.@global[0].transparency_dark=0'
		uci -q set 'argon.@global[0].blur_dark=0'
		uci -q commit argon

		uci -q set firewall.@defaults[0].flow_offloading='1'
		uci -q set firewall.@defaults[0].flow_offloading_hw='1'
		uci -q commit firewall

		# E87N is commonly used behind a 5G modem whose uplink address is
		# private. Enable the complete UPnP/PCP service set on fresh installs
		# and allow that valid CPE topology without weakening the port ACLs.
		uci -q set 'upnpd.config.enabled=1'
		uci -q set 'upnpd.config.enable_upnp=1'
		uci -q set 'upnpd.config.enable_natpmp=1'
		uci -q set 'upnpd.config.ext_allow_private_ipv4=1'
		uci -q commit upnpd
		/etc/init.d/miniupnpd enable >/dev/null 2>&1 || true

		# Source-only feeds are not published by downloads.openwrt.org. Keep
		# their packages in the image, but never expose dead runtime indexes.
		for feed_file in \
			/etc/apk/repositories.d/distfeeds.list \
			/etc/opkg/distfeeds.conf; do
			[ -f "$feed_file" ] || continue
			sed -i \
				-e '\|/openclash\(/packages\.adb\)\?$|d' \
				-e '\|/passwall_luci\(/packages\.adb\)\?$|d' \
				-e '\|/passwall_packages\(/packages\.adb\)\?$|d' \
				"$feed_file"
		done

		# The pinned OpenClash feed registers its Services menu at order 50.
		# Put it ahead of Passwall only on E87N; other boards keep feed defaults.
		openclash_controller='/usr/lib/lua/luci/controller/openclash.lua'
		if [ -f "$openclash_controller" ]; then
			sed -i 's/_("OpenClash"), 50)/_("OpenClash"), -5)/' "$openclash_controller"
			rm -f /tmp/luci-indexcache
		fi

		uci -q set openclash.config.core_version='arm64'
		uci -q commit openclash

		# OpenClash preserves /etc/openclash across sysupgrade, including an
		# older downloaded core. Activate the alpha core pinned in this E87N
		# image even when the user keeps settings during the firmware upgrade.
		packaged_meta_core='/rom/etc/openclash/core/clash_meta'
		active_meta_core='/etc/openclash/core/clash_meta'
		if [ -x "$packaged_meta_core" ]; then
			mkdir -p /etc/openclash/core
			if ! cmp -s "$packaged_meta_core" "$active_meta_core"; then
				core_tmp="${active_meta_core}.e87n-new"
				if cp "$packaged_meta_core" "$core_tmp"; then
					chmod 0755 "$core_tmp"
					mv -f "$core_tmp" "$active_meta_core"
				else
					rm -f "$core_tmp"
				fi
			fi
		fi
		;;
esac

exit 0
