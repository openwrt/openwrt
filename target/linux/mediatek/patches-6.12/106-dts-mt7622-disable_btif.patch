From 50416c18dd309fec75b6911221905cd0c0139b25 Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Thu, 21 Dec 2023 21:20:17 +0100
Subject: [PATCH] arm64: dts: mediatek: mt7622: do not enable btif

Do not enable the Bluetooth interface (btif) in the device trees of the
MT7622 RFB1 and the BananaPi BPI-R64.
---
--- a/arch/arm64/boot/dts/mediatek/mt7622-bananapi-bpi-r64.dts
+++ b/arch/arm64/boot/dts/mediatek/mt7622-bananapi-bpi-r64.dts
@@ -109,10 +109,6 @@
 	status = "disabled";
 };
 
-&btif {
-	status = "okay";
-};
-
 &cir {
 	pinctrl-names = "default";
 	pinctrl-0 = <&irrx_pins>;
--- a/arch/arm64/boot/dts/mediatek/mt7622-rfb1.dts
+++ b/arch/arm64/boot/dts/mediatek/mt7622-rfb1.dts
@@ -90,10 +90,6 @@
 	status = "disabled";
 };
 
-&btif {
-	status = "okay";
-};
-
 &cir {
 	pinctrl-names = "default";
 	pinctrl-0 = <&irrx_pins>;
