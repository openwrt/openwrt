From f9a28d216d65b55e1139e2c73d016c5e77d7fe0b Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Sat, 4 Dec 2021 22:46:00 +0100
Subject: [PATCH] arm64: dts: mediatek: mt7622-rfb1: enable BMT

Enable the MediaTek bad block management table (mediatek,bmt-v2) for the
NAND flash of the MT7622 RFB1.
---
--- a/arch/arm64/boot/dts/mediatek/mt7622-rfb1.dts
+++ b/arch/arm64/boot/dts/mediatek/mt7622-rfb1.dts
@@ -572,6 +572,7 @@
 		spi-tx-bus-width = <4>;
 		spi-rx-bus-width = <4>;
 		nand-ecc-engine = <&snfi>;
+		mediatek,bmt-v2;
 
 		partitions {
 			compatible = "fixed-partitions";
