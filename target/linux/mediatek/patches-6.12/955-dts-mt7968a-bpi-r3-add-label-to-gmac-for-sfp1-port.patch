From 84fc59c0d5285a0a0fe50e3cb2a85f6224362c55 Mon Sep 17 00:00:00 2001
From: Jonas Jelonek <jelonek.jonas@gmail.com>
Date: Sun, 10 Nov 2024 00:43:23 +0000
Subject: [PATCH] arm64: dts: mediatek: bpi-r3: name the sfp1 port

Set the netdev name of the GMAC connected to the first SFP cage of the
BananaPi BPI-R3 to sfp1.
---
--- a/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3.dts
+++ b/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3.dts
@@ -195,6 +195,7 @@
 		phy-mode = "2500base-x";
 		sfp = <&sfp1>;
 		managed = "in-band-status";
+		openwrt,netdev-name = "sfp1";
 	};
 
 	mdio: mdio-bus {
